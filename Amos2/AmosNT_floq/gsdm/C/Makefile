AMOSHOME=../..

# Be sure that this is the same dir as in daemon_cfg.h!
INSTALLDIR=/opt/LOIS/udp_broadcaster

LISPFILE=daemon.lsp

BINDIR=$(AMOSHOME)/bin

OBJDIR=.

UDPLIBS=$(BINDIR)/libamos.a -lm -lnsl -lpthread -lrt

# bcast server executable file name
UDPB_EXECUTABLE=bcastd

# sources we use for the udp-test
#

#UDPSRCS = udp_test.c udp_producer.c udp_radiosource.c udp_streams.c
UDPSRCS = broadcaster_lin.c udp_test.c udp_producer.c udp_radiosource.c udp_streams.c udp_logging.c

# generate a list of required obj files using the sources list
#
UDPOBJS = $(sort $(foreach src, $(UDPSRCS), $(OBJDIR)/$(notdir $(src:%.c=%.o))))

# make all by default
#
default: all

# phony rules don't produce real files
#
.PHONY: all clean

# All targets
#
all: $(BINDIR)/amos2 $(BINDIR)/amos2.dmp $(BINDIR)/$(UDPB_EXECUTABLE) testclient

#####
# the following two are Tore's original rules
#
$(BINDIR)/amos2: $(BINDIR)/libamos.a $(AMOSHOME)/C/main.o
	$(CC) -O2 -o $(BINDIR)/amos2 $(AMOSHOME)/C/main.c $(BINDIR)/libamos.a -lm -lnsl

$(BINDIR)/amos2.dmp: $(BINDIR)/amos2
	$(BINDIR)/amos2 -i../../lsp -o "save '$(BINDIR)/amos2.dmp';quit;"
#
#####

# rule to install the broadcaster server daemon in installdir
install: $(BINDIR)/amos2 $(BINDIR)/amos2.dmp $(BINDIR)/$(UDPB_EXECUTABLE)
	@echo Installing $(UDPB_EXECUTABLE) to $(INSTALLDIR) ;\
	if [[ ! -d ${INSTALLDIR} ]] ; then mkdir ${INSTALLDIR} ; fi ;\
	cp $(BINDIR)/amos2.dmp $(INSTALLDIR)/amos2.dmp ;\
	cp $(BINDIR)/$(UDPB_EXECUTABLE) $(INSTALLDIR)/$(UDPB_EXECUTABLE) ;\
	echo Installing $(LISPFILE) to $(INSTALLDIR) ;\
	if [[ -a $(INSTALLDIR)/$(LISPFILE) ]] ;	then \
	echo Backing up existing file to $(LISPFILE).bak ;\
	rm -f $(INSTALLDIR)/$(LISPFILE).bak ;\
	mv ${INSTALLDIR}/$(LISPFILE) ${INSTALLDIR}/$(LISPFILE).bak ; \
	fi ;\
	cp $(LISPFILE) $(INSTALLDIR)
#

# rule to make broadcaster
#
$(BINDIR)/$(UDPB_EXECUTABLE): $(UDPOBJS) $(BINDIR)/amos2.dmp
	$(CC) -O2 -o $@ $(UDPOBJS) $(UDPLIBS)

# rule to make testclient (receives udp packets at port 4096)
#
testclient: testclient.o
	$(CC) -O2 -o $@ $^ -lnsl -lm

# rule to generalize c-sources compilation, no linking
#
$(OBJDIR)/%.o: %.c
	$(CC) -O2 -o $@ -c $<

# rule to handle dependency generation for faster compilation
#
$(OBJDIR)/%.d: %.c
	@set -e; rm -f $@; echo Generating dependencies for $<; \
	$(CC) $(CXXFLAGS) $(MYFLAGS) -MM $< > $@.$$$$; \
	sed 's,\($*\)\.o[ :]*,$(OBJDIR)/\1.o $@ : ,g' < $@.$$$$ > $@; \
	rm -f $@.$$$$;\

# remove all files generated by make (as well as emacs backups)
clean:
	rm -f $(OBJDIR)/*.d $(OBJDIR)/*.o *~ $(BINDIR)/udptest testclient

#
# Include generated dependency-files for each obj.
# This forces make to use the dep-rule above to create the files.
#
-include $(OBJDIR)/$(UDPOBJS:%.o=%.d)

#
# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
#
#.NOEXPORT:

