create function heartbeat0(Number freq)->Bag of Number
  as foreign 'heartbeat0-+';

create function heartbeat(Number frequency)->Stream of Number
  /* Emit time from start in seconds at given frequency */
  as streamof(heartbeat0(frequency));

create function randStream0(Number l, Number u) -> Bag of Number
  as loop
      return frand(l, u);
     end loop;

create function randStream(Number l, Number u) -> Stream of Number
  as streamof(randStream0(l, u));

create function heartbeat0(Stream s, Number freq) -> Bag of (Real ts, Object r)
  as foreign 'heartbeat0--++';

create function heartbeat(Stream s, Number freq) -> Stream of (Real, Object)
  as streamof(heartbeat0(s, freq));

create function diota0(Number delay, Number l, Number u) -> Bag  of Number
  as foreign "diota---+";

create function diota(Number freq, Number l, Number u) -> Stream of Number
  /* Make a stream of iota(l, u) with frew delayed tuples */
  as streamof(diota0(freq, l, u));

create function replay(Stream s, Function ts) -> Bag of Vector
  as foreign 'replay0--+';

create function playback(Stream s) -> Bag of Vector
  /* Playback time stamped stream of tuples where first element is timestamp */
  as foreign 'playback0-+';

create function tuples(Stream s) -> Bag of Vector
  /* Extract all tuples from stream s */
  as foreign 'stream.tuples-+';

create function first(Stream s) -> Vector
  /* Extract the first tuple from stream s */
  as foreign 'first-+';

create function tupleSchema(Charstring name,
                            Vector of Vector of Charstring attributes)
                          -> Bag of Function
  /* Generate access functions for a tuple.
     name: The name of the tuple
     attributes: A vector of pairs declaring attributes {{A1, TP1},...{An,TPn}}
                 Ai: name of attribute
                 TPi: name of data type of attribute
     The access functions are named name_A1,...,name_An */
  as for each Integer i, Charstring attr, Charstring tp 
         where attributes[i]={attr,tp}
     return(eval("create function "+name+"_"+attr+"(Vector e) -> "+tp+
                 " as e["+i+"];"));

