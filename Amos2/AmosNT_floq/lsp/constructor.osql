 *
 * Description: Functions for declaring a custom constructor function for a 
 *              user type.
 *
 ****************************************************************************/
create function set_constructor(type t, function constructor) -> boolean
as foreign 'set_constructor--+';

create function forbid_constructor(type t) -> boolean
as foreign 'forbid_constructor-+';

create function forbid_constructor(type t, charstring error_message) -> boolean
as foreign 'forbid_constructor--+';

create function get_property(type base, charstring generic_name, type res)
  -> function f
as
select f
where generic(f) != f and
      res in result_types(f) and
      name(generic(f))=generic_name and
      argument_types(f)= allsupertypes(base);