create function make_record(Vector) -> Record 
  /* Construct a record from a vector of keys and values */
  as foreign 'makerecord'; 

create function empty_record() -> Record
  as make_record({});

create function put_record(Record r, Charstring k, Object v) -> Record 
  /* Set value of key k in record r to value v */
  as foreign 'put_record';

create function merge_records(Record x, Record y) -> Record
  /* Merge records X and Y */
  as foreign 'merge-records--+';

create function vref(Record, Charstring) -> Object
  as multidirectional
     ('bbf' foreign 'vref-bbf')
     ('bff' foreign 'vref-bff');

create function vref(Record, Vector) -> Object
  as multidirectional
     ('bbf' foreign 'vref-bbf')
     ('bff' foreign 'vref-bff');

create function vref(Record, Number) -> Object
  as multidirectional
     ('bbf' foreign 'vref_any_bbf')
     ('bff' foreign 'vref_any_bff');

create function all_value(Record R) -> Object
  as foreign 'all_value';

create function record_length(Record R) -> Integer
  /* The number of key value pairs in a record */
  as foreign 'record-length';
