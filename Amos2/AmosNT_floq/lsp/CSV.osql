lisp;

(defun writecsvfile-- (fno file b)
  (with-output-file
   s file
   (mapbag b (f/l (row)(write-csv-line (car row) s))))
  (osql-result file b))

:osql

create function writecsvfile(Charstring file, Bag b) -> Boolean
  as foreign 'writecsvfile--';

create function csv_file_tuples (Charstring file) -> Bag of Vector
  as foreign 'csv-file-tuples-+';

create function csv_file_stream (Charstring file) -> Stream of Vector
  as streamof(csv_file_tuples(file));


