(defun get-real-types (faked_tp original_tp)
"Select types alternatively from the two type lists stored in an SAE node.
 The rule is:
 - if a type in ORIGINAL_TP is NIL then the corresponding type stored in
   FAKED_TP is a the real type.
 - otherwise take the one from the ORIGINAL_TP."
    (if (null original_tp)
	faked_tp
	(mapcar (f/l (f_tp o_tp) (if (null o_tp) f_tp o_tp))
		faked_tp
		original_tp)))

(defun make-proxy-obj (remote-oid db)
"Create a proxy object to an object in DB with oid REMOTE-OID
 TODO: improve speed."
  (let ((bucket (gethash remote-oid _proxytable_))
	(obj nil))
    (if bucket ; there are proxies with the same xoidno
	; check if they are in the same DB
	(let ((duplicate-lst (mapfilter (f/l (obj) (eq (proxy-database obj) db))
					bucket)))
	  (if duplicate-lst   ; do not create a new object, return the old one
	      (setq obj (car duplicate-lst)))))
    (if obj
	obj                                ; return the old object
        (let ((obj (createobject _proxy_))) ; create a new object
	  (/putobject obj 'xoidno   remote-oid)
	  (/putobject obj 'exportto db)
	  ; append the new obj at the end of the bucket put it in the hashtable
	  (puthash remote-oid _proxytable_ (nconc1 bucket obj))
	  obj))))


