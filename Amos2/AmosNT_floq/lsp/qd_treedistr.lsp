(defun vinfo-set-diff (vi-lst-1 vi-lst-2)
"Calculate the set-difference of 2 lists of varInfo,
 using the varInfo-name field as a key.
 Out: a list of varInfo, containing the set difference of the inputs."
  (let ((result NIL))
    (do* ((rest-1 vi-lst-1     (cdr rest-1))
	  (vnfo-1 (car rest-1) (car rest-1)))
	 ((null rest-1) result)
	 (if (not-contained? vnfo-1 vi-lst-2)
	     (push vnfo-1 result)))))

(defun not-contained? (vnfo vi-lst)
"check if a varInfo is not contained in a list of varInfo."
  (let ((varname (varInfo-name vnfo)))
    (do* ((rest vi-lst (cdr rest))
	  (curr-vnfo (car rest) (car rest)))
	 ((null rest) T)
	 (if (equal varname (varInfo-name curr-vnfo))
	     (return NIL)))))

(defun vinfo-unique (vi-lst)
"Similar to (unique lst), but works on a list of varInfo, using the
name field as a key.
Duplicate vars at beggining of the lists are removed, while their
last occurence remains in the new list."
  (let ((result NIL))
    (do* ((rest vi-lst (cdr rest))
	  (curr-vnfo (car rest) (car rest)))
	 ((null rest) result)
	 (if (not-contained? curr-vnfo (cdr rest))
	     (push curr-vnfo result)))))


(defun ppvi (vinfo)
"pretty-print a varInfo structure."
  (formatl t "["    (varInfo-name vinfo) ", "
	             (varInfo-type vinfo) ", "
		     (varInfo-orgtype vinfo) ", "
		     (varInfo-bind vinfo) "]" t))
