declare_key(theresolvent('R'),{'i','str'});
declare_key(theresolvent('R'),{'uri'});

 /***************************************************************	
 * Constructor fns for uris and rdf literals in terms of r.	*
 ***************************************************************/

create function uri(literal l)->resource key
  as select r(0,l);

create function lit(literal l)->rlit key
  as select r(1,l);
  
 /***************************************************************	
 * Inverse of uri and literal resources as identifying values.  *
 ***************************************************************/
create function uid(resource r)->literal l
  as select l where uri(l)=r;

create function lid(resource r)->literal l 
  as select l where lit(l)=r;
