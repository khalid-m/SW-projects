create function wsnew_function(Charstring name, Charstring query)->Vector as ship("WSBench","new_function('"+name+"','"+query+"');");


create function define_operation(Charstring oname, Charstring query)->Charstring as begin
                                       wsnew_function(oname, query);
                                       result "true";
                                       end;

create function wsnew_function_load()->Vector as ship("WSBench","new_function_load();");

create function ch_vec(charstring o_name)->Vector of Charstring as cast(unstringify(o_name) as Vector of Charstring);

create function deploy_service(charstring o_name,Charstring ws_name)->Charstring as begin 
                                   wsnew_function_load();
                                   load_amosql(getenv('AMOS_HOME')+'wsmed/WSBench/src/amosql/user_defined_wsop.amosql');
                                   deploy_wsdl(ch_vec(o_name),ws_name+'.wsdl',ws_name); 
                                   result "true";
                                   end;														

create function execute(Charstring oname,charstring delay, Integer no_tup, Vector opara)-> Vector  as
                   begin                   
                   result apply(functionnamed(oname),concat(opara,{no_tup,cast(unstringify(delay) as real)})) ;
                   end;


create function execute_operation(Charstring oname, Charstring opara, charstring delay, Integer no_tup)->Vector as vectorof(execute(oname,delay,no_tup,cast(unstringify(opara) as vector)));

set deploy_dir()= getenv('AMOS_HOME')+'\wsmed\\wsdl\\';
deploy_wsdl({'define_operation','deploy_service','execute_operation'},'WSBENCH.wsdl','WSbench');



                   







                                      