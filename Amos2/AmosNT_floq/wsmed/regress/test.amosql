
<'regress/iota_exp.amosql';


lisp;
(checkequal "orginal code U1"
  ((osql "count(u1());") '((55))))

(checkequal "orginal code U2"
  ((osql "count(u2());") '((165))))
:osql
rollback;

/*load parallel query execution */
load_lisp("src/lisp/pardecom.lsp");

/* start servers */
wsmedns();
register("me");
startwsmedpeers(4,"test.dmp");

/* without adaptive cost model */
lisp;
(setq  _fanout_ (list 5 1))
:osql
/* with adaptive cost model */
lisp;
(setq  _initnodes_ 5)
:osql

<'regress/iota_exp.amosql';

lisp;

(checkequal "Parallel QueryPlan test U1" 
  ((osql "count(u1());") '((55))))

(checkequal "Parallel QueryPlan test U2- one rr-receive call" 
  ((osql "count(u2());") '((165))) )

(checkequal "Parallel QueryPlan test U3- two rr-receive call" 
  ((osql "count(u3());") '((15642))) )
:osql

kill_all();



      



