/* helping functions*/
lisp;
(defun getzipcode (fno string r)
  "Returns a list of substrings (zipcode) of string"
  (let ((zc "") (j 0) tstr)
    (if (string= string "") (osql-result string nil)
      (progn 
	(setq tstr (explode (mksymbol string)))
	(dolist (i tstr)
	  (if (integerp i) (progn (if (< j 5)(setq zc ( concat zc (mkstring i)))) (setq j (1+ j)))
	    (if (not (string= zc "")) (progn (setq j 0)(osql-result string zc) (setq zc "")) ))
      
      
	  )))
    ))

(register-init-form '(delay-emit t));wsmed requires delayed emits 

:osql
create function sql:getzipcode(charstring zipstr)->charstring zipcode as foreign "getzipcode"; 
create function sql:substring(charstring str, integer start, integer finish)->charstring substr as select substring(str,start,finish); 
save 'wsmed.dmp';
quit;
