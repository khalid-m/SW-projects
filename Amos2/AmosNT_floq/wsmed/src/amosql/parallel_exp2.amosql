/* setup */
setup

/*compile the system */
compile

/* create a dump file, wsmed.dmp,  with required commands */

mkdmp

/* start the wsmed system */

wsmedco fd wsmed.dmp

/* start the nameserver and register the client */

wsmedns();




/* importing metadata from WSDL */
importwsdl("wsdl/TerraService2.wsdl");
importwsdl("wsdl/PlaceLookup.wsdl");
importwsdl("wsdl/ZipCodeLookup.wsdl");
importwsdl("wsdl/uszip.wsdl");
importwsdl("wsdl/Weather.wsdl");
importwsdl("wsdl/WeatherForecast.wsdl");
importwsdl("wsdl/LocalTime.wsdl");
