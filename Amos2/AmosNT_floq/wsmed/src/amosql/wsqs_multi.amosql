/*__________________________________________________________________________*/

lisp;

(defun concat-vector(fno iv oc)
"Concat all vector elements as comma separated string"
  (setq oc "")
  (maparray iv
	    (f/l (row i)
		 (if (= oc "") (setq oc (concat oc row))
		 (setq oc (concat oc " , " row)))))
  (osql-result iv oc))

(defun replace-str(fno is r)
  (let ((s (explode is)) (rstr ""))
     
    (dolist (x s)
      (cond   ((equal x "?")(setq rstr (concat rstr "\"")))
              ((= x "^")(setq rstr (concat rstr "<")))
	      (t (setq rstr (concat rstr x)))))
    (osql-result is rstr)))

:osql

create function replace_str(charstring is)->charstring os as foreign "replace-str";

create function concatvector(vector i)->charstring c as foreign "concat-vector";

                               

create function importWSDL(integer userid,charstring wsdlurl)-> Bag of charstring viewstr  as select a+","+b+","+c+","+d from vector v, charstring a, charstring b, charstring c, charstring d where a=v[0] and b=v[1] and  c=v[2] and  d=v[3] and v=importwsdl(wsdlurl);
      

funInfo('IMPORTWSDL','USERID.WSDLURL','INTEGER.CHARSTRING','VIEWSTR','CHARSTRING',"BAG"); 


create function tableInfo(integer userid, charstring tname)-> (charstring authenticationstr, charstring servicename, charstring tablein, charstring tableout) as select tableInfo(tname);

create function tableInfo(integer userid, charstring tname)-> charstring viewstr as select a+";"+b+";"+c+";"+d  from vector v, charstring a, charstring b, charstring c, charstring d where a=v[0] and b=v[1] and  c=v[2] and  d=v[3] and v=tableInfo(tname);
                              

funInfo('TABLEINFO','USERID.TNAME','INTEGER.CHARSTRING','VIEWSTR','CHARSTRING',"");

create function authentication(integer userid, charstring tname, charstring authenticationstr)-> charstring status as select putsoaphvalue(tname,authenticationstr);


funInfo('AUTHENTICATION','USERID.TNAME.AUTHENTICATIONSTR','INTEGER.CHARSTRING.CHARSTRING','STATUS','CHARSTRING',"");			      

create function query (integer userid, charstring sqlq)-> charstring vo as 
					begin
				           return concatvector(cast (sql(replace_str(sqlq)) as Vector));
					end;




funInfo('QUERY','USERID.SQLQ','INTEGER.CHARSTRING','VO','CHARSTRING',"BAG");




