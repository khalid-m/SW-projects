

create function isExportable(Function f)-> Boolean as stored;

create function theExportableResolvents(Charstring fn)-> Function f
  as if some(isExportable(resolvents(theFunction(fn)))) 
     then for each Function r
          where isExportable(r) 
           and r = resolvents(functionNamed(fn))
          return r
     else error("Function not exportable", fn);

create function exportable (Charstring fn) -> boolean
  as set isExportable(resolvents(theFunction(fn)))=true;


create type funInfo properties (funName charstring, argsType charstring, 
                                argsName charstring, rettype charstring, 
                                retname charstring, resformat charstring);


create function getFunInfo(charstring fn, charstring argst)
                          -> (charstring rettype, charstring retname, charstring resformat) 
  as select rettype(f), retname(f),resformat(f) 
     from funInfo f 
     where funName(f) = fn 
       and argsType(f) = argst;


create function getFuninfo(charstring fn)-> 
       (charstring rettype, charstring retname, charstring argstype, 
        charstring argsname)
  as select rettype(f), retname(f), argsType(f), argsName(f) 
     from funInfo f 
     where funName(f) = fn;

create function FunInfo(charstring funn, charstring argn, charstring argt, 
                        charstring retn, charstring rett , charstring resf) -> boolean
  as begin
	declare funInfo p;
	
        if notany(select f 
                  from funInfo f 
                  where funname(f) = funn 
                    and argsType(f) = argt) 
        then 
    		begin 
		create funInfo instances p;
        		set argsName(p) = argn;
         		set retName(p) = retn;
 			set retType(p) = rett;
         		set argsType(p) = argt;
         		set funName(p) = funn;
			set resformat(p)=resf;
			return 1;
    		end
 	else
   		begin
       		set argsName(fun) = argn 
                    from funInfo fun 
                    where funname(fun) = funn 
                      and argsType(fun) = argt ; 
       		set retName(fun) = retn 
                    from funInfo fun 
                    where funname(fun) = funn 
                      and argsType(fun) = argt; 
       		set retType(fun) =rett 
                    from funInfo fun 
                    where funname(fun) = funn 
                      and argsType(fun) = argt; 
		set resformat(fun) =resf
                    from funInfo fun 
                    where funname(fun) = funn 
                      and argsType(fun) = argt; 
		return 1;
   		end  
      
end;



create function isSubType(charstring superType, charstring subType) -> boolean
  as select some(select t 
                 from type t 
                 where t in subtypes(typenamed(superType)) 
                   and t = typenamed(subType));


