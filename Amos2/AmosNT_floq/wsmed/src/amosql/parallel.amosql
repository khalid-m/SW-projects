/* helping functions */

create function storebag()-> object  as stored;

create function partition(integer num1, integer num2, bag s)->object as select (vectorof(s))[i] from  integer i where  i in iota(num1-1,num2-1);



create function make_partition(integer no_peers, bag bg, vector arg)->vector v as
						begin
						 declare integer dividend, integer reminder; 
						
						 set dividend=div((count(bg)-mod(count(bg),no_peers)),no_peers);
						 set reminder=mod(count(bg),no_peers);
						 set v={};
						 
						 for each integer i where i=iota(1,no_peers) 
						  begin
						    if (i<= reminder) then
							   set v= concat(v,{concat(arg,{vectorof((partition((i-1)*dividend+i,(i-1)*dividend+dividend+i,bg)))})})
						    else
						          set v= concat(v,{concat(arg,{vectorof((partition((i-1)*dividend+1,(i-1)*dividend+dividend,bg)))})});
						  end;
						
						 result v;

						end;


create function states()-><charstring state> as 
				      select state
				      from  charstring statename, Charstring types,  real latDegrees, real lonDegrees, real latRadians, real lonRadians 
				      where GetAllStates()=< statename ,types ,state, latDegrees , lonDegrees , latRadians , lonRadians>;

create function placeinfo(charstring city, vector of object  bg)-> integer as 
					 select count(GetPlaceList(city+", "+state, 100,'true'))
					 from charstring state
					 where state in bg and print(state);


