/* some helping function */
lisp;
(defun getzipcode (fno string r)
  "Returns a list of substrings (zipcode) of string"
  (let ((zc "") (j 0) tstr)
    (if (string= string "") (osql-result string nil)
      (progn 
	(setq tstr (explode (mksymbol string)))
	(dolist (i tstr)
	  (if (integerp i) (progn (if (< j 5)(setq zc ( concat zc (mkstring i)))) (setq j (1+ j)))
	    (if (not (string= zc "")) (progn (setq j 0)(osql-result string zc) (setq zc "")) ))
      
      
	  )))
    ))

:osql
create function sql:getzipcode(charstring zipstr)->charstring zipcode as foreign "getzipcode"; 
create function sql:substring(charstring str, integer start, integer finish)->charstring substr as select substring(str,start,finish); 
create function sql:substring1(charstring str)->charstring substr as select substring(str,0,1); 


save "wsmed.dmp";

/*query 1*/

create function query1()-> integer as select count(
                  sql("select gl.City ,  gl.PlaceTypeId
                       from   GetAllStates gs, GetPlacesWithin gp, GetPlaceList gl
                       where  gs.State=gp.state and gp.distance=15.0 and gp.placeTypeToFind='City' and gp.place='Atlanta' and gl.placeName=gp.ToPlace+' ,'+gp.ToState and gl.MaxItems=100 and gl.imagePresence='true'"));


/* query 2 */
create function query2()-> integer as select count(
                 sql("select gp.ToState, gp.zip
                      From   GetAllStates gs, GetInfoByState gi,getzipcode gc, GetPlacesInside_0 gp
                      Where gs.State=gi.USState and gi.GetInfoByStateResult=gc.zipstr and gc.zipcode=gp.zip and gp.ToPlace='USAF Academy' "));




create function query3()-> integer as select count(
                  sql("select gp.ToPlace
                       from   GetAllStates gs, GetPlacesWithin gp
                       where  gs.State=gp.state and gp.distance=15.0 and gp.placeTypeToFind='City' and gp.place='Atlanta'"));

/* Find all the places inside the US states starting with the alphabets in {'A','B','C'} and their forecast for a week */

create function q4(charstring chk)->  integer as select count(
					sql("select gp.ToPlace,gp.ZIP,gp.ToState,zipcode,gz.date, gz.desciption,gz.MorningLow,gz.Daytime
					     from   GetAllStates gs, GetInfoByState gi,getzipcode gc, GetPlacesInside gp,  GetCityForeCastByZip gz, substring ss
					     where  ss.str=gs.State and ss.start=0 and ss.finish=0 and ss.substr< 'C' and  ss.str=gi.USState and gi.GetInfoByStateResult=gc.zipstr and gc.zipcode=gp.zip and gz.ZIP=gc.zipcode"));


create function q5(charstring chk)-> <  CHARSTRING placeout,  CHARSTRING state1, CHARSTRING zipcode,CHARSTRING date,CHARSTRING description,CHARSTRING low,
                                      CHARSTRING high> as
                                       select v[0],v[1],v[2],v[3],v[4],v[5],v[6]
                                       from vector v
                                       where sql("select gp.TOPLACE,gp.TOSTATE,gz.zipcode,gc.DATE, gc.DESCIPTION,gc.MORNINGLOW,gc.DAYTIMEHIGH
				      from   GetAllStates gs,  GetInfoByState gi, GetPlacesInside_0 gp,  substring ss, GetCityForeCastByZip gc ,getzipcode gz
					where   ss.str=gs.State and ss.substr<'"+chk+"'and ss.start=0 and ss.finish=0 and gi.USState=gs.State and gi.GETINFOBYSTATERESULT=gz.zipstr and gp.zip=gz.zipcode and gc.zip=gz.zipcode")=v;





 sql("select * from getdistances g where g.LONGITUDE=32.96 AND g.LATITUDE=-93.99 AND g.DEPARTUREPOINT_LONGITUDE=27.78 AND g.DEPARTUREPOINT_LATITUDE=-97.42 AND g.AUTHENTICATIONPARAMS='50227'"); 




create function query5()-> integer as select count(sql("select gp.TOPLACE,gp.TOSTATE,gz.zipcode,gc.DATE, gc.DESCIPTION,gc.MORNINGLOW,gc.DAYTIMEHIGH from   GetAllStates gs,  GetInfoByState gi, GetPlacesInside_0 gp,  substring ss, GetCityForeCastByZip gc ,getzipcode gz	where   ss.str=gs.State and ss.substr<'AK'and ss.start=0 and ss.finish=0 and gi.USState=gs.State and gi.GETINFOBYSTATERESULT=gz.zipstr and gp.zip=gz.zipcode and gc.zip=gz.zipcode"));



create function query6()-> integer as select count(sql("select gp.TOPLACE,gp.TOSTATE,gz.zipcode,gc.DATE, gc.DESCIPTION,gc.MORNINGLOW,gc.DAYTIMEHIGH from   GetAllStates gs,  GetPlacesInside_0 gp,  GetCityForeCastByZip gc ,GetZipc gz	where   gs.State<'AL' and gz.State=gs.State and  gp.zip=gz.zipcode and gc.zip=gz.zipcode"));


sql("select gp.toplace,count(gp.TOSTATE) from   GetAllStates gs,  GetPlacesInside_0 gp,  GetCityForeCastByZip gc ,GetZipc gz	where   gs.State<'AL' and gz.State=gs.State and  gp.zip=gz.zipcode and gc.zip=gz.zipcode group by gp.toplace");
  
sql("select gp.TOSTATE, gp.TOPLACE  from   GetPlacesInside_0 gp  where gp.zip='99501'");


/***********************Views*****************************/

create function sql:View()-> <Charstring zip, Charstring dat, Charstring place, Charstring state> as select v[0],v[1],v[2],v[3]
                                       from vector v where sql("select gz.zipcode,gc.DATE,gp.TOPLACE,gp.TOSTATE from   GetAllStates gs,  GetPlacesInside_0 gp,  GetCityForeCastByZip gc ,GetZipc gz where gs.State<'AL' and gz.State=gs.State and  gp.zip=gz.zipcode and gc.zip=gz.zipcode")=v;

sql("select v.zip,count(v.dat) from View v group by v.zip ");

create function sql:View1()-> <Charstring zip, Charstring place, Charstring state> as select v[0],v[1],v[2]
                                       from vector v where sql("select gz.zipcode, gp.TOSTATE, gp.TOPLACE  from   GetAllStates gs,  GetPlacesInside_0 gp,  GetZipc gz where gs.State<'AL' and gz.State=gs.State and  gp.zip=gz.zipcode")=v;

sql("select v.zip  from View1 v group by v.zip ");


create function sql:View2()-> <Charstring zip, Charstring dat> as select v[0],v[1]
                                       from vector v where sql("select gz.zipcode,gc.DATE from   GetAllStates gs,  GetCityForeCastByZip gc ,GetZipc gz where gs.State<'AL' and gz.State=gs.State and gc.zip=gz.zipcode")=v;

sql("select v.zip  from View1 v group by v.zip ");

