create function findoperation(charstring wsdluri, charstring wsname, charstring opname,vector sv)->Operation  as 
                                                                        select op
									from Operation op, Service ws 
									where name(op)=opname and name(ws)=wsname  and wsdluri(ws)=wsdluri and op in port(ws)                                                                          and find_type( authentication(op),{})=findsignature(sv);

create function putsoaphvalue(charstring wsdluri, charstring wsname, charstring opname,vector sv)->SHValue s as 
							begin
							   create SHValue instances s;
							   set oper(s)=findoperation(wsdluri,wsname,opname,sv); 
							   set value(s)=sv;
							end;