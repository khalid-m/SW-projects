/* Wrapper function s*/

create function GetState( bag b,charstring stn)-> charstring  sn as 
                                                          select snv[2]  
                                                          from vector snv 
                                                          where snv in b and snv[0]=stn;



create function GetAllStates_w0()-> charstring state as
                         select state  
                         from  charstring statename, Charstring types, real latDegrees, real lonDegrees, real latRadians, real lonRadians 
                         where GetAllStates()=<statename ,types ,state, latDegrees , lonDegrees , latRadians , lonRadians>;


create function GetAllStates_GetPlaceList_w0(charstring kw,integer notuple, charstring imagepresence)->  <charstring kw1,charstring state, integer notuple1, charstring imagepresence1> as 
				select kw, state, notuple, imagepresence
                                where GetAllStates_w0()=state;

create function GetAllStates_GetPlaceList_w1(charstring kw,integer notuple, charstring imagepresence, bag bg)-> Vector as 
                                                 select {kw,state,notuple,imagepresence}  
                                                 from charstring state , vector ve
                                                 where ve in bg and state=ve[2];



create function GetPlacesWithin_GetPlaceList_w0(integer notuple, charstring imagepresence, bag bg)-> <charstring kw, charstring state ,integer notuple1, charstring imagepresence1> as 
                                        select kw,state,notuple,imagepresence 
                                        from vector ve 
                                        where ve in bg and state=ve[1] and kw= ve[0];

create function GetPlaceList_w( charstring kw,charstring state,integer notuple, charstring imagepresence)-> <charstring pn,charstring statename, charstring country, real lon1, real lat1,integer theme, charstring pid, integer pop> as 
                                              select pn,statename,country,lon1,lat1,theme,pid,pop 
                                              where GetPlaceList(kw+", "+state, notuple, imagepresence)=<pn,statename,country,lon1,lat1,theme,pid,pop>;


create function GetAllStates_GetPlacesWithin_w0(charstring city, real distance, charstring pint)-> <charstring city1, charstring state, real distance1, charstring pint1> as 
                                           select city,state,distance,pint  
                                           where GetAllStates_w0()=state;

