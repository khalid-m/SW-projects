
/* To import web service meta data */
load_amosql("src/amosql/parallel_exp3.amosql");



/*To load the operator FF_APPLYP */

load_lisp("src/lisp/ff_receive_static_co.lsp");

/*To load the query parallellization functions*/
load_lisp("src/lisp/pardecom_ff_static_co.lsp");

/* To load helping lisp functions */
load_lisp("src/lisp/coroutine_ffapplyp.lsp");	



/*set fanout */
setfanout({3,3});


/* Test query with real web service call */

create function q1()-> integer
	as select count(sql("select gp.toplace
           from GetAllStates gs, GetPlacesWithin gp
           where gs.state=gp.State and gp.place= 'Atlanta' and gp.distance=15.0 and gp.placetypetofind='City' "));

