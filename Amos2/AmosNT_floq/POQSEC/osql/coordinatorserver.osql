create function createQueryFile(job j, charstring query) -> charstring as
begin
	openwritefile(queryfile(j));
	for each vector v where v=data(j)
		print("load_root_file(\""+name(cast(v[0] as eventdata))+"\","
								+itoa(cast(v[1] as integer))+","
								+itoa(cast(v[2] as integer))+");");
	print("openwritefile(\""+resultfile(j)+"\");");
	print("print("+query+");");
	print("closewritefile();");
	print("quit;");
	closewritefile();
	result QueryFile(j);
end;
