<'nginteract.osql';
<'getload.osql';
load_lisp("../lsp/coordinatorserver.lsp");

declare cluster :beppe, cluster :bluesmoke, cluster :hagrid,
	cluster :hive, cluster :ingrid, cluster :sigrid, cluster :ng, 
	cluster :swegrid;
/*
	set :beppe=clusternamed("beppe");
	set :bluesmoke=clusternamed("bluesmoke");
	set :hagrid=clusternamed("hagrid");
	set :hive=clusternamed("hive");
	set :ingrid=clusternamed("ingrid");
	set :sigrid=clusternamed("sigrid");
	set :ng=clusternamed("NorduGrid");
	set :swegrid=clusternamed("swegrid");
*/

create function createjobs(submission, integer, integer, integer) -> boolean 
	as foreign 'create-jobs';

declare charstring :location; /* this variable necessary for determining path to binaries depending on current location: either Hagrid (default) or Ingrid */
set :location= "Hagrid";

create function resultvalue(job) -> charstring as stored;

create function getResultValue(job j) -> job as
begin
	openreadfile(resultdir(j)+"/"+resultfile(j));
	set resultvalue(j) = readfile();
	closereadfile();
	result j;
end;

create function getResultValue(bag of job jobs) -> job as
begin
	for each job j where j=in(jobs)
	begin
		openreadfile(resultdir(j)+"/"+resultfile(j));
		set resultvalue(j) = readfile();
		closereadfile();
		result j;
	end;
end;

create function timechar(timeval t) -> charstring str as
begin
	result itoa(year(t))+itoa(month(t))+itoa(day(t))+
		itoa(hour(t))+itoa(minute(t))+itoa(second(t));
end;
