create function createAJobFile(job j, charstring Executable, 
	charstring Image) -> charstring as
begin
	openwritefile(xrslFile(j));
	prinx("&");
	prinx("(executable="+Executable+")");
	prinx("(arguments=\""+Image+"\")");
	prinx("(inputfiles=");
	prinx("	("+Executable+" \""+binarypath(cluster(j))+Executable+"\")");
	prinx("	("+Image+" \""+binarypath(cluster(j))+Image+"\")");
	prinx("	("+QueryFile(j)+" \""+QueryFile(j)+"\")");
	for each vector evF where evF=data(j)
		prinx("	("+name(cast(evF[0] as eventdata))+" \""
					+path(cast(evF[0] as eventdata))
					+name(cast(evF[0] as eventdata))+"\")");
	prinx(")");
	prinx("(outputfiles=("+resultfile(j)+" \"\"))");
	prinx("(cputime="+itoa(CPUtime(j))+")");
	if (nickname(cluster(j))="swegrid")
	then begin
		prinx("(|");
		for each cluster site where site=clusters(cast(cluster(j) as grid))
			prinx("(runtimeenvironment="+rootRE(site)+")");
		prinx(")");
	end else
		prinx("(runtimeenvironment="+rootRE(cast(cluster(j) as cluster))+")");
	if (nickname(cluster(j))="swegrid")
	then begin
		prinx("(|");
		for each cluster site where site=clusters(cast(cluster(j) as grid))
			prinx("(cluster="+name(site)+")");
		prinx(")");
	end else
		prinx("(cluster="+name(cast(cluster(j) as cluster))+")");
	prinx("(stdin=\""+QueryFile(j)+"\")");
	prinx("(middleware>=\"nordugrid\")");
	prinx("(stdout=\"outGen.out\")");
	prinx("(stderr=\"errGen.err\")");
	prinx("(gmlog=\"grid.debug\")");
	prinx("(jobName=\"POQSEC: "+xrslFile(j)+"\")");
	closewritefile();
	result xrslFile(j);
end;
