create function resubmit(submission s) -> job as
	for each job j where j=jobs(s) and status(j)="NOT"
	begin
		set status(j)="NEW";
		result j;
	end;


/*******************************************************
 * Interface to the Clients
 *******************************************************/

create function submit(charstring query, vector files, 
	integer jobs, integer cputime, charstring site) ->
 submission as
begin
	declare submission statjobs, integer sumFileSize, integer currentfile,
		integer positionInFile;
	set sumFileSize=0;
	create submission instances statjobs;
	set query(statjobs) = query;
	set cluster(statjobs) = clusternamed(site);
	set time(statjobs) = now();
	for each eventdata evfile where name(evfile)=in(files)
	begin
		set sumFileSize = sumFileSize + size(evfile);
		add data(statjobs) = evfile;
	end;
	set currentfile = 0;
	set positionInFile = 0;
	createjobs(statjobs,jobs,sumFileSize,count(files));
	for each job j where j=jobs(statjobs)
	begin
		set cputime(j) = cputime;
		set cluster(j) = clusternamed(site);
		set queryfile(j) = "query"+timechar(now())+itoa(getIxrsl())+".osql";
		set xrslfile(j) = site+timechar(now())+itoa(getIxrsl())+".xrsl";
		set resultfile(j)="result.out";
		set status(j)="NEW";
		createQueryFile(j, query(statjobs));
		createAJobFile(j,"aleh","aleh.dmp");
	end;
	result statjobs;
end;

/**************************************************************
 * Printing statistics part
 **************************************************************/

create function statistics() -> <charstring site, integer jobs,
	integer expectedCPUtime, integer freeCPUs, integer queuedjobs, 
	integer totaltime> as
	select nickname(cluster(s)), count(jobs(s)), maxagg(cputime(jobs(s))),
		load_freecpus(s), load_queuedjobs(s), totaltime(s) from submission s
	where status(s)="DOWNLOADED";

create function statistics(integer n) -> vector as
/*<charstring site, integer jobs,
	integer expectedCPUtime, integer freeCPUs, integer queuedjobs, 
	integer totaltime> as*/
	select in(sort((select nickname(cluster(s)), count(jobs(s)), 
					maxagg(cputime(jobs(s))), load_freecpus(s), 
					load_queuedjobs(s), totaltime(s) from submission s
					where status(s)="DOWNLOADED"),n));

create function statistics(charstring file) -> charstring as
begin
	openwritefile(file);
	print("cluster, jobs, totfiles, maxcputime, freecpus, queuedjobs, totaltime");
	for each submission s where status(s)="DOWNLOADED"
		print(nickname(cluster(s))+", "+itoa(count(jobs(s)))+", "+
			itoa(count(data(jobs(s))))+", "+
			itoa(cast(maxagg(cputime(jobs(s))) as integer))+", "+
			itoa(load_freecpus(s))+	", "+itoa(load_queuedjobs(s))+
			", "+itoa(totaltime(s)));
	closewritefile();
	result file;
end;

create function statistics(charstring file, cluster site) -> charstring as
begin
	openwritefile(file);
	print("cluster, jobs, totfiles, maxcputime, freecpus, queuedjobs, totaltime");
	for each submission s where status(s)="DOWNLOADED" and cluster(s)=site
		print(nickname(cluster(s))+", "+itoa(count(jobs(s)))+", "+
			itoa(count(data(jobs(s))))+", "+
			itoa(cast(maxagg(cputime(jobs(s))) as integer))+", "+
			itoa(load_freecpus(s))+	", "+itoa(load_queuedjobs(s))+
			", "+itoa(totaltime(s)));
	closewritefile();
	result file;
end;
