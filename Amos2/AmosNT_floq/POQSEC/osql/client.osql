create function submit(charstring query, vector files, integer
	jobs, integer cputime, charstring site) -> object as
begin
	declare charstring str;
	set str = "submit(\""+query+"\",{\""+cast(files[0] as charstring)+"\"";
	for each integer i where i=iota(1,cast(count(files)-1 as integer))
		set str = str+",\""+cast(files[i] as charstring)+"\"";
	set str = str+"},"+itoa(jobs)+","+itoa(cputime)+",\""+site+"\");";
	result ship("coordinator",str);
end;

create function submit(charstring query, bag files, integer
		jobs, integer cputime, charstring site) -> object as
begin
	declare charstring str, boolean b;
	set b=TRUE;
	set str = "submit(\""+query+"\",{";
	for each charstring file where file=in(files)
		if (b=TRUE)
		then begin
			set str = str+"\""+file+"\"";
			set b = FALSE
		end else set str = str+",\""+file+"\"";
	set str = str+"},"+itoa(jobs)+","+itoa(cputime)+",\""+site+"\");";
	result ship("coordinator",str);
end;

create function submit(charstring query, vector files, integer
	jobs, integer cputime) -> object as
begin
	declare charstring str;
	set str = "submit(\""+query+"\",{\""+cast(files[0] as charstring)+"\"";
	for each integer i where i=iota(1,cast(count(files)-1 as integer))
		set str = str+",\""+cast(files[i] as charstring)+"\"";
	set str = str+"},"+itoa(jobs)+","+itoa(cputime)+",\"swegrid\");";
	result ship("coordinator",str);
end;

create function submit(charstring query, bag files, integer
	jobs, integer cputime) -> object as
begin
	declare charstring str, boolean b;
	set b=TRUE;
	set str = "submit(\""+query+"\",{";
	for each charstring file where file=in(files)
		if (b=TRUE)
		then begin
			set str = str+"\""+file+"\"";
			set b = FALSE
		end else set str = str+",\""+file+"\"";
	set str = str+"},"+itoa(jobs)+","+itoa(cputime)+",\"swegrid\");";
	result ship("coordinator",str);
end;

create function status(object o) -> charstring as
begin
	result ship("coordinator","status(#[OID "+itoa(getidno(o))+"]);");
end;
