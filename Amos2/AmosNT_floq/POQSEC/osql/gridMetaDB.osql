 *  published at VLDB DMG 05. 
 *
 ****************************************************************************/

/**
 *  Schema of the permanent data about Grid resources, such as Swegrid's 
 * clusters and data of test suit.
 */

create type CResource;
create type Cluster under CResource;
create type Grid under CResource;
create type DataFile;
create type EventData under DataFile;

create function nickname(cResource) -> charstring key as stored; /* short name */
create function binarypath(cResource) -> charstring as stored; /* path to the binary that can be used */
create function binarypath(cResource,charstring) -> charstring as stored; /* path to the binary that can be used */
create function clusternamed(charstring site) -> CResource as
	select c from cresource c where site=nickname(c); /* object based on short name */

create function name(cluster) -> charstring key as stored; /* full name (URL) */
create function rootRE(cluster) -> charstring as stored; /* name of the ROOT REfor the cluster */
create function mpiRE(cluster) -> charstring as stored;

create function clusters(grid) -> bag of cluster as stored;

create function name(DataFile) -> charstring key as stored; /* filename */
create function path(DataFile) -> charstring as stored; /* path to SE or RS */
create function size(EventData) -> integer as stored; /* number of events */
