/**
 *  Schema of the permanent data about Grid resources, such as Swegrid's 
 * clusters and data of test suit.
 */

create type cluster;
create type EventData;

create function name(cluster) -> charstring key as stored;
create function nickname(cluster) -> charstring key as stored;
create function binarypath(cluster) -> charstring as stored;
create function rootRE(cluster) -> charstring as stored;
create function mpiRE(cluster) -> charstring as stored;

create function clusternamed(charstring site) -> cluster as
	select c from cluster c where site=nickname(c);

create function name(EventData) -> charstring key as stored; /* filename */
create function path(EventData nonkey) -> charstring as stored;
create function size(EventData) -> integer as stored; /* number of events */

/**
 *  Schema of collected statistics which is neccessary for Decision Maker
 * to choose a plan for evaluating 
 */

create function cputime(cluster, integer filesNo) -> integer as stored;

create function runoverst(cluster, integer jobsNo, integer CPUtimePjob, integer freeCPUs, integer queuedJobs) -> integer as stored;


/**
 *  Schema for temporary storing data about submitted jobs.
 */
create type job;

create function name(job) -> charstring key as stored;
create function cluster(job) -> cluster as stored;
create function xrslfile(job) -> charstring as stored;
create function queryfile(job) -> charstring as stored;
create function cputime(job) -> integer as stored;
create function submittime(job) -> timeval as stored;
create function data(job) -> bag of eventdata as stored;
create function parallel(job) -> integer as stored;
create function status(job) -> charstring as stored;
create function lasttime(job) -> timeval as stored;
create function resultfile(job) -> charstring as stored;
create function resultdir(job) -> charstring as stored;
create function resulttime(job) -> timeval as stored;
create function executiontime(job) -> real as stored;
create function loadtime(job) -> real as stored;

create type submission;

create function query(submission) -> charstring as stored;
create function data(submission) -> bag of eventdata as stored;
create function jobs(submission) -> bag of job as stored;
create function time(submission) -> timeval as stored;
create function load_freecpus(submission) -> integer as stored;
create function load_queuedjobs(submission) -> integer as stored;
create function cluster(submission) -> cluster as stored;
create function totaltime(submission) -> integer as stored;
create function currentload(submission) -> 
	bag of vector as stored; /*cluster, freecpus, queued jobs*/
