/*Extent of a raw file*/
create function RawFile_cc()->Bag of (Number m, Number s, Number bt, Number et, Number mv) 
as foreign 'raw-log-file'; 

/*Mapped type*/
create_mapped_type("RawFile",{"m", "s", "bt"},{"m","s", "bt", "et", "mv"},"RawFile_cc");

/*AmosQL query
select m(r), s(r), bt(r), et(r), mv(r) from RawFile r;
*/

/*Add another proxy to queriable in SQL*/
create function sql:RawFile()->(Number m, Number s, Number bt, Number et,  Number mv)  
   as in(rawfile_cc());

add_descr_index_cc('B-tree', #'RAWFILE_CC->NUMBER.NUMBER.NUMBER.NUMBER.NUMBER', 4);

lisp;
(setq _save-intermediates_ t)
(setq *use-dnf* nil)
(setq *enable-aqit* t)

;;; Mark 'rawfile_cc' as core cluster function
(putobject (getfunctionnamed 'rawfile_cc) 'cclusterfct? t)

:osql