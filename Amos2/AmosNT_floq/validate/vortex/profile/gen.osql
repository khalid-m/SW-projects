/* ts function for time window */
create function millTS(Vector v) -> Number
  as select ts
  from Number ts, Integer id, Vector of Number val
  where {ts, id, val} = v;

/* create time window */
create function millWindow(Stream s) -> Stream of Window
  as twindowize(s, #'millTS', 0.1, 0.1);


/* the following populate the database */

/* add the raw data */
addRawData("../../../Vortex/Sandvik/data/mill.csv");

/* size of the raw data */
set rawDataSize() = count(select rawData(i) from Integer i);

/* random offset between 0 - 3300 */
set RandOffsetRange() = floor(0.1 * rawDataSize());

/* profile on */
validation_profile(True);