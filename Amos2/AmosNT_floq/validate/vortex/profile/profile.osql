    where response
    in mergestreams(mapstreams(vectorof(newStreams1(9)), #'millMapper')));
/* 2.53712548888696 */

avg(select response from Number response
      where response
        in mergestreams(mapstreams(vectorof(newStreams1(10)), #'millMapper')));
/* 2.60048757460674 */

count(in(mergestreams(mapstreams(vectorof(newStreams1(10)), #'pass'))));

/****************************************************************************************************/
/*** Q2 ***/

in(millDeviationsW(newStream2(33000, 100, 1)));

centralAvgResponseQ2(1);  /* 2.454185390656 */

centralAvgResponseQ2(2);  /* 2.55610988800066 */

centralAvgResponseQ2(3);  /* 3.3045400527531 */

