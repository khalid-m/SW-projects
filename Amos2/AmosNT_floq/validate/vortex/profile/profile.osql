select centralValidationQ2(i)
from Integer i
where i in iota(1, 10);

select
avg(select response from Number response
    where response
    in mergestreams(mapstreams(vectorof(newStreams2(i)), #'millMapperQ2')))
from Integer i
where i in iota(1,10);

