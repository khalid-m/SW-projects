merge({newsp(siota(1,10))});

/*** central system ***/

/* directly generate the stream based on the data in memory */
count(in(newStream0(rawDataSize(), ezrand(RandOffsetRange()))));  /* 0.273918 sec */

/* directly validate the stream generated by the data in memory */
count(in(millDeviations(newStream0(rawDataSize(), ezrand(RandOffsetRange()))))); /* 2.3281 sec */

/* via socket */
count(uall({newsp(newStream0(rawDataSize(), ezrand(RandoffsetRange())))})); /* 1.5559 sec */

/* validate the stream sent via socket */
count(in(millDeviations(suall({newsp(newStream0(rawDataSize()))})))); /* 2.95708 sec */

/* just merge 10 streams sent via socket, without validation */
count(in(mergestreams(vectorof(newStreams0(10)))));              /* 8.28306 sec */


/*** central valiation ***/

for each Integer i where i in iota(1,10)
count(in(millDeviations(
		mergestreams(vectorof(newStreams0(1))))));  /* avg. 3.25876 s */

/* start up time? */
for each Integer i where i in iota(1,10)
count(in(mergestreams(vectorof(newStreams0(1)))));  /* avg. 1.54141 */

for each Integer i where i in iota(1,10)
count(in(millDeviations(
		mergestreams(vectorof(newStreams0(2))))));  /* avg. 5.82647 sec */


for each Integer i where i in iota(1,10)
count(in(millDeviations(
		mergestreams(vectorof(newStreams0(3))))));  /* avg. 8.84183 sec */

for each Integer i where i in iota(1,10)
count(in(millDeviations(
		mergestreams(vectorof(newStreams0(4))))));  /* avg. 11.4298 sec */

for each Integer i where i in iota(1,10)
count(in(millDeviations(
		mergestreams(vectorof(newStreams0(5))))));  /* avg. 14.2701 sec */

count(in(millDeviations(
		mergestreams(vectorof(newStreams0(6))))));  /* 17.597 sec */

count(in(millDeviations(
		mergestreams(vectorof(newStreams0(7))))));  /* 20.882 sec */

count(in(millDeviations(
		mergestreams(vectorof(newStreams0(8))))));  /* 23.875 sec */

count(in(millDeviations(
		mergestreams(vectorof(newStreams0(9))))));  /* 26.499 sec */

count(in(millDeviations(
		mergestreams(vectorof(newStreams0(10))))));     /* 29.422 sec */



/*** parallelization ***/

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(1)), #'millDeviations'))));  /* avg. 3.32199 sec */

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(2)), #'millDeviations'))));  /* avg. 3.36348 sec */

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(3)), #'millDeviations'))));  /* avg. 3.63399 sec */

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(4)), #'millDeviations'))));  /* avg. 3.73933 sec */

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(5)), #'millDeviations'))));  /* avg. 4.01944 sec*/

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(6)), #'millDeviations'))));  /* avg. 4.39846 sec*/

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(7)), #'millDeviations'))));  /* avg. 4.55408 sec */

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(8)), #'millDeviations'))));  /* avg. 4.68384 sec*/

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(9)), #'millDeviations'))));  /*avg. 4.78524 sec */

for each Integer i where i in iota(1,10)
count(in(mergestreams(mapstreams(vectorof(newStreams0(10)), #'millDeviations')))); /* avg. 5.06439 sec */


/*** stream in calm pace ***/

count(in(newStream1(rawDataSize(), 3300)));

count(in(smjstreamsv(vectorof(newStreams1(10)), 0)));

/* central */

for each Integer i where i in iota(1,10)
  return
    centralAvgResponse(i);

centralAvgResponse(1);  /* avg. 2.17393588766643 */

centralAvgResponse(2);  /* avg. 2.06903965226415 */

centralAvgResponse(3); /* avg. 2.82867743169326 */

centralAvgResponse(4); /* avg. 4.06633278613338 */ 

centralAvgResponse(5); /* avg. 5.67743822141961 */

centralAvgResponse(6); /* avg. 7.44541975760946 */

centralAvgResponse(7); /* avg. 7.70432218764995 */

centralAvgResponse(8); /* avg. 10.4922181550547 */

centralAvgResponse(9); /* avg. 9.96557604135535 */

centralAvgResponse(10); /* avg. 10.8887369897658 */

/* parallel */


for each Integer i where i in iota(1,10)
return
  avg(select response from Number response
    where response
    in mergestreams(mapstreams(vectorof(newStreams1(i)), #'millMapper')));

avg(select response from Number response
    where response
    in mergestreams(mapstreams(vectorof(newStreams1(1)), #'millMapper')));
