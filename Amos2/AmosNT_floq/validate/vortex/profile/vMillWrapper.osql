create function ap(Vector v) -> Number
  as select v[4];

create function ae(Vector v) -> Number
  as select v[21];

create function fz(Vector v) -> Number
  as select v[22];

create function hex(Vector v) -> Number
  as select v[23];

create function vc(Vector v) -> Number
  as select v[24];

create function zt(Vector v) -> Number
  as 4;

create function dcap(Vector v) -> Number
  as select v[5];

create function measuredPower(Vector v) -> Number
  as select v[13];

/* when wrapped like: {ts, id, val} */
create function measuredPower1(Vector v) -> Number
  as select measuredPower(vv)
     from Vector vv
     where vv = v[2];

create function timestamp(Vector v) -> Number
  as v[0];