/* for data generation */
< 'gen.osql';

/* default dump file */
set dumpfile() = getenv("AMOS_HOME") + "\\bin\\profile.dmp";

/* load model and validate */
< 'vMillWrapper.osql';

< 'vMillValidator.osql';


save "C:\\AmosNT\\bin\\profile.dmp";

quit;