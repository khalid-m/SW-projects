/************************************ the schema ****************************************/                        

create function v_ap(Vector v) -> Number
  as select v[4];                                 

create function r_ap(Record r) -> Number
  as select unstringify(cast(v[5]["value"] as Charstring))
  from Vector of Record v
  where v = r["data"];                               

create function v_ae(Vector v) -> Number
  as select v[21];                           

create function r_ae(Record r) -> Number
  as select unstringify(cast(v[22]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];                                 

create function v_fz(Vector v) -> Number
  as select v[22];                               

create function r_fz(Record r) -> Number
  as select unstringify(cast(v[23]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];                              

create function v_hex(Vector v) -> Number
  as select v[23];                       

create function r_hex(Record r) -> Number
  as select unstringify(cast(v[24]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];                                

create function v_vc(Vector v) -> Number
  as select v[24];                                

create function r_vc(Record r) -> Number
  as select unstringify(cast(v[25]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];                             

create function v_kc(Vector v) -> Number
  as select sqrt(4727.9);                       

create function v_zt(Vector v) -> Number
  as 4;                             

create function r_zt(Record r) -> Number
  as 4;                           

create function v_dcap(Vector v) -> Number
  as select v[5];                             

create function r_dcap(Record r) -> Number
  as select unstringify(cast(v[6]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];                          

create function v_power(Vector v) -> Number
  as select v[13];                          

create function r_power(Record r) -> Number
  as select unstringify(cast(v[14]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];                            

create function r_expected_power(Record r) -> Number
  as (r_ap(r)*r_ae(r)*r_fz(r)*r_vc(r)*r_zt(r)*r_kc(r))/(pi()*r_dcap(r)*60000);    

create function r_hm(Record r) -> Number
  as (2*pi()*sin(90*pi()/180)*r_ae(r)*r_fz(r))/(pi()*r_dcap(r)*acos(1-2*r_ae(r)/r_dcap(r)));

create function r_kc(Record r) -> Number
  as 1950*power(r_hm(r), -0.25)*(1-2.5/100);               

create function v_timestamp(Vector v) -> Number
  as v[0];      

create function r_timestamp(Record r) -> Number
  as select unstringify(cast(v[1]["value"] as Charstring))
  from Vector of Record v
  where V = r["data"];      

/****************************************************************************************/                          



/* the computation */                         

create function invalid_v(Vector v, Number interval) -> (Number ts, Number measured, Number expected, Number invalid)
  as
    begin
       set expected = (v_ap(v)*v_ae(v)*v_fz(v)*v_vc(v)*v_zt(v)*v_kc(v))/(pi()*v_dcap(v)*60000);
       set measured = v_power(v);
       set ts = v_timestamp(v);
       if abs(measured-expected) > interval then return (ts, measured, expected, 1)
       else return (ts, measured, expected, 0);
    end;                   

create function invalid_r(Record r, Number interval) -> (Number ts, Number measured, Number expected, Number invalid)
  as
    begin
       set expected = r_expected_power(r);
       set measured = r_power(r);
       set ts = r_timestamp(r);
       if abs(measured-expected) > interval then return (ts, measured, expected, 1)
       else return (ts, measured, expected, 0);
    end;                    

