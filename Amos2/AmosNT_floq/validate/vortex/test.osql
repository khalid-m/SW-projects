/*
create function invalid_r(Record r, Number interval) -> (Number measured, Number expected, Number invalid)
  as (select measured, expected, 1
  where expected = (r_ap(r)*r_ae(r)*r_fz(r)*r_vc(r)*r_zc(r)*r_kc(r))/(pi()*r_dcap(r)*60000)
  and measured = r_power(r) and abs(measured-expected) > interval)
  and (select measured, expected, 0
  where expected = (r_ap(r)*r_ae(r)*r_fz(r)*r_vc(r)*r_zc(r)*r_kc(r))/(pi()*r_dcap(r)*60000)
  and measured = r_power(r) and abs(measured-expected) <= interval);
*/             

create function r_validate0(Stream s, Function invalidf, Number interval)
       				      	     -> Bag of (Number ts, Number measured, Number expected, Number invalid)
  as select ts, measured, expected, invalid
  from Object o
  where o in s and {ts, measured, expected, invalid} = apply(invalidf, {o, interval});                    

create function r_replay(Charstring logfile, Function invalidf, Number interval)
       				    	     -> Bag of (Number ts, Number measured, Number expected, Number invalid)
  as r_validate0(streamof(readfile(logfile)), invalidf, interval);                   

create function r_validate(Stream s, Function invalidf, Number interval, Charstring logfile, Charstring mode)
       -> Bag of (Number ts, Number measured, Number expected, Number invalid)
  as begin
	openlog(logfile, mode);
       	for each Object o, Number ts, Number measured, Number expected, Number invalid
     	    where o in s and {ts, measured, expected, invalid} = apply(invalidf, {o, interval})
	 begin
		if invalid = 1 then write2log(o, logfile);
    	 	return (ts, measured, expected, invalid);
	 end;
	closelog(logfile);
  end;    

r_validate(json_stream_wrapper("python corenet_streamer.py", "localhost", 1337), #'invalid_r', 0, "wrong.log", "w");                                       

r_replay("wrong.log", #'invalid_r', 0);