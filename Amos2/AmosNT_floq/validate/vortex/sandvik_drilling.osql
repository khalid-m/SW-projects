/* function to poll out the relative differences */
/* w.r.t. Statistik20111122.csv */
create function power_difference(Vector v) -> Number as v[3];		                 

create function enumerate(Bag b) -> Bag of Vector
  as begin
       declare Integer i;
       set i = 0;
       for each original Object o where o in b
       begin
         set i = i + 1;
	 return {i, o};
       end;
     end;     

/* raw data w.r.t. drill_raw.csv */
create function drill_start0(Vector v) -> Boolean
  as select v[1] = 0;

create function drill_stop0(Boolean started, Vector v) -> Boolean
  as select v[1] = 8.99 and started;

/* the wear rate */
create function power_sum(Window w) -> Number
  as sum(select v[2]
     	 from Vector of Number v
	 where v in w); 

create function wear_rate(Window reference, Window compare) -> Number
  as select power_sum(compare) / power_sum(reference);

create function power_difference1(Vector v) -> Number as v[1];

create function drill_start(Vector v) -> Boolean
  as select v[1] = 1; 

create function drill_stop(Boolean started, Vector v) -> Boolean
  as select v[1] = 0 and started;

create function drill_record(Vector of Vector vv) -> Vector ref
  as select vv[0];

create function drill_validate(Vector ref, Vector v, Number threshold) -> (Integer isvalid, Vector orgin)
  as begin
       declare Integer avgref, Integer avgv;
       set avgref = avg(select refe[3] from Vector of Number refe where refe in ref);
       set avgv = avg(select ve[3] from Vector of Number ve where ve in v);
       if abs(avgref - avgv) > threshold
       then return (1, v)
       else return (0, v);
     end;