create function input(Charstring file, Function start, Function stop) -> Stream of Window
  as pwindowize(streamof(read_csv(file)), start, stop);         

create function project_bv(Bag of Vector bv, Number d, Number baseline) -> Bag of Vector
  as select project(v, {0, d})
  from Vector of Number v
  where v in bv and abs(v[d]) > baseline; 

create function plot_v(Bag of Vector of Number bv) -> Integer
  as plot(vselect {i, v[i]} from Integer i, Vector of Number v
          where i in iota(0, dim(v)) and v in bv);