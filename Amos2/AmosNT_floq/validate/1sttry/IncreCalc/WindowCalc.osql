/* here comes the accident detection */
create function acc_detection_helper(Window w) -> Bag of Vector as
  select {xway, lane, dir, seg, pos, sec}
	from Integer xway, Integer lane, Integer dir, Integer seg, Integer pos, Integer sec, Integer vidcounts
	where <{xway, lane, dir, seg, pos}, vidcounts> in
		groupby((select {v[1]/*xway*/, v[2]/*lane*/, v[3]/*dir*/, v[4]/*seg*/, v[5]/*pos*/}, v[0]/*vid*/
			 from Vector of Integer v
			 where v in (select v from Vector of Integer v, Integer counts
			 		where <v, counts> = get_incre(w) and counts > 3)),
	  		#'count')
	and vidcounts > 1
	and sec = get_timec(w);

create function w_window_acc(Charstring filename) -> Bag of Vector as
  select acc_detection_helper(w)
	from Window w
	where w in w_create_window(filename, 120, 1);

count(w_window_acc("lr/data/cdp_mid15.out"));

count(w_window_acc("../../Cheng/2010\ Spring/04-26/data/cdp_mid15.out"));

count(w_create_window("../../Cheng/2010\ Spring/04-26/data/cdp_mid15.out", 120, 1));

