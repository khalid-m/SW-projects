testlr('data/cdp_mid15.out');

create function readfilestream(Charstring filename)->Stream
   as streamof(readfile(filename));

create function test_alert(Charstring file, Integer fr, Integer t)-> 
   <Integer acc, Integer timestamp, Integer vehicleid, Integer roadSegment>
  as select r[0], r[1], r[3], r[4]
     from Vector r
     where r in section(readfilestream(file),fr,t);

create function test_t2(Charstring file, Integer fr, Integer t)-> 
   <Integer tp, Integer timestamp, Integer qid, Integer balance>
  as select r[0], r[1], r[3], r[5]
     from Vector r
     where r in section(readfilestream(file),fr,t);

create function test_t3(Charstring file, Integer fr, Integer t)-> 
   <Integer tp, Integer timestamp, Integer qid, Real toll>
  as select r[0], r[1], r[3], r[4]
     from Vector r
     where r in section(readfilestream(file),fr,t);

create function test_tollalert(Charstring file, Integer fr, Integer t)-> 
   <Integer tp, Integer vehicle, Integer timestamp, Real speed, Real toll>
  as select r[0], r[1], r[2], r[4], R[5]
     from Vector r
     where r in section(readfilestream(file),fr,t);


lisp;
