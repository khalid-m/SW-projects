create function printWindow(Stream of Window sw) -> Bag of Object
  as for each Window w where w in sw
    begin
      print("window starts: ");
      for each Object v where v in w
	return v;
      if ts(w) then print({"time stamp is:", ts(w)});
      print("window end!");
   end;

count(printWindow(twindowize(tstream3(25), #'vector.ts->number', 4, 4, -1, #'falsefn', #'truefn'))); 127

count(printWindow(twindowize(tstream3(25), #'vector.ts->number', 5, 3, 2, #'falsefn', #'truefn'))); 392

count(printWindow(twindowize(tstream4(25), #'vector.ts->number', 5, 5, -1, #'jumpstartfn', #'jumpstopfn'))); 145

count(printWindow(twindowize(tstream4(25), #'vector.ts->number', 3, 3, 1, #'jumpstartfn', #'jumpstopfn')));  317

count(printWindow(twindowize(tstream3(25), #'vector.ts->number', 3, 2, -1, #'falsefn', #'truefn')));  195

count(printWindow(twindowize(tstream3(25), #'vector.ts->number', 5, 4, 2, #'falsefn', #'truefn')));  382

count(printWindow(twindowize(tstream4(25), #'vector.ts->number', 4, 2, -1, #'jumpstartfn', #'jumpstopfn')));  229

count(printWindow(twindowize(tstream4(25), #'vector.ts->number', 3, 2, 1, #'jumpstartfn', #'jumpstopfn')));  348

