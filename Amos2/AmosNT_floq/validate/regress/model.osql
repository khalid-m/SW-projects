/* test of window operator */

create function istartp(Integer i) -> Boolean
  as mod(i, 10) = 0;

create function istopp(Integer s, Integer i) -> Boolean
  as mod(i, 10) = 5 and s > 0;

create function vstartp(Vector of Number v) -> Boolean
  as mod(v[0], 10) = 0;

create function vstopp(Vector of Number s, Vector of Number v) -> Boolean
  as mod(v[0], 10) = 5 and dim(s) > 0;

create function istartp1(Integer i) -> Boolean
  as mod(i, 10) = 0;

create function istopp1(Integer s, Integer j) -> Boolean
  as j - s = 10;

create function tstream0(Integer j) -> Bag of Vector
  as for each Integer i where i in iota(1, j)
    begin
      for each Integer k where k in iota(1, i)
      return {i, k};
    end;
create function tstream(Integer j) -> Stream of Vector
  as streamof(tstream0(j));

create function tstream01(Integer j) -> Bag of Vector
  as for each Integer i where i in iota(1, j)
    begin
      if i = 5 then return {-1, -1};  /* jump start event */
      if i = 6 then return {-1, -2};  /* jump end event */
      for each Integer k where k in iota(1, i)
      return {i, k};
    end;
create function tstream1(Integer j) -> Stream of Vector
  as streamof(tstream01(j));

create function tstream02(Integer j) -> Bag of Vector of Integer
  as for each Integer i where i in iota(1, j)
    begin
      for each Integer k where k in iota(1, i)
    return {i, k};
    end;
create function tstream2(Integer j) -> Stream of Vector of Integer
  as streamof(tstream02(j));


create function tstream03(Integer j) -> Bag of Vector
  as for each Integer i where i in iota(1, j)
    begin
      for each Integer k where k in iota(1, i)
      if (i < 10 or i > 18) then return {i, k};
    end;
create function tstream3(Integer j) -> Stream of Vector
  as streamof(tstream03(j));

create function tstream04(Integer j) -> Bag of Vector
  as for each Integer i where i in iota(1, j)
    begin
      if i = 5 then return {-1, -1};  /* jump start event */
      if i = 6 then return {-1, -2};  /* jump end event */
      for each Integer k where k in iota(1, i)
      if (i < 10 or i > 18) then return {i, k};
    end;
create function tstream4(Integer j) -> Stream of Vector
  as streamof(tstream04(j));



create function partVal(Vector of Integer v) -> Integer
  as v[0];


create function ts(Vector v) -> Number as v[0];

create function jumpstartfn(Vector of Number e) -> Boolean
  as e[1] = -1;
create function jumpstopfn(Vector of Number e) -> Boolean
  as e[1] = -2;

/* test of aggregation result */
create function initfn1() -> Vector of Number as {0, 0};
create function addfn1(Vector of Number res, Vector of Number e)
						-> Vector of Number
  as res + e;
create function removefn1(Vector of Number res, Vector of Number e)
						-> Vector of Number
  as res - e;

/*
create function agg1(Window w) -> Vector of Number
  as select window_agg(w, "foo1", #'initfn1', #'addfn1', #'removefn1');
*/

aggregate_function("agg1", "initfn1", "addfn1", "removefn1");

create function initfn2() -> Number as 0;
create function addfn2(Number res, Vector of Number e)
						-> Number
  as res + 1;
create function removefn2(Number res, Vector of Number e)
						-> Number
  as res - 1;

/*
create function agg2(Window w) -> Number
  as select window_agg(w, "foo2", #'initfn2', #'addfn2', #'removefn2');
*/

aggregate_function("agg2", "initfn2", "addfn2", "removefn2");


create function initfn3() -> Number as 0;
create function addfn3(Number res, Number e) -> Number
  as res + e;
create function removefn3(Number res, Number e) -> Number
  as res - e;

aggregate_function("agg3", "initfn3", "addfn3", "removefn3");

create function initfn4() -> Number as 0;
create function addfn4(Number res, Number e) -> Number
  as res + 1;
create function removefn4(Number res, Number e) -> Number
  as res - 1;

aggregate_function("agg4", "initfn4", "addfn4", "removefn4");

/* test of validation */

create function thres(Charstring tp) -> Integer as stored;

set thres("model_n_validate") = 0;
set thres("learn_n_validate") = 60;

create function expected(Integer i) -> Integer as i * i;

create function check_equal(Integer r, Integer x)
                                     -> (Number ts, Integer m)
  as select r, r
     where abs(r - x) > thres("model_n_validate");

create function expectedb(Integer i) -> Bag of Integer as iota(i + 1, i + 2);

create function check_equalb(Integer r, Bag of Integer bx)
				     -> (Number ts, Integer m)
  as begin
	declare Integer ok;
	set ok = 0;
	for each Integer x where x in bx
	if abs(r - x) <= thres("model_n_validate")
	then set ok = 1;
	if ok = 0 then return (r, r);
     end;

create function learnfn(Vector of Window vw) -> Vector of Number
  as sumvectors(select v
  from Vector of Number v
  where v = window2vector(in(vw))) / dim(vw);

create function validatefn(Window r, Vector of Number x)
       				     -> (Number, Vector)
  as select 0, m
     from Vector of Number m
     where m = window2vector(r)
     and euclid(m, x) > thres("learn_n_validate");

create function learnfn_bag(Vector of Window vw) -> Bag of Vector of Number
  as select window2vector(w)
  from Window w
  where w in vw;

create function validatefn_bag(Window r, Bag of Vector of Number ref)
       				                         -> (Number, Vector)
  as begin
	declare Integer ok, Vector of Number rv;
	set ok = 0;
	set rv = window2vector(r);
	for each Vector of Number x where x in ref
	if euclid(rv, x) <= thres("learn_n_validate")
	then set ok = 1;
	if ok = 0 then return (0, rv);
     end;


