 * $State: Exp $ $Locker:  $
 *
 * Description: Python callout regressions tests
 *
 ****************************************************************************
 * $Log: callout.osql,v $
 * Revision 1.17  2011/12/17 16:16:17  torer
 * Storage leaks fixed
 *
 * Revision 1.16  2011/12/14 19:59:20  torer
 * Removed unnecessary coersions
 *
 * Revision 1.15  2011/11/01 21:37:58  torer
 * Replaced Python error messages with Amos errors
 *
 * Revision 1.14  2011/09/13 18:25:52  torer
 * Aggregate functions in Python now work over materialized bags too
 *
 * Revision 1.13  2011/08/30 01:11:31  roka4241
 * Sum with and without using a callback.
 *
 * Revision 1.12  2011/08/08 20:20:06  torer
 * Python foreign TBR definitions without binding patterns
 *
 * Revision 1.11  2011/06/01 15:10:59  roka4241
 * AmosObj objects containing any kind of oidtype are now hashable and comparable. Made NumPy optional by PYAMOS_NUMPY flag.
 *
 * Revision 1.10  2011/05/31 15:19:04  roka4241
 * Fixed amos_map_func in callin. Record to dict conversion.
 *
 * Revision 1.9  2011/05/27 12:38:30  roka4241
 * All foreign function definitions will now reload their target module to detect code added since last time the module was loaded.
 *
 * Revision 1.8  2011/05/24 16:19:20  roka4241
 * Fixed errors in MVC settings. Added support for skipping in an python mapper (return nothing). Also added support for premature breaking. Simplified some regression tests.
 *
 * Revision 1.7  2011/05/20 18:38:54  torer
 * extlang("python");
 * now works!
 *
 * Revision 1.5  2011/05/18 15:03:46  roka4241
 * Fast nested loop join implemented using mapping over generators.
 *
 * Revision 1.4  2011/05/16 15:56:16  roka4241
 * Implemented and tested nested loop join and mergejoin as python foreign functions. Started with a mapped nested loop join.
 *
 * Revision 1.3  2011/05/12 17:55:08  roka4241
 * create two separate streams over the same bag
 *
 * Revision 1.2  2011/05/11 18:26:26  roka4241
 * Opening of streams over amos functions, queries and generators (bags). Implicit and explicit iteration over bag streams from python (either by explicitly opening a stream over the bag and iterating over the stream, or by iterating over the bag directly).
 *
 * Revision 1.1  2011/05/05 16:44:18  roka4241
 * moved the whole project down one directory
 *
 * Revision 1.11  2011/05/02 18:05:59  roka4241
 * Better error handling and regression tests of invalid foreign function specifications that cause a_error errors.
 *
 * Revision 1.10  2011/04/28 18:27:16  roka4241
 * Merged pyiter.c/h into pyobj.c/h and made a new type pyitertype that is 'sort of' a subtype of pyobj.
 *
 * Revision 1.9  2011/04/26 17:53:00  roka4241
 * Merged PyAmosOid, PyAmosScan and PyAmosConn into a single python type PyAmosObj. Will simplify addition of amos generator wrapper.
 *
 * Revision 1.8  2011/04/20 17:16:26  roka4241
 * Returning of scans from amos to python. Calling and mapping over amos functions from python.
 *
 * Revision 1.7  2011/04/07 17:48:21  roka4241
 * Calling of python functions with amos scans and iterating over the scan transparently in python.
 *
 * Revision 1.6  2011/02/24 23:06:04  roka4241
 * Embedding of NumPy. Foreign function definition and calling of python function that returns the NumPy ndarray datatype.
 *
 * Revision 1.4  2011/02/21 17:17:11  roka4241
 * Fixed reloading of foreign functions bug. Initial testing of multidirectional foreign functions defined in python.
 *
 * Revision 1.3  2011/02/18 15:31:33  roka4241
 * Getting compilation and tests running without having to compile python yourself.
 *
 * Revision 1.2  2011/02/17 13:30:59  roka4241
 * Added support for binding patterns to allow unbound arguments and multidirectional functions.
 *
 * Revision 1.1  2011/02/02 13:41:39  roka4241
 * First commit since the file was forgotten last time. Previous commit: testing of foreign functions based on user defined python functions. All common datatypes are tested, including passing of amos oids to python. This commit: testing creation and calling of foreign functions based on builtin python functions.
 *
 ****************************************************************************/

extlang("python");

create function even(Number x) -> Number 
  as select x where mod(x,2)=0;

create function repeat(Object i, Number n) -> Bag of Object o 
  as select i from Integer dummy where dummy in iota(1,n);

create function vectorofcopies(Object i, Number n) -> Vector o 
  as select vectorof(repeat(i,n));

create function vectorwrap(Object i) -> Vector o
  as select {i};

/* Foreign functions defined in Python: */
 
create function pyabs(Number a) -> Number x 
  as foreign 'py:abs';

create function pyfloor(Number a) -> Real x 
  as foreign 'py:math.floor';

create function pyplus(Number a, Number b) -> Number x
  as foreign 'py:regress.callout.plus';

create function pyplusm(Number x, Number y) -> Number r 
  as multidirectional ('bbf' key foreign 'py:regress.callout.plus_bbf')
                      ('bfb' key foreign 'py:regress.callout.plus_bfb') 
                      ('fbb' key foreign 'py:regress.callout.plus_fbb');

create function pyminus(Number a, Number b) -> Number x
  as foreign 'py:regress.callout.minus';

create function pyplus(Charstring a, Charstring b) -> Charstring x
  as foreign 'py:regress.callout.plus';

create function pyiota(Integer start, Integer stop) -> Bag items
  as foreign 'py:regress.callout.iota';

create function pyiota_list(Integer start, Integer stop) -> Vector items
  as foreign 'py:regress.callout.iota_list';

create function pyiota_tuple(Integer start, Integer stop) -> Vector items
  as foreign 'py:regress.callout.iota_tuple';

create function pyiota_dict(Integer start, Integer stop) -> Record items
  as foreign 'py:regress.callout.iota_dict';

create function pyiota_array(Integer start, Integer stop) -> Bag of Object
  /* Not correct. Returns bag */
  as foreign 'py:regress.callout.iota_array';

create function pyiota_pow(Integer start, Integer stop, Number exp) 
                         -> Bag items 
  as foreign 'py:regress.callout.iota_pow';

create function pybounce(Function oid) -> Function oid2
  as foreign 'py:regress.callout.bounce';

create function yield_scan(Scan s) -> Bag of Vector items 
  as foreign 'py:regress.callout.yield_scan';

create function mapf_iota(Integer start, Integer stop) -> Vector items
  as foreign 'py:regress.callout.mapf_iota';

create function callf_iota(Integer start, Integer stop) -> Vector items
  as foreign 'py:regress.callout.callf_iota';

create function callf_plus(Integer a, Integer b) -> Integer c
  as foreign 'py:regress.callout.callf_plus';

create function stream_func_iota(Integer start, Integer stop) -> Vector items
  as foreign 'py:regress.callout.stream_func_iota';

create function stream_query_iota(Integer start, Integer stop) -> Vector items
  as foreign 'py:regress.callout.stream_query_iota';

create function stream_gen_iota(Bag input) -> Vector output
  as foreign 'py:regress.callout.stream_gen';

create function stream_gen_iota2(Bag input) -> Vector output
  as foreign 'py:regress.callout.stream_gen2';

create function iterate_gen_iota(Bag input) -> Vector output
  as foreign 'py:regress.callout.iterate_gen';

create function pynestedloopjoin(Bag l, Bag r, Integer pos) -> Bag items
  as foreign 'py:regress.callout.nestedloopjoin';

create function pymergejoin(Bag l, Bag r, Integer pos) -> Bag items
  as foreign 'py:regress.callout.mergejoin';

create function viota(Integer min, Integer max) -> Bag of Vector items
  as select {i} from integer i where i in iota(min, max);

create function pyfastnestedloopjoin3(Bag l, Bag m, Bag r, Integer pos) 
                                    -> Bag items
  as foreign 'py:regress.callout.fastnestedloopjoin3';

create function map_gen_ret(Bag b) -> Vector items
  as foreign 'py:regress.callout.map_gen_ret';

create function map_gen_even(Bag b) -> Vector items
  as foreign 'py:regress.callout.map_gen_even';

create function map_gen_firstn(Bag b, Integer n) -> Vector items
  as foreign 'py:regress.callout.map_gen_firstn';

create function dict_put(Object key, Object value) -> Object o
  as foreign 'py:regress.callout.dict_put';

create function dict_get(Object key) -> Object o
  as foreign 'py:regress.callout.dict_get';

create function oidtype_cmp0(Object oid1, Object oid2) -> Integer o
  as foreign 'py:regress.callout.oidtype_cmp';

create function oidtype_cmp1(Object oid1, Object oid2) -> Integer o
  as foreign 'py:regress.callout.oidtype_cmp';

create function oidtype_cmp_1(Object oid1, Object oid2) -> Integer o
  as foreign 'py:regress.callout.oidtype_cmp';

create function pysum(Bag l) -> Number n 
  as foreign 'py:regress.callout.mysum';

create function pysum_fast(Bag l) -> Number n 
  as foreign 'py:regress.callout.mysum_fast';

lisp;

(defun tuplelist-to-record (l)
  (let ((r (make-record #())))
    (mapc (f/l (x) 
	       (record-put r (car x) (cadr x)))
	  l)
    r))

(defun zip (&rest args)
  (apply #'mapcar (cons 
		   (f/l (&rest x) 
			x)
		   args)))

;;;
;;; Test Python error messages: 
;;;

(defun str-before (str before)
  (let ((pos (string-pos str before)))
    (if pos         
        (substring 0 (- pos (length before)) str)      
      (substring 0 (length str) str))))

(defun pyerror-const (err)
  (str-before (second (second err)) ","))

(checkequal 
 "Incomplete foreign function signature."
 ((pyerror-const (catch-error (osql "
create function pyerr(Real a) -> Real x 
  as foreign 'py:';")))
  "PYAMOS_ERR_FUNC_MISSING")
 ((pyerror-const (catch-error (osql "create function pyerr(Real a) -> Real x 
                            as foreign 'py:b';")))
  "PYAMOS_ERR_FUNC_DEF")
 )

(checkequal 
 "Non-existing module."
 ((pyerror-const (catch-error (osql "create function pydir(Real a) -> Bag info
                            as foreign 'py:undef.dir';")))
  "PYAMOS_IMPORT_FAILED"))

(checkequal 
 "Non-existing function."
 ((pyerror-const (catch-error (osql "create function pydir(Real a) -> Bag info
                            as foreign 'py:undef_func';")))
  "PYAMOS_ERR_FUNC_DEF"))

(checkequal 
 "Existing non-callable function."
 ((pyerror-const (catch-error (osql "create function pydir(Real a) -> Bag info
                            as foreign 'py:regress.callout.non_func';")))
  "PYAMOS_ERR_FUNC_CALLABLE"))

;;;
;;; Test foreign functions defined in Python:
;;;

(checkequal 
 "Calling foreign function defined as bulitin python function."
 ((osql "pyabs(-2.2);") '((2.2))))

(checkequal 
 "Calling foreign function defined as from python math function."
 ((osql "pyfloor(1.2);") '((1.0))))

(checkequal 
 "Calling foreign function defined as user defined python function."
 ((osql "pyplus(1,5);") '((6))))

(checkequal 
 "Calling multidirectional foreign function defined in python."
 ((osql "pyplusm(1,3);") '((4)))
 ((osql "select x from Number x where pyplusm(x,3)=4;") '((1)))
 ((osql "select x from Number x where pyplusm(3,x)=4;") '((1)))
 ((osql "select where pyplusm(1,2)=3;") '((true)))
 ((osql "select where pyplusm(1,2)=4;") nil)
 )

(checkequal 
 "Integer input and integer output."
 ((osql "pyminus(5,1);") '((4))))

(checkequal 
 "String input and string output."
 ((osql "pyplus('Hello ', 'World!');") '(("Hello World!"))))

(checkequal 
 "Bag output (extracted from generator)."
 ((osql "pyiota(1,8);")(osql "iota(1,8);")))

(checkequal 
 "List output."
 ((osql "pyiota_list(1,8);") (osql "vectorof(iota(1,8));")))

(checkequal 
 "Tuple output."
 ((osql "pyiota_tuple(1,8);")(osql "vectorof(iota(1,8));")))

(checkequal 
 "Dict output."
 ((record-fields 
   (caar (osql "pyiota_dict(1,8);")))
  (record-fields 
   (tuplelist-to-record 
    (zip 
     (mapcar #'car (osql "iota(1,8);"))
     (mapcar #'car (osql "iota(1,8);")))))))

(quote
 (checkequal 
  "Record input and dict output."
  ((caar 
    (osql "create function pydict_get(Record i, Charstring key) -> Object o
                        as foreign 'py:regress.callout.dict_get';
                      pydict_get({'a': {'b': 1}}, 'a');"))
   (caar (osql "{'b': 1};"))))
 )

(checkequal 
 "Array output (treated as sequence)."
 ((osql "pyiota_array(1,8);") (osql "iota(1,8);")))

(checkequal 
 "Bag output (yielded values)."
 ((osql "pyiota_pow(1,8,3.1415);")
  (osql "iota(1,8)^3.1415;")))

(checkequal 
 "Oidtype input and oidtype output."
 ((caar (osql "pybounce(functionnamed('typeof'));"))
  (caar (osql "functionnamed('typeof');"))))

(checkequal 
 "Call foreign function based on builtin (__builtin__) python function."
 ((caar (osql "pyabs(-5);"))
  5))

(checkequal 
 "Call foreign function based on builtin library (math) function."
 ((caar (osql "pyfloor(4.9);"))
  4))

(quote (checkequal 
	"Reload foreign function."
	((caar                
	  (let* 
	      ((file (openstream "regress\\_reload.py" "w")))
	    (formatl file 
		     "import math" T            
		     "def pow_incorrect(base, exp):" T
		     "  return math.pow(base*2, exp)" T) 
	    (flush file)
	    (closestream file)
	    (osql "
create function pypow_incorrect(Real base, Real exp) -> Real r 
                        as foreign 'py:bbf:regress._reload.pow_incorrect';")
	    (osql "pypow_incorrect(2,7);")))
	 16384)
	((caar                
	  (let* 
	      ((file (openstream "regress\\_reload.py" "w")))
	    (delete-file "regress\\_reload.pyc")
	    (formatl file 
		     "import math" T            
		     "def pow_incorrect(base, exp):" T
		     "  return math.pow(base, exp)" T) 
	    (flush file)
	    (closestream file)
	    (osql "py_reload('py:bbf:regress._reload.pow_incorrect');")
	    (osql "pypow_incorrect(2,7);")))
	 128)))


; Uncomment if NumPy support is included (by setting the PYAMOS_NUMPY flag)
(quote (checkequal 
	"Multidimensional ndarray output (NumPy)."
	((caar (osql "
create function np_square(Integer size) -> Vector of Vector r
                            as foreign 'py:bf:regress.callout.numpy_square';  
                          np_square(3);")) 
	 #(#(0 1 2) 
	   #(3 4 5) 
	   #(6 7 8)))
	((caar (osql "select a from Integer a where pyplusm(1,a)=6;")) 5)
	((caar (osql "select a from Integer a where pyplusm(a,5)=6;")) 1)))

(checkequal 
 "Iterate over amos scan and yield the items back to amos."
 ((osql "open :s for iota(1,8);
         yield_scan(:s);")
  (osql "vectorwrap(iota(1,8));")))

(checkequal  "Call function that maps over an amos function."
	     ((osql "mapf_iota(1,8);")
	      (osql "vectorof(iota(1,8));")))

(checkequal "Call function that calls an bag-returning amos function."
            ((osql "callf_iota(1,8);")
             (osql "vectorof(vectorwrap(iota(1,8)));")))

(checkequal "Call function that calls an integer-returning amos function."
            ((osql "callf_plus(1,8);")
             (osql "vectorof(vectorof(plus(1,8)));")))

(checkequal "Call function that wraps a function call in a stream 
and yields the items of the stream back to amos."
            ((osql "stream_func_iota(1,8);")
             (osql "vectorwrap(iota(1,8));")))

(checkequal "Call function that wraps an amos query in a stream 
and yields the items of the stream back to amos."
            ((osql "stream_query_iota(1,8);");; leak!
             (osql "vectorwrap(iota(1,8));")))

(checkequal "Call function that wraps an amos generator (bag) in a stream 
and yields the items of the stream back to amos."
            ((osql "stream_gen_iota(iota(1,8));")
             (osql "select {el} from Integer el where el in iota(1,8);"))
            ((osql "stream_gen_iota2(iota(1,8));")
             (osql "select {v[i]} from Vector v, Integer i 
where i in iota(0,16) and v = concat(vectorof(iota(1,8)), 
                                     vectorof(iota(1,8)));")))

(checkequal "Call function that iterates over a bag 
(by implicitly creating a stream) 
and yields the items of the bag back to amos."
            ((osql "iterate_gen_iota(iota(1,8));")
             (osql "vectorwrap(iota(1,8));")))

(checkequal "Call function that joins two bags using a nested loop join."
            ((osql "pynestedloopjoin(iota(1,8), iota(4,12), 0);")
             (osql "select {el, el} from Integer el where el in iota(4,8);")))

(checkequal "Call function that joins two bags using a merge join."
            ((osql "pymergejoin(iota(1,8), iota(4,12), 0);")
             (osql "vectorofcopies(iota(4,8), 2);")))

(checkequal "Call function that joins three bags using a fast nested loop join"
            ((osql "
pyfastnestedloopjoin3(viota(1,8), viota(5,7), viota(4,12), 0);");;leak!
             (osql "vectorofcopies(iota(5,7), 3);")))

(checkequal "Call function that maps over an amos bag."
            ((osql "map_gen_ret(iota(1,8));")
             (osql "vectorof(iota(1,8));")))

(checkequal "Call function that maps over an amos integer bag using a 
python mapper that only returns even numbers."
            ((osql "map_gen_even(iota(1,8));")
             (osql "even(iota(1,8));")))

(checkequal "Premature break from python mapper"
            ((osql "map_gen_firstn(iota(1,8), 4);")
             (osql "iota(1,4);")))
(quote
 (checkequal 
  "Foreign function definitions reload their target module."
  ((caar                
    (let* 
	((file (openstream "regress\\_import.py" "w")))
      (formatl file 
	       "import math" T            
	       "def pow(base, exp):" T
	       "  return math.pow(base, exp)" T) 
      (flush file)
      (closestream file)
      (osql "create function pypow(Real base, Real exp) -> Real r 
                        as foreign 'py:bbf:regress._import.pow';")
      (osql "pypow(2,7);")))
   128)
  ((caar                
    (let* 
	((file (openstream "regress\\_import.py" "w")))
      (delete-file "regress\\_import.pyc")
      (formatl file 
	       "import math" T            
	       "def pow(base, exp):" T
	       "  return math.pow(base, exp)" T         
	       "def pow2(base, exp):" T
	       "  return math.pow(base, exp)" T) 
      (flush file)
      (closestream file)
      (osql "create function pypow2(Real base, Real exp) -> Real r 
                        as foreign 'py:bbf:regress._import.pow2';")
      (osql "pypow2(2,7);")))
   128))
 )

(checkequal "Test using oidtype as key in a dict."
            ((osql "dict_put(#'euclid', #'iota');
                    dict_get(#'euclid');")
             (osql "#'iota';")))

(checkequal "Test comparing oidtypes ."
            ((caar (osql "oidtype_cmp0(#'euclid', #'euclid');"))
             '0)
            ((caar (osql "oidtype_cmp1(#'euclid', #'iota');"))
             '1)
            ((caar (osql "oidtype_cmp_1(#'iota', #'euclid');"))
             '-1))


(checkequal 
 "Test of sum using implicit conversion of amos generator to stream."
 ((osql "pysum(iota(1,512));")
  (osql "sum(iota(1,512));"))
 ((osql "pysum(materialize(iota(1,512)));")
  (osql "sum(iota(1,512));"))
 )

(checkequal 
 "Test of sum using callbacks."
 ((osql "pysum_fast(iota(1,512));")
  (osql "sum(iota(1,512));"))
 ((osql "pysum_fast(materialize(iota(1,512)));")
  (osql "sum(iota(1,512));"))
 )

:osql;

rollback;
