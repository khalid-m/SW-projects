/* 	query_handler(..)börjar med att sätta en commitpunkt.
 * 	Sedan läggs QEL tripler in i tripelrymd, skapas QEL fråga, 
 * 	översätts denna till AmosQL samt exekveras denna. 
 * 	Slutligen skickas resultat tillbaka som scan av vektorer populerade med strängar.
 * 	Till sista rullas samtliga operationer under procedur tillbaka. På så vis slipper 
 * 	vi problem med herrelösa variabler.
 */
	create function query_handler(vector st)->vector
	as
	begin
		declare vector v1, vector v2, vector res, rdf_query q1, 
                        charstring dbdir, jdbc a;
		eval("commit;");
		for each integer i 
                    where i in iota(0,an_int(minus(count(st),1)))
		begin
	   		set v1 = st[i];
	   		new_RDF_statement(a_string(v1[0]),a_string(v1[1]),
                                          a_string(v1[2]));
	   	end;
		migrate_all();
		select q into q1 from rdf_query q;
		return eval_query(q1);
		eval("rollback;");
	end;