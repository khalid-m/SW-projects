 *
 * Description: Load PSELOServer.
 ****************************************************************************/
lisp;
(stdoutstream (openstream "log/pselo.log" "a"))
(print (concat "Starting PSELO at:" (timeval-to-date(gettimeofday))))
(setq _debugging_ t)
(setq _batch_ t)
(load-amosql "src/amosql/extension.amosql")	;Load PSELO extended tSpace fns and stmt fn.
:osql
getenv("PATH");
getenv("CLASSPATH");
getenv("NSPORT");
nameserverport(cast(atoi(getenv('NSPORT')) as integer));
lisp;
(print *nsp*)
:osql
nameserver("PSELO");
listen();
