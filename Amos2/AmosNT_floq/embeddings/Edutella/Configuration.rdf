 <pd:javaClass>net.jxta.edutella.service.timer.TimerServiceImpl</pd:javaClass>
</pd:Component>
<pd:Component rdf:about="#ConsoleService">
 <pd:javaClass>net.jxta.edutella.service.socket.SocketServiceImpl</pd:javaClass>
 <pd:hasComponent rdf:resource="#ConsoleComponents"/>
</pd:Component>

<rdf:Seq rdf:about="#ConsoleComponents">
<rdf:li rdf:resource="#ConsolePool"/>
</rdf:Seq>

<pd:Component rdf:about="#ConsolePool">
  <pd:javaClass>net.jxta.edutella.component.processor.WorkerServiceImpl</pd:javaClass>
  <pd:moduleProcessorResource rdf:resource="#ConsoleProcessor"/>
  <pd:registerWith rdf:resource="#ConsoleService"/>
</pd:Component>


<pd:Processor rdf:about="#ConsoleProcessor">
