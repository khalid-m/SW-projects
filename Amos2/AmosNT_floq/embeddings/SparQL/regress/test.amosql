in(sortbagby((select approval,name from Literal rq,Literal name,Literal data,Literal rslt,Literal approval,Literal reason
where TestInfo(rq)=<name,data,rslt,approval,"Passed",reason>),1,"dec"));

print("<----------------Failed---------------->");
in(sortbagby((select reason,approval,name from Literal rq,Literal name,Literal data,Literal rslt,Literal approval,Literal reason
where TestInfo(rq)=<name,data,rslt,approval,"Failed",reason>),{1,2},{"dec","dec"}));

