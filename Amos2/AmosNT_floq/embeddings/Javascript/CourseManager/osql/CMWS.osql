/******* broadcast mailer **********************/
load_amosql("osql/server.osql");
create function mailall(charstring sender, charstring subject, charstring message)->charstring as 
select smtp_sendmail("smtp.uu.se", sender, x, subject, message)
from charstring x 
where x in (select email(a) from assistant a) 
or x in (select email(a) from lecturer a)
or x in (select email(a) from student a);

/******* registration of grades ****************/

create function notifyStudent(student s, assignment a, charstring stat, assistant assist)->charstring as
  select smtp_sendmail("smtp.uu.se", email(assist), 
                              email(s), "DBT: Updated assignment status", 
  "This is an automated message.

--------

" +
  firstName(assist) + " " + lastName(assist) + 
  " has updated the status of assignment " + 
  stringify(assNo(a)) +
  " (" + title(a) + "). New status is " + stat + "." +
  "

--------

Assignments that must be completed and resubmitted, can be collected by
visiting the assistant.

Good luck!

--------
");

/*add course specified*/

create function updateStudentAssignment
(student s, assignment a, charstring stat, assistant assist)
 -> boolean
as begin
     set respAssistant(s, a) = assist;
     set worksOn(s,a) = <stat,now()>;
    notifyStudent(s, a, stat, assist);
  result TRUE;
end;


/*add course specified*/
create function updateStudentAssignment
(charstring sname, integer an, charstring stat, charstring aname, charstring cname)
 -> boolean
as select updateStudentAssignment(studentNamed(sname),
                                  a,
                                  stat,
                                  assistantNamed(aname))
   from assignment a
   where assNo(a) = an and coursename(a)=cname;

/*add course specified*/
create function updateStudentAssignmentExp
(charstring sname, integer an, charstring stat, charstring aname, charstring cname)
-> charstring succ
as if (updateStudentAssignment(sname,an,stat,aname,cname)) 
		then 
			result 'succ'
		else
			result 'fail';

/*add course specified*/

create function updateGroupAssignment
(integer gr, assignment a, charstring stat, assistant assist, charstring cname)
 -> boolean
as begin
for each student s
     where group(s,cname) = gr and coursename(a)=cname and coursename(s)=cname
       begin 
        updateStudentAssignment(s,a,stat,assist);
       end;
       result TRUE;
end;


/*add course specified*/
create function updateGroupAssignment
(charstring sname, integer an, charstring stat, charstring aname, charstring cname)
 -> boolean succ
as select updateGroupAssignment(group(studentNamed(sname),cname),
                                a,
                                stat,
                                assistantNamed(aname),
                                cname) 
   from assignment a 
   where assNo(a) = an and coursename(a)=cname and coursename(studentNamed(sname))=cname;

/*add course specified*/
create function updateGroupAssignmentExp
(charstring sname, integer an, charstring stat, charstring aname, charstring cname)
-> charstring succ
as if (updateGroupAssignment(sname,an,stat,aname,cname)) 
		then 
			result 'succ'
		else
			result 'fail';
/************ student info ********/

create function assignmentStatus(student s)
 -> <integer, charstring, charstring>
as select assNo(a), latestStatus(s,a), fullName(respAssistant(s,a))
from assignment a;

create function assignmentStatus(student s, charstring cname)
 -> <integer, charstring, charstring>
as select assNo(a), latestStatus(s,a), fullName(respAssistant(s,a))
from assignment a where coursename(a)=cname;


create function assignmentStatus(charstring sname)
 -> <integer, charstring, charstring>
 as select assignmentStatus(studentNamed(sname));

create function studentInfoPublic(student s)
 -> <charstring, charstring, charstring>
as select fullName(s), email(s), groupToString(group(s,cname)) from charstring cname where cname in coursename(s);

create function studentInfoPublic(student s, charstring cname)
 -> <charstring, charstring, charstring>
as select fullName(s), email(s), groupToString(group(s,cname));

create function studentInfoPublic(charstring sname)
 -> <charstring, charstring, charstring>
as select studentInfoPublic(studentNamed(sname));

create function studentInfoFull(student s)
 -> <charstring, charstring, charstring, charstring, charstring>
as select fullName(s),
          email(s),
          name(s),
          pn(s),
          groupToString(group(s,cname))from charstring cname where cname in coursename(s);

create function studentInfoFull(student s, charstring cname)
 -> <charstring, charstring, charstring, charstring, charstring,vector>
as select fullName(s),
          email(s),
          name(s),
          pn(s),
           groupToString(group(s,cname)), sortbagby(assignmentStatus(s,cname), 1, 'inc');


create function studentInfoFull(charstring sname)
 -> <charstring fullname, charstring email, charstring name, charstring pnumber, charstring group>
as select studentInfoFull(studentNamed(sname));



create function studentInfoFullAss(student s)
 -> <charstring, charstring, charstring, charstring, charstring, vector>
as select fullName(s),
          email(s),
          name(s),
          pn(s),
          groupToString(group(s,cname)),
          sortbagby(assignmentStatus(s), 1, 'inc') 
    from charstring cname where cname in coursename(s);

create function studentInfoFullAss(student s, charstring cname)
 -> <charstring, charstring, charstring, charstring, charstring,vector>
as select fullName(s),
          email(s),
          name(s),
          pn(s),
         groupToString(group(s,cname)),
          sortbagby(assignmentStatus(s,cname), 1, 'inc');

create function studentInfoFullAss(charstring sname)
 -> <charstring, charstring, charstring, charstring, charstring, vector>
as select studentInfoFullAss(studentNamed(sname));



/******* REPORTS called from JSP **********************************/
/*add course specified*/
create function listStudents(integer col, charstring order, charstring cname) -> vector students
as select
   sortbagby((select studentInfoPublic(s,cname) from student s where coursename(s) = cname),
             col,
             order);

/*add course specified*/
create function listStudentsFull(integer col, charstring order, charstring cname) -> vector stufull
as select
   sortbagby((select studentInfoFull(s,cname) from student s where coursename(s) = cname),
             col,
             order);

/*add course specified*/
create function listStudentsFullAss(integer col, charstring order, charstring cname) -> vector fullassignment
as select
   sortbagby((select studentInfoFullAss(s,cname) from student s where coursename(s)=cname),
             col,
             order);

/*add course specified*/
create function listLonelyStudents(integer col, charstring order, charstring cname) -> vector lonelystu
as select
   sortbagby((select studentInfoPublic(s,cname)
              from student s
              where coursename(s) = cname and ((count(groupMembers(group(s,cname),cname)) = 1 and 
                    (group(s,cname) != -1)) or
                    group(s,cname) = -1)),
            col,
            order);

/*add course specified*/
create function selectstudentInfoFull(charstring sname, charstring cname)
->  bag of <charstring fullname, charstring email, charstring name, charstring pnumber, charstring group>
as select fullname, email,name,pnumber, group from student s, vector vec where name(s)=sname and studentInfoFull(s,cname)=< fullname, email,name,pnumber, group,vec>;

/*add course specified*/
create function listGroupMembers(charstring sname, charstring cname)
 -> bag of <charstring stuname, charstring emptys, charstring groups>
as select studentInfoPublic(groupMembers(group(s,cname),cname),cname) from student s where name(s)= sname;

/*add course specified*/

create function studentAssignmentStatus(charstring sname, charstring cname) -> vector assstatus
as select
   sortbagby((select assignmentStatus(s,cname) from student s where name(s)= sname and coursename(s)=cname),
             1,
             'inc');

/*add course specified*/
create function assignmentInfo(charstring cname) -> vector assinfo
as select
   sortbagby((select assNo(a), title(a)
              from assignment a where coursename(a)=cname),
             1,
             'inc');

/******** Web service Functions *******************************/
create function login1(charstring uname,charstring pwd,charstring coursename) -> user us
as begin
	if (typename(userNamed(uname))='ASSISTANT')
	then
		select u into us from user u where name(u) = uname and password(u)=pwd and assistants(courseNamed(coursename))=u
	else
		if (typename(userNamed(uname))='LECTURER')
		then
			select u into us from user u where name(u) = uname and password(u)=pwd and responsible(courseNamed(coursename))=u
		else
			select u into us from user u where name(u) = uname and password(u)=pwd and coursename(cast(u as student))=coursename;
	result us;
end;


create function login(charstring uname,charstring pwd,charstring coursename) -> charstring usertype
as begin 
  if some(userNamed(uname)) 
  then
  	if (login1(uname,pwd,coursename) = userNamed(uname))
  	then
  	result typename(login1(uname,pwd,coursename))
  	else 
  	result 'none';
	
end;
  
create function registerstudent
(charstring firstName, charstring lastName, charstring userName, charstring pwd, charstring email, charstring personalNumber, charstring coursename) 
-> charstring studentname
as begin
  if notany(userNamed(userName)) 
    then
     result name(student(firstName,lastName,userName,pwd,email,personalNumber,coursename))
  else
     if (coursename(cast (userNamed(userName) as Student))=coursename)
     then
       result 'false'
     else
      begin
	add coursename(cast(userNamed(userName) as Student))=coursename;
        add group(cast(userNamed(userName) as Student),coursename)=-1;
        for each assignment a where coursename(a) = coursename
         begin
          add worksOn(cast(userNamed(userName) as Student),a) = <"UNKNOWN", now()>;
         end;
        result name(cast(userNamed(userName) as Student));
      end;
end;

create function registergroupvalidate(charstring studentName, charstring studPassword)
-> charstring
as begin
	if (password(studentNamed(studentName)) = studPassword)
	then
		result studentName
	else
	  result 'false';
end;

create function studentexist(charstring studName, charstring studPwd, charstring cname)
-> boolean
as select some(s) from student s where name(s) = studName and coursename(s) = cname;

create function registerstudentgroup(charstring studName, charstring studPwd, charstring cname)
-> charstring registergroupResult
as begin
	if (studentexist(studName, studPwd, cname))
	then 
		result registergroupvalidate(studName, studPwd)
	else
		result 'none';
end;

create function checkauthority (charstring userName)
-> charstring usertype
as select distinct typename(userNamed(userName));

create function existcourse()-> vector coursenames
as select
   sortbagby((select name(c) from course c),
             1,
             'inc');
create function executesql(charstring q)-> bag of vector as evalv(q);


