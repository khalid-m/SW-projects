load_lisp("osql/server.lsp");

create function println(Charstring str, Charstring file, Charstring mode) 
                -> Boolean
  as foreign 'println---';

create function CourseId()->Charstring 
  /* The ID of the current course database */
  as stored; 

create function unloadCM()->Charstring script
  /* Unload the current course database to its recover script */
  as begin set script = "courses/"+courseID()+"_unload.osql";
           unload(script);
           result script;
     end;

create function smtp_sendmail(Charstring smtp_server, Charstring f, 
                              Charstring r, Charstring subject, 
                              Charstring message) -> Charstring 
  /* Sendmail from AmosQL */
  as foreign 'amosql-sendmail';

create function generate_server(Charstring id, Charstring home, 
                                Charstring option) -> Boolean
  /* Generate server database image named ID.
     The database image is located in folder WEB-INF under folder HOME.
     If OPTION='recover' the unloaded database named ID will be reloaded,
        othewise an empty database is created */
  as foreign "generate-server";




