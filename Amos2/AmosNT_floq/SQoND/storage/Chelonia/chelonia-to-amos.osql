        "SELECT taskId FROM tasks t, experiments e WHERE t.taskName = '" + taskName + 
        "' AND e.expId = t.expId AND e.expName = '"+expName+"';"))) as Integer);
  end; */

create function getTaskId(Charstring dbname, Charstring expName, Charstring taskName) -> Bag of Integer
  as cast(unstringify(Chelonia_parse_strings(queryToURL(dbname,
        "SELECT taskId FROM tasks t, experiments e WHERE t.taskName = '" + taskName + 
        "' AND e.expId = t.expId AND e.expName = '"+expName+"';"))) as Integer);

create function addValue(Charstring dbname, Integer taskId, Charstring vName, Literal value) -> Boolean
  as foreign 'addValue----';



