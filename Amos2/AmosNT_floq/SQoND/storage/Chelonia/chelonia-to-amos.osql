/* QUERIES */

create function queryToURL(Charstring dbname, Charstring query) -> Bag of Charstring
  as foreign "JAVA:CheloniaConnector/queryToURL";

load_lisp('chelonia-output-parsers.lsp');
load_lisp('chelonia-store.lsp');

create function getAllExperiments(Charstring dbname) -> Bag of Charstring
  as select Chelonia_parse_strings(queryToURL(dbname,"SELECT expName FROM experiments;"));

create function getTasks(Charstring dbname, Charstring expName) -> Bag of (Charstring, Integer)
  as select Chelonia_parse_string_ints(queryToURL(dbname,
        "SELECT taskName, taskId FROM tasks t, experiments e WHERE e.expId = t.expId AND e.expName = '"+expName+"';"));

create function getVars(Charstring dbname, Integer taskId) -> Bag of Charstring
  as select Chelonia_parse_strings(queryToURL(dbname,
	"(SELECT vName from iTriples WHERE taskId=" + taskId + 
	") UNION DISTINCT (SELECT vName FROM fTriples WHERE taskId = " + taskId + 
	") UNION DISTINCT (SELECT vName FROM sTriples WHERE taskId = " + taskId +
	") UNION DISTINCT (SELECT vName FROM aTriples WHERE taskId = " + taskId + ");"));

create function getAllVars(Charstring dbname, Charstring tasklist) -> Bag of (Charstring, Integer)
  as select Chelonia_parse_string_ints(queryToURL(dbname,
	"(SELECT vName,taskId from iTriples WHERE taskId IN (" + taskList + 
	")) UNION DISTINCT (SELECT vName,taskId FROM fTriples WHERE taskId IN (" + taskList + 
	")) UNION DISTINCT (SELECT vName,taskId FROM sTriples WHERE taskId IN (" + taskList +
	")) UNION DISTINCT (SELECT vName,taskId FROM aTriples WHERE taskId IN (" + taskList + "));"));

create function getValue(Charstring dbname, Integer taskId, Charstring vName) -> Bag of Literal
  as select Chelonia_str_to_literal(Chelonia_parse_literals(queryToURL(dbname,
	"(SELECT 'i' AS type, value FROM iTriples WHERE taskId = " + taskId + " AND vName = '" + vName + 
	"') UNION (SELECT 'f' AS type,  value FROM fTriples WHERE taskId = " + taskId + " AND vName='" + vName + 
	"') UNION (SELECT 's' AS type, value FROM sTriples WHERE taskId = " + taskId + " AND vName='" + vName + 
	"') UNION (SELECT concat('p',elementsType) AS type, dimension AS value FROM aTriples a WHERE taskId = " + 
	taskId + " AND vName='" + vName + "');"), dbname, taskId, vName, ''));

create function getSubArray(Charstring dbname, Integer taskId, Charstring vName, Charstring rangeStr) -> Bag of Literal
  as select Chelonia_parse_literals(queryToURL(dbname,
        "SELECT concat('a',elementsType) AS type, read_data('" + rangeStr + "', a.blobId, '1') AS value FROM aTriples a WHERE taskId = " + 
	taskId + " AND vName='" + vName + "';"), dbname, taskId, vName, rangeStr);

create function printOutput(Charstring dbname, Charstring query, Integer chunks) -> Boolean
  as select Chelonia_print_output(queryToURL(dbname,query),chunks);


/* UPDATES */

create function sendUpdate(Charstring dbname, Charstring query) -> Boolean
  as foreign "JAVA:CheloniaConnector/update";

create function addExperiment(Charstring dbname, Charstring expName) -> Boolean
  as select sendUpdate(dbname,"INSERT INTO experiments (expName) VALUES ('" + expName + "');");

create function addTask(Charstring dbname, Charstring expName, Charstring taskName) -> Boolean
  as select sendUpdate(dbname,
	"INSERT INTO tasks (expId,taskName) VALUES((SELECT expId FROM experiments WHERE expName = '" + expName + 
	"'),'" + taskName + "');");

