< 'chelonia-to-amos.osql';

load_lisp('chelonia-wrapper.lsp');

/* CHELONIA WRAPPED EXPERIMENT */

create type CWE properties (graph Charstring, namespace Charstring, db Charstring, experiment Charstring);

/* CACHING TASKS AND VARS */

create function ch_tasks(CWE e) -> Bag of Integer tid as stored;

create function ch_vars(CWE e, Integer tid) -> Bag of Charstring v as stored;

create function refresh_tasks(CWE e, Boolean doQuery) -> Boolean as 
  begin
    remove ch_tasks(e) = id from Integer id;
    if doQuery then
      add ch_tasks(e) = id from Charstring s, Integer id 
        where (s,id) in getTasks(db(e),experiment(e));
  end;

create function refresh_vars(CWE e, Boolean doQuery) -> Boolean as
  begin 
    declare Charstring tlcb;   
    remove ch_vars(e,tid) = v from Charstring v, Integer tid;
    if doQuery then 
    begin
      set tlcb = stringify(vectorof(select ch_tasks(e)));
      add ch_vars(e,tid) = vname from Charstring vname, Integer tid
        where (vname,tid) in getAllVars(db(e),substring(tlcb,1,char_length(tlcb)-2)); 
    end;
  end;

create function refresh_CWE(CWE e, Boolean doQuery) -> Boolean as
  begin
    refresh_tasks(e,doQuery);
    refresh_vars(e,doQuery);
  end;

/* INITIALIZING */

create function CheloniaExperiment(Charstring graph, Charstring namespace, Charstring db, Charstring experiment) -> CWE as
  begin
    declare CWE res;
    create CWE(graph, namespace, db, experiment) instances res (graph, namespace, db, experiment);
    add_prefix_if_empty(graph, namespace);
    refresh_CWE(res,true);
    return res;
  end;

create function rdf:CheloniaExperiment(Literal graph, Literal namespace, Literal db, Literal experiment) -> CWE as
  CheloniaExperiment(rdf_str(graph), rdf_str(namespace), rdf_str(db), rdf_str(experiment));

create function rdf:CheloniaExperiment(Literal namespace, Literal db, Literal experiment) -> CWE as
  CheloniaExperiment('', rdf_str(namespace), rdf_str(db), rdf_str(experiment));

/* ACCESSING */

create function graphToCWE(Charstring graph) -> CWE as
  select e from CWE e where graph(e) = graph;

create function CW(CWE e) -> Bag of (Literal, Literal, Literal) as
  select tid2uri(namespace(e),tid), URI(namespace(e)+p), getValue(db(e), tid, p)
    from Charstring p, Integer tid
   where tid in ch_tasks(e)
     and p in ch_vars(e, tid);


