set :rdfstore = jdbc("rdfstore","com.mysql.jdbc.Driver");

connect(:rdfstore, "jdbc:mysql://localhost:3306/rdfstore", "root", "");

read_sql(:rdfstore,"setup.sql");

disconnect(:rdfstore);
