load_lisp('sql-naive.lsp');

set :rdfstore = jdbc("rdfstore","com.mysql.jdbc.Driver");

connect(:rdfstore, "jdbc:mysql://localhost:3306/rdfstore", "root", "");

import_table(:rdfstore,"triples",true);

/* Triple store interface function */
create function SDEF() -> Bag of (Literal s, Literal p, Literal o)
  as select storeToRDF(s(tr),1), storeToRDF(p(tr),1), StoreToRDF(o(tr),otype(tr)) 
       from TRIPLES_RDFSTORE tr;

/* Set the next generated blank node number relative to number of triples currently in the store */
Update_last_blank(cast(sql(:rdfstore,'SELECT COUNT(*) FROM Triples')[0] as Integer) * 3);

/* Blank node lookup */
create function URI_in_SDEF(JDBC conn, Charstring x) -> Boolean
  as some(sql(conn,"SELECT * FROM Triples WHERE s = '" + x +
	           "' OR p =' " + x + "' OR (o = '" + x + "' AND otype = 1)"));






