/* :chunksize needs to be set before running this script! */

< 'settings_ms.osql';

< 'utils.osql';

set :rdfstore = jdbc("rdfstore", :driver);

connect(:rdfstore, :connection_str, :username, :password);

load_lisp("sql-store-utils.lsp");

create function setupDB(JDBC conn, Integer chunksize) -> Boolean as
begin
  read_sql(conn, "setup.tsql"); /* Create schema */
  sql(conn, "ALTER TABLE arrayChunks ALTER COLUMN chunk " + hex_based({"BINARY(", "CHAR("}) 
            + stringify(chunksize*(1+cast(tlvar('isHex') as Integer))) +")");
  sql(conn, /* SQL containing ';' cannot be handled by read_sql() */
      "CREATE FUNCTION mod (@x int, @y int)
         RETURNS int
       BEGIN
         DECLARE @q float;
         SET @q = 1.0*@x/@y;
         RETURN ROUND((@q - FLOOR(@q))*@y, 0);
       END;");
  sql(conn, "SET IDENTITY_INSERT URI ON; INSERT INTO URI(id,uri) VALUES (?,?)", {sqlStoreDefaultURIs()}); /* Populate default URIs into URI table */
  sql(conn, "INSERT INTO Parameters VALUES ('chunksize',?)", {chunksize}); /* Store  parameters */
end;

setupDB(:rdfstore, :chunksize);

disconnect(:rdfstore);
