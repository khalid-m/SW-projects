/* Load all 7 tables */

create function fmtDir() -> Charstring as stored;

set fmtDir() = getenv('AMOS_HOME')+"/SQoND/storage/sql/bulkloader/fmt/";

create function acVolumeFile(Charstring dumpfileprefix, Integer i) -> Charstring
  as dumpfileprefix + "_ac" + i + hex_based({".dat", ".csv"});

/* Making use of MS SQL Server format files created with command:

bcp <dbname>.dbo.<tablename> format nul -f fmt/<filename>.Fmt -n -T

that were to set all storage types to SQLCHAR, prefix length to 0, field length to 0,
added delimiters and removed 'graph' fields

If isHex=0, binary files are loaded into ArrayChunks  instead, compatible with ones created with command

bcp <dbname>.dbo.ArrayChunks out <filename> -n -T

*/


create function BulkLoad(JDBC conn, Charstring dumpfileprefix) -> Boolean as
begin
  declare Integer i;

  sql(conn, "DELETE FROM Parameters");

  sql(conn, "BULK INSERT Parameters FROM '"+ dumpfileprefix +"_par.csv' WITH ( FIELDTERMINATOR=',' )");

  sql(conn, "ALTER TABLE arrayChunks ALTER COLUMN chunk " + hex_based({"BINARY(", "CHAR("})
            + stringify((1 + cast(tlvar('isHex') as Integer)) * cast(sql(conn, "SELECT value FROM parameters WHERE name='chunksize'")[0] as Integer)) 
            + ")");

  sql(conn, "DELETE FROM URI");

  sql(conn, "BULK INSERT URI FROM '"+ dumpfileprefix +"_uri.csv' WITH ( FORMATFILE='"+ fmtDir() +"URI.Fmt', KEEPIDENTITY)");

  sql(conn, "BULK INSERT URITriples FROM '"+ dumpfileprefix +"_ut.csv' WITH ( FORMATFILE='"+ fmtDir() +"URITriples.Fmt')");

  sql(conn, "BULK INSERT LongStrings FROM '"+ dumpfileprefix +"_ls.csv' WITH ( FORMATFILE='"+ fmtDir() +"LongStrings.Fmt', KEEPIDENTITY)");

  sql(conn, "BULK INSERT LiteralTriples FROM '"+ dumpfileprefix +"_lt.csv' WITH ( FORMATFILE='"+ fmtDir() +"LiteralTriples.Fmt')");

  sql(conn, "BULK INSERT ArrayTriples FROM '"+ dumpfileprefix +"_at.csv' WITH ( FORMATFILE='"+ fmtDir() +"ArrayTriples.Fmt', KEEPIDENTITY)");

  set i = 0;
  while file_exists(acVolumeFile(dumpfileprefix,i)) do
    print("Loading "+acVolumeFile(dumpfileprefix,i));
    sql(conn, "BULK INSERT ArrayChunks FROM '"+ acVolumeFile(dumpfileprefix, i)
              + hex_based({"' WITH ( DATAFILETYPE='native')", "' WITH ( FORMATFILE='"+ fmtDir() +"ArrayChunks.Fmt')"}));
    set i = i + 1;
  end while;
end;
