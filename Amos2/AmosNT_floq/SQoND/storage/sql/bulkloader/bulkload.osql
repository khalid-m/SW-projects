 *
 * Description: Bulk-loader script into MySQL-based RDF store (as alternative to setup.osql)
 *
 ****************************************************************************
 * $Log: bulkload.osql,v $
 * Revision 1.3  2013/07/14 11:15:48  andan342
 * Using Integer parameters to nma2chunks function, truly parametrized BINARY/HEX chunk storage
 *
 * Revision 1.2  2013/03/21 10:33:58  andan342
 * Updated to use new ../settings.osql file
 *
 * Revision 1.1  2013/01/11 17:30:49  andan342
 * Added bulk-loading and dumper functionality
 *
  *
 ****************************************************************************/

< 'settings.osql';
< '../settings.osql';

< 'bulkloader.osql';

set :rdfstore = jdbc("rdfstore",:driver);

connect(:rdfstore, :connection_str, :username, :password);

/* (Re-)create schema */

read_sql(:rdfstore,"../setup.sql");

/* Load all 7 tables */

BulkLoad(:rdfstore, :dumpfileprefix, :isHex);

disconnect(:rdfstore);


