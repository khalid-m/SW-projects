/* Load all 6 tables */

create function acVolumeFile(Charstring dumpfileprefix, Integer i) -> Charstring
  as dumpfileprefix + "_ac" + i + ".csv";

create function BulkLoad(JDBC conn, Charstring dumpfileprefix) -> Boolean as
begin
  declare Integer i;

  sql(conn, "SET foreign_key_checks = 0");

  sql(conn, "LOAD DATA LOCAL INFILE ? REPLACE INTO TABLE Parameters
             FIELDS TERMINATED BY ','", {dumpfileprefix+"_par.csv"});

  if (tlvar('isHex') = 1) then
    sql(conn, "ALTER TABLE arrayChunks CHANGE chunk chunk varchar(?)", 
        {2 * cast(sql(conn, "SELECT value FROM parameters WHERE name='chunksize'")[0] as Integer)});
	
  sql(conn, "LOAD DATA LOCAL INFILE ? IGNORE INTO TABLE uri
             FIELDS TERMINATED BY ','", {dumpfileprefix+"_uri.csv"});

  sql(conn, "LOAD DATA LOCAL INFILE ? INTO TABLE uritriples
             FIELDS TERMINATED BY ',' 
             (s, p, o)", {dumpfileprefix+"_ut.csv"});

  sql(conn, "LOAD DATA LOCAL INFILE ? INTO TABLE longstrings
             FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '\"'", {dumpfileprefix+"_ls.csv"});

  sql(conn, "LOAD DATA LOCAL INFILE ? INTO TABLE literaltriples
             FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '\"'
             (s, p, o, type, longstr)", {dumpfileprefix+"_lt.csv"});

  /* BUG workaround: MySQL inserts 0 for integer fields absent in source file even with DEFAULT NULL */
  sql(conn, "UPDATE literaltriples SET longstr=NULL where longstr=0"); 

  sql(conn, "SET foreign_key_checks = 1");

  sql(conn, "LOAD DATA LOCAL INFILE ? INTO TABLE arraytriples
             FIELDS TERMINATED BY ',' 
             (s, p, type, arrayid, ndims, size0, size1, size2, size3)", {dumpfileprefix+"_at.csv"});

  set i = 0;
  while file_exists(acVolumeFile(dumpfileprefix,i)) do
    print("Loading "+acVolumeFile(dumpfileprefix,i));
    if (tlvar('isHex') = 1) then /* load HEX chunks as they are */
      sql(conn, "LOAD DATA LOCAL INFILE ? INTO TABLE arraychunks
                 FIELDS TERMINATED BY ',' 
                 (arrayid,chunkid,chunk)", {acVolumeFile(dumpfileprefix, i)})
    else /* convert HEX to BINARY with MySQL 'unhex' function */
      sql(conn, "LOAD DATA LOCAL INFILE ? INTO TABLE arraychunks
                 FIELDS TERMINATED BY ',' 
                 (arrayid,chunkid, @hexchunk) 
                 SET chunk = unhex(@hexchunk)", {acVolumeFile(dumpfileprefix, i)}); 
    set i = i + 1;
  end while;
end;