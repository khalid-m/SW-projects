< 'utils.osql';

load_amosql('bulkloader/' + dialect_based({'bulkloader.osql', 'bulkloader_ms.osql'})); /* BUG: doesn't work with logging off! */

logging off;

load_lisp('sql-store.lsp');

/**************** INITIALIZING ****************/

set_nma_proxy_threshold(:nma_proxy_threshold);

create function rdfstore() -> JDBC as stored;

set rdfstore() = jdbc("rdfstore", :driver);

create function arraychunksize() -> Integer as stored;

create function refresh_parameters() -> Boolean as
begin
  set arraychunksize() = first(sql(rdfstore(),"SELECT value FROM Parameters WHERE name = 'chunksize'")[0]);
  set_chunksize(arraychunksize());
  sql_setMaxBinarySize(rdfstore(), arraychunksize());
end;

/*************** URI LOOKUP, UPDATE & CACHE FUNCTIONS *****************/

create function URI_cache(Integer id key) -> URI uri key as stored; 

create_index("URI_cache", "id", "mbtree", "unique");

create_index("URI_cache", "uri", "hash", "unique"); /* TODO: Trie index might work better here */

create function refresh_URI_cache(Boolean doQuery) -> Boolean as 
  begin
    remove URI_cache(id) = uri from Integer id, URI uri;
    if doQuery then
      add URI_cache(id) = URI(uristr) from Integer id, Charstring uristr
        where {id,uristr} = sql(rdfstore(),"SELECT id, uri FROM URI");
  end;

create function lookupOrAddURI(URI uri) -> Integer id 
as begin 
  declare Bag of Integer ids;
  set ids = (select id from Integer id where URI_cache(id) = uri); 
  if notany(ids) then
  begin
    if (tlvar('sql_dialect') = 'tsql') then
    begin
      set ids = materialize(select sql(rdfstore(), "INSERT INTO URI(uri) OUTPUT INSERTED.id VALUES (?)", {URI_id(uri)})[0]);      
    end else
    begin
      sql(rdfstore(),"INSERT INTO URI(uri) VALUES (?)",{URI_id(uri)});
      set ids = materialize(select sql(rdfstore(),"SELECT LAST_INSERT_ID()")[0]); 
    end;
    add URI_cache(first(ids)) = uri;
  end;
  return first(ids);
end;


/************** CONNECTING TO RDF STORE ******************/

connect(rdfstore(), :connection_str, :username, :password);

refresh_parameters();

refresh_URI_cache(true);

/************** MAPPED TYPES FOR SQL VIEWS ***************/

add amos_type_from_generic_relational('TEXT') = typenamed('charstring'); /* TODO: should you table defined in JDBC Wrapper */

import_table(rdfstore(), get_db_name(:connection_str), :username, "GeneralView", "GViewType", true, {}); 
/* MySQL: import_table(rdfstore(), "GeneralView", true); */

create function GView() -> Bag of (Integer s, Integer p, Charstring o, Integer otype)
 as select s(gv),p(gv),o(gv),otype(gv) from GViewType gv;

create function DEF() -> Bag of (Literal ss, Literal pp, Literal oo)
 as select URI_cache(s), URI_cache(p), storeToRDF(o,otype)
      from Integer s, Integer p, Charstring o, Integer otype
     where (s,p,o,otype) in GView();

create function SDEF() -> Bag of (Literal ss, Literal pp, Literal oo) as stored;

create function refresh_SDEF(Boolean doQuery) -> Boolean as 
  begin 
    if rdf_cache_enabled() then /* Does nothing if cache is disabled */
    begin
      remove SDEF() = (s, p, o) from Literal s, Literal p, Literal o;
      if doQuery then
        add SDEF() = DEF();
    end;
  end;

create function set_enable_rdf_cache(Boolean x) -> Boolean as
  begin
    set_enable_rdf_cache_internal(x);
    refresh_SDEF(true);
  end;

/******************* UPDATES ********************/

create function RDFToStore(Literal x) -> (Charstring str, Integer xtype)
 as select str,xtype 
     where storeToRDF(str,xtype) = x;

create function insertArrayTriple(Vector vs) -> Integer
as begin
     declare Integer arrayid;
     if (tlvar('sql_dialect') = 'tsql') then
     begin
       set arrayid = first(sql(rdfstore(),"INSERT INTO ArrayTriples(s,p,type,ndims,size0,size1,size2,size3) OUTPUT INSERTED.arrayid VALUES (?,?,?,?,?,?,?,?)", vs)[0]);
     end else 
     begin
       sql(rdfstore(), "INSERT INTO ArrayTriples(s,p,type,ndims,size0,size1,size2,size3) VALUES (?,?,?,?,?,?,?,?)", vs);
       set arrayid = first(select sql(rdfstore(), "SELECT LAST_INSERT_ID()")[0]); 
     end;
     return arrayid;
end;

create function storeArray(Literal x, Integer arrayid) -> Boolean
as begin
     sql(rdfstore(),"INSERT INTO ArrayChunks(arrayid,chunkid,chunk) VALUES (?,?,?)", concat({arrayid}, {nma2chunks(cast(x as NMA), ArrayChunkSize(), 
                                                                                                                   cast(tlvar('isHex') as Integer))}));
end;

create function storeTriple(Literal ss, Literal pp, Literal oo) -> Boolean
/* store Triple in the backend, but not in cache */
as begin
     declare Integer s, Integer p, Integer otype, Charstring ostr, Integer arrayid;
     set s = lookupOrAddURI(cast(ss as URI));
     set p = lookupOrAddURI(cast(pp as URI));
     set (ostr, otype) = RDFToStore(oo);
     if (otype = 0) then 
     begin
       sql(rdfstore(),"INSERT INTO URITriples(s,p,o) VALUES (?,?,?)",{s,p,lookupOrAddURI(cast(oo as URI))});
     end else if (otype = 7) then
     begin
       sql_setAutoCommit(rdfstore(),0);
       storeArray(oo, insertArrayTriple(concat({s,p}, getNMAMeta(oo))));
       sql_commit(rdfstore());
       sql_setAutoCommit(rdfstore(),1);
     end else 
     begin
       if (char_length(ostr) > 32) then 
       begin
         sql(rdfstore(),"INSERT INTO LongStrings(str) VALUES(?)",{ostr});
         sql(rdfstore(),"INSERT INTO LiteralTriples(s,p,o,type,longstr) VALUES (?,?,'',?,LAST_INSERT_ID())",{s,p,otype});
       end else 
         sql(rdfstore(),"INSERT INTO LiteralTriples(s,p,o,type) VALUES (?,?,?,?)",{s,p,ostr,otype});
     end;
end;

/* delete function rdf:insert; */

create function rdf:insert(Literal s, Literal p, Literal o) -> Boolean
/* Insert triple both to backend and cache */
  as begin 
    storeTriple(s,p,o);
    if rdf_cache_enabled() then
    begin
      add SDEF() = (s, p, o);
    end;
  end;


/******************* ADDITIONAL ACCESS FUNCTIONS ***************/

create function URI_in_DEF(Charstring x) -> Boolean
  as some(sql(rdfstore(),"SELECT id FROM URI WHERE uri = ?",{x}));

create function getArrayChunks(Integer arrayid) -> Bag of Vector
  as sql(rdfstore(),"SELECT chunkid, chunk FROM ArrayChunks WHERE arrayid = ?",{arrayid}); 

create function getArrayChunk(Integer arrayid, Integer Chunkid) -> Bag of Object
  as sql(rdfstore(),"SELECT chunk FROM ArrayChunks WHERE arrayid = ? AND chunkid = ?",{arrayid,chunkid})[0]; 

create function getArrayChunksByPattern(Integer arrayid, Integer origin, Integer divisor, Charstring modlist) -> Bag of Vector
  as sql(rdfstore(), "SELECT chunkid, chunk FROM ArrayChunks WHERE arrayid = ? AND chunkid >= ? AND " 
                     + dialect_based({"", "dbo."}) + "mod(chunkid-?, ?) in (" + modlist + ")", {arrayid, origin, origin, divisor});

InitSQLProxies();

create function reconnect_rdf(Charstring connection_str, Charstring username, Charstring password) -> Boolean as
begin
  connect(rdfstore(), connection_str, username, password);
  refresh_parameters();
  refresh_URI_cache(true);
  refresh_SDEF(true);
end;

refresh_SDEF(true);


/******************* BULK LOADER FUNCTION *********************/

/*
load_amosql('bulkloader/' + dialect_based({'bulkloader.osql', 'bulkloader_ms.osql'}));
*/

< 'bulkloader/settings.osql';

create function rdf:bulkload(Boolean doClear) -> Boolean as
begin
  if doClear then rdf:clear();
  BulkLoad(rdfstore(), cast(tlvar('dumpfileprefix') as Charstring));
  refresh_parameters();
  refresh_URI_cache(true);
  refresh_SDEF(true);
end;


