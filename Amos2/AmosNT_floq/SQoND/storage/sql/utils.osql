/* Return binding of top-level Amos variable */

lisp;

(foreign-lispfn tlvar ((Charstring v)) ((Object)) 
	(foreign-result (eval (mksymbol (concat "amos_" v)))))

:osql

/* return options[0] if MySQL, options[1] if T-SQL */
create function dialect_based(Vector of Charstring options) -> Charstring
as begin
  if (tlvar('sql_dialect') = 'tsql') then return options[1]
  else return options[0];
end;

/* return options[0] if binary chunks, options[1] if hex chunks */
create function hex_based(Vector of Charstring options) -> Charstring
  as options[cast(tlvar('isHex') as Integer)];