/* :chunksize needs to be set before running this script! */

< 'settings.osql';

set :rdfstore = jdbc("rdfstore", :driver);

connect(:rdfstore, :connection_str, :username, :password);

load_lisp("sql-store-utils.lsp");

/* Create schema */

create function setupDB(JDBC conn, Integer chunksize, Integer isHex) -> Boolean as
begin
  read_sql(conn, "setup.sql");
  if (isHex = 1) then /* Store chunks as HEX strings (BLOBs by default) */
    sql(conn, "ALTER TABLE arrayChunks CHANGE chunk chunk VARCHAR(?)", {chunksize * 2});
  sql(conn, "INSERT INTO URI(id,uri) VALUES (?,?)", {sqlStoreDefaultURIs()}); /* Populate default URIs into URI table */
  sql(conn, "INSERT INTO Parameters VALUES ('chunksize',?)", {chunksize}); /* Store  parameters */
end;

setupDB(:rdfstore, :chunksize, :isHex);

disconnect(:rdfstore);
