 /*-*-sql-*-*******************************************************************
 * AMOS2
 *
 * Author: (c) 2007 Johan Petrini, UDBL
 * 
 * Description: Scalability experiment increasing the synthetic content query, 
 * SQ2_tbls_cols (as defined here), size over a fixed synthetically generated 
 * database size and UPV definition size. All queries are defined in RDQL.
 * 
 * We measure optimization times for strategies END, END-P, DPS, DVS-P.
 *
 * ID: SQ2opt
 *
 * Parameters:
 * We used two different database sizes (nt=1, nc=8 and nt=8, nc=10).
 *
 * In the scenario with database size (nt=1, nc=8) the query (SQ2_1tbl_?) 
 * was scaled the from 0-7 joins (step 1)where clauses, that is, 
 * the ppt was scaled from 1-8. 
 * The script synopt1db.cmd was used to generate the database.
 *
 * In the scenario with database size (nt=8, nc=10) the query (SQ2_8tbl_?)
 * was scaled the from 3-31 (step 4) joins, that is, 
 * the ppt was fixed to 4 but the number of relational joins was scaled from 0-7.
 * The script synopt10db.cmd was used to generate the database.
 *
 * The machine used was a PC with a 2.26 GHz Pentium 4 processor and 
 * 512 MB running Windows XP.
 *
 * As DBMS we use InterBase.
 * Size of database is 1 row.
 *
 * MSSQL Server is stopped. 
 *****************************************************************************/
/* Experiment steps
 */
  set :f = compileQuery();
  call_function(:f,{}); 

/* Variables are used to facilitate changes in data.
 * Change in one place instead of several places.
 */
set :tbl = 1;				   /* Number of tbls */
set :col = 8;				   /* Number of cols in each tbl */
set :strategy = "END";			   /* Scenario */
set :pe = true;				   /* Partial evaluation on/off. On is default in SWARD*/

/* Define DS for SQ relational database with 1 table.
 */
defineDS("SQDS",
         "jdbc:interbase://localhost/" + getenv('SWARD_ROOT') + "/bin/SQ.gdb",
         "interbase.interclient.Driver",
         "",
         "",
         "SYSDBA",
         "masterkey");


/* Define UPV 'sq' associated with data source 'SQDS'. 
 */
defineUPV("SQDS","Sq","http://upv/com/sq/");

/* Connect to predefined data source assigned to UPV 'eGov'. 
 */
DSConnect("Sq");	

/* Speed up UPV generation.
 */
lisp;
(defglobal get-columnscache)
(memo 'get-columnscache 'get-columns (list 'ds 'table))
:osql

/* End of setup of synthetic test database
 */

/* Populate SWARD system tables 
 */

/* Automatically generate property and class mappings for cols and tbls 
 * by calling fn genPMap and genCMap.
 */
genPMap(sort(mktblvector(:tbl)),"Sq");
genCMap(sort(mktblvector(:tbl)),"Sq");

/* End of populating SWARD system tables 
 */

/* Autogenerate UPV
 */
dispatch(:strategy,"Sq");

/* Test queries
 */
set :SQ2_1_1 =
	"SELECT ?c1
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1)";

set :SQ2_1_2 = 
	"SELECT ?c1, ?c2
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2)";

set :SQ2_1_3 =
	"SELECT ?c1, ?c2, ?c3
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3)";

set :SQ2_1_4 =
	"SELECT ?c1, ?c2, ?c3, ?c4
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4)";

set :SQ2_1_5 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s1, <http://upv.com/schemas/sq#t1.c5>, ?c5)";

set :SQ2_1_6 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s1, <http://upv.com/schemas/sq#t1.c5>, ?c5),
	(?s1, <http://upv.com/schemas/sq#t1.c6>, ?c6)";

set :SQ2_1_7 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s1, <http://upv.com/schemas/sq#t1.c5>, ?c5),
	(?s1, <http://upv.com/schemas/sq#t1.c6>, ?c6),
	(?s1, <http://upv.com/schemas/sq#t1.c7>, ?c7)";

set :SQ2_1_8 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7, ?c8
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s1, <http://upv.com/schemas/sq#t1.c5>, ?c5),
	(?s1, <http://upv.com/schemas/sq#t1.c6>, ?c6),
	(?s1, <http://upv.com/schemas/sq#t1.c7>, ?c7),
	(?s1, <http://upv.com/schemas/sq#t1.c8>, ?c8)";

set :SQ2_8_8 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s2, <http://upv.com/schemas/sq#t2.c2>, ?c1),
