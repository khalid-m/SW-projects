	(?s4, <http://upv.com/schemas/sq#t4.c4>, ?c13)";	

set :SQ2_8_20 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7, ?c8, 
		?c9, ?c10, ?c11, ?c12, ?c13, ?c14, ?c15, ?c16  
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s2, <http://upv.com/schemas/sq#t2.c2>, ?c1),
	(?s2, <http://upv.com/schemas/sq#t2.k>, ?c5),
	(?s2, <http://upv.com/schemas/sq#t2.c3>, ?c6),
	(?s2, <http://upv.com/schemas/sq#t2.c4>, ?c7),	
	(?s3, <http://upv.com/schemas/sq#t3.c2>, ?c5),
