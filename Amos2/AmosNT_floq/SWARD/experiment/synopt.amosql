	(?s3, <http://upv.com/schemas/sq#t3.c3>, ?c9),
	(?s3, <http://upv.com/schemas/sq#t3.c4>, ?c10),
	(?s4, <http://upv.com/schemas/sq#t4.c2>, ?c8),
	(?s4, <http://upv.com/schemas/sq#t4.k>, ?c11),
