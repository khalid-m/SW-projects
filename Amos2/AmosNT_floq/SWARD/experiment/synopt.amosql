	(?s3, <http://upv.com/schemas/sq#t3.c4>, ?c10)";	

set :SQ2_8_16 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7, ?c8, 
		?c9, ?c10, ?c11, ?c12, ?c13  
