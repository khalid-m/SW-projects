	(?s2, <http://upv.com/schemas/sq#t2.c2>, ?c1),
	(?s2, <http://upv.com/schemas/sq#t2.k>, ?c5),
	(?s2, <http://upv.com/schemas/sq#t2.c3>, ?c6),
	(?s2, <http://upv.com/schemas/sq#t2.c4>, ?c7),	
	(?s3, <http://upv.com/schemas/sq#t3.c2>, ?c5),
	(?s3, <http://upv.com/schemas/sq#t3.k>, ?c8),
	(?s3, <http://upv.com/schemas/sq#t3.c3>, ?c9),
	(?s3, <http://upv.com/schemas/sq#t3.c4>, ?c10),
	(?s4, <http://upv.com/schemas/sq#t4.c2>, ?c8),
	(?s4, <http://upv.com/schemas/sq#t4.k>, ?c11),
	(?s4, <http://upv.com/schemas/sq#t4.c3>, ?c12),
	(?s4, <http://upv.com/schemas/sq#t4.c4>, ?c13),
	(?s5, <http://upv.com/schemas/sq#t5.c2>, ?c11),
	(?s5, <http://upv.com/schemas/sq#t5.k>, ?c14),
	(?s5, <http://upv.com/schemas/sq#t5.c3>, ?c15),
	(?s5, <http://upv.com/schemas/sq#t5.c4>, ?c16),
	(?s6, <http://upv.com/schemas/sq#t6.c2>, ?c14),
	(?s6, <http://upv.com/schemas/sq#t6.k>, ?c17),
	(?s6, <http://upv.com/schemas/sq#t6.c3>, ?c18),
	(?s6, <http://upv.com/schemas/sq#t6.c4>, ?c19)";	

set :SQ2_8_28 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7, ?c8, 
		?c9, ?c10, ?c11, ?c12, ?c13, ?c14, ?c15, ?c16,
		?c17, ?c18, ?c19, ?c20, ?c21, ?c22  
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s2, <http://upv.com/schemas/sq#t2.c2>, ?c1),
	(?s2, <http://upv.com/schemas/sq#t2.k>, ?c5),
	(?s2, <http://upv.com/schemas/sq#t2.c3>, ?c6),
	(?s2, <http://upv.com/schemas/sq#t2.c4>, ?c7),	
	(?s3, <http://upv.com/schemas/sq#t3.c2>, ?c5),
	(?s3, <http://upv.com/schemas/sq#t3.k>, ?c8),
	(?s3, <http://upv.com/schemas/sq#t3.c3>, ?c9),
	(?s3, <http://upv.com/schemas/sq#t3.c4>, ?c10),
	(?s4, <http://upv.com/schemas/sq#t4.c2>, ?c8),
	(?s4, <http://upv.com/schemas/sq#t4.k>, ?c11),
	(?s4, <http://upv.com/schemas/sq#t4.c3>, ?c12),
	(?s4, <http://upv.com/schemas/sq#t4.c4>, ?c13),
	(?s5, <http://upv.com/schemas/sq#t5.c2>, ?c11),
	(?s5, <http://upv.com/schemas/sq#t5.k>, ?c14),
	(?s5, <http://upv.com/schemas/sq#t5.c3>, ?c15),
	(?s5, <http://upv.com/schemas/sq#t5.c4>, ?c16),
	(?s6, <http://upv.com/schemas/sq#t6.c2>, ?c14),
	(?s6, <http://upv.com/schemas/sq#t6.k>, ?c17),
	(?s6, <http://upv.com/schemas/sq#t6.c3>, ?c18),
	(?s6, <http://upv.com/schemas/sq#t6.c4>, ?c19),
	(?s7, <http://upv.com/schemas/sq#t7.c2>, ?c17),
	(?s7, <http://upv.com/schemas/sq#t7.k>, ?c20),
	(?s7, <http://upv.com/schemas/sq#t7.c3>, ?c21),
	(?s7, <http://upv.com/schemas/sq#t7.c4>, ?c22)";	

set :SQ2_8_32 =
	"SELECT ?c1, ?c2, ?c3, ?c4, ?c5, ?c6, ?c7, ?c8, 
		?c9, ?c10, ?c11, ?c12, ?c13, ?c14, ?c15, ?c16,
		?c17, ?c18, ?c19, ?c20, ?c21, ?c22, ?c23, ?c24, 
		?c25  
	FROM <http://upv/com/sq/>
	WHERE (?s1, <http://upv.com/schemas/sq#t1.k>, ?c1),
      	(?s1, <http://upv.com/schemas/sq#t1.c2>, ?c2),
	(?s1, <http://upv.com/schemas/sq#t1.c3>, ?c3),
	(?s1, <http://upv.com/schemas/sq#t1.c4>, ?c4),
	(?s2, <http://upv.com/schemas/sq#t2.c2>, ?c1),
	(?s2, <http://upv.com/schemas/sq#t2.k>, ?c5),
	(?s2, <http://upv.com/schemas/sq#t2.c3>, ?c6),
	(?s2, <http://upv.com/schemas/sq#t2.c4>, ?c7),	
	(?s3, <http://upv.com/schemas/sq#t3.c2>, ?c5),
	(?s3, <http://upv.com/schemas/sq#t3.k>, ?c8),
	(?s3, <http://upv.com/schemas/sq#t3.c3>, ?c9),
	(?s3, <http://upv.com/schemas/sq#t3.c4>, ?c10),
	(?s4, <http://upv.com/schemas/sq#t4.c2>, ?c8),
	(?s4, <http://upv.com/schemas/sq#t4.k>, ?c11),
	(?s4, <http://upv.com/schemas/sq#t4.c3>, ?c12),
	(?s4, <http://upv.com/schemas/sq#t4.c4>, ?c13),
	(?s5, <http://upv.com/schemas/sq#t5.c2>, ?c11),
	(?s5, <http://upv.com/schemas/sq#t5.k>, ?c14),
	(?s5, <http://upv.com/schemas/sq#t5.c3>, ?c15),
	(?s5, <http://upv.com/schemas/sq#t5.c4>, ?c16),
	(?s6, <http://upv.com/schemas/sq#t6.c2>, ?c14),
	(?s6, <http://upv.com/schemas/sq#t6.k>, ?c17),
	(?s6, <http://upv.com/schemas/sq#t6.c3>, ?c18),
	(?s6, <http://upv.com/schemas/sq#t6.c4>, ?c19),
	(?s7, <http://upv.com/schemas/sq#t7.c2>, ?c17),
	(?s7, <http://upv.com/schemas/sq#t7.k>, ?c20),
	(?s7, <http://upv.com/schemas/sq#t7.c3>, ?c21),
	(?s7, <http://upv.com/schemas/sq#t7.c4>, ?c22),
	(?s8, <http://upv.com/schemas/sq#t8.c2>, ?c20),
	(?s8, <http://upv.com/schemas/sq#t8.k>, ?c23),
	(?s8, <http://upv.com/schemas/sq#t8.c3>, ?c24),
	(?s8, <http://upv.com/schemas/sq#t8.c4>, ?c25)";


/* Parse queries
 */
set :dl_1_1 = parse_rdql(:SQ2_1_1);
set :dl_1_2 = parse_rdql(:SQ2_1_2);
set :dl_1_3 = parse_rdql(:SQ2_1_3);
set :dl_1_4 = parse_rdql(:SQ2_1_4);
set :dl_1_5 = parse_rdql(:SQ2_1_5);
set :dl_1_6 = parse_rdql(:SQ2_1_6);
set :dl_1_7 = parse_rdql(:SQ2_1_7);
set :dl_1_8 = parse_rdql(:SQ2_1_8);
set :dl_8_8 = parse_rdql(:SQ2_8_8);
set :dl_8_12 = parse_rdql(:SQ2_8_12);
set :dl_8_16 = parse_rdql(:SQ2_8_16);
set :dl_8_20 = parse_rdql(:SQ2_8_20);
set :dl_8_24 = parse_rdql(:SQ2_8_24);
set :dl_8_28 = parse_rdql(:SQ2_8_28);
set :dl_8_32 = parse_rdql(:SQ2_8_32);

/* Experiment post-settings 
 */
enable_parteval(:pe);

/* End of experiment post-settings 
 */

/* Cost based optimization in SQLServer  
 */

/* Measure compilation (optimization) and execution time in MSSQL Server
 * using the 'STATISTICS' facility explained in the MSSQL Server on-line manual.
 */
SET STATISTICS TIME ON

/* END, END-P, DVS-P  
 */

/* 0 RDQL join 
 */
select K from T1

/* 4 RDQL join 
 */
select K,C2,C3,C4,C5 from T1

/* 7 RDQL join 
 */
select K,C2,C3,C4,C5,C6,C7,C8 from T1

/* 1 SQL join 
 */
select 	T1_.K,
	T1_.C2,
	T1_.C3,
	T1_.C4,
	T2_.K,
	T2_.C3,
	T2_.C4 
from T1 T1_,T2 T2_
where T2_.C2 = T1_.K

/* 5 SQL join 
 */
select 	T1_.K,
	T1_.C2,
	T1_.C3,
	T1_.C4,
	T2_.K,
	T2_.C3,
	T2_.C4,
	T3_.K,
	T3_.C3,
	T3_.C4,
	T4_.K,
	T4_.C3,
	T4_.C4,
	T5_.K,
	T5_.C3,
	T5_.C4,
	T6_.K,
	T6_.C3,
	T6_.C4 
from T1 T1_,T2 T2_,T3 T3_,T4 T4_,T5 T5_,T6 T6_
where T2_.C2 = T1_.K and T3_.C2 = T2_.K and T4_.C2 = T3_.K and T5_.C2 = T4_.K and T6_.C2 = T5_.K and T7_.C2 = T6_.K

/* 6 SQL join 
 */
select 	T1_.K,
	T1_.C2,
	T1_.C3,
	T1_.C4,
	T2_.K,
	T2_.C3,
	T2_.C4,
	T3_.K,
	T3_.C3,
	T3_.C4,
	T4_.K,
	T4_.C3,
	T4_.C4,
	T5_.K,
	T5_.C3,
