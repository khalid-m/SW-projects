//uriflag==0, source
//uriflag==1, prefix (... for URI)
//uriflag==2, URI in rdfTriple
//uriflag==3, URI in PrimaryExpression
void URI(int uriflag) :
{/*@bgen(jjtree) URI */
 SimpleNode jjtn000 = new SimpleNode(JJTURI);
 boolean jjtc000 = true;
 jjtree.openNodeScope(jjtn000);
