public Rdql2Amos() {
}

public void reinit() {
	wholeQuery=new String[10];
	selectVariables=new Vector();
	sources=new Vector();
	rdfTripleVariables=new Vector();
	rdfTriples=new Vector();
	prefixvec=new Vector();
	constraintvec=new Vector();
	andVar=0;
}


        public String upvofuri(String uri){
	Tuple argl;
	String res;
	
	res = "";
	try{
	argl = new Tuple(1);
	Connection tmpConnection = new Connection("");
	argl.setElem(0,uri);
	res = tmpConnection.callFunction("charstring.upvofuri->charstring",argl).getRow().getStringElem(0);
	}catch(AmosException e){}	
	return res;
    }

public String output() {
        	
/************** remove doubles in rdfTripleVariables ************************************/
        	
        	for (int a=0;a<rdfTripleVariables.size();a++)	{
				int last=rdfTripleVariables.lastIndexOf(rdfTripleVariables.get(a));
				if (last!=a)	{
					rdfTripleVariables.remove(last);
					a--;
				}
			}
			
/*************** handling of the select variables following ***************************************/           	        	        	
        	
        	int b=0;
        	String selectvars="";
        	if (selectVariables.size()==0)	{  //if it is "select *"
        		selectVariables=rdfTripleVariables;
        	}
        	while(b < selectVariables.size()) {
        		if (b==selectVariables.size()-1)	{
        			//selectvars+= "rid(" + selectVariables.elementAt(b)+")";
				selectvars+=selectVariables.elementAt(b);
        		} else	{
        			//selectvars+= "rid(" + selectVariables.elementAt(b)+"), ";
				selectvars+=selectVariables.elementAt(b)+ ", ";  	
        		}
        		b++;
			}
			
        wholeQuery[1]= selectvars; 

//wholeQuery[2]="from" (in the grammar)        
/*********************** sources are in AmosQL all select variables and variables in RDFtriples - following *****/

        	Vector sourceVars=(Vector) selectVariables.clone();	
        	for (int c=0;c<rdfTripleVariables.size();c++) {
				if (!selectVariables.contains(rdfTripleVariables.get(c))) { 
				sourceVars.addElement(rdfTripleVariables.get(c));
				}
			} 
			for (int d=0;d<sourceVars.size();d++)	{ 	//we need just the variables
				if (sourceVars.elementAt(d).equals(","))	{
					sourceVars.remove(d);
					d--;
				}
			}
			int e=0;
        	String sourceVarsOut="";
        	while(e < sourceVars.size()) {
        		if (e==sourceVars.size()-1) {
	
        			sourceVarsOut+="Charstring "+sourceVars.elementAt(e);
        			//sourceVarsOut+="resource "+sourceVars.elementAt(e);
			} else { 

				sourceVarsOut+="Charstring "+sourceVars.elementAt(e)+", ";
        			//sourceVarsOut+="resource "+sourceVars.elementAt(e)+", ";
        		} 
        		e++;
			}
						
        wholeQuery[3]=sourceVarsOut; //output of the sources. These are the select variables and all variables in the TriplePatterns
        
//wholeQuery[4]="where" (in the grammar)
/************** that will be in the form: "rdf_triples('source') in AmosQL****************/        
        	//not fixed for more than one source. 
        	int f=0;
        	while (f < sources.size())	{
 				if (Start.SourceNameSpace==null)	{
					//wholeQuery[5]= "rdf_triples('"+sources.elementAt(f)+"')";
 					//wholeQuery[5]= sources.elementAt(f)+"triples()";
					wholeQuery[5]= upvofuri((String)sources.elementAt(f))+"()";
					
 				} else	{
				//wholeQuery[5]= "rdf_triples('"+Start.SourceNameSpace+sources.elementAt(f)+"')";
        			//wholeQuery[5]= Start.SourceNameSpace+sources.elementAt(f)+"triples()";
				wholeQuery[5]= upvofuri(Start.SourceNameSpace+sources.elementAt(f))+"()";	
				
        		}
        		f++; 
        	}
        	
//**************************************************************************************/
       
        wholeQuery[6]="=";
        
/****************** prefixes from PrefixClause must be inserted into TriplePatterns - following ************/
        	
        	for (int prefsize=prefixvec.size();prefsize>0;prefsize=prefsize-2)	{
        		String shortcut=(String)prefixvec.elementAt(1);
        		int length=shortcut.length();
           		for (int g=0;g<rdfTriples.size();g++)	{
           			String tripleElement=(String)rdfTriples.elementAt(g);
           			if (tripleElement.length()>length)	{
        				if (tripleElement.substring(1,length+1).equals(shortcut))	{   
        					int colonindex=tripleElement.lastIndexOf(":");
        					String postfix=tripleElement.substring(colonindex+1);
        					rdfTriples.set(g,"'"+prefixvec.elementAt(0)+postfix); //see also URI method for description
        				}
        			}
        		}
        		prefixvec.removeElementAt(1);
        		prefixvec.removeElementAt(0);	
        	}
/**************** now the prefixes are inserted into the RDFTriples ***************************/
/****************** this the handling of the RDFTriples following******************************/        	
        	int h=0;
        	while(h < rdfTriples.size()) {
        		String svo="";
        		if (andVar==0)	{
        			for (int i=0; i<5; i++)	{
        				svo+=rdfTriples.elementAt(h); 
        				h++;
        			}
        			if (wholeQuery[7]==null)	{
        				wholeQuery[7]="<"+svo+">";
        			} else	{
        				wholeQuery[7]+="<"+svo+">";
        			}
        		} else	{
        			for (int i=0; i<5; i++)	{
        				svo+=rdfTriples.elementAt(h);
        				h++;
        			} 	
        			andVar--;
        			if (wholeQuery[7]==null)	{
        				wholeQuery[7]="<"+svo+"> and "+wholeQuery[5]+" = ";
        			} else	{
        				wholeQuery[7]+="<"+svo+"> and "+wholeQuery[5]+" = ";
        			}
        		}
        	}
/************************ now comes constraint syntax (for Example where age>=24)***************/        		

		for (int j=0; j<constraintvec.size(); j++)	{
			if (wholeQuery[8]==null)	{
				wholeQuery[8]=(String)constraintvec.elementAt(j);
			} else	{
				wholeQuery[8]+=(String)" "+constraintvec.elementAt(j);
			}
		}
		
/*************************** output of the AmosQL query following *******************************/

        wholeQuery[9]=";";
        
        String parsedquery="";
        int k=0;
        while(k < 10) {
        	if (wholeQuery[k]==null)	{
        		k++;
        	} else	{
        		//System.out.print(wholeQuery[k]+" "); //output of the whole query
        		parsedquery+=wholeQuery[k]+" ";
        		k++;
        	}
        }
      	
      	//System.out.println("");
      	reinit();
		return parsedquery;
	}

}

