{/*@bgen(jjtree) URI */
        try {
/*@egen*/
  	"<" ident=Identifier() ">"/*@bgen(jjtree)*/
        {
          jjtree.closeNodeScope(jjtn000, true);
          jjtc000 = false;
        }
/*@egen*/ 
  	{
  	if (uriflag==0) {sources.addElement(ident);}
  	if (uriflag==1) {prefixvec.addElement(ident);}/*that\u00b4s a bit tricky: in the postfix (prefix:postfix)
  													we have the "'" after it included because it\u00b4s extractet
  													from an	Uri in a RDFTriple. But not before the prefix*/
  	if (uriflag==2) {rdfTriples.addElement("'"+ident+"'");}
	//if (uriflag==2) {rdfTriples.addElement("uri('"+ident+"')");}
  	if (uriflag==3) {constraintvec.addElement("'"+ident+"'");}
  	}/*@bgen(jjtree)*/
        } catch (Throwable jjte000) {
          if (jjtc000) {
