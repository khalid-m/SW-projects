/*Input a SparQL language query as a string     */
/*Input1: RDF source                            */
/*Input3: SPARQL query statement                */
create function __sparql__(Charstring,Integer,Charstring)->Charstring
  as foreign "sparql_query";

/*Function for parsing a SparQL query to AmosQL. 
 *Default is caching of resources and specification of dataset 
 *in FROM clause of SparQL query.
 *Added by Johan Petrini
 */
create function parse_sparql(Charstring query)->Charstring 
  as select __sparql__("",1,query);

