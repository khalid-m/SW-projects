/*** Return 0 if sql identifier is uri and 1 if rlit ***/
create function is_sqllid(Charstring str)->Integer flg
  as foreign 'is_sqllid';

/*** Translates an sql string to corresponding uid. E.g. <monkey> is 
     translated to monkey.
     If the argument of sqltouid is a sql string representing an rdf literal 
     sqltouid returns nothing ***/

create function sqltouid(Charstring str)->Charstring r
  as foreign 'sqltouid';

lisp;
