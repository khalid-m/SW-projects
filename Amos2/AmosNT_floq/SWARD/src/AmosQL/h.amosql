create function SWOfUPV(Charstring upv)->Charstring sw as stored;
create function CWOfUPV(Charstring upv)->Charstring cw as stored;
create function pStat()->Boolean as foreign 'p-stat'; /*Returns true if partial evaluation is enabled (default)*/
create function compileQuery(Charstring query)->Function fn as foreign 'compile-query'; 
create function setWM(Integer wm)->Boolean as foreign 'setwm';
create function resVars(Function q)->Vector as foreign 'resvars';
create function resSQLVars(Charstring query)->Vector as foreign 'ressqlvars';
create function bindsTpl(Vector val,Vector var)->Vector
  as select vectorof(select {var[i],val[i]} 
     from Integer i    
     where i in iota(0,dim(var)));

/* Fn for serializing several values into one value given a delimiter.
 */
create function serializeVal(Vector vals, Charstring dl)->Vector val 
  as multidirectional ('bbf' foreign 'svbbf' cost {1,1})
                      ('ffb' foreign 'svffb' cost {1,2});

declare_key(theresolvent('Vector.Charstring.serializeVal->Vector'),
                         {'vals','dl'});

declare_key(theresolvent('Vector.Charstring.serializeVal->Vector'),
                         {'val'});

/* Inverse of fn serializeVal.
 */
create function usv(Vector val)-><Vector usv, Charstring dl>
  as
   select usv, dl where serializeVal(usv,dl)=val;

/* Fn for serializing composite key (values).
 */
create function serializeCk(Vector ck)->Charstring sck 
  as 
   select sck where serializeVal(ck,'@')={sck,'@'};

/* Inverse function of serializeCk.
 */
create function usck(Charstring sck)->Vector ck
  as
   select ck where serializeCk(ck)=sck;




