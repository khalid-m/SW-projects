/* Fn overriding inequality fn neq called in 
 * parsed SparQL queries.
 */
create function neq(Charstring c1, Charstring c2)->Boolean 
as
	select true where c1 != c2;
	
/* Fn overriding filter collector fn fltr called in 
 * parsed SparQL queries.
 */
create function fltr(Boolean b)->Boolean  
as
	select b;

/*Fn  parsing a SparQL query to AmosQL.
  * @param1  Data set
  * @param2  Chached (1) or not cached (0)  resources
  * @param3 SparQL query as string
  * @return   AmosQL query as string 
 */
create function __parse_sparql__(Charstring,Integer,Charstring)->Charstring
  as foreign "parse_sparql";

/*Fn parsing a SparQL query to AmosQL. Default is uncached query and specified data set. 
  *Added by Johan Petrini
  */
create function parse_sparql(Charstring query)->Charstring 
  as select __parse_sparql__("",0,query);

create function parseSparQL(Charstring query)->Charstring 
  as select __parse_sparql__("",0,query);
	

/*Fn parsing and  executing a SparQL query. Default is data set "".
  *Added by Johan Petrini
  */
create function sparql(Charstring sparql)->Vector 
as
 select evalv(parseSparQL(sparql));

create function sparqlBinds(Charstring sparql)->Vector
as
 select bindsTpl(call_function(q,{}),resVars(q))
 from Function q
 where q = compileQuery(parseSPARQL(sparql));

create function areg(Charstring sreg)->Charstring areg as foreign 'areg';