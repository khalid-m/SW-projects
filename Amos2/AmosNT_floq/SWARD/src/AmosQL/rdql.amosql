create function parse_rdql(Charstring query)->Charstring 
as 
 foreign "JAVA:Start/parseRDQL";

create function parseRDQL(Charstring query)->Charstring 
as 
 foreign "JAVA:Start/parseRDQL";

/*
create function parseRDQLBinds(Charstring query)->Vector
as
 foreign "JAVA:Start/parseRDQLBinds";
*/

/*
create function rdql(Charstring query)->Vector
as 
 foreign "JAVA:Start/RDQL";
*/

create function rdql(Charstring query)->Vector
as 
 select evalv(parseRDQL(query));

/*
create function rdqlBinds(Charstring rdql)->Vector
as
 select bindsTpl(evalv(amosql),resVars(amosql))
 from Charstring amosql
 where amosql = parseRDQL(rdql);
*/

create function rdqlBinds(Charstring rdql)->Vector
as
 select bindsTpl(call_function(q,{}),resVars(q))
 from Function q
 where q = compileQuery(parseRDQL(rdql));




