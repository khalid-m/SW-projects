/*-*-sql-*-********************************************************************
 * AMOS2
 *
 * Author: (c) 2008 Johan Petrini, UDBL
 * 
 * Description: Master regression test of SWARD system exporting and querying 
 * the Company relational database with strategies END-P and DVS-P.
 *
 * The following queries are tested:
 *
 *  Schema queries accessing the relational database schema.
 *  1. Give me all properties, except for 
 *     http://udbl.it.uu.se/schemas/company#CustID, of a customer.
 *
 *  Content queries accessing the relational database data.
 *  1. Give me the market segment of the customer who placed 
 *     the order '1'.
 *  2. Give me the class of the instance with 
 *     identifier 'http://udbl.it.uu.se/schemas/company#Customer/120'. 
 *  3. Give me all customers.
 *  4. Give me the selling clerk, the buying customer (co:Customer)
 *     and the market segment for that customer, for all orders (co:Orders).
 *
 *  Hybrid queries joining schema and content data. 
 *  1. Give me all properties, except for 
 *     'http://udbl.it.uu.se/schemas/company#CustID, 
 *     and values of the customer who placed the order '1'.      
 ******************************************************************************/
/* Load SWARD master regression setup  
 */		
<'company_setup.amosql';

/* Generate the UPVs
 */
dispatch("END","CompI");
dispatch("DPS","CompII");

/* SPARQL queries 
 */
set :sparql_schema_1 = 
"SELECT ?prop
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {?prop <http://www.w3.org/2000/01/rdf-schema#domain>
		 <http://udbl.it.uu.se/schemas/company#Customer> .
 FILTER (?prop != <http://udbl.it.uu.se/schemas/company#CustID>) .}";

set :sparql_schema_1_II = 
"SELECT ?prop
 FROM <http://udbl.it.uu.se/upv/comp_II/>
 WHERE {?prop <http://www.w3.org/2000/01/rdf-schema#domain>
		 <http://udbl.it.uu.se/schemas/company#Customer> .
 FILTER (?prop != <http://udbl.it.uu.se/schemas/company#CustID>) .}";

set :sparql_content_2 = 
"SELECT ?cust ?mkt
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {?order <http://udbl.it.uu.se/schemas/company#OrderID> '1' .
        ?order <http://udbl.it.uu.se/schemas/company#OrderCustomer> ?ocust .
        ?cust  <http://udbl.it.uu.se/schemas/company#CustID> ?ocust .
        ?cust  <http://udbl.it.uu.se/schemas/company#Market> ?mkt .}";

set :sparql_content_2_II = 
"SELECT ?cust ?mkt
 FROM <http://udbl.it.uu.se/upv/comp_II/>
 WHERE {?order <http://udbl.it.uu.se/schemas/company#OrderID> '1' .
        ?order <http://udbl.it.uu.se/schemas/company#OrderCustomer> ?ocust .
        ?cust  <http://udbl.it.uu.se/schemas/company#CustID> ?ocust .
        ?cust  <http://udbl.it.uu.se/schemas/company#Market> ?mkt .}";

set :sparql_hybrid_3 = 
"SELECT ?cust ?prop ?val
FROM <http://udbl.it.uu.se/upv/comp/>	
WHERE {?order <http://udbl.it.uu.se/schemas/company#OrderID> '1' .
       ?order <http://udbl.it.uu.se/schemas/company#OrderCustomer> ?ocust .
       ?cust <http://udbl.it.uu.se/schemas/company#CustID> ?ocust .
       ?prop <http://www.w3.org/2000/01/rdf-schema#domain> 
		<http://udbl.it.uu.se/schemas/company#Customer> .      
       ?cust ?prop ?val .
FILTER (?prop != <http://udbl.it.uu.se/schemas/company#CustID>) .}";

set :sparql_hybrid_3_II = 
"SELECT ?cust ?prop ?val
FROM <http://udbl.it.uu.se/upv/comp_II/>	
WHERE {?order <http://udbl.it.uu.se/schemas/company#OrderID> '1' .
       ?order <http://udbl.it.uu.se/schemas/company#OrderCustomer> ?ocust .
       ?cust <http://udbl.it.uu.se/schemas/company#CustID> ?ocust .
       ?prop <http://www.w3.org/2000/01/rdf-schema#domain> 
		<http://udbl.it.uu.se/schemas/company#Customer> .      
       ?cust ?prop ?val .
FILTER (?prop != <http://udbl.it.uu.se/schemas/company#CustID>) .}";

set :sparql_content_4 = 
"SELECT ?class
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {<http://udbl.it.uu.se/schemas/company#Customer/120> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
         ?class .}";

set :sparql_content_5 = 
"SELECT ?cust
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {?cust <http://udbl.it.uu.se/schemas/company#CustID> ?custid .}";

set :sparql_content_6 = 
"SELECT ?cust
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {?cust <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
         <http://udbl.it.uu.se/schemas/company#Customer> .}";

set :sparql_content_7 = 
"SELECT ?cust ?mkt ?clerk 
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {?order <http://udbl.it.uu.se/schemas/company#Clerk> ?clerk .
        ?order <http://udbl.it.uu.se/schemas/company#OrderedBy> ?cust .
        ?cust <http://udbl.it.uu.se/schemas/company#Market> ?mkt .}";

set :sparql_content_8 = 
"SELECT ?cust ?mkt ?clerk 
 FROM <http://udbl.it.uu.se/upv/comp/>
 WHERE {?order <http://udbl.it.uu.se/schemas/company#Clerk> ?clerk .
        ?order <http://udbl.it.uu.se/schemas/company#OrderCustomer> ?ocustid .
        ?cust <http://udbl.it.uu.se/schemas/company#CustID> ?ocustid .
        ?cust <http://udbl.it.uu.se/schemas/company#Market> ?mkt .}";


/* Corresponding SQL queries 
 */
 set :sql_schema_1 =
"select c1.s
 from compI c1
 where c1.p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
       c1.val = 'http://udbl.it.uu.se/schemas/company#Customer' and
       c1.s <> 'http://udbl.it.uu.se/schemas/company#CustID';";

 set :sql_schema_1_II =
"select c1.s
 from compII c1
 where c1.p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
       c1.val = 'http://udbl.it.uu.se/schemas/company#Customer' and
       c1.s <> 'http://udbl.it.uu.se/schemas/company#CustID';";

 set :sql_content_2 =
"select c4.s, c4.val
 from compI c1,
      compI c2,
      compI c3,
      compI c4
 where c1.p = 'http://udbl.it.uu.se/schemas/company#OrderID' and
       c2.p = 'http://udbl.it.uu.se/schemas/company#OrderCustomer' and
       c3.p = 'http://udbl.it.uu.se/schemas/company#CustID' and       
       c4.p = 'http://udbl.it.uu.se/schemas/company#Market' and
       c1.val = '1' and
       c1.s = c2.s and
       c2.val = c3.val and
       c3.s = c4.s;";

 set :sql_content_2_II =
"select c4.s, c4.val
 from compII c1,
      compII c2,
      compII c3,
      compII c4
 where c1.p = 'http://udbl.it.uu.se/schemas/company#OrderID' and
       c2.p = 'http://udbl.it.uu.se/schemas/company#OrderCustomer' and
       c3.p = 'http://udbl.it.uu.se/schemas/company#CustID' and       
       c4.p = 'http://udbl.it.uu.se/schemas/company#Market' and
       c1.val = '1' and
       c1.s = c2.s and
       c2.val = c3.val and
       c3.s = c4.s;";

 set :sql_hybrid_3 =
"select c5.s, c5.p, c5.val
 from compI c1,
      compI c2,
      compI c3,
      compI c4,
      compI c5
 where c1.p = 'http://udbl.it.uu.se/schemas/company#OrderID' and
       c2.p = 'http://udbl.it.uu.se/schemas/company#OrderCustomer' and
       c3.p = 'http://udbl.it.uu.se/schemas/company#CustID' and       
       c4.p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
       c4.val = 'http://udbl.it.uu.se/schemas/company#Customer' and
       c1.val = '1' and
       c1.s = c2.s and
       c2.val = c3.val and
       c3.s = c5.s and
       c4.s = c5.p and
       c5.p <> 'http://udbl.it.uu.se/schemas/company#CustID' ;";

 set :sql_hybrid_3_II =
"select c5.s, c5.p, c5.val
 from compII c1,
      compII c2,
      compII c3,
      compII c4,
      compII c5
 where c1.p = 'http://udbl.it.uu.se/schemas/company#OrderID' and
       c2.p = 'http://udbl.it.uu.se/schemas/company#OrderCustomer' and
       c3.p = 'http://udbl.it.uu.se/schemas/company#CustID' and       
       c4.p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
       c4.val = 'http://udbl.it.uu.se/schemas/company#Customer' and
       c1.val = '1' and
       c1.s = c2.s and
       c2.val = c3.val and
       c3.s = c5.s and
       c4.s = c5.p and
       c5.p <> 'http://udbl.it.uu.se/schemas/company#CustID' ;";

/* Defining the results of and evaluating the example queries
 */
lisp;
(defglobal _schema_1_res_ 
 (list (list (listtoarray 
    (list "http://udbl.it.uu.se/schemas/company#Market")))))

(defglobal _content_2_res_ 
 (list (list (listtoarray 
    (list "http://udbl.it.uu.se/schemas/company#Customer/120" "AUTOMOBILE"))))) 

(defglobal _hybrid_3_res_
(list (list (listtoarray 
  (list "http://udbl.it.uu.se/schemas/company#Customer/120" 
		"http://udbl.it.uu.se/schemas/company#Market" "AUTOMOBILE")))))

(defglobal _content_4_res_ 
 (list 
  (list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/company#Customer")))))

(defglobal _content_5_6_res_ 
 (list 
  (list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/company#Customer/120")))))

(defglobal _content_7_8_res_ 
 (list 
  (list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/company#Customer/120" "AUTOMOBILE" "Wesson")))
  (list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/company#Customer/120" "AUTOMOBILE" "Doe")))))


(checkequal "SPARQL schema query Q1 with END-P"
	    ((osql "sparql(:sparql_schema_1);")
		 _schema_1_res_))

(checkequal "SPARQL schema query Q1 with DVS-P"
	    ((osql "sparql(:sparql_schema_1_II);")
		 _schema_1_res_))

(checkequal "SPARQL content query Q2 with END-P"
	    ((osql "sparql(:sparql_content_2);")
		 _content_2_res_))

(checkequal "SPARQL content query Q2 with DVS-P"
	    ((osql "sparql(:sparql_content_2_II);")
		 _content_2_res_))

(checkequal "SPARQL hybrid query Q3 with END-P"
	    ((osql "sparql(:sparql_hybrid_3);")
		 _hybrid_3_res_))

(checkequal "SPARQL hybrid query Q3 with DVS-P"
	    ((osql "sparql(:sparql_hybrid_3_II);")
		 _hybrid_3_res_))

(checkequal "SPARQL content query Q4 with END-P"
	    ((osql "sparql(:sparql_content_4);")
		 _content_4_res_))

(checkequal "SPARQL content query Q5 with END-P"
	    ((osql "sparql(:sparql_content_5);")
		 _content_5_6_res_))

(checkequal "SPARQL content query Q6 with END-P"
	    ((osql "sparql(:sparql_content_6);")
		 _content_5_6_res_))

(checkequal "SPARQL content query Q7 with END-P"
	    ((osql "sparql(:sparql_content_7);")
		 _content_7_8_res_))

(checkequal "SPARQL content query Q8 with END-P"
	    ((osql "sparql(:sparql_content_8);")
		 _content_7_8_res_))

(checkequal "SQL schema query Q1 with END-P"
	    ((osql "sql(:sql_schema_1);")
		 _schema_1_res_))

(checkequal "SQL schema query Q2 with DVS-P"
	    ((osql "sql(:sql_schema_1_II);")
		 _schema_1_res_))

(checkequal "SQL content query Q3 with END-P"
	    ((osql "sql(:sql_content_2);")
		 _content_2_res_))

(checkequal "SQL content query Q3 with DVS-P"
	    ((osql "sql(:sql_content_2_II);")
		 _content_2_res_))

(checkequal "SQL hybrid query Q3 with END-P"
	    ((osql "sql(:sql_hybrid_3);")
		 _hybrid_3_res_))

(checkequal "SQL hybrid query Q3 with DVS-P"
	    ((osql "sql(:sql_hybrid_3_II);")
		 _hybrid_3_res_))

:osql

DSDisconnect("CompI");
DSDisconnect("CompII");




