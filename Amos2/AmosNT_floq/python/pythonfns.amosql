 *
 * Description: Examples of definitions of foreign functions in Python
 ****************************************************************************

/* Load Python engine into Amos: */
extlang("python"); 

create function pyabs(Number a) -> Number x 
  /* Call the built-in Python function abs() */
  as foreign 'py:abs';

/* Test pyabs() */
pyabs(1);
pyabs(-1);
pyabs(-1.2);

create function pyfloor(Number a) -> Real x 
  /* Call floor() in math package in Python */
  as foreign 'py:math.floor';

/* Test pyfloor() */
pyfloor(1.2);
pyfloor(2);

/* Foreign table function defined by built-in Python function: */
create function xrange(Integer l, Integer y)->Bag of Integer
  as foreign 'py:xrange';

/* Test xrange() */
xrange(1,3);
count(xrange(1,1000000));
xrange(1.1,2);

/* Define pyiota() in terms of xrange() */
create function pyiota(Number l, Number u) -> Bag of Integer
  as xrange(integer(l), integer(1+u));

/* Test pyiota() compare with iota(): */
pyiota(1,4);
pyiota(1.1,4.3);
iota(1,4);

pyiota(1.4,2.6);
iota(1.4,2.6);

/* Compare speed: */
count(pyiota(1,1000000));
count(iota(1,1000000));

/* Define pyplus() in terms of plus() implementation in foreign.py: */
create function pyplus(Number a, Number b) -> Number x
  as foreign 'py:foreign.plus';

/* Test pyplus(): */
pyplus(1,2.3);

/* Implement foreign table function in Python: */
create function pyiota2(Number l, Number u) -> Bag of Number
  as foreign 'py:foreign.iota';

/* Test pyiota2(): */ 
pyiota2(1,3);
pyiota2(1.1,3.4);

/* compare speed of pyiota2() with pyiota() and iota(): */
count(pyiota2(1,1000000));
count(pyiota(1,1000000));
count(iota(1,1000000));

/* Implement foreign aggregate function in Python: */
create function pycount(Bag b) -> Integer
  as foreign 'py:foreign.count';

/* Test pycount(): */
pycount(iota(1,100));

/* Compare speed of pycount() and count(): */
pycount(iota(1,10000));
count(iota(1,10000));
/* Not so good */

/* Printing on standard output: */
create function myprint(Charstring x) -> Integer
  as foreign 'py:foreign.myprint';

myprint("Hello world");




