/* Watching a target directory*/
create logdirectory (name,folder, timeout, startseq) instances ('d2b','D:\\Generated_Machine_Data\\Hagglund\\', 15, 575);

create function report_logfiles() -> bag of Vector 
 as for each logfile lf where lf in  logFileStream(dirnamed('d2b'))
  return  {round(real(sysTimestamp(lf))), filename(lf), sysTimestamp(lf)};


/*A new coming log file will be extracted for bulk loader
*/
format_and_bulk(remove_null(report_logfiles()), "logfile", FALSE);
