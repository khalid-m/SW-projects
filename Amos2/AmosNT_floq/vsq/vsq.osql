create function sink(stream) -> boolean as foreign 'sink-stream';
create function sink(vector of stream) -> boolean as foreign 'sink-vector';

create function vi(charstring) -> vi as foreign 'vi-+';
create function viopen(vi) -> boolean as foreign 'viopen-';
create function viclose(vi) -> boolean as foreign 'viclose-';
create function virun(vi) -> boolean as foreign 'virun-';

create function visualize(vector of vi, stream) -> bag of boolean
  as foreign 'visualize-labview--';

create function visualize_numeric_validation(stream s) -> stream of boolean
  as streamof(visualize(
    {vi("labview\\visualize_numeric_validation.vi")},
    streamof((select darray({real(ts), real(is), real(sh), real(inv)})
                from number ts, number is, number sh, number inv,
                     stream of(number, number, number, number) ns
                where (ts, is, sh, inv) in ns and ns = s))));

create function visualize_numstream(stream s) -> stream of boolean
  as streamof(visualize(
    {vi("labview\\visualize_numstream.vi")},
    streamof(select darray({real(ts), real(is)})
               from number ts, number is,
                    stream of(number, number) ns
               where (ts, is) in ns and ns = s)));

create function visualize0(vi, stream) -> bag of boolean
  as foreign 'visualize-stream--';

create function visualize(vi v, stream s) -> stream of boolean
  as streamof(visualize0(v, s));

create function stream_file(Charstring file) -> Stream of Object
  as streamof(readfile(file));
