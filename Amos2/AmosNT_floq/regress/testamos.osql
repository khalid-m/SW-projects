 ((osql "MgrAgeOfPerson2('Kalle');") '(("Ulla" 31)))
 ((sorttuples(osql "select p,m from Charstring p,Charstring m
			   where (32,m) = AgeMgrOfPerson(p);"))
  '(("Kalle" "Ulla")("Tore" "Ulla")))
 ((osql "sameage();") '(("Tore")))
 ((osql "sameage2();") '(("Tore")))
 ((osql "testr2('Tore');") '((TRUE)))
 ((osql "testr2('Kalle');") '((TRUE)))
 ((osql "testr2('Filip');") nil)
 ((osql "testr3('Tore');") '((TRUE)))
 ((osql "testr3('Filip');") nil)
 ((osql "testr4('Tore');") '((TRUE)))
 ((osql "testr4('Kalle');") nil)
 ((osql "testr4('Filip');") nil)
 ((osql "eq(1,1);") '((true)))
 ((osql "eq(1,2);") nil)
 ((osql "tuple1(1,2);") nil)
 ((osql "tuple1(1,1);") '((true)))
 ((osql "tuple2(1,2);") nil)
 ((osql "tuple2(1,1);") '((1)))
 ((osql "select true where streng() = (upper('hej'),'hej');") '((true)))
 ((osql "remove streng()=(y,z) 
         from Charstring y, Charstring z;") nil)
 ((osql "set foo(1)=1;") nil)
 ((osql "set foo('1')=2;") nil)
 ((osql "set foo(1.1)=3;") nil)
 ((osql "foo(1);") '((1)))
 ((osql "foo('1');") '((2)))
 ((osql "foo(1.1);") '((3)))
 ((extent 'foo 'integer) '((1 1)))
 ((extent 'foo 'real) '((1.1 3)))
 ((sorttuples(extent 'sameage)) '(("Tore")))
 ((sorttuples(extent 'testr2)) '(("Kalle") ("Tore") ("Ulla")))
 )

(checkequal "Casting"
	    ((osql "cast('a' as integer);") '(("a")))
            ((osql "cast(nil as boolean);") nil)
	    ((osql "name(typeof(cast(nil as integer)));") '(("INTEGER")))
	    ((osql "name(typesof(cast(nil as integer)));") 
	     '(("INTEGER") ("NUMBER") ("LITERAL") ("OBJECT")))
            ((osql "cast({1} as vector of integer);") '((#(1))))
	    ((errstring (osql "cast({1,2,3} as vector of person);")) 
	     "No object found named PERSON of type TYPE")
            ((osql "sum(cast(iota(1,100) as number));") '((5050)))
