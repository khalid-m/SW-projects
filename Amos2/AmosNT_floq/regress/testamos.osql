create function ctof (Number c)->Number f
		 as c * 9 / 5 + 32;
lisp;

(checkequal "constraints"  
	    ((osql "select i from Integer i where 4 = 1+i;") '((3)))
	    ((osql "select x,y from integer x,integer y
			 where x + y = 3 and
                               3 - y = 1;") '((1 2)))
	    ((osql "ctof(26);") '((78.8)))
	    ((osql "select c from Number c where 77 = ctof(c);") '((25)))
	    ((osql "select c from Number c where 78 = ctof(c);")
	     '((25.555555555555557)))
	    )
:osql
create function managers()->Charstring m
		 as select m from Charstring m,Charstring p
		 where m = mgrofperson(p);
create function undermanagers()->Charstring p
		 as select p from Charstring p,Charstring m
		 where m= mgrofperson(p);
create function ageofmanagers()->Integer a
		 as ageofperson(managers());
create function ageofundermanagers()->Integer a
		 as ageofperson(undermanagers());
lisp;

(checkequal "exists"
	    ((sorttuples(osql "undermanagers();"))
	     '(("Kalle") ("Tore") ("Ulla")))
	    ((sorttuples(osql "managers();")) '(("Ulla") ("Ulla") ("Vilhelm")))
	    ((sorttuples(osql "ageofmanagers();")) '((32) (32) (40)))
	    ((sorttuples(osql "ageofundermanagers();")) '((31)(32)(32)))
	    )
:osql
create function ortest (Charstring n)->integer a
		 as select a from integer a
		 where 	a=ageofperson(n) or
			a=ageofperson("Tore");
create function ortest2 (Charstring n)->integer a
		 as select a from integer a
		 where 	a=ageofmgr(n) or
			a=ageofmgr("Tore");
create function ortest3 (Charstring n)->Integer a
		 as select a from Integer a
		 where a=ortest(n) and a= ortest2(n);
create function ortest4 (Charstring n)->Integer a
		 as select a from Integer a
		 where a=ortest2(n) and a=ortest(n);
create function invortest4 (Integer a)->charstring n
		 as select n from charstring n where a=ortest4(n);
lisp;
(checkequal "disjunction"
	    ((osql "ortest('Pii');") '((32)))
	    ((osql "ortest('Ulla');") '((32) (32)))
	    ((osql "ortest2('Ulla');") '((40)(32)))
	    ((osql "ortest3('Ulla');") '((32)(32)))
	    ((osql "ortest4('Ulla');") '((32)(32)))
	    ((sorttuples(osql "invortest4(32);"))
	     '(("Kalle") ("Tore") ("Tore") ("Tore") ("Ulla")))
	    )
:osql
create function youngerthanmgr ()-> (Integer a,charstring p)
		 as select a,p from Integer a,Charstring p
		 where 	a=ageofperson(p) and
			a < ageofmgr(p);
lisp;
(checkequal "inequality"
	    ((sorttuples(osql "youngerthanmgr();"))
	     '((31 "Kalle") (32 "Ulla")))
	    )

