create type absolutetone properties(tie boolean);

create type AbsoluteDuration properties (start integer, length integer);
create function createabsoluteduration(integer start, integer length)->
   absoluteduration d
as begin
     create absoluteduration (start,length) instances d(start,length);
     return d;
   end;

create function createTone
(charstring lyrics, boolean tie, AbsoluteDuration duration) ->
AbsoluteTone a as
begin
 create AbsoluteTone instances a;
 set tie(a) = tie;
 return a;
end;

set :c = createTone("Shit",false,createAbsoluteDuration(3,4));
lisp;
