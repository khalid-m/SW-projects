	    ((osql "1=1;") '((true)))
	    ((osql "2=1;") nil)
	    ((osql "select 1=1;") '((true)))
	    ;;the following three queries test compile time evaluation
	    ((osql "select 1<1;") nil)
	    ((osql "select 1<1 and 3>2;") nil)
	    ((osql "select 3>2 and 4>2;") '((true)))
	    ((osql "select 1=2;") nil)
	    ((osql "bool1(true,1);") '((true)))
	    ((osql "bool1(true,0);")nil)
	    ((osql "bool1(false,1);")nil)
	    ((osql "flag1();") '((true)))
	    ((osql "flag2(1);") nil)
	    ((osql "flag2(3);") '((true)))
	    ((osql "flag3();") '((true)))
	    ((osql "flag4();") '((true)))
	    ((osql "notany(flag2(3));") nil)
	    ((osql "notany(flag2(1));") '((true)))
	    ((osql "notany(flag3());") nil)
	    ((osql "flag4();") '((true)))
	    ((osql "begin return true; end;") '((true)))
	    ((osql "f2(5.49);") '((true)))
	    ((osql "f2(5.51);") nil)
	    )
