/* Testing Lisp - AMOSQL  interface */
create type person;
create function name(person)-> charstring;
create person (name) instances :tore("Tore");
lisp;

(defun persname1(amos_o) 
  (let (amos_nm) 
    (osql "select name(:o) into :nm;") 
    amos_nm))
    (defun persname2 (amos_o) 
          (let (amos_nm) 
               (osql "select name(:o) into :nm;") 
               amos_nm)) 
    (defun persname3 (p) 
        (osql-let ((person :o) (charstring :nm)) 
	  (setq amos_o p) ; notice how to declare function parameters!
          (osql "select name(:o) into :nm;") 
          amos_nm)) 
    (defun persname4 (p) 
        (osql-let ((person :o) (charstring :nm)) 
	  (setq amos_o p) ; notice how to declare function parameters!
          (osql "select nm into :nm from charstring nm where
                                    nm = name(:o);") 
          amos_nm)) 

  (defun atomindef (a x)(not(null(in a x))))
  (if (> (set-authority nil) 4)
  (resetvar *within-lisp* nil
  (checkequal "Calling AMOSQL from Lisp"
        ((null (proid #[OID 1] (maketextstream))) nil)
	((null(osql-declare person :o)) nil)
  	((persname1 amos_tore) "Tore")
  	((persname1 amos_tore) "Tore") ; has to call to macroexpand more
        ((persname1 amos_tore) "Tore") ; has to call to macroexpand more
	((atomindef 'name (getd 'persname1)) nil) ; early bound
	((osql-undeclare :o) t)
	((persname2 amos_tore) "Tore")
	((persname2 amos_tore) "Tore")
        ((persname2 amos_tore) "Tore")
	((atomindef 'name (getd 'persname2)) t) ; late bound
	((persname3 amos_tore) "Tore")
	((persname3 amos_tore) "Tore")
        ((persname3 amos_tore) "Tore")
	((atomindef 'name (getd 'persname3))nil) ; early bound
	((persname4 amos_tore) "Tore")
        ((persname4 amos_tore) "Tore")
        ((persname4 amos_tore) "Tore")
        ((caar(osql "name(:tore);")) "Tore")
	((atomindef 'map-select (getd 'persname4)) t) ; dynamic optimization!
	((rollback) nil)
	((null *vardeclarations*) t) ;
; *vardeclarations* should be transactional
	))
     )
:osql
rollback;

