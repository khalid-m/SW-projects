	    ((osql "select x,y from integer x,integer y
			 where y = 2 and (x = 1 or x = 3) and x > y;") 
	     '((3 2)))
	    ((osql "select where 1=2;") nil)
	    ((osql "select where 1=1;")'((true)))
	    )

(checkequal "Equivalent actual parameters"
	    ((osql "select n from number n where eqvars(2)=(n,2);")
	     '((2)))
	    )

(foreign-lispfn truee nil nil (foreign-result))

(foreign-lispfn evenp ((number x))((boolean))
		(if (evenp x) (foreign-result 'true)(foreign-result 'false)))

(foreign-lispfn sqrt1 ((number x))((number r))
		(if (>= x 0.0)
		    (let ((r (sqrt x)))
		      (foreign-result r)
		      (foreign-result (- 0 r)))))

(foreign-lispfn sqrt2 ((number x))((real r1)(real r2))
		(if (>= x 0.)
		    (let ((r (sqrt x)))
		      (foreign-result r (- 0 r)))))

(foreign-lispfn one ()((integer))(foreign-result 1))

(checkequal "Foreign Lisp functions"
	    ((osql "truee();") '((true)))
            ((osql "evenp(1);") nil)
            ((osql "evenp(2);") '((true)))
	    ((osql "sqrt1(4);") '((2.0) (-2.0)))
	    ((osql "sqrt1(-1);") nil)
	    ((osql "sqrt2(4);") '((2.0 -2.0)))
	    ((osql "sqrt2(-1);") nil)
	    ((osql "one();") '((1)))
            ((osql "one()=1;") '((true)))
	    )

