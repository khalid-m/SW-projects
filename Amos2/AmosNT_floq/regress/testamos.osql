	    ((osql "select c from charstring c,type t
			 where c = nametype(t) and c = 'TYPE.NAMETYPE';")
	     nil)
	    ((osql "select c from charstring c,function f
			 where name(f)=c and c = 'TYPE';")
	     nil)
	    )
:osql

create function hobbies_bag()-> Bag of (Charstring,Charstring) as stored;
create function hobbies(charstring p)-> bag of charstring h as 
  select h where (p,h) in hobbies_bag();

create function _person(integer ssn)->(charstring name, integer zip) as stored;

add hobbies("Tore")= "Painting";
add hobbies("Tore")= "Golfing";
set hobbies("Tore")= "Canoeing";
add hobbies("Tore")= "Exploring";
add hobbies("Tore")= "Exploring"; 
remove hobbies("Tore")= "Canoeing";
create function ind(integer)->integer;
set ind(1)=2;
set ind(ind(1))=1+ind(1);;
set ind(ind(ind(1)))=1+ind(ind(1));
lisp;

(checkequal "set/add/remove with bag semantics" 
	    ((osql "hobbies('Tore')	;") '(("Exploring")("Exploring"))) 
	    ;; BAG semantics!
	    ((osql "remove hobbies('Tore')='Exploring';") nil)
	    ((osql "hobbies('Tore')	;") '(("Exploring"))) ; BAG semantics!
	    ((osql "ind(3);") '((4)))
	    ((errstring (osql "set plus(1,2)=3;"))"Function not updatable")
	    ((errstring 
	      (osql "add theresolvent('foo')=functionnamed('plus');"))
	     "Function not updatable")
	    ((osql "remove ind(i)=j from integer i, integer j where j>2;") nil)
	    ((osql "select ind(i) from integer i;") '((2)))
	    ((osql "remove _person(ssn)= (name, zip)
from integer ssn, charstring name, integer zip
where ssn=1234567 and name='markus J';") nil)
	    )
:osql

rollback;

create function f(integer nonkey)->integer;
create function g(integer,integer)->integer;
set f(1)=1;
add f(1)=2;
set g(1,1)=11;
set g(1,2)=12; /* 1st arg has non-key index */
lisp;

