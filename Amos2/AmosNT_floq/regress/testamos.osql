create function Nametype (Type o)-> Charstring n
		 as select n where Name(o)=n;
create function TypeOfName (Charstring n)-> Type 
		 as select o from Type o where
	 object(o) and n = Nametype(o);
create function AgeOfPerson (Charstring p)-> Integer a as stored;
create function MgrOfPerson (Charstring p)->Charstring m as stored;
create function ageofmgr (Charstring p)-> Integer a
		 as ageofperson(mgrofperson(p));
create function AgeMgrOfPerson (Charstring p)->(Integer a,Charstring m)
		 as select a,m 
		 where a = AgeOfMgr(p) and m = MgrOfPerson(p);
create function MgrAgeOfPerson(charstring p) -> (charstring mgr,integer age)
		 as select mgr,age where (age,mgr) = agemgrofperson(p);
create function MgrAgeOfPerson2 (charstring p)->(charstring mgr,integer age)
		 as select mgr,age where mgr = mgrofperson(p)
                     and age = ageofperson(p);
create function sameage ()-> Charstring p
		 as select p from Integer m,Integer a
		 where a = m and m = ageofmgr(p)and a = ageofperson(p);
create function sameage2 ()-> Charstring p
		 as select p 
                 where ageofmgr(p)=ageofperson(p);
create function testr2(Charstring p)->Boolean b
		 as AgeMgrOfPerson(p)=AgeMgrOfPerson(p);
create function testr3(charstring p)->Boolean b
		 as select from integer a,charstring m
		 where  (a,m) = AgeMgrOfPerson(p) and
			(m,a) = MgrAgeOfPerson(p);
create function testr4 (Charstring p)-> Boolean b
		 as MgrAgeOfPerson(p)=MgrAgeOfPerson2(p);
create function eq (number x,number y)->boolean as x=y;
create function tuple1 (integer i,integer j)->boolean
		  as (i,j) = (j,i);
create function tuple2 (integer i,integer j)-> integer k
		 as select k where (i,j) = (j,k);
create function foo (Charstring c) -> Integer i as stored;
create function foo (Integer i)-> Integer j as stored;
create function foo (Real r) -> Integer i as stored;
create function streng() -> (charstring,charstring);
set streng()=('HEJ','hej');
declare Type :tmp;
set :tmp = typeofname("TYPE");
lisp;
(debugging t)
(checkequal
 "basic"
 ((caar(osql "#[OID 0];")) _object_)
 ;; All system object names are stored in CAPITALIZED case
 ((osql      "typenamed('object');") (list(list _object_)))
 ((osql "nametype(:tmp);") '(("TYPE")))
