/* Testing advanced boolean function calls */

create function foo(number)->number;
create function fie(number)->number;
create function eq(object x,object y) -> boolean as x=y;
create function myand(boolean x, boolean y) -> boolean 
  as x and y;
create function myor(boolean x, boolean y) -> boolean 
  as x or y;
set foo(1)=1;
set foo(2)=2;
set fie(1)=1;
set fie(2)=2;
set :ett=1;
set :tva=2;
lisp;
(checkequal "Boolean comparisons"
	    ((osql "select foo(1)=1;") '((true)))
	    ((osql "select foo(1)=2;") nil)
	    ((osql "select foo(1)=fie(1);") '((true)))
	    ((osql "foo(1)=fie(1);") '((true)))
	    ((osql "select foo(1)=1,fie(2)=2;") '((true true)))
	    ((osql "select foo(1)=1,fie(2)=3;") nil)
	    ((osql "select foo(x)=fie(x) from integer x;")
	     '((true)(true)))
	    ((osql "select foo(x+1)= fie(x)+1 from integer x;") '((true)))
	    ((osql "select foo(1)=1 and fie(1)=1;") '((true)))
	    ((osql "select foo(1)=1 and fie(1)=2;") nil)
	    ((osql "select myand(eq(foo(1),1),eq(fie(1),1));") '((true)))
	    ((osql "select myand(eq(foo(1),1),eq(fie(1),2));") nil)
	    ((osql "select eq(eq(foo(1),1),eq(fie(2),2));") '((true)))
	    ((osql "select eq(eq(foo(1),1),eq(fie(2),1));") nil)
	    ((osql "select 1= :ett;") '((true)))
	    ((osql "select 1= :tva;") nil)
	    ((osql "select 1= :ett and 1= :tva;") nil)
	    ((osql "select 1= :ett and 2= :tva;") '((true)))
	    ((osql "select 1=1 or 1=2;") '((true)))
	    ((osql "select 1=1 or 1=2;") '((true)))
	    ((osql ":ett + 1;") '((2)))
	    ((osql "select foo(1)=1 or foo(1)=2;") '((true)))
	    ((osql "select foo(1)=2 or fie(2)=1;") nil)
;	((osql "myor(eq(1,1),eq(1,2));") '((true)))
;	((osql "select myor(myand(eq(foo(1),1),eq(fie(2),3)),eq(fie(2),2));")
;	 '((true)))
	    ((osql "myand(true,true);") '((true)))
	    ((osql "myand(true,false);") nil)
	    ((osql "myor(true,false);") '((true)))
	    ((osql "myor(false,false);") nil)
	    ((osql "true or false;") '((true)))
	    ((osql "select x from integer x where true or x=1;") '((1)))
	    ((osql "select true;") '((true)))
	    ((osql "select true where 1=1;") '((true)))
	    ((osql "select false where 1=1;") nil)
	    ((osql "select from integer x where x = 1;") '((true)))
	    ((osql "select from integer x where x = 1 or x=2;") '((true)(true)))
	    )

