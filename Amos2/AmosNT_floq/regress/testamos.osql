/* User defined cost models */

create function ctest(integer)-> integer as
  multidirectional
  ("bf" foreign "ctestbf")
  ("ff" foreign "ctestff" cost {0.3,0.3});
lisp;

(defun dflt (x)(if (eq x '*) 0 x))
(defun ctestbf (fno x r)(osql-result x 1))
(defun ctestff (fno x r)(osql-result (dflt x) 2))

(checkequal "Cost functions"
	    ((osql "
select ctest(x) 
   from integer x
   where x=1;") '((1)))
	    ((osql "
select ctest(x) 
   from integer x;") '((2)))
	    )

