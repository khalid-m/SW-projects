	    ((osql "select 2+3-(1+4);") '((0)))
	    ((osql "select 3-1+5-2;") '((5)))
					; foreign C functions
            ((osql "typeof(:p)=typenamed('PERSON');") '((true)))
            ((osql "identity(1+3.5)+identity(3);") '((7.5)))
	    )

