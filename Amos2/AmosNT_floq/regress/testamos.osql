/*  Test of multiple '*' in ObjectLog */

create function f1(charstring) -> integer;
create function f2(charstring) -> integer;

add f1('a') = 1;
add f2('b') = 1;

create function f() -> integer as
select i
from integer i, charstring c1, charstring c2
where i = f1(c1) and
      i = f2(c2);

lisp;

