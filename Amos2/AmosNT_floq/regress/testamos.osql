create function bool1(boolean b,integer i) -> boolean c
   as b and i=1;
create function flag1()-> boolean as stored;
create function flag2(integer x)-> boolean 
  as flag1() and x > 1;
create function flag3() -> boolean 
  as flag1() and flag2(2);
create function flag4() -> boolean b as select b where b=flag3();
set flag1()=true;
create function f1(Integer i)->Boolean as i<=5;
create function f2(number x)->Boolean as f1(integer(x));
lisp;

