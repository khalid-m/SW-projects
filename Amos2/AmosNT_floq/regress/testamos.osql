:osql
create type Person;
create type Student under Person;
create function Name (Person p)-> Charstring n as stored;
create Person instances :p;
create Student instances :s;
set Name(:p)="Tore";
set Name(:s)="Ulla";
create function PersonNamed(Charstring nm)-> Person p
		 as select p from Person p where Name(p)=nm;
lisp;

(defun ocomp (x y)(string< (oid-name x)(oid-name y)))

(defun gettypel (l)
  (mapcar (f/l (tp)(gettypenamed tp)) l))

(checkequal 
 "type hierarchy"
 ((sort(oid-types amos_p)'ocomp)
  (gettypel '(OBJECT PERSON USEROBJECT)))
 ((sort(oid-types amos_s)'ocomp)
  (gettypel
   '(OBJECT PERSON STUDENT USEROBJECT)))
 ((osql "Name(:p);") '(("Tore")))
 ((osql "Name(:s);") '(("Ulla")))
 ((caar(osql "PersonNamed('Tore');")) amos_p)
 ((caar(osql "PersonNamed('Ulla');")) amos_s)
 ((externalize (sort (osql "typesof(:s);")
		     '(lambda (x y)(ocomp (car x)(car y)))))
  '((OBJECT) (PERSON)(STUDENT)(USEROBJECT)))
 ((null 
   (osql "select f from function f where typeof(f)=typenamed('RELATION');"))
  nil)
 ((osql "select name(o) from type o 
         where oid_nr(o) = oid_nr(typenamed('function'));") 
  '(("FUNCTION")))
 )

