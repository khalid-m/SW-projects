
create type Person properties ( 
	key Name Charstring key,
	key Age  Integer nonkey
	);

create function PersonNamed (Charstring n key) -> Person p key
	as select p where Name(p)=n ;

create function Married (Person husband key, Person wife key) -> Boolean as stored;

create function Husband (Person w) -> Person h
	as select h where Married ( h, w );

create function Wife (Person h) -> Person w
	as select w where Married ( h, w );

create function ParentChild (Person parent nonkey, Person child nonkey) ->
	Boolean as stored;

create function Parent ( Person c) -> Person p
	as select p where ParentChild ( p, c );

create function Child ( Person p) -> Person c
	as select c where ParentChild ( p, c );

create function Sibling ( Person p) -> Person s
	as select s
	   where s = Child(Parent(p)) and s != p;

create function Grandparent ( Person p) -> Person g
	as select g where g = Parent(Parent(p));

create function Grandchild ( Person p) -> Person g
	as select Child(Child(p));

create function Cousin ( Person p ) -> Person
	as select Child(Sibling(Parent(p)));

create type Course properties (
	key CourseName Charstring key
	);

create function CourseNamed (Charstring n key) -> Course c 
	as select c where CourseName(c)=n;

create type Student under Person properties (
	key GraduationYear Integer nonkey
	);

create function Enrollment (Student s nonkey, Course c nonkey, 
	Charstring t nonkey, Charstring g nonkey) -> Boolean as stored;

create function TakenBy (Student s) -> Course c
	as select c from Course c, Charstring t, Charstring g
	   where Enrollment(s, c, t, g);

create type Instructor under Student properties (
	key Salary Integer nonkey
	);

create function Assignment (Instructor i nonkey, Course c nonkey,
	Charstring t nonkey) -> Boolean as stored;

create function Taught (Instructor i) ->  Course
	as select c from Course c, Charstring t where Assignment(i, c, t);

