		/*  Queries  */



/* Find names and ages of all persons: */
/* ----------------------------------- */

lisp;
(checkequal "Find names and ages of all persons"
	((sorttuples(osql "select n, a
		 	from Person p, Charstring n, Integer a
			where Name (p) = n and Age (p) = a;"))
  	'(("Alice" 44) ("Arthur" 108) ("Barbara" 51) ("Bill" 50) ("Dan" 48) 
	 ("Dennis" 18) ("Helen" 48) ("Henry" 72) ("Jim" 52) ("Joanne" 18) 
	 ("Joe" 21) ("John" 81) ("Kim" 46) ("Linda" 81) ("Lisbeth" 69) 
	 ("Mary" 77) ("Michael" 45) ("Pam" 25) ("Peter" 25) ("Shirley" 22) 
	 ("Stacee" 19) ("Susan" 72) ("Tim" 76) ("Tom" 18) ("Victor" 78)))) 


; Find names of all students who enrolled in biology: */
; --------------------------------------------------- */

(checkequal "Find names of all students who enrolled in biology"
	((sorttuples(osql "select n	
		from Charstring n, Student s
		where Name(s) = n and CourseNamed('Biology') = TakenBy(s);"))
	     '(("Dennis") ("Helen") ("Jim") ("Joanne") ("Joe") ("Mary") 
		("Peter") ("Shirley"))))

; Find names of all cousins of Joe: */
; -------------------------------- */

(checkequal "Find names of all cousins of Joe"
	((osql "select distinct n
		from Charstring n
		where Name(Cousin(PersonNamed('Joe'))) = n;")
	 '(("Tom"))))

;Find all students who enrolled in classes in which their cousins enrolled: */
;-------------------------------------------------------------------------- */

(checkequal "Find all students who enrolled in classes in which their cousins enrolled"
	((osql "select distinct n1, n2, cn
		from Charstring n1, Charstring n2, Charstring cn, 
			Student s1, Student s2, Person s3, Course c, 
			Charstring t, Charstring g
		where Name(s1) > Name(s2) and
			Enrollment(s1, c, t, g) and Enrollment(s2, c, t, g)
			and s3 = Cousin(s1) and s2 = s3 and Name (s1) = n1 and
			Name (s2) = n2 and CourseName (c) = cn;")
	 '(("Peter" "Dennis" "Biology"))))
:osql
/* Translation of above query:						*/
/* select distinct Name(s1), Name(s2), CourseName			*/
/* from Student s1, Student s2, Person s3, Course, Charstring t, Charstring g */
/* where Name(s1) > Name(s2) and					*/
/*       Enrollment(s1, Course, t, g) and Enrollment(s2, Course, t, g)	*/
/* 	    and s3 = Cousin(s1) and s2 = s3;				*/

/* (Ordering on names imposed to avoid pairs coming up permuted.)	*/
/* Note:  Stricter type checking under present Iris no longer allows	*/
/* this form of query: 							*/
/* 									*/
/* select distinct Name(s1), Name(s2), CourseName			*/
/* from Student s1, Student s2, Course, Charstring t, Charstring g	*/
/* where Name(s1) > Name(s2) and					*/
/*       Enrollment(s1, Course, t, g) and Enrollment(s2, Course, t, g)	*/
/*       and s2 = Cousin(s1);						*/

		/*  Updates  */


