lisp;

(defun is-bound (x)(and x (neq x '*)(neq x 'false)))

(defun boundp- (fno x) (if (is-bound x)(osql-result x)))

:osql

create function boundp(Object x)->Boolean as foreign 'boundp-';

create function f1(Number x)->Number y as stored;
set f1(1)=2;
set f1(2)=3;
set f1(3)=4;

create function q1(Number x) -> (Number y, Number a, Number b, Number c) 
  /* Nested simple optional */
  as select x, a, b, c
     where  optional(a = f1(x) and
                     optional(b = f1(a) and c = f1(b)));

create function q2(Number x) -> (Number y, Number a, Number b, Number c) 
  /* Simple parallel optional */
  as select x, a, b, c
     where  optional(a = f1(x)) and
            optional(b = f1(a)) and
            optional(c = f1(b));

create function q3(Number x) -> (Number y, Number a, Number b, Number c)
  as select x, a, b, c+1
     where y=x+1 and
           optional(a = f1(y)) and
           b = f1(a)-1 and
           optional(c = f1(b)) and /* This is unsafe! */
           boundp(c);
            
create function q4(Number x) -> (Number y, Number z, Number a)
  as select y, z, a
     where y=f1(x) and (optional(z=f1(y)) or optional(a=f1(y+1)));

create function f(Integer x) -> Integer as stored; 
set f(2) = 20; 
set f(3) = 30; 

create function g(Integer x) -> Integer as stored; 
set g(3) = 300; 
set g(4) = 400; 

create function q5(Number x) -> Number 
  as select y
     from Number y, Number z
     where y=x-2 and optional(y=x+1) and y=z-2;

create function q6()-> Number
  as select y from number x, number y
     where optional(x in iota(1,4)) and y=identity(x);

lisp;

(checkequal "optional"
            ((osql "optional(1<2 and 1>2);") '((true)))
            ((null (printed-execution-plan (theselectbody 'q1))) nil)
            ((osql "select x from number x where optional(x=1);") '((1)))
            ((osql "select 3,x from number x where optional(x=1 and x>x);")
	     '((3 nil)))
	    ((osql "q1(1);") '((1 2 3 4)))
	    ((osql "q1(2);") '((2 3 nil nil)))
	    ((osql "q1(3);") '((3 4 NIL nil)))
	    ((osql "q1(4);") '((4 NIL NIL nil))))

(checkequal "parallel unbound optional"
	    ((osql "q2(1);") '((1 2 3 4)))
	    ((osql "q2(2);") '((2 3 4 nil)))
	    ((osql "q2(3);") '((3 4 1 2) (3 4 2 3) (3 4 3 4)))
	    ((osql "q2(4);") '((4 1 2 3) (4 2 3 4) (4 3 4 NIL)))

	    )

(checkequal "unbound parallel optional with predicates inbetween"
            ((osql "q3(1);") '((1 3 3 5)))
            ((osql "q3(2);") nil)
	    )

(checkequal "join from optional"
	    ((osql "q6();")'((1) (2) (3) (4))))

(checkequal "optional in disjunction"
	    ((osql "q4(1);") '((2 3 NIL) (2 NIL 4)))
            ((osql "
select x,y from Integer x, Integer y 
where x in iota(1,5) and 
      optional(y = f(x)) and 
      optional (y = g(x)); ")
	     '((1 NIL) (2 20) (3 30) (4 400) (5 NIL)))
            ((osql "
select x,y from Integer x, Integer y 
where x in iota(1,5) and 
      (y = f(x) or y = g(x));") '((2 20) (3 30) (3 300) (4 400)))
            ((osql "
select x,y from Integer x, Integer y 
where x in iota(1,5) and 
      optional(y = f(x) or y = g(x));") 
	     '((1 NIL) (2 20) (3 30) (3 300) (4 400) (5 NIL)))
	    )

(checkequal "Unify optional"
	    ((osql "q5(2);") '((0)))
	    )

:osql

rollback;
