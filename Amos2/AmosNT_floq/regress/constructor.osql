 * Description: Test parameterized constructors and aggregation operators
 ****************************************************************************
 * $Log: constructor.osql,v $
 * Revision 1.24  2011/01/27 11:26:14  torer
 * Changed from <...> to SQL's (...) notation for tuples (much nicer)
 *
 * Revision 1.23  2010/12/29 20:04:19  torer
 * No more vectorize errors because of automatic coersion between reals and integers
 *
 * Revision 1.22  2010/09/10 13:42:55  torer
 * More bagify tests
 *
 * Revision 1.21  2009/11/02 17:31:52  zeitler
 * Took out vsum procedure
 *
 * Revision 1.20  2008/11/11 07:46:14  torer
 * Stricter checking of conformance with result types in function definitions
 * Can be turned off with
 *    (setq _strict-resulttypes_ nil)
 *
 * Revision 1.19  2008/11/05 16:16:20  torer
 * select after 'as' optional
 *
 * Revision 1.18  2008/09/27 15:36:05  torer
 * New syntax for 'vector selection' as in SCSQ:
 *
 * vselect iota(2,10); <=> vectorof(select iota(2,20));
 *
 * Revision 1.17  2007/10/09 18:19:15  torer
 * Invertible string concatenation
 *
 * Revision 1.16  2007/01/30 17:58:22  torer
 * inn -> bagify
 *
 * Revision 1.15  2007/01/07 00:26:43  torer
 * Use of inferred vector types instead of casting
 *
 * Revision 1.14  2006/12/06 22:31:50  torer
 * Strict typing of vector constructors in queries
 *
 * Revision 1.13  2006/11/30 19:42:24  torer
 * Functions may return materialized bags
 *
 * Revision 1.12  2006/08/15 18:54:53  torer
 * Bug in unification of vector constructors with unequal arity
 *
 * Revision 1.11  2006/05/16 17:46:33  torer
 * Test inn and vectorize
 *
 * Revision 1.10  2006/05/03 20:00:48  torer
 * Testing infix 'in'
 *
 * Revision 1.9  2006/05/03 19:12:51  torer
 * Extensive testing of in(...)
 *
 ****************************************************************************/

create function foo(vector) -> integer;

set :v = {1,2,3};

create function bagger()->Bag as bag(1,2,3);

lisp;

(checkequal 
 "Type constructors"
 ((arraytolist amos_v) '(1 2 3))
 ((osql "select x from integer x where {x} = {1};") '((1)))
 ((osql "{1,2} = {1,2,3};") nil)
 ((osql "{1,2,3} = {1,2,3};") '((true)))
 ((osql "set foo(:v) = 123;") nil)
 ((osql "foo({1,2,3});") '((123)))
 ((osql "select v into :u from vector v,integer i where foo(v)=i;") nil)
 ((arraytolist amos_u) '(1 2 3))
 ((osql "select x from object x where {x,1} = {1,x};") '((1))))

(checkequal 
 "Function returning bag"
 ((osql "bagger();") '(((AGGR_BAG (1) (2) (3)))))
 ((osql "count(bagger());") '((3)))
 ((osql "in(bagger());") '((1) (2) (3)))
 )

:osql

create type history properties 
   (events vector of integer, 
    kind charstring);
create history (events,kind) instances 
   ({1,2,5},"eating"),
   ({3,6},"drinking");

declare vector of integer :v2;

set :v2 = {1,2};

set :a = {{1,2},{3,4}}; 

lisp;

(checkequal 
 "Typed sequences"
 ((osql "vsum({1,2,3});") '((6)))
 ((osql "select vsum(events(h)) from history h where kind(h)='eating';") 
  '((8)))
 ((osql "select x,y from integer x, integer y where {x,y}=:v2;") '((1 2)))
 ((osql "vsum(:v2);") '((3)))
 ((osql "select :v[i] from integer i;") '((1)(2)(3)))
 )

(checkequal 
 "IN generator"
 ((osql "in(select 'integer','integer');") '(("integer" "integer")))
 ((osql "in({1,2,3});") '((1) (2) (3)))
 ((osql "in({{1},{2}});") '((#(1)) (#(2))))
 ((osql "select x from object x where x in {1,2,3};") '((1) (2) (3)))
 ((osql "in(select 1);") '((1)))
 ((osql "in(select 1);") '((1)))
 ((osql "select x from object x where x in (select 1);") '((1)))
 ((osql "in(select 1,2);") '((1 2)))
 ((osql "select x,y from object x,object y where (x,y) in (select 1,2);")
  '((1 2)))
 ((osql "in(select {1,2},1);") '((#(1 2) 1)))
 ((osql "bagify({{1,2},{3,4}});") '((0 #(1 2)) (1 #(3 4))))
 ((osql "bagify(:a);") '((0 #(1 2)) (1 #(3 4))))
 ((osql "bagify(vselect iota(1,3));") '((0 1) (1 2) (2 3)))
 ((osql "vectorize(bagify({1,2,3}));") '((#(1 2 3))))
 )

:osql

rollback;




