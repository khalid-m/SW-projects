lisp;

(checkequal "eval"
	    ((osql "evalv('select iota(1,2),iota(1,2);');")
	     '((#(1 1)) (#(1 2)) (#(2 1)) (#(2 2))))
            ((plan-trail _select_) '(AND IOTA IOTA))
	    ((osql "evalv('select distinct iota(1,2)+iota(1,2);');")
	     '((#(2)) (#(3)) (#(4))))
	    )

:osql

create function afn(Integer x)-> Bag of (Integer y, Integer z) as stored;

add afn(1) = (1,1);
add afn(1) = (1,2);
add afn(1) = (2,1);
add afn(2) = (2,2);

create function _iota(Number l, Number u)->Bag of Integer as stored;

lisp;

(checkequal "Forward apply"
	    ((proccall(theresolvent 'iota)(vector 1 5)) t)
	    ((osql "apply(#'iota',{1,5});")
	     '((#(1)) (#(2)) (#(3)) (#(4)) (#(5))))
            ((osql "apply(functionnamed('plus'),{1,2})[0];")
             '((3)))
	    )

(checkequal 
 "Inverse apply"
 ((osql "select n from Number n where apply(#'sqrt',{n}) = {3};")
  '((9)))
 ((osql "select n from Number n 
                   where apply(functionnamed('sqrt'),{n}) = {3};")
  '((9)))
 ((osql "select i,j,k from Number i, Number j, Number k
                   where {i,j,k} in extent(#'afn');")
  '((1 2 1) (1 1 2) (1 1 1) (2 2 2)))
 )

(checkequal 
 "Cached function application"
 ((osql "cachedApply(#'iota',{1,3},#'_iota');") '((1) (2) (3)))
 ((osql "cachedApply(#'iota',{1,3},#'_iota');") '((3) (2) (1)))
 )

:osql

rollback;

