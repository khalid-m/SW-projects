 * Testing advanced updates
 *
 ****************************************************************************/

create function f0()->Bag of Number;

create function f02()->Bag of (Number, Number);

create function f1(Number x)->Bag of Number y;

set f1(1)=iota(1,3);
set f1(1)=iota(1,4);

set f1(2) = iota(4,6);
set f1(2) = iota(6,4);


set f1(3)=iota(10,11);
set f1(4)=iota(11,12);
set f1(5)=iota(12,13);
set f1(x)= iota(1,x-3) from Number x where x in iota(3,5);


set f1(6)=(select iota(1,3));

set f1(7)=(select iota(2,5));
set f1(7)=(select iota(5,2));

set f1(8)=iota(0,3);
set f1(8)=f1(8)+1;
set f1(8)=f1(8)-2;

set f1(x) = x+y from Number x, Number y 
                where y in iota(9,12) and x in iota(9,10) and x<y;

set f1(11) = x from Number x where x in {4,5,6};

lisp;

(checkequal
 "No argument set function value"
 ((osql "set f0()=iota(1,3);") nil)
 ((osql "f0();") '((1)(2)(3)))
 ((osql "set f0()=iota(4,1);") nil)
 ((osql "f0();")nil)
 ((osql "set f02()=(iota(1,2),iota(1,2));") nil)
 ((osql "f02();") '((1 1) (1 2) (2 1) (2 2)))
 ((osql "set f02()=(iota(3,4),iota(4,3));") nil)
 ((osql "f02();") '((3 NIL) (4 NIL)))
 ((osql "set f02()=(iota(4,3),iota(4,3));") nil)
 ((osql "f02();")nil)
 )

(checkequal 
 "Single argument set function value"
 ((sorttuples (osql "f1(1);")) '((1)(2)(3)(4)))
 ((osql "f1(2);") nil)
 ((osql "f1(3);") nil)
 ((osql "f1(4);") '((1)))
 ((sorttuples (osql "f1(5);")) '((1)(2)))
 ((sorttuples (osql "f1(6);")) '((1)(2)(3)))
 ((osql "f1(7);") nil)
 ((sorttuples (osql "f1(8);")) '((-1)(0)(1)(2)))
 ((sorttuples (osql "f1(9);")) '((19)(20)(21)))
 ((sorttuples (osql "f1(10);")) '((21)(22)))
 ((sorttuples (osql "f1(11);")) '((4) (5) (6)))
 )

:osql

create function f2(Number) -> Bag of (Number, Number);

set f2(1) = (1,1);

set f2(1) = (iota(1,2), iota(3,4));

set f2(2) = (iota(1,2),iota(10,11));
set f2(2) = (iota(2,1),iota(10,11));

set f2(3) = (1,6);
set f2(n) = (iota(1,n-2),-iota(1,n-3)) from Number n
            where n in iota(3,4);

set f2(n) = (iota(1,n-m),iota(m,n-1)) from Number m, Number n
            where n in iota(5,6) and m in iota(4,5);

set f2(n) = (iota(1,n-m),iota(m,n-1)) from Number m, Number n
            where n in iota(6,7) and m in iota(6,8);

lisp;

(checkequal 
 "Multiple argument set function value"
 ((sorttuples (osql "f2(1);")) '((1 3) (1 4) (2 3) (2 4)))
 ((osql "f2(2);") '((nil 10)(nil 11)))
 ((osql "f2(3);") '((1 nil)))
 ((sorttuples (osql "f2(4);")) '((1 -1)(2 -1)))
 ((sorttuples (osql "f2(5);")) '((1 4)))
 ((osql "f2(6);") nil)
 ((osql "f2(7);") '((1 6)))
 )

:osql

create function f3(Number x, Number y) -> Bag of (Number a, Number b)
  as stored;

set f3(1,1)=(1,2);

set f3(1,2)=(3,4);

set f3(1,1) = f3(1,2);

lisp;

(checkequal
 "Setting tuple valued functions"
 ((osql "f3(1,1);") '((3 4)))
 )

:osql
rollback;