/******************* NOTICE !!!!!!!!!!!!!!! *******************/
/* Anybody resetting optimization flags should restore them   */
/* again and all optimizer flags should be transactional!!!   */
/**************************************************************/

lisp;

(checkequal "Amos Lisp code"
	    ((verify-all) t)
	    )

:osql
debugging(true);
< 'readtest.osql';
< 'nb_printread.osql';
load_lisp("coroutines.lsp");
< 'cfunctions.osql';
< 'testamos.osql';
load_lisp("mapquery.lsp");
load_lisp("scanregress.lsp");
normalization(false);
< "testamos.osql";
normalization(true);
< 'resolverr.osql';
< 'apply.osql';
< 'bags.osql';
< 'tuple.osql';
< 'null.osql';
< 'optional.osql';
< 'paroptional.osql';
< 'updates.osql';
< 'wildcard.osql';
< 'disjunctions.osql';
< 'rewrite.osql';
< 'multidir.osql'; 
< 'compkey.osql';
< 'mapped.osql';
< 'coerce.osql';
< 'optimizer.osql';
< 'distinct.osql';
load_lisp("testsubplan.lsp");
< 'sample.osql'; 
< 'person.osql';
< 'school.osql';
< 'cursor.osql';
< 'join.osql';
< 'index.osql';
< 'drugs.osql';
< 'typeinf.osql';
< 'testagg.osql';
< 'groupby.osql'; 
< 'testvector.osql';
< 'streams.osql';
lisp;
(load "topk.lsp")
(load "ntuples.lsp")
(load "plot.lsp")
(if (not (getenv 'releasing))(load "record.lsp"))
:osql
< 'prime.osql';
< 'genoverl.osql';
/*< 'family.osql'; recursion disallowed */
< 'proc.osql'; 
< 'recproc.osql';
< 'lobbug.osql';
< 'inferequal.osql';
< 'constructor.osql'; /* Leak */
< 'redeffns.osql';
< 'testlate.osql'; /* Leak */
< 'if.osql';
< 'correctedbugs.osql';
< 'tclose.osql';
< 'mbt.osql'; /* Big leak! */
< 'mbt-rewrite.osql'; 
< 'dt.osql'; /* Leak */
< 'integr.osql'; /* Big leak */
< 'test_temporal.osql';
< 'testupdates.osql';
< 'testunload.osql';
load_lisp("typeinf.lsp");
< 'transient.osql';

/************ Testing optimization options *****************/
latebinding("OR"); /* Implement late binding as disjunctions */
< 'testlate.osql';
latebinding("DTR"); /* Back to default!!! */

optmethod("randomopt"); /* Test randomized optimization */
<'testamos.osql'; 
<'testvector.osql';

optmethod("exhaustive"); /* Test dynamic prog. optimization */
normalization(false);
< "testamos.osql";
<'testvector.osql';
normalization(true);

optmethod("ranksort");
rollback;
/************* Testing creating many objects ****************/
< 'manyobjs.osql';
/************* Testing ECA rules ****************/
lisp;
(cond (_eca-enabled_ (load-amosql "eca_rules.osql")
                     (load-amosql "net_effect.osql")
                     (load-amosql "eca_without_logging.osql")))
:osql

/***********  Testing statistics *********************/
lisp;

(load "stat.lsp")

;(with-directory "../lsp/grm" (load "ascend.lsp"))
;(with-directory "../lsp/grm" (load "regress.lsp"))
;;; New Charstring-based SparQL parser regression test
;(with-directory "../lsp/sparql-lsp-parser/test" (load "regress.lsp"))

:osql


