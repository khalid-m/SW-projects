create function income (Charstring nm)->Integer i as stored;

create function income (Integer i)->Integer j as stored;

create function incomes ()->Bag of Integer i 
		 as select i
			from charstring nm
			where income(nm) = i;

create function highincomes (integer thres)->Bag of Integer h
		 as select h 
			from charstring m
		 	where h = income(m) and h > thres;

create function countincomes ()->Integer i
		 as count(incomes());

create function sumhighincomes ()->Integer i
		 as sum(highincomes(5));

create function nonericher (Integer i)->Boolean
		 as notany(highincomes(i));

/* nested selects, always within (select .... ) : */

create function sumincomes3 ()->Integer s
		 as select sum(b)
		 from Bag of Integer b
		 where b = (select i
				from Integer i, Charstring nm
				where i > 3 and i = income(nm));

create function sumincomes5 (Integer l,Integer u)->Integer s
		 as select sum(b)
		 from Bag of Integer b,Integer u1,Integer l1
		 where b = (select i from Integer i,Charstring nm
				where i >= l1 and i <= u1 and i = income(nm))
			and u1 = u+0
			and l1 = l+0;

create function sumincomes4 (Integer thres)->Integer s
		 as select sum(b)
		 from Bag of Integer b
		 where b = bagof(highincomes(thres));

create function sumincomes6 ()->Integer s
		 as select sum(b) 
		 from Bag of Integer b
		 where b = (select incomes());

create function sumincomes2 ()->Integer s
		 as sum(incomes());

create function butlowestincomes(Integer d)->Bag of Integer i
                 as select i
                 from Integer i,Charstring p
                 where some(select from Charstring q
                             where income(q)+d < i)
                       and i = income(p);

create function lowestincomes (Integer d)->Bag of Integer i
		 as select i 
		 from Integer i,Charstring nm
		 where notany(select j
				from Integer j,Charstring m
				where j+d < i and
				      j = income(m))
			and i = income(nm);

create function local_scope()->Integer i
 as select i 
    where i = sum(select i from Integer i where i in iota(1,3));

create function tavg(Bag of Number b)->Number
  as sum(b)/count(b);

create function tavg(Bag of Integer b)->Integer as 1;

create function vectorbags()->Bag of Vector
  as {iota(1,10)};

set income("A")=1;
set income("b")=2;
set income("c")=3;
set income("d")=4;
set income("e")=5;
set income("f")=6;
set income("g")=7;
           /****  testing ****/
lisp;
(checkequal "Aggregation"
 ((osql "countincomes();") '((7)))
 ((osql "sumhighincomes();") '((13)))
 ((osql "nonericher(1);") nil)
 ((osql "nonericher(100);") '((true)))
 ((osql "sumincomes2();") '((28)))
 ((osql "sumincomes3();") '((22)))
 ((osql "sumincomes4(3);") '((22)))
 ((osql "sumincomes4(4);") '((18)))
 ((osql "sumincomes5(1,7);") '((28)))
 ((osql "sumincomes5(2,6);") '((20)))
 ((sorttuples(osql "BUTLOWESTINCOMES(0);"))
  '((2) (3) (4) (5) (6) (7)))
 ((sorttuples(osql "BUTLOWESTINCOMES(1);")) 
  '((3) (4) (5) (6) (7)))
 ((sorttuples(osql "LOWESTINCOMES(0);")) '((1)))
 ((sorttuples(osql "LOWESTINCOMES(1);")) '((1)(2)))	
 ((osql "some((select 1));") '((true)))
 ((osql "some(select 1);") '((true)))
 ((osql "local_scope();") '((6)))
 ((osql "count(select v from vector of vector v where v={{1}});")
     '((1)))
 ((osql "tavg(select i from number i,charstring c where income(c)=i);")
    '((4)))
 ((osql "tavg(select i from integer i,charstring c where income(c)=i);")
    '((1)))
 ((osql "tavg(select 2);") '((1)))
 ((osql "tavg(select 1.1);") '((1.1)))
 ((osql "1+maxagg(iota(1,4));") '((5)))
 ((osql "maxagg(select i from integer i where i in {1,2,3});") 
      '((3)))
 ((osql "maxagg(select i from object i where i in {1,2,3});") 
      '((3)))
 ((osql "minagg(iota(1,3))+2;") '((3)))
 ((osql "1+cast(in(section(streamof(iota(1,100)),30,32))
           as Integer);") '((31) (32) (33)))
 ((osql "first(argrestypes(#'iota'));")
   '((1 #[OID 8 "NUMBER"] 0))) 
 ((osql "last(argrestypes(#'iota'));")
   '((3 #[OID 9 "INTEGER"] 1)))
 ((osql "1+unique(select i from integer i where i in iota(1,4) or i in iota(3,5));")
  '((2) (3) (4) (5) (6)))
 ((osql "1+exclusive(select i from integer i where i in iota(1,4) or i in iota(3,5));")
  '((2) (3) (6)))
 ((osql "count(select v[0] from vector v where v in vectorbags());") '((10)))
 )
:osql

/* Test of UNIQUE and EXCLUSIVE */

create function foo(Integer)->Integer;
set foo(1)=1;
set foo(2)=1;
set foo(3)=2;

create function bar()->Bag of Integer as 
	select unique (select f from Integer f, Integer j 
			where foo(j)=f);

create function fie()->Bag of Integer as
	select exclusive (select f from Integer f, Integer j 
			  where foo(j)=f);

lisp;
(checkequal "Unique & Exclusive"
	    ((osql "bar();") '((1) (2)))
	    ((osql "fie();") '((2)))
	    )
:osql
set :b0 = bag(1,2,3);
set :c = bag(1+2,2+3);

create function bagger()->Bag as bagof(iota(1,3));
set :bg=bagger();

lisp;
(checkequal "Bag literals and functions"
	    ((osql "count(:b0);") '((3)))
	    ((osql "count(bag(1,2,3));") '((3)))
	    ((osql "in(bagger());") '((1) (2) (3)))
	    ((osql "in(:bg)+1;") '((2) (3) (4)))
	    ((osql "sum(:bg);") '((6)))
	    ((osql "sum(in(:bg));") '((6)))
	    )
:osql

create function ints()->Integer;

create function bagvar()->Integer as
   select sum(b) 
   from Bag of Integer b
   where b = ints();

add ints()=1;
add ints()=2;

lisp;

(checkequal "Bag coersion when binding variable"
  ((osql "bagvar();") '((3)))
)
:osql

create function strings()->Bag of Charstring r;
create_index("strings","r","mbtree",'multiple');

add strings() = "Apa";
add strings() = "Banan";
add strings() = "Bil";

lisp;
(checkequal "String aggregates"
   ((osql "concatagg(inject(strings(),' and '));") 
  '(("Apa and Banan and Bil")))
)
:osql
/***********************************/
/* Statistical operators over bags */
/***********************************/

create function products(Bag of (Real,Real) v) -> Bag of Real p
  /* declarative definition */
  as select x*y from Real x, Real y 
                where (x,y) in v;
    
create function wavg(Bag of (Real,Real) b)->Real
  as sum(products(b));


create function wavg2(Bag of (Real,Real) b)->Real
  /* 'procedural' definition */
  as begin
       declare Real res;

       set res=0.0;
       for each Real x, Real y where (x,y) in b
         set res = res + x*y;
       return res;
     end;    

create function tavg(Bag of Real x)->Real
  as sum(x)/count(x);

create function squarediffs(Bag of Real b, Real x)->Bag of Real
  as select (y-x)*(y-x) from Real y 
                        where y in b;

create function variance(Bag of Real b)->Real
  as sum(squarediffs(b,tavg(b)))/(count(b)-1);

declare bag of (Real,Real) :b;
set :b = bag({0.6, 1.0},{0.1, 2.0}, {0.3,5.0});

declare bag of real :b2;
set :b2 = bag(1.0, 2.0, 3.0);

lisp;
(checkequal "Advanced aggregation"
   ((osql "wavg(:b);") '((2.3)))
   ((osql "wavg2(:b);") '((2.3)))
   ((osql "tavg(:b2);") '((2.0)))
   ((osql "variance(:b2);") '((1.0)))
)
:osql

/**************************************/
/* Statistical operators over vectors */
/**************************************/

create function products(Vector of (Real,Real) v) -> Vector of Real p
  /* declarative definition */
  as vselect x*y from Real x, Real y 
                 where (x,y) in v;

create function vsum(Vector of Real v)->Real
  as sum(select in(v));
     
create function wavg(Vector of (Real,Real) b)->Real
  as vsum(products(b));


create function wavg2(Vector of (Real,Real) b)->Real
  /* 'procedural' definition */
  as begin
       declare Real res;

       set res=0.0;
       for each Real x, Real y where (x,y) in b
         set res = res + x*y;
       return res;
     end;    

create function tavg(Vector of Real x)->Real
  as vsum(x)/dim(x);

create function squarediffs(Vector of Real b, Real x)->Vector of Real
  as vselect (y-x)*(y-x) from Real y 
                         where y in b;

create function variance(Vector of Real b)->Real
  as vsum(squarediffs(b,tavg(b)))/(dim(b)-1);

declare Vector of (Real,Real) :b;
set :b = {{0.6, 1.0},{0.1, 2.0},{0.3, 5.0}};

declare Vector of Real :b2;
set :b2 = {1.0, 2.0, 3.0};

lisp;
(checkequal 
 "Advanced vector aggregation"
 ((osql "wavg(:b);") '((2.3)))
 ((osql "wavg2(:b);") '((2.3)))
 ((osql "tavg(:b2);") '((2.0)))
 ((osql "variance(:b2);") '((1.0)))
 )

:osql

create function reals()-> Bag of Real;

create function square(Number x)->Number r as
  select r where sqrt(r)=x;

create function varcnt(Bag of Real r)-> (Number var, Number cnt) 
   as select sum(square(in(r))), count(r);

create function positive(Number r)-> Number
   as select r where r>=0;

create function stddev(Number var, Number cnt)->Real
  as positive(sqrt(var))/(cnt-1);

create function swap(Number x, Number y) -> (Number, Number)
  as select y,x;

add reals()=1.1;
add reals()=2.2;
add reals()=3.5;
add reals()=4.7;

lisp;

(checkequal "Tuple application"
   ((osql "round(stddev(varcnt(reals()))*100);") '((212)))
   ((osql "round(stddev(swap(swap(varcnt(reals()))))*100);") '((212)))
)

:osql
/* nested parameterized collections */

create function npc(Bag of Vector of Vector of Integer b)-> Integer
  as in(b)[0][0]+1;

declare Bag of Vector of Vector of Integer :npc;
set :npc = bag({{1}});

lisp;

(checkequal 
 "Nested collection parameterization"
 ((osql "npc(cast(bag({{1}}) as Bag of Vector of Vector of Integer));")
  '((2)))
 ((osql "npc(:npc);") '((2)))
 )
:osql

rollback;
/* Sorting */

create function srtdata()->Bag of (Integer, Vector);
add srtdata()= (1,{1,2});
add srtdata()= (1,{1,0});
add srtdata()= (2,{3,0});
add srtdata()= (3,{3,0});
add srtdata()= (4,{0,0});

lisp;

(checkequal "sorting"
  ((osql "sort(srtdata());")
   '((#(#(1 #(1 0)) #(1 #(1 2)) #(2 #(3 0)) #(3 #(3 0)) #(4 #(0 0)))))) 
  ((osql "sort(srtdata(),'dec');")
   '((#(#(4 #(0 0)) #(3 #(3 0)) #(2 #(3 0)) #(1 #(1 2)) #(1 #(1 0))))))
  ((osql "sortbagby(srtdata(),1,'inc');")
   '((#(#(1 #(1 2)) #(1 #(1 0)) #(2 #(3 0)) #(3 #(3 0)) #(4 #(0 0))))))
  ((osql "sortbagby(srtdata(),2,'inc');")
   '((#(#(4 #(0 0)) #(1 #(1 0)) #(1 #(1 2)) #(3 #(3 0)) #(2 #(3 0))))))
  ((osql "sortbagby(srtdata(),2,'dec');")
   '((#(#(2 #(3 0)) #(3 #(3 0)) #(1 #(1 2)) #(1 #(1 0)) #(4 #(0 0))))))
  ((osql "sortbagby(srtdata(),{2,1},{'inc','dec'});")
   '((#(#(4 #(0 0)) #(1 #(1 0)) #(1 #(1 2)) #(3 #(3 0)) #(2 #(3 0))))))
  ((osql "sortbagby(srtdata(),{1,2},{'dec','inc'});")
   '((#(#(4 #(0 0)) #(3 #(3 0)) #(2 #(3 0)) #(1 #(1 0)) #(1 #(1 2))))))   
  ((osql "sortvector({4,3,2,3},'<');")
   '((#(2 3 3 4))))
  ((osql "sortbag(bag(4,3,2,3),'<');")
   '((#(2 3 3 4))))
)

:osql

rollback;


