create function bglisteners() -> (charstring name, charstring host, 
                                  integer port);

create function bglisteners(charstring name)-> (charstring host, integer port)
  as select host, port
     where (name, host, port) in bglisteners();

nameserver("s");

lisp;
(if (debugging-enabled) (trace server-eval))
:osql

listen();
