 * $RCSfile: compkey.osql,v $
 * $Revision: 1.3 $ $Date: 2006/04/15 18:48:23 $
 * $State: Exp $ $Locker:  $
 *
 * Description: Testing compound keys
 *
 ****************************************************************************
 * $Log: compkey.osql,v $
 * Revision 1.3  2006/04/15 18:48:23  torer
 * Possibility to specify 'key' on multidirectional implementation
 *
 * Revision 1.2  2006/04/12 15:58:02  torer
 * Sorted execution predicate
 *
 * Revision 1.1  2006/04/08 15:39:13  torer
 * Testing compound keys
 *
 ****************************************************************************/

create function foo(Integer i,Integer j) -> Integer r as stored;

declare_key(theresolvent('FOO'),{'i','j'});
declare_key(theresolvent('FOO'),{'r'});
declare_key(theresolvent('FOO'),{'i','r'});
undeclare_key(theresolvent('FOO'),{'i','r'});
set foo(1,2)=12; 
set foo(1,3)=13; 
set foo(2,3)=23;
lisp;

(checkequal 
 "Compound keys"
 ((osql "sort(declared_keys(theresolvent('FOO')));") 
  '((#(#("I" "J") #("R")))))
 ((osql "select r from integer r,integer i, integer j 
         where foo(i,j)=r and foo(i,j)=23;") '((23)))
 ((sort-predicate (externalize (selectbody-pred(getselectbody _select_))))
  '(AND (OBJECT.OBJECT.=->BOOLEAN R 23) 
	(P_INTEGER.INTEGER.FOO->INTEGER I J 23)))
 ((osql "select i,j from integer r,integer i, integer j 
         where foo(i,j)=r and foo(1,2)=r;")
  '((1 2)))
 ((sort-predicate (externalize (selectbody-pred(getselectbody _select_))))
  '(AND (OBJECT.OBJECT.=->BOOLEAN I 1) 
	(OBJECT.OBJECT.=->BOOLEAN J 2) 
	(P_INTEGER.INTEGER.FOO->INTEGER 1 2 R)))
 ((osql "select i from number i, number j where i+j=1 and i+j=2;") nil)
 )

:osql
rollback;
