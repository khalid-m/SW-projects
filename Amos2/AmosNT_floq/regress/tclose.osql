create function father (Charstring c)->Charstring f as stored;
create function mother (Charstring c)->Charstring m as stored;
create function orphan (Charstring p)->Boolean as stored;
create function french (Charstring p)->Boolean as stored;

set father("jane")="bill";
set father("liz")="ed";
set father("ed")="henry";
set father("mary")="henry";
set father("max")="henry";
set father("ann")="john";
set father("bill")="kent";
set father("sally")="kent";


set mother("bill")="ann";
set mother("sally")="ann";
set mother("liz")="jane";
set mother("mary")="linda";
set mother("max")="linda";
set mother("ann")="nicole";
set mother("ed")="sally";

set orphan("henry")=TRUE;
set orphan("john")=TRUE;
set orphan("kent")=TRUE;
set orphan("linda")=TRUE;
set orphan("nicole")=TRUE;

set french("henry")=TRUE;
set french("john")=TRUE;
set french("kent")=TRUE;
set french("nicole")=TRUE;

create function parents(Charstring child)->Bag of Charstring
  as select p 
     from Charstring p
     where p = father(child) or 
           p = mother(child);

create function ancestors(Charstring dsc)->Bag of Charstring
  as select anc
     from Charstring anc
     where anc in tclose(#'parents',dsc) and
           anc != dsc;

create function tancestors(Charstring dsc)->Bag of Charstring
  as select anc
     from Charstring anc
     where anc in traverse(#"parents",dsc) and
           anc != dsc;

create function descendants(Charstring anc)-> Bag of Charstring
  as select dsc
     from Charstring dsc
     where anc in tclose(#"parents",dsc) and
           anc != dsc;

create function tdescendants(Charstring anc)->Bag of Charstring
  as select dsc
     from Charstring dsc
     where anc in traverse(#"parents",dsc) and
           anc != dsc;

create function parentsd(Charstring nm, Integer d)->Bag of (Charstring,Integer)
  as select parents(nm), 1+d;

create function ancestorsd(Charstring nm)->Bag of (Charstring,Integer)
  as tclose(#'parentsd',nm,0);

create function offspringsd(Charstring nm)->Bag of (Charstring,Integer)
  as select o, d
     from Charstring o, Integer d
     where (nm,0) in tclose(#'parentsd',o,-d) and
           o != nm;

create function generation_depth(Charstring x)-> Integer
  as maxagg((select d 
             from Integer d, Charstring r
             where (r,d) in tclose(#"parentsd",x,0)));

create function grandchildren(Charstring x, Integer lev)->Bag of Charstring
  as select c
     from Charstring c
     where (c, lev) in offspringsd(x);

lisp;

(checkequal 
 "Transitive closure"
 ((osql "ancestors('bill');")
  '(("kent") ("ann") ("john") ("nicole")))
 ((osql "tancestors('bill');")
  '(("kent") ("ann") ("john") ("nicole")))
 ((osql "ancestorsd('bill');")
  '(("bill" 0) ("kent" 1) ("ann" 1) ("john" 2) ("nicole" 2)))
 ((osql "offspringsd('ann');")
  '(("bill" 1) ("jane" 2) ("liz" 3) ("sally" 1) ("ed" 2)))
 ((osql "generation_depth('bill');")
  '((2)))
 ((osql "grandchildren('ann',2);")
  '(("jane") ("ed")))
 ((osql "descendants('kent');")
  '(("bill") ("jane") ("liz") ("sally") ("ed")))
 ((osql "tdescendants('kent');")
  '(("bill") ("jane") ("liz") ("sally") ("ed") ("liz")))
 ((osql "select x from Charstring x where 'kent' in ancestors(x);")
  '(("bill") ("jane") ("liz") ("sally") ("ed")))
 )
:osql

create function mynxt(Number x) -> Number
  as select x + 1 where x < 4;

create function mynxt1(Number x) -> Bag of Number
  as select x + 1 where x < 4;

create function mynxt2(Number x, Number y) -> (Number, Number)
  as select x - 1, y + 1 where x > 0;

lisp;

(checkequal "iterate"
	    ((osql "iterate(#'mynxt',6,0)+1;") '((5)))
	    ((osql "iterate(#'mynxt',3,0)+1;") '((4)))
            ((errstring (osql "iterate(#'mynxt',6,0,1);"))
             "Wrong number of arguments in iterate()")
	    ((errstring (osql "iterate(#'mynxt1',3,0)+1;"))
             "Not a closed function")
            ((osql "iterate(#'mynxt2',5,3,3);") '((0 6)))
            ((errstring (osql "iterate(#'mynxt2',5,3);"))
             "Wrong number of arguments in iterate()")
	    )

:osql

rollback;
