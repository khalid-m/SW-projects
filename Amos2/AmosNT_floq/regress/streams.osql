set :b = (select iota(1,4));
set :s = streamof(iota(1,4));

create function siota(integer i, integer j)
                    ->stream
  as streamof(iota(i,j));

lisp;

(checkequal 
 "Datatype STREAM"
 ((osql "name(typeof(:b));") '(("BAG-INTEGER")))
 ((osql "name(typeof(:s));") '(("STREAM-INTEGER")))
 ((osql "select i+1 from integer i where i in :s;")
  '((2) (3) (4) (5)))
 ((osql "select in(:s)+2;") '((3) (4) (5) (6)))
 ((osql "sum(:b);") '((10)))
 ((osql "select in(s) from stream s
          where s = streamof(select iota(1,4));")
  '((1)(2)(3)(4)))
 ((osql "select in(s) from stream s, integer n
          where s = streamof(iota(1,n))
          and n in iota(3,4);")
  '((1) (2) (3) (1) (2) (3) (4)))
 ((osql "select i from stream s, integer i where s = siota(1,5) and i in s;")
  '((1) (2) (3) (4) (5)))
 )
:osql

/*** Scans over streams ***/

open :c1 for siota(1,100);

open :c2 for bag(siota(1,2),siota(4,5));

lisp;

(checkequal "Scans over streams"
	    ((osql "next(:c1);") '((#(1))))
	    ((osql "next(:c2);" )'((#(1))))
	    ((osql "next(:c2);") '((#(2))))
	    ((osql "next(:c2);") '((#(4))))
	    ((osql "next(:c2);") '((#(5))))
	    )
(defglobal _csv-result_)

(setq _csv-result_ 
      '((#(1.2 2.3)) (#(1.3 4)) (#(1.062934249E+016  5)) 
	(#(2.3 6)) (#(6.7 7.7)) 
	(#(8.3)) (#(5 6 7 8 9 10 11)) (#(5 "hej du" 6 7)) 
	(#(5 "  hej" "ab,c\"d")) (#(5 "hej" nil)) (#("hej")) 
	(#("hej" NIL)) (#("abc
de"))))

(checkequal 
 "CSV file stream"
 ((osql "tuples(csv_file_stream('CSVfile.csv'));") _csv-result_)
 ((osql "tuples(csv_file_stream('CSVfile.csv'));") _csv-result_)
   )

(checkequal 
 "Playbacks"
 ((osql "playback2(streamof(select iota(1,3)/4,'a'));")
  '((0.25 "a") (0.5 "a") (0.75 "a")))
 )

:osql


rollback;
