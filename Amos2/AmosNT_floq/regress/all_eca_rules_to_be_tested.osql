set income(:e8) = 10000;
*/

rollback;

<  'base_sample.osql';

/* ------------------------------------------------------------------------ */

/* Rules #10 and #11 are CA rules, have been removed */

/* These are only compensatory changes for the removed CA rules: */

set income(:e1) = 10000;
set income(:e2) = 10000;
set income(:e3) = 7000;

/* ------------------------------------------------------------------------ */

/* Example of rule termination */

set income(:e3) = 10000;
set taxes(:e3) = .25;

create rule rule12() as
	from employee_r e
	on updated(income(e))
	when income(e) > 20000
	do set taxes(e) = .2;

create rule rule13() as
	from employee_r e
	on updated(taxes(e))
	when employee_r.netincome->number(e) < 10000
	do set income(e) = 25000;

activate rule rule12();
activate rule rule13();

set income(:e1) = 22000;

ruleCheck();
deactivate rule rule12();
deactivate rule rule13();

lisp;
(checkequal
	"Rule termination "
	((osql "income(:e1);") '((25000))))
:osql

/* !!!! Rule12 and Rule13: :e1 is 22000, not 25000! Not triggered ???? */
/* Dummy update for absent rule execution (REMOVE LATER): */
set income(:e1) = 25000;
ruleCheck();

