;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;UT materialzation tests
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


(checkequal
 "MDB test: Materialization of IT instances and type change"
;select an object in the intersection part of the integration type
;:e1 and :je1 should be the same object and not nil
 ((osql "select e into :e1  from int_emp e where issn(e) = 25;") nil)
 ((osql "select e into :je1 from join_int_emp e where issn(e) = 25;") nil)
 ((osql "select e into :eeo1 from only_eds_ee_emp e where issn(e) = 25;") nil)
 ((osql "real_salary(:e1);") '((50)))
 (amos_e1 amos_je1)
 ((arg-type amos_e1) (gettypenamed 'join_int_emp))

;get the corresponding proxy towards foo
 ((osql "select ef into :ef from emp@foo  ef where ef = :e1;") nil)
 ((oid-p  amos_ef) T)

;delete the corresponding instance in foo
 ((remote-eval (list 'deleteobject amos_ef) 'FOO) amos_ef)
;((remote-eval (list 'deleteobject amos_ef) 'FOO) nil)

;the same selects as before, now it should be in int_emp and only_eds_ee_emp
 ((osql "select e into :e2  from int_emp e where issn(e) = 25;") nil)
 ((osql "select e  from join_int_emp e where issn(e) = 25;") nil)
 ((osql "select e into :eeo2 from only_eds_ee_emp e where issn(e) = 25;") nil)
 ((arg-type amos_e2) (gettypenamed 'only_eds_ee_emp))
 (amos_e2 amos_e1)
 (amos_e2 amos_eeo2)
 ((length (osql "select ei from int_emp ei;")) 100)
 ((osql "select real_salary(ie) from int_emp ie where issn(ie) = 25;") '((25)))

;create a instance in FOO which comes in the view
 ((remote-eval '(create-userobjects 
		 Emp (ssn age name salary lab) 
		 ((200 200 "new_emp" 200  "edslab"))) 'FOO) nil)

 ((length (qm1)) 10)
 ((length (qm2)) 81)
 ((length (qm3)) 10)
 ((osql "select ie into :e3 from int_emp ie where issn(ie) = 200;") nil)
 ((osql "real_salary(:e3);") '((200)))
 ((osql "real_name(:e3);") '(("new_emp")))

;create instance in FIE corresponding to :e3
 ((remote-eval '(create-userobjects ee_Emp (id  name pay  wplace) 
				    (("200"  "new_empA" 150 1))) 'FIE) nil)

;here there is a bug: real_name(:e3) won't work now after the chabge!!!!


 ((osql "select real_name(ie), real_salary(ie) 
	from int_emp ie 
        where issn(ie) =200;") 
  '(("new_empA" 350)))

;another bug:
;((osql "select real_name(ie), real_salary(ie) 
;        from int_emp ie where ie = :e3;")
; '(("new_empA" 350)))

 ((length (qm1)) 11)
 ((length (qm2)) 80)
 ((length (qm3)) 10)
 )


:osql
rollback;


