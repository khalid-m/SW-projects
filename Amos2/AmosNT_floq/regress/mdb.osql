;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


(defun qa1 () 
  (osql "select je into :je  from join_int_emp je where pay(je)=22;"))

(checkequal
 "MDB test: parametrized mdb functions"
 ((osql "gs(1);") nil) 
 ((let ((r (osql "gs(25);"))) (and (eq 1 (length r)) (oid-p (caar r)))) T) 
 ((osql "fn1('emp22');") '((44)))
 ((qa1) nil)
 ((oid-p amos_je) T)
 ((osql "select real_salary(:je);") '((44))))

