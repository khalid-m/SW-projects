/*cleardebug();*/
enable_dt(true);
enable_mdb();
commit;
lisp;

(debugging t)
(setq *DSVE-STRATEGY* 'dsve-full) ; test with distributed view expansion
(setq _tree-distribution_ t) ; test with tree rebalancing
(formatl t  "MDB test: begining of the query compilation tests block" t)
(checkequal
 "MDB test: connecting to the servers and importing types and functions"
 ((let ((result_list 
	 (list 
	  (osql "register('client');")
	  (osql "import_db('foo');")
	  (osql "import_db('fie');")
	  (osql "import_type('emp', 'foo');")
	  (osql "import_type('EE_emp', 'fie');")
	  (osql "import_func('CHARSTRING.ID_TO_SSN->INTEGER', 'fie');"))))
    (cons (length result_list)
	  (mapcar (f/l (e) (if (oid-p (caar e)) 
			       (list (list (mkstring (oid-name (caar e))))) 
			     e)) 
		  result_list)))
  '(6 (("client")) (("FOO")) (("FIE")) 
      (("EMP_FOO")) (("EE_EMP_FIE")) (("CHARSTRING.ID_TO_SSN->INTEGER")))
  ))

(global-eval '(setq *optimizing-message* nil)) ; tooloud otherwise

(checkequal
 "MDB test: definition of derived types over imported types"

;MODELING OF THE INTEGRATION SCHEMA
 ((oid-p
   (osql "
create derived type eds_emp under emp@foo e
        where lab(e) = 'edslab';")
   ) T)

 ((oid-p
   (osql "
create derived type eds_ee_emp under ee_emp@fie e
        where wplace(e) = 1;")
   ) T))

(checkequal
 "MDB test: Integration type definition"
 ((oid-p
   (osql "
create derived type int_emp
 key integer issn
 supertype of 
   eds_emp e = ssn(e),
   eds_ee_emp ee = id_to_ssn(id(ee))
 functions (issn integer, real_salary integer, real_name charstring)
   case e:
    real_salary = salary(e);
    real_name = name(e);
    issn = ssn(e);
   case ee:
    real_salary = pay(ee);
    real_name = name(ee);
    issn  = id_to_ssn(id(ee));
   case e, ee:
    real_salary = salary(e) + pay(ee);
    real_name = ee_emp_fie.name->charstring(ee);
    issn = ssn(e);
 end functions
 properties (bonus integer);"))
  T))


;Some performance testing examples
(defun dqns0 (fn) 
  (eval 
   (parse 
    (concat "create function " fn  "()-><charstring, integer> as
	           select nm, rs
		     from int_emp ie,charstring nm,integer rs
		     where real_name(ie)=nm and rs=real_salary(ie);"))))

(defun dqns1 (fn) 
  (let ((fnstring 
	 (concat "create function " fn
		 "(integer a)-><charstring nn, integer> as
	     		 select nm, rs
	     		 from int_emp ie,charstring nm,integer rs
	     		 where real_name(ie)=nm and rs=real_salary(ie) and
	           	 rs = a ;")))
    (eval (parse fnstring)))) 


;This flag on to skip the removal of multiple typechecks
;should not be used in the regression testing

;(defun op () (setq _skip_rmt_ (if _skip_rmt_ nil t)))

(defvar oqdns1) ; set below
(defvar oqdns0)

(checkequal
 "MDB test: compilation of queries over integration derived types (IT) 
  and late binding over DTs"

 ((oid-p
   (setq oqdns1 (dqns1 'optqns1))
   ) T)

;(op)
;(setq noqdns1 (dqns1 'noptqdns1))

;(op)

 ((oid-p
   (setq oqdns0 (dqns0 'optqns0))
   ) T)

;(op)
;(setq noqdns0 (dqns0 'noptqdns0))
;(op)
 )


(checkequal
 "MDB test: compilation of mdb functions taking parameters"

 ((oid-p
   (osql
    "create function gs(integer i)-> emp_foo e 
	as select e from emp_foo e where salary(e) = i;")

   ) T)

 ((oid-p

   (osql
    "create function fn1(charstring nm)->integer as
 select pay(ee)+salary(e) from emp@foo e, ee_emp@fie ee
 where nm=name(e) and id_to_ssn(id(ee))=ssn(e);")

   ) T))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;Execution part
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(formatl  t "MDB test: begining of the execution tests block" t)

;DIFFERENT QUERIES

(defun qb1 () (osql "select name(eeo) from only_eds_ee_emp eeo;"))
(defun qb2 () (osql "select name(eo) from only_eds_emp eo;"))
(defun qb3 () (osql "select real_name(je) from join_int_emp je;"))
(defun qb4 () (osql "select pay(je)  from join_int_emp je;"))
(defun qb5 () (osql "select ee from eds_ee_emp ee
	          where rkeyf_eds_emp(id_to_ssn(id(ee)));"))

(defun qm1 () (osql "select je from join_int_emp je;"))
(defun qm2 () (osql "select e  from only_eds_emp e;"))
(defun qm3 () (osql "select ee from only_eds_ee_emp ee;"))


(defun qs  ()  (osql "select real_salary(ie) from int_emp ie;"))
(defun qs1 ()  (osql "select rs  from int_emp ie, integer rs where 
	              rs=real_salary(ie) and rs> 40 and rs < 50;"))
(defun qs2 ()  (osql "select rs  from int_emp ie, integer rs where 
		      rs=real_salary(ie) and rs = 54;"))
(defun qn   () (osql "select real_name(ie) from int_emp ie;"))
(defun qn1  () (osql "select nm from int_emp ie,charstring nm
	              where nm='ee_emp30' and real_name(ie)=nm;"))
(defun qns  () (osql "
	              select nm, rs
		      from int_emp ie,charstring nm,integer rs
		      where real_name(ie)=nm and rs=real_salary(ie);")) 
(defun qns1 () (osql "
		      select nm, rs
		      from int_emp ie,charstring nm,integer rs
		      where real_name(ie)=nm and rs=real_salary(ie) and
		            rs < 20 ;")) 
(defun qns2 () (osql "
		      select nm, rs
		      from int_emp ie,charstring nm,integer rs
		      where real_name(ie)=nm and rs=real_salary(ie) and
		            rs = 16  ;")) 

;This has to be extended when fixed
(defun qi1 () (osql "select ie from int_emp ie;"))


