/*-*-sql-*-*******************************************************************/

create Location (id,country,continent) instances
 :swe (1,"Sweden","Europe"),
 :fra (2,"France","Europe"),
 :atl (3,"Atlantis","Pangea");

create Machine (id,name,manufacturer) instances
 :wb1 (1,"Water Boiler","Boils R Us"),
 :af1 (2,"Air Freshener","EasyBreathe Inc");

create MachineInstallation(id,locatedAt,locatedAtID,machineType,machineTypeID)
 instances
 :mi1 (1,:swe,1,:wb1,1),
 :mi2 (2,:swe,1,:wb1,1),
 :mi3 (3,:fra,2,:wb1,1),
 :mi4 (4,:atl,3,:af1,2);

create Sensor (id,name,manufacturer,version,hystereses,sensorprecision)
 instances
 :ws1 (1,"Water Sensor","AquaSens Technologies","1.1e",1.0,0.5),
 :ws2(2,"Water Sensor","AquaSens Technologies, Korea Division","0.2b",1.0,0.1),
 :as1 (3,"Air Sensor","Zephyr Ltd","1.0a",2.0,1.0);

create SensorInstallation (id,onMachine,onMachineID,sensorType,sensorTypeID,
                           serialNumber)
 instances
 :si1 (1,:mi1,1,:ws1,1,"WS1ABC"),
 :si2 (2,:mi2,2,:ws2,2,"WS2ABC"),
 :si3 (3,:mi3,3,:ws1,1,"WS3ABC"),
 :si4 (4,:mi4,4,:as1,3,"AS1ABC");
