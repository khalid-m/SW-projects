create logdirectory (name,folder,timeout,startseq) 
       instances ('d3',pwd()+'/realdata/',10,0);

create function q1a(Charstring dirname) -> Bag of Vector
  as select {timestamp(e), variable(e), value(e)}
  from Logevent e
  where e in simlogeventstream(dirnamed(dirname));

create function q2a(Charstring dirname, Charstring var)
                                      -> Bag of Vector of Number
  as select {timestamp(e), value(e)}
  from Logevent e
  where e in simlogeventstream(dirnamed(dirname))
  and variable(e) = var;

select distinct q1a('d3')[1];

plot(vectorof(q2a('d3', 'REG407')));