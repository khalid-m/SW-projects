loadsystem('../src/amosql','init.osql');
lisp;
(load-extension "svali" t)
:osql
loadsystem('../../validate/amosql','init.amosql');

load_lisp('copier.lsp');
load_lisp('sync.lsp');
< 'sync.osql';
lisp;
(clear-dir (dircsv (concat (getenv 'amos_home) "/logdir/hlund/testdata/")))
