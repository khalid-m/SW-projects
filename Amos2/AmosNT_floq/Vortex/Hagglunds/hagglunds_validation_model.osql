create function torque_measured(Record rec) -> (Number ts, Number torq)
  as select ts, (reg403 - reg407) * 100
  from Number reg403, Number reg407
  where ts = rec["ts"]
  and reg403 = rec["REG403"]
  and reg407 = rec["REG407"];

create function power_measured(Record rec) -> (Number ts, Number power)
  as select ts, torque *  reg109 / 9549
  from Number ts, Number reg109, Number torque
  where (ts, torque) in torque_measured(rec)
  and reg109 = rec["REG109"];

create function temperature_tank(Record rec) -> (Number ts, Number temp)
  as select rec["ts"], rec["REG410"];

create function pressure_AsidePump1(Record rec) -> (Number ts, Number pressure)
  as select rec["ts"], rec["REG403"];


/*------------------Predefined input parameters---------------------------*/

create function CoolingFlowTotal()->number as stored;
create function CoolingFlowTotal_1()->number as stored;
/* set Cooling Flow Total*/
set CoolingFlowTotal()= 25;
set CoolingFlowTotal_1()= 20;

/* Correktionsfactors for HDCA 100-4 cooler*/

create function A()->number as stored;
create function B()->number as stored;
create function C()->number as stored;
create function D()->number as stored;
create function E()->number as stored;
create function F()->number as stored;
create function G()->number as stored;
create function H()->number as stored;

set A() = 1.76E-07;   
set B() = -7.04015E-05;
set C() = 0.009182137;
set D() = 0.11471627;
set E() = 6.0538;
set F() = -1.7835;
set G() = 0.050979;
set H() = -5.7723;


create function AirF()->number as stored;
create function ALT()->number as stored;
create function OVC()->number as stored;
create function ALT1()->number as stored;

set AirF()= 1.5;      /*A constant for each cooler*/
set ALT()= 62;        /*Altitude above sealevel 62 m for HDAB*/
set OVC()= 0.996;     /*46 cst =Correktionsfactor for different types of oil*/
set ALT1() = 500;


/*-------- Calculation of REAL Specefic heat dissipation---------*/


create function CoolingDemand(number TempOilIn,number TempOilOut)-> number as
/* Calculation of HDTR(Coolingdemand) */
(TempOilIn - TempOilOut)*(CoolingFlowTotal_1() * 60 * 0.9 * 0.5 * 1.163 * 0.001);
/*model attribute temp for oil*/


create function SpecificHeatDissipation(Number TempOilIn, number TempOilOut,
					number CoolMediumTemp)->number as
/*Calculation of Speceific heat dissipation*/
CoolingDemand(TempOilIn,TempOilOut)/(TempOilIn - CoolMediumTemp);

/* for dir4 */
create function SHD_measured(Record rec) -> Number
  as select SpecificHeatDissipation(reg402, reg403, reg410)
  from Number reg402, Number reg403, Number reg410
  where reg402 = rec["REG402"]
  and reg403 = rec["REG403"]
  and reg410 = rec["REG410"];


/*-------- Calculation of Theroretical Specefic heat dissipation---------*/

create function HDV()-> number as
A() * (CoolingFlowTotal() ^ 3) + B() * (CoolingFlowTotal() ^ 2) 
+ C() * CoolingFlowTotal() + D();

create function AirDV()->number as
((-1.0416667E-18 * (ALT()^5))  + (1.2291667E-14 * (ALT()^4)) +
(-4.9375000E-11 * (ALT()^3)) + (8.5208333E-08 * (ALT()^2)) +
(-2.0708333E-04 * ALT()) +1.3);


create function AirD500()->number as
((-1.0416667E-18 * (ALT1()^5))  + (1.2291667E-14 * (ALT1()^4))  +
(-4.9375000E-11 * (ALT1()^3)) +(8.5208333E-08 * (ALT1()^2)) +
(-2.0708333E-04 * ALT1()) +1.3);


create function ATOV(number TempOilIn,number TempOilOut, number CoolMediumTemp)->number as
CoolMediumTemp+ (7.5 /(1.2* AirF())* (AirD500() / AirDV()));


create function SHD(number TempOilIn,number TempOilOut, number CoolMediumTemp)->number as
/*Theroretical SHD*/
HDV() * OVC() * (1.02-0.0015 * ATOV(TempOilIn,TempOilOut, CoolMediumTemp)) *
(1-0.00006875 * (ALT()-500));

create function SHD_expected(Record rec) -> Number
  as select SHD(reg402, reg403, reg410)
  from Number reg402, Number reg403, Number reg410
  where reg402 = rec["REG402"]
  and reg403 = rec["REG403"]
  and reg410 = rec["REG410"];

create function validate_SHD(Record rec, Number ref, Number threshold)
                                                         -> (Number ts, Number measured,
							     Number expected, Number diff)
  as select ts, measured, expected, diff
  where ts = rec["ts"]
  and measured = SHD_measured(rec)
  and expected = SHD_expected(rec)
  and diff = abs(measured - expected)
  and rec["DIN01"] = 1;

for each Number ts, Number measured, Number expected, Number diff
  where (ts, measured, expected, diff)
		in(model_n_validate(hagglunds_records(dirnamed("dir4")),
                    		    #'SHD_expected',
		    		    #'validate_SHD', 0.06))
  if diff > 0.06 then return (ts, measured, expected, diff);

