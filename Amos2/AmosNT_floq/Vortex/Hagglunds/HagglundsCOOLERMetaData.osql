create logdirectory (name,folder,timeout,startseq)
       instances ('COOLERDir', '../Hagglunds/data/COOLER/',2,0);
set variables(dirnamed("COOLERDir")) =
  {"REG402","REG403", "REG408", "REG410", "DIN01"};

/* hagglunds stream has a name and logdirectory */
create HagglundsStream (hlundid, logdirname)
       instances ('hsCOOLER', 'COOLERDir');


/* set the threshold of the T2 statistics
   for Hagglunds Stream named 'hsCOOLER'  */
set_th("hsCOOLER", 1000);

set_oilTempOutWarningLimit("hsCOOLER", 17.5);

set_oilTempOutAlarmLimit("hsCOOLER", 15);