load_lisp("multi_variable.lsp");

<'hagglunds_schema.osql';

create logdirectory (name,folder,timeout,startseq)
       instances ('dir1',pwd()+'/data/realdata/',10,0);

set variables(dirnamed("dir1")) = 
{"DATALOSS","EMOTOR2","EMOTOR3","DOUT01","DOUT02",
  "REG103","REG109","REG311","REG401","REG402",
  "REG403","REG404","REG405","REG406","REG407",
  "REG408","REG409","REG410","W1_019"};

create logdirectory (name,folder,timeout,startseq)
       instances ('dir2',pwd()+'/data/E01PB303190/',10,0);

set variables(dirnamed("dir2")) =
{"DATALOSS","EMOTOR2","EMOTOR3","DOUT01","DOUT02",
  "REG103","REG109","REG311","REG401","REG402",
  "REG403","REG404","REG405","REG406","REG407",
  "REG408","REG409","REG410","W1_019"};

create logdirectory (name,folder,timeout,startseq)
       instances ('dir3',pwd()+'/data/E01PS10-2991/',10,0);

set variables(dirnamed("dir3")) =
{"DOUT01","DOUT02","REG103","REG109","REG311",
  "REG401","REG402","REG403","REG404","REG405",
  "REG406","REG407","REG408","REG409","REG410","W1_019"};

create logdirectory (name,folder,timeout,startseq)
       instances ('dir4',pwd()+'/data/cooler/',10,0);

set variables(dirnamed("dir4")) =
{"DOUT01","DOUT02","REG103","REG109","REG311",
  "REG401","REG402","REG403","REG404","REG405",
  "REG406","REG407","REG408","REG409","REG410","W1_019", "DIN01"};

