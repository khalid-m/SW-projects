load_lisp('../../logdir/src/lisp/logdir.lsp');

<'../../logdir/src/amosql/logdir.osql';

<'../../logdir/hlund/hlund.osql';


load_lisp('../../logdir/hlund/hlund.lsp');

load_lisp('../../logdir/hlund/dgen.lsp');

create function variables(Logdirectory dir) -> Vector of Charstring
as stored;

create function hagglunds_stream(Logdirectory dir) -> Stream of Vector
as streamof(select {timestamp(e), variable(e), value(e)}
   from Logevent e where e in simlogeventstream(dir));

create function hagglunds_tuples0(Stream s, Vector of Charstring variables)
                                                                -> Bag of Vector
as foreign 'hagglunds-vtuples--+';

create function hagglunds_tuples(Logdirectory dir) -> Stream of Vector
       as streamof(hagglunds_tuples0(hagglunds_stream(dir), variables(dir)));


create function hagglunds_records0(Stream s, Vector of Charstring variables)
                                                                -> Bag of Record
as foreign 'hagglunds-rtuples--+';

create function hagglunds_records(Logdirectory dir) -> Stream of Record
       as streamof(hagglunds_records0(hagglunds_stream(dir), variables(dir)));