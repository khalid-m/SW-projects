 * Hagglunds Log Wrapper
 *
 ****************************************************************************/

create type HagglundsStream under RawDataStream
   properties (hlundid Charstring key,
	       logdirname Charstring);

create function variables(Logdirectory dir) -> Vector of Charstring
  as stored;

/* the hagglunds stream */
create function theHagglundsStream(Charstring hlundid) -> HagglundsStream
  as select s from HagglundsStream s where hlundid(s) = hlundid;

create function hagglundsRawRecords(Charstring hlundid) -> Stream of Record
  as streamof(select project_record(r, concat({"TS"}, variables))
     	      from Logdirectory dir, Vector of Charstring variables, Record r
     	      where dir = dirnamed(logdirname(theHagglundsStream(hlundid)))
     	      and variables = variables(dir)
     	      and r in filter_record_agg(simlogeventstream(dir), variables));