 * Revision 1.3  2013/10/20 18:42:08  chexu484
 * moving average included
 * To be refined:
 * 1. how to choose appropriate size of the moving window
 * 2. how to choose appropriate size of the training data
 *
 * Revision 1.2  2013/09/27 12:14:47  chexu484
 * *** empty log message ***
 *
 * Revision 1.1  2013/09/27 12:11:56  chexu484
 * demo of learn_n_validate
 * scenario: hagglunds cooler
 *
 ****************************************************************************/

svali

< '../schema/SmartVortexSchema.osql'; /* The generic Smart Vortex schema 
                                         based on D3.1 */

< 'HagglundsLogWrapper.osql';

< 'HagglundsCOOLERWrapper.osql'; /* The general Hagglunds stream wrapper that handles
                              streams that logged in logdirectory from Hagglund */

< 'HagglundsCOOLERModel.osql'; /* The Specefic Statistical Model from Hagglunds */

< 'HagglundsCOOLERValidator.osql'; /* validate the stream based on the statistics */

< 'HagglundsCOOLERMetaData.osql'; /* Populate the Smart Vortex database with hagglunds metadata */


/* the hagglunds stream of records */
set :s = hagglundsRecords("hsCOOLER");

/* firt 10 record in the stream */
in(first_N(:s, 10));


bsection(playback2(cloogedCoolerWarning("hsCOOLER")), 0, 50);


bsection(playback2(cloogedCoolerAlarm("hsCOOLER")), 0, 50);


bsection(playback2(validateHagglundsCooler("hsCOOLER")), 0, 50);


bsection(playback2(validateHagglundsCoolerMA("hsCOOLER")), 0, 50);



/* a CQ that take the first 2000 record as training data 
   learn the statistics and then use the statistics as a
   reference to validate the coming records. The result
   of the query is:
   (timsStamp, measuredStatistics, learntExpectedStatistics) *
playback(first_N(learn_n_validate(:s, #'buildStats', 2000, #'validateCOOLER'), 20));


set :mas = movingAverage(:s, 15, 0.1);

* firt 10 record in the averaged stream *
in(first_N(:mas, 10));

* similar as above, but the validation is done over the averaged stream *
playback(first_N(learn_n_validate(:mas, #'buildStats', 2000, #'validateCOOLER'), 10));


writecsvfile("onebyone.csv", in(learn_n_validate(:s, #'buildStats', 2000, #'validateCOOLER')));

writecsvfile("mvaverage.csv", in(learn_n_validate(:mas, #'buildStats', 2000, #'validateCOOLER')));

set :raw = hagglundsRawRecords("hsCOOLER");

in(first_N(:raw, 10));

bsection(in(:s), 1999, 2000);  |2012-06-14/07:53:38|

bsection(in(:s), 2999, 3000);  |2012-06-14/07:55:47|

bsection(in(:s), 3999, 4000);  |2012-06-14/08:17:09|

bsection(in(:s), 5999, 6000);  |2012-06-14/08:21:46|
*/