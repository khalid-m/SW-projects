create logdirectory (name,folder,timeout,startseq)
       instances ('dir',pwd()+'/../Hagglunds/data/COOLER/',10,0);
set variables(dirnamed("dir")) =
  {"DOUT01","DOUT02","REG103","REG109","REG311",
  "REG401","REG402","REG403","REG404","REG405",
  "REG406","REG407","REG408","REG409","REG410","W1_019", "DIN01"};

/* define sampled E01PB30 hagglunds stream */
create HagglundsStream (hlundid, logdirname)
       instances ('hs', 'dir');

set th(theHagglundsStream("hs")) = 0.06;

create logdirectory (name,folder,timeout,startseq)
       instances ('dir1',pwd()+'/data/E01PB30-3190/',10,0);
set variables(dirnamed("dir1")) =
  {"DATALOSS","EMOTOR2","EMOTOR3","DOUT01","DOUT02",
  "REG103","REG109","REG311","REG401","REG402",
  "REG403","REG404","REG405","REG406","REG407",
  "REG408","REG409","REG410","W1_019"};

/* define sampled E01PB30 hagglunds stream */
create HagglundsStream (hlundid, logdirname)
       instances ('hs1', 'dir1');

