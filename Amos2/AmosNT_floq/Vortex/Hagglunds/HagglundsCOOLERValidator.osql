create function validateCOOLER(Record r, Number t2) -> (Number ts, Number measuredT)
  as select hsTS(r), measuredT
     where measuredT = measuredT2({hsREG410(r), hsREG402(r), hsREG403(r)})
     and abs(measuredT - t2) > get_th("hsCOOLER");

create function validateHagglundsCooler(Charstring hid, Integer nSample) -> Stream of (Number, Number, Number)
  as streamof(select ts, m, e
     	      from Number ts, Number m, Number e
              where {ts, m, e} in learn_n_validate(hagglundsRecords(hid),
						   #'buildStats', nSample, #'validateCOOLER'));

create function validateHagglundsCoolerMA(Charstring hid, Number windowSize, Number windowSlide, Integer nSample)
									-> Stream of (Number, Number, Number)
  as streamof(select ts, m, e
     	      from Number ts, Number m, Number e
              where {ts, m, e} in learn_n_validate(movingAverage(hagglundsRecords(hid), windowSize, windowSlide),
						   #'buildStats', nSample, #'validateCOOLER'));

/* the following is to validate the oil temperature */


/* Conveniance functions */

create function cloogedCoolerWarning0(Charstring hid) -> Bag of (Number, Number)
  as for each Record r, Number ts, Number oilTemp
	where r in hagglundsRecords(hid) and ts = r["TS"] and oilTemp = oilTempOut(r)
	if oilTemp > get_oilTempOutWarningLimit(hid) then return (ts, oilTemp);

create function cloogedCoolerAlarm0(Charstring hid) -> Bag of (Number, Number)
  as for each Record r, Number ts, Number oilTemp
	where r in hagglundsRecords(hid) and ts = r["TS"] and oilTemp = oilTempOut(r)
	if oilTemp > get_oilTempOutAlarmLimit(hid) then return (ts, oilTemp);

create function cloogedCoolerWarning(Charstring hid) -> Stream of (Number, Number)
  as streamof(cloogedCoolerWarning0(hid));

create function cloogedCoolerAlarm(Charstring hid) -> Stream of (Number, Number)
  as streamof(cloogedCoolerAlarm0(hid));

create function validateHagglundsCooler(Charstring hid) -> Stream of (Number, Number, Number)
  as validateHagglundsCooler(hid, 2000);

create function validateHagglundsCoolerMA(Charstring hid) -> Stream of (Number, Number, Number)
  as validateHagglundsCoolerMA(hid, 15, 0.1, 2000);