svali

< '../schema/SmartVortexSchema.osql'; /* The generic Smart Vortex schema 
                                         based on D3.1 */

< 'HagglundsWrapper.osql'; /* The general Hagglunds stream wrapper that handles
                              streams that logged in logdirectory from Hagglund */

< 'HagglundsSHDModel.osql'; /* The Specefic Heat Dissipation Model from Hagglunds */

< 'HagglundsSHDValidator.osql'; /* validate Specefic Heat Dissipation using 
                                   model and validate */

< 'HagglundsMetaData.osql'; /* Populate the Smart Vortex database with hagglunds metadata */


playback(validateHagglundsSHD("hs"));