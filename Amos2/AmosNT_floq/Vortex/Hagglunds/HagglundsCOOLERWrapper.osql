create function hsTS(Record r) -> Number
  as r["TS"];

/* a set of access functions */
/* note: the access functions can actually generated automatically */

create function hsDIN01(Record r) -> Number
  as r["DIN01"];

create function hsREG402(Record r) -> Number
  as r["REG402"];

create function hsREG403(Record r) -> Number
  as r["REG403"];

create function hsREG408(Record r) -> Number
  as r["REG408"];

create function hsREG410(Record r) -> Number
  as r["REG410"];

create function hagglundsRecords(Charstring hlundid) -> Stream of Record
  as streamof(select project_record(r, concat({"TS"}, variables))
     	      from Logdirectory dir, Vector of Charstring variables, Record r
     	      where dir = dirnamed(logdirname(theHagglundsStream(hlundid)))
     	      and variables = variables(dir)
     	      and r in filter_record_agg(simlogeventstream(dir), variables)
     	      and hsDIN01(r) = 1 and hsREG408(r) > 15);