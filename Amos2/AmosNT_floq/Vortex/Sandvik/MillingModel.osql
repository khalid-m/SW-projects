create function hm(Record r) -> Number
  as (2 * pi() * sin(90 * pi() / 180) 
     * ae(r) * fz(r))
     / (pi() * cuttingDiameter(r) 
        * acos(1 - 2 * ae(r)/cuttingDiameter(r)));

create function kc(Record r) -> Number
  as 1950*power(hm(r), -0.25) * (1-2.5/100);

create function expected_power(Record r) -> Number p
  as  (cuttingDepth(r) * ae(r) * fz(r) * vc(r) * zt(r) * kc(r))
      /(pi() * cuttingDiameter(r) * 60000);

create function millPower_b(MillStream cs) -> Bag of (Number, Number)
  /* A CQ returns a bag of (ts, power) */
  as select timestampMill(r), powerConsumption(r)
     from Record r
     where r in rawStreamTuples(cs);

create function millPower(MillStream cs) -> Stream of (Number, Number)
  /* A CQ returns a stream of (ts, power) */
  as streamof(millPower_b(cs));

/*** Conveniance functions ***/

create function millPower(Charstring coreid) -> Stream of (Number, Number)
  as millPower(theMillStream(coreid));

create function expectedPower_b(MillStream cs) -> Bag of (Number, Number)
  /* A CQ returns a bag of (ts, power) */
  as select timestampMill(r), expected_power(r)
     from Record r
     where r in rawStreamTuples(cs);

create function expectedPower(MillStream cs) -> Stream of (Number, Number)
  /* A CQ returns a stream of (ts, power) */
  as streamof(expectedPower_b(cs));

/*** Conveniance functions ***/

create function expectedPower(Charstring coreid) -> Stream of (Number, Number)
  as millPower(theMillStream(coreid));