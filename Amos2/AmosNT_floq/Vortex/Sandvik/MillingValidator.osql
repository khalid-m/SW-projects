create function validate_power(Record r, Number ref) 
                        -> (Number ts, Number measured)
  as select ts, measured
     where measured = powerConsumption(r) and
           ts = timestampMill(r) and
	   abs(measured - ref) > th("A");

create function validateMill_b(MillStream cs)
                             -> Bag of (Number ts, Number measured, Number expected)
  as select ts, measured, expected
     where {ts, measured, expected} in
	model_n_validate(rawStreamTuples(cs), #'expected_power', #'validate_power');

create function validateMill(MillStream cs) -> Stream of (Number, Number, Number)
  as streamof(validateMill_b(cs));

create function sandvikMillAlertMsg(Vector invalidTuple, CorenetStream s)
                       -> (Number ts, Charstring msg)
  as select ts, alertString(s) + ". Threshold: " + th(s) +
	        ". Measured: " + measured + ". Expected: "+ expected
     from Number ts, Number measured, Number expected
     where {ts, measured, expected} = invalidTuple;

create function millAlerts_b(MillStream cs) -> Bag of (Number ts, Charstring msg)
  as select alertMsg(validationStream, #'sandvikMillAlertMsg', {cs})
     from Stream validationStream
     where validationStream = model_n_validate(rawStreamTuples(cs), #'expected_power', #'validate_power');

create function millAlerts(MillStream cs) -> Stream of (Number, Charstring)
  as streamof(millAlerts_b(cs));

/*** Conveniance functions ***/

create function validateMill(Charstring coreid) -> Stream of (Number, Number, Number)
  as validateMill(theMillStream(coreid));

create function millAlerts(Charstring coreid) -> Stream of (Number, Charstring)
  as millAlerts(theMillStream(coreid));