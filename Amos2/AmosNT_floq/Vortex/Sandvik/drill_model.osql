create function Vector2Jason(Record r, Vector of Charstring keys) -> Vector
  as vselect r[in(keys)];

create function corenet_jason2vector(Record corenet) -> Vector
as vselect unstringify(s)
from Vector of Record vr, Record r, Charstring s
where vr = corenet["data"]
and r in vr and s = vector2jason(r, {"value"})[0];

create function corenet_jason2vector_stream(Stream of Record sr) -> Stream of Vector
as streamof(corenet_jason2vector(in(sr)));

/* two access functions */
create function drill_time(Vector of Number v) -> Number as v[3];
create function drill_power(Vector of Number v) -> Number as v[4];

/* extract power vector for one complete drill */
create function power_vector(Window w) -> Vector of Number
as vselect v[4] from Vector of Number v where v in w;

/* start and stop predicate for drill */
/* 0:counter 1:id, 2:flag, 3:time, 4:power */
create function drill_start(Vector v) -> Boolean
  as select v[2] = 1;
create function drill_stop(Vector s, Vector v) -> Boolean
  as select v[2] = 0 and s[2] = 1;

create function learn_drill(Vector of Window sample) -> Vector of Number
  /* the first cycle might be incomplete depending on when the
     FDMS is hooked up to the corenet server */
  as select sumvectors(fv) / vcount
  from Bag of Vector of Number fv, Integer vcount
  where fv = (select power_vector(sample[i])
              from Integer i
              where i in iota(1, vcount - 1))
  and vcount = dim(sample);

create function validate_one_drill(Window this, Vector of Number refv)
				   -> (Number, Window, Vector, Number)
  /* the function to validate cycle based on the sampled power vector */
  as select rnow(), this, refv, d
  from Number d, Vector of Number thisv
  where d = euclid(refv, thisv)
  and thisv = power_vector(this);

create function corenet_drill_stream(Integer port) -> Stream of Vector
  /* Stream wrapper interface for drilling */
  as corenet_jason2vector_stream(
    	   json_stream_wrapper("python corenet_streamer.py", 
                               "localhost", port));

create function corenet_validate_drill_b(Integer port) 
                                       -> Bag of (Number, Window, Vector, 
                                                  Number)
  /* Learn-and-validate model for drilling */
  as for each Number ts, Window measured, Vector of Number expected, Number diff
     where (ts, measured, expected, diff) in
       learn_n_validate(pwindowize(corenet_drill_stream(port), #'drill_start',
                        #'drill_stop'),
       			2, #'learn_drill', #'validate_one_drill', 0)
       if diff > th("drill") then return (ts, measured, expected, 1)
       else return (ts, measured, expected, 0);

create function is_drilling_b(Charstring src) -> Bag of (Number, Number)
  as for each Number identifier, Number id, Number flag, Number time, Number value
    where {identifier, id, flag, time, value} in corenet_drill_stream(port(src))
    if flag = 1 then return (time, value);

create function is_drilling(Charstring src) -> Stream of (Number, Number)
  /* A CQ returns (ts, power) when the drill is drilling */
  as streamof(is_drilling_b(src));

create function validate_drill_b(Charstring src) -> Bag of (Number, Number)
  as for each Number ts, Window measured, Vector of Number expected, Number invalid
    where (ts, measured, expected, invalid) in corenet_validate_drill_b(port(src))
      if invalid = 1
      then for each Vector of Number v where v in measured
           return (drill_time(v), drill_power(v));

create function validate_drill(Charstring src) -> Stream of (Number, Number)
  /* A CQ returns (ts, power) within a invalid drill cycle */
  as streamof(validate_drill_b(src));

create function drill_alert_b0(Charstring src) -> Bag of Number
  as for each Number ts, Window measured, Vector of Number expected, Number invalid
    where (ts, measured, expected, invalid) in corenet_validate_drill_b(port(src))
   return invalid;

create function drill_alert_b(Charstring src) -> Bag of Charstring
  as for each Number x where x in changed0(drill_alert_b0(src))
     if x > 0 then return alertmsg(src, th("drill"))
     else return "";

create function drill_alert(Charstring src) -> Stream of Charstring
  /* drill alert stream */
  as streamof(drill_alert_b(src));


create function drill_difference(Integer port) -> Bag of (Number, Number)
  as for each Number ts, Window measured, Vector of Number expected, Number diff
     where (ts, measured, expected, diff) in
       learn_n_validate(pwindowize(corenet_drill_stream(port), #'drill_start',
                                   #'drill_stop'),
       			4, #'learn_drill', #'validate_one_drill', 0)
     if 1 then return (ts, diff);