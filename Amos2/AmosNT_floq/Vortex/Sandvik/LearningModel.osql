/*** The model starts here ***/

create function touchingPower(OtherStream s) -> Stream of (Number, Number)
  as streamof(select timestampOther(r), power
              from Record r, Number power
              where r in rawStreamTuples(s)
		and power = powerConsumptionOther(r) 
                and flag(r) = 1 and power > 0);

/*** Conveniance functions ***/
create function touchingPower(Charstring coreid) -> Stream of (Number, Number)
  as touchingPower(theOtherStream(coreid));