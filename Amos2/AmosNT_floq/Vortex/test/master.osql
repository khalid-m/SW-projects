set :s1 = my_csv_stream("../extensions/humbledata.csv"); 

set :s2 = section(numtuples(0.001),0,100);

lisp;

(checkequal
 "extensions"
 ((osql "round(sum(vsum(na2vec(in(:s1)))));") '((214778)))
 ((osql "count(in(:s2));") '((100)))
 )

:osql

rollback;