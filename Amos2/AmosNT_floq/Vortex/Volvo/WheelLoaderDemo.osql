< '../schema/SmartVortexSchema.osql'; /* The generic Smart Vortex schema 
                                         based on D3.1 */

/* simulated canbus stream, i.e. streaming from csv file */
< 'CanBusWrapper.osql';

/* the wheel loader wrapper: */
< 'WheelLoaderWrapper.osql';

/* the wheel loader model: */
< 'WheelLoaderModel.osql';

/* the wheel loader validator */
< 'WheelLoaderValidator.osql';

/* the volvo meta data */
< 'VolvoMetaData.osql';

in(validateRecordedWheelLoader("volvo"));

create function windowKurtosis(Charstring cid) -> Stream of Vector of Number
  as streamof(select windowKurtosis(w, signals(cs))
     	      from CanBusStream cs, Window w
     	      where cs = theCanBusStream(cid) and
	      w in partwindowize(simCanBusStream(cs), #'partitionBy'));

in(windowKurtosis("volvo"));

create function invalidIndxw(Window part, Vector of Charstring signals) -> Bag of Integer
  as for each Integer i, Vector of Number wkurtosis
	where i in iota(0, dim(wkurtosis) - 1) and
              wkurtosis = windowKurtosis(part, signals)
	if wkurtosis[i] > maxAllowedKurtosis(signals[i]) then return i;

create function invalidIndx(Charstring cid) -> Bag of Integer
  as select invalidIndxw(w, signals(cs))
     from CanBusStream cs, Window w
     where cs = theCanBusStream(cid) and
     w in partwindowize(simCanBusStream(cs), #'partitionBy');

invalidIndx("volvo");


set :s = simCanBusStream(theCanBusStream("volvo"));

set :sw = partwindowize(:s, #'partitionBy');

select invalidSignal(w, signals()) from window w where w in :sw;


