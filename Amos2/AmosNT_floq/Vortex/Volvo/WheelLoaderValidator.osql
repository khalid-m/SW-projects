create function validateWheelLoader(Charstring cid) -> Stream of (Number, Charstring, Number)
  as streamof(select invalidSignal(w, signals(cs))
     	      from CanBusStream cs, Window w
     	      where cs = theCanBusStream(cid) and
              w in partwindowize(canBusStream(cs), #'partitionBy'));

create function validateRecordedWheelLoader(Charstring cid) -> Stream of (Number, Charstring, Number)
  as streamof(select invalidSignal(w, signals(cs))
     	      from CanBusStream cs, Window w
     	      where cs = theCanBusStream(cid) and
	      w in partwindowize(simCanBusStream(cs), #'partitionBy'));