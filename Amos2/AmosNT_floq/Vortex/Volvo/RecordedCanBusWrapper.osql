create function canBusStream(Charstring settings) 
                           -> Stream of Vector of Number
  as streamof(cast(csv_file_stream("data/CanBus_Recorded.csv") as Bag of Vector of Number));

create function simCanBusStream(Charstring file)
                           -> Stream of Vector of Number
  as streamof(cast(csv_file_stream(file) as Bag of Vector of Number));


