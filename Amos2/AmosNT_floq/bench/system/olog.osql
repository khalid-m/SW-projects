 * Benchamarked UPPMAX tintin
 *
 * Revision 1.3  2014/01/09 15:49:11  torer
 * The fastest PC is MAC BOOTCAMP!!
 * MS VS 6.0 excellent compiler.
 * OSX CC no good.
 *
 * Revision 1.2  2014/01/09 15:29:55  torer
 * Updated ObjectLog benchmark figures for Macbook MS VS 6.0 compiler
 *
 * Revision 1.1  2013/03/17 09:42:05  torer
 * Micro-benchmarks
 *
 ****************************************************************************/

create function q1()->Number as count(iota(1,10000000));

create function q2()->Number as count(iota(1,10000000)+2*3);

lisp;

(defglobal _q1_ (theresolvent 'q1))

(defglobal _q2_ (theresolvent 'q2))

(rptq 10 (mapfunction-apply _q1_ nil 'null))
;; Macbook, OSX, CC v 4.2, Intel i7, 2.6 GHz: 60.4s
;; Macbook, Windows, VS6.0, Intel i7, 2.6 GHz: 4.55s, 13 times faster!
;; HP desktop PC, Windows, VS6.0, Intel i7, 2.93GHz, VS 6.0: 7.51 s
;; UPPMAX tintin, Linux, GCC, AMD 6220, 3GHz: 7.38s

(rptq 10 (mapfunction-apply _q2_ nil 'null))
;; Macbook, OSC, CC v 4.2, Intel i7, 2.6 GHz: 77.7s
;; Macbook, Wimdows32, VS6.0, Intel i7, 2.6 GHz: 14.53s, 5 times faster
;; HP desktop PC, Windows, VS 6.0, Intel i7, 2.93GHz: 21.38 s
;; UPPMAX tintin, Linux, GCC, AMD 6220, 3GHz: 27.74 s
:osql

rollback;
