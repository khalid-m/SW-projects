/* Testing of winpred */

lisp;

(checkequal "basic winpred invocation"
 ((osql "
winpred(siota(1,4),#'INTEGER.ODD->BOOLEAN');
") '((#(1)) (#(3)))))

(checkequal "winpred with empty stream"
 ((osql "
winpred(siota(1,0),#'INTEGER.ODD->BOOLEAN');
") nil ))

(checkequal "winpred boundary condition"
 ((osql "
winpred(streamof(in({1,2,2,3,1,1})),#'INTEGER.ODD->BOOLEAN');
") '((#(1)) (#(3 1 1))) ))

(checkequal "winpred boundary condition (2)"
 ((osql "
winpred(streamof(in({2,2,2,2,2,1})),#'INTEGER.ODD->BOOLEAN');
") '((#(1))) ))

(checkequal "winpred completeness (1)"
 ((osql "
select n1 + n2
from integer n1, integer n2, vector of real rv
where n1 = (sum(dim(winpred(streamof(in(rv)), #'gt0'))))
  and n2 = (sum(dim(winpred(streamof(in(rv)), #'le0'))))
  and rv = vectorof(nrands(1000));
") '((1000)) ))

(checkequal "winpred completeness (2)"
 ((osql "
select n1 + n2
from integer n1, integer n2, vector of integer rv 
where n1 = (sum(dim(winpred(streamof(in(rv)), #'INTEGER.ODD->BOOLEAN'))))
  and n2 = (sum(dim(winpred(streamof(in(rv)), #'INTEGER.EVEN->BOOLEAN'))))
  and rv = vectorof(integer(abs(nrands(1000)*100)));
") '((1000)) ))

(checkequal "swinpred"
 ((osql "
select n1 + n2
from integer n1, integer n2, vector of integer rv 
where n1 = (sum(dim(in(swinpred(streamof(in(rv)), #'INTEGER.ODD->BOOLEAN')))))
  and n2 = (sum(dim(in(swinpred(streamof(in(rv)), #'INTEGER.EVEN->BOOLEAN')))))
  and rv = vectorof(integer(abs(nrands(1000)*100)));
") '((1000)) ))

:osql

/* Checking stream constructors */

lisp;

(checkequal "length of stream generated by int0s"
 ((osql "
count(in(int0s(10)));
") '((10)) ))

(checkequal "length of stream generated by real0s"
 ((osql "
count(in(real0s(10)));
") '((10)) ))

(checkequal "length of stream generated by int1s"
 ((osql "
count(in(int1s(10)));
") '((10)) ))

(checkequal "length of stream generated by real0s"
 ((osql "
count(in(real1s(10)));
") '((10)) ))

(checkequal "length of stream generated by srep"
 ((osql "
count(in(srep(siota(1,4), 3)));
") '((12)) ))

(checkequal "stream generated by srep (1)"
 ((osql "
in(srep(streamof({1, 2}), 3));
") '(((#(1 2))) ((#(1 2))) ((#(1 2)))) ))

(checkequal "stream generated by srep (2)"
 ((osql "
in(srep(streamof(select 1, 2), 3));
") '(((1 2)) ((1 2)) ((1 2))) ))

