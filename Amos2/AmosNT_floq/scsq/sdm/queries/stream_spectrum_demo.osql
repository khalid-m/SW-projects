/* Query to monitor the spectrum of a random stream */
(in(smonitor(srfft(nrrandstream(10*1024), 1024, 64), 3)));

/* Query to monitor the spectrum of a number stream 
   in a given column of a file (Number is cast as Real) */ 
select in(smonitor(ss, 0))
from Stream of Vector of Number ss, Stream of Number s
where ss = srfft(s, 1024, 64)
  and s = streamColFromFile("C:/data/iStreams/HPMN4.out", 6); 

/* Query to monitor the spectrum of a number stream 
   in a given column of a file (Number is cast as Real) */ 
select alert
from Vector of Vector of Number alert, 
     Stream of Vector of Number ss, 
     Stream of Number s
where alert = in(sspectrummonitor(s, 1024, 64, 3))
  and s = streamColFromFile("C:/data/iStreams/HPMN4.out", 6);

 