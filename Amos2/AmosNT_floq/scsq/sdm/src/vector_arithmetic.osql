/* Vector Element-wise Arithmetic */

create function plus(Vector of Number v1, Number n)
                     -> Vector of Number 
/* Vector-Scalar Plus */
  as vselect v1[i]+n from integer i;

create function minus(Vector of Number v1, Number n)
                     -> Vector of Number 
/* Vector-Scalar Minus */
  as vselect v1[i]-n from integer i;

/* TO DO: Missing correct shorthand for arithmetic operators. 
   It should be something like .* to differenciate the element-wise
   multiplication opetaror from the dot or outer product operators.
   Also missing vector element-wise .^ and regular ^ exponentiation 
   and element-wise function application, i.e if fn(Number)->Number
   is defined then if not otherwised defined fn(Vector of Number v) 
   should automatically denote the application of fn to all elements
   of v. */

create function vapply(Function f, Vector v)-> Vector
/* Function that applies function f on every element of v */
  as vselect in(apply(f, {v[i]})) from integer i;

create function colv(Vector of Vector vv, Integer i)
                     -> Vector
/* Fn that returns a specified column of a matrix 
   which is represented as a Vector of Vector */ 
  as vselect vv[j][i] from Integer j;  

create function vvavgstdev(Vector of Vector of Number vv)
                           -> Vector of Vector of Number
/* Fn to calculate the columns-wise mean and standard deviation
   of a matrix which is represeted as a Vector of Vector */
  as vselect col_stat
     from Vector of Number col_stat, Integer i
     where col_stat = {vavgstdev(colv(vv, i))}
       and i in iota(0,dim(vv[0])-1);