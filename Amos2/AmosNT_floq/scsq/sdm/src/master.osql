set dumpfile() = "sdm.dmp";
load_lisp('random.lsp');
load_amosql('utility.osql');
load_lisp('math.lsp');
load_amosql('vector_arithmetic.osql');
load_lisp('winpred.lsp');
load_lisp('stream_constructor.lsp');
load_lisp('stream_filter.lsp');
load_lisp('stream_apply.lsp');
load_lisp('stream_subind.lsp');
load_amosql('NNet.osql');
load_lisp('NNet.lsp');
load_lisp('stream_transducer_initfn.lsp');
load_amosql('stream_aggregators_initfn.osql');
load_lisp('stream_transducer.lsp');
load_lisp('stream_transducer_exitfn.lsp');
load_lisp('stream_transducer_silent.lsp');
load_amosql('stream_aggregators.osql');
load_amosql('stream_spectrum.osql');
load_lisp('streams.lsp');
load_amosql('NoveltyDetectNN.osql');

lisp;
(setq _system-watermark_ _oidno_)
:osql
