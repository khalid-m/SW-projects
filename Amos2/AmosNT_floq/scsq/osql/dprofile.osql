lisp;
(defun rgen-+ (fno r res) 
  (let ((ret 
    (with-textstream s 
      (print (record-get r "generator") s) 
      (textstreamstring s))))
    (osql-result r ret)))
:osql

create function rgenerator(record r)->charstring as foreign 'rgen-+';

create function dprofile(charstring sp)->bag of record
as select r
from charstring c, record r
where <c, r> in dprofile()
and c = sp;

create function profiles()-><charstring, record>
as select c, p
from charstring c, record r, record p
where <c, r> in dprofile()
and p = r['profile'];

create function cpureport() -> <charstring, real, charstring, integer> as
select c, roundto(pt, 2), r['generator'], r['nsub']
from charstring c, record r, real pt
where <c, r> in dprofile()
and pt = r['proctime'];

create function cpureport(charstring c, record r)
-> <charstring, real, charstring, integer> as
select c, roundto(pt, 2), r['generator'], r['nsub']
from real pt
where pt = r['proctime'];

create function dcpu(charstring c, record r) -> <real, charstring, integer> as
select roundto(pt, 2), c, r['nsub']
from real pt
where pt = r['proctime'];

create function splitcpu() -> <charstring, real, integer> as
select c, roundto(pt, 2), r['nsub']
from charstring c, record r, real pt
where <c, r> in dprofile()
and (some(r['sfn']) or some(r['rfn']))
and pt = r['mappertime'];

create function psum(bag of <charstring, real, integer> data) -> real
as sum(select time
from charstring c, real time, integer nsub 
where <c, time, nsub> in data);

create function profiles(charstring c, record r)-><charstring, number, record>
as select c, cpu, p
from record p, number cpu
where p = r['profile']
and cpu = r['mappertime'];

create function flushes(charstring c, record r)->
<charstring, number, number, number>
as select c, forcedf, proactivef, interf
from number forcedf, number proactivef, number interf
where forcedf = r['forced flush']
and proactivef = r['proactive flush']
and interf = r['interrupt-flush'];
