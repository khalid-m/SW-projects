/* Everything loaded before this belongs to the basic SCSQ system,
   and is contained within the watermark. */

lisp;
(setq _system-watermark_ _oidno_)
(setq _scsq-watermark_ _oidno_)
:osql

load_lisp("../lsp/cumsum.lsp");

< 'spconfig.osql';
< 'istream.osql';

create function vdiff(vector x,vector y)->vector of object as select 
vectorof(select e from object e
where e in x and notany (e in y));

create function vunion(vector x,vector y)->vector as 
select vectorof(select distinct e from object e where e in x or e in y);

create function initge(charstring dmp) -> Vector
as begin
  set prepcoordhost() = gethostname();
  set prephosts() = vectorof(distgenodes());
/*  set cpus_per_host() = integer(count(genodes())/count(distgenodes()));*/
  set cpus_per_host() = 1;
  daemon_mode(1);
  select scsqged(s, dmp)
    from charstring s
    where s in uniqueprephosts()
    and s != gethostname();
end;

create function initsl(charstring dmp) -> Vector
as begin
  set prepcoordhost() = gethostname();
  set prephosts() = vectorof(distslnodes());
  sp_stdout(getenv("TMPDIR") + "/SPlog");
/*  sp_stdout(getenv("HOME") + "/splogs/SPlog"); */
  /* Many NFS handles writing to HOME */
  set cpus_per_host() = 1;
  daemon_mode(1);
  select scsqsld(shortname(s), dmp)
    from charstring s
    where s in uniqueprephosts()
    and s != gethostname();
end;


lisp;
(verify-all)
:osql
