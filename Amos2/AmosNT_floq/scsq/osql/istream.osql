/*-*-sql-*-*******************************************************************/
create function wpp(vector v, integer port, integer nports)->object as
select v[6+port];

create function wa(stream input)->vector of real as
select winagg(in(input), 10, 1);

create function transform(stream input)->darray as
select rfft(darray(r))
from vector of real r
where r = wa(input);

create function inc(number a)->number
as select a + 1;

create function rhs(number x, number y)->number
as select y;

create function one()->number
as select 1;

create function twice(integer x)->integer as
select 2*x;

create function indata()->integer as
select 25 - (i - j)*(i - j)
from integer j, integer i
where j = 5 + 10*round((i+1.0)/10-.5) and i in iota(1, 20);

create function threshold(stream s, integer winsize)->vector as
select v
from vector v, integer b
where v in winagg(indata(), winsize, 1)
and b = count(select i from integer i where i=in(v) and i>20) and b=winsize;

create function ifilter(integer x, integer thres)->integer as
select x where x>thres;

create function sifilters(stream of integer sx, integer thres)->stream as
streamof(ifilter(in(sx), thres));



