/*-*-sql-*-*******************************************************************/

create function peakdetect(vector v, number threshold) -> vector
as vselect i, n
from integer i, number n
where n > threshold and
v[i]=n;

create function speakdetect(stream of vector s, number threshold) -> stream of vector
as streamof(peakdetect(in(s), threshold));

