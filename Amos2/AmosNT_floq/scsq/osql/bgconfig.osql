/* PC */
/* NB cmd.exe syntax: 
	/k=keep window (useful for debug), 
	/c=close window after exit */


set :bgsubmission = "start cmd.exe /k mpiexec -n 4 " + 
getenv("AMOS_HOME") + "\\\astro\\proc\\Debug\\proc.exe " +
getenv("AMOS_HOME") + "\\astro\\bg.dmp";
set :bghome = "";
set :bghostid = "localhost";
set :environment = "interactive";
set :crdatapath="/crdata4/";


