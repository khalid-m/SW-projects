< 'bgconfig.osql';
< 'spconfig.osql';
< 'scsq.osql';
< 'scsql.osql';
< 'mathfns.osql';
< 'peakdetect.osql';

load_lisp("../lsp/sp.lsp");
load_lisp("../lsp/ga.lsp");
load_lisp("../../lsp/iterate.lsp");

save "../../bin/sp.dmp";
quit;
