/*
Decoment this when running on a cluster:

sp_basehostnum(1);
sp_currenthostnum(0);
*/
set lroutputfiles() = "/local/home/javad/AmosNT/scsq/lr/scsq-plr/lrouput";

create function dlrnomysepib(charstring inputstream, vector of integer fo,
                             integer L, charstring descr) -> object as
select in(mergestreams({t3, t2, t1, t0}))
from stream of iarray input, charstring ofname,
	vector of stream xp, vector of stream proc, vector of stream postproc,
	Vector of Stream si, Vector of Stream si_hist, 
	Vector of Stream so_hist, stream t0, stream t1, stream t2, stream t3, integer nr_nodes

where t3 = ostream(newspflex( streamof(
           writefiles(ofname + "-ib-3-", 10000000,
           tslrhoho(cast(in(mergestreams(so_hist))
           as vector of integer)))),
           make_record({'hostname', 'localhost'})), 0)

and t2 = ostream(newspflex(streamof(writefiles(ofname + "-ib-2-", 10000000,
           dtslrbin(lrf0(in(zipstreams(vectorize(select i, postproc[i*3 + 2]
           from integer i where i in iota(0, dim(postproc)/3)))))))),
           make_record({'hostname', 'localhost'})), 0)

and t1 = ostream(newspflex(streamof(writefiles(ofname + "-ib-1-", 10000000,
         dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3 + 1]
         from integer i where i in iota(0, dim(postproc)/3))))))),
         make_record({'hostname', 'localhost'})), 0)

and t0 = ostream(newspflex(streamof(writefiles(ofname + "-ib-0-", 10000000,
         dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3]
         from integer i where i in iota(0, dim(postproc)/3))))))),
         make_record({'hostname', 'localhost'})), 0)

and so_hist = mapflexv((vselect {si_hist[i], i}
                    from integer i where i in iota(0,nr_nodes-1)),
                    #'lr_dailyexp', make_record({}))
and postproc = splitstreams(proc, 3, #'oesplit')
and proc = mapstreams(xp, #'mylrbin')
and si_hist = splitstream(si[1], nr_nodes, #'idexpmodpartition')
/*and xp = hpartstreamv(si[0], #'lrproute', L, fo, 0)*/
and xp = splitstream(si[0], L, #'xpartitionbin')
and nr_nodes = count( select mysql_nodes(i) from integer i )
and ofname = lroutputfiles() + stringify(L)
and si = splitstream( input, 2, #'dpartitionbin_nc')
and input = ostream(newsp(streamof(clrmultiply(ts_iarray(in(lreadbins(vselect('/local/home/javad/AmosNT/scsq/lr/data/l64-'+iota( 0, 76 ) ))),12),64,1))),0);
/*and input = ostream(newsp(streamof(clrmultiply(ts_iarray(in(lreadbins({'/local/home/javad/AmosNT/scsq/lr/data/cdp_lite40.bin'})),12),64,1))),0);*/

