and f = 8;")))

(checkequal "rr(16)"
((osql "set v() = vselect in(zipstreams(so))
from integer f, vector of stream t1, vector of stream so
where so = mapstreams(t1, #'tscount')
and t1 = splitstream(streamagg(lreadfast(datafile(), 10), f, f), f, #'rr')
and f = 16;
print({'time: ', maxagg(select cast(v()[2][i] as vector of real)[0]
                -cast(v()[0][i] as vector of real)[0] from integer i)});
sort(in(in(v()[1])));")
(osql "vselect floor(filecount()/f) from integer i, integer f 
where i in iota(1,f)
and f = 16;")))

(checkequal "rr(2+2)"
((osql "set v() = vselect in(zipstreams(p))
from integer f, vector of stream t1, vector of stream t2, vector of stream p
where p = mapstreams(t2, #'tscount')
and t1 = splitstream(streamagg(lreadfast(datafile(), 10), f, f), f, #'rr')
and t2 = (vselect so from stream so, stream s 
where s in t1 and so in splitstream(streamagg(s, f, f), f, #'rr'))
and f = 2;
print({'time: ', maxagg(select cast(v()[2][i] as vector of real)[0]
                -cast(v()[0][i] as vector of real)[0] from integer i)});
sort(in(in(v()[1])));")
(osql "vselect floor(filecount()/f) from integer i, integer f 
where i in iota(1,f)
and f = 4;")))

(checkequal "rr(2+2+2)"
((osql "set v() = vselect in(zipstreams(p))
from integer f, vector of stream t1, vector of stream t2, vector of stream t3,
vector of stream p
where p = mapstreams(t3, #'tscount')
and t1 = splitstream(streamagg(lreadfast(datafile(), 10), f, f), f, #'rr')
and t2 = (vselect so from stream so, stream s 
where s in t1 and so in splitstream(streamagg(s, f, f), f, #'rr'))
and t3 = (vselect so from stream so, stream s 
where s in t2 and so in splitstream(streamagg(s, f, f), f, #'rr'))
and f = 2;
print({'time: ', maxagg(select cast(v()[2][i] as vector of real)[0]
                -cast(v()[0][i] as vector of real)[0] from integer i)});
sort(in(in(v()[1])));")
(osql "vselect floor(filecount()/f) from integer i, integer f 
where i in iota(1,f)
and f = 8;")))

(checkequal "rr(2+2+2+2)"
((osql "set v() = vselect in(zipstreams(p))
from integer f, vector of stream t1, vector of stream t2, vector of stream t3,
vector of stream t4, vector of stream p
where p = mapstreams(t4, #'tscount')
and t1 = splitstream(streamagg(lreadfast(datafile(), 10), f, f), f, #'rr')
and t2 = (vselect so from stream so, stream s 
where s in t1 and so in splitstream(streamagg(s, f, f), f, #'rr'))
and t3 = (vselect so from stream so, stream s 
where s in t2 and so in splitstream(streamagg(s, f, f), f, #'rr'))
and t4 = (vselect so from stream so, stream s 
where s in t3 and so in splitstream(streamagg(s, f, f), f, #'rr'))
and f = 2;
print({'time: ', maxagg(select cast(v()[2][i] as vector of real)[0]
                -cast(v()[0][i] as vector of real)[0] from integer i)});
sort(in(in(v()[1])));")
(osql "vselect floor(filecount()/f) from integer i, integer f 
where i in iota(1,f)
and f = 16;")))
