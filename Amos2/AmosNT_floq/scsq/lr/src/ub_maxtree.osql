/*-*-sql-*-*******************************************************************/

create function file_fsplit(charstring file, integer inl, integer mult)
-> vector of vector of number as
select in(zipstreams(premerge))
from stream of numarray src, vector of stream premerge, vector of stream root,
integer q
where premerge = mapflex(root, #'stcount', {'rem':'mrg'})
and root = splitflexra(src, q, #'lrprfn', #'q2bfn', {0, 1}, 
{'hostnum':1, 'rem':'fsplit'})
and src = ostream(newspflex(streamof(multi2na(clrmultiply(in(
lreadfastbins({file})), inl, mult), 15)), {'hostnum':0, 'rem':'src'}), 0)
and q = inl*mult;

create function file_maxtree(charstring file, integer inl, integer mult)
-> vector of vector of number as
select in(zipstreams(premerge))
from stream of numarray src, vector of stream premerge, vector of stream maxt,
integer q
where premerge = mapflex(maxt, #'stcount', {'rem':'mrg'})
and maxt = rbhpartstreamv(src, #'lrprfn', #'q2bfn', q, optv(q, 0.58, 5), 0)
and src = ostream(newspflex(streamof(multi2na(clrmultiply(in(
lreadfastbins({file})), inl, mult), 15)), {'hostnum':0, 'rem':'src'}), 0)
and q = inl*mult;

create function lrpcpu()-> (charstring, real, integer) as
select c, roundto(p, 2), r['nsub']
from charstring c, record r, real p, charstring rfn
where (c, r) in dprofile()
and like(rfn, '*LRPRFN*')
and rfn = r['rfn']
and p = r['mappertime'];

create function x_file_maxtree(charstring file, integer inl, integer mult)
-> vector as begin
reset_ipr();
set res() = file_maxtree(file, inl, mult);
return {inl*mult, file, exectime(res()), countsum(res()),
psum(remcpu('src')), psum(lrpcpu()), psum(remcpu('mrg'))};
sleep(0.1);
end;

create function x_file_fsplit(charstring file, integer inl, integer mult)
-> vector as begin
reset_ipr();
set res() = file_fsplit(file, inl, mult);
return {inl*mult, file, exectime(res()), countsum(res()),
psum(remcpu('src')), psum(lrpcpu()), psum(remcpu('mrg'))};
sleep(0.1);
end;

create function ub_file_maxtree(charstring file, integer inl, 
vector of integer mults) -> object as begin
for each integer mult where mult in mults begin
declare charstring outputfilename;
set outputfilename = "maxtree-" + "m" + stringify(mult) + "_inl_" + 
stringify(inl);
add rrp_res() = x_file_maxtree(file, inl, mult);
print(rrp_res());
writefile("dp-" + outputfilename, {dprofile()});
end;
write_ntuples(rrp_res(), "maxtree_" + timestamp());
end;

create function ub_file_fsplit(charstring file, integer inl, 
vector of integer mults) -> object as begin
for each integer mult where mult in mults begin
declare charstring outputfilename;
set outputfilename = "fsplit-" + "m" + stringify(mult) + "_inl_" + 
stringify(inl);
add rrp_res() = x_file_fsplit(file, inl, mult);
print(rrp_res());
writefile("dp-" + outputfilename, {dprofile()});
end;
write_ntuples(rrp_res(), "fsplit_" + timestamp());
end;
