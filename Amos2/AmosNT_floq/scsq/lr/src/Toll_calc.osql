/****************************Vehicle info***************************/
/* Used for storing all data about a vehicle*/

create function vehicle_info(Integer vi)->
          ( Integer xway, Integer pos, Integer seg,Integer dir,Real bal,
            Integer lastupdate, Integer vav, Real nextexp)
  as stored;	

create function set_vehicle_info(Integer vi, Integer xway, Integer pos, 
                                 Integer seg,Integer dir,Real bal,
                                 Integer lastupdate, Integer vav, Real nextexp)
                                -> Boolean
  as set vehicle_info(vi)= (xway,pos,seg,dir,bal,lastupdate,vav,nextexp);

create function add_vehicle_info(Integer vi,Integer xway, Integer pos, 
                                 Integer seg,Integer dir,Real bal,
                                 Integer lastupdate, Integer vav, Real nextexp)
                                 ->boolean
  as add vehicle_info(vi)=(xway,pos,seg,dir,bal,lastupdate,vav,nextexp);

/***************************Vehicle info ends*********************************/

create function giveme_seg(Integer vid)->Integer
  as select s 
     from Integer x, Integer p, Integer s,Integer d, Real b, Integer l, 
          Integer va, Real n 
     where vehicle_info(vid)=(x,p,s,d,b,l,va,n) ;

create function giveme_xway(Integer vid)->Integer
  as select x 
     from Integer x, Integer p, Integer s,Integer d, Real b,Integer l, 
          Integer va, Real n 
     where vehicle_info(vid)=(x,p,s,d,b,l,va,n) ;

create function check_new_seg_report(Integer vid,Integer seg,Integer xway)
                                    -> Boolean
  /* same seg in this report as in the latest report?*/
  as select where giveme_seg(vid)=seg 
              and giveme_xway(vid)=xway;

create function add_previous_toll(Integer sec, Integer vid,Integer xway,
                                  Integer pos, Integer seg, Integer dir, 
                                  Integer spd)
                                 ->boolean
  as    select set_vehicle_info(vid, xway, pos, seg, dir, upbalance, 
                                sec, spd, 0.0)
	from Real upbalance
        where upbalance=sum(select n + b
                            from  Integer xw, Integer p, Integer s, Integer d,
                                  Real b,Integer l, Integer va, Real n 
                            where vehicle_info(vid) = (xw,p,s,d,b,l,va,n));

create function giveme_balance(Integer vid)->Real
  as select b 
     from  Integer xway, Integer p, Integer s, Integer d, Real b, Integer l, 
           Integer va, Real n 
     where vehicle_info(vid)=(xway,p,s,d,b,l,va,n);

create function giveme_lasttime(Integer vid)->Integer
  as select l 
     from Integer xway, Integer p, Integer s, Integer d, Real b, Integer l, 
          Integer va, Real n 
     where vehicle_info(vid)=(xway,p,s,d,b,l,va,n);

create function update_vehicle_info(Integer sec, Integer vid, Integer xway,
                                    Integer pos, Integer seg, Integer dir,
                                    Integer spd) -> Boolean
  /*Vehicle is on the exit lane, update info and remove nextexp*/
  as select add_previous_toll(sec,vid,xway,pos,seg,dir,spd);

create function update_vehicle_toll(Integer sec, Integer vid, Integer xway,
                                    Integer pos, Integer seg,Integer dir,
                                    Integer spd, Real toll)->Boolean 
  as select set_vehicle_info(vid,xway,pos,seg,dir,
                             giveme_balance(vid),
                             sec, spd, toll);

create function toll_alert()->(Integer ty, Integer vid,Integer time, 
                               Real emit,Real vavg,Real toll)
  as stored;

create function generate_toll_alert(Integer vid, Integer time, Real vavg, 
                                    Real toll)->vector as
  /* Result[3] (emit time) is computed in timestamplr(). */
  select {0, vid, time, 0, vavg, toll};

create function generate_toll_alert_t(Integer vid, Integer time, Real vavg, 
                                    Real toll, real ts)->vector as
  /* Result[3] (emit time) is computed in timestamplr(). */
  select {0, vid, time, 0, vavg, toll, ts}; 

create function calc_toll(Integer sec, Integer vid, Integer xway, Integer pos,
                          Integer seg, Integer dir, Integer spd)
                         -> Vector
  as begin
       declare Real toll,Integer nr_of_cars,Real Avgv;
       if is_accident_area(xway,seg,dir)
	/* Return[2] (emit time) is computed in timestamplr(). */
       then begin return {1, sec, 0, vid,
                            get_accident_seg(xway) }; /* Send accident alert */
	          set toll=0.0;
	          set Avgv=avgv(seg,xway,dir,
                                cast(current_minute()-1 as Integer));
            end
       else begin set nr_of_cars=count_visited(seg, xway, dir,
                                               cast(current_minute() - 1
                                                    as Integer));
	          set Avgv=avgv(seg,xway,dir,
                                cast(current_minute()-1 as Integer));
	          if (nr_of_cars<=50) or (Avgv>=40) 
                  then set toll=0.0
                  else begin set toll=2*(nr_of_cars-50)*(nr_of_cars-50);
		             /*print({"toll=", toll});*/
                       end;
           end;
       update_vehicle_toll(sec, vid, xway, pos, seg, dir, spd, toll);
       return generate_toll_alert(vid, sec, Avgv, toll);
     end;

create function calc_toll_t(Integer sec, Integer vid, Integer xway, Integer pos,
                            Integer seg, Integer dir, Integer spd, real ts)
                         -> Vector
  as begin
       declare Real toll, Integer nr_of_cars, Real Avgv;
       if is_accident_area(xway,seg,dir)
	/* Return[2] (emit time) is computed in timestamplr(). */
       then begin return {1, sec, 0, vid,
                            get_accident_seg(xway), ts}; /* Send accident alert */
	          set toll=0.0;
	          set Avgv=avgv(seg,xway,dir,
                                cast(current_minute()-1 as Integer));
            end
       else begin set nr_of_cars=count_visited(seg, xway, dir,
                                               cast(current_minute() - 1
                                                    as Integer));
	          set Avgv=avgv(seg,xway,dir,
                                cast(current_minute()-1 as Integer));
	          if (nr_of_cars<=50) or (Avgv>=40) 
                  then set toll=0.0
                  else begin set toll=2*(nr_of_cars-50)*(nr_of_cars-50);
		             /*print({"toll=", toll});*/
                       end;
           end;
       update_vehicle_toll(sec, vid, xway, pos, seg, dir, spd, toll);
       return generate_toll_alert_t(vid, sec, Avgv, toll, ts);
     end;
