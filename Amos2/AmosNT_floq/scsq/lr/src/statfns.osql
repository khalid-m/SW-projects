where rt = maxagg(in(w))
and (sec, w) = groupagg(60, in(select v[0],v[1] from vector v where v = readfile("/home/zeitler/crt5s")))));

*/

create function responsetime(stream s, integer stride, real tstart)
-> (integer, vector) as
select groupagg(stride, in(
select simtime(w), realtime(w) - simtime(w) - tstart
from vector w
where w in s));
create function count_inputs(stream of vector s, integer stride)
-> (integer, integer) as
select sec, num from 
integer sec, integer num, vector w
where num = dim(w)
and (sec, w) = groupagg(stride, in(
select v[1], 0
from vector v
where v=in(s))); 

create function lrs(stream s, integer stride, real tstart)
-> (integer, integer, real, real, real) as
select dim(v), sec, max_tot, avg_tot, std_tot
from integer sec, vector v, real max_tot, vector totstatv, real avg_tot, 
real std_tot 
where max_tot = maxagg(in(v))
and totstatv = v
and (avg_tot, std_tot) = vavgstdev(totstatv)
and (sec, v) = responsetime(s, stride, tstart);

create function lrstat(vector of charstring filenames, integer stride)
-> (integer, integer, real, real, real) as begin
declare real tstart;
set tstart = getstarttime(filenames[0]);
return lrs(streamof(readfiles(filenames)), stride, tstart);
end;

create function makelrstat(vector of charstring infile, charstring outfile, 
integer stride)->boolean as
select writefile(outfile, {lrstat(infile, stride)});

create function allfiles(charstring dir, charstring mask)->vector of charstring
as select sort(dir + "/" + dir(dir, mask));

create function distribstat(charstring lroutputdir, charstring lroutputmask, 
charstring outfile, integer stride)->vector as
select merge(statproc)
from vector of sp statproc
where statproc = spv(vectorof(
select streamof(makelrstat(allfiles(lroutputdir + "/" + stringify(i), 
                                    lroutputmask),
                           outfile + stringify(i), stride))
from integer i where i in iota(2, 5)));

create function vec2csv(charstring infile, charstring outfile)->charstring as
select exec("sed s'/#(//g;s/)//g;s/ /;/g' " + infile + " > " + outfile);
