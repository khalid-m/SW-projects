create function eventtype(vector v)->integer as
select v[0];

create function vidno(vector v)->integer
as select v[2];

create function xway(vector v)->integer as
select v[4];

create function direction(vector v)->integer as
select v[6]; 

create function eventtype(iarray v)->integer as
select v[0];

create function vidno(iarray v)->integer
as select v[2];

create function xway(iarray v)->integer as
select v[4];

create function direction(iarray v)->integer as
select v[6];

create function eventtype(darray v)->real as
select v[0];

create function vidno(darray v)->integer
as select integer(v[2]);

create function xway(darray v)->integer as
select integer(v[4]);

create function direction(darray v)->integer as
select integer(v[6]);

create function maxv(Vector v)->Number
  /* Get max element in vector */
  as select maxagg(in(v));

create function groupMax(Number stride, Bag s)-> (Number stamp, Number max)
  /* Stream group max values from pairs (x, value) in s striding over x */
  as select stamp, maxv(g)
     from Vector g
     where (stamp, g) = groupAgg(stride, s);

create function groupStat(Number stride, Bag s)-> 
                         (Number stamp, Number max, Number avg, Number stddev)
  /* Stream group statistics from pairs (x, value) in s striding over x */
  as select stamp, maxv(g), avg, stddev
     from Vector g
     where (stamp, g) = groupAgg(stride, s) and
           (avg, stddev) = vavgstdev(g);

create function numvec(Object o)->Vector of Number n
  /* Cast object to Vector of Number */
  as select n where n=o;

create function maxResponses(Number stride, Number arr, Number leav, 
                             Stream stream)-> 
                            (Number stamp, Number max)
  /* Stream (arrival, maxresponse) where arr and leave are event positions */
  as select groupMax(stride,(select e[arr], e[leav]-e[arr]
                             from Vector of Number e
                             where e = numvec(in(stream))));

create function statResponses(Number stride, Number arr, Number leav, 
                             Bag stream)-> 
                            (Number stamp, Number max, Number avg, Number std)
  /* Stream (arrival, max, mean, stddev) of difference e[leav]-e[arr] */
  as select groupStat(stride,(select e[arr], e[leav]-e[arr]
                             from Vector of Number e
                             where e = numvec(in(stream))));

create function maxTollResponses(Number stride)-> (Number stamp, Number max)
  /* Stream max tollalert response times with given stride */
  as select maxResponses(stride, 2, 3, readnumstream("o-tollalert"));

create function maxTollResponsesBetween(Number bt, Number et, Number stride)
                                       -> (Number stamp, Number max)
  /* Stream max tollalert response times between bt and et with stride */
  as select maxResponses(stride, 2, 3, streamof(select e from Vector e
                                        where e in readnumstream("o-tollalert")
                                          and e[2]>= bt
                                          and e[2]<= et));

create function compare(integer a, integer b)->integer 
as foreign 'compare-impl';

lisp;

(defun compare-impl (fno a b res)
  "Enables osql calls to lisp fn compare"
  (osql-result a b (compare a b)))

:osql

create function lrstat(charstring filename, integer stride)->
(charstring, integer, real, real, real, real) as
select filename, s, max, min, avg,stdev
from integer s, vector v, real max, real min, real avg, real stdev
where min = minagg(in(v))
and max = maxagg(in(v))
and (avg,stdev) = vavgstdev(v)
and (s,v) in
groupagg(stride, in(select v[2-compare(cast(v[0] as integer),0)],
v[3-compare(cast(v[0] as integer),0)]
from vector v
where v in readfile(filename)));

create function lrs(stream s, integer stride)
-> (integer, integer, real, real, real, real, real, real) as
select dim(v), sec, max_tot, avg_tot, stdev_tot, max_comp, avg_comp, stdev_comp
from integer sec, vector v, real max_tot, vector totstatv, real max_comp, 
vector compstatv,
real avg_tot, real stdev_tot, real avg_comp, real stdev_comp
where max_tot = maxagg(cast(in(v) as vector)[0])
and totstatv = vectorof(cast(in(v) as vector)[0])
and (avg_tot, stdev_tot) = vavgstdev(totstatv)
and (avg_comp, stdev_comp) = vavgstdev(compstatv)
and max_comp = maxagg(cast(in(v) as vector)[1])
and compstatv = vectorof(cast(in(v) as vector)[1])
and (sec, v) = groupagg(stride, in( 
select w[2-compare(cast(w[0] as integer),0)], 
w[3-compare(cast(w[0] as integer),0)]
from vector w where w in s));

create function getstarttime(charstring filename)->real as
select w[dim(w)-1]
from vector w
where w = in(section(streamof(readfile(filename)), 1, 1)); 

create function simtime(vector w)->integer as
select w[2-compare(eventtype(w),0)]; 

create function realtime(vector w)->real as
select w[dim(w)-1];

create function rtvid(stream of vector s, integer stride, real tstart)
-> (integer, vector) as
select groupagg(stride, in(
select simtime(w), {realtime(w) - simtime(w) - tstart, w[1]}
from vector w
where w=in(s)));

/* Statistics for instrumented LR (time stamps for incoming + outgoing tpls) */

create function instrumenttime(vector w)->real as
select w[dim(w)-2];

create function irt(stream of vector s, integer stride)
-> (integer, Vector of Real) as
select groupagg(stride, in(
select simtime(w), realtime(w) - instrumenttime(w)
from vector w
where w=in(s)));

create function i_time_in_system(stream of vector s, integer stride)
-> (integer, integer, real, real) as
select dim(v), sec, av, st
from vector v, integer sec, real av, real st
where (av, st) = vavgstdev(v)
and (sec, v) = irt(s, stride);

/* End statistics for instrumented LR */

/* Full fräs-statistik */

create function stvid(stream of vector s, integer stride, real tstart)
-> (integer, vector) as
select groupagg(stride, in(
select simtime(w), {realtime(w) - tstart, w[1]}
from vector w
where w=in(s)));

create function tdiffs(vector v) -> (real,real) as
select vavgstdev(vectorof(
select pairs[1][0] - pairs[0][0]
from vector of vector of real pairs
where pairs in winagg(in(v), 2, 1)));

create function secstart(vector of vector v)->real as
select v[0][0];   

create function secend(vector of vector v)->real as
select v[dim(v)-1][0];   

create function ptime(stream of vector s, real tstart)
-> (integer, real) as
select sec, w
from vector of vector v, integer sec, real w
where w = secend(v) - secstart(v)
and (sec, v) = stvid(s, 1, tstart); 

create function ptimeagg(stream of vector s, real tstart, integer stride)
-> (integer, real) as
select sec, av
from integer sec, real av, real st, vector stat
where (av, st) = vavgstdev(stat)
and (sec, stat) = groupagg(stride, ptime(s, tstart)); 

create function time_in_system(stream of vector s, integer stride, real tstart)
-> (integer, integer, vector) as
select dim(v), sec, w
from vector v, vector w, Integer sec
where w = tdiffs(v)
and (sec, v) = stvid(s, stride, tstart);
create function lrsvid(stream of vector s, integer stride, real tstart)
-> (integer, integer, vector) as
select dim(v), sec, ma
from integer sec, vector v, vector ma
where ma = vmax(v)
and (sec, v) = rtvid(s, stride, tstart);

/* end full fräs */

create function crt(stream of vector s, real tstart)
-> (integer, real) as
select simtime(w), realtime(w) - simtime(w) - tstart
from vector w
where w=in(s);

