create function duration(real start)->real as
roundto(rnow() - start, 2);

/* Tables for the full tests */
create function last_clock() -> real;    
create function lroutput()->vector;
create function lroutputbin()->numarray;

create function actual0(integer xway, integer carid, integer time)
 -> <number, number>;
create_index("actual0", "carid", "hash", "multiple");
create_index("actual0", "time", "hash", "multiple");
create function actual1()->vector;
create function actual2()->vector;
create function actual3()->vector;
create function expected0(integer xway, integer carid, integer time)
 -> <number, number>;
create function expected1()->vector;
create function expected2()->vector;
create function expected3()->vector;

add expected0(v[0], v[1], v[2]) = <v[4], v[5]>
from vector of number v
where v in readfile('data/o15-0-expected.out');
create_index("expected0", "carid", "hash", "multiple");
create_index("expected0", "time", "hash", "multiple");
add expected1() = {v[0], v[1], v[3], v[4]}
  from vector v
  where v in readfile('data/o15-1-expected.out');
add expected2() = {v[0],v[3],v[5]}
  from vector v
  where v in readfile('data/o15-2-expected.out');
add expected3() = {v[0],v[1],v[3],v[4]}
  from vector v
  where v in readfile('data/o15-3-expected.out');

create function test_alert(Charstring file, Integer fr, Integer t)->
   <Integer acc, Integer timestamp, Integer vehicleid, Integer roadSegment>
  as select r[0], r[1], r[3], r[4]
     from Vector r
     where r = cast(in(section(streamof(readfile(file)),fr,t)) as vector);
create function test_t2(Charstring file, Integer fr, Integer t)->
   <Integer tp, Integer timestamp, Integer qid, Real balance>
  as select r[0], r[1], r[3], r[5]
     from Vector r
     where r = cast(in(section(streamof(readfile(file)),fr,t)) as vector);
create function test_t3(Charstring file, Integer fr, Integer t)->
   <Integer tp, Integer timestamp, Integer qid, Real toll>
  as select r[0], r[1], r[3], r[4]
     from Vector r
     where r = cast(in(section(streamof(readfile(file)),fr,t)) as vector);
create function test_tollalert(Charstring file, Integer fr, Integer t)->
   <Integer tp, Integer vehicle, Integer timestamp, Real speed, Real toll>
  as select r[0], r[1], r[2], r[4], R[5]
     from Vector r
     where r = cast(in(section(streamof(readfile(file)),fr,t)) as vector);
create function test_sorted_tollalert(charstring file, integer second)->vector 
as select sort(
  select {v[0], v[1], v[2], v[4], v[5]}
  from vector v
  where v in readfile(file)
  and v[2]=second);

