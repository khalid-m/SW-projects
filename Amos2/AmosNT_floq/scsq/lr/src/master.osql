load_lisp("lread.lsp");
load_lisp("visited.lsp");
<'Historical_data.osql';
<'statfns.osql';
<'lrconfig.osql';
<'Timecalc.osql';
<'Accident_check.osql';
<'Toll_calc.osql';
<'scsq-lr.osql';
<'myhistory.osql';
<'partition.osql';
<'testdata.osql';
lisp;
(setq _strict-restypes_ nil) ;; Several type errors in multitos.osql!
:osql
<'multitos.osql';
lisp;
(setq _strict-restypes_ t)
:osql
<'ub_psplit.osql';
<'ub_smj.osql';
<'ub_rsplit.osql';
<'ub_rpsplit.osql';
<'ub_p2p.osql';
<'ub_fsplit.osql';
<'ub_rrsplit.osql';
<'ub_rrpsplit.osql';
<'ub_maxtree.osql';
<'ub_mamaxtree.osql';
<'profile.osql';
<'freeze.osql';
lisp;
(verify-all)
(setq _system-watermark_ _oidno_)
:osql
