/*-*-sql-*-*******************************************************************/

< "src/test_setup.osql";
clear_function('expected0');
clear_function('expected1');
clear_function('expected2');
clear_function('expected3');

add expected0(v[0], v[1], v[2]) = <v[4], v[5]>
from vector v
where v = readfile('data/o40-0-expected.out');
create_index('expected0', 'carid', 'hash', 'multiple');
create_index('expected0', 'time', 'hash', 'multiple');
add expected1() = readfile('data/o40-1-expected.out');
add expected2() = {v[0],v[3],v[5]}
  from vector v
  where v = readfile('data/o40-2-expected.out');
add expected3() = {v[0],v[1],v[3],v[4]}
  from vector v
  where v = readfile('data/o40-3-expected.out');

lisp;
;"

;(osql "show_sp();");


(checkequal "L=4 binary: split-[map+MySQL+split]-abagg-merge"
 ((osql "clear_function('actual0');
clear_function('actual1');
clear_function('actual2');
clear_function('actual3');
clear_function('lroutputbin');
writefile('data/cdp_lite40.bin', iarray(vreadfile('data/cdp_lite40.out')));
set last_clock() = real(now());
add lroutputbin() = in(mergestreams(concat({abagg}, concat(alla, mybin))))
from vector of stream src, vector of stream of darray proc, 
vector of stream of darray postproc,
vector of stream alla, stream abagg, vector of stream my, 
vector of stream mybin, integer L
where abagg = ostream(newsp(lrf(zipstreams(vectorize(select i, postproc[i*2+1]
  from integer i where i in iota(0, dim(postproc)/2))))), 0)
and alla = vectorize(select i, postproc[i*2]
  from integer i where i in iota(0, dim(postproc)/2))
and postproc = splitstreams(proc, 2, #'accbalsplit')
and proc = mapstreams(
(vselect src[i] from integer i where i in iota(0, L - 1)), #'lrbin')
and mybin = mapstreams(my, #'vstream2iastream')
and my = mapflexv({{'mei.it.uu.se', 'lrtest40', src[L]}}, #'dailyexp',
                 make_record({'hostname', 'mei.it.uu.se', 'exe', 'javascsq'}))
and src = splitstream(lreadfast(
                getenv('AMOS_HOME') + '/scsq/lr/data/cdp_lite40.bin', L),
                L + 1, #'dxpartitionbin')
and L = 4;
print({'duration L=4 // = ', real(now()) - last_clock()});
add actual0(integer(v[0]), integer(v[1]), integer(v[2])) = <v[4], v[5]>
from vector of number v
where v = lrbinlogfilter(lroutputbin(), 0, 0);
add actual1() = {integer(v[0]), integer(v[1]), integer(v[3]), integer(v[4])} 
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 1, 0);
add actual2() = {integer(v[0]), integer(v[3]), v[5]}
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 2, 0);
add actual3() = {integer(v[0]), integer(v[1]), integer(v[3]), integer(v[4])} 
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 3, 0);
count(select actual0(i,j,k) from integer i, integer j, integer k);")
  (osql "count(select expected0(i,j,k) from integer i, integer j, 
               integer k);"))
 ((osql "count(actual1());") (osql "count(expected1());"))
 ((osql "count(actual2());") (osql "count(expected2());"))
 ((osql "count(actual3());") (osql "count(expected3());")))


(sleep 3)

(send-form '(quit) (open-nameserver-port))
