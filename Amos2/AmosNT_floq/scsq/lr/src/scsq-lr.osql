create function in_d(stream s)->darray
as select d from darray d
where d in s;

create function tscount0(stream s)->vector as begin
 return {real(now())};
 return {count(in(s))};
 return {real(now())};
end;

create function tscount(stream s)->stream
as streamof(tscount0(s));

create function L()->integer; 

create function lreadfast(charstring filename, integer L)
 -> Stream of Vector of Integer as begin
clear_function("L");
add L() = L;
return readintstream(filename);
end; 

/*
create function lreadfastbin(charstring filename, integer L)
 -> Stream of Iarray as begin
clear_function("L");
add L() = L;
return streamof(readfile(filename));
end;
*/

create function lreadfast(vector of charstring filenames, integer L)
 -> Stream of Vector of Integer as begin
clear_function("L");
add L() = L;
return readintstreams(filenames);
end; 

