/* CPU profiling of all nodes doing either split or merge */

create function mergecpu()-> (charstring, real, integer) as
select c, roundto(p, 2), r['nsub']
from charstring c, record r, real p
where (c, r) in dprofile()
and notany(like(rgenerator(r), "*CLRMULTIPLY*"))
and notany(like(rgenerator(r), "*EXTRACT*"))
and p = r['mappertime']
and notany(r['rfn'])
and r['nsub'] = 1;

create function gencpu()-> (charstring, real, integer) as
select c, roundto(p, 2), r['nsub']
from charstring c, record r, real p
where (c, r) in dprofile()
and like(rgenerator(r), "*CLRMULTIPLY*")
and p = r['mappertime'];

create function rcpu()-> (charstring, real, integer) as
select c, roundto(p, 2), r['nsub']
from charstring c, record r, real p
where (c, r) in dprofile()
and p = r['mappertime']
and like(rgenerator(r), "*EXTRACT*")
and notany(r['rfn']);

create function fscpu()-> (charstring, real, integer) as
select c, roundto(p, 2), r['nsub']
from charstring c, record r, real p, charstring rfn
where (c, r) in dprofile()
and like(rfn, "*XWAYRFN*")
and rfn = r['rfn']
and p = r['mappertime'];

/* ub_parasplit: u-Benchmark parallel splitstream using synthetic input data */

create function ub_parasplit(integer inl, integer mult, integer promille,
                             integer rep, integer msz, integer rrfo)
-> vector of number as
select in(zipstreams(premerge))
from vector of stream premerge, vector of stream of numarray rr,
vector of stream fsplit, stream src, integer w
where premerge = mapstreams(premerge(fsplit, rrfo, w), #'stcount')
and fsplit = unpackfsplit(rr, w, #'xwayrfn', #'q2bfn', 15)
and rr = rsplit_force_flex(src, rrfo, make_record({}))
and src = ostream(newsp(streamof(clrmultiply(in(
i_multihybrid_enumc(inl, promille, rep, msz)), inl, mult))), 0)
and w = inl*mult;

create function ub_file_parasplit(integer inl, integer mult, integer promille,
                                  integer rep, integer msz, integer rrfo)
-> vector of number as
select in(zipstreams(premerge))
from vector of stream premerge, vector of stream of numarray rr,
vector of stream fsplit, stream src, integer w
where premerge = mapstreams(premerge(fsplit, rrfo, w), #'stcount')
and fsplit = unpackfsplit(rr, w, #'xwayrfn', #'q2bfn', 15)
and rr = rsplit_force_flex(src, rrfo, {'hostnum':0, 'rem':'rsplit'})
and src = ostream(newspflex(streamof(clrmultiply(in(
lreadfastbins({getenv('HOME') + "/glob/c10-1M-multi" + stringify(msz) +".bin"})
), inl, mult)), {'hostnum':0, 'rem':'src'}), 0)
and w = inl*mult;

/* x_ub_parasplit procedure measures throughput and cpu usage */

create function res()->vector of vector of number;

create function x_ub_parasplit(integer inl, integer mult, integer promille,
                       integer rep, integer msz, integer rrfo)
-> (integer, integer, integer, integer, integer, real exetime,
  integer countsum, real gencpu, real rcpu, real fscpu, real mcpu, real sumcpu)
as begin
reset_ipr();
set res() = ub_file_parasplit(inl, mult, promille, rep, msz, rrfo);
set gencpu = psum(gencpu());
set rcpu = psum(rcpu());
set fscpu = psum(fscpu());
set mcpu = psum(mergecpu());
set sumcpu = gencpu + rcpu + fscpu + mcpu;
print({inl*mult, promille, msz, rrfo, res(), gencpu, rcpu, fscpu, mcpu, 
       sumcpu});
set exetime = exectime(res());
set countsum = countsum(res());
return(select inl*mult, promille, msz, rrfo, rep, exetime, countsum, gencpu,
       rcpu, fscpu, mcpu, sumcpu);
sleep(0.1);
end;

/* Result storage */

create function ub_para_res() -> vector of number;
/*(integer, integer, integer, integer, integer, real exetime,
  integer countsum, real gencpu, real rcpu, real fscpu, real mcpu, real sumcpu);*/

/* Experiment script to be called from top level */

create function parasplit(integer inl, vector of integer mults,
                          vector of integer promilles, integer rep,
                          integer msz, vector of integer rrfos)
-> object as begin
for each integer mult where mult in mults begin
for each integer promille where promille in promilles begin
for each integer rrfo where rrfo in rrfos begin
declare charstring outputfilename;
set outputfilename = "psplit-" + stringify(inl*mult) + 
                     "_promille" + stringify(promille) +
                     "_rrfo" + stringify(rrfo) +
                     "_r" + stringify(rep);
add ub_para_res() = {x_ub_parasplit(inl, mult, promille, rep, msz, rrfo)};
print(ub_para_res());
writefile("dp-" + outputfilename, {dprofile()});
end;
end;
end;
write_ntuples({ub_para_res()}, "psplit_" + timestamp());
end;

create function f_parasplit(charstring file, integer inl, integer mult,
                            integer p) -> vector of number as
select in(zipstreams(premerge))
from vector of stream premerge, vector of stream of numarray rr,
vector of stream fsplit, stream src, integer w
where premerge = mapstreams(premerge(fsplit, p, w), #'stcount')
and fsplit = unpackfsplit(rr, w, #'xwayrfn', #'q2bfn', 15)
and rr = rsplit_force_flex(src, p, {'hostnum':0, 'rem':'rsplit'})
and src = ostream(newspflex(streamof(clrmultiply(in(
lreadfastbins({file})), inl, mult)), {'hostnum':0, 'rem':'src'}), 0)
and w = inl*mult;

create function x_file_parasplit(charstring file, integer inl, integer mult,
                                 integer p)
-> (integer, charstring, integer, real exetime, integer countsum, real gencpu,
    real rcpu, real fscpu, real mcpu, real sumcpu)
as begin
reset_ipr();
set res() = f_parasplit(file, inl, mult, p);
set gencpu = psum(gencpu());
set rcpu = psum(rcpu());
set fscpu = psum(fscpu());
set mcpu = psum(mergecpu());
set sumcpu = gencpu + rcpu + fscpu + mcpu;
print({inl*mult, file, p, res(), gencpu, rcpu, fscpu, mcpu, 
       sumcpu});
set exetime = exectime(res());
set countsum = countsum(res());
return(select inl*mult, file, p, exetime, countsum, gencpu,
       rcpu, fscpu, mcpu, sumcpu);
sleep(0.1);
end;

/* Result storage */

create function file_para_res() -> vector of number;

/* Experiment script to be called from top level */

create function file_parasplit(charstring file, integer inl,
                               vector of integer mults, vector of integer ps)
-> object as begin
for each integer mult where mult in mults begin
for each integer p where p in ps begin
declare charstring outputfilename;
set outputfilename = "psplit-" + stringify(inl*mult) + 
                     "_p" + stringify(p);
add file_para_res() = {x_file_parasplit(file, inl, mult, p)};
print(file_para_res());
writefile("dp-" + outputfilename, {dprofile()});
end;
end;
write_ntuples(file_para_res(), "psplit_" + timestamp());
end;
