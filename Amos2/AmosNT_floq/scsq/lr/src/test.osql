  writefile('data/u2.bin', iarray(vreadfile('data/ultralite2.out')));
  writefile('data/u1.bin', iarray(vreadfile('data/ultralite1.out')));")
(let ((ts (time-spent (osql "set :count = 
    count(in(lreadbinsadj({'data/u1.bin', 'data/u2.bin'}, -1.0, 1)));"))))
  (princ (concat " [" (roundto ts 3) " seconds] "))
  (>= ts 3.0)))
