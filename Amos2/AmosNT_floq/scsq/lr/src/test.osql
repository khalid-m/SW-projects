/* Add an accident in a this segment to enable test of toll-free region. */

add_accident(0,27,1,65,1);

set_current_minute(4);

lisp;
(checkequal "toll alert inside accident area"
 ((osql "select r[0], r[1], r[2], r[4], r[5]
         from vector r
         where r = toll_calc(242, 5556, 0, 147319, 27, 1, 37, 2);")
 '((0 5556 242 32.0 0.0))))

:osql

clear_function("accident");

lrinit();
set current_second() = 0;
set rtime()=now();
count(in(lr(lreadfast("data/accident_test.out", 1))));


/* One accident on xway 0, one accident on xway 1.
   Look at all vehicles involved, in the smashed_car() table.

   Once a vehicle has started moving, its xway and minute of clearance
   (current_minute() + 2) is added to accident_remove_order(). 
   All accidents in accident_remove_order() will be cleared at minute of
   clearance.

   Some of the seconds in the test data are empty. 
*/

lisp;
(checkequal "accidents"
  ((osql "accident();") '((0 69 1 301 6) (1 62 1 276 5))))

(checkequal "smashed_car()"
  ((osql "smashed_car();") '((8 364320 0 69 1 1) (76 364320 0 69 1 1)
			(5555 328673 1 62 1 2) (5556 328673 1 62 1 2))))

(checkequal "accident_remove_order()"
 ((osql "select i, accident_remove_order(i) from integer i;") 
 '((0 8) (0 8) (1 8) (1 8))))
:osql

set_current_minute(8);
select check_kill_accident(xways)
	            from Integer xways
	           where xways in iota(0,1);

lisp;
(checkequal "accidents after remove order"
  ((osql "accident();") '()))

(checkequal "smashed_car after remove order"
  ((osql "smashed_car();") '()))

(checkequal "accident_remove_order after remove order"
  ((osql "select accident_remove_order(i) from integer i;") '()))


;;; There should not be an accident here (seg is arbitrarily chosen).

(checkequal "non-accident area"
  ((osql "is_accident_area(0,10,1);") '()))
:osql

set_current_second(140);
set_current_minute(3);
add_accident(0,10,1,140,3);
set_current_minute(7);

lisp;
(checkequal "accident area"
  ((osql "is_accident_area(0,10,1);") '((TRUE)))
  ((osql "is_accident_area(0,11,1);") '((TRUE)))
  ((osql "is_accident_area(0,9,1);") '()))
:osql

remove_accident(0);

lisp;
(checkequal "accident area after removal"
  ((osql "is_accident_area(0,10,1);") '())
  ((osql "is_accident_area(0,11,1);") '())
  ((osql "is_accident_area(0,9,1);") '()))

:osql
lrfinalize();

/* accbalfuse */

lisp;
(checkequal "lrfuse (fusing account balance)"
((osql "sort(select lrlogfilter(lrfuse(suall(proc), 2),
                                2, 0)
from sp src, vector of sp proc, integer L
where proc = spv(
  vectorof(
    select lr(s)
    from integer i, stream of vector of integer s
    where i in iota(0, L - 1)
    and s = stract(src)))
and src = newsp(lreadfast(
             {getenv('AMOS_HOME') + '/scsq/lr/data/crowded.out' }, L),
             L, #'lrdistrib2')
and L = 2);") 
'((#(#(2 63 0 1000 63 8.0) #(2 70 0 1001 65 10.0) #(2 80 0 1002 65 10.0))))))


; Do a regression test on a moderately sized data set.
; testlr() is used for the regression test 
; on the local node, which re-initializes all tables 
; used in LR.
; lr() is used directly without any initialization in
; the distributed extract(newsp(...)) test below.

(checkequal "Conventional L=1.5"
  ((osql "loadhistory(readintstream('data/hist_lite.out'));

set last_clock() = real(now());
add lroutput() = testlr('data/cdp_mid15.out', 2);
print({'duration CONVENTIONAL = ', duration(last_clock())});

add actual0(v[0], v[1], v[2]) = <v[4], v[5]>
from vector v
where v = lrlogfilter(lroutput(), 0, 0);
add actual1() = {v[0], v[1], v[3], v[4]} 
  from vector v
  where v = lrlogfilter(lroutput(), 1, 0);
add actual2() = {v[0],v[3],v[5]}
  from vector v
  where v = lrlogfilter(lroutput(), 2, 0);
add actual3() = {v[0],v[1],v[3],v[4]} 
  from vector v
  where v = lrlogfilter(lroutput(), 3, 0);
count(select actual0(i,j,k) from integer i, integer j, integer k);")
   (osql "count(select expected0(i,j,k) 
                from integer i, integer j, integer k);"))
  ((osql "count(actual1());") (osql "count(expected1());"))
  ((osql "count(actual2());") (osql "count(expected2());"))
  ((osql "count(actual3());") (osql "count(expected3());")))

(checkequal "full L=1.5 output CONVENTIONAL"
 ((osql "count(
   select a_lav, a_toll
   from integer i, integer j, integer k, 
     real a_lav, real a_toll, real e_lav, real e_toll
   where <a_lav, a_toll> = actual0(i,j,k)
     and <e_lav, e_toll> = expected0(i,j,k)
     and roundto(a_lav, 5) = roundto(e_lav, 5)
     and roundto(a_toll, 5) = roundto(e_toll, 5));")
  (osql "count(select expected0(i,j,k) from integer i, integer j,
         integer k);"))
 ((osql "sort(actual1());")
  (osql "sort(expected1());"))
 ((osql "sort(actual2());")
  (osql "sort(expected2());"))
 ((osql "sort(actual3());")
  (osql "sort(expected3());")))
;'

(checkequal "binary writefile"
 ((osql
   "set last_clock() = real(now());
    writefile('data/cdp_mid15.bin',
               iarray(vreadfile('data/cdp_mid15.out')));
    print({'duration write = ', duration(last_clock())});
    create function iadiff(iarray ia, vector of number v)->real as
    sum(select abs(ia[i] - v[i])
    from integer i where i in iota(0,dim(ia)-1));
    set last_clock() = real(now());
    set :diff = sum(select iadiff(i, v)
    from iarray i, vector of integer v, vector m
    where m = merge({newsp(streamof(readfile(getenv('AMOS_HOME') + 
                                             '/scsq/lr/data/cdp_mid15.out'))),
                     newsp(streamof(readfile(getenv('AMOS_HOME') + 
                                             '/scsq/lr/data/cdp_mid15.bin')))})
    and v = m[0]
    and i = m[1]);
    print({'duration read = ', duration(last_clock())});
    :diff;")
 '((0))))

;'"

(checkequal "Binary L=1.5"
  ((osql "clear_function('actual0');
clear_function('actual1');
clear_function('actual2');
clear_function('actual3');
clear_function('lroutput');
clear_function('abtime');
clear_function('abanswer');
set last_clock() = real(now());
add lroutputbin() = testlrbin('data/cdp_mid15.bin', 2);
print({'duration BINARY = ', duration(last_clock())});

add actual0(integer(v[0]), integer(v[1]), integer(v[2])) = <v[4], v[5]>
from vector of number v
where v = lrbinlogfilter(lroutputbin(), 0, 0);
add actual1() = {integer(v[0]), integer(v[1]), integer(v[3]), integer(v[4])} 
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 1, 0);
add actual2() = {integer(v[0]), integer(v[3]), v[5]}
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 2, 0);
add actual3() = {integer(v[0]), integer(v[1]), integer(v[3]), integer(v[4])} 
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 3, 0);
count(select actual0(i,j,k) from integer i, integer j, integer k);")
   (osql "count(select expected0(i,j,k) 
                from integer i, integer j, integer k);"))
  ((osql "count(actual1());") (osql "count(expected1());"))
  ((osql "count(actual2());") (osql "count(expected2());"))
  ((osql "count(actual3());") (osql "count(expected3());")))

(checkequal "full L=1.5 output BINARY"
 ((osql "count(
   select a_lav, a_toll
   from integer i, integer j, integer k, 
     real a_lav, real a_toll, real e_lav, real e_toll
   where <a_lav, a_toll> = actual0(i,j,k)
     and <e_lav, e_toll> = expected0(i,j,k)
     and roundto(a_lav, 5) = roundto(e_lav, 5)
     and roundto(a_toll, 5) = roundto(e_toll, 5));")
  (osql "count(select expected0(i,j,k) from integer i, integer j,
         integer k);"))
 ((osql "sort(actual1());")
  (osql "sort(expected1());"))
 ((osql "sort(actual2());")
  (osql "sort(expected2());"))
 ((osql "sort(actual3());")
  (osql "sort(expected3());")))

(checkequal "Textual timestamp tslr()"
 ((osql "
set :a = {1, 1, 1, 1};
set :b = tslr(:a);
sleep(0.1);
set :c = roundto(rnow() - :b[2], 3);
:a;")
  (osql "{1, 1, 1, 1};"))
 ((formatl t "[time diff " amos_c "] ") nil)
 ((and (< amos_c 1.0) (>= amos_c 0.1))
  t))

(checkequal "Binary timestamp timestamplrbin()"
 ((osql "
set :abin = realify({1, 1, 1, 1});
set :bbin = timestamplrbin(:abin);
sleep(0.1);
set :cbin = roundto(rnow() - :bbin[2], 3);
na2vec(:abin);")
  (osql "{1.0, 1.0, 1.0, 1.0};"))
 ((formatl t "[time diff " amos_cbin "] ") nil)
 ((and (< amos_cbin 1.0) (>= amos_cbin 0.1))
  t))

(checkequal "L=4, // per xway, distrib main mem dailyexp db. [split|map|merge]"
 ((osql "clear_function('history');
clear_function('expected0');
clear_function('expected1');
clear_function('expected2');
clear_function('expected3');
clear_function('actual0');
clear_function('actual1');
clear_function('actual2');
clear_function('actual3');
clear_function('lroutputbin');
clear_function('abtime');
clear_function('abanswer');
set last_clock() = real(now());
add lroutput() = lrfuse(all, 4)
from vector of stream src, vector of stream proc, stream all
where all = mergestreams(proc)
and proc = mapflex(src, #'lr',
                   make_record({'dump', {'lrhistory-0.dmp', 'lrhistory-1.dmp', 
                                'lrhistory-2.dmp', 'lrhistory-3.dmp'}}))
and src = splitstream(lreadfast(
                getenv('AMOS_HOME') + '/scsq/lr/data/cdp_lite40.out', 4),
                4, #'lrdistrib2');
print({'duration L=4 // = ', duration(last_clock())});
add actual0(v[0], v[1], v[2]) = <v[4], v[5]>
from vector v
where v = lrlogfilter(lroutput(), 0, 0);
add actual1() = lrlogfilter(lroutput(), 1, 0);
add actual2() = {v[0],v[3],v[5]} 
  from vector v
  where v = lrlogfilter(lroutput(), 2, 0);
add actual3() = {v[0],v[1],v[3],v[4]} 
  from vector v
  where v = lrlogfilter(lroutput(), 3, 0);
add expected0(v[0], v[1], v[2]) = <v[4], v[5]>
from vector v
where v in readfile('data/o40-0-expected.out');
create_index('expected0', 'carid', 'hash', 'multiple');
create_index('expected0', 'time', 'hash', 'multiple');
add expected1() = readfile('data/o40-1-expected.out');
add expected2() = {v[0],v[3],v[5]}
  from vector v
  where v in readfile('data/o40-2-expected.out');
add expected3() = {v[0],v[1],v[3],v[4]}
  from vector v
  where v in readfile('data/o40-3-expected.out');
count(select actual0(i,j,k) from integer i, integer j, integer k);")
  (osql "count(select expected0(i,j,k) from integer i, integer j, 
               integer k);"))
 ((osql "count(actual1());") (osql "count(expected1());"))
 ((osql "count(actual2());") (osql "count(expected2());"))
 ((osql "count(actual3());") (osql "count(expected3());")))

(checkequal "full L=4.0 output CONVENTIONAL"
 ((osql "count(
   select a_lav, a_toll
   from integer i, integer j, integer k, 
     real a_lav, real a_toll, real e_lav, real e_toll
   where <a_lav, a_toll> = actual0(i,j,k)
     and <e_lav, e_toll> = expected0(i,j,k)
     and roundto(a_lav, 5) = roundto(e_lav, 5)
     and roundto(a_toll, 5) = roundto(e_toll, 5));")
  (osql "count(select expected0(i,j,k) from integer i, integer j,
         integer k);"))
 ((osql "sort(actual1());")
  (osql "sort(expected1());"))
 ((osql "sort(actual2());")
  (osql "sort(expected2());"))
 ((osql "sort(actual3());")
  (osql "sort(expected3());")))

(checkequal "L=4, BINARY"
 ((osql "clear_function('history');
clear_function('actual0');
clear_function('actual1');
clear_function('actual2');
clear_function('actual3');
clear_function('lroutput');
clear_function('lroutputbin');
clear_function('abtime');
clear_function('abanswer');
writefile('data/cdp_lite40.bin', iarray(vreadfile('data/cdp_lite40.out')));
set last_clock() = real(now());
add lroutputbin() = lrfusebin(all, 4)
from vector of stream src, vector of stream proc, stream of darray all
where all = mergestreams(proc)
and proc = mapflex(src, #'lrbin',
                   make_record({'dump', {'lrhistory-0.dmp', 'lrhistory-1.dmp', 
                                'lrhistory-2.dmp', 'lrhistory-3.dmp'}}))
and src = splitstream(lreadfast(
                getenv('AMOS_HOME') + '/scsq/lr/data/cdp_lite40.bin', 4),
                4, #'lrdistrib2bin');
print({'duration L=4 // = ', duration(last_clock())});
add actual0(integer(v[0]), integer(v[1]), integer(v[2])) = <v[4], v[5]>
from vector of number v
where v = lrbinlogfilter(lroutputbin(), 0, 0);
add actual1() = {integer(v[0]), integer(v[1]), integer(v[3]), integer(v[4])} 
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 1, 0);
add actual2() = {integer(v[0]), integer(v[3]), v[5]}
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 2, 0);
add actual3() = {integer(v[0]), integer(v[1]), integer(v[3]), integer(v[4])} 
  from vector of number v
  where v = lrbinlogfilter(lroutputbin(), 3, 0);
count(select actual0(i,j,k) from integer i, integer j, integer k);")
  (osql "count(select expected0(i,j,k) from integer i, integer j, 
               integer k);"))
 ((osql "count(actual1());") (osql "count(expected1());"))
 ((osql "count(actual2());") (osql "count(expected2());"))
 ((osql "count(actual3());") (osql "count(expected3());")))

(checkequal "full L=4.0 output BINARY"
 ((osql "count(
   select a_lav, a_toll
   from integer i, integer j, integer k, 
     real a_lav, real a_toll, real e_lav, real e_toll
   where <a_lav, a_toll> = actual0(i,j,k)
     and <e_lav, e_toll> = expected0(i,j,k)
     and roundto(a_lav, 5) = roundto(e_lav, 5)
     and roundto(a_toll, 5) = roundto(e_toll, 5));")
  (osql "count(select expected0(i,j,k) from integer i, integer j,
         integer k);"))
 ((osql "sort(actual1());")
  (osql "sort(expected1());"))
 ((osql "sort(actual2());")
  (osql "sort(expected2());"))
 ((osql "sort(actual3());")
  (osql "sort(expected3());")))


