set_current_minute(2);

lisp;

(checkequal "toll alert"
 ((osql "select r[0], r[1], r[2], r[4], r[5]
         from vector r
         where r = toll_calc(62, 5555, 0, 147319, 27, 1, 37, 2);")
             '((0 5555 62 32.0 8))))

