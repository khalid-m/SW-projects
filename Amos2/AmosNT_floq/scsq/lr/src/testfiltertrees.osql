:osql

create function p(charstring input, integer L, integer fanout)->integer as
select count(select v
from sp src, vector of sp dbp, vector of sp tp, vector of sp all, 
vector of stream is, vector of sp proc,
vector v, integer nsub
where nsub = L/fanout
and v = uall(all)
and all = concat({dbp[0]}, proc)
and proc = procs(is, theresolvent('lr'))
and is = lrinputstreams(tp, nsub)
and tp = treenodes(dbp[1], L, fanout, nsub, 'rangefilter')
and dbp = db_partstream(src, fanout, L, 'modfilter')
and src = layer_1_fast({input}, L));

print(real(now()) - lasttime());
set lasttime() = real(now());
lisp; 

(send-form '(quit) (open-nameserver-port))
