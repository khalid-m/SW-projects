/* Functions for storing historical data */

create function history() -> (Integer v, Integer d, Integer x, Integer t) 
  as stored;
create_index("history","v","hash","multiple");

create function add_history(Integer v, Integer d, Integer x, Integer t)
                            -> Boolean 
  as add history()=(v,d,x,t);
 	
create function loadhistory(Stream s) -> Boolean as
select add_history(x[0],x[1],x[2],x[3])
from Vector of Integer x 
where x in s;

/* returns the toll given a specific vid,day and xway*/
create function hist_toll(Integer vid, Integer day, Integer xway) -> Integer 
  as select t 
     from  Integer v, Integer d, Integer x, Integer t 
     where history()=(v,d,x,t) 
       and v=vid 
       and d=day  
       and x=xway;

/* lrollout is used to rollout from an SP */

lisp;
(defun lrolloutbf (fno filename res)
 (resetvar _scsq-id_ nil
  (resetvar _amosid_ nil
   (resetvar _nameserver_ nil
    (resetvar _debugging_ nil
     (resetvar _to-coord-sock_ nil
      (resetvar _prep-listen-sock_ nil
       (resetvar _PORTNAMETBL_ (make-hash-table :test 'equal)
       (osql-result fno filename (rollout filename))))))))))
:osql

create function lrollout(charstring filename)->Boolean
  as foreign 'lrolloutbf';

/* makepdmp makes a history dump from what the SP received */

create function makepdump(stream s, charstring filename)->integer
  as begin
  clear_function("history");
  loadhistory(s);
  lrollout(filename);
  return count(history());
end;

/* makepdmp makes a history dump from a "shard file" of historical data */

create function mkdmp_shardfile(charstring infile, charstring outfile)->Integer
  as begin
  clear_function("history");
  loadhistory(readintstream(infile));
  lrollout(outfile);
  return count(history());
end;  

/* distributed mkhist */

create function dmkhist(integer L, charstring dir)->vector as
select merge(p)
from vector of sp p, vector of charstring shards
where shards = vectorof(
select dir + "/" +
dir(dir, "ht" + stringify(L) + "*"))
and p=spv(vectorof(
  select streamof(
    mkdmp_shardfile(shards[i], dir + "/shdmp" + stringify(L) +
                    "-" + stringify(i) + ".dmp"))
  from integer i where i in iota(0, dim(shards)))); 

create function disthistd(integer L)->charstring as
select exec(cmd)
from charstring cmd, integer i
where cmd = "/usr/bin/rcp /home/zeitler/lrdirhistory/shdmp" + stringify(L) +
            "-" + stringify(i) + ".dmp compute-0-" + stringify(mod(i + 1, 9)) +
            ":/scratch/zeitler/" + stringify(L) + "/bighist" +
            stringify(i + 1) + "d.dmp"
and i in iota(0, 2*L - 1);

create function disthist(integer L)->charstring as
select exec(cmd)
from charstring cmd, integer i
where cmd = "/usr/bin/rcp /home/zeitler/lrhistory/shdmp" + stringify(L) +
            "-" + stringify(i) + ".dmp compute-0-" + stringify(mod(i + 1, 9)) +
            ":/scratch/zeitler/" + stringify(L) + "/bighist" + 
            stringify(i + 1) + ".dmp"
and i in iota(0, L - 1);

