/*set my_jdbc() = jdbc("lrdb", "com.mysql.jdbc.Driver");*/
create function mysql_host()->charstring as select "localhost";
create function mysql_db_name()->charstring as select "regresstest";
create function mysql_user()->charstring as select "regress";
create function mysql_password()->charstring as select "regress";
create function mysql_port()->Number as select
  cast( unstringify( getenv("PORTDB") ) as Integer );


create function init_lr()->vector as
  select sql( my_jdbc(), "TRUNCATE historical_toll;" );

create function my_sql_query(charstring sql)->vector as
  select sql( my_jdbc(), sql );
/*
connect(my_jdbc(), "jdbc:mysql://" + mysql_host() + ":" + mysql_port() + "/"
+ mysql_db_name(), mysql_user(), mysql_password());
