lisp;
(checkequal "Read_file"
  ((osql "count(stream_to_vector(lreadfast(getenv('AMOS_HOME') + '/scsq/lr/dexp/data/test.txt',1)));")
   '((6))))

(checkequal "Run Single Node count"
  ((osql "count(callLR0(stream_to_vector(lreadfast(getenv('AMOS_HOME') + '/scsq/lr/dexp/data/test.txt',1))));")
   '((6))))

(checkequal "Run Single Node"
  ((osql "callLR0(stream_to_vector(lreadfast(getenv('AMOS_HOME') + '/scsq/lr/dexp/data/test.txt',1)));")
   '((#(3 17 0 5 10.0)) (#(3 19 0 5 10.0)) (#(3 23 0 5 10.0)) (#(3 28 0 5 10.0)) 
     (#(3 32 0 5 10.0)) (#(3 33 0 5 10.0)))))

(checkequal "splitstream"
((osql "in(zipstreams(splitstream(siota(1, 12), 2,#'integer.integer.oddeven->integer', #'f')));")
	'((#(2 1)) (#(4 3)) (#(6 5)) (#(8 7)) (#(10 9)) (#(12 11)))))

(checkequal "splitstream_file count"
((osql "count(in(zipstreams(splitstream(lreadfast(getenv('AMOS_HOME') + '/scsq/lr/dexp/data/test.txt',1), 2, #'dexpmodpartition'))));")
	'((3))))

(checkequal "splitstream_file iarray count"
((osql "count(in(zipstreams(splitstream(lreadfastbin(getenv('AMOS_HOME') + '/scsq/lr/dexp/data/binarytest.bin'), 2, #'idexpmodpartition'))));")
        '((3))))

(checkequal "splitstream_file"
((osql "in(zipstreams(splitstream(lreadfast(getenv('AMOS_HOME') + '/scsq/lr/dexp/data/test.txt',1), 2, #'dexpmodpartition')));")
	'((#(#(3 19 1 -1 0 -1 -1 -1 -1 5 -1 -1 -1 -1 10) #(3 17 1 -1 1 -1 -1 -1 -1 5 -1 -1 -1 -1 10))) 
	  (#(#(3 23 1 -1 0 -1 -1 -1 -1 5 -1 -1 -1 -1 10) #(3 28 1 -1 1 -1 -1 -1 -1 5 -1 -1 -1 -1 10)))
	  (#(#(3 32 1 -1 0 -1 -1 -1 -1 5 -1 -1 -1 -1 10) #(3 33 1 -1 1 -1 -1 -1 -1 5 -1 -1 -1 -1 10))))))




