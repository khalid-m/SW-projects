/* Set the dumpfile to be loaded by the SP */

set dumpfile() = 'lr.dmp';

create function lrdatadir() -> charstring;
set lrdatadir() = getenv("HOME") + '/data/lr';

create function lroutputfiles()->charstring;
set lroutputfiles() = '/scratch/erikz/lroutput/c';
