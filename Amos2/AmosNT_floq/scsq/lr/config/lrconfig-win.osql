/* Set the dumpfile to be loaded by the SP */

create function lrdumpfiledir() -> Charstring;
set lrdumpfiledir() = getenv("AMOS_HOME") + 'scsq/lr/';
set dumpfile() = 'lr.dmp';

create function lrdatadir() -> charstring;
set lrdatadir() = '/data/lr';
