clear_function("tresult");

add tresult("exp") = scale_exp(100, 4, 5);
add tresult("fsplit") = scale_fsplit(100, 4, 5);
add tresult("max") = scale_max(100, 4, 5);
add tresult("tosno") = scale_tos(100, 4, 5, #'tosno');
add tresult("tos") = scale_tos(100, 4, 5, #'tos');

write_ntuples(report(), "scaleupreport_100_" + timestamp());

sleep(2);

clear_function("tresult");
select c, tresult(c) from charstring c;

add tresult("exp") = robust_exp(100, 3);
add tresult("fsplit") = robust_fsplit(100, 3);
add tresult("max") = robust_max(100, 3);
add tresult("tosno") = robust_tos(100, 3, #'tosno');
add tresult("tos") = robust_tos(100, 3, #'tos');

write_ntuples(report(), "robustness_8_" + timestamp());

sleep(2);

q();
