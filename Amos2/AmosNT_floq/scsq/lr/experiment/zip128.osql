/* run experiments. Add results to results table. write results to file */

add ub_zip_res(w) = ub_zip(w,50) from integer w
where w in {128};
write_ntuples(
(select concat({w}, ub_zip_res(w)) from integer w),
"ub_zip_" + timestamp());

add ub_zipma_res(w, masize) = ub_zipma(w,50,masize) from integer w, integer masize
where w in {128} and masize in {1,2,4,8,16};
write_ntuples(
(select concat({w, m}, ub_zipma_res(w, m)) from integer w, integer m),
"ub_zipma_" + timestamp());

add ub_zipmap_res(w) = ub_zipmap(w,50) from integer w
where w in {128};
write_ntuples(
(select concat({w}, ub_zipmap_res(w)) from integer w),
"ub_zipmap_" + timestamp());

add ub_zipmapma_res(w,masize) = ub_zipmapma(w,50,masize) from integer w, integer masize
where w in {128} and masize in {1,2,4,8,16};
write_ntuples(
(select concat({w,m}, ub_zipmapma_res(w,m)) from integer w, integer m),
"ub_zipmapma_" + timestamp());

q();
