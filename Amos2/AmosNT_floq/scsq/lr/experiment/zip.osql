add ub_zipmapmatree_res(w, 16, integer(sqrt(w))) = 
ub_zipmapmatree(w, 1, 16, integer(sqrt(w)))
from integer w
where w in {1024};

write_ntuples(
(select concat({i,j,k}, ub_zipmapmatree_res(i,j,k))
from integer i, integer j, integer k),
"tree_ma_zip_" + timestamp());

q();
