 ((osql "count(experiment());")
  '((1))))

(checkequal "proctimedir string"
((osql "
set tbasedir() = '/scratch/erikz/e/' + stringify(experiment()) + '/times';
set pbasedir() = '/scratch/erikz/e/' + stringify(experiment()) + '/proctime';
count(pbasedir());")
'((1))))

(checkequal "existence of proctimedir + subdirs"
((osql "count(dir(pbasedir()));")
'((6))))

(checkequal "Input streams"
 ((osql "count(in(i_hybrid(64, 5, 1)));")
  '((1000)))
 ((osql "count(in(i_hybrid(64, 5, 2)));")
  '((2000)))
((osql "
select
count(select v from iarray v where v in i_hybrid(64, i, 1) and v[0] = 0),
count(select v from iarray v where v in i_hybrid(64, i, 1) and v[0] = 2)
from integer i where i in {0,5,10,50,100,500,1000};")
'((1000 0) (995 5) (990 10) (950 50) (900 100) (500 500) (0 1000))))

(checkequal "qdsplit counts"
((osql "
select in(zipstreams(mapstreams(s, #'stream.scount->stream')))
from vector of stream of iarray s 
where s = splitstream(i_hybrid(64, 100, 1), 2, #'qdsplit');") 
'((#(900 100)))))
