;"
:osql

create function setuptime(vector of vector of number x, real inittime)->real as
maxagg(select y[0] from vector of number y where y in x) - inittime;

create function exectime(vector of vector of number x)->real as
maxagg(select y[2] from vector of number y where y in x);

create function countsum(vector of vector of number x)->integer as
sum(select y[3] from vector of number y where y in x);

writefile(tbasedir() + "/all.tms",
(select {experiment, width, times, fov}
from integer experiment, integer width, vector of vector of number times,      
vector fov, real stime
where <width, times, fov, stime> in tresult(experiment)
and experiment in iota(1, 32)
and width in iota(0, 1000)));

writefile(tbasedir() + "/setup.tms",
(select {experiment, width, time}
from integer experiment, integer width, real time, vector fov, 
vector of vector of number times, real stime
where <width, times, fov, stime> in tresult(experiment)
and experiment in iota(1, 32)
and width in iota(0, 1000)
and time = setuptime(times, stime)));

writefile(tbasedir() + "/bcast.tms",
(select {experiment, width, time, counts}
from integer experiment, integer width, real time, vector fov, 
vector of vector of number times, integer counts, real stime
where <width, times, fov, stime> in tresult(experiment)
and experiment in iota(11, 17)
and width in iota(0, 1000)
and time = exectime(times)
and counts = countsum(times)));

writefile(tbasedir() + "/fanout.tms",
(select {experiment, width, time, counts}
from integer experiment, integer width, real time, vector fov,
vector of vector of number times, integer counts, real stime
where <width, times, fov, stime> in tresult(experiment)
and experiment in iota(21, 27)
and width in iota(1, 256)
and time = exectime(times)
and counts = countsum(times)));

dumpinst(tbasedir() + "/commtrees"); 
