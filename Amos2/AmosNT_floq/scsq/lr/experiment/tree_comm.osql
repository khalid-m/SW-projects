/* This is obsoleted by qss.osql and qssbig.osql */

< "experiment/tree_comm_setup.osql";

declare integer :exp;

sp_ts(1);
sp_ts_freq(0.1);
sp_report_freq(10.0);

sp_flush_freq(0.02);

sp_imgsize(100000000);
sp_proctime_freq(1.0);
lisp;
;"

