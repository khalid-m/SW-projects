(checkequal "FSPLIT bcast" ((osql "set :exp = experiment();
set experimentdir() = pbasedir() + '/bc/flat';
add tresult(11) = flat_bc(2000, :exp);") nil))

(checkequal "TWOMAX bcast" ((osql "set :exp = experiment();
set experimentdir() = pbasedir() + '/bc/twomax';
add tresult(12) = twomax_bc(2000, :exp);") nil))

(checkequal "BIN bcast" ((osql "set :exp = experiment();
set experimentdir() = pbasedir() + '/bc/bin';
add tresult(13) = bin_bc(2000, :exp);") nil))

(checkequal "EXP bcast" ((osql "set :exp = experiment();
