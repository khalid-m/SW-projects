/* Regular TOS experiments are defined in dasfaa10_scaleup.osql.
   TOS of multiarrays are defined in src/ub_psplit.osql.
   This file is obsoleted. */


/* Input stream from file */

create function mt_is(vector of charstring infiles, integer inl, integer mult,
                      integer rrfo) -> vector as
select in(zipstreams(pmerge))
from vector of stream pmerge, vector of stream of numarray rr,
vector of stream fsplit, stream src, integer fo
where pmerge = mapstreams(vectorof(
  select smjstreamsna(vectorize(
    select j, fsplit[i + j*fo]
    from integer j
    where j in iota(0, rrfo - 1)), 1)
  from integer i
  where i in iota(0, fo - 1)), #'stcount')
and fsplit = unpacksplitras(rr, fo, #'lrprfn', #'q2bfn', {0, 1}, 15)
and rr = splitstream(src, rrfo, #'randr', #'f')
and src = ostream(newsp(streamof(clrmultiply(in(lreadfastbins(infiles)),
                                             inl, mult))), 0)
and fo = inl*mult;


/* LR working nodes (mapstream over result from mtos)  */
