/* run experiments. Add results to results table. write results to file */

add ub_zipmapmatree_res(512,16,1) = ub_zipmapmatree(512, 3, 16, 1);
add ub_zipmapmatree_res(512,16,2) = ub_zipmapmatree(512, 3, 16, 2);
add ub_zipmapmatree_res(512,16,4) = ub_zipmapmatree(512, 3, 16, 4);
add ub_zipmapmatree_res(512,16,8) = ub_zipmapmatree(512, 3, 16, 8);
add ub_zipmapmatree_res(512,16,16) = ub_zipmapmatree(512, 3, 16, 16);
add ub_zipmapmatree_res(512,16,22) = ub_zipmapmatree(512, 3, 16, 22);
add ub_zipmapmatree_res(512,16,23) = ub_zipmapmatree(512, 3, 16, 23);
add ub_zipmapmatree_res(512,16,32) = ub_zipmapmatree(512, 3, 16, 32);
add ub_zipmapmatree_res(512,16,64) = ub_zipmapmatree(512, 3, 16, 64);
add ub_zipmapmatree_res(512,16,128) = ub_zipmapmatree(512, 3, 16, 128);
add ub_zipmapmatree_res(512,16,256) = ub_zipmapmatree(512, 3, 16, 256);
add ub_zipmapmatree_res(512,16,512) = ub_zipmapmatree(512, 3, 16, 512);

write_ntuples(
(select concat({w,m,f}, ub_zipmapmatree_res(w,m,f)) from integer w, integer m, integer f),
"ub_tree_" + timestamp());

q();
