(checkequal "LRbin timestamps"
((osql "set :vend = 
in(select na2vec(v) from darray v where v = extract(newspflex(
section(streamof(readfile(
        '/scratch/erikz/lroutput/c10rtest-ib-2-0')), 981, 981),
