make_record({'hostname', 'gr49.uppmax.uu.se'}))));

:vstart[1];")
'((1.0)))
((osql ":vend[1];")
'((316.0)))
((progn
  (osql "
set :now_end = rnow() - :vend[2];
set :end_start = :vend[2] - :vstart[2];")
  (formatl t "[now_end " (roundto amos_now_end 3)
             "] [end_start " (roundto amos_end_start 3) "]" t)
    (and (< amos_now_end 10.0) (> amos_now_end 0.0))) t)
((and (< amos_end_start 3.5) (> amos_end_start 0.0)) t))

