 ((osql "count(experiment());") '((1)))
 ((directoryp (caar (osql "tbasedir();"))) t))

(osql "proctime_dir(pbasedir());")

;; FE: sp_imagesize() satte upp imagen till nåt stort i början så att vi inte
;; drabbades av pekarfel när imagen expanderade under körning.
;; Felet är *nog* åtgärdat nu, så du behöver *nog* inte sätta upp imagen 
;; såhär längre.

(osql "sp_imgsize(100000000);")

;; dessa är inte så intressanta längre. Du behöver nog inte sätta upp enligt
;; dessa om du stänger av tidsstämpling med sp_ts(0).

(osql "delay_file(tbasedir() + '/ret');")
(osql "sp_report_freq(11.0);")

