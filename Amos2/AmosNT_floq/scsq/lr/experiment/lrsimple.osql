;; FE: sp_ts(1) ställer på tidsstämplandet. 
;; (osql "sp_ts(1);")
;; sp_ts_freq(37.5): genererar en tidsstämpel var 37.5:e sekund i avsändande
;; process (input i dlrnomysepib)
;; (osql "sp_ts_freq(37.5);")
;; sp_report_freq(43.0): var 43:e sekund rapporterar mottagande processer till
;; koordinatorn
;; (osql "sp_report_freq(43.0);")

;; FE: Jag rekommenderar att du stänger av tidsstämplandet helt och hållet.
;; Detta görs med sp_ts(0);

;; FE: I DASFAA'10 jämfördes 64 exp RT med 64 flat RT.
;; FE: Den intressanta är 64 exp RT.

;; (checkequal "64 exp RT"
;;  ((osql "reset_ipr();
;;   count(dlrnomysepib(lreadbins(lrinputfiles(64)),
;;                    {2, 4, 8}, 64, 'exp-a-'));")
