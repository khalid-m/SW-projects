/*-*-sql-*-*******************************************************************/

logging off;
create function tbasedir()->charstring;
create function pbasedir()->charstring;
create function lroutputbin()->numarray;
create function last_clock()->real;
create function clocks(integer)->real;
create function lresult(integer L) -> <vector fov, real stime, real rtime>;
create_index("lresult", "L", "hash", "multiple");
create function lrinputfiles(integer num)->vector of charstring;

set lrinputfiles(10) = {'/home/erikz/binbench/c10-200k.bin'};
set lrinputfiles(64) = {'/scratch/erikz/c64-0', '/scratch/erikz/c64-1',
'/scratch/erikz/c64-2', '/scratch/erikz/c64-3'};
set lrinputfiles(52) = {'/scratch/erikz/c52-0', '/scratch/erikz/c52-1',
'/scratch/erikz/c52-2'};

create function hyb(stream of iarray s, integer fo)
-> vector of stream of iarray as select preproc
from vector of stream of iarray pre,
vector of stream of iarray sposrep,
vector of stream of iarray squeries,
vector of stream of iarray preproc
where preproc = vselect mergestreams({sposrep[i], squeries[i]}) from integer i
and sposrep = hpartstreamv(pre[0], #'lrproute', fo, {fo}, 0)
and squeries = hpartstreamv(pre[1], #'bcast', fo, expv(fo), 0)
and pre = splitstream(s, 2, #'qdsplit');

create function dlrnomysephyb(stream inputstream, vector of integer fo,
                              integer L, charstring descr) -> object as
select in(mergestreams({t2, t1, t0}))
from stream of iarray input, charstring ofname,
vector of stream proc, vector of stream postproc,
stream t0, stream t1, stream t2
where t2 = ostream(newspflex(streamof(writefiles(ofname + "-ib-2-", 10000000,
  dtslrbin(lrf0(in(zipstreams(vectorize(select i, postproc[i*3 + 2]
  from integer i where i in iota(0, dim(postproc)/3)))))))),
  make_record({'hostname', 'gr49.uppmax.uu.se'})), 0)
and t1 = ostream(newspflex(streamof(writefiles(ofname + "-ib-1-", 10000000,
  dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3 + 1]
  from integer i where i in iota(0, dim(postproc)/3))))))),
  make_record({'hostname', 'gr54.uppmax.uu.se'})), 0)
and t0 = ostream(newspflex(streamof(writefiles(ofname + "-ib-0-", 10000000,
  dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3]
  from integer i where i in iota(0, dim(postproc)/3))))))),
  make_record({'hostname', 'gr55.uppmax.uu.se'})), 0)
and postproc = splitstreams(proc, 3, #'oesplit')
and proc = mapstreams(hyb(input, L), #'lrbin')
and input = ostream(newspflex(inputstream,
make_record({'hostname', 'gr41.uppmax.uu.se'})), 0)
and ofname = lroutputfiles() + stringify(L) + descr;

/* FE: Det är dlrnomysepib som gäller */

create function dlrnomysepib(stream inputstream, vector of integer fo,
                             integer L, charstring descr) -> object as
select in(mergestreams({t2, t1, t0}))
from stream of iarray input, charstring ofname,
vector of stream xp, vector of stream proc, vector of stream postproc,
stream t0, stream t1, stream t2
where t2 = ostream(newspflex(streamof(writefiles(ofname + "-ib-2-", 10000000,
  dtslrbin(lrf0(in(zipstreams(vectorize(select i, postproc[i*3 + 2]
  from integer i where i in iota(0, dim(postproc)/3)))))))),
  make_record({'hostname', 'gr49.uppmax.uu.se'})), 0)
and t1 = ostream(newspflex(streamof(writefiles(ofname + "-ib-1-", 10000000,
  dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3 + 1]
  from integer i where i in iota(0, dim(postproc)/3))))))),
  make_record({'hostname', 'gr54.uppmax.uu.se'})), 0)
and t0 = ostream(newspflex(streamof(writefiles(ofname + "-ib-0-", 10000000,
  dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3]
  from integer i where i in iota(0, dim(postproc)/3))))))),
  make_record({'hostname', 'gr55.uppmax.uu.se'})), 0)
and postproc = splitstreams(proc, 3, #'oesplit')
and proc = mapstreams(xp, #'lrbin')
and xp = hpartstreamv(input, #'lrproute', L, fo, 0)
and input = ostream(newspflex(inputstream,
make_record({'hostname', 'gr41.uppmax.uu.se'})), 0)
and ofname = lroutputfiles() + stringify(L) + descr;

create function dlrnomysepob(stream inputstream, vector of integer fo_r, 
            vector of integer fo_bc, integer L, charstring descr) -> object as
select in(mergestreams({t0, t1, t2}))
from stream of iarray input, charstring ofname,
vector of stream of iarray s,
vector of stream of iarray sposrep,
vector of stream of iarray squeries,
vector of stream proc,
vector of stream postproc,
stream t0, stream t1, stream t2
where t2 = ostream(newspflex(streamof(writefiles(ofname + "-ob-2-", 10000000,
  dtslrbin(lrf0(in(zipstreams(vectorize(select i, postproc[i*3 + 2]
  from integer i where i in iota(0, dim(postproc)/3)))))))),
  make_record({'hostname', 'gr49.uppmax.uu.se'})), 0)
and t1 = ostream(newspflex(streamof(writefiles(ofname + "-ob-1-", 10000000,
  dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3 + 1]
  from integer i where i in iota(0, dim(postproc)/3))))))),
  make_record({'hostname', 'gr54.uppmax.uu.se'})), 0)
and t0 = ostream(newspflex(streamof(writefiles(ofname + "-ob-0-", 10000000,
  dtslrbin(in_d(mergestreams(vectorize(select i, postproc[i*3]
  from integer i where i in iota(0, dim(postproc)/3))))))),
  make_record({'hostname', 'gr55.uppmax.uu.se'})), 0)
and postproc = splitstreams(proc, 3, #'oesplit')
and proc = mapstreams(
  (vselect mergestreams({sposrep[i], squeries[i]}) from integer i),
  #'lrbin')
and sposrep = hpartstreamv(s[0], #'lrproute', L, fo_r, 0)
and squeries = hpartstreamv(s[1], #'bcast', L, fo_bc, 0)
and s = splitstream(input, 2, #'qdsplit')
and input = ostream(newspflex(inputstream,
make_record({'hostname', 'gr41.uppmax.uu.se'})), 0)
and ofname = lroutputfiles() + stringify(L) + descr;

create function dlrnomysepsamp(stream inputstream, vector of integer fo,
                               integer L, integer samprate, charstring descr)
-> object as select in(mergestreams({t2, t1, t0}))
from stream of iarray input, charstring ofname,
vector of stream xp, vector of stream proc, vector of stream postproc,
stream t0, stream t1, stream t2
where t2 = ostream(newspflex(streamof(writefiles(ofname + "-2-", 10000000,
  dtslrbin(winagg(lrf0(in(zipstreams(vectorize(select i, postproc[i*3 + 2]
  from integer i where i in iota(0, dim(postproc)/3))))), 1, samprate)[0]))),
  make_record({'hostname', 'gr49.uppmax.uu.se'})), 0)
and t1 = ostream(newspflex(streamof(writefiles(ofname + "-1-", 10000000,
  dtslrbin(winagg(in_d(mergestreams(vectorize(select i, postproc[i*3 + 1]
  from integer i where i in iota(0, dim(postproc)/3)))), 1, samprate)[0]))),
  make_record({'hostname', 'gr54.uppmax.uu.se'})), 0)
and t0 = ostream(newspflex(streamof(writefiles(ofname + "-0-", 10000000,
  dtslrbin(winagg(in_d(mergestreams(vectorize(select i, postproc[i*3]
  from integer i where i in iota(0, dim(postproc)/3)))), 1, samprate)[0]))),
  make_record({'hostname', 'gr55.uppmax.uu.se'})), 0)
and postproc = splitstreams(proc, 3, #'oesplit')
and proc = mapstreams(xp, #'lrbin')
and xp = hpartstreamv(input, #'lrproute', L, fo, 0)
and input = ostream(newspflex(inputstream,
make_record({'hostname', 'gr41.uppmax.uu.se'})), 0)
and ofname = lroutputfiles() + stringify(L) + descr;

create function dlrnomy(vector of integer fo, integer L)
-> <vector, real, real> as
select fo, rt, st
from real rt, real st
where <rt, st> = writefiles("/scratch/erikz/c" + stringify(L) + ".out", 
10000000,
(select dtslrbin(in_d(mergestreams(concat({abagg}, alla))))
from stream of iarray input,
vector of stream xp, vector of stream proc, vector of stream postproc,
vector of stream alla, stream abagg
where abagg = ostream(newsp(lrf(zipstreams(vectorize(select i, postproc[i*2+1]
  from integer i where i in iota(0, dim(postproc)/2))))), 0)
and alla = vectorize(select i, postproc[i*2]
  from integer i where i in iota(0, dim(postproc)/2))
and postproc = splitstreams(proc, 2, #'accbalsplit')
and proc = mapstreams(xp, #'lrbin')
and xp = hpartstreamv(input, #'lrproute', L, fo, 0)
and input = ostream(newspflex(lreadfast(lrinputfiles(L), L),
make_record({'hostname', 'gr41.uppmax.uu.se'})), 0)));

lisp;
(imagesize 150000000)
;"


