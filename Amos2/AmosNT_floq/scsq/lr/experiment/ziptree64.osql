/* run experiments. Add results to results table. write results to file */

add ub_zipmapmatree_res(64,16,1) = ub_zipmapmatree(64, 100, 16, 1);
add ub_zipmapmatree_res(64,16,2) = ub_zipmapmatree(64, 100, 16, 2);
add ub_zipmapmatree_res(64,16,4) = ub_zipmapmatree(64, 100, 16, 4);
add ub_zipmapmatree_res(64,16,8) = ub_zipmapmatree(64, 100, 16, 8);
add ub_zipmapmatree_res(64,16,16) = ub_zipmapmatree(64, 100, 16, 16);
add ub_zipmapmatree_res(64,16,32) = ub_zipmapmatree(64, 100, 16, 32);
add ub_zipmapmatree_res(64,16,64) = ub_zipmapmatree(64, 100, 16, 64);

write_ntuples(
(select concat({w,m,f}, ub_zipmapmatree_res(w,m,f)) from integer w, integer m, integer f),
"ub_tree_" + timestamp());

q();
