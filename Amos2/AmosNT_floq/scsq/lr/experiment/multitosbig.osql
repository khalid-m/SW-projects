< "experiment/dasfaa10_scaleup.osql";
< "experiment/tos.osql";

/* scale_mtos(rep, minexp, maxexp, bc, msz, rrfo, tosfn) */

add tosresult("multitos") = scale_mtos(1000, 6, 6, 5, 10, 16, #'multitos');
add tosresult("multitos") = scale_mtos(1000, 6, 6, 5, 20, 16, #'multitos');
add tosresult("multitos") = scale_mtos(1000, 6, 6, 5, 16, 16, #'multitos');

/*
add tosresult("multitno") = scale_mtos(1000, 6, 6, 5, 16, 16, #'multitosno');
*/

write_ntuples(tosreport(), "mt_scaleup_big_" + timestamp());

sleep(2);

clear_function("tosresult");
select c, tresult(c) from charstring c;

/* robust_mtos(rep, exp, minbc, maxbc, msz, rrfo, tosfn) */

/*
add tosresult("multitos") = robust_mtos(1000, 6, 0, 100, 16, 16, #'multitos');
add tosresult("multi_no") = robust_mtos(1000, 6, 0, 100, 16, 16, #'multitosno');
write_ntuples(tosreport(), "mt_robustness_big_" + timestamp());
*/

sleep(2);

q();
