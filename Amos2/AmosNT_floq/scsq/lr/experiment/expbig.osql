clear_function("tresult");

add tresult("exp") = scale_exp(1000, 8, 5);
add tresult("fsplit") = scale_fsplit(1000, 8, 5);
add tresult("max") = scale_max(1000, 8, 5);
add tresult("tosno") = scale_tos(1000, 8, 5, #'tosno');
add tresult("tos") = scale_tos(1000, 8, 5, #'tos');

write_ntuples(report(), "scaleupreport_1000_" + timestamp());

sleep(2);

clear_function("tresult");
select c, tresult(c) from charstring c;

add tresult("exp") = robust_exp(1000, 6);
add tresult("fsplit") = robust_fsplit(1000, 6);
add tresult("max") = robust_max(1000, 6);
add tresult("tosno") = robust_tos(1000, 6, #'tosno');
add tresult("tos") = robust_tos(1000, 6, #'tos');

write_ntuples(report(), "robustness_64_" + timestamp());

sleep(2);

q();
