< "experiment/dasfaa10_scaleup.osql";

/* < "experiment/tos.osql"; */

/* scale_mtos(rep, minexp, maxexp, bc, msz, rrfo, tosfn) */
add tosresult("multitos") = scale_mtos(100, 1, 2, 5, 10, 2, #'multitos', 2);

add tosresult("multi_no") = scale_mtos(100, 1, 3, 5, 10, 2, #'multitosno', 2);

write_ntuples(tosreport(), "mt_scaleup_100_" + timestamp());

sleep(2);

clear_function("tosresult");
select c, tresult(c) from charstring c;

/* robust_mtos(rep, exp, minbc, maxbc, msz, rrfo, tosfn) */
add tosresult("multitos") =
robust_mtos(100, 2, 0, 1000, 10, 2, #'multitos', 2);

add tosresult("multi_no") = 
robust_mtos(100, 2, 0, 1000, 10, 2, #'multitosno', 2);

write_ntuples(tosreport(), "mt_robustness_4_" + timestamp());

sleep(2);

q();
