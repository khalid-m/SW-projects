create function posrepcount(Integer vid) -> Integer;
create function first_seen(Integer vid) -> Integer;
create function last_seen(Integer vid) -> Integer;

create function clearstat() -> Integer as begin
clear_function("posrepcount");
clear_function("first_seen");
clear_function("last_seen");
end;

create function increase_posrepcount(Integer vid) -> Boolean as begin
  if notany(posrepcount(vid)) then
    set posrepcount(vid) = 1
  else
    set posrepcount(vid) = posrepcount(vid) + 1;
end;

create function addstat0(Vector of Integer rep) -> Boolean as begin
  set first_seen(vid(rep)) = second(rep) where count(first_seen(vid(rep))) < 1;
  set last_seen(vid(rep)) = second(rep);
  increase_posrepcount(vid(rep));
  result(TRUE);
end;

create function addstat(Vector of Integer rep) -> Boolean as begin
  if posrep(rep) then
  result(addstat0(rep));
end;

create function statread(Vector of Charstring filenames) -> Vector of Integer
as readfiles(filenames);

create function distinct_diffs() -> Integer as
select distinct diff
from integer i, integer diff
where diff = 30 + last_seen(i) - first_seen(i) - 30*posrepcount(i)
and diff != 0;

select diff, i
from integer i, integer diff
where diff = 30 + last_seen(i) - first_seen(i) - 30*posrepcount(i)
and diff = -1049;

create function num_vids() -> Integer as
count(
select i
from integer i, integer cnt
where cnt = posrepcount(i));

create function num_aliased_vids() -> Integer as
count(select
from integer i, integer diff
where diff = 30 + last_seen(i) - first_seen(i) - 30*posrepcount(i)
and diff > 0);

create function num_posreps() -> Integer as
sum(select posrepcount(i) from integer i);

