create function vids_out(integer vid)->integer leavetime;

create_index("vids_out", "leavetime", "mbtree", "multiple");

create function vidsoutres() -> function;
set vidsoutres() = theresolvent("vids_out");

create function nvidsout()->integer as 
count(select vids_out(v) from integer v);

create function vidalias(integer old)->integer new;

create function nvidalias()->integer as
count(select vidalias(o) from integer o);

create function oldest_vid_out()->integer as
select minagg(select s from integer s, integer v where s = vids_out(v));

create function vids_left_at_sec(integer s)->integer as
select vid from integer vid
where s = vids_out(vid);

create function add_vidalias(vector v)->boolean as begin
declare integer secout, integer vidout;
set secout = oldest_vid_out();
if (second(v) > secout) then begin
  set vidout = first(vids_left_at_sec(secout));
  set vidalias(vid(v)) = vidout;
  remove vids_out(vidout) = secout;
end;
end;

/* Note to self: 
   Vi har upptäckt en til parameter som vi vill tune:a:
   Hur lång tid ska det typiskt ta mellan återbesöken?

   TODO: Byt ut oldest_vid_out() mot en som varit ute minst 60 sek plus ev. en slumpterm
*/

create function add_vidalias_prob(vector v, integer migr_perc)->boolean as begin
declare integer secout, integer vidout;
set secout = oldest_vid_out();
if ((second(v) > secout) and
   (migr_perc > rand(100))) then begin
  set vidout = first(vids_left_at_sec(secout));
  set vidalias(vid(v)) = vidout;
end;
remove vids_out(vidout) = secout;
end;

create function is_vid_aliased(integer vidfrom)->boolean as
select
from integer tovid
where tovid = vidalias(vidfrom);

create function alias(vector v)->vector as
select concat({v[0], v[1], vidalias(vid(v))}, w)
from vector w
where w = vectorof(
select v[i] from integer i where i > 2);

create function vids_out_before(integer sec)->boolean as
some(select
from integer vid
where vids_out(vid) < sec);

create function on_onramp(vector v)->boolean as
select
where lane(v) = 0
and posrep(v);

create function stands_onramp()->integer;

create function not_seen_before(vector v)->boolean as
select
where notany(select where stands_onramp() = vid(v)); 

create function on_the_road(vector v)->boolean as
select
where lane(v) > 0
and posrep(v);

create function just_entered(vector v)->boolean as
select
where lane(v) = 0
and posrep(v);

create function just_left(vector v)->boolean as
select
where lane(v) = 4
and posrep(v);

create function traceenterleave(Vector v, Integer min_time_outside)
 -> vector of Integer as
begin
if (just_left(v)) then
  if (is_vid_aliased(vid(v))) then
    set vids_out(vidalias(vid(v))) = second(v)
  else
    set vids_out(vid(v)) = second(v);
if (on_onramp(v) and not_seen_before(v)
    and (vids_out_before(integer(second(v) - min_time_outside)))) then
  add_vidalias(v);
if (on_onramp(v)) then add stands_onramp() = vid(v);
if (on_the_road(v)) then remove stands_onramp() = vid(v);
if (is_vid_aliased(vid(v))) then return alias(v) else return v;
end;

/* Conditional on size of reservoir */

create function cond_add_vids_out(Integer vid, Integer second, Integer res_size)
 -> Integer as
set vids_out(vid) = second
where function_cardinality(vidsoutres()) < res_size;

create function traceenterleave_res(Vector v, Integer min_time_outside, 
Integer res_size, Integer migr_perc) -> vector of Integer as
begin
if (just_left(v)) then
  if (is_vid_aliased(vid(v))) then
    cond_add_vids_out(vidalias(vid(v)), second(v), res_size)
  else
    cond_add_vids_out(vid(v), second(v), res_size);
if (on_onramp(v) 
    and not_seen_before(v)
    and (vids_out_before(integer(second(v) - min_time_outside)))) then
  add_vidalias_prob(v, migr_perc);
if (on_onramp(v)) then add stands_onramp() = vid(v);
if (on_the_road(v)) then remove stands_onramp() = vid(v);
if (is_vid_aliased(vid(v))) then return alias(v) else return v;
end;


/* Top level functions */

create function smjv(vector of sp spv, integer attrib) -> vector as
select v from vector v where v = smj(spv, attrib);

create function smjsv(vector of sp spv, integer attrib) -> stream of vector as
select streamof(smjv(spv, attrib));

create function all(integer nxways, integer time_out, vector of sp inp)
-> vector of integer as select v
from vector v
where v = traceenterleave(smjv(inp, 1), time_out);

create function all_limit(Integer nxways, Integer time_out, Integer res_size, 
Integer migr_perc, Vector of Sp inp)
-> Vector of Integer as select v
from Vector v
where v = traceenterleave_res(smjv(inp, 1), time_out, res_size, migr_perc);

create function initgen()->boolean as
/* clear all state before start */
begin
  clear_function("vids_out");
  clear_function("vidalias");
  clear_function("stands_onramp");
  return asserteq(nvidalias(), 0, "Failed to clear alias table")
    and 
    asserteq(nvidsout(), 0, "Failed to clear vids_out table")
    and
    asserteq(count(stands_onramp()), 0, "Failed to clear stands_onramp table");
end;
