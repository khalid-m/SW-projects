/* maxvid and maxqid: The maximum vid and qid for one single xway */

set maxvid() = 140000;
set maxqid() = 125000;

/* Location of full input files */
set inputfilesdir() = 'd:/ezgen/';
set inputfilesmask() = 'cdp';
