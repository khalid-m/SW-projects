lisp;

(checkequal "tuple window."
            ((flatten (swinbag-in (osql "in(w_tuple(vstreamfile('data/lr32'), 5, 1, 1));")))
             (let ((data (mapcar (f/l (x) (car x)) (osql "readfile('data/lr32');"))))
               (nconc (sublist data 10 5)
                      (sublist data 27 5)
                      (sublist data 28 5)
                      (sublist data 29 5)
                      (sublist data 30 5)
                      (sublist data 31 5)
                      (sublist data 32 5)))))

(checkequal "time window."
            ((flatten (swinbag-in (osql "in(w_time(vstreamfile('data/lr32'), 5, 1, 1));")))             
             (let ((data (mapcar (f/l (x) (car x)) (osql "readfile('data/lr32');"))))
               (nconc (sublst data 0 15)
                      (sublst data 0 32)
                      (sublst data 0 33)
                      (sublst data 0 34)
                      (sublst data 0 35)
                      (sublst data 15 36)
                      (sublst data 32 37))))
            ((flatten (swinbag-in (osql "in(w_time(vstreamfile('data/lr32'), 5, 5, 1));")))
             (let ((data (mapcar (f/l (x) (car x)) (osql "readfile('data/lr32');"))))
               (nconc (sublst data 0 15)
                      (sublst data 0 32)
                      (sublst data 0 33)
                      (sublst data 0 34)
                      (sublst data 0 35)
                      (sublst data 35 36)
                      (sublst data 35 37)))))

(checkequal "partition window."
            ((flatten (swinbag-in (osql "in(w_partition(vstreamfile('data/lr_partition'), {3}, 5, 1, 1));")))
             (let ((data (mapcar (f/l (x) (car x)) (osql "readfile('data/lr_partition');"))))
               (nconc (sublist data 0 5)
                      (sublist data 5 5)
                      (sublist data 1 4)
                      (sublist data 10 1)
                      (sublist data 6 4)
                      (sublist data 11 2)))))

(checkequal "distinct operator in window stream."
            ((swinbag-in (osql "in(w_distinct({3}, w_time(vstreamfile('data/lr6'), 5, 1, 1)));"))
             '((#(0 0 101 30 0 0 1 39 210675 -1 -1 -1 -1 -1 -1) 
                #(0 0 102 27 0 0 1 65 348022 -1 -1 -1 -1 -1 -1) 
                #(0 0 137371 34 1 0 0 24 127303 119736 -1 -1 -1 -1 -1) 
                #(0 0 137372 32 1 0 0 0 535 119736 -1 -1 -1 -1 -1) 
                #(0 0 137373 28 1 0 0 26 137751 119736 -1 -1 -1 -1 -1))))
            ((swinbag-in (osql "in(w_distinct({4, 5, 6}, w_time(vstreamfile('data/lr6'), 5, 1, 1)));"))
             '((#(0 0 101 30 0 0 1 39 210675 -1 -1 -1 -1 -1 -1) 
                #(0 0 137371 34 1 0 0 24 127303 119736 -1 -1 -1 -1 -1)))))

(checkequal "projection on window stream."
            ((flatten (swinbag-in (osql "in(w_project({0, 2, 3}, w_tuple(vstreamfile('data/lr32'), 5, 1, 1)));")))
             (let ((data 
                    (projectl (mapcar (f/l (x) (car x)) (osql "readfile('data/lr32');")) '(0 2 3))))
               (nconc (sublist data 10 5)
                      (sublist data 27 5)
                      (sublist data 28 5)
                      (sublist data 29 5)
                      (sublist data 30 5)
                      (sublist data 31 5)
                      (sublist data 32 5)))))


(checkequal "filtering on window stream."
            ((progn 
               (osql "
create function __where__fows(Vector row) -> Boolean as 
  row[1] > 0;
")
               (flatten (swinbag-in (osql "
in(w_filter(
  w_tuple(vstreamfile('data/lr32'), 5, 1, 1),
  #'__where__fows'));
"))))
             (let ((data                     
                    (mapcar (f/l (x) (car x)) (osql "readfile('data/lr32');"))))
               (nconc (sublist data 27 5)
                      (sublist data 28 5)
                      (sublist data 29 5)
                      (sublist data 30 5)
                      (sublist data 31 5)
                      (sublist data 32 5)))))