lisp;

(checkequal "pipe"
	    ((let ((str (new-pipestream)))
	      (print "hej" str)
	      (flush str)
	      (read str))
	     "hej"))

(checkequal "IPC"
	    ((let ((pid (fork (f/l (p) (pf "hej2" p)))))
	       (prog1
		   (read _uppipe_)
		 (waitproc pid)))
	     "hej2"))

(let (count ttime btime)
(checkequal "Textual IPC"
  ((let ((pid (fork (f/l (p) (print (osql 
    "select (vselect iota(1, 200))
     from integer i where i in iota(1, 10000);") p))))
  (tpl))
  (progn
    (setq ttime (time-spent (setq count (length (read _uppipe_)))))
    (formatl t "[textual time-spent " (roundto ttime 4) "] ")
    (waitproc pid)
    (and (> ttime 0.02) (< ttime 2))))
  t)
(count 10000))
(checkequal "Binary IPC"
  ((let ((pid (fork (f/l (p) (print (osql 
    "select iarray(vselect iota(1, 200)) 
     from integer i where i in iota(1, 10000);") p))))
  (tpl))
  (progn
    (setq btime (time-spent (setq count (length (read _uppipe_)))))
    (formatl t "[binary time-spent " (roundto btime 4) "] ")
    (waitproc pid)
    (and (> (/ ttime btime) 5) (< (/ ttime btime) 20))))
  t)
(count 10000)))

(checkequal "non blocking rollout"
	((let pid (nbrollout "data/nbrollout.dmp")
	 (wait-nbrollout)
	 (osql "dir('data','nbrollout.dmp');"))
	'(("nbrollout.dmp"))))

(checkequal "osql-fork"
	((osql "fork(siota(1,5));")
	 '(((1)) ((2)) ((3)) ((4)) ((5)))))


:osql
sleep(0.5);
quit;
