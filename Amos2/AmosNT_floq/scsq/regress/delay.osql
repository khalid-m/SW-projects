(osql "writefile('proctime/symdelays', cdelay());
sleep(2);
clear_cdelay();")

(let ((amos_times 5) (amos_percentage 1))
(checkequal "starved union flush 0.1"
((let* (
(resv (prog1 (caar (osql "
setup(0.1, :emitcap);
starvexp(:times, :emitcap, :percentage);")) (sleep 2)))
(delays (osql "avgdelay(src_grp());"))
(tp (/ (* 1.01 amos_times amos_emitcap) (elt resv 2)))
(avgdelay (caar (osql "average(cdelay()[3]);"))))
(prog1 (elt resv 3)
       (formatl t "average delay = " (roundto avgdelay 3) t)
       (formatl t "left | right delay = " delays t)
       (formatl t "throughput = " tp " tpl/s ")))
(round (* 1.01 amos_times amos_emitcap)))))

