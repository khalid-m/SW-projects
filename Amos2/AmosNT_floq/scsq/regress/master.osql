(checkequal 
 "numarray copy"
 ((let ((b (copy-numarray amos_a))) (na2vec b))
  #(17 42 57))
 ((let ((b (copy-numarray amos_a))) (na-seta b 1 4711) (na2vec amos_a))
  #(17 42 57)))

(checkequal "numarray smash"
	    ((let ((v (make-iarray 6))
		   (w (init-iarray #(1 2 3 4))))
	       (na-smash v 0 w))
	     (init-iarray #(1 2 3 4 0 0)))
	    ((let ((v (make-iarray 6)))
	       (na-smash v 2 (init-iarray #(1 2 3 4))))
	     (init-iarray #(0 0 1 2 3 4)))
	    ((let ((v (make-darray 6))
		   (w (init-darray #(1.0 2.0 3.0 4.0))))
	       (na-smash v 2 w))
	     (init-darray #(0.0 0.0 1.0 2.0 3.0 4.0)))
	    ((let ((v (make-darray 6)))
	       (na-smash v 0 (init-darray #(1.0 2.0 3.0 4.0))))
	     (init-darray #(1.0 2.0 3.0 4.0 0.0 0.0)))
	    ((let ((v (make-farray 6))
		   (w (init-farray #(1.0 2.0 3.0 4.0))))
	       (na-smash v 2 w))
	     (init-farray #(0.0 0.0 1.0 2.0 3.0 4.0)))
	    ((let ((v (make-farray 6)))
	       (na-smash v 0 (init-farray #(1.0 2.0 3.0 4.0))))
	     (init-farray #(1.0 2.0 3.0 4.0 0.0 0.0)))
	    )

(checkequal "numarray smash type mismatch"
	    ((errcond-msg (catch-error
			   (let ((v (make-darray 1))) 
			     (na-smash v -1 (make-iarray 1)))))
	     "Numarray type mismatch")
	    ((errcond-msg (catch-error
			   (let ((v (make-farray 1))) 
			     (na-smash v -1 (make-iarray 1)))))
	     "Numarray type mismatch")
	    )

