 ((osql "enum_na(iarray(10), 2)[2];")
  '((11))))

(checkequal "make-numarray"
	    ((make-numarray 8 (arg-type (make-darray 1)))
	     (make-darray 8))
	    ((make-numarray 8 (arg-type (make-farray 1)))
	     (make-farray 8))
	    )

; NB: The windowagg() function defined below does funky stuff to vectors.
; As such, it is a good test of basic vector aggregation methods.

(checkequal 
 "vector aggregation"
 ((osql "
create function windowagg(bag of vector v, integer sz) -> vector as begin
        declare vector w, integer cnt;
        set w={};
        set cnt=0;
        for each original vector e where e=in(v)
        begin
                set cnt=cnt+1;
                set w=concat(w,e);

                if cnt=sz then
                begin
                        return(w);
                        set w={};
                        set cnt=0;
                end;
        end;
end;

count(select windowagg((
    select vectorof(select iota(1,100)) 
    from integer i 
    where i in iota(1,10)),5));")
  '((2))))

