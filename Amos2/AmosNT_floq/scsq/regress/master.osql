(checkequal 
 "writefiles"
 ((let ((wfresult 
	 (osql "writefiles('data/empty.out', 10, (
  select i from integer i where i in retard(0.05, iota(5,10))));")))
    (formatl t "[time " (roundto (first (car wfresult)) 2) "s bag, "
	     (roundto(second (car wfresult)) 2) "s setup] ")
    (< (caar wfresult) 1.0))
  t))

(checkequal 
 "writefiles on empty bag"
 ((let ((wfresult 
	 (osql "writefiles('data/empty.out', 10, (
  select i from integer i where i in retard(0.05, iota(5,10)) and i < 5));")))
    (formatl t "[time " (roundto (first (car wfresult)) 2) "s bag, "
	     (roundto(second (car wfresult)) 2) "s setup] ")
    (< (caar wfresult) 1.0))
  t))

(checkequal 
 "operations on vectors of numbers"
 ((osql "
create function positive(number n)->number as select n where n>=0;

create function vsquarediffs(vector of number b, real x)->bag of real as
select (y-x)*(y-x) from real y where y = in(b);

create function getdimvalues(vector of number v, integer dim)-> real as
select positive(sqrt(sum(vsquarediffs(cast({v[cast(dim-1 as integer)],v[dim]}
  as vector of number),0.0))));

getdimvalues(cast ({1,1,4,4,99,98} as vector of number),1) - positive(sqrt(2));
")
  '((0.0)))

 ((osql "getdimvalues(cast ({1,1,4,4.5,99,98} as vector of number), 3) - 
        positive(sqrt(36.25));")
  '((0.0))))

