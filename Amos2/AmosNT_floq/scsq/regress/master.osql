lisp;

(if (file-exists-p "regress/numarray_regress.lsp")
    (load "regress/numarray_regress.lsp"))
(if (file-exists-p "numarray_regress.lsp")
    (load "numarray_regress.lsp"))

(let ((a (caar (osql "tcount(siota(0,10));")))
      (b (caar (osql "tcount(siota(0,-1));"))))
  (checkequal "tcount"
	      ((length a)
	       4)
	      ((elt a 3)
	       11)
	      ((elt b 3)
	       0)
	      ((length b)
	       4)))


