(checkequal "Sort Merge Join"
 ((osql "vectorof(smj(spv(vselect streamof({i*iota(1,5)}) 
        from integer i where i in iota(1,3)), 0));")
 '((#(#(1) #(2) #(2) #(3) #(3) #(4) #(4) #(5) #(6) #(6) #(8) #(9) #(10) #(12)
    #(15)))))
 ((osql "vectorof(smj(spv(vselect streamof({0, i*iota(1, 3+i), 1})
         from integer i where i in iota(1, 3)), 1));")
 '((#(#(0 1 1) #(0 2 1) #(0 2 1) #(0 3 1) #(0 3 1) #(0 4 1) #(0 4 1) #(0 6 1) 
      #(0 6 1) #(0 8 1) #(0 9 1) #(0 10 1) #(0 12 1) #(0 15 1) #(0 18 1))))))

