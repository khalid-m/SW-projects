((osql "select in(zipstreams(mapstreams(s, #'stream.scount->stream')))
from vector of stream s
where s = splitflexra(streamof(winagg(iota(1,90),8,8)), 8, #'rra', {0},
make_record({}));") 
'((#(11 11 11 11 11 11 11 11)))))

