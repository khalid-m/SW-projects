:osql

create function smjsrc()->vector of stream of vector of integer as
vectorize(select i-1, streamof({integer(i*iota(1,5))})
from integer i where i in iota(1,3));

create function smjsrcna()->vector of stream of vector of integer as
vectorize(select i-1, streamof(iarray({integer(i*iota(1,5))}))
from integer i where i in iota(1,3));

lisp;

(checkequal "smjstreamsv"
((osql "in(smjstreamsv(exestreams(smjsrc()), 0));")
 '((#(1)) (#(2)) (#(2)) (#(3)) (#(3)) (#(4)) (#(4)) (#(5)) (#(6)) (#(6)) (#(8))
  (#(9)) (#(10)) (#(12)) (#(15)))))

(checkequal "smjstreamsna"
((osql "na2vec(in(smjstreamsna(exestreams(smjsrcna()), 0)));")
 '((#(1)) (#(2)) (#(2)) (#(3)) (#(3)) (#(4)) (#(4)) (#(5)) (#(6)) (#(6)) (#(8))
  (#(9)) (#(10)) (#(12)) (#(15)))))

