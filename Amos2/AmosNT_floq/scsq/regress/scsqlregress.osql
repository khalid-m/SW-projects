(checkequal "intra bg merge"
 ((osql "select extract(c)
from sp a, sp b, sp c
where c = newsp(streamof(sum(dim(zip({a,b})))))
and   a = newsp(gen_array(1, 3))
and   b = newsp(gen_array(1, 3));")
  '((6))))

(checkequal "Query I"
 ((osql "select extract(c) from
vector of sp a, sp b, sp c, 
integer n
where c = newsp(streamof(extract(b)))
and   b = newsp(streamof(sum(dim(zip(a)))))
and   a = spv(
  vselect gen_array(1, 3)
  from integer i where i in iota(1,n))
and n=4;")
  '((12))))

(checkequal "Query III"
 ((osql "select extract(c) from
 vector of sp a, vector of sp b, sp c,
 integer n
 where c = newsp(streamof(vsum(cast(zip(b) as vector of number))))
 and   b = spv(
   vselect streamof(countbag(extract(a[cast(i-1 as integer)])))
   from integer i 
   where i in iota(1,n))
 and a=spv(
   vselect gen_array(1, 3)
   from integer i where i in iota(1,n))
 and n=4;")
  '((12))))

