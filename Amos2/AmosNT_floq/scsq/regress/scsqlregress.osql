'((10) (11) (12))))

(checkequal "running a set of mapflex in parallel"
((osql "select in(zipstreams(proc))
from vector of stream proc, vector of stream src, vector of integer argv,
integer width
where proc = mapflexv((vselect {src[i], argv[i]} from integer i), 
#'sadd', make_record({}))
and src = splitstream(siota(1, 5), width, #'bcast')
and argv = {1000, 100, 200}
and width = dim(argv);")
'((#(1001 101 201)) (#(1002 102 202)) (#(1003 103 203)) (#(1004 104 204))
  (#(1005 105 205)))))

