(checkequal "quality of adaptive KD parallelized css"
((osql "roundto(avg(select in(v)[3] 
  from vector of vector of number v, vector of sp b, sp c, integer n,
  charstring file
  where v = merge(b)
  and b = spv(vectorof(
    select streamof({this_amosid(),cssqual(
      select css(cast(v[1] as vector of vector), cast(v[0][1] as timeval),
                 4, 0.8, 600)
      from vector of vector v
    where v = twinagg(ostream(c, i), 60.0,60.0,0,0))})
  from integer i
  where i in iota(0, n - 1)))
  and c = newsp(streamof(rfkd2(file, 600.0, 60.0, 10)), n, #'kdnodefilter')
  and n in {4} and file = getenv('AMOS_HOME') + '/scsq/css/data/req300.data'),
    5);")
 '((0.90944))))

(sleep 3)
(send-form '(quit) (open-nameserver-port))
:osql
quit;
