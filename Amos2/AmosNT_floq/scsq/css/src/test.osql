lisp;

(checkequal "static oct node boundaries"
 ((osql "sort(select a, b, c, d, e, f, g, h, i
         from real a, real b, real c, real d, real e, real f, real g, real h, 
         integer i
         where i in iota(0, 2) and i = octnodes(a, b, c, d, e, f, g, h));")
 '((#(#(0.0 722550.0 0.0 6176650.0 0.0 724769.0 0.0 6175663.0 0) #(0.0 722550.0 6176650.0 10000000.0 0.0 724769.0 0.0 6175663.0 2) #(722550.0 1000000.0 0.0 6176650.0 0.0 724769.0 0.0 6175663.0 1))))))

(checkequal "static kd node boundaries"
 ((osql "sort(select a, b, c, d, e, f, g, h, i
         from real a, real b, real c, real d, real e, real f, real g, real h, 
         integer i
         where i in iota(0, 2) and i = kdnodes(a, b, c, d, e, f, g, h));")
 '((#(#(0.0 722550.0 0.0 6177150.0 0.0 725011.0 0.0 6176152.0 0) #(0.0 722550.0 0.0 6177150.0 0.0 725011.0 6176152.0 10000000.0 1) #(0.0 722550.0 0.0 6177150.0 725011.0 1000000.0 0.0 6176196.0 2))))))

(checkequal "static kdnodefilter"
 ((osql "count(select v from vector v, integer i 
where <i, v> = kdnodefilter(vreadfile('data/req300.data'), 16)
and i = 5);")
 '((20))))

(checkequal "adaptive kdnodefilter"
 ((osql "count(select v from vector v, integer i 
where <i, v> = kdnodefilter(rfkd('data/req300.data', 600.0), 16)
and i = 5);")
 '((17))))

(checkequal "amount of output from rfkd"
 ((osql "count(rfkd('data/req21.data',600.0));")
 '((21))))

(checkequal "amount of output from rfkd2 (swallows first few tuples)"
 ((osql "count(rfkd2('data/req21.data', 600.0, 60.0, 10));")
 '((19))))

(checkequal "static octnodefilter"
 ((osql "count(select v from vector v, integer i 
where <i, v> = octnodefilter(vreadfile('data/req21.data'), 16)
and i = 0);")
 '((3))))

(checkequal "getkd2"
 ((osql "getKD2({twinagg(streamof(readfile('data/req21.data')),
                         600000.0,60000.0,0,0)[1], 1, 4, 1, {}});")
  '((#(#() 4 4 1 #(722250.0 6175550.0 723934.0 6174510.0) 1 0 1))
    (#(#() 4 4 2 #(722250.0 6175550.0 723934.0 6176538.0) 3 1 2)) 
    (#(#() 4 4 3 #(722250.0 6175550.0 724504.0 6176723.0) 2 0 2)) 
    (#(#() 4 4 4 #(722250.0 6175550.0 724504.0 6173728.0) 4 1 3)) 
    (#(#() 4 4 5 #(722250.0 6176350.0 724106.0 6172505.0) 2 0 2)) 
    (#(#() 4 4 6 #(722250.0 6176350.0 724106.0 6176192.0) 3 1 2)) 
    (#(#() 4 4 7 #(722250.0 6176350.0 725239.0 6175354.0) 2 0 2)) 
    (#(#() 4 4 8 #(722250.0 6176350.0 725239.0 6174680.0) 4 1 3)))))

(checkequal "quality of basic css"
 ((osql "select roundto(q,6)
from vector dummy, integer numreq, real q, timeval now, real realnow
where <dummy, numreq, q, now, realnow> =
cssqual(select css(cast(v[1] as vector of vector), 
                            cast(v[0][1] as timeval),
                            4, 0.8, 600)
                 from vector of vector v
                 where v = twinagg(streamof(readfile('data/req300.data')), 
                     60.0,60.0,0,0));")
 '((0.880547))))

; tests added Nov 6 2008

(checkequal "inserting into BUFq"
 ((osql "drop(theresolvent('bufq'));
   insertBUFq(decrequest(vreadfile('data/req21.data')));
   maxagg(select t 
          from timeval t, real fx, real fy, real tx, real ty, integer i 
          where <t, fx, fy, tx, ty> = bufq(i));")
'((#[T 25560 0]))))

(checkequal "shift out data from BUFq"
 ((osql "removeBUFqOlderThan(add_duration(maxagg(select t 
          from timeval t, real fx, real fy, real tx, real ty, integer i 
          where <t, fx, fy, tx, ty> = bufq(i)), - (120.0 - 1)));
         count(select bufq(i) from integer i);")
 '((4))))

(checkequal "BUFq data"
 ((osql "sort(select bufq(i) from integer i);")
 '((#(#(#[T 25500 0] 718850.0 6177850.0 725320.0 6174768.0) 
    #(#[T 25500 0] 719150.0 6173350.0 725533.0 6179142.0)
    #(#[T 25500 0] 725050.0 6174750.0 724106.0 6178277.0)
    #(#[T 25560 0] 721850.0 6176950.0 718769.0 6179010.0))))))

(checkequal "statistics on data in BUFq"
 ((osql "fxavg();")
  '((721225.0))
  (osql "fyavg();")
  '((6175725.0))
  (osql "txavg();")
  '((723432.0))
  (osql "tyavg();")
  '((6177799.25))))

(checkequal "getoctnode on the small dataset (one in each quadrant)"
 ((osql "drop(theresolvent('octnodes'));
         updateOCTnodes(fxavg(), fyavg(), txavg(), tyavg());
       sort(select i, getoctnode(fx, fy, tx, ty, 4)
       from integer i, timeval t, real fx, real fy, real tx, real ty
       where <t, fx, fy, tx, ty> = bufq(i));")
 '((#(#(288 2) #(304 0) #(320 1) #(336 3))))))

(checkequal "oct partition based on BUFq statistics"
((osql "select i, count(select v from vector v, integer j
where <j, v> = octnodefilter(vreadfile('data/req21.data'), 4)
and j = i)
        from integer i where i in iota(0,3);")
 '((0 3) (1 7) (2 3) (3 8))))

(checkequal "dynamic oct partition node"
 ((osql "select in(v)[1]
   from vector of sp b, sp c, integer n, vector of vector v
   where v = merge(b)
   and b = spv(vselect streamof({this_amosid(), count(in(ostream(c, i)))})
     from integer i
     where i in iota(0, n - 1))
   and c = newsp(streamof(
     readfileoct(getenv('AMOS_HOME') + '/scsq/css/data/req300.data', 120.0)),
     n, #'octnodefilter')
   and n = 4;")
 '((69) (75) (88) (68))))

; Expected output (a) '((68) (79) (88) (65))
; Expected output (b) '((69) (75) (88) (68))
; (a) was valid from the start until 2008-11-06 and 2009-09-03 until 2010-02-13
; (b) was valid 2008-11-06 until 2009-09-03, 2009-02-13 until ...

