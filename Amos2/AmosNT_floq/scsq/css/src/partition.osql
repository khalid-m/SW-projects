create function fxa()->real;
create function fya()->real;
create function txa()->real;
create function tya()->real;

/* Averages */
/*set fxa()=722796.148131609;
set fya()=6176349.7318105;
set txa()=724002.517005311;
set tya()=6175306.58724342;*/

/* Medians */
set fxa()=722550.0;
set fya()=6176650.0;
set txa()=724769.0;
set tya()=6175663.0;


/* Hierarchical medians */

create function fx()->real;

create function fxlfy()->real;
create function fxufy()->real;

create function fxlfyltx()->real;
create function fxlfyutx()->real;
create function fxufyltx()->real;
create function fxufyutx()->real;

create function fxlfyltxlty()->real;
create function fxlfyutxlty()->real;
create function fxufyltxlty()->real;
create function fxufyutxlty()->real;
create function fxlfyltxuty()->real;
create function fxlfyutxuty()->real;
create function fxufyltxuty()->real;
create function fxufyutxuty()->real;

/* Manual boundaries. 
These are better balanced than automatic boundaries. 
However, it is a tedious taks to define them.
*/

