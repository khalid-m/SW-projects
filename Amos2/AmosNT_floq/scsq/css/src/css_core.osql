/* 
Function that evaluates the quality of CSS in terms of average estimated 
savings.
*/
create function cssqual(bag of vector of vector cssdata)-> 
  (vector, integer, real, timeval, real) as
begin
   declare real sumsavings, integer numreq, real Tsumsavings, integer Tnumreq, 
           vector iter;
   set Tsumsavings = 0.0;
   set Tnumreq = 0;
   
   for each original vector x where x in(cssdata) 
   begin
      set iter = x[1];
      set sumsavings = 0.0;
      set numreq = 0;
      for each original vector w where w in(iter)

      if w[1] = -1 then begin
         set numreq = numreq + 1;
         set sumsavings = sumsavings + cast(w[2] as real);
      end else begin
         set numreq = numreq + dim(w) - 1;
         set sumsavings = sumsavings + 
                          cast((dim(w)-1) as real) * cast(w[dim(w)-1] as real);
      end;
      if numreq > 0 then begin 
         set Tnumreq = Tnumreq + numreq;
         set Tsumsavings = Tsumsavings + sumsavings;        
         /*return (x[0],numreq, sumsavings/numreq, now(), real(now()));*/
      end;
   end;
   return ({},Tnumreq, Tsumsavings/Tnumreq, now(), real(now()));
end;

/* 
Function that checks for double scheduling. Very slow as is it is based on
cummulation of vector data.
*/
create function csscheck(bag of vector of vector cssdata)-> vector as
begin
   declare vector of integer uh, vector of integer ch;
   set uh = {};
   set ch = {};
   
   for each original vector x where x in(cssdata) 
   begin
      for each original vector w where w in(x)
      if w[1] = -1 then begin
         set uh = vunion(uh, {w[0]});
         set ch = concat(ch, {w[0]});
      end else begin
         set uh = vunion(uh, subvector(w,0,dim(w)-1));
         set ch = concat(ch, subvector(w,0,dim(w)-1));      
      end;
   end;
   if dim(ch) = dim(uh) then begin
      return {1, ch};
   end else begin
      return {0, ch};
   end;
end;

/* 
Function that checks for double scheduling. Very slow as is it is based on
cummulation of vector data.
*/
create function csscheck_verbose(bag of vector of vector cssdata)-> vector as
begin
   declare vector of integer uh, vector of integer ch;
   set uh = {};
   set ch = {};
   
   for each original vector x where x in(cssdata) 
   begin
      for each original vector w where w in(x)
      if w[1] = -1 then begin
         set uh = vunion(uh, {w[0]});
         set ch = concat(ch, {w[0]});
      end else begin
         set uh = vunion(uh, subvector(w,0,dim(w)-1));
         set ch = concat(ch, subvector(w,0,dim(w)-1));      
      end;
      if dim(ch) = dim(uh) then begin
	       return {1, {}};
      end else begin
         return {0, ch};
      end;   
   end;
   if dim(ch) = dim(uh) then begin
      return {1, {}};
   end else begin
      return {0, ch};
   end;   
end;


/*
NOTE: CSS assumes that the main memory table q() is empty at startup, 
in particular it should not have future requests in it, as those would 
be scheduled twice (secont time around sometime after they have been 
reinserted as "new" incomming requests). 
*/

/* gyg added */

create function BUFq(integer id) -> 
(timeval t, real fx, real fy, real tx, real ty);
	
/*
Function that inserts a request provided as a set of values as a tuple in the 
table BUFq().
*/	
create function insertBUFq(timeval t, integer id, real fx, real fy, real tx, 
                           real ty)->boolean as
add BUFq(id)= (t, fx, fy, tx, ty);

/*
Function that removes a request from the table BUFq() if it id of the requests 
matches the parameter id.
*/	
create function removeBUFq(integer id)->integer as 
begin
   remove BUFq(id) = (t, fx, fy, tx, ty) from timeval t, real fx, real fy, 
     real tx, real ty where 1=1;
   return true;
end;

/*  
Function that removes requests from the table BUFq() that have timevals <= tv.  
*/	
create function removeBUFqOlderThan(timeval tv)->boolean as
begin
   select removeBUFq(i)
   from integer i, timeval t, real fx, real fy, real tx, real ty
   where BUFq(i)=(t,fx, fy, tx, ty) and t <= tv;
   return true;
end;

/*
Function that updates the octnode tables according to the supplied parameters.
*/  
create function updateOCTnodes(real fxa, real fya, real txa, real tya) -> 
boolean as
begin 
   set octnodes(  0.0,     fxa,   0.0,      fya,   0.0,     txa,   0.0,      tya)=0;
   set octnodes(fxa, 1000000.0,   0.0,      fya,   0.0,     txa,   0.0,      tya)=1;
   set octnodes(  0.0,     fxa, fya, 10000000.0,   0.0,     txa,   0.0,      tya)=2;
   set octnodes(fxa, 1000000.0, fya, 10000000.0,   0.0,     txa,   0.0,      tya)=3;
   set octnodes(  0.0,     fxa,   0.0,      fya, txa, 1000000.0,   0.0,      tya)=4;
   set octnodes(fxa, 1000000.0,   0.0,      fya, txa, 1000000.0,   0.0,      tya)=5;
   set octnodes(  0.0,     fxa, fya, 10000000.0, txa, 1000000.0,   0.0,      tya)=6;
   set octnodes(fxa, 1000000.0, fya, 10000000.0, txa, 1000000.0,   0.0,      tya)=7;
   set octnodes(  0.0,     fxa,   0.0,      fya,   0.0,     txa, tya, 10000000.0)=8;
   set octnodes(fxa, 1000000.0,   0.0,      fya,   0.0,     txa, tya, 10000000.0)=9;
   set octnodes(  0.0,     fxa, fya, 10000000.0,   0.0,     txa, tya, 10000000.0)=10;
   set octnodes(fxa, 1000000.0, fya, 10000000.0,   0.0,     txa, tya, 10000000.0)=11;
   set octnodes(  0.0,     fxa,   0.0,      fya, txa, 1000000.0, tya, 10000000.0)=12;
   set octnodes(fxa, 1000000.0,   0.0,      fya, txa, 1000000.0, tya, 10000000.0)=13;
   set octnodes(  0.0,     fxa, fya, 10000000.0, txa, 1000000.0, tya, 10000000.0)=14;
   set octnodes(fxa, 1000000.0, fya, 10000000.0, txa, 1000000.0, tya, 10000000.0)=15;
end;

/*
Function that reads the CSS file and mimics the output of the function 
readfile(), but at the same time based on a tbuf-seconds long temporal buffer
of the so far read values updates the octnode table every time a NEW timestamp
is encountered in the input data (effectively every minute).
*/  


/*

print ({"stat", in(select {a,b,c,d,e,f,g,h,octnodes(a,b,c,d,e,f,g,h)}
from real a, real b, real c, real d, real e, real f, real g, real h)});

*/

create function fxavg()->real
  as avg(select fx
         from integer i, timeval t, real fx, real fy, real tx, real ty
         where (t, fx, fy, tx, ty) = bufq(i));

create function fyavg()->real
  as avg(select fy
         from integer i, timeval t, real fx, real fy, real tx, real ty
         where (t, fx, fy, tx, ty) = bufq(i));

create function txavg()->real
  as avg(select tx
         from integer i, timeval t, real fx, real fy, real tx, real ty
         where (t, fx, fy, tx, ty) = bufq(i));

create function tyavg()->real
  as avg(select ty
         from integer i, timeval t, real fx, real fy, real tx, real ty
         where (t, fx, fy, tx, ty) = bufq(i));


create function readfileoct(charstring file, real tbuf)->vector as
begin
  declare stream of vector cssdata, timeval prev_tv, function rf;
  set cssdata = streamof(readfile(file));
  set prev_tv = mktv(0);
  set rf = theresolvent("octnodes");

  /* make sure the BUFq is empty */
  drop(theresolvent("BUFq"));
  for each vector x where x in cssdata
  begin
    insertBUFq(decrequest(x));
    if prev_tv < x[0] then /* update statistics if time has moved forward */
    begin
      set prev_tv = x[0]; /* delete the old stuff from BUFq */
      removeBUFqOlderThan(add_duration(cast(x[0] as timeval), -(tbuf-1)));
      /* clear and re-populate the octnodes table */
      drop(rf);
      updateOCTnodes(fxavg(), fyavg() ,txavg() ,tyavg());
    end;
    return(x);
  end;
end;


/* 
Function that reads the CSS file and mimics the output of the function 
readfile(), but at the same time based on a tbuf-seconds long temporal buffer 
of the so far read values updates the octnode table every time a NEW timestamp 
is encountered in the input data (effectively every minute). WITH LOOK-AHEAD!!!
*/
create function readfileoct2(charstring file, real tbuf)->vector as
begin
  declare stream of vector cssdata, vector prev_x, real fxa, real fya, 
    real txa, real tya, function rf, integer i, integer qsize;
  set cssdata = streamof(readfile(file));
  set prev_x = {};
  set i = 0;
  set qsize = 0;
  set rf = theresolvent("octnodes"); 
  /* make sure the BUFq is empty */
  drop(theresolvent("BUFq"));
  for each vector x where x in cssdata
  begin
    /* from the 2nd css data vector and onwards */ 
   if i > 0 then
   begin
     insertBUFq(decrequest(prev_x));
     if prev_x[0] < x[0] then
     begin /* delete the old stuff from BUFq */
     removeBUFqOlderThan(add_duration(cast(prev_x[0] as timeval), -(tbuf-1)));
     /* -1 because there seems to be some equality check problems 
        between timevals */
    /* calculate new stats */
    set fxa = median(vectorof(select cast({BUFq(i)}[1] as real)from integer i));
    set fya = median(vectorof(select cast({BUFq(i)}[2] as real)from integer i));
    set txa = median(vectorof(select cast({BUFq(i)}[3] as real)from integer i));
    set tya = median(vectorof(select cast({BUFq(i)}[4] as real)from integer i));
    /* drop and polulate the octnodes table */
    drop(rf);
    updateOCTnodes(fxa,fya,txa,tya);  
  end;
  return(prev_x);
  end;
  set prev_x = x;
  set i = i + 1;
end;
   
   insertBUFq(decrequest(prev_x));
   /* delete the old stuff from BUFq */
   removeBUFqOlderThan(add_duration(cast(prev_x[0] as timeval), -(tbuf-1))); 
   /* -1 because there seems to be some equality check problems 
      between timevals */
   /* calculate stats */
   set fxa = median(vectorof(select cast({BUFq(i)}[1] as real)from integer i));
   set fya = median(vectorof(select cast({BUFq(i)}[2] as real)from integer i));
   set txa = median(vectorof(select cast({BUFq(i)}[3] as real)from integer i));
   set tya = median(vectorof(select cast({BUFq(i)}[4] as real)from integer i));
   /* drop and polulate the octnodes table */
   drop(rf);
   updateOCTnodes(fxa,fya,txa,tya); 
   return(prev_x);
end;
    
   
/*   
Function that reads the CSS file and mimics the output of the function 
readfile(), but at the same time every tbuf-seconds based on a tbuf-seconds 
long temporal buffer of the so far read values updates the octnode table. 
Statistics are based on samples of the input stream.
*/
create function rfo(charstring file, real tbuf)->vector as begin
   declare stream of vector ts, function rf, real fxa, real fya, real txa, 
           real tya;
   set rf = theresolvent("octnodes");
   set ts = streamof(twinagg(streamof(readfile(file)),tbuf,tbuf,0,0)[1]);
   for each vector t where t in ts begin
      set fxa = median(vectorof(select x[2] from vector of number x 
	where x = in(t)));
      set fya = median(vectorof(select x[3] from vector of number x 
	where x = in(t)));
      set txa = median(vectorof(select x[4] from vector of number x 
	where x = in(t)));
      set tya = median(vectorof(select x[5] from vector of number x 
	where x = in(t)));
      drop(rf);
      updateOCTnodes(fxa,fya,txa,tya);
      /*  return vectorof(select a,b,c,d,e,f,g,h,i 
      from real a, real b, real c, real d, real e, real f, real g, real h, 
      integer i 
      where i=iota(0,15) and i=octnodes(a,b,c,d,e,f,g,h));*/
      for each vector e where e in t begin
         return e;
      end;
   end;
end;

      
/* input and output are vectors of: {{q}, level , k, node, {means}}*/
create function getKD_tcf(Vector input) -> Vector
as 
begin
   declare vector q, vector q1, vector q2, integer level, integer k, 
           integer node, vector means, integer np, real m;
	 set q = input[0];
	 set level = input[1];
	 set k = input[2];
	 set node = input[3];
	 set means = input[4];	

   /* calculate the median of the appropriate dimension and construct 
      partitions */
   set m = sortbagby(cast(cast(in(q) as vector)[level] as real), 1,
                     "inc")[round(count(in(q))/2)];
   /* MEAN: set m = average(select cast(v[level] as real) from integer i, 
      vector v where bagify(q) = (i, v)); */
   set q1 = vectorof(select v from integer i, vector v 
                     where (i,v) in bagify(q) and v[level] < m);
   set q2 = vectorof(select v from integer i, vector v 
                     where (i,v) in bagify(q) and v[level] >= m); 
   /* should really be 2^(k-level-1)*/   
   if level = 1 then set np = 4; 
   if level = 2 then set np = 2;
   if level = 3 then set np = 1; 
   
   if level = k then
   begin 
      return({{}, level, k, node, concat(means,{m})});
   end
   else
   begin
      return({q1, level+1, k, node, concat(means,{m})});
      return({q2, level+1, k, node+np, concat(means,{m})});
   end;
   
end;
   
/* input and output are vectors of: {{q}, level , k, node, {means}}
create function getKD(Vector of Vector input) -> Vector of Vector
   as select output
      from integer d, vector of vector output
      where iterate(theresolvent("getKD_tcf"), input, 4) = (output, d);
*/

/* input and output are vectors of: 
   {{q}, level , k, node, {means}, size(q),
    size(left_child(q)), size(right_child(q))}*/
create function getKD2(Vector input) -> Vector
as 
begin
   declare vector q, vector q1, vector q2, integer level, integer k, 
           integer node, vector means, integer np, real m;
	 set q = input[0];
	 set level = input[1];
	 set k = input[2];
	 set node = input[3];
	 set means = input[4];	

   /* calculate the median of the appropriate dimension and construct 
      partitions*/
   set m = median(vectorof(select d[level+1] from vector d
                           where d in q));
   /*MEAN: set m = average(select cast(v[level+1] as real) 
                         from integer i, vector v where bagify(q) = (i, v)); */
   set q1 = vectorof(select v from integer i, vector v 
                     where v = q[i] and v[level+1] < m);
   set q2 = vectorof(select v from integer i, vector v 
                     where v = q[i] and v[level+1] >= m); 
   /*should really be 2^(k-level-1)*/   
   if level = 1 then set np = 4; 
   if level = 2 then set np = 2;
   if level = 3 then set np = 1;   

   if level = k then
   begin 
      return({{}, level, k, node, 
              concat(means,{m}), dim(q), dim(q1), dim(q2)});
   end
   else
   begin
      return(getKD2({q1, level+1, k, node, concat(means,{m})}));
      return(getKD2({q2, level+1, k, node+np, concat(means,{m})}));
   end;
   
end; 

/*
Same as getKD2 but with old median. SLOWER!
*/
create function getKD2old(Vector input) -> Vector
as 
begin
   declare vector q, vector q1, vector q2, integer level, integer k, 
           integer node, vector means, integer np, real m;
	 set q = input[0];
	 set level = input[1];
	 set k = input[2];
	 set node = input[3];
	 set means = input[4];	

   /* calculate the median of the appropriate dimension and construct 
      partitions*/
   /*  Old median: */
       set m = sortbagby(cast(cast(in(q) as vector)[level+1] as real), 
                     1, "inc")[round(dim(q)/2)]; 
   /*MEAN: set m = average(select cast(v[level+1] as real) 
                         from integer i, vector v where bagify(q) = (i, v)); */
   set q1 = vectorof(select v from integer i, vector v 
                     where v = q[i] and v[level+1] < m);
   set q2 = vectorof(select v from integer i, vector v 
                     where v = q[i] and v[level+1] >= m); 
   /*should really be 2^(k-level-1)*/   
   if level = 1 then set np = 4; 
   if level = 2 then set np = 2;
   if level = 3 then set np = 1;   

   if level = k then
   begin 
      return({{}, level, k, node, 
              concat(means,{m}), dim(q), dim(q1), dim(q2)});
   end
   else
   begin
      return(getKD2({q1, level+1, k, node, concat(means,{m})}));
      return(getKD2({q2, level+1, k, node+np, concat(means,{m})}));
   end;
   
end;   

/*
Function that initializes the kdnodes tables according to the static KD split values.
*/
create function initKDnodes()-> boolean as 
begin
   drop(theresolvent("kdnodes"));
   set kdnodes(  0.0,      fx(),    0.0,    fxlfy(),       0.0,fxlfyltx(),          0.0,fxlfyltxlty())=0;
   set kdnodes(  0.0,      fx(),    0.0,    fxlfy(),       0.0,fxlfyltx(),fxlfyltxlty(),   10000000.0)=1;
   set kdnodes(  0.0,      fx(),    0.0,    fxlfy(),fxlfyltx(), 1000000.0,          0.0,fxlfyltxuty())=2;
   set kdnodes(  0.0,      fx(),    0.0,    fxlfy(),fxlfyltx(), 1000000.0,fxlfyltxuty(),   10000000.0)=3;
   set kdnodes(  0.0,      fx(),fxlfy(), 10000000.0,       0.0,fxlfyutx(),          0.0,fxlfyutxlty())=4;
   set kdnodes(  0.0,      fx(),fxlfy(), 10000000.0,       0.0,fxlfyutx(),fxlfyutxlty(),   10000000.0)=5;
   set kdnodes(  0.0,      fx(),fxlfy(), 10000000.0,fxlfyutx(), 1000000.0,          0.0,fxlfyutxuty())=6;
   set kdnodes(  0.0,      fx(),fxlfy(), 10000000.0,fxlfyutx(), 1000000.0,fxlfyutxuty(),   10000000.0)=7;
   set kdnodes( fx(), 1000000.0,    0.0,    fxufy(),       0.0,fxufyltx(),          0.0,fxufyltxlty())=8;
   set kdnodes( fx(), 1000000.0,    0.0,    fxufy(),       0.0,fxufyltx(),fxufyltxlty(),   10000000.0)=9;
   set kdnodes( fx(), 1000000.0,    0.0,    fxufy(),fxufyltx(), 1000000.0,          0.0,fxufyltxuty())=10;
   set kdnodes( fx(), 1000000.0,    0.0,    fxufy(),fxufyltx(), 1000000.0,fxufyltxuty(),   10000000.0)=11;
   set kdnodes( fx(), 1000000.0,fxufy(), 10000000.0,       0.0,fxufyutx(),          0.0,fxufyutxlty())=12;
   set kdnodes( fx(), 1000000.0,fxufy(), 10000000.0,       0.0,fxufyutx(),fxufyutxlty(),   10000000.0)=13;
   set kdnodes( fx(), 1000000.0,fxufy(), 10000000.0,fxufyutx(), 1000000.0,          0.0,fxufyutxuty())=14;
   set kdnodes( fx(), 1000000.0,fxufy(), 10000000.0,fxufyutx(), 1000000.0,fxufyutxuty(),   10000000.0)=15;
end;



create function updateKDnodes(integer node, real fxa, real fya, real txa, 
                              real tya) -> boolean as
begin 
   declare real U, real L;
   set U = 100000000.0;
   set L = 0.0; 
   
   /* take care of NIL values by substituting appropriate STATIC global 
      OCT means. */
   if fxa = nil then set fxa = fxa(); 
   if fya = nil then set fya = fya();
   if txa = nil then  set txa = txa();
   if tya = nil then set tya = tya();

   if node = 1 then
   begin
      set kdnodes(L, fxa,   L, fya,   L, txa,   L, tya)=(node-1);
      set kdnodes(L, fxa,   L, fya,   L, txa,   tya, U)=(node-1)+8;
   end;
   if node = 2 then
   begin
      set kdnodes(L, fxa,   L, fya,   txa, U,   L, tya)=(node-1);
      set kdnodes(L, fxa,   L, fya,   txa, U,   tya, U)=(node-1)+8;   
   end;
   if node = 3 then
   begin
      set kdnodes(L, fxa,   fya, U,   L, txa,   L, tya)=(node-1);
      set kdnodes(L, fxa,   fya, U,   L, txa,   tya, U)=(node-1)+8;
   end;
   if node = 4 then
   begin
      set kdnodes(L, fxa,   fya, U,   txa, U,   L, tya)=(node-1);
      set kdnodes(L, fxa,   fya, U,   txa, U,   tya, U)=(node-1)+8;
   end;
   if node = 5 then
   begin
      set kdnodes(fxa, U,   L, fya,   L, txa,   L, tya)=(node-1);
      set kdnodes(fxa, U,   L, fya,   L, txa,   tya, U)=(node-1)+8;
   end;
   if node = 6 then
   begin
      set kdnodes(fxa, U,   L, fya,   txa, U,   L, tya)=(node-1);
      set kdnodes(fxa, U,   L, fya,   txa, U,   tya, U)=(node-1)+8;   
   end;
   if node = 7 then
   begin
      set kdnodes(fxa, U,   fya, U,   L, txa,   L, tya)=(node-1);
      set kdnodes(fxa, U,   fya, U,   L, txa,   tya, U)=(node-1)+8;
   end;
   if node = 8 then
   begin
      set kdnodes(fxa, U,   fya, U,   txa, U,   L, tya)=(node-1);
      set kdnodes(fxa, U,   fya, U,   txa, U,   tya, U)=(node-1)+8;
   end;
end;

       
/*   
Function that reads the CSS file and mimics the output of the function 
readfile(), but at the same time every tbuf-seconds based on a tbuf-seconds 
long temporal buffer of the so far read values updates the kdnode table. 
Statistics are based on samples of the input stream.
*/
create function rfkd(charstring file, real tbuf)->vector as begin
   declare stream of vector ts, function rf;
   set rf = theresolvent("kdnodes");
   set ts = streamof(twinagg(streamof(readfile(file)),tbuf,tbuf,0,0)[1]);
   for each vector t where t in ts 
    begin
      drop(rf);
      select updateKDnodes(v1, v2, v3, v4, v5)
      from Integer v1, Real v2, Real v3, Real v4, Real v5,
           Vector of Vector v
      where v1 = v[3]
        and v2 = v[4][0]
        and v3 = v[4][1]
        and v4 = v[4][2]
        and v5 = v[4][3]
        and v = getKD2({t, 1, 4, 1, {}});
      
      /*  return vectorof(select a,b,c,d,e,f,g,h,i 
      from real a, real b, real c, real d, real e, real f, real g, real h, 
           integer i 
      where i=iota(0,15) and i=kdnodes(a,b,c,d,e,f,g,h)); */
      for each vector e where e in t 
         return e;
    end;
end;
  

create function rfkd2(charstring file, real size, real stride, 
                      integer samplefreq)->vector as
begin
   declare vector of timeval wb, stream of vector ts, timeval fromtv, 
           function rf, integer counter;
   set rf = theresolvent("kdnodes");
   set ts = streamof(twinagg(streamof(readfile(file)),size,stride,0,0));
   set counter = 0;
   for each vector t where t in ts
   begin
      /* update if it is time :) */
      if mod(counter, samplefreq) = 0 then
      begin
         drop(rf);     
         select updateKDnodes(v1, v2, v3, v4, v5)
         from Integer v1, Real v2, Real v3, Real v4, Real v5,
              Vector of Vector v
         where v1 = v[3]
           and v2 = v[4][0]
           and v3 = v[4][1]
           and v4 = v[4][2]
           and v5 = v[4][3]
           and v = getKD2({t[1], 1, 4, 1, {}});
      end;
      /* advance sampling counter */
      set counter = counter + 1;
      set fromtv = add_duration(cast(cast(t[0]as vector)[1] as timeval), 
                                -stride);
     
      for each vector e, integer i 
          where e=cast(t[1] as vector)[i]
            and fromtv <= e[0]
         return e;
   end;
end;

create function testit()->Integer
as begin /* swallows first few tupples */
     rfkd2("/data/taxi/vectors300.osql",600.0,60.0, 10);
     return count(rfkd2("/data/taxi/vectors300.osql",600.0,60.0, 10));
     return count(rfkd("/data/taxi/vectors300.osql",600.0));
     return count(rfkd2("/data/taxi/b16.osql",600.0,60.0, 10));
     return count(rfkd("/data/taxi/b16.osql",600.0));
end;
