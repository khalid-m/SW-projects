/*Knn operator is replaced with xtree knn search.
Knn takes a function to search on*/
create function q11() -> Bag of Charstring 
as select p from Charstring p
   where p in knn( {1, 2, 3, 4}, 3, #'pictureFeatures');

/*Rewrite knn operator with xtree knn search.
Knn takes a function to search on*/
create function q12() -> Bag of Charstring 
as select p from Charstring p, Charstring q
   where p in knn({1, 2, 3, 4}, 3,  #'pictureFeatures')
    and	 q in knn({1, 2, 3, 5}, 3,  #'pictureFeatures')
	and p > q;

create function allPictureFeatures()-><Charstring , Vector of Number>
as
   select str, fv from Charstring str, Vector of Number fv
	where fv = pictureFeatures(str);
  
/*Knn taking a bag to search on*/
create function q13() -> Bag of Charstring 
as select p from Charstring p, Charstring q
    where p in knn({1, 2, 3, 4}, 3, 
		( select str, fv from Charstring str, Vector of Number fv
		where fv = pictureFeatures(str)))
    and	 q in knn({1, 2, 3, 5}, 3, 
		( select str, fv from Charstring str, Vector of Number fv
		where fv = pictureFeatures(str)))
	and p > q;


/*Naive knn implementation*/
create function q14() -> Bag of <Number, Charstring> 
 as
  select roundto(dist, 3), st from Number dist , Charstring st where
	(dist, st) in k_nearest({1, 2, 3, 5}, 3, 
                      	    #'euclid',
			  (select str, fv from Charstring str, 
		           Vector of Number fv
		           where fv = pictureFeatures(str)));


/*Another naive knn implementation*/
create function q15() -> Bag of <Number, Charstring> 
 as
  select roundto(dist, 3), st from Number dist , Charstring st where
	(dist, st) in k_nearest_with_fn({1, 2, 3, 5}, 3, 
                      	    #'euclid', #'pictureFeatures');

lisp;

(checkequal
  "Knn operator (input function)utilizing XTREE index"
 ((osql "q11();")
  '(("Pic001") ("Pic002") ("Pic003"))))

(checkequal
 "Knn operator(input function) utilizing XTREE index"
 ((osql "q12();")
  '(("Pic002") ("Pic003") ("Pic003"))))

(checkequal
  "Knn operator (input bag) utilizing XTREE index "
 ((osql "q13();")
  '(("Pic002") ("Pic003") ("Pic003"))))

(checkequal
 "Naive knn (input bag) without XTREE index"
 ((osql "q14();")
  '((1.414 "Pic003") (1.0 "Pic001") (0.0 "Pic002"))))

(checkequal 
 "Naive knn(input function) without XTREE index"
 ((osql "q15();")
  '((1.414 "Pic003") (1.0 "Pic001") (0.0 "Pic002"))))

:osql