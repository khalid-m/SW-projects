create function getcolPmap(Charstring tab,Charstring pid, Charstring upv) ->Charstring
as select col from Charstring col where pMap(tab,col,upv)=pid;

create function get_columnURIs_fromNT(Charstring ntfile)->Charstring
/*Retrieves all the URIs corresponding to columns*/ 
as
	select s
	from charstring s, charstring p,charstring v
	where returnspv(ntfile)=(s,p,v) and like_i(v, "*property*");


create function get_columnURIs(Charstring abb)->Charstring 
as parse_sparql("SELECT ?s 
	     	  FROM <"+abb+">
	     	  WHERE {?s ?p ?val.
		  FILTER REGEX (?val,'*Property*').
		  FILTER REGEX (?p, '*type*').}"); 


create function get_tablePksURIsQ(Charstring abb, Charstring ontology,Charstring tname)->Charstring
as  parse_sparql("SELECT ?val ?p1 ?val1
	     FROM <"+abb+">
	     WHERE {?s ?p ?val.
	      FILTER REGEX (?p,'*PRIMARY_KEY*').
	       FILTER REGEX (?s, '*"+ontology+"#"+tname+"*').	 
		   ?val ?p1 ?val1.
	       FILTER REGEX (?p1,'*rdf-syntax-ns#_*').}");



create function get_tableFksURIsQ(Charstring abb, Charstring ontology,Charstring tname)->Charstring
as  parse_sparql("SELECT ?val ?p1 ?val1 ?val2
		   FROM <"+abb+">
                   WHERE {?s ?p ?val.
	       	   FILTER REGEX (?p,'*FOREIGN_KEY*').
		   FILTER REGEX (?s, '*"+ontology+"#"+tname+">').
		   ?val ?p1 ?val1.
		   FILTER REGEX (?p1,'*rdf-syntax-ns#_*').
		   ?val1 ?p2 ?val2.
		   FILTER REGEX (?p2,'*REFERENCES*').}");


create function get_FKowner_col(Charstring abb, Charstring ont,Charstring tn)->Charstring
/*Retrieves the name of the FK owner table*/
as select tnouri 
   from Charstring tnouri, Charstring tno, Charstring cno, Charstring rdf,
        Charstring cnouri,Vector ve 
   where ve in evalv(get_tableFksURIsQ(abb,ont,tn)) and 
         rdf=ve[1] and 
         like(rdf,"*www.w3.org/1999/02/22-rdf-syntax*") and 
         cnouri=ve[3] and 
         cnouri=pMap(tno,cno,abb) and 
         cMap(tno,abb)=tnouri;


create function orderNum_rdfseq(Charstring rdfseq,Charstring uri)->Number
as
	select atoi(substring (uri,char_length(rdfseq)+6,char_length(uri)-2));



create function get_tablePKURIs(Charstring abb, Charstring ontology,Charstring tname)->(Number,Charstring)
/*Retrieves the primary key columns and their order */
as
   select p1,v1 from Charstring v, Number p1, Vector ve, Charstring p,Charstring v1
	where ve in evalv(get_tablePksURIsQ(abb,ontology,tname)) and p=ve[1] and p1=orderNum_rdfseq("http://www.w3.org/1999/02/22-rdf-syntax",p)  and v=ve[2] and v1=getcolPmap(tname,v,abb);


create function bagf_get_tablePKURIs(Charstring abb, Charstring ontology,Charstring tname)->(Integer,Vector of Charstring)
as bagify(sortbagby(get_tablePKURIs(abb,ontology,tname),1,'inc'));
	

create function combine_pkcols(Charstring abb, Charstring ontology,Charstring tname,Vector vals)->(Charstring,Charstring)
/*Makes the pk string and the values*/
as 
   begin
	declare Charstring pks, Charstring pkval;
	set pks="";
	set pkval="";
	for each integer i,vector of Charstring vec,integer j,literal ll where bagf_get_tablePKURIs(abb,ontology,tname)=(i,vec) and (j,ll) in bagify(vals) and i=j
	  begin
	    set pks=pks+vec[1]+",";
	    set pkval=pkval+"'"+cast(ll as Charstring) +"',";
	  end;	  
	return (substring(pks,0,char_length(pks)-2), substring(pkval,0,char_length(pkval)-2));
   end;




create function get_columnName_fromNT(Charstring ntfile,Charstring tableURI,Charstring columnURI) -> Charstring
as 
/*Retrieves the column name from the column URI if such exists*/
 if ( some(select true where get_columnURIs_fromNT(ntfile)=columnURI)) then
	return substring(columnURI,char_length(tableURI),char_length(columnURI)-2);



create function get_columnURI_fromNT(Charstring ntfile,Charstring tableURI)->Charstring colURI
as
/*Retrieves the column names of the table from its URI*/
  	select s from charstring s, charstring p,charstring v
	where returnspv(ntfile)=(s,p,v) and like(p,"*domain*")and v=tableURI ;



create function get_columnURI(Charstring tabURI,Charstring abb)->Charstring
as select ch from Charstring ch, Vector vect where
		sparql("SELECT ?s 
		  FROM <"+abb+">
	     	  WHERE {?s ?p ?val.
		  FILTER REGEX (?p,'*domain*').
		  FILTER REGEX (?val,'*"+tabURI+"*').}")=vect and ch=vect[0];

create function get_columnName(Charstring tableURI,Charstring columnURI,Charstring upv) -> Charstring
as 
/*Retrieves the column name from the column URI if such exists*/
 if ( some(select true where eval(get_columnURIs(upv))=columnURI)) then
	return substring(columnURI,char_length(tableURI),char_length(columnURI)-2);


create function assignPMaptable_fromNT(Charstring ontol,Charstring upv, Charstring cid)->Boolean
as
	for each Charstring pid where get_columnURI(cid,upv)=pid
		 set pMap(get_tableNames(ontol,cid,upv),get_columnName(cid,pid,upv),upv)=pid;


create function assignCPMap_fromNT(Charstring ontol,Charstring upv)->Boolean
as
	for each Charstring cid where eval(get_tableURIs(upv))=cid
          begin
	 	set cMap(get_tableNames(ontol, cid,upv),upv)=cid;
		for each Charstring pid where get_columnURI(cid,upv)=pid
		 	set pMap(get_tableNames(ontol,cid,upv),get_columnName(cid,pid,upv),upv)=pid;
	  end;



create function get_columnName_fromTable(Charstring ntfile,Charstring tabURI)-> (Charstring col,Charstring colURI)
as
	select get_columnName_fromNT(ntfile,tabURI,colURI),colURI from Charstring colURI where colURI=get_columnURI_fromNT(ntfile,tabURI);
	


create function get_columnType_fromNT(Charstring ntfile,Charstring columnURI) -> Charstring coltype
as 
	select  find_typeCol(substring(v,1,char_length(v)-2))
	from charstring s, charstring p,charstring v
	where returnspv(ntfile)=(s,p,v) and s=columnURI and like(p, "*range*");


create function get_columnURI_fromColName(Charstring sch,Charstring tabURI,Charstring colname)->Charstring
as
	select colU from Charstring colU where get_columnName_fromTable(sch,tabURI)=(colname,colU);

