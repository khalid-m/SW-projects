create function get_columnSize_fromNT(Charstring columnURI) -> Charstring coltype
as 
	select v
	from charstring s, charstring p,charstring v
	where schemaDB()=(s,p,v) and s=columnURI and like_i(p, "*size");
*/


create function get_tabcolNames_fromTable(Charstring ntfile,Charstring ontol)->(Charstring tabname,Charstring colname,Charstring coltype) 
/*Retrieves the tables names with their column names, types */
as
  	for each original Charstring tabURI, Charstring col, Charstring colURI where tabURI=get_tableURIs_fromNT(ntfile) and get_columnName_fromTable( ntfile,tabURI)= (col,colURI)
	  return (get_tableName_fromNT(ntfile,ontol,tabURI),col,get_columntype_fromNT(ntfile,colURI));




create function list_colNames(Charstring sch,Charstring tableURI)->Charstring
/*Makes a list with empty string which number is equal the number of the columns in table, tableURI*/
as
  begin
	declare Charstring collist, Charstring emptylist,Charstring res1, Charstring res2;
/*	set collist="";*/
	set emptylist="";
	for each Charstring col,Charstring colURI where get_columnName_fromTable(sch,tableuRI)=(col,colURI) 	
	   begin
	/*	set collist=collist+","+col;*/
		set emptylist=emptylist+","+"''";
    	   end;
	/*set res1 = substring(collist, 1,char_length(collist));*/
	set res2= substring(emptylist, 1,char_length(emptylist));
	return res2;
  end;

create function list_colNames1(Charstring sch,Charstring tableURI)->Charstring
/*Makes a list of the columns in table, tableURI*/
as
  begin
	declare Charstring collist, Charstring collist;
	set collist="";
	for each Charstring col, Charstring colURI where get_columnName_fromTable(sch,tableuRI)=(col,colURI) 	
	 	set collist=collist+","+col;
	return substring(collist, 1,char_length(collist));
  end;



create function insert_intoTab_fromNTP(Charstring schnt,Charstring datant,Charstring ontol)-> Charstring
/*Constructs INSERT statements and inserts rows in a RDB from N-Triples in row-order*/
as
  begin
    declare Charstring stat1, Charstring stat2, Charstring tname, Charstring row;
    set row="";
  	for each original Charstring subject, Charstring property, Charstring value where returnspv(datant)=(subject, property, value) 
           begin
		if (subject!=row) then
		  begin
			if (row!="") then
			  return "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-2)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-2) + ");";
		    set stat1="";
		    set stat2="";	
		    set row=subject;
		    set tname=get_tableName_fromRowID(schnt,ontol,subject)
                  end;
		   /* if (notany(like("'"+value+"'","*null*"))) then
		     begin*/
			/* if value is URI .... */
			set stat1=get_columnName_fromNT(schnt,get_tableURI_fromRowID(schnt,ontol,subject),property)+","+stat1;	
                  	set stat2="'" + value+"',"+stat2;
                  /*   end;*/
	   end;
		return "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-2)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-2) + ");";
    end;



create function insert_intoTab(Charstring upv,Charstring datant,Charstring ontol)-> Charstring
/*Constructs INSERT statements and inserts rows in a RDB from N-Triple files datant, ordered in row-order*/
as
  begin
    declare Charstring stat1, Charstring stat2, Charstring tname, Charstring tURI,Charstring row,Charstring ch1, Charstring ch2;
    set row="";
  	for each original Charstring subject, Charstring property, Charstring value where returnspv(datant)=(subject, property, value) 	 begin
/*	 if notany(like_i(property, "*type*")) then  
           begin*/
	     if (subject!=row) then
               begin                          
		 if (row!="") then
                    return "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-1)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-1) + ");";
		  set row=subject;
		  set tname=get_tableName_fromRowID(upv,ontol,subject);
		  set tURI=get_tableURI_fromRowID(upv,ontol,subject);
		  select c1,c2 into ch1, ch2 from Charstring c1, Charstring c2 where combine_pkcols(upv, ontol,tname, row_ident(subject,tURI))= (c1,c2);
		  set stat1=ch1;
		  set stat2=ch2;
	       end;
	       if notany(like_i(property, "*type*")) then  
                 begin
	       		set stat1=stat1+","+getcolPmap(tname,property,upv);	
	       	 	if notany(like(value,"<*>")) then
                  		set stat2= stat2+",'" + value+ "'"
 		   	else
	/*if the value is a FK value, OBS:hardcoded for a simple FK, one column*/
                     	begin
				select c into ch2 from Charstring c,Vector vect where row_ident(value,get_FKowner_col(upv,ontol,tname))=vect and c= vect[0];
		 		set stat2=stat2+",'"+ch2+"'";     
		    	end;	
		end;
        /*   end;*/
          end;
          return "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-1)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-1) + ");";
  end;

create function insert_intoTab(jdbc jd,Charstring upv,Charstring datant,Charstring ontol)-> Charstring
/*Inserts rows in a RDBMS from N-Triple files datant, ordered in row-order*/
as
  begin
    declare Charstring stat1, Charstring stat2, Charstring tname, Charstring tURI,Charstring row,Charstring ch1, Charstring ch2;
    set row="";
  	for each original Charstring subject, Charstring property, Charstring value where returnspv(datant)=(subject, property, value) 	 begin
	     if (subject!=row) then
               begin                          
		 if (row!="") then
                    sql(jd, "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-1)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-1) + ");");
		  set row=subject;
		  set tname=get_tableName_fromRowID(upv,ontol,subject);
		  set tURI=get_tableURI_fromRowID(upv,ontol,subject);
		  select c1,c2 into ch1, ch2 from Charstring c1, Charstring c2 where combine_pkcols(upv, ontol,tname, row_ident(subject,tURI))= (c1,c2);
		  set stat1=ch1;
		  set stat2=ch2;
	       end;
	       if notany(like_i(property, "*type*")) then  
                 begin
	       		set stat1=stat1+","+getcolPmap(tname,property,upv);	
	       	 	if notany(like(value,"<*>")) then
                  		set stat2= stat2+",'" + value+ "'"
 		   	else
	/*if the value is a FK value, OBS:hardcoded for a simple FK, one column*/
                     	begin
				select c into ch2 from Charstring c,Vector vect where row_ident(value,get_FKowner_col(upv,ontol,tname))=vect and c= vect[0];
		 		set stat2=stat2+",'"+ch2+"'";     
		    	end;	
		end;
          end;
          sql(jd,"INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-1)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-1) + ");");
  end;





create function insert_intoTab_fromNTP(jdbc j,Charstring schnt,Charstring datant,Charstring ontol)-> Charstring
/*Constructs INSERT statements and inserts rows in a RDB from N-Triples in row-order*/
as
  begin
    declare Charstring stat1, Charstring stat2, Charstring tname, Charstring row;
    set row="";
  	for each original Charstring subject, Charstring property, Charstring value where returnspv(datant)=(subject, property, value) 
           begin
		if (subject!=row) then
		  begin
			if (row!="") then
			  sql(j, "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-2)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-2) + ");");
		    set stat1="";
		    set stat2="";	
		    set row=subject;
		    set tname=get_tableName_fromRowID(schnt,ontol,subject)
                  end;
		    if (notany(like("'"+value+"'","*null*"))) then
		     begin
			set stat1=get_columnName_fromNT(schnt,get_tableURI_fromRowID(schnt,ontol,subject),property)+","+stat1;	
                  	set stat2="'" + value+"',"+stat2;
                     end;
	   end;
		sql(j, "INSERT INTO " + tname+ "(" + substring(stat1,0,char_length(stat1)-2)  + ") VALUES (" + substring(stat2,0,char_length(stat2)-2) + ");");
    end;


create function make_eqstatements(Vector of Charstring pkcolumns)->Charstring
/*Creates the pimary key equalities for the stored procedures*/
as
  begin
   declare Charstring st,Integer num;
   set st="";
   set num=0;
	for each Charstring el where el=in(pkcolumns)
   	  begin
	    set st=st+el+"=@numID"+num+" and ";
	    set num = num+1;
          end;
    return substring(st,0,char_length(st)-6);
  end;

create function make_varlist(Vector of Charstring pkcolumns)->Charstring
/*Creates the pimary key equalities for the stored procedures*/
as
  begin
   declare Charstring st,integer num;
   set st="";
   set num=0;
	for each Charstring el where el=in(pkcolumns)
   	  begin
	    set st=st+"@numID"+num+",";
	    set num = num+1;
          end;
    return substring(st,0,char_length(st)-2);
  end;


create function make_pklist(Vector of Charstring pkcolumns)->Charstring
/*Creates the pimary key equalities for the stored procedures*/
as
  begin
   declare Charstring st;
   set st="";
	for each Charstring el where el=in(pkcolumns)
   	      set st=st+el+",";
     return substring(st,0,char_length(st)-2);
  end;

create function make_vars(Charstring sch,Charstring tabURI,Vector pkcolumns)->Charstring
/*Creates the variables needed fo the stored procedures*/
as
 begin
   declare Charstring st,Integer num,Charstring typ,Charstring colURI;
   set st="";
   set num=0;
 	for each Charstring el where el=in(pkcolumns)
   	  begin  
	    set colURI=get_columnURI_fromColName(sch,tabURI,el);
    	    set typ=get_columnType_fromNT(sch,colURI);	
	    set st=st+"@numID"+num+" "+ typ+", ";
	    set num = num+1;
          end;
    return substring(st,0,char_length(st)-3);
  end;


create function columnProcedures(Charstring sch,Charstring tabURI,Charstring tname, Vector of Charstring keycol,Charstring colname, Charstring collist,Charstring emptyvals,Charstring coltype)-> Charstring
/*Creates a stored procedure in MS SQL server*/
as
 return "create procedure intoCol_"+tname+"_"+colname+"       																		     	     " + 
		make_vars(sch,tabURI,keycol)+", 
		@val "+ coltype+"
		AS
		  begin
			DECLARE @num int;
			if not exists(SELECT "+ make_pklist(keycol)+ " FROM "+tname +" WHERE "+ make_eqstatements(keycol)+")		
	  		   BEGIN
				INSERT INTO "+ tname+"("+ make_pklist(keycol)+","+collist+") VALUES("+ make_varlist(keycol)+","+emptyvals+");
				UPDATE "+tname + " SET "+ colname+"=@val WHERE "+ make_eqstatements(keycol) +";
		      	    END
			else
			  UPDATE "+tname+" SET "+ colname+" =@val WHERE "+ make_eqstatements(keycol)+";
		end;"; 


create function columnProcedures(Charstring tname, Charstring keycol,Charstring colname, Charstring collist,Charstring emptyvals,Charstring coltype)-> Charstring
/*Creates a stored procedure in MS SQL server*/
as
 return "create procedure intoCol_"+tname+"_"+colname+" 
		@numID int, 
		@val "+ coltype+"
		AS
		  begin
			DECLARE @num int;
			SET @num=(SELECT "+keycol+ " FROM "+tname +" WHERE "+ keycol+"=@numID);
			if @num is null 
	  		BEGIN
				INSERT INTO "+ tname+"("+keycol+","+collist+") VALUES(@numID,"+emptyvals+");
				UPDATE "+tname + " SET "+ colname+"=@val WHERE "+keycol+"=@numID;
		      	END
		else
			UPDATE "+tname+" SET "+ colname+" =@val WHERE "+keycol+"=@numID;
		end;";

create function createProcedures(jdbc j,Charstring sch,Charstring ontol)-> Boolean
as
  begin
	declare Charstring collist1, Charstring collist2, Charstring colname, Charstring cURI, Charstring coltype, Charstring colsize, Charstring colt, Vector of Charstring key_col;
	for each Charstring tabURI where tabURI=get_tableURIs_fromNT(sch)
          begin
	   set collist1=""; set collist2="";
	   set key_col= get_pkcolumns_fromURIst(get_primaryK(sch,tabURI));
	   for each Charstring col, Charstring colURI where get_columnName_fromTable(sch,tabURI)= (col,colURI) 
		begin
               	  if (notany(like(col,in(key_col)))) then
		    begin
		  	set collist1=collist1+","+col;
		  	set collist2=collist2+","+"''";
		    end;
                 end;
		set collist1=substring(collist1, 1,char_length(collist1));
		set collist2=substring(collist2,1,char_length(collist2));
	    for each Charstring col, Charstring colURI where get_columnName_fromTable(sch,tabURI)= (col,colURI) 
		begin
		  set coltype=get_columnType_fromNT(sch,colURI);
		  set colsize= 500;/*??????*/
		  if (like_i(coltype,"int*")) then
			set colt=coltype
		  else if ( like_i(coltype,"float*")) then	
			set colt=coltype
		  else if ( like_i(coltype,"datetime*")) then	
			set colt=coltype
		  else
			set colt=coltype+"("+colsize+")";
	     		/*return columnProcedures(get_tableName_fromNT(tabURI),get_tableName_fromNT(tabURI)+"_rowid",col,collist1,collist2,colt);*/
		    if (sql(j, columnProcedures(sch,tabURI,get_tableName_fromNT(sch,ontol,tabURI),key_col,col,collist1,collist2,colt))) then
				print( "The procedure  intoCol_"+ get_tableName_fromNT(sch,ontol,tabURI)+"_"+col+" was created");
  		end;
          end;
  end;



create function dropProcedures(jdbc j,Charstring sch,Charstring ontol)-> Boolean
as
  for each Charstring tabURI,Charstring col, Charstring colURI where tabURI=get_tableURIs_fromNT(sch) and get_columnName_fromTable(sch,tabURI)= (col,colURI) 
	sql(j, "drop procedure intoCol_"+get_tableName_fromNT(sch,ontol,tabURI)+"_"+col+";");



create function insert_intoCols(Charstring sch, Charstring ontol,Charstring datant)-> Charstring
/*Inserts values in columns in a RDB by stored procedures from N-Triples in column-order*/
as
  begin
    declare Charstring stat1, Charstring stat2, Charstring tname, Charstring collist1,Charstring collist2,Charstring coltype,Charstring procname;
     	for each original Charstring subject, Charstring property, Charstring value where returnspv(datant)=(subject, property, value) 
           begin
		set tname=get_tableName_fromRowID(sch,ontol,subject);
		set stat1=get_columnName_fromNT(sch,get_tableURI_fromRowID(sch,ontol,subject),property);	
		set stat2="'" + value+"'";
		set procname="intoCol_"+tname+"_"+stat1;
		return ("exec "+procname+ " "+  get_PrimaryK_value(sch,ontol,subject)+","+stat2+";");

           end;
    end;


create function insert_intoCols(jdbc j,Charstring sch, Charstring ontol,Charstring datant)-> Charstring
/*Inserts values in columns in a RDB by stored procedures from N-Triples in column-order*/
as
  begin
    declare Charstring stat1, Charstring stat2, Charstring tname, Charstring collist1,Charstring collist2,Charstring coltype,Charstring procname;
     	for each original Charstring subject, Charstring property, Charstring value where returnspv(datant)=(subject, property, value) 
           begin
		set tname=get_tableName_fromRowID(sch,ontol,subject);
		set stat1=get_columnName_fromNT(sch,get_tableURI_fromRowID(sch,ontol,subject),property);	
		set stat2="'" + value+"'";
		set procname="intoCol_"+tname+"_"+stat1;
		sql(j,"exec "+procname+ " "+  get_PrimaryK_value(sch,ontol,subject)+","+stat2+";");

           end;
    end;


