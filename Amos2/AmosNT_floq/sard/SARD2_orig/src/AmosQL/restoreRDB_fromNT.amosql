create function returnspv(Charstring filen)->(Charstring,Charstring,Charstring )
/*Return the triples (s,p,v) from the NT filen*/
as
	select vec[0],vec[1],vec[2] from  Vector vec 
        where vec in read_Ntuples(filen);

create function populate_stored_trips(Charstring file, Charstring abb)->Boolean
/*Defines an RDF view over the N-triples file
 abb is the name that will be used in the WHERE clause*/
 as eval("create function stored_trips_"+abb+"()->(Charstring,Charstring,Charstring)
	as select s,p,v from Charstring s, Charstring p, Charstring v 
	where returnspv('"+file+"')=(s,p,v);");



create function get_tableURIs(Charstring abb)->Charstring as 
	parse_sparql("SELECT ?s 
	     	  FROM <"+abb+">
	     	  WHERE {?s ?p ?val.
		  FILTER REGEX (?val,'*Class*').
		  FILTER REGEX (?p, '*type*').}"); 


create function get_tableURIs_fromNT(Charstring ntfile)->Charstring
/*Retrieves all the URIs corresponding to tables*/ 
as
	select s
	from charstring s, charstring p,charstring v
	where returnspv(ntfile)=(s,p,v) and like_i(v, "*class*") and like_i(p, "*type*");


create function get_tableNames(Charstring ontol,Charstring tableURI, Charstring abb)->Charstring
/*Retrieves the table name from its URI*/
as
   if ( some(select true where eval(get_tableURIs(abb))=tableURI)) then
	return substring(tableURI,char_length(ontol)+2,char_length(tableURI)-2);



create function get_tableName_fromNT(Charstring ntfile,Charstring ontol,Charstring tableURI)->Charstring
/*Retrieves the table name from its URI*/
as
   if ( some(select true where get_tableURIs_fromNT(ntfile)=tableURI)) then
	return substring(tableURI,char_length(ontol)+2,char_length(tableURI)-2);



create function get_tableName_fromRowID(Charstring ntfile,Charstring ontol,Charstring rowID)->Charstring
/*Retrieves the table name from the URI of a row record rowID by comparing rowID with all the URIscorresponding to tables*/
as
     for each Charstring ch where ch=get_tableURIs_fromNT(ntfile)
        if (like (rowID,substring(ch,0,char_length(ch)-4)+'*')) then
		return get_tableName_fromNT(ntfile,ontol,ch);


create function get_tableName_fromRowID1(Charstring ontol,Charstring rowID,Charstring abb)->Charstring
/*Retrieves the table name from the URI of a row record rowID by comparing rowID with all the URIscorresponding to tables*/
as
     for each Charstring ch where ch=eval(get_tableURIs(abb))
        if (like (rowID,substring(ch,0,char_length(ch)-4)+'*')) then
		return get_tableNames(ontol,ch,abb);

create function get_tableName_fromRowID2(Charstring upv,Charstring ontol,Charstring rowID)->Charstring
/*Retrieves the table name from the URI of a row record rowID by comparing rowID with all the URIscorresponding to tables*/
as
     for each Charstring tname, Charstring cid where cMap(tname,upv)=cid
        if (like (rowID,substring(cid,0,char_length(cid)-4)+'/_*>')) then
		return tname;


create function get_tableURI_fromRowID(Charstring upv,Charstring ontol,Charstring rowID)->Charstring
/*Retrieves the table URI form a rowID by */
as
     for each Charstring tname, Charstring cid where cMap(tname,upv)=cid
        if like(rowID,substring(cid,0,char_length(cid)-4)+'/_*>') then
		return cid;


create function get_tableURI_fromRowID1(Charstring ntfile,Charstring ontol,Charstring rowID)->Charstring
/*Retrieves the table URI from the URI of a row record rowID by comparing rowID with all the URIscorresponding to tables*/
as
     for each Charstring ch where ch=get_tableURIs_fromNT(ntfile)
        if (like (rowID,substring(ch,0,char_length(ch)-2)+'*')) then
		return substring(rowID,0,char_length(ch)-2)+">";  


create function get_PrimaryK_value(Charstring ntfile,Charstring ont,Charstring rowID)->Literal
/*Retrieves the value of the primary key from the URI of the row*/
as 
	select in(pks) from vector pks where rowid( substring(get_tableURI_fromRowID(ntfile,ont,rowID),1, char_length(get_tableURI_fromRowID(ntfile,ont,rowID))-2),pks)= substring(rowID,1,char_length(rowid)-2) and pks!={}; 


create function get_primaryKURI_fromNT(Charstring sch,Charstring tabURI)->Charstring
/*Retrieves the URI of the primary key of the table with tabURI*/
as
	select val from Charstring s,Charstring p,Charstring val 
	where like_i(p,"*primary_keys*") and s =tabURI and returnspv(sch)=(s,p,val);

create function get_primaryK(Charstring sch, Charstring tabURI)->Charstring
/*Retrieves the string of the primary key columns*/
as
   begin
      if ( some(select true where get_tableURIs_fromNT(sch)=tabURI)) then
        begin
	  declare Charstring str;
	  set str=get_primaryKURI_fromNT(sch,tabURI);
	  if ( str!= "NULL") then
	    return substring(str,char_length(tabURI),char_length(str)-2);
        end;
   end;


