create function isColOf(Relational r, 
	                Charstring tbl, 
	                Charstring col)->Boolean
  as 
   select true
   from Charstring dummy,Charstring native_col
   where columns(r,tbl)=(dummy,native_col) and like_i(col, native_col);


create function isTblOf(Relational r, 
	                Charstring tbl)->Boolean
  as 
   select true
   from Charstring dummy1,
        Charstring dummy2,
        Charstring dummy3,
        Charstring native_tbl
   where tables(r)=(native_tbl,dummy1,dummy2,dummy3) and 
         like_i(native_tbl,tbl);

/* Definition of schema view. 
 */  
create function SchemaView(Charstring upv)->
		 (Charstring s,Charstring p,Charstring val)
as
 select s,p,val
 from Charstring tn,Charstring cn, URI prop,
       URI class
 where (cMap(tn,upv,class) and
        s = class and
        p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
        val = 'http://www.w3.org/2000/01/rdf-schema#Class') or
       (cMap(tn,upv,class) and
 	pMap(tn,cn,upv,prop) and
        s = prop and
        p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
        val = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
       (pMap(tn,cn,upv,prop) and
        cMap(tn,upv,class) and
        s = prop and
        p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
        val = class) or
       (pMap(tn,cn,upv,prop) and
        cMap(tn,upv,class) and
	s = prop and
	p = 'http://www.w3.org/2000/01/rdf-schema#range' and
	val = 'http://www.w3.org/2000/01/rdf-schema#Literal');

/* Fn materializing the schema view.
 */
create function SchemaViewMaterialize(Charstring upv)->Boolean 
as 
 begin
  eval("create function s" + upv 
	+ "(Charstring s,Charstring p,Charstring val)->
		Boolean as stored;");
 
  eval("declare_key(theresolvent('s" + upv + "'),{'s','p','val'});");

   /* Since the schema view resides in main memory the cost is 2 and fanout is
    * very small
    */
  eval("costhint('Charstring.Charstring.Charstring.s" + upv + "->Boolean',
		'fbf',{2,1});");

  eval("parteval('s" + upv + "');");

  begin
   for each Charstring s, Charstring p, Charstring val 
    where (s,p,val) = SchemaView(upv)
    begin
     eval("add s" + upv + "('" + s + "','" + p + "','" + val + "')=true;");
    end;
  end;

  eval("create function s" + upv + "()->
	(Charstring s,Charstring p,Charstring val) 
		as select s, p, val where s" + upv + "(s,p,val);");
 end;

/* Extending schema view definition to incorporate triples about class relationshop properties.
 */
create function CRSchemaView(Charstring upv)->
		 (Charstring s,Charstring p,Charstring val)
as
 select s,p,val
 from Charstring tn,Charstring otn,Charstring cn, URI prop,
       URI class
 where (rMap(tn,cn,otn,upv,prop) and
        cMap(otn,upv,class) and
	s = prop and
	p = 'http://www.w3.org/2000/01/rdf-schema#range' and
	val = class) or
       (cMap(tn,upv,class) and
 	rMap(tn,otn,cn,upv,prop) and
        s = prop and
        p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
        val = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
       (rMap(tn,cn,otn,upv,prop) and
        cMap(tn,upv,class) and
        s = prop and
        p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
        val = class);



/* Fn materializing the extended schema view.
 */
create function CRSchemaViewMaterialize(Charstring upv)->Boolean 
as 
 begin
   for each Charstring s, Charstring p, Charstring val 
    where (s,p,val) = CRSchemaView(upv)
    begin
     eval("add s" + upv + "('" + s + "','" + p + "','" + val + "')=true;");
    end;
  end;



 
/* Fn for definition of content view
 */
create function defineCV(Charstring upv)->Boolean
  as
   begin
    eval("create function c" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
         as 
          select s,p,val 
          where p" + upv + "() = (s,p,val);");
   end;

/* Fn for definition of UPVd
 */
create function defineUPV(Charstring upv)->Boolean
  as
   begin
    eval("create function " + upv + "()->
          (Charstring s,Charstring p,Charstring val)
         as
          select s,p,val where s" + upv + "() = (s,p,val) or 
                               c" + upv + "() = (s,p,val);");
   end;

/* Fn for definition of SQL UPV
 */
create function defineSUPV(Charstring upv)->Boolean
  as
   begin
    eval("create function #" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
         as 
          select s,p,val
          where (s,p,val) = " + upv + "();");
   end;

create function SWOfUPV(Charstring upv)->Charstring sw as stored;
create function CWOfUPV(Charstring upv)->Charstring cw as stored;


/* Dynamically calling UPV 
 */	
create function UPVTriples(Charstring UPV)-> Vector
as 
 select call_function(upv,{});

create function schemaTriples(Charstring UPV)-> Vector
as 
 select call_function(swofupv(upv),{});

create function contentTriples(Charstring UPV)-> Vector
as 
 select call_function(cwofupv(upv),{});       


/* Key declarations 
 */


declare_key(theresolvent(
             'Charstring.Charstring.Charstring.URI.pMap->Boolean'),
               {'tn','cn','upv'});
declare_key(theresolvent(
             'Charstring.Charstring.Charstring.URI.pMap->Boolean'),
               {'upv','prop'});

declare_key(theresolvent(
             'Charstring.Charstring.Charstring.URI.pMap->Boolean'),
               {'tn','upv'});


declare_key(theresolvent('Charstring.Charstring.URI.cMap->Boolean'),
                          {'upv'});
declare_key(theresolvent('Charstring.Charstring.URI.cMap->Boolean'),
                          {'tn','upv'});
declare_key(theresolvent('Charstring.Charstring.URI.cMap->Boolean'),
                          {'tn','upv','class'});

declare_key(theresolvent('Charstring.Charstring.Function.TEVExtent->Boolean'),
                          {'tid','upv'});
declare_key(theresolvent('Charstring.Charstring.Function.TEVExtent->Boolean'),
                          {'vd'});

/* Very simple cost model.
 * Intuition: All main memory tables in SWARD are very small and 
 * have a low fanout and cost.
 */
costhint("Charstring.Charstring.Charstring.URI.pMap->Boolean",
	   "bbbb",{2,1}); 

costhint("Charstring.Charstring.URI.cMap->Boolean",
           "bbb",{2,1}); 

create function sp2areg(Charstring spreg)->Charstring areg as foreign 'sp2areg';
