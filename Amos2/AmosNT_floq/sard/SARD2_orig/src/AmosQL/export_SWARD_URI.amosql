/* Property mapping table
 * A table, column and UPV decides a property identifier i.e. 
 *  they make up a key in pMap.
 * A second key in pMap is UPV and property identifier that decides table 
 * and column.
 * There can be several underlying data sources since every UPV is associated 
 * with a data source. Table pMap is on BCNF. 
 */
create function pMap(Charstring tn,Charstring cn,Charstring upv,
                        URI prop)->Boolean
  as stored;

/* Wrapper for pMap stored fn. 
 */
create function pMap(Charstring tn,Charstring cn,Charstring upv)
                        ->URI prop
  as select prop where pMap(tn,cn,upv,prop);

create function getPMap(Charstring tn,Charstring cn,Charstring upv)
                          ->URI prop
  as select prop where pMap(tn,cn,upv,prop); 

/* Get those tbls refered to in pMap table. 
 */
create function getPMapTbls(Charstring upv)->Charstring tn
  as select distinct tn 
     from Charstring cn, URI prop 
     where pMap(tn,cn,upv,prop);

/* Get extent of pMap. 
 */
create function pMap()->(Charstring tn,Charstring cn,Charstring upv,URI propid)
as
 select tn,cn,upv,propid 
 where pMap(tn,cn,upv,propid);

/* Class mapping table 
 */
create function cMap(Charstring tn,Charstring upv,URI class)
                        ->Boolean
  as stored;

/* Wrapper for cMap stored fn.
 */
create function cMap(Charstring tn,Charstring upv)->URI class
  as select class where cMap(tn,upv,class);

/* Get extent of cMap. 
 */
create function cMap()->(Charstring tn,Charstring upv,URI classid)
as
 select tn,upv,classid 
 where cMap(tn,upv,classid);

create function cMap(Charstring upv)->(Charstring tn,URI class)
  as select tn,class where cMap(tn,upv,class)=true;

/* Setter fns for pMap and cMap 
 */	
create function assignPropID(Charstring tbl,
                             Charstring col,
                             Charstring upv,
                             URI propid)->Boolean
as
 begin
  set pMap(tbl,col,upv)=propid;
 end;	

create function assignClassID(Charstring tbl,
                              Charstring upv,
                              URI classid)->Boolean
as
 begin
  set cMap(tbl,upv)=classid;
 end;	
	
/* Defining TEVExtent table that maps a colid to 
 * corresponding domain calculus expression that 
 * defines the column triple extent of the colid. 
 */
create function TEVExtent(Charstring tid,
                          Charstring upv,
                          Function vd)->Boolean as stored;

/* Wrapper for TEVExtent stored fn.
 */
create function TEVExtent(Charstring tid,
                          Charstring upv)->Function vd
as 
  select vd 
  where TEVExtent(tid,upv,vd);


/* Stored fn rMap containing all foreign properties together with their respective 
 * relational columns for a given UPV. 
 */
create function rMap(Charstring tn,Charstring cn,Charstring otn,Charstring upv,URI relationship)
                        ->Boolean as stored;

declare_key(theresolvent(
             'Charstring.Charstring.Charstring.Charstring.URI.rMap->Boolean'),
               {'tn','cn','upv'});
declare_key(theresolvent(
             'Charstring.Charstring.Charstring.Charstring.URI.rMap->Boolean'),
               {'upv','relationship'});

/* Wrapper for rMap stored fn. 
 */
create function rMap(Charstring tn,Charstring cn,Charstring otn,Charstring upv)
                        ->URI prop
  as select prop where rMap(tn,cn,otn,upv,prop);

/* Get extent of rMap. (Silvia S)
 */
create function rMap()->(Charstring tn,Charstring cn,Charstring otn,Charstring upv,URI prop)
as
 select tn,cn,otn,upv,prop 
 where rMap(tn,cn,otn,upv,prop);

/* Setter fns for rMap. User not allowed to set the foreign property identifier of a column in a table
 * to a property identifier already existing in pMap for that column. 
 */	
create function assignCRID(Charstring tn,
                           Charstring cn,
                           Charstring otn,
                           Charstring upv,
                           URI crid)->Boolean
as
 begin
  set rMap(tn,cn,otn,upv)=crid
 end;

/* Defining fn that given a name of a function f returns f. 
 * If there exist more than one resolvent for f an exception is thrown. 
 */
create function resolventNamed(Charstring fn) -> Function
 as if count(resolvents(functionnamed(fn))) != 1 
    then error("Not exactly one resolvent",fn)
    else return resolvents(functionnamed(fn));

/* Get key of relational table. 
 */
create function getKey(Charstring ds,
  	                Charstring tn)
	                ->Charstring col
as 
 select col 
 from Charstring constraint 
 where (col,constraint) in primary_keys(JDBCOfDS(ds),catalogOfDS(ds),
                                        schemaOfDS(ds),tn);

/* Generate variables as part of UPV for RDB. 
 */
create function genRelvars(Charstring upv,
                            Charstring rname)->Charstring
as 
 begin
  declare Charstring relvars;
  set relvars= concatagg(inject((select "Charstring " +  rname + "_" + cname 
                                 from Charstring cname,Charstring ctype 
                                 where (ctype, cname) = 
                                        columns(JDBCOfDS(DSOfUPV(upv)),
                                         rname)), ","));
  if(relvars = "") then
   begin
    error("Could not extract any columns from table " + rname);
   end
  else
  return relvars; 
 end;

create function genRelvars1(Charstring upv)->Bag of Charstring
as
 begin
  for each Charstring tn,URI cid where cMap(tn,upv,cid)
   begin
    declare Charstring relvars;
    if (notany(functionnamed(upper(tn) + "_" + DSOfUPV(upv) + "_CC"))) 
    then  import_table(JDBCOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),
                        schemaOfDS(DSOfUPV(upv)),tn,'',false,{});
    set relvars = concatagg(inject((select "Charstring " +  tn + "_" + cn 
	                    from Charstring cn,Charstring ctype 
	                    where (ctype, cn) in 
                             columns(JDBCOfDS(DSOfUPV(upv)),tn)), ","));
    if(relvars = "") then
     error("Could not extract any columns from table " + tn);

    return relvars; 
   end;
 end;

create function genRelvarsCR1(Charstring upv)->Bag of Charstring
as
 begin
  for each Charstring tn,Charstring cn,Charstring otn,URI crid where rMap(tn,cn,otn,upv,crid)
   begin
    declare Charstring relvars;
    if (notany(functionnamed(upper(tn) + "_" + DSOfUPV(upv) + "_CC"))) 
    then  import_table(JDBCOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),
                        schemaOfDS(DSOfUPV(upv)),tn,'',false,{});
    set relvars = concatagg(inject((select "Charstring " +  tn + "_" + cn 
	                    from Charstring cn,Charstring ctype 
	                    where (ctype, cn) = 
                             columns(JDBCOfDS(DSOfUPV(upv)),tn)), ","));
    if(relvars = "") then
     error("Could not extract any columns from table " + tn);

    return relvars; 
   end;
 end;


create function genRelvars2(Charstring upv)->Charstring relvars
as 
 return concatagg(inject(genRelvars1(upv), ","));

create function genRelvarsCR2(Charstring upv)->Charstring relvars
as 
 return concatagg(inject(genRelvarsCR1(upv), ","));

/* Generate call to core cluster fn of table in 
 * exported relational database. 
 */
create function genRelcall(Charstring upv,
	                    Charstring rname)->Charstring r
as
 begin
  declare Charstring relcall;  
  set relcall=rname + "_" + DSOfUPV(upv) + "_cc()=(" + 
              concatagg(inject((select rname + "_" + cname 
                                from Charstring cname, Charstring ctype 
                                where (ctype, cname) = 
                                       columns(JDBCOfDS(DSOfUPV(upv)), 
                                        rname)), ",")) + ")";
  if(relcall="") then
   error("Could not extract any columns from table " + rname);
  
  return relcall;
 end;

/* Get primary key in owning relational table for foreign key in a table. 
 */
create function getFKeys(Charstring ds,
  	                 Charstring fktbl)->
                             (Charstring pktbl,Charstring pkcol,Charstring fkcol)
  as select pktbl,pkcol,fkcol  
     where (pktbl,pkcol,fkcol) in 
            imported_keys(JDBCOfDS(ds),catalogOfDS(ds),schemaOfDS(ds),fktbl);

/* Calculate if column is foreign key. 
 */
create function getFKey(Charstring cn,
                        Vector fkeys)->Vector
  as
   for each Vector fkey where fkey in(fkeys)
   begin
    if (cn = fkey[2]) then return fkey;
   end;

/* Fn returning true if cn is a column mapped to a foreign property and 
 * false othervise.
 */
create function isFProp(Charstring tn,Charstring cn)->Boolean 
  as
   select true from Charstring upv,URI fp,Charstring otn where rMap(tn,cn,otn,upv,fp);  

/* Calculate the RDFS range of a property mapped to a relational column. 
 */
/*
create function getRangeVal(Charstring upv,Charstring tn,Charstring cn)->Charstring
  as
  begin
   declare Vector pkey,Vector fkey;
   if(isFProp(tn,cn)) then
   begin
    set fkey=getFkey(cn,sortvector(vectorof(getFkeys(DSOfUPV(upv),tn)),'<'));
    if (fkey!=nil) then 
