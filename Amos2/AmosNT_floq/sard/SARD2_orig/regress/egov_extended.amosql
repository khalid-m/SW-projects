	?s ?p ?o  } ";

set :sparql15=
"CONSTRUCT { ?s ?p ?o }
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {<http://udbl.it.uu.se/schemas/eGovern#Form/_fid0> ?rel ?s .
	?s ?p ?o .} ";



/* Defining the results of and evaluating the example queries
 */
lisp;

(defglobal _schema_1_res_ 
  (sorttuples  '((#(#[URI "http://purl.org/dc/elements/1.1/description"]))
		(#(#[URI "http://purl.org/dc/elements/1.1/language"]))
 		(#(#[URI "http://purl.org/dc/elements/1.1/title"]))
 		(#(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEventID"]))
 		(#(#[URI "http://udbl.it.uu.se/schemas/eGovern#country"]))
 		(#(#[URI "http://udbl.it.uu.se/schemas/eGovern#parag"])))))

 
(defglobal _content_1_res_ 
  '((#("Adapt the personal number" NIL))
    (#("Job" "A citizen from one EU country intends to look for a job in another EU country ."))
    (#("Moving House" "A citizen intends to move from one EU country to another.")))
  )


 
(defglobal _hybrid_1_res_ 
  '((#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://udbl.it.uu.se/schemas/eGovern#forms_of_thelifeevents"] #[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields"] 25))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid1"] #[URI "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields"] 129))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid2"] #[URI "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields"] 59))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://www.egov_project.org/GovMLSchema#Creator"] #[USTR "National Tax Board of Sweden"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid1"] #[URI "http://www.egov_project.org/GovMLSchema#Creator"] #[USTR "National Tax Board of Sweden"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid2"] #[URI "http://www.egov_project.org/GovMLSchema#Creator"] #[USTR "http://www.workpermit.com"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://udbl.it.uu.se/schemas/eGovern#URL"] #[USTR "http://www.skatteverket.se/etjanster/skrivutpersonbevis.4.18e1b10334ebe8bc80001262.html"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid1"] #[URI "http://udbl.it.uu.se/schemas/eGovern#URL"] #[USTR "http://www.skatteverket.se/download/18.3dfca4f410f4fc63c86800010627/7665B5.pdf"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid2"] #[URI "http://udbl.it.uu.se/schemas/eGovern#URL"] #[USTR "http://www.workpermit.com/uk/employer_form.htm"]))))
  


(defglobal _opt2_res__ 
  '((#("http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_adaptpn" "Adapt the personal number" NIL NIL))
    (#("http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "Job" "A citizen from one EU country intends to look for a job in another EU country ." "JEU1023"))
    (#("http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "Moving House" "A citizen intends to move from one EU country to another." NIL)))
  )


(defglobal _opt3_res__
  '((#("http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_adaptpn" "Adapt the personal number" NIL NIL)) 
    (#("http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "Job" "JEU1023" "A citizen from one EU country intends to look for a job in another EU country .")) 
    (#("http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "Moving House" NIL "A citizen intends to move from one EU country to another.")))
  )

(defglobal _opt4_res__ 
  '((#("Adapt the personal number" ""))
    (#("Job" "A citizen from one EU country intends to look for a job in another EU country ."))
    (#("Moving House" "")))
  )

(defglobal _opt44_res__ 
  '((#("Adapt the personal number" ""))
    (#("Job" ""))
    (#("Moving House" "")))
