set :sparql_noopt0=
"SELECT ?s1 ?s ?val1 ?val2 ?val3
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/title> ?val1 .
	?s <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .
	?s <http://udbl.it.uu.se/schemas/eGovern#NumberOfFields> '25' .
        ?s1 <http://purl.org/dc/elements/1.1/description> ?val2 . 
	?s1 <http://udbl.it.uu.se/schemas/eGovern#parag> ?val3 } ";



set :cons_opt1=
"CONSTRUCT { ?s1 <http://purl.org/dc/elements/1.1/title> ?val1 .
	     ?s  <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .
	     ?s1 <http://purl.org/dc/elements/1.1/description> ?val2 .
	     ?s1 <http://udbl.it.uu.se/schemas/eGovern#parag> ?val3 .
	      }
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE 
	{?s1 <http://purl.org/dc/elements/1.1/title> ?val1 .
         ?s  <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .
	 ?s <http://udbl.it.uu.se/schemas/eGovern#NumberOfFields> '25'.
	 OPTIONAL {?s1 <http://purl.org/dc/elements/1.1/description> ?val2 .}
	 OPTIONAL {?s1 <http://udbl.it.uu.se/schemas/eGovern#parag> ?val3 .} } ";

