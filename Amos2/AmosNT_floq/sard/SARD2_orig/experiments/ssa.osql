/* create triple view from local mysql setting */ 

set :id="pssaDS";
set :url="jdbc:microsoft:sqlserver://localhost;DatabaseName=pssa";
set :driver="com.microsoft.jdbc.sqlserver.SQLServerDriver";
set :dbname="pssa";
set :usern="pssa";
set :passw="pssa";
set :catal="PSSA";
set :schem="pssa";

set :upv="pssa";
set :uriOfupv="http://user.it.uu.se/~udbl/pssa";

defineDS(:id,
         :url,
         :driver,
         :catal,
         :schem,
         :usern,
         :passw);


defineUPV(:id,:upv, :uriofupv);
/*defineUPV(:id,:upv_fn, :uriofupv_fn);*/

DSConnect(:upv);

wrapRDB(jdbcOfDS(:id), :dbname, :catal, :schem);

