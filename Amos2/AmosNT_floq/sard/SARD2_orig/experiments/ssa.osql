set ucMap("Source","pssa")="http://udbl.it.uu.se/PSSA/Source"; 
set ucMap("CrossNeighboursEDR","pssa")="http://udbl.it.uu.se/PSSA/"; 
set pmap("CrossNeighboursEDR","sdssPrimary","pssa")=URI("http://user.it.uu.se/~udbl/pssa#CrossNeighboursEDR/sdssPrimary");
set pmap("CrossNeighboursEDR","sdssType","pssa")=URI("http://user.it.uu.se/~udbl/pssa#CrossNeighboursEDR/sdssType");
set pmap("CrossNeighboursEDR","distanceMins","pssa")=URI("http://user.it.uu.se/~udbl/pssa#CrossNeighboursEDR/distanceMins");
set pmap("CrossNeighboursEDR","sdssID","pssa")=URI("http://user.it.uu.se/~udbl/pssa#CrossNeighboursEDR/sdssID");
