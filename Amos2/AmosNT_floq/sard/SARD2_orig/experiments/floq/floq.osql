/*RDF view of the meta data*/
set :id="metaDS";
set :url="jdbc:mysql://localhost:3306/metadb";
set :driver="com.mysql.jdbc.Driver";
set :dbname="metadb";
set :usern="regress";
set :passw="regress";
set :catal="metadb";
set :schem="";

set :upv="meta";
set :uriOfupv="http://user.it.uu.se/~udbl/machines/metaDB/";

defineDS(:id,
         :url,
         :driver,
         :catal,
         :schem,
         :usern,
         :passw);


defineUPV(:id,:upv, :uriofupv);
DSConnect(:upv);
assignIDs(:upv,:catal, :schem);
ViewRDB(:upv);

