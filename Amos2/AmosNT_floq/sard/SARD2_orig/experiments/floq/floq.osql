lisp;

(setq _rewrite_filter_ t)
(setq _save-intermediates_ t)

:osql


/*TO DO: Temporary */
create function mul()->(URI,URI,Literal)
as select  s,p,o from URI s,URI p,Literal o 
   where meta()=(s,p,o) or prod()=(s,p,o);

set :upv_q="mul";
set :uriOfupv_q="http://user.it.uu.se/~udbl/floq/";

defineDS("query",
         "",
         "",
         "",
         "",
         "",
         "");

defineUPV("query",:upv_q,:uriOfupv_q);


set :q33 = 
"select  ?ie ?ename ?val ?mv
 from <http://user.it.uu.se/~udbl/floq/>
 where { ?s <http://user.it.uu.se/~udbl/machines/metaDB/#site/location> 'Uppsala' .
	 ?s <http://user.it.uu.se/~udbl/machines/metaDB/#site/site>  ?site .
	 ?mi <http://user.it.uu.se/~udbl/machines/metaDB/#machineinstallation/site> ?site .
	 ?mi <http://user.it.uu.se/~udbl/machines/metaDB/#machineinstallation/ie>  ?ie .
	 ?si <http://user.it.uu.se/~udbl/machines/metaDB/#sensorinstallation/ie>   ?ie .
	 ?ma <http://user.it.uu.se/~udbl/machines/metaDB/#machine/e> ?e .
	 ?ma <http://user.it.uu.se/~udbl/machines/metaDB/#machine/ename> ?ename .
	 ?mi <http://user.it.uu.se/~udbl/machines/metaDB/#machineinstallation/e> ?e .
	 ?si <http://user.it.uu.se/~udbl/machines/metaDB/#sensorinstallation/ev>  ?ev .
	 ?si <http://user.it.uu.se/~udbl/machines/metaDB/#sensorinstallation/th>  ?th .
	 ?measa <http://user.it.uu.se/~udbl/prod#measuresA/logdbid> ?val .
	 ?measa <http://user.it.uu.se/~udbl/prod#measuresA/mv> ?mv .
	 ?s    <http://user.it.uu.se/~udbl/machines/metaDB/#site/logdbid> ?val .
	FILTER (?mv - ?ev > ?th) . }";
	 

eval("create function q33()-><Literal,Literal,Literal,Literal> as " + sparql_translate(:q33, true));

pc("q33");


/*Q: new test query in new set up  */
create function newq3()->(Integer, charstring, Integer, Number) as
select ie(si), ename(e), logdbid(s), mv(m)
from SENSORINSTALLATION@A si, SITE@A s, MEASURESA m, 
     MachineInstallation@A ie, Machine@A e
where location(s)='Uppsala' and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      s(m)=si(si) and
      logdbid(m)=logdbid(s);

pc("newq3");

count(newq3());

;