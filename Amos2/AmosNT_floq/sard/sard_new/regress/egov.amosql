/*-*-sql-*-********************************************************************
 * AMOS2
 *
 * Author: (c) 2007 Johan Petrini, UDBL
 *	       2010 Silvia Stefanova, UDBL (added queries with GCT rule)
 * 
 * Description: Master regression test of SWARD system exporting and querying 
 * the eGovernment relational database with strategy END-P.
 *
 * The following queries are tested:
 *
 *  Schema queries accessing the relational database schema.
 *  1. Give me all properties, except for the property
 *     http://purl.org/dc/elements/1.1/Identifier, of a life event.
 *
 *  Content queries accessing the relational database content.
 *  1. Give me the names and descriptions of all life events.
 *
 *  Hybrid queries joining schema and content data. 
 *  1. Give me all life event forms about moving and their properties 
 *     except for the properties http://udbl.it.uu.se/schemas/eGovern#FormID,
 *     http://udbl.it.uu.se/schemas/eGovern#LifeEventID and
 *     http://udbl.it.uu.se/schemas/eGovern#Concern.     
 ******************************************************************************/
/* Load regression setup  
 */		
<'egov_setup.amosql';

/* Generate the UPV according to END-P
 */
viewRDB("EGov");

parteval('pmap');
parteval('cmap');

parteval('rmap');

parteval('rowid');

lisp;
(setq _rewrite_row_and_like_ T)
:osql

/* SPARQL queries 
 */
set :sparql_schema_1 = 
"SELECT ?lifeeventprop
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?lifeeventprop <http://www.w3.org/2000/01/rdf-schema#domain> 
		<http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
 FILTER	(?lifeeventprop != <http://purl.org/dc/elements/1.1/identifier>) .}";

set :sparql_content_1 = 
"SELECT ?val1 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/title> ?val1 .
        ?s1 <http://purl.org/dc/elements/1.1/description> ?val2 .}";

set :sparql_hybrid_1 = 
"SELECT ?s2 ?p ?val3
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/description> ?val1 .
        ?s2 <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .
        ?p <http://www.w3.org/2000/01/rdf-schema#domain> 
         <http://udbl.it.uu.se/schemas/eGovern#Form> .
        ?s2 ?p ?val3 .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#FormID>) .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#LifeEventID>) .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#Concern>) .
 FILTER REGEX (?val1, '.*move.*') .}";


set :sparql_cont2 = 
"SELECT ?s1 ?p2 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
        ?s1 ?p2 ?val2 .}";



/* Defining the results of and evaluating the example queries
 */
lisp;
(defglobal _schema_1_res_ 
 (list 
  (list (listtoarray 
	(list "http://purl.org/dc/elements/1.1/description")))
  (list (listtoarray 
	(list "http://purl.org/dc/elements/1.1/language")))
  (list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/eGovern#parag")))
  (list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/eGovern#LifeEventID")))
(list (listtoarray 
	(list "http://udbl.it.uu.se/schemas/eGovern#lifeev_country")))
  (list (listtoarray 
	(list "http://purl.org/dc/elements/1.1/title")))))



(defglobal _content_1_res_ 
	(list 
	  (list 
	 	(listtoarray (list "Moving House" "A citizen intends to move from one EU country to another.")))
	  (list
		(listtoarray (list "Job" "A citizen from one EU country intends to look for a job in another EU country .")))))
	

(defglobal _hybrid_1_res_ 
 (list 
  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_0" "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields" "25")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_1" "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields" "129")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_2" "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields" "59")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_0" "http://www.egov_project.org/GovMLSchema#Creator" "National Tax Board of Sweden")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_1" "http://www.egov_project.org/GovMLSchema#Creator" "National Tax Board of Sweden")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_2" "http://www.egov_project.org/GovMLSchema#Creator" "http://www.workpermit.com")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_0" "http://udbl.it.uu.se/schemas/eGovern#URL" "http://www.skatteverket.se/etjanster/skrivutpersonbevis.4.18e1b10334ebe8bc80001262.html")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_1" "http://udbl.it.uu.se/schemas/eGovern#URL" "http://www.skatteverket.se/download/18.3dfca4f410f4fc63c86800010627/7665B5.pdf")))

  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#Form/_fid_2" "http://udbl.it.uu.se/schemas/eGovern#URL" "http://www.workpermit.com/uk/employer_form.htm")))))


(defglobal _cont2_
 (list 
  (list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://udbl.it.uu.se/schemas/eGovern#parag" "sql null")))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://udbl.it.uu.se/schemas/eGovern#parag" "JEU1023" )))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://purl.org/dc/elements/1.1/language" "EN" )))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://purl.org/dc/elements/1.1/language" "EN" )))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://purl.org/dc/elements/1.1/description" "A citizen intends to move from one EU country to another." )))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://purl.org/dc/elements/1.1/description" "A citizen from one EU country intends to look for a job in another EU country .")))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://purl.org/dc/elements/1.1/title" "Moving House")))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://purl.org/dc/elements/1.1/title" "Job")))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://udbl.it.uu.se/schemas/eGovern#LifeEventID" "eujob")))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://udbl.it.uu.se/schemas/eGovern#LifeEventID" "movinghouse" )))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" "http://udbl.it.uu.se/schemas/eGovern#LifeEvent" )))
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" "http://udbl.it.uu.se/schemas/eGovern#LifeEvent" ))) 
(list (listtoarray 
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse" "http://udbl.it.uu.se/schemas/eGovern#lifeev_country" "italy" )))
(list (listtoarray
   (list "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob" "http://udbl.it.uu.se/schemas/eGovern#lifeev_country" "germany")))
 ))




:osql
/* Regression test
 */
lisp;
(checkequal "SparQL schema query 1 with END-P"
	    ((sorttuples (osql "sparql(:sparql_schema_1);"))
	     (sorttuples _schema_1_res_)))

(checkequal "SparQL content query 1 with END-P"
	    ((sorttuples (osql "sparql(:sparql_content_1);"))
		(sorttuples _content_1_res_)))

(checkequal "SparQL hybrid query 1 with END-P"
	    ((osql "sparql(:sparql_hybrid_1);")
	     _hybrid_1_res_))

(checkequal "SparQL unbound-property query 1"
	    ((sorttuples (osql "sparql(:sparql_cont2);"))
	     (sorttuples _cont2_)))

(setq _unif_ t)

(setq _gct_ t)

(checkequal "SparQL unbound-property query 1 with GCT"
	    ((sorttuples (osql "sparql(:sparql_cont2);"))
	     (sorttuples _cont2_)))

(setq _unif_ nil)

(setq _gct_ nil)


:osql

DSDisconnect("eGov");