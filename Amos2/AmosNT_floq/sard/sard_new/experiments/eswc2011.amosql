defineDS("producer10milDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=producer10mil",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "producer10mil",
         "producer10mil",
         "product10mil",
         "product10mil");


defineUPV("producer10milDS","prod10mil", "http://user.it.uu.se/~udbl/sard/producer10mil");

DSConnect("prod10mil");	

wrapRDB(jdbcOfDS("producer10milDS"), "producer10mil", "producer10mil", "producer10mil");

assignIDs("prod10mil","producer10mil", "producer10mil");

ViewRDB("prod10mil");

parteval('pmap');
parteval('cmap');
parteval('rowid');
parteval('vector');
parteval('rmap1');
parteval('rmmmap');

lisp;
(setq  _el-corcl_ t)
(setq _unif_ t)
(setq _gct_ t)

:osql



set :q="SELECT ?s ?p ?val
	FROM <http://user.it.uu.se/~udbl/sard/producer10mil>
	WHERE {?s ?p ?val.}";

eval("create function exec_q()-><Charstring,Charstring,Literal> as " + parse_sparql(:q)); 

create function count_q()->Integer as count(exec_q());


Query 2:
