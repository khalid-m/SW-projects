Query 11 (Berlin): Get all info about an offer having URI  <http://user.it.uu.se/~udbl/sard/producer10mil#offer/_100>

set :q11="PREFIX dd: <http://user.it.uu.se/~udbl/sard/producer10mil>
	SELECT ?property ?hasValue ?isValueOf
	FROM  <http://user.it.uu.se/~udbl/sard/producer10mil>
	WHERE {
     	{ <http://user.it.uu.se/~udbl/sard/producer10mil#offer/_100> ?property ?hasValue. }
     	UNION
     	{ ?isValueOf ?property  <http://user.it.uu.se/~udbl/sard/producer10mil#offer/_100>.} }";

eval("create function exec_q11()-><Literal,Charstring,Literal> as " + parse_sparql(:q11)); 

