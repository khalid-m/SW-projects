select OFFER_PRODUCT,OFFER_PRODUCER,OFFER_VENDOR,OFFER_PRICE,OFFER_VALIDFROM,OFFER_VALIDTO,OFFER_DELIVERYDAYS,OFFER_OFFERWEBPAGE,OFFER_PUBLISHER,OFFER_PUBLISHDATE from OFFER where OFFER_NR = 100'


Query 3:  Retrieve all the info about offers that have deliver days = 5
	and the vendor country is GB
:::::::::::
set :q3="SELECT ?s1 ?p1 ?val1
	FROM <http://user.it.uu.se/~udbl/sard/producer10mil>
	WHERE {	?s1 <http://user.it.uu.se/~udbl/sard/producer10mil#offer/offer_deliveryDays> '5'.
		?s1 ?p1 ?val1.
		?s2 <http://user.it.uu.se/~udbl/sard/producer10mil#vendor/vendor_country> 'GB'.
		?s1 <http://user.it.uu.se/~udbl/sard/producer10mil#offer/offer_vendor> ?s2.}";

eval("create function exec_q3()-><Charstring,Charstring,Literal> as " + parse_sparql(:q3)); 

create function count_q3()->Integer as count(exec_q3());

Num of results:
...............
180 059 (= 11 * 16 369)

sql : (16 369 results)
........
select VENDOR_NR,OFFER_NR,OFFER_PRODUCT,OFFER_PRODUCER,OFFER_PRICE,OFFER_VALIDFROM,OFFER_VALIDTO,OFFER_OFFERWEBPAGE,OFFER_PUBLISHER,OFFER_PUBLISHDATE from VENDOR V_,OFFER O_ where VENDOR_COUNTRY = 'GB' and OFFER_VENDOR = VENDOR_NR and OFFER_DELIVERYDAYS = '5'

