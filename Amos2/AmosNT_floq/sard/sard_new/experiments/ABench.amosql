/* Query Q1: Archive the entire database */

set :q1 =
"CONSTRUCT { ?subject ?property ?value } 
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE {?subject ?property ?value } " ;


create function q1()-> (Charstring, Charstring, Literal)
as
remove_null(select _ss_, _pp_, _oo_
  from Charstring subject, Charstring property, Charstring value, 
       Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (subject, property, value) in prod()
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)));


create function count1()-> Integer as 
 count(q1());


lisp;
(setq _unif_ t)
(setq _gct_ t)
:osql


/*************************/

/*Query Q2: Archive the entire classes product and offer */

set :q2 =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 PREFIX saq: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
 CONSTRUCT { ?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {{ ?subject ?property ?value .
          saq:product   rdf:type  rdfs:Class .
          ?subject rdf:type  saq:product }
       UNION
       {  ?subject ?property ?value .
 	 saq:offer rdf:type  rdfs:Class .
         ?subject rdf:type  saq:offer } } ";



create function q2()-> (Charstring, Charstring, Literal)
as
remove_null( select _ss_, _pp_, _oo_
  from Charstring property, Charstring value, Charstring subject, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (((subject, property, value) in prod()
     and ('http://user.it.uu.se/~udbl/sard/prod#product', 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#Class') in prod()
     and (subject, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/prod#product') in prod())
    or  ((subject, property, value) in prod()
     and ('http://user.it.uu.se/~udbl/sard/prod#offer', 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#Class') in prod()
     and (subject, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/prod#offer') in prod()))
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)) );

create function count2()-> Integer as 
 count(q2());

archive_schemaNT_contentNT(:id_a,#'q2',"C:/AmosNT/sard/sard_new/q2.nt","q2s.nt");

lisp;
(setq _unif_ t)
(setq _gct_ t)


(setq _sch_ t)
:osql


/**********************/


/*Query Q3: Archive all values of the specific properties producer_label,
	     offer_price, offer_offerWebpage */

set :q3 =
"PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX prod: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 CONSTRUCT 
{ ?subject1 prod:product_label ?value1 .
  ?subject2 prod:product_price ?value2 .
  ?subject3 offer:offer_webpage ?value3  }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
 {{?subject1  prod:producer_label ?value1 .}
   UNION
  {?subject2  offer:offer_price ?value2 } 
   UNION
  {?subject3 offer:offer_offerWebpage ?value3 } } ";

create function q3()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring value2, Charstring subject2, Charstring subject1, Charstring value1, Charstring subject3, Charstring value3, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where ( (subject1, 'http://user.it.uu.se/~udbl/sard/prod#producer/producer_label', value1) in prod()
          and (_ss_ = subject1 and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#producer/producer_label' and _oo_ = value1) )
         
       or( (subject2, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_price', value2) in prod()
    	  and (_ss_ = subject2 and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_price' and _oo_ = value2 ) )
         
        or ((subject3, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_offerWebpage', value3) in prod() 
      	 and (_ss_ = subject3 and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_offerWebpage' and _oo_ = value3 ))) ;

create function count3()-> Integer as 
 count(q3());


lisp;
(setq _unif_ t)
(setq _gct_ t)
:osql


/*******************/
      

/*Query Q4: Archive products' property pNum1for values > 214 
	    and property pNum3 for values < 348, and 
            reviews' property text for values matching the string 
             'time' if the reviews have rating4 > 8 */

set :q4 =
"PREFIX prod: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX rev: <http://user.it.uu.se/~udbl/sard/prod#review/>
 CONSTRUCT 
{ ?subject1 prod:product_propertyNum1 ?value1 .
  ?subject2 prod:product_propertyNum3 ?value2 .
  ?subject3 rev:review_text           ?value3  }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE 
{{?subject1 prod:product_propertyNum1 ?value1 .
  FILTER (?value1 > '214' ) }
  UNION
 {?subject2 prod:product_propertyNum3 ?value2 .
  FILTER (?value2 < '348' ) } 
  UNION
 {?subject3 rev:review_text ?value3 .
  ?subject3 rev:review_rating4 ?value4 .
  FILTER REGEX(?value3, '%time%' ) .
  FILTER (?value4 > '8' ) }       } ";


lisp;
(setq _rewrite_filter_ t);;to rewrite FILTER correct
:osql

create function q4()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring subject1, Charstring value2, Charstring value1, Charstring value3, Charstring subject3, Charstring value4, Charstring _ss_, Charstring _pp_, Charstring _oo_, Charstring subject2
 where ((subject1, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', value1) in prod()
     	and value1 > '214'
	and (_ss_ = subject1 and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1' and _oo_ = value1 ) )

    or  ((subject2, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum3', value2) in prod()
     	and value2 < '348'
     	and (_ss_ = subject2 and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum3' and _oo_ = value2))

    or  ((subject3, 'http://user.it.uu.se/~udbl/sard/prod#review/review_text', value3) in prod()
     and (subject3, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating4', value4) in prod()
     and like(value3, '%time%')
     and value4 > '8'
     and (_ss_ = subject3 and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#review/review_text' and _oo_ = value3))) ;

create function count4()-> Integer as 
 count(q4());


/*******************************/


/*Query Q5: Archive the class product except the  RDF properties 
	    product_label and product_pNum1 */

set :q5 =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 PREFIX prod: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX saq: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
 CONSTRUCT { ?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
{ ?subject ?property ?value .
  ?subject rdf:type  saq:product .
  saq:product rdf:type  rdfs:Class .
  FILTER (?property != prod:product_label ).
  FILTER (?property != prod:product_propertyNum1 ) } ";



lisp;
(setq _rewrite_filter_ nil);;to rewrite a FILTER on subject/object ????
:osql


create function q5()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring subject, Charstring property, Charstring value, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (subject, property, value) in prod()
   and (subject, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/prod#product') in prod()
   and ('http://user.it.uu.se/~udbl/sard/prod#product', 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#Class') in prod()
   and property != 'http://user.it.uu.se/~udbl/sard/prod#product/product_label'
   and property != 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1'
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)) );

create function count5()-> Integer as 
 count(q5());


lisp;
(setq _unif_ t)
(setq _gct_ t)
(setq _sch_ t)
:osql



/*******************************/



/*Query Q6: Archive all classes whose URIs match the string 'product' */

set :q6 =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
 CONSTRUCT { ?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
{ ?class rdf:type  rdfs:Class .
  ?subject rdf:type ?class .
  ?subject ?property ?value .
  FILTER REGEX (?class, '%product%' ) } " ;



create function q6()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring value, Charstring property, Charstring subject, Charstring class, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (subject, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', class) in prod()
   and (subject, property, value) in prod()
   and like(class, '*product*')
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)));


create function count6()-> Integer as 
 count(q6());


archive_schemaNT_contentNT(:id_a,#'q6',"C:/AmosNT/sard/sard_new/q6.nt","q6s.nt");


/* The elimination of the table columns that don't fulfill the condition is done at run time.
   Disjuncts are not disappearing form the query plan. If the like condition is not fulfilled
   an SQL query is not sent from a partiqular disjunct. 
   The elimination happens beacuse the conjunction (AND (s-view) (like) ...) returns FALSE
*/

/*To see only the effect of GCT */

(setq _unif_ t)
(setq _gct_ t)


(defun source-fetcher (l)
  "returns list of terms to use as grouping key in L"
  (subset l (f/l (x) (or (is-source-relation x)
			 (is-like x)
			 (and (string-like (mkstring (oid-name (first x))) "P_CHARSTRING.CHARSTRING.CHARSTRING.S*")
			      (string-like (mkstring (oid-name (first x))) "*->BOOLEAN")) ;;if c is the schema view 
			 (is-biggerlessthan x)))))


(setq _sch_ t)




/***************/


/*Query Q7: Archive all subjects having a property with URI 
              matching the string 'homepage' */

set :q7 =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
 CONSTRUCT {?subject ?property ?value }
FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
{ ?class rdf:type  rdfs:Class .
  ?subject rdf:type ?class .
  ?subject ?property1 ?value1 .
  ?subject ?property  ?value .
  FILTER REGEX (str(?property1), 'homepage')} ";

create function q7()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring value, Charstring property, Charstring subject, 
	Charstring property1, Charstring value1, Charstring _ss_, Charstring _pp_, Charstring _oo_
   where (subject, property1, value1) in prod()
   and (subject, property, value) in prod()
   and like(property1, '*homepage')
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)));

create function count7()-> Integer as 
 count(q7());


lisp;
(setq _unif_ t)
(setq _gct_ t)
(setq _sch_ t)
:osql





/**********************/


/*Query Q8: Archive all properties of the subjects from class product 
           having productFeature 3 and 4, and pNum1 > 348 */

set :q8 =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 PREFIX saq: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX prod: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 CONSTRUCT { ?product ?property ?value } 
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {?product ?property 	   ?value . 
        ?product prod:product_label ?label .
        ?product rdf:type          <http://user.it.uu.se/~udbl/sard/prod#product> .
        ?product db:product_to_productfeature saq:_3 .
        ?product db:product_to_productfeature  saq:_4 . 
        ?product prod:product_propertyNum1 ?pn1 .
        FILTER (?pn1 > '348') }";


lisp;
(setq _rewrite_filter_ t);;to rewrite FILTER correct
:osql

create function q8()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring pn1, Charstring product, Charstring label, Charstring property, Charstring value, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (product, property, value) in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label) in prod()
   and (product, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/prod#product') in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_3') in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_4') in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', pn1) in prod()
   and pn1 > '348'
      and ((_ss_ = product and _pp_ = property and _oo_ = value)));

create function count8()-> Integer as 
 count(q8());


lisp;
(setq _unif_ t)
(setq _gct_ t)
(setq _sch_ t)
:osql



