/*Query Q9: Archive all classes whose property values are literals 
           contains the specific string 'symbols'    */


set :q9 =
"CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE { ?subject ?property ?value .
         FILTER REGEX (?value, 'symbols') } ";


lisp;
(setq _rewrite_filter_ t);;to rewrite FILTER correct
:osql

create function q9()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring value, Charstring property, Charstring subject, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (subject, property, value) in prod()
   and like(value, '*symbols*')
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)));

create function count9()-> Integer as 
 count(q9());

lisp;
(setq _is_Literal_ t);;to activate rewrite is_Literal 

(setq _type_Match_ t);; to activate rewrite Type-match

:osql

/*************************/


/*Query Q10: Archive all subjects related by a property to 
           another subject identified by the specific URI */


set :q10 =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
{ product:_2549  ?relation   ?subject .
  ?subject       ?property   ?value    } " ;


create function q10()-> (Charstring, Charstring, Literal)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring relation, Charstring subject, Charstring property, Charstring value, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where ('http://user.it.uu.se/~udbl/sard/prod#product/_2549', relation, subject) in prod()
   and (subject, property, value) in prod()
      and ((_ss_ = subject and _pp_ = property and _oo_ = value)));

create function count10()-> Integer as 
 count(q10());

lisp;
(setq _elcon_ifnounif_ t);;to rewrite FKR
:osql 



/*******************************************/


/* Berlin Q4 : Find products (and their properties and values) matching two different sets of features */

lisp;
(setq _rewrite_filter_ t);;to rewrite FILTER correct
:osql

create function berlin4a()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from Charstring p1, Charstring product, Charstring p2, Charstring label,
			Charstring ss, Charstring pp, Charstring oo, Charstring pred, Charstring obj
	where (prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_1')
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_43')
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_45')
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', p1)
     and p1 > '348' and p2 = ''
     and (prod()=(product,pred,obj) and (ss=product and pp=pred and oo=obj)))  or
        (prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_1')
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_43')
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_52')
     and prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum2', p2)
     and p2 > '400' and p1 = '' 
     and (prod()=(product,pred,obj) and (ss=product and pp=pred and oo=obj)));


create function count_berlin4a()->integer as select count(remove_null(berlin4a()));
/* 5707 (no duplicates if col view with p keys) */
/* 6323 ( with the duplicates if col view with pr keys); 6172 */

create function berlin4a_arch()->(Charstring,Charstring,Charstring) as select remove_null(berlin4a());

archive_content_new(#'berlin4a_arch',"berlin4_data.nt","berlin4_schema.nt","berlin4_stat.txt");

archive_schemaNT_contentNT(:id_a,#'berlin4a_dup',"C:/AmosNT/sard/sard_new/berlin4data_ordered.nt","berlin4schema_o.nt");



/*********************************************/
set :q =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT {?s ?p ?o }
  FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#product> .
	 ?s ?p ?o . }
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#person> .
	 ?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#producttype> .
	 ?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#vendor> .
	 ?s ?p ?o .}
	UNION
	{ ?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#review> .
	?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#producer> .
	?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#productfeature> .
	?s ?p ?o . }
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#offer> .
	?s ?p ?o } }";	

lisp;
(setq _unif_ t)
(setq _gct_ t)
:osql

eval("create function exec()->(Charstring,Charstring,Literal) as " + parse_sparql(:q)); 


create function arch()->(Charstring,Charstring,Charstring)
	as remove_null(select s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec());

logging off;

archive_content_new(#'arch',"data552m_gct.nt","schema552m.nt","stat180.txt");





lisp;
(setq _unif_ nil)
(setq _gct_ nil)
:osql

eval("create function exec2()->(Charstring,Charstring,Literal) as " + parse_sparql(:q)); 


create function arch2()->(Charstring,Charstring,Charstring)
	as remove_null(select s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec2());


