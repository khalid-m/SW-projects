/*Berlin 7a Archive query - CONSTRUCT */
/* Archive info about a product including offers and reviews */
/*Best plan: GCT with optional and rowid - 0.23 */
/*duplicates from the non optional query */

/*
1)GCT (old): 1.96 s
2)GCT with optional:0.23  
3)GCT with optional and rowid : 0.235 (the same plan as in 2)
4) no DNF: (the idea of 3): 0.304  
results 22 (no duplicates; 26 -duplicates of the non optional query)
5)late old GCT : result ~ GCT : 2.05
6) no GCT :2.01
*/


/*The CONSTRUCT OPTIONAL query*/
set :q7a =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
CONSTRUCT 
	{product:_5 product:product_label ?productlabel .
	 ?offer     offer:offer_price     ?price .
	 ?offer     db:offer_of_vendor    ?vendor .
	 ?vendor    vendor:vendor_label   ?vendortitle .
	 ?review    db:review_of_person   ?reviewer .
	 ?review    review:review_title  ?revtitle .
	 ?reviewer  person:person_name    ?revname .
       	 ?review    review:review_rating1 ?rating1 .
	 ?review    review:review_rating2 ?rating2 . }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE
	{ product:_5  product:product_label ?productlabel .
 OPTIONAL { ?offer     db:offer_of_product   product:_5 .
	    ?offer     offer:offer_price     ?price .
	    ?offer     db:offer_of_vendor    ?vendor .
            ?vendor    vendor:vendor_label   ?vendortitle .
	    ?vendor    vendor:vendor_country 'DE' .
	    ?offer     offer:offer_publisher ?vend .
	    ?offer     offer:offer_validTo   ?date .
	    FILTER (?date >  '2001-09-16' ) }
 OPTIONAL
	  { ?review    db:review_of_product  product:_5 .
	    ?review    db:review_of_person   ?reviewer .
	    ?reviewer  person:person_name    ?revname .
	    ?review    review:review_title  ?revtitle .
	OPTIONAL {  ?review    review:review_rating1 ?rating1  }
	OPTIONAL {  ?review    review:review_rating2 ?rating2  } } } ";

eval("create function exec_q7a()->(Charstring,Charstring,Literal) as " + parse_sparql(:q7a)); 

create function q7_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q7a());

create function count7a()-> Integer as count(q7_arch());


lisp;
(setq _repl_literal_ t)
:osql



/*The UNION query*/
set :q7au =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
CONSTRUCT 
	{product:_5 product:product_label ?productlabel .
	 ?offer     offer:offer_price     ?price .
	 ?offer     db:offer_of_vendor    ?vendor .
	 ?vendor    vendor:vendor_label   ?vendortitle .
	 ?review    db:review_of_person   ?reviewer .
	 ?review    review:review_title  ?revtitle .
	 ?reviewer  person:person_name    ?revname .
       	 ?review    review:review_rating1 ?rating1 .
	 ?review    review:review_rating2 ?rating2 . }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE{ { product:_5 product:product_label ?productlabel .}
	UNION
	{product:_5 product:product_label ?productlabel .
	 ?offer     db:offer_of_product   product:_5 .
	 ?offer     offer:offer_price     ?price .
	 ?offer     db:offer_of_vendor    ?vendor .
         ?vendor    vendor:vendor_label   ?vendortitle .
	 ?vendor    vendor:vendor_country 'DE' .
	 ?offer     offer:offer_publisher ?vend .
	 ?offer     offer:offer_validTo   ?date .
	 FILTER (?date >  '2001-09-16' ) 		}
	UNION
	{product:_5 product:product_label ?productlabel .
 	 ?review    db:review_of_product  product:_5 .
	 ?review    db:review_of_person   ?reviewer .
	 ?reviewer  person:person_name    ?revname .
	 ?review    review:review_title  ?revtitle . }
	UNION
	{product:_5 product:product_label ?productlabel .
 	 ?review    db:review_of_product  product:_5 .
	 ?review    db:review_of_person   ?reviewer .
	 ?reviewer  person:person_name    ?revname .
	 ?review    review:review_title  ?revtitle . 
	 ?review    review:review_rating1 ?rating1 . }
	union
	{product:_5 product:product_label ?productlabel .
 	 ?review    db:review_of_product  product:_5 .
	 ?review    db:review_of_person   ?reviewer .
	 ?reviewer  person:person_name    ?revname .
	 ?review    review:review_title  ?revtitle . 
	 ?review    review:review_rating1 ?rating1 .
	 ?review    review:review_rating2 ?rating2 . } } ";

eval("create function exec_q7au()->(Charstring,Charstring,Literal) as " + parse_sparql(:q7au)); 


create function q7u_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q7au());

create function count7au()-> Integer as count(q7u_arch());
	
	 
