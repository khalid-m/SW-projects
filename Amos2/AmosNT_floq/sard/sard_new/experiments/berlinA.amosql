/*Berlin 2al - less selective CONSTRUCT query */
/*Retrive a list of properties of all products 
 where the properties 'propertyTex4', 'propertyTex5' and 'propertyNum4' are retrieved if they exist */

/*Distinct needed because for the NON-OPTIONAL part 2 sql queries are executed instead of 1 */
/*Best plan: GCT with optional   or no DNF*/
/* ??? GCT with optional and rowid needs better normalization*/




/*The OPTIONAL query*/
set :q2al =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
 CONSTRUCT
	{?product	product:product_label			?label .
	 ?product	product:product_comment 		?comment .
         ?p 		producer:producer_label			?producer .
	 ?f 		productfeature:productfeature_label 	?productfeature .
	 ?product 	product:product_propertyTex1 		?propertytextual1 .
	 ?product	product:product_propertyTex2 		?propertytextual2 .
	 ?product 	product:product_propertyTex3 		?propertytextual3 .
	 ?product 	product:product_propertyNum1 		?propertynumeric1 .
         ?product 	product:product_propertyNum2 		?propertynumeric2 .
	 ?product 	product:product_propertyTex4		?propertytextual4 .
	 ?product	product:product_propertyTex5		?propertytextual5 .
	 ?product 	product:product_propertyNum4 		?propertynumeric4    }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE {
	?product	product:product_label			?label .
        ?product	product:product_comment 		?comment .
        ?product     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	?product 	product:product_publisher 		?publ .
       	?product 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        ?product 	product:product_propertyTex1 		?propertytextual1 .
	?product	product:product_propertyTex2 		?propertytextual2 .
	?product 	product:product_propertyTex3 		?propertytextual3 .
	?product 	product:product_propertyNum1 		?propertynumeric1 .
        ?product 	product:product_propertyNum2 		?propertynumeric2 .
  OPTIONAL { ?product	 	product:product_propertyTex4		?propertytextual4 . }
  OPTIONAL { ?product		product:product_propertyTex5		?propertytextual5 . }
  OPTIONAL { ?product	 	product:product_propertyNum4 		?propertynumeric4 . } }" ;


eval("create function exec_q2al()->(Charstring,Charstring,Literal) as " + parse_sparql(:q2al)); 

create function q2_arch_l()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q2al());

create function count2al()-> Integer as count(q2_arch_l());

archive_content("q2_arch","berlin2aD.NT","berlin2aS.NT","berlin2D_stat.txt");





