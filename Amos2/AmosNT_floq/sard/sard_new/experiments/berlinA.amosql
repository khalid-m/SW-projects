:osql


set :q02 =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
 CONSTRUCT
	{product:_5	product:product_label			?label .
	 product:_5	product:product_comment 		?comment .
         ?p 		producer:producer_label			?producer .
 	product:_5 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature . }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE {
	product:_5	product:product_label			?label .
        product:_5	product:product_comment 		?comment .
        product:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer . 
 	product:_5 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .} ";

eval("create function exec_q02()->(Charstring,Charstring,Literal) as " + parse_sparql(:q02)); 



/*Berlin 2a - CONSTRUCT query */
/*Retrive a list of properties of a specific product identified by 'http://user.it.uu.se/~udbl/sard/prod#product/_5'
 where the properties 'propertyTex4', 'propertyTex5' and 'propertyNum4' are retrieved if they exist */

/*Distinct needed because for the NON-OPTIONAL part 2 sql queries are executed instead of 1 */
/*Best plan: GCT with optional   or no DNF*/
/* ??? GCT with optional and rowid needs better normalization*/

/*
1)GCT (old): 
2)GCT with optional: 0.01
3)GCT with optional and rowid : needs better normalization
4)no DNF: good enough plan ~ GCT with optional : 0.01
*/


/*The OPTIONAL query*/
set :q2a =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
 CONSTRUCT
	{product:_5	product:product_label			?label .
	 product:_5	product:product_comment 		?comment .
         ?p 		producer:producer_label			?producer .
	 ?f 		productfeature:productfeature_label 	?productfeature .
	 product:_5 	product:product_propertyTex1 		?propertytextual1 .
	 product:_5	product:product_propertyTex2 		?propertytextual2 .
	 product:_5 	product:product_propertyTex3 		?propertytextual3 .
	 product:_5 	product:product_propertyNum1 		?propertynumeric1 .
         product:_5 	product:product_propertyNum2 		?propertynumeric2 .
	 product:_5 	product:product_propertyTex4		?propertytextual4 .
	 product:_5	product:product_propertyTex5		?propertytextual5 .
	 product:_5 	product:product_propertyNum4 		?propertynumeric4    }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE {
	product:_5	product:product_label			?label .
        product:_5	product:product_comment 		?comment .
        product:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	product:_5 	product:product_publisher 		?publ .
       	product:_5 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        product:_5 	product:product_propertyTex1 		?propertytextual1 .
	product:_5	product:product_propertyTex2 		?propertytextual2 .
	product:_5 	product:product_propertyTex3 		?propertytextual3 .
	product:_5 	product:product_propertyNum1 		?propertynumeric1 .
        product:_5 	product:product_propertyNum2 		?propertynumeric2 .
  OPTIONAL { product:_5 	product:product_propertyTex4		?propertytextual4 . }
  OPTIONAL { product:_5		product:product_propertyTex5		?propertytextual5 . }
  OPTIONAL { product:_5 	product:product_propertyNum4 		?propertynumeric4 . } }" ;


eval("create function exec_q2a()->(Charstring,Charstring,Literal) as " + parse_sparql(:q2a)); 

create function q2_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q2a());

create function count2a()-> Integer as count(q2_arch());

archive_content("q2_arch","berlin2aD.NT","berlin2aS.NT","berlin2D_stat.txt");

archive_content_old(#'q2_arch',"berlin2aD.NT","berlin2aS.NT");

