/*Berlin 6 Archive - CONSTRUCT */
/* Find products and their properties having a label that contains a specific string */


set :q6a =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX producttype: <http://user.it.uu.se/~udbl/sard/prod#producttype/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT { ?product ?property  ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE { 
	?product	product:product_label		?label .
	?product	rdf:type 			product .
	FILTER REGEX (?label, ) ";

create function berlin6a()->(Charstring,Charstring, Charstring)
as select ss,pp,oo
  from Charstring product, Charstring label,Charstring ss, Charstring pp,Charstring oo,
	Charstring pred, Charstring obj
  where prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
   and prod()=(product, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/prod#product')
   and like(label,'%r%') and (prod()=(product,pred,obj) and ss=product and pp=pred and oo=obj);

create function count_berlin6a()->integer as select count(remove_null(berlin6a())); 
/* Amos crash */

create function berlin6a_arch()->(Charstring,Charstring,Charstring) as select remove_null(berlin6a());
archive_content(#'berlin6a_arch',"berlin6_data.nt","berlin6_schema.nt");

