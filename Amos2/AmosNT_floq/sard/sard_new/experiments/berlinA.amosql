/*Berlin 4 Archive q - CONSTRUCT query */
/* Find products (and their properties and values) matching two different sets of features */


create function berlin4a()->(Charstring,Charstring,Charstring)
as select distinct ss,pp,oo from Charstring p1, Charstring product, Charstring p2, Charstring label,
			Charstring ss, Charstring pp, Charstring oo, Charstring pred, Charstring obj
	where (prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_2')
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_12')
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_20')
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', p1)
     and p1 > '348' and p2 = ''
     and (prod_fn()=(product,pred,obj) and (ss=product and pp=pred and oo=obj)))  or
        (prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_1')
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_12')
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_8')
     and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum2', p2)
     and p2 > '759' and p1 = '' 
     and (prod_fn()=(product,pred,obj) and (ss=product and pp=pred and oo=obj)));


create function count_berlin4a()->integer as select count(remove_null(berlin4a()));
/* 5126  */
/* 5520 (with the duplicates)*/

create function berlin4a_arch()->(Charstring,Charstring,Charstring) as select remove_null(berlin4a());
archive_content(#'berlin4a_arch',"berlin4_data.nt","berlin4_schema.nt");


