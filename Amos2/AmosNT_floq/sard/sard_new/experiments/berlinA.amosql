/*Berlin 2a - CONSTRUCT query */

create function berlin2a()->(Charstring,Charstring,Charstring)
as select distinct ss,pp,oo from Charstring ss,Charstring pp,Charstring oo, Charstring propertynumeric2, Charstring propertytextual3, Charstring propertytextual1, 
Charstring p, Charstring producer, Charstring comment, Charstring label, Charstring publ, Charstring productfeature, Charstring f, Charstring propertytextual2, 
Charstring propertynumeric1, Charstring propertytextual4, Charstring propertytextual5, Charstring propertynumeric4
 where prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_label_fn', label)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_comment_fn', comment)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product_of_producer_fn', p)
   and prod_fn()=(p, 'http://user.it.uu.se/~udbl/sard/prod#producer/producer_label', producer)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_publisher_fn', publ)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature_fn', f)
   and prod_fn()=(f, 'http://user.it.uu.se/~udbl/sard/prod#productfeature/productfeature_label', productfeature)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex1_fn', propertytextual1)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex2_fn', propertytextual2)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex3_fn', propertytextual3)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1_fn', propertynumeric1)
   and prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum2_fn', propertynumeric2)
   and propertytextual4=optional((select propertytextual4_o from Charstring propertytextual4_o
                      where prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex4_fn', propertytextual4_o)),'')
   and propertytextual5=optional((select propertytextual5_o from Charstring propertytextual5_o
                      where prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex5_fn', propertytextual5_o)),'')
   and propertynumeric4=optional((select propertynumeric4_o from Charstring propertynumeric4_o
                      where prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum4_fn', propertynumeric4_o)),'')
   and ((ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_label_fn' and oo= label) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp= 'http://user.it.uu.se/~udbl/sard/prod#product/product_comment_fn' and oo=comment) or
	(ss=p and pp= 'http://user.it.uu.se/~udbl/sard/prod#producer/producer_label_fn' and oo= producer) or
	(ss=f and pp= 'http://user.it.uu.se/~udbl/sard/prod#productfeature/productfeature_label_fn' and oo= productfeature) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex1_fn' and oo=propertytextual1) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex2_fn'and oo=propertytextual2) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex3_fn'and oo= propertytextual3) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1_fn' and oo= propertynumeric1) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum2_fn' and oo=propertynumeric2) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex4_fn' and oo=propertytextual4) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyTex5_fn' and oo= propertytextual5) or
	(ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum4_fn'and oo= propertynumeric4));

create function berlin2a_count()-> Integer as count(remove_null(berlin2a()));
/* 28 */

create function berlin2_arch()->(Charstring,Charstring,Charstring)
	as remove_null(berlin2a());

archive_content(#'berlin2_arch',"berlin2_data.nt","berlin2_schema.nt");

