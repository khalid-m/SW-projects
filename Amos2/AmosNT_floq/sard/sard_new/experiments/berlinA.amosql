/*Berlin 3a - CONSTRUCT) */
/* Archive query:Find products (and their properties) having some features and not having one feature ('label')*/ 

lisp;
(setq _optional_ t)
(setq _subjects_ t)
:osql

set :q3a =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX producttype: <http://user.it.uu.se/~udbl/sard/prod#producttype/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 CONSTRUCT { ?product ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE { 
	?product	product:product_label		?label .
	?product	db:product_to_producttype	producttype:_1 .
	?product	db:product_to_productfeature	productfeature:_3 .
	?product	product:product_propertyNum1	?p1 .
	FILTER (?p1 > '214').
	?product	product:product_propertyNum3	?p3 .
	FILTER (?p3 < '698').
        OPTIONAL {
		?product	db:product_to_productfeature	productfeature:_20 .
		?product	product:product_label		?testvar .		}
	FILTER (!bound(?testvar)).
	?product ?property ?value								}";

eval("create function exec_q3a()->(Charstring,Charstring,Literal) as " + parse_sparql(:q3a)); 

create function q3_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q3a());

create function count3a()-> Integer as count(q3_arch());

