set :q =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT
	{?s ?p ?o }
  FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#offer> .
	?s ?p ?o } ";

/*It has to 3 sql queries <- mapping + rewrite */
set :q=
"
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {?object ?property1 ?value1 }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
         { product:_2549 ?property   ?object .
	   ?object       ?property1  ?value1 } ";

/*producer1 */
/*Without rewrites, comp time: 213.376 s, count:127, SQL qs:1287 , exec:~0.3 */
/*Only _elcon_ifnounif_ rewrite:  comp time:147, count:127, SQL qs: 39, exec:~0.014 */ 
/*_elcon_ifnounif_, _sch_, comp time:74 s, count:127, SQL qs: 36, exec: :~0.013 */


set :q=
"
 CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
         { ?subject ?property ?value .
	   FILTER REGEX (?value, '%elbows%') } ";

/* no rewrite: 70 SQL qs (70 disjuncts+1); exec w: ~ 0.05 */
/* FILTER rewr: 59 SQL qs(59 disjuncts +1); exec w: ~ 0.018  */


/*!!! It doesn't work */
set :q=
"
 CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
         { ?subject ?property ?value .
	   FILTER (?value > '348') } ";


set :q=
"
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 CONSTRUCT { producer:_1 ?property   ?hasValue . 
	    ?isValueOf  ?property   producer:_1 }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
        { { producer:_1 ?property   ?hasValue .}
	UNION
	{  ?isValueOf  ?property   producer:_1 } }";

create function q()->(Charstring,Charstring,Charstring)
as
select _ss_, _pp_, _oo_
  from Charstring hasvalue, Charstring isvalueof, Charstring property, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where  ( ('http://user.it.uu.se/~udbl/sard/prod#producer/_1', property, hasvalue) in prod()) 
    or  ((isvalueof, property, 'http://user.it.uu.se/~udbl/sard/prod#producer/_1') in prod()) 
      and ((_ss_ = 'http://user.it.uu.se/~udbl/sard/prod#producer/_1' and _pp_ = property and _oo_ = hasvalue )
        or (_ss_ = isvalueof and _pp_ = property and _oo_ = 'http://user.it.uu.se/~udbl/sard/prod#producer/_1' ));

/**without _el_coerc_ rewrite: sql qs:72 , exec:~0.017*/
/*with _el_coerc_ rewrite: sql qs: 36,      exec:0.0045*/

create function countq()-> Integer as count(q());


set :q =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT
	{?s ?p ?o }
  FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#product> .
	?s ?p ?o } ";

set :q =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT
	{?s ?p ?o }
  FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {?s ?p ?o } ";


set :q =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT {?s ?p ?o }
  FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#product> .
	 ?s ?p ?o . }
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#person> .
	 ?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#producttype> .
	 ?s ?p ?o .
	 FILTER (?p != <http://user.it.uu.se/~udbl/sard/prod#producttype_to_product> ) .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#vendor> .
	 ?s ?p ?o .}
	UNION
	{ ?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#review> .
	?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#producer> .
	?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#productfeature> .
	?s ?p ?o .
	FILTER (?p != <http://user.it.uu.se/~udbl/sard/prod#productfeature_to_product>). }
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#offer> .
	?s ?p ?o } }";	



set :q =
"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT {?s ?p ?o }
  FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#product> .
	 ?s ?p ?o . }
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#producttype> .
	 ?s ?p ?o .
	 FILTER (?p != <http://user.it.uu.se/~udbl/sard/prod#producttype_to_product> ) .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#vendor> .
	 ?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#producer> .
	?s ?p ?o .}
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#productfeature> .
	?s ?p ?o .
	FILTER (?p != <http://user.it.uu.se/~udbl/sard/prod#productfeature_to_product>). }
	UNION
	{?s rdf:type <http://user.it.uu.se/~udbl/sard/prod#offer> .
	?s ?p ?o } }";	


eval("create function exec()->(Charstring,Charstring,Literal) as " + parse_sparql(:q)); 

create function count()-> Integer as count(exec());



create function arch()->(Charstring,Charstring,Charstring)
	as remove_null(select s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec());

create function count()-> Integer as count(arch());

