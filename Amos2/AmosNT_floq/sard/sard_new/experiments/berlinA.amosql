/*The UNION query 2*/
set :q2au2 =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX o1: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX o2: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX o3: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 CONSTRUCT
	{product:_5	product:product_label			?label .
	 product:_5	product:product_comment 		?comment .
         ?p 		producer:producer_label			?producer .
	 ?f 		productfeature:productfeature_label 	?productfeature .
	 product:_5 	product:product_propertyTex1 		?propertytextual1 .
	 product:_5	product:product_propertyTex2 		?propertytextual2 .
	 product:_5 	product:product_propertyTex3 		?propertytextual3 .
	 product:_5 	product:product_propertyNum1 		?propertynumeric1 .
         product:_5 	product:product_propertyNum2 		?propertynumeric2 .
	 o1:_5 		product:product_propertyTex4		?propertytextual4 .
	 o2:_5		product:product_propertyTex5		?propertytextual5 .
	 o3:_5 		product:product_propertyNum4 		?propertynumeric4    }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE {{
	product:_5	product:product_label			?label .
        product:_5	product:product_comment 		?comment .
        product:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	product:_5 	product:product_publisher 		?publ .
       	product:_5 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        product:_5 	product:product_propertyTex1 		?propertytextual1 .
	product:_5	product:product_propertyTex2 		?propertytextual2 .
	product:_5 	product:product_propertyTex3 		?propertytextual3 .
	product:_5 	product:product_propertyNum1 		?propertynumeric1 .
        product:_5 	product:product_propertyNum2 		?propertynumeric2 . }
  UNION
	{
	o1:_5		product:product_label			?label .
        o1:_5		product:product_comment 		?comment .
        o1:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	o1:_5 		product:product_publisher 		?publ .
       	o1:_5 		db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        o1:_5 		product:product_propertyTex1 		?propertytextual1 .
	o1:_5		product:product_propertyTex2 		?propertytextual2 .
	o1:_5 		product:product_propertyTex3 		?propertytextual3 .
	o1:_5 		product:product_propertyNum1 		?propertynumeric1 .
        o1:_5 		product:product_propertyNum2 		?propertynumeric2 .
	o1:_5 		product:product_propertyTex4		?propertytextual4 . }
  UNION
	{o2:_5		product:product_label			?label .
        o2:_5		product:product_comment 		?comment .
        o2:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	o2:_5 		product:product_publisher 		?publ .
       	o2:_5 		db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        o2:_5 		product:product_propertyTex1 		?propertytextual1 .
	o2:_5		product:product_propertyTex2 		?propertytextual2 .
	o2:_5 		product:product_propertyTex3 		?propertytextual3 .
	o2:_5 		product:product_propertyNum1 		?propertynumeric1 .
        o2:_5 		product:product_propertyNum2 		?propertynumeric2 . 
	o2:_5		product:product_propertyTex5		?propertytextual5 . }
  UNION
	{o3:_5		product:product_label			?label .
        o3:_5		product:product_comment 		?comment .
        o3:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	o3:_5 		product:product_publisher 		?publ .
       	o3:_5 		db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        o3:_5 		product:product_propertyTex1 		?propertytextual1 .
	o3:_5		product:product_propertyTex2 		?propertytextual2 .
	o3:_5 		product:product_propertyTex3 		?propertytextual3 .
	o3:_5 		product:product_propertyNum1 		?propertynumeric1 .
        o3:_5 		product:product_propertyNum2 		?propertynumeric2 .
	o3:_5 		product:product_propertyNum4 		?propertynumeric4 . } } ";

