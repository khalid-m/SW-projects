archive_schemaNT_contentNT_ver2(:id_a,#'q2_arch','C:/AmosNT/sard/sard_new/b2aD.nt','b2aS.nt');

/*The UNION query 1*/
set :q2au =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
 CONSTRUCT
	{product:_5	product:product_label			?label .
	 product:_5	product:product_comment 		?comment .
         ?p 		producer:producer_label			?producer .
	 ?f 		productfeature:productfeature_label 	?productfeature .
	 product:_5 	product:product_propertyTex1 		?propertytextual1 .
	 product:_5	product:product_propertyTex2 		?propertytextual2 .
	 product:_5 	product:product_propertyTex3 		?propertytextual3 .
	 product:_5 	product:product_propertyNum1 		?propertynumeric1 .
         product:_5 	product:product_propertyNum2 		?propertynumeric2 .
	 product:_5 		product:product_propertyTex4		?propertytextual4 .
	 product:_5		product:product_propertyTex5		?propertytextual5 .
	 product:_5 		product:product_propertyNum4 		?propertynumeric4    }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE {{
	product:_5	product:product_label			?label .
        product:_5	product:product_comment 		?comment .
        product:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	product:_5 	product:product_publisher 		?publ .
       	product:_5 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        product:_5 	product:product_propertyTex1 		?propertytextual1 .
	product:_5	product:product_propertyTex2 		?propertytextual2 .
	product:_5 	product:product_propertyTex3 		?propertytextual3 .
	product:_5 	product:product_propertyNum1 		?propertynumeric1 .
        product:_5 	product:product_propertyNum2 		?propertynumeric2 . }
  UNION
	{
	product:_5	product:product_label			?label .
        product:_5	product:product_comment 		?comment .
        product:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	product:_5 	product:product_publisher 		?publ .
       	product:_5 	db:product_to_productfeature 		?f .
	?f 		productfeature:productfeature_label 	?productfeature .
        product:_5 	product:product_propertyTex1 		?propertytextual1 .
	product:_5	product:product_propertyTex2 		?propertytextual2 .
	product:_5 	product:product_propertyTex3 		?propertytextual3 .
	product:_5 	product:product_propertyNum1 		?propertynumeric1 .
        product:_5 	product:product_propertyNum2 		?propertynumeric2 .
	product:_5 	product:product_propertyTex4		?propertytextual4 . }
  UNION
	{product:_5	product:product_label			?label .
        product:_5	product:product_comment 		?comment .
        product:_5     	db:product_of_producer 			?p .
   	?p 		producer:producer_label 		?producer .
	product:_5 	product:product_publisher 		?publ .
