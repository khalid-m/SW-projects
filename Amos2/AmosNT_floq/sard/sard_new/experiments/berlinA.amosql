/*Berlin 10a Archive -Archives the cheap offers which fulfill the consumer's delivery requirements*/
/*CONSTRUCT query */

create function berlin10a()->(Charstring,Charstring,Charstring) 
as select distinct ss, pp, oo
  from Charstring price, Charstring deliverydays, Charstring ve, Charstring vendor, Charstring date, 
	Charstring obj, Charstring pred, Charstring offer,
	Charstring ss, Charstring pp, Charstring oo
 where prod()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer_of_product', 'http://user.it.uu.se/~udbl/sard/prod#product/_5')
   and prod()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer_of_vendor', vendor)
   and prod()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_publisher', ve)
   and prod()=(vendor, 'http://user.it.uu.se/~udbl/sard/prod#vendor/vendor_country', 'US')
   and prod()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_deliveryDays', deliverydays)
   and deliverydays <= '3'
   and prod()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_price', price)
   and prod()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_validTo', date)
   and date > '2008-01-01T00:00:00'
   and (prod()=(offer, pred, obj) and ss=offer and pp=pred and oo=obj);



create function count_berlin10a()->integer as select count(remove_null(berlin10a()));

/* 11 */
archive_content(#'berlin10a',"berlin10_data.nt","berlin10_schema.nt");


