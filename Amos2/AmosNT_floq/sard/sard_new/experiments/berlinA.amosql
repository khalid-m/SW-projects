/*Berlin9 (originally DESCRIBE)- (is already archive q)- Get information about a reviewer*/
set :berlin9a="SELECT ?x ?pred ?obj
	       FROM  <http://user.it.uu.se/~udbl/sard/prod>
	       WHERE {
		      <http://user.it.uu.se/~udbl/sard/prod#review/_4> <http://user.it.uu.se/~udbl/sard/prod#review_of_person> ?x.
			?x ?pred ?obj }";

eval("create function berlin9a()->(Charstring,Charstring,Charstring) as " + parse_sparql(:berlin9a)); 
create function count_berlin9a()->integer as select count(remove_null(berlin9a()));

archive_content(#'berlin9a',"berlin9_data.nt","berlin9_schema.nt");

/******************************************************************************/

/*Berlin 10a Archive -Archives the cheap offers which fulfill the consumer's delivery requirements*/
/*CONSTRUCT query */

create function berlin10a()->(Charstring,Charstring,Charstring) 
as select distinct ss, pp, oo
  from Charstring price, Charstring deliverydays, Charstring ve, Charstring vendor, Charstring date, 
	Charstring obj, Charstring pred, Charstring offer,
	Charstring ss, Charstring pp, Charstring oo
 where prod_fn()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer_of_product', 'http://user.it.uu.se/~udbl/sard/prod#product/_1')
   and prod_fn()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer_of_vendor', vendor)
   and prod_fn()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_publisher', ve)
   and prod_fn()=(vendor, 'http://user.it.uu.se/~udbl/sard/prod#vendor/vendor_country', 'GB')
   and prod_fn()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_deliveryDays', deliverydays)
   and deliverydays <= '3'
   and prod_fn()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_price', price)
   and prod_fn()=(offer, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_validTo', date)
   and date > '2008-04-19T00:00:00'
   and (prod_fn()=(offer, pred, obj) and prod_fn()=(ss,pp,oo));

create function count_berlin10a()->integer as select count(remove_null(berlin10a()));

/* 11 */
archive_content(#'berlin10a',"berlin10_data.nt","berlin10_schema.nt");


/******************************************************************************/

/*Berlin 11a - Archive all information about an offer (as CONSTRUCT )*/

create function berlin11a()-><Charstring,Charstring,Literal> 
as select distinct ss, pp, oo
  from Charstring hasvalue, Charstring property, Charstring isvalueof, Charstring ss, Charstring pp, Charstring oo
 where (prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#offer/_1', property, hasvalue) or  
	prod_fn()=(isvalueof, property, 'http://user.it.uu.se/~udbl/sard/prod#offer/_1') ) and
	((ss ='http://user.it.uu.se/~udbl/sard/prod#offer/_1' and pp= property and oo= hasvalue) or
	 (ss=isvalueof and pp= property and oo= 'http://user.it.uu.se/~udbl/sard/prod#offer/_1'));

create function count_berlin11a()->integer as select count(remove_null(berlin11a()));    

/* 11 */




select PRODUCT_LABEL from producer180m.PRODUCT where PRODUCT_NR = 5

create view producer180m.berlin7 as
select VENDOR_NR,VENDOR_LABEL,OFFER_NR,offer_product,OFFER_PRICE,OFFER_VALIDTO,OFFER_PUBLISHER
from producer180m.VENDOR V_,producer180m.OFFER O_ where VENDOR_COUNTRY = 'DE' and OFFER_PRODUCT = 5 and 
OFFER_VENDOR = VENDOR_NR and OFFER_VALIDTO > '2001-09-16'

select PRODUCT_LABEL,t2.VENDOR_LABEL from producer180m.PRODUCT left outer join 
(select VENDOR_NR,VENDOR_LABEL,OFFER_NR,offer_product,OFFER_PRICE,OFFER_VALIDTO,OFFER_PUBLISHER
from producer180m.VENDOR V_,producer180m.OFFER O_ where VENDOR_COUNTRY = 'DE' and OFFER_PRODUCT = 3418 and 
OFFER_VENDOR = VENDOR_NR and OFFER_VALIDTO > '2001-09-16') AS t2 on t2.offer_product=product_nr
where PRODUCT_NR = 5


select distinct PERSON_NR,PERSON_NAME,REVIEW_NR,REVIEW_TITLE from producer180m.PERSON P_,producer180m.REVIEW R_ 
where REVIEW_PRODUCT = 3418 and REVIEW_PERSON = PERSON_NR


select product_label,VENDOR_NR,VENDOR_LABEL,OFFER_NR,offer_product,OFFER_PRICE,OFFER_VALIDTO,OFFER_PUBLISHER
from producer180m.PRODUCT
left outer join producer180m.berlin7 on offer_product=product_nr;