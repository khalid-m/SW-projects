*Berlin 3a - CONSTRUCT) */
/* Archive query:find products with their properties having some features and not having one feature */ 

create function berlin3a()->(Charstring,Charstring,Charstring)
as select distinct ss,pp,oo
  from Charstring label, Charstring p1, Charstring p3, Charstring product, Charstring testvar,Charstring ss,Charstring pp, Charstring oo,
	Charstring pred, Charstring obj
 where prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_2')
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_12')
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', p1)
   and p1 > '214'
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum3', p3)
   and p3 < '698'
   and testvar=optional((select testvar_o
                           from Charstring testvar_o
                          where prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_20')
                            and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', testvar_o)),'') and testvar="" 
  and prod_fn()=(product,pred,obj) and (ss=product and pp=pred and oo=obj);

create function berlin3a_count()-> Integer as count(remove_null(berlin3a()));

/*5993 SAQ, D2RQ */

create function berlin3_arch()->(Charstring,Charstring,Charstring)
	as remove_null(berlin3a());

archive_content(#'berlin3_arch',"berlin3_data.nt","berlin3_schema.nt");


