/*Berlin 11a - Archive all information about an offer (as CONSTRUCT )*/

set :q11a_1= "
CONSTRUCT  {?isvalueof ?property <http://user.it.uu.se/~udbl/sard/prod#offer/_1> }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE{ ?isvalueof ?property <http://user.it.uu.se/~udbl/sard/prod#offer/_1> } ";

eval("create function exec_q11a_1()->(Charstring,Charstring,Literal) as " + parse_sparql(:q11a_1)); 

/*without rewrite: sql qs :27  */
/*with rewrite: no sql query */


create function q11_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o 
	where (s,p,o) in exec_q11a());

create function count11a()-> Integer as count(q11_arch());

archive_content_old(#'q11_arch',"berlin11aD.NT","berlin11aS.NT",:upv);


create function berlin11a()-><Charstring,Charstring,Literal> 
as select ss, pp, oo
  from Charstring hasvalue, Charstring property, Charstring isvalueof, Charstring ss, Charstring pp, Charstring oo
 where (prod()=('http://user.it.uu.se/~udbl/sard/prod#offer/_1', property, hasvalue) or  
	prod()=(isvalueof, property, 'http://user.it.uu.se/~udbl/sard/prod#offer/_1') ) and
	((ss ='http://user.it.uu.se/~udbl/sard/prod#offer/_1' and pp= property and oo= hasvalue) or
	 (ss=isvalueof and pp= property and oo= 'http://user.it.uu.se/~udbl/sard/prod#offer/_1'));

create function count_berlin11a()->integer as select count(remove_null(berlin11a()));    

