/*Berlin 1 Archive as CONSTRUCT query */

create function berlin1a()->(Charstring, Charstring, Charstring)
as select distinct product, pred, obj
  from Charstring label, Charstring value1, Charstring obj, Charstring pred, Charstring product,
	Charstring ss, Charstring pp, Charstring oo
 where prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label_fn', label)
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype_fn', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_2')
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature_fn', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_12')
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature_fn', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_20')
   and prod_fn()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1_fn', value1)
   and value1 > '348'
   and (prod_fn()=(product, pred, obj) and ss=product and pp=pred and oo=obj);

create function berlin1a_count()-> Integer as count(remove_null(berlin1a()));
/* 3544 */
create function berlin1_arch()->(Charstring,Charstring,Charstring) as remove_null(berlin1a());
archive_content(#'berlin1_arch',"berlin1_data.nt","berlin1_schema.nt");

