/******************************************************************************/

/*Berlin 7a Archive query - CONSTRUCT */
/* Archive info about a product including offers and reviews */


create function berlin7a()->(Charstring,Charstring,Charstring)
as select distinct ss,pp,oo
  from Charstring productlabel, Charstring offer, Charstring price, Charstring vendor, Charstring vendortitle, Charstring review, Charstring revtitle, Charstring reviewer, Charstring revname, Charstring rating1, Charstring rating2,Charstring ss, Charstring pp, Charstring oo
 where prod_fn()=('http://user.it.uu.se/~udbl/sard/prod#product/_5', 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', productlabel)
   and {vendortitle,price,vendor,offer}=optional((select {vendortitle_o, price_o, vendor_o, offer_o}
                                                    from Charstring offer_o, Charstring date, Charstring vendor_o, Charstring price_o, Charstring vendortitle_o, Charstring vend
                                                   where prod_fn()=(offer_o, 'http://user.it.uu.se/~udbl/sard/prod#offer_of_product', 'http://user.it.uu.se/~udbl/sard/prod#product/_5')
                                                     and prod_fn()=(offer_o, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_price', price_o)
                                                     and prod_fn()=(offer_o, 'http://user.it.uu.se/~udbl/sard/prod#offer_of_vendor', vendor_o)
                                                     and prod_fn()=(vendor_o, 'http://user.it.uu.se/~udbl/sard/prod#vendor/vendor_label', vendortitle_o)
                                                     and prod_fn()=(vendor_o, 'http://user.it.uu.se/~udbl/sard/prod#vendor/vendor_country', 'DE')
                                                     and prod_fn()=(offer_o, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_publisher', vend)
                                                     and prod_fn()=(offer_o, 'http://user.it.uu.se/~udbl/sard/prod#offer/offer_validTo', date)
                                                     and date > '2001-09-16'),{'','','',''})
   and {review,rating2,revtitle,revname,reviewer,rating1}=optional((select {review_o, rating2_o, revtitle_o, revname_o, reviewer_o, rating1_o}
                                                                      from Charstring reviewer_o, Charstring revname_o, Charstring revtitle_o, Charstring review_o, Charstring rating2_o, Charstring rating1_o
                                                                     where prod_fn()=(review_o, 'http://user.it.uu.se/~udbl/sard/prod#review_of_product', 'http://user.it.uu.se/~udbl/sard/prod#product/_5')
                                                                       and prod_fn()=(review_o, 'http://user.it.uu.se/~udbl/sard/prod#review_of_person', reviewer_o)
                                                                       and prod_fn()=(reviewer_o, 'http://user.it.uu.se/~udbl/sard/prod#person/person_name', revname_o)
                                                                       and prod_fn()=(review_o, 'http://user.it.uu.se/~udbl/sard/prod#review/review_title', revtitle_o)
                                                                       and rating1_o=optional((select rating1_oo
                                                                                                 from Charstring rating1_oo
                                                                                                where prod_fn()=(review_o, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating1', rating1_oo)),'')
                                                                       and rating2_o=optional((select rating2_oo
                                                                                                 from Charstring rating2_oo
                                                                                                where prod_fn()=(review_o, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating2', rating2_oo)),'')),{'','','','','',''})
 and
	((ss='http://user.it.uu.se/~udbl/sard/prod#product/_5' and pp='http://user.it.uu.se/~udbl/sard/prod#product/product_label' and oo=productlabel) or
	 (ss=offer and pp='http://user.it.uu.se/~udbl/sard/prod#offer/offer_price' and oo=price) or
	(ss=offer and pp='http://user.it.uu.se/~udbl/sard/prod#offer_of_vendor' and oo=vendor) or
	(ss=vendor and pp='http://user.it.uu.se/~udbl/sard/prod#vendor/vendor_label' and oo= vendortitle) or
	(ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review_of_person' and oo= reviewer) or
 	(ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review/review_title' and oo= revtitle) or
	(ss=reviewer and pp='http://user.it.uu.se/~udbl/sard/prod#person/person_name' and oo= revname) or
	(ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review/review_rating1' and oo=rating1) or
	(ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review/review_rating2' and oo=rating2));


create function berlin7_arch()->(Charstring,Charstring,Charstring)
	as remove_null(berlin7a());

archive_content(#'berlin7_arch',"berlin7_data.nt","berlin7_schema.nt");
 

/*5 result sets */


/******************************************************************************/

/*Berlin 8a Archive - CONSTRUCT query */
/* Give me recent English language reviews for a specific product */

create function berlin8a()->(Charstring,Charstring,Charstring)
as select distinct ss, pp, oo    
  from Charstring title, Charstring text, Charstring reviewdate, Charstring reviewername, Charstring reviewer, Charstring review, Charstring rating1, Charstring rating2, Charstring rating3, Charstring rating4, Charstring oo, Charstring pp, Charstring ss
 where prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review_of_product', 'http://user.it.uu.se/~udbl/sard/prod#product/_6')
   and prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_title', title)
   and prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_text', text)
   and prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_language', 'en')
   and prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_reviewDate', reviewdate)
   and prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review_of_person', reviewer)
   and prod_fn()=(reviewer, 'http://user.it.uu.se/~udbl/sard/prod#person/person_name', reviewername)
   and rating1=optional((select rating1_o
                           from Charstring rating1_o
                          where prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating1', rating1_o)),'')
   and rating2=optional((select rating2_o
                           from Charstring rating2_o
                          where prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating2', rating2_o)),'')
   and rating3=optional((select rating3_o
                           from Charstring rating3_o
                          where prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating3', rating3_o)),'')
   and rating4=optional((select rating4_o
                           from Charstring rating4_o
                          where prod_fn()=(review, 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating4', rating4_o)),'')
	and ( (oo=title and pp='http://user.it.uu.se/~udbl/sard/prod#review/review_title' and ss=review) or 
	      (ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review/review_text' and oo=text) or
	      (ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review/review_reviewDate' and oo= reviewdate) or
	      (ss=review and pp='http://user.it.uu.se/~udbl/sard/prod#review_of_person' and oo= reviewer) or
	      (ss=reviewer and pp= 'http://user.it.uu.se/~udbl/sard/prod#person/person_name' and oo= reviewername) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating1' and oo= rating1) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating2' and oo= rating2) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating3' and oo= rating3) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/prod#review/review_rating4' and oo= rating4));
	       

create function count_berlin8a()->integer as select count(remove_null(berlin8a()));

