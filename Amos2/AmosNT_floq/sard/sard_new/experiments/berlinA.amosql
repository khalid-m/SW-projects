/******************************************************************************/

/*Berlin 8a Archive - CONSTRUCT query */
/* Give me recent English language reviews for a specific product */
/*Best plan :GCT with optional and rowid, no DNF */

/*
1)GCT (old): 1.37
2)GCT with optional:not good enough
3)GCT with optional and rowid : 0.175
4)GCT old late: 0.177 (same result but not plan) as no DNF
5)no DNF : 0.177
6)no GCT: 0.33
*/

/*The OPTIONAL query */
set :q8a =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
 CONSTRUCT
	{?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername .
	 ?review		review:review_rating1		?rating1 .
	 ?review		review:review_rating2		?rating2 .
	 ?review		review:review_rating3		?rating3 .
	 ?review		review:review_rating4		?rating4 . }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{?review		db:review_of_product		product:_6 .
	 ?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_language		'en' .
  	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername .
  OPTIONAL { ?review		review:review_rating1		?rating1 . }
  OPTIONAL { ?review		review:review_rating2		?rating2 . }	
  OPTIONAL { ?review		review:review_rating3		?rating3 . }
  OPTIONAL { ?review		review:review_rating4		?rating4 . } }";


eval("create function exec_q8a()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q8a)); 

create function q8_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q8a());

create function count8a()-> Integer as count(q8_arch());



/*The UNION query*/

set :q8au =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX offer: <http://user.it.uu.se/~udbl/sard/prod#offer/>
 PREFIX producer: <http://user.it.uu.se/~udbl/sard/prod#producer/>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX vendor: <http://user.it.uu.se/~udbl/sard/prod#vendor/>
 PREFIX review: <http://user.it.uu.se/~udbl/sard/prod#review/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX person: <http://user.it.uu.se/~udbl/sard/prod#person/>
 CONSTRUCT
	{?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?review		review:review_rating1		?rating1 .
	 ?review		review:review_rating2		?rating2 .
	 ?review		review:review_rating3		?rating3 .
	 ?review		greview:review_rating4		?rating4 .
	 ?reviewer 		person:person_name		?reviewername  }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {
	{?review		db:review_of_product		product:_6 .
	 ?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_language		'en' .
  	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername 	}
	UNION
	{?review		db:review_of_product		product:_6 .
	 ?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_language		'en' .
  	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername .
  	 ?review		review:review_rating1		?rating1 	}
	UNION
	{?review		db:review_of_product		product:_6 .
	 ?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_language		'en' .
  	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername .
	 ?review		review:review_rating2		?rating2 . 	}	
	UNION
	{?review		db:review_of_product		product:_6 .
	 ?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_language		'en' .
  	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername .
	 ?review		review:review_rating3		?rating3 . 	}
	UNION
	{?review		db:review_of_product		product:_6 .
	 ?review		review:review_title		?title .
	 ?review		review:review_text		?text .
	 ?review		review:review_language		'en' .
  	 ?review		review:review_reviewDate	?reviewdate .
	 ?review		db:review_of_person		?reviewer .
	 ?reviewer 		person:person_name		?reviewername .
	 ?review		review:review_rating4		?rating4 . 	} }";


eval("create function exec_q8au()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q8au)); 

create function q8_archu()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o where (s,p,o) in exec_q8au());

create function count8au()-> Integer as count(q8_archu());


