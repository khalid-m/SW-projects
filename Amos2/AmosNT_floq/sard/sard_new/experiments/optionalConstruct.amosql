set :o3 =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT
	{  ?s 	product:product_label ?label .
	   ?s 	product:product_propertyTex4	?propertytextual4 .
	   ?s	product:product_propertyTex5	?propertytextual5 . }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE { ?s 	product:product_label ?label .
	 ?s 	product:product_propertyNum1 ?pn1 .
	 FILTER (?pn1 > '1990') .
	 OPTIONAL { ?s 	product:product_propertyTex4  ?propertytextual4 .
		 OPTIONAL { ?s	product:product_propertyTex5  ?propertytextual5 .} } }";   

/* ???? Translate 1- translate using only one 'left outer join'  */
create function f3_1()->(Charstring,Charstring,Charstring)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring propertytextual4, Integer pr, Charstring label,Charstring s, Charstring _ss_, Charstring _pp_, Charstring _oo_, Charstring propertytextual5
 where {pr,label,propertytextual4,propertytextual5} = 
sql(jdbcOfDS("producer180mDS"),
"select p3.product_nr,p3.product_label,t.product_propertyTex4,p3.product_propertyTex5 from producer180m.product p3 
 left outer join (select p1.product_nr ,p1.product_label ,p2.product_propertyTex4 from producer180m.product p1 
 left outer join producer180m.product p2 on p1.product_nr=p2.product_nr WHERE p1.product_propertyNum1 >1990)  
 as t on t.product_nr=p3.product_nr WHERE p3.product_propertyNum1 >1990;  ")
and s=rowid(cMap('product','prod'),{pr}) 
and ( (_ss_ = s and _pp_ = pMap('product','product_label','prod') and _oo_ = label) or 
     (_ss_ = s and _pp_ = pMap('product','product_propertyTex4','prod') and _oo_ = propertytextual4) or
     (_ss_ = s and _pp_ = pMap('product','product_propertyTex5','prod') and _oo_ = propertytextual5)) );

/* Translate Query 2- using UNION  */

create function f3_2()->(Charstring,Charstring,Charstring)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring propertytextual4, Integer pr, Charstring label,Charstring s, Charstring _ss_, Charstring _pp_, Charstring _oo_, Charstring propertytextual5,Charstring s1, Charstring s2
 where ({pr,label}=sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_label from producer180m.product p1 WHERE p1.product_propertyNum1 >1990;") and  s=rowid(cMap('product','prod'),{pr}) and( (_ss_ = s and _pp_ = pMap('product','product_label','prod') and _oo_ = label))) 
or
({pr,propertytextual4} = sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_propertyTex4 from producer180m.product p1 WHERE p1.product_propertyNum1 >1990 AND p1.product_propertyTex4 IS NOT NULL;;") and s1=rowid(cMap('product','prod'),{pr}) and( (_ss_ = s1 and _pp_ =  pMap('product','product_propertyTex4','prod') and _oo_ = propertytextual4)))
or
({pr,propertytextual5} = sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_propertyTex5 from producer180m.product p1 WHERE p1.product_propertyNum1 >1990 AND p1.product_propertyTex4 IS NOT NULL;") and s2=rowid(cMap('product','prod'),{pr}) and ( (_ss_ = s2 and _pp_ =  pMap('product','product_propertyTex5','prod') and _oo_ = propertytextual5))));

/*Translate 3 : Query 2 corresponds to the UNION q: use s, s1, s2 to avoid 'DISTINCT' */

set :o3as_un =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT
	{  ?s 	product:product_label           ?label .
	   ?s1 	product:product_propertyTex4	?propertytextual4 .
	   ?s2	product:product_propertyTex5	?propertytextual5 . }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE {{?s 	product:product_label ?label .
	 ?s 	product:product_propertyNum1 ?pn1 .
	 FILTER (?pn1 > '1990') }
	UNION
	{?s1 	product:product_label ?label .
	 ?s1 	product:product_propertyNum1 ?pn1 .
	 FILTER (?pn1 > '1990') .
	 ?s1 	product:product_propertyTex4  ?propertytextual4 .}
	UNION
	{?s2 	product:product_label ?label .
	 ?s2 	product:product_propertyNum1 ?pn1 .
	 FILTER (?pn1 > '1990') .
	 ?s2 	product:product_propertyTex4  ?propertytextual4 .
	 ?s2	product:product_propertyTex5  ?propertytextual5 .} }"; 

/*Important to add ' .. is nOT NULL ..' */

create function f3_3()->(Charstring,Charstring,Charstring)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring propertytextual4, Integer pr, Charstring label,Charstring s, Charstring _ss_, Charstring _pp_, Charstring _oo_, Charstring propertytextual5,Charstring s1, Charstring s2
 where ({pr,label}=sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_label from producer180m.product p1 WHERE p1.product_propertyNum1 >1990;") and  s=rowid(cMap('product','prod'),{pr}) and( (_ss_ = s and _pp_ = pMap('product','product_label','prod') and _oo_ = label))) 
or
({pr,propertytextual4} = sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_propertyTex4 from producer180m.product p1 WHERE p1.product_propertyNum1 >1990;") and s1=rowid(cMap('product','prod'),{pr}) and( (_ss_ = s1 and _pp_ =  pMap('product','product_propertyTex4','prod') and _oo_ = propertytextual4)))
or
({pr,propertytextual4,propertytextual5} = sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_propertyTex4,p1.product_propertyTex5 from producer180m.product p1 WHERE p1.product_propertyNum1 >1990 AND p1.product_propertyTex4 IS NOT NULL;") and s2=rowid(cMap('product','prod'),{pr}) and ( (_ss_ = s2 and _pp_ =  pMap('product','product_propertyTex5','prod') and _oo_ = propertytextual5))));

/*or Important to add ' .. is nOT NULL ..' */
create function f3_4()->(Charstring,Charstring,Charstring)
as remove_null(select _ss_, _pp_, _oo_
  from Charstring propertytextual4, Integer pr, Charstring label,Charstring s, Charstring _ss_, Charstring _pp_, Charstring _oo_, Charstring propertytextual5,Charstring s1, Charstring s2
 where ({pr,label}=sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_label from producer180m.product p1 WHERE p1.product_propertyNum1 >1990;") and  s=rowid(cMap('product','prod'),{pr}) and( (_ss_ = s and _pp_ = pMap('product','product_label','prod') and _oo_ = label))) 
or
({pr,propertytextual4} = sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p1.product_propertyTex4 from producer180m.product p1 WHERE p1.product_propertyNum1 >1990;") and s1=rowid(cMap('product','prod'),{pr}) and( (_ss_ = s1 and _pp_ =  pMap('product','product_propertyTex4','prod') and _oo_ = propertytextual4)))
or
({pr,propertytextual4,propertytextual5} = sql(jdbcOfDS("producer180mDS"),"select p1.product_nr,p2.product_propertyTex4,p1.product_propertyTex5 from producer180m.product p1,producer180m.product p2 WHERE p1.product_propertyNum1 >1990 AND p1.product_nr=p2.product_nr;") and s2=rowid(cMap('product','prod'),{pr}) and ( (_ss_ = s2 and _pp_ =  pMap('product','product_propertyTex5','prod') and _oo_ = propertytextual5))));


set :qo =
"PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT
	{  ?s 	product:product_comment ?comment .
	   ?s 	product:product_propertyTex4	?propertytextual4 .
	   ?s	product:product_propertyTex5	?propertytextual5 .
	   ?s 	product:product_propertyNum4 	?propertynumeric4   }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE { ?s 	product:product_comment ?comment .
	 OPTIONAL { ?s 	product:product_propertyTex4  ?propertytextual4 . 
FILTER REGEX(?propertyTextual4, '*activis*') 
	  	OPTIONAL { ?s	product:product_propertyTex5  ?propertytextual5 . 
			OPTIONAL { ?s 	product:product_propertyNum4  ?propertynumeric4 . } } } }";

eval("create function qo()->(Charstring,Charstring,Literal) as " + parse_sparql(:qo)); 