set :q9_2="SELECT ?s1 ?p1 ?val2
	FROM <http://user.it.uu.se/~udbl/sard/producer180m>
	WHERE {	?s <http://user.it.uu.se/~udbl/sard/producer180m#review/nr> '10'.
		?s <http://user.it.uu.se/~udbl/sard/producer180m#review/person> ?val3.
		?s1 <http://user.it.uu.se/~udbl/sard/producer180m#person/nr> ?val3.
		?s1 ?p1 ?val2.
	FILTER (?p1 != <http://user.it.uu.se/~udbl/sard/producer180m#person/mbox_sha1sum>) 
