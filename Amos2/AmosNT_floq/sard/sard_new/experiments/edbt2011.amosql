/* Help functions needed to rename the columns' names in the benchmark database (for MS SQL server) */

create function rename_colsin_tablsMSSQL(jdbc jd,Charstring dbname, Charstring file)->Boolean
as
  begin
   openwritefile(file);
	for each Charstring tabname,Charstring schema where tables(jd)=<tabname,dbname,schema,"TABLE">
	  rename_columns(jd, tabname);
   closewritefile();
  end;


create function rename_columns(jdbc j,Charstring tabname)->boolean
as
   for each Charstring typec, Charstring colname where columns(j,tabname)= <typec,colname>
	printxmll("sp_RENAME '"+ tabname+"."+colname+"' , '"+tabname+"_"+colname+"';");


create function construct_sql(jdbc j,Charstring tabname,Charstring catalog, Charstring sch,Integer num)->boolean
as
  begin
	declare Charstring prim;
	set prim="";
	for each Charstring pk, Charstring pk_name where primary_keys(j,catalog,sch, tabname)=<pk,pk_name>
	   set prim=prim+pk;
	/*set prim=*/
	for each Charstring typec, Charstring colname where columns(j,tabname)= <typec,colname>
	  begin
		printxmll("sql["+num+"]= "+ "\"select "+prim+","+colname+" from " + tabname+" ;\";");
		set num=num+1;
	  end;
  end;

CONSTRUCT_SQL(jdbcOfDS("producer10milDS"),"person", "producer10mil", "producer10mil",25);


/* Help functions needed to execute single column sql queries with some postprocessing */

craete function execute_allsql(jdbc j)->Boolean
as
   begin
	Declare Vector sqlq, integer i;
	set i=0;
	set sqlq[0]="select review_nr,review_publishDate from review;";
	for each sqlq[i],Vector ve where sql(j, sqlq[i])=ve 
		begin
			set s="<http://user.it.uu.se/~udbl/sard/producer"+v[0];
 			set p="<http://user.it.uu.se/~udbl/sard/producer#property>";
			set val = v[1];
			set i=i+1;
		end;

   end;


/*****************  2 GB database (product 100 000)   ********/

defineDS("producer20milDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=producer20mil",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "producer20mil",
         "producer20mil",
         "product20mil",
         "product20mil");


defineUPV("producer20milDS","prod20mil", "http://user.it.uu.se/~udbl/sard/producer20mil");

DSConnect("prod20mil");	

wrapRDB(jdbcOfDS("producer20milDS"), "producer20mil", "producer20mil", "producer20mil");

assignIDs("prod20mil","producer20mil", "producer20mil");

ViewRDB("prod20mil");

parteval('pmap');
parteval('cmap');

parteval('rowid');

parteval('vector');


Unload query:

set :q="SELECT ?s ?p ?val
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {?s ?p ?val.}";

eval("create function exec_q()-><Charstring,Charstring,Literal> as " + parse_sparql(:q)); 

create function count_q()->Integer as count(exec_q());


Query9: Unbound-property query: Get information about the reviewer that has done review number 10. 


set :q9="SELECT ?s1 ?p1 ?val2
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s <http://user.it.uu.se/~udbl/sard/producer20mil#review/review_nr> '10'.
		?s <http://user.it.uu.se/~udbl/sard/producer20mil#review/review_person> ?val3.
		?s1 <http://user.it.uu.se/~udbl/sard/producer20mil#person/person_nr> ?val3.
		?s1 ?p1 ?val2.}";

eval("create function exec_q9()-><Charstring,Charstring,Literal> as " + parse_sparql(:q9)); 

create function count_q9()->Integer as count(exec_q9());



Query 11: Unbound-property query: Retrieve all the offers with their properties that have deliver days = 5
	and the vendor is from GB



set :q11="SELECT ?s1 ?p1 ?val1
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s1 <http://user.it.uu.se/~udbl/sard/producer20mil#offer/offer_deliveryDays> '5'.
		?s1 ?p1 ?val1.
		?s2 <http://user.it.uu.se/~udbl/sard/producer20mil#vendor/vendor_country> 'GB'.
		?s1 <http://user.it.uu.se/~udbl/sard/producer20mil#offer/offer_vendor> ?val2.
		?s2 <http://user.it.uu.se/~udbl/sard/producer20mil#vendor/vendor_nr> ?val2.}";


eval("create function exec_q11()-><Charstring,Charstring,Literal> as " + parse_sparql(:q11)); 

create function count_q11()->Integer as count(exec_q11());

