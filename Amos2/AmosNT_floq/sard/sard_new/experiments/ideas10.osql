/*Insert procedures*/

create procedure intoCol_customer_c_custkey 
	@numID int, 
	@val int
AS
  begin
	DECLARE @num int;
	SET @num=(SELECT c_custkey FROM customer WHERE c_custkey=@numID);
	if @num is null 
	   BEGIN
		INSERT INTO customer (c_custkey,c_name,c_address,c_nationkey,c_phone,c_acctbal,c_comment,c_segment) VALUES(@numID,'','','','','','','');
		UPDATE customer SET c_custkey=@val WHERE c_custkey=@numID;
	   END
	else
		UPDATE customer SET c_custkey=@val WHERE c_custkey=@numID;
 end;


create procedure intoCol_customer_c_name 
	@numID int, 
	@val varchar
AS
  begin
	DECLARE @num int;
	SET @num=(SELECT c_custkey FROM customer WHERE c_custkey=@numID);
	if @num is null 
	   BEGIN
		INSERT INTO customer (c_custkey,c_name,c_address,c_nationkey,c_phone,c_acctbal,c_comment,c_segment) VALUES(@numID,'','','','','','','');
		UPDATE customer SET c_name=@val WHERE c_custkey=@numID;
	   END
	else
		UPDATE customer SET c_name=@val WHERE c_custkey=@numID;
 end;

sql(jdbcOfDS("customer1DS"),"select O_ORDERKEY,O_CUSTKEY,C_NAME,C_ADDRESS,C_NATIONKEY,C_PHONE,C_ACCTBAL,C_MKTSEGMENT,C_COMMENT from ORDERS O_,CUSTOMER C_ where O_ORDERPRICE = '44730' and C_CUSTKEY = O_CUSTKEY");