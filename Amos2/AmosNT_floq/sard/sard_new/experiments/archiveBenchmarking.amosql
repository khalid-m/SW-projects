/*****************  20mil database (product 100 000)   ********/

defineDS("producer20milDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=producer20mil",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "producer20mil",
         "producer20mil",
         "product20mil",
         "product20mil");


defineUPV("producer20milDS","prod20mil", "http://user.it.uu.se/~udbl/sard/producer20mil");

DSConnect("prod20mil");	

wrapRDB(jdbcOfDS("producer20milDS"), "producer20mil", "producer20mil", "producer20mil");

assignIDs("prod20mil","producer20mil", "producer20mil");

ViewRDB("prod20mil");

parteval('pmap');
parteval('cmap');
parteval('rowid');
parteval('like');
parteval('rmap');
parteval('rmmMap');
parteval('typeMap');
parteval('xsd_Shortmap');
parteval("valueid");
parteval("OBJECT.OBJECT.!=->BOOLEAN");
parteval("CHARSTRING.AREG->CHARSTRING");
lisp;
(setq _rewrite_row_and_like_ T);;rewrite SARD
(setq _el-corcl_ t)
(setq _elcon_ifnounif_ t);;rewrite for { * * ?s. ?s ?p ?o }
(setq _rewrite_row_and_like_ t);;rewrite when FILTER on subject/object
(setq _unif_ t) 
(setq _gct_ t) 
:osql


/*Unload the whole DB*/

set :q="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s ?p ?val}";

eval("create function exec()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q)); 

create function count()->Integer as count(remove_null(exec()));

/*Berlin 1*/

set :berlin1="	PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/> 
	       	PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
		PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
		SELECT ?product ?label 
		FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
		WHERE { 
			?product <http://user.it.uu.se/~udbl/sard/producer20mil#product/product_label> ?label . 
			?product rdf:type <http://user.it.uu.se/~udbl/sard/producer20mil#product> . 
			?product <http://user.it.uu.se/~udbl/sard/producer20mil#product_to_productfeature> <http://user.it.uu.se/~udbl/sard/producer20mil#productfeature/_12>. 
			?product <http://user.it.uu.se/~udbl/sard/producer20mil#product_to_productfeature> <http://user.it.uu.se/~udbl/sard/producer20mil#productfeature/_20> . 
			?product <http://user.it.uu.se/~udbl/sard/producer20mil#product/product_propertyNum1> ?value1 . 
			FILTER (?value1 > '348') }";

eval("create function berlin1()->(Charstring,Charstring) as " + parse_sparql(:berlin1)); 

count(berlin1e());
718

/*Berlin 1 - extended*/

set :berlin1e="	PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
		PREFIX data: <http://user.it.uu.se/~udbl/sard/producer20mil#>
		PREFIX sc: <http://user.it.uu.se/~udbl/sard/producer20mil#product/>
		SELECT ?product ?p ?o
		FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
		WHERE { 
			?product sc:product_label ?label . 
			?product rdf:type data:product . 
			?product data:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer20mil#productfeature/_12>. 
			?product data:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer20mil#productfeature/_20> . 
			?product sc:product_propertyNum1 ?value1 . 
			?product ?p ?o.
			FILTER (?value1 > '348')  }";

eval("create function berlin1e()->(Charstring,Charstring,Charstring) as " + parse_sparql(:berlin1e)); 

count(berlin1e());
28254


/*Berlin 6 */

set :berlin6="  SELECT ?s ?p ?o
		FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
		WHERE {
			?s <http://user.it.uu.se/~udbl/sard/producer20mil#product/product_label> ?label .
			?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://user.it.uu.se/~udbl/sard/producer20mil#product> .
			?s ?p ?o.
			FILTER regex(?label, '%r%')} ";

eval("create function berlin6()->(Charstring,Charstring,Charstring) as " + parse_sparql(:berlin6)); 

count(remove_null(berlin6()));
2 493 853



/*Unload table offer*/

set :q_offer="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://user.it.uu.se/~udbl/sard/producer20mil#offer>.
		?s ?p ?val .}";

eval("create function exec_offer()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q_offer)); 

create function count_offer()->Integer as count(remove_null(exec_offer()));



/*(Berlin 11): Unbound-property query*/

set :q11="SELECT  ?property ?hasValue ?isValueOf 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	{<http://user.it.uu.se/~udbl/sard/producer20mil#offer/_2285> ?property ?hasValue.}
		UNION
		{ ?isValueOf ?property <http://user.it.uu.se/~udbl/sard/producer20mil#offer/_2285> } }";
	

eval("create function exec_q11()-><Charstring,Charstring,Literal> as " + parse_sparql(:q11)); 

create function count_q11()->Integer as count(remove_null(exec_q11()));


/*Berlin 9 inspired (low selectivity): Select the info about a reviewer coming from JP*/

set :q3="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {?s1 <http://user.it.uu.se/~udbl/sard/producer20mil#review/review_person> ?s.
		?s <http://user.it.uu.se/~udbl/sard/producer20mil#person/person_country> 'JP'.
		?s ?p ?val .}";

eval("create function exec_q3()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q3)); 

create function count_q3()->Integer as count(remove_null(exec_q3()));



