/* 6 */



/*Berlin 10- Get cheap offers which fulfill the consumer's delivery requirements*/

set :berlin10 = "PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#>
		PREFIX ven: <http://user.it.uu.se/~udbl/sard/producer180m#vendor/> 
		PREFIX of: <http://user.it.uu.se/~udbl/sard/producer180m#offer/>
		SELECT ?offer ?price 
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			?offer bsbm:offer_of_product <http://user.it.uu.se/~udbl/sard/producer180m#product/_1> .
			?offer bsbm:offer_of_vendor ?vendor .
			?offer of:offer_publisher ?ve .
			?vendor ven:vendor_country  'GB'  .
			?offer of:offer_deliveryDays ?deliveryDays .
			FILTER (?deliveryDays <= '3').
			?offer of:offer_price ?price .
			?offer of:offer_validTo ?date .
			FILTER (?date > '2008-04-19T00:00:00') } ";



eval("create function berlin10()->(Charstring,Charstring) as " + parse_sparql(:berlin10));

/* 1 result*/

/*Berlin 10a Archive -Archive the cheap offers which fulfill the consumer's delivery requirements*/

set :berlin10a = "PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#>
		PREFIX ven: <http://user.it.uu.se/~udbl/sard/producer180m#vendor/> 
		PREFIX of: <http://user.it.uu.se/~udbl/sard/producer180m#offer/>
		SELECT ?offer ?pred ?obj
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			?offer bsbm:offer_of_product <http://user.it.uu.se/~udbl/sard/producer180m#product/_1> .
			?offer bsbm:offer_of_vendor ?vendor .
			?offer of:offer_publisher ?ve .
			?vendor ven:vendor_country  'GB'  .
			?offer of:offer_deliveryDays ?deliveryDays .
			FILTER (?deliveryDays <= '3').
			?offer of:offer_price ?price .
			?offer of:offer_validTo ?date .
			FILTER (?date > '2008-04-19T00:00:00').
			?offer ?pred ?obj. } ";

eval("create function berlin10a()->(Charstring,Charstring,Charstring) as " + parse_sparql(:berlin10a)); 


/*Berlin 10a Archive -Archive the cheap offers which fulfill the consumer's delivery requirements*/
/*CONSTRUCT query */

create function berlin10a()->(Charstring,Charstring,Charstring) 
as select distinct ss, pp, oo
  from Charstring price, Charstring deliverydays, Charstring ve, Charstring vendor, Charstring date, 
	Charstring obj, Charstring pred, Charstring offer,
	Charstring ss, Charstring pp, Charstring oo
 where prod180m()=(offer, 'http://user.it.uu.se/~udbl/sard/producer180m#offer_of_product', 'http://user.it.uu.se/~udbl/sard/producer180m#product/_1')
   and prod180m()=(offer, 'http://user.it.uu.se/~udbl/sard/producer180m#offer_of_vendor', vendor)
   and prod180m()=(offer, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_publisher', ve)
   and prod180m()=(vendor, 'http://user.it.uu.se/~udbl/sard/producer180m#vendor/vendor_country', 'GB')
   and prod180m()=(offer, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_deliveryDays', deliverydays)
   and deliverydays <= '3'
   and prod180m()=(offer, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_price', price)
   and prod180m()=(offer, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_validTo', date)
   and date > '2008-04-19T00:00:00'
   and (prod180m()=(offer, pred, obj) and prod180m()=(ss,pp,oo));


create function count_berlin10a()->integer as select count(remove_null(berlin10a()));

/* 11 */

archive_content(#'berlin10a',"berlin10_data.nt","berlin10_schema.nt");



/*Berlin 11 - Get all information about an offer */

set :berlin11="SELECT  ?property ?hasValue ?isValueOf 
	       FROM <http://user.it.uu.se/~udbl/sard/producer180m>
	       WHERE {	{<http://user.it.uu.se/~udbl/sard/producer180m#offer/_1> ?property ?hasValue.}
	       UNION
		{ ?isValueOf ?property <http://user.it.uu.se/~udbl/sard/producer180m#offer/_1> } }";
	

eval("create function berlin11()-><Charstring,Charstring,Literal> as " + parse_sparql(:berlin11)); 

create function count_q11()->Integer as count(remove_null(berlin11()));
/* 11 */

/*Berlin 11a - Archive all information about an offer (as CONSTRUCT )*/

create function berlin11a()-><Charstring,Charstring,Literal> 
as select ss, pp, oo
  from Charstring hasvalue, Charstring property, Charstring isvalueof, Charstring ss, Charstring pp, Charstring oo
 where (prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#offer/_1', property, hasvalue) or  
	prod180m()=(isvalueof, property, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/_1') ) and
	((ss ='http://user.it.uu.se/~udbl/sard/producer180m#offer/_1' and pp= property and oo= hasvalue) or
	 (ss=isvalueof and pp= property and oo= 'http://user.it.uu.se/~udbl/sard/producer180m#offer/_1'));
    









