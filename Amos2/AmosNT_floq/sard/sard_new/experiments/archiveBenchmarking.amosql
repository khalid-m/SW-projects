/*Berlin 6 - Find products having a label that contains a specific string */

set :berlin6="  PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
		PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#>
		PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
		SELECT ?product ?label
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			?product db:product_label ?label .
			?product rdf:type bsbm:product .
			FILTER regex(?label, '%r%')} ";

eval("create function berlin6()->(Charstring,Charstring) as " + parse_sparql(:berlin6)); 

create function count_berlin6()->integer as select count(remove_null(berlin6()));

/*7344*/

/*Berlin 6 Archive - Find products and their properties having a label that contains a specific string */

create function berlin6a()->(Charstring,Charstring, Charstring)
as select distinct ss,pp,oo
  from Charstring product, Charstring label,Charstring ss, Charstring pp,Charstring oo,
	Charstring pred, Charstring obj
  where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', label)
   and prod180m()=(product, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/producer180m#product')
   and like(label,'%r%') and (prod180m()=(product,pred,obj) and ss=product and pp=pred and oo=obj);

create function count_berlin6a()->integer as select count(remove_null(berlin6a()));

