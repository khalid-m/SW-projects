/*****************  180 MB database (product 10 000)   ********/

defineDS("producer180mDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=producer180m",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "producer180m",
         "producer180m",
         "product180m",
         "product180m");


defineUPV("producer180mDS","prod180m", "http://user.it.uu.se/~udbl/sard/producer180m");
defineUPV("producer180mDS","prod180m_fn", "http://user.it.uu.se/~udbl/sard/producer180m_fn");

DSConnect("prod180m");	

wrapRDB(jdbcOfDS("producer180mDS"), "producer180m", "producer180m", "producer180m");

assignIDs("prod180m","producer180m", "producer180m");

ViewRDB("prod180m");
FunRDB("prod180m");

parteval('pmap');
parteval('cmap');
parteval('rowid');
parteval('like');
parteval('rmap');
parteval('rmmMap');
parteval('typeMap');
parteval('xsd_Shortmap');
parteval("valueid");
parteval("OBJECT.OBJECT.!=->BOOLEAN");
parteval("CHARSTRING.AREG->CHARSTRING");
parteval("TEVEXTENT2");
lisp;
(setq _el-corcl_ t)
(setq _elcon_ifnounif_ t);;rewrite for { * * ?s. ?s ?p ?o }
(setq _rewrite_row_and_like_ t);;rewrite when FILTER on subject/object
(setq _unif_ t) 
(setq _gct_ t) 
;;(setq _sq_ub_ NIL);;NIL if no result for OPTIONAL
:osql
/*set_bijective_function("rowid",true);*/ 
make_def("prod180m");


set :try="	PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#> 
		PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
	  	SELECT ?product ?pred ?obj
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE { 
			?product db:product_propertyTex1 'interfacial biodegradability basting masturbatory distractions cenobite' . 
			?product db:product_propertyNum4 ?pn1 . 
			OPTIONAL {?product db:product_propertyNum6 ?pn2 }.
			FILTER (?pn2 > '50') .
			?product ?pred ?obj }";

eval("create function try()->(Charstring,Charstring,Charstring) as " + parse_sparql(:try)); 

set :try="	PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#> 
		PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
	  	SELECT ?product ?pred ?obj
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE { 
			?product db:product_propertyNum1 ?pn1 . 
			FILTER( ?pn1 > '1998') .
			OPTIONAL {?product db:product_propertyNum6 ?pn2. } .
			?product ?pred ?obj.
		}";

eval("create function try()->(Charstring,Charstring,Charstring) as " + parse_sparql(:try)); 




create function try2()->(Charstring,Charstring,Charstring)
as select ss, pp, oo
  from Charstring pn1, Charstring obj, Charstring pred, Charstring product,Charstring pn2,
	Charstring ss, Charstring pp, Charstring oo
 where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex1', 'interfacial biodegradability basting masturbatory distractions cenobite')
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum4', pn1)  
   and prod180m()=(product, pred, obj)
   and pn2=optional((select pn2_o
                       from Charstring pn2_o
                      where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum6', pn2_o)),'')
   and ( ss=product and pp= pred and oo= obj);



create function try3()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring pn1, Charstring product,Charstring pn2,Charstring pt2, Charstring pn6,
	Charstring ss, Charstring pp, Charstring oo
 where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex1','interfacial biodegradability basting masturbatory distractions cenobite' )
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum4', pn1)
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex2', pt2)
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum6', pn6)
   and pn2=optional((select pn2_o
                       from Charstring pn2_o
                      where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum6', pn2_o)),'')
  and ((ss=product and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex2' and oo=pt2) or (ss=product and  pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum6' and oo=pn6 and NEQ(pn6,'')));

create function try4()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring pn1, Charstring product,Charstring pn2,Charstring pt2, Charstring pn6,
	Charstring ss, Charstring pp, Charstring oo
 where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex1','interfacial biodegradability basting masturbatory distractions cenobite' )
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum4', pn1)
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex2', pt2)
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum6', pn6)
   and pn2=optional((select pn2_o
                       from Charstring pn2_o
                      where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum6', pn2_o)),'')
  and prod180m()=(product,pred,obj) and 
  and (ss=product and pp=pred and oo=obj and NEQ(pn6,'')));


