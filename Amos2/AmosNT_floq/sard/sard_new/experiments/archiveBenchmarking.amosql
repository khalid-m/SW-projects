/*Berlin 4* - Find products matching two different sets of features */

set :berlin4= "	PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#> 
		PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
		SELECT ?product ?label
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			{ ?product db:product_label ?label . 
                          ?product bsbm:product_to_producttype <http://user.it.uu.se/~udbl/sard/producer180m#producttype/_2> . 
           		  ?product bsbm:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12>. 
                          ?product bsbm:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_20>. 
			  ?product db:product_propertyNum1 ?p1 .		  
			   FILTER (?p1 > '348')  } 
			UNION 
			{
			   ?product db:product_label ?label . 
			   ?product bsbm:product_to_producttype <http://user.it.uu.se/~udbl/sard/producer180m#producttype/_1> . 
			   ?product bsbm:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12> . 
                           ?product bsbm:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_8> . 
			   ?product db:product_propertyNum2 ?p2 .
			   FILTER ( ?p2 > '759' ) }
		} ";

eval("create function berlin4()->(Charstring,Charstring) as " + parse_sparql(:berlin4)); 

create function count_berlin4()->integer as select count(berlin4());
/* 131*/


/*Berlin 4 as archive q - Find products (and their properties and values) matching two different sets of features */
/*as CONSTRUCT query */


create function berlin4a()->(Charstring,Charstring,Charstring)
as select distinct ss,pp,oo from Charstring p1, Charstring product, Charstring p2, Charstring label,
			Charstring ss, Charstring pp, Charstring oo, Charstring pred, Charstring obj
	where (prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', label)
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/producer180m#producttype/_2')
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12')
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_20')
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum1', p1)
     and p1 > '348' and p2 = ''
     and (prod180m()=(product,pred,obj) and (ss=product and pp=pred and oo=obj)))  or
        (prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', label)
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/producer180m#producttype/_1')
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12')
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_8')
     and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum2', p2)
     and p2 > '759' and p1 = '' 
     and (prod180m()=(product,pred,obj) and (ss=product and pp=pred and oo=obj)));


create function count_berlin4a()->integer as select count(remove_null(berlin4a()));
