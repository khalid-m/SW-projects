/* 281 961 */


/*Berlin 7- Retrieve in-depth info about a product including offers and reviews */

set :berlin7= "PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#>
	  	PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
		PREFIX of: <http://user.it.uu.se/~udbl/sard/producer180m#offer/>
		PREFIX ven: <http://user.it.uu.se/~udbl/sard/producer180m#vendor/>
		PREFIX per: <http://user.it.uu.se/~udbl/sard/producer180m#person/>
		PREFIX rev: <http://user.it.uu.se/~udbl/sard/producer180m#review/>
		SELECT ?productLabel ?offer ?price ?vendor ?vendorTitle ?review
		?revTitle ?reviewer ?revName ?rating1 ?rating2
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5> db:product_label ?productLabel .
		OPTIONAL {
				?offer bsbm:offer_of_product <http://user.it.uu.se/~udbl/sard/producer180m#product/_5> .
				?offer of:offer_price ?price .
				?offer bsbm:offer_of_vendor ?vendor .
				?vendor ven:vendor_label ?vendorTitle .
				?vendor ven:vendor_country 'DE'.
				?offer of:offer_publisher ?vend .
				?offer of:offer_validTo ?date .
				FILTER (?date > '2001-09-16' ) }.
		OPTIONAL {
				?review bsbm:review_of_product <http://user.it.uu.se/~udbl/sard/producer180m#product/_5> .
				?review bsbm:review_of_person ?reviewer .
				?reviewer per:person_name ?revName .
				?review rev:review_title ?revTitle .
				OPTIONAL { ?review rev:review_rating1 ?rating1 . }.
				OPTIONAL { ?review rev:review_rating2 ?rating2 . }. }. } ";


eval("create function berlin7()->(Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring) as " + parse_sparql(:berlin7)); 


/*5 result sets */

/*Berlin 7a Archive query - Archive info about a product including offers and reviews */
create function berlin7a()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring productlabel, Charstring offer, Charstring price, Charstring vendor, Charstring vendortitle, Charstring review, Charstring revtitle, Charstring reviewer, Charstring revname, Charstring rating1, Charstring rating2,Charstring ss, Charstring pp, Charstring oo
 where prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', productlabel)
   and {vendortitle,price,vendor,offer}=optional((select {vendortitle_o, price_o, vendor_o, offer_o}
                                                    from Charstring offer_o, Charstring date, Charstring vendor_o, Charstring price_o, Charstring vendortitle_o, Charstring vend
                                                   where prod180m()=(offer_o, 'http://user.it.uu.se/~udbl/sard/producer180m#offer_of_product', 'http://user.it.uu.se/~udbl/sard/producer180m#product/_5')
                                                     and prod180m()=(offer_o, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_price', price_o)
                                                     and prod180m()=(offer_o, 'http://user.it.uu.se/~udbl/sard/producer180m#offer_of_vendor', vendor_o)
                                                     and prod180m()=(vendor_o, 'http://user.it.uu.se/~udbl/sard/producer180m#vendor/vendor_label', vendortitle_o)
                                                     and prod180m()=(vendor_o, 'http://user.it.uu.se/~udbl/sard/producer180m#vendor/vendor_country', 'DE')
                                                     and prod180m()=(offer_o, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_publisher', vend)
                                                     and prod180m()=(offer_o, 'http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_validTo', date)
                                                     and date > '2001-09-16'),{'','','',''})
   and {review,rating2,revtitle,revname,reviewer,rating1}=optional((select {review_o, rating2_o, revtitle_o, revname_o, reviewer_o, rating1_o}
                                                                      from Charstring reviewer_o, Charstring revname_o, Charstring revtitle_o, Charstring review_o, Charstring rating2_o, Charstring rating1_o
                                                                     where prod180m()=(review_o, 'http://user.it.uu.se/~udbl/sard/producer180m#review_of_product', 'http://user.it.uu.se/~udbl/sard/producer180m#product/_5')
                                                                       and prod180m()=(review_o, 'http://user.it.uu.se/~udbl/sard/producer180m#review_of_person', reviewer_o)
                                                                       and prod180m()=(reviewer_o, 'http://user.it.uu.se/~udbl/sard/producer180m#person/person_name', revname_o)
                                                                       and prod180m()=(review_o, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_title', revtitle_o)
                                                                       and rating1_o=optional((select rating1_oo
                                                                                                 from Charstring rating1_oo
                                                                                                where prod180m()=(review_o, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating1', rating1_oo)),'')
                                                                       and rating2_o=optional((select rating2_oo
                                                                                                 from Charstring rating2_oo
                                                                                                where prod180m()=(review_o, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating2', rating2_oo)),'')),{'','','','','',''})
 and
	((ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_label' and oo=productlabel) or
	 (ss=offer and pp='http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_price' and oo=price) or
	(ss=offer and pp='http://user.it.uu.se/~udbl/sard/producer180m#offer_of_vendor' and oo=vendor) or
	(ss=vendor and pp='http://user.it.uu.se/~udbl/sard/producer180m#vendor/vendor_label' and oo= vendortitle) or
	(ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review_of_person' and oo= reviewer) or
 	(ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review/review_title' and oo= revtitle) or
	(ss=reviewer and pp='http://user.it.uu.se/~udbl/sard/producer180m#person/person_name' and oo= revname) or
	(ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating1' and oo=rating1) or
	(ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating2' and oo=rating2));


create function berlin7_arch()->(Charstring,Charstring,Charstring)
	as remove_null(berlin7a());

archive_content(#'berlin7_arch',"berlin7_data.nt","berlin7_schema.nt");
 

/*5 result sets - the same as in the berlin7*/


/*Berlin 8 - Give me recent English language reviews for a specific product */

set :berlin8= " PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#>
		PREFIX rev: <http://user.it.uu.se/~udbl/sard/producer180m#review/> 
		PREFIX per: <http://user.it.uu.se/~udbl/sard/producer180m#person/>
		SELECT ?title ?text ?reviewDate ?reviewer ?reviewerName ?rating1 ?rating2 ?rating3 ?rating4
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			?review bsbm:review_of_product <http://user.it.uu.se/~udbl/sard/producer180m#product/_6> . 
			?review rev:review_title ?title .
			?review rev:review_text ?text .
			?review rev:review_language 'en'.
			?review rev:review_reviewDate ?reviewDate .
			?review bsbm:review_of_person ?reviewer .
			?reviewer per:person_name ?reviewerName .
			OPTIONAL {?review rev:review_rating1 ?rating1 }.
			OPTIONAL {?review rev:review_rating2 ?rating2 }.
			OPTIONAL {?review rev:review_rating3 ?rating3 }.
			OPTIONAL {?review rev:review_rating4 ?rating4 } } ";
/*		ORDER BY DESC(?reviewDate) LIMIT 20 "; */

eval("create function berlin8()->(Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring) 
		as " + parse_sparql(:berlin8));


/*Berlin 8a Archive - Give me recent English language reviews for a specific product */
/*CONSTRUCT query */

create function berlin8a()->(Charstring,Charstring,Charstring)
as select distinct ss, pp, oo    
  from Charstring title, Charstring text, Charstring reviewdate, Charstring reviewername, Charstring reviewer, Charstring review, Charstring rating1, Charstring rating2, Charstring rating3, Charstring rating4, Charstring oo, Charstring pp, Charstring ss
 where prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review_of_product', 'http://user.it.uu.se/~udbl/sard/producer180m#product/_6')
   and prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_title', title)
   and prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_text', text)
   and prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_language', 'en')
   and prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_reviewDate', reviewdate)
   and prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review_of_person', reviewer)
   and prod180m()=(reviewer, 'http://user.it.uu.se/~udbl/sard/producer180m#person/person_name', reviewername)
   and rating1=optional((select rating1_o
                           from Charstring rating1_o
                          where prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating1', rating1_o)),'')
   and rating2=optional((select rating2_o
                           from Charstring rating2_o
                          where prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating2', rating2_o)),'')
   and rating3=optional((select rating3_o
                           from Charstring rating3_o
                          where prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating3', rating3_o)),'')
   and rating4=optional((select rating4_o
                           from Charstring rating4_o
                          where prod180m()=(review, 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating4', rating4_o)),'')
	and ( (oo=title and pp='http://user.it.uu.se/~udbl/sard/producer180m#review/review_title' and ss=review) or 
	      (ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review/review_text' and oo=text) or
	      (ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review/review_reviewDate' and oo= reviewdate) or
	      (ss=review and pp='http://user.it.uu.se/~udbl/sard/producer180m#review_of_person' and oo= reviewer) or
	      (ss=reviewer and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#person/person_name' and oo= reviewername) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating1' and oo= rating1) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating2' and oo= rating2) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating3' and oo= rating3) or
	      (ss=review and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#review/review_rating4' and oo= rating4));
	       


/* 2 results */

/*Berlin 8 as archive query -1st var */
/*This query can be rewritten to a query without OPTIONAL since the predicates in the OPTIONAL clauses
  do not appear outside */

set :berlin8a1= " PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#>
		PREFIX rev: <http://user.it.uu.se/~udbl/sard/producer180m#review/> 
		PREFIX per: <http://user.it.uu.se/~udbl/sard/producer180m#person/>
		SELECT ?review ?pred ?obj
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			?review bsbm:review_of_product <http://user.it.uu.se/~udbl/sard/producer180m#product/_6> . 
			?review rev:review_title ?title .
			?review rev:review_text ?text .
			?review rev:review_language 'en'.
			?review rev:review_reviewDate ?reviewDate .
			?review bsbm:review_of_person ?reviewer .
			?reviewer per:person_name ?reviewerName .
			OPTIONAL {?review rev:review_rating1 ?rating1 }.
			OPTIONAL {?review rev:review_rating2 ?rating2 }.
			OPTIONAL {?review rev:review_rating3 ?rating3 }.
			OPTIONAL {?review rev:review_rating4 ?rating4 }.
			?review ?pred ?obj .}" ;


