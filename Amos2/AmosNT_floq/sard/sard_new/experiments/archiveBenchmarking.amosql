/*Berlin 2 *: Retrieve basic information about a specific product for display purposes*/

set :berlin2 =" PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#> 
		PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
		PREFIX prod: <http://user.it.uu.se/~udbl/sard/producer180m#producer/>
		PREFIX pf: <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/>
		SELECT ?label ?comment ?producer ?productFeature ?propertyTextual1
		?propertyTextual2 ?propertyTextual3 ?propertyNumeric1
		?propertyNumeric2 ?propertyTextual4 ?propertyTextual5
		?propertyNumeric4
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_label ?label .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_comment ?comment .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  bsbm:product_of_producer ?p .
			?p prod:producer_label ?producer .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_publisher ?publ .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  bsbm:product_to_productfeature ?f .
			?f pf:productfeature_label ?productFeature .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex1 ?propertyTextual1 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex2 ?propertyTextual2 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex3 ?propertyTextual3 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum1 ?propertyNumeric1 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum2 ?propertyNumeric2 .
			OPTIONAL {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex4 ?propertyTextual4 .}.
			OPTIONAL {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex5 ?propertyTextual5 . }.
			OPTIONAL {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum4 ?propertyNumeric4 . }.} ";

eval("create function berlin2()->(Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring,Charstring) as " + parse_sparql(:berlin2));

/*Berlin 2 as archive query */
/* Archive the following properties of a specific product and the labels of the producers and product features connected to that product*/

set :berlin2a ="PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#> 
		PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
		PREFIX prod: <http://user.it.uu.se/~udbl/sard/producer180m#producer/>
		PREFIX pf: <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/>
		ARCHIVE {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_label ?label .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_comment ?comment .
			?p prod:producer_label ?producer .
			?f pf:productfeature_label ?productFeature .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex1 ?propertyTextual1 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex2 ?propertyTextual2 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex3 ?propertyTextual3 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum1 ?propertyNumeric1 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum2 ?propertyNumeric2 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyText4 ?propertyTextual4 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyText5 ?propertyTextual5 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum4 ?propertyNumeric4 . }
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_label ?label .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_comment ?comment .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  bsbm:product_of_producer ?p .
			?p prod:producer_label ?producer .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_publisher ?publ .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  bsbm:product_to_productfeature ?f .
			?f pf:productfeature_label ?productFeature .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex1 ?propertyTextual1 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex2 ?propertyTextual2 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex3 ?propertyTextual3 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum1 ?propertyNumeric1 .
			<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum2 ?propertyNumeric2 .
			OPTIONAL {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex4 ?propertyTextual4 .}.
			OPTIONAL {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyTex5 ?propertyTextual5 . }.
			OPTIONAL {<http://user.it.uu.se/~udbl/sard/producer180m#product/_5>  db:product_propertyNum4 ?propertyNumeric4 . }.} ";

/*Berlin 2a - CONSTRUCT query */
/*SAQ sends an SQL query for any OPTIONAL (3) and any result of the SQL query obtained from the non-OPTIONAL part */
/*D2RQ send 3 SQL qs for the 3 OPTIONAL and 1 big SQL q for the  non-OPTIONAL part*/
/* D2RQ is processing OPTIONAL as UNION in this case????*/

create function berlin2a()->(Charstring,Charstring,Charstring)
as select distinct ss,pp,oo from Charstring ss,Charstring pp,Charstring oo, Charstring propertynumeric2, Charstring propertytextual3, Charstring propertytextual1, 
Charstring p, Charstring producer, Charstring comment, Charstring label, Charstring publ, Charstring productfeature, Charstring f, Charstring propertytextual2, 
Charstring propertynumeric1, Charstring propertytextual4, Charstring propertytextual5, Charstring propertynumeric4
 where prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', label)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_comment', comment)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product_of_producer', p)
   and prod180m()=(p, 'http://user.it.uu.se/~udbl/sard/producer180m#producer/producer_label', producer)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_publisher', publ)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', f)
   and prod180m()=(f, 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/productfeature_label', productfeature)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex1', propertytextual1)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex2', propertytextual2)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex3', propertytextual3)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum1', propertynumeric1)
   and prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum2', propertynumeric2)
   and propertytextual4=optional((select propertytextual4_o from Charstring propertytextual4_o
                      where prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex4', propertytextual4_o)),'')
   and propertytextual5=optional((select propertytextual5_o from Charstring propertytextual5_o
                      where prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex5', propertytextual5_o)),'')
   and propertynumeric4=optional((select propertynumeric4_o from Charstring propertynumeric4_o
                      where prod180m()=('http://user.it.uu.se/~udbl/sard/producer180m#product/_5', 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum4', propertynumeric4_o)),'')
   and ((ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_label' and oo= label) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_comment' and oo=comment) or
	(ss=p and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#producer/producer_label' and oo= producer) or
	(ss=f and pp= 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/productfeature_label' and oo= productfeature) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex1' and oo=propertytextual1) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex2'and oo=propertytextual2) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex3'and oo= propertytextual3) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum1' and oo= propertynumeric1) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum2' and oo=propertynumeric2) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex4' and oo=propertytextual4) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyTex5' and oo= propertytextual5) or
	(ss='http://user.it.uu.se/~udbl/sard/producer180m#product/_5' and pp='http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum4'and oo= propertynumeric4));

create function berlin2a_count()-> Integer as count(remove_null(berlin2a()));
/* 28 */

create function berlin2_arch()->(Charstring,Charstring,Charstring)
	as remove_null(berlin2a());

create function berlin2_arch2()->(Charstring,Charstring,Charstring)
	as select s,p,o from Charstring s,Charstring p,Charstring o, integer ii
		where bagify(sortbagby(remove_null(berlin2a()),1,'inc'))=(ii,{s,p,o }) ;

create function berlin2_arch()->(Charstring,Charstring,Charstring)
	as select s,p,o from Charstring s,Charstring p,Charstring o, Vector vect,Vector vect2
	where group_by(remove_null(berlin2a()),1)=({s},vect) and in(vect)=vect2 and vect2={p,o};

archive_content(#'berlin2_arch',"berlin2_data.nt","berlin2_schema.nt");
	


/*Berlin 3 mod query */

set :berlin3m= "PREFIX bsbm: <http://user.it.uu.se/~udbl/sard/producer180m#> 
		PREFIX db: <http://user.it.uu.se/~udbl/sard/producer180m#product/>
		SELECT ?product ?label ?testvar
		FROM <http://user.it.uu.se/~udbl/sard/producer180m>
		WHERE {
			?product db:product_label ?label .
			?product bsbm:product_to_producttype <http://user.it.uu.se/~udbl/sard/producer180m#producttype/_2> . 
			?product bsbm:product_to_productfeature <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12>. 
			?product  db:product_propertyNum1 ?p1 .
			FILTER ( ?p1 > '214' ).
			?product  db:product_propertyNum3 ?p3 .			
			FILTER (?p3 < '698' ).
			OPTIONAL {
				?product <http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature> <http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_20> . 
				?product db:product_label ?testVar . } }";		


eval("create function berlin3m()->(Charstring,Charstring) as " + parse_sparql(:berlin3m)); 


/*Berlin 3 - Find products having some features and not having one feature */ 
create function berlin3()->(Charstring,Charstring)
as select product, label
  from Charstring label, Charstring p1, Charstring p3, Charstring product, Charstring testvar
 where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', label)
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/producer180m#producttype/_2')
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12')
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum1', p1)
   and p1 > '214'
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum3', p3)
   and p3 < '698'
   and testvar=optional((select testvar_o
                           from Charstring testvar_o
                          where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_20')
                            and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', testvar_o)),'') and isnull(testvar) and NEQ(testvar,'');


create function count_berlin3()->integer as select count(berlin3());
/* 148 */



/*Berlin 3a (as CONSTRUCT) */
/* Archive query:find products with their properties having some features and not having one feature */ 

create function berlin3a()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring label, Charstring p1, Charstring p3, Charstring product, Charstring testvar,Charstring ss,Charstring pp, Charstring oo,
	Charstring pred, Charstring obj
 where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', label)
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/producer180m#producttype/_2')
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_12')
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum1', p1)
   and p1 > '214'
   and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_propertyNum3', p3)
   and p3 < '698'
   and testvar=optional((select testvar_o
                           from Charstring testvar_o
                          where prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/producer180m#productfeature/_20')
                            and prod180m()=(product, 'http://user.it.uu.se/~udbl/sard/producer180m#product/product_label', testvar_o)),'') and testvar="" 
  and prod180m()=(product,pred,obj) and (ss=product and pp=pred and oo=obj);

