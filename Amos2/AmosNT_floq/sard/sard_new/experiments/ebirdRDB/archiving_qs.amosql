/*7.2)Archive the classes Event and Occurrence for events that happened before 2007-09-08.*/


set :q72="SELECT ?s ?p ?val
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE{	?s2  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://rs.tdwg.org/dwc/terms/Event>.
		?s2 <http://rs.tdwg.org/dwc/terms/eventDate> ?val2.
		FILTER (?val2 < '2007-09-08').
		?s1 <http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence> ?s2.
		{?s ?p ?val.
		 FILTER (?s = ?s2).}
		UNION
		{?s ?p ?val.
		 FILTER (?s = ?s1). }}";


eval("create function exec_q72()-><Charstring,Charstring,Literal> as " + parse_sparql(:q72)); 
create function count_q72()->Integer as count(remove_null(exec_q72()));


/*SAQ: 3 686 952;;  */

create function archive_q72()->(Charstring,Charstring,Charstring)
as
select distinct s_1, p_1, val_1
  from Charstring p_1, Charstring val_1, Charstring cl, Charstring s_1,Charstring s1, Charstring s2, Charstring val2, Charstring s, Charstring p, Charstring val
 where ( bird()=(s2, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Event')
   and bird()=(s2, 'http://rs.tdwg.org/dwc/terms/eventDate', val2)
   and val2 < '2007-09-08'
   and bird()=(s1, 'http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence', s2)
   and ((bird()=(s, p, val)
     and s = s2)
    or  (bird()=(s, p, val)
     and s = s1)) )
   and bird()=(s_1, p_1, val_1)
   and bird()=(cl, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#Class')
   and bird()=(s, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', cl)
   and ((s_1 = cl
     and p_1 = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type')
    or  (bird()=(p, 'http://www.w3.org/2000/01/rdf-schema#domain', cl)
     and s_1 = p
     and p_1 = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type')
    or  (bird()=(p, 'http://www.w3.org/2000/01/rdf-schema#domain', cl)
     and s_1 = p
     and p_1 = 'http://www.w3.org/2000/01/rdf-schema#domain')
    or  (bird()=(p, 'http://www.w3.org/2000/01/rdf-schema#domain', cl)
     and s_1 = p
     and p_1 = 'http://www.w3.org/2000/01/rdf-schema#range')
    or  (s_1 = cl
     and p_1 = 'http://user.it.uu.se/~udbl/sard#PRIMARY_KEY')
    or  (bird()=(cl, 'http://user.it.uu.se/~udbl/sard#PRIMARY_KEY', s_1)
     and p_1 = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type')
    or  (bird()=(cl, 'http://user.it.uu.se/~udbl/sard#PRIMARY_KEY', s_1)
     and p_1 = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#_1'));


8)Archive the classes Event, Occurrence and Location for events observed in Georgia, USA.

set :q8="SELECT ?s ?p ?val
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE{	?s2  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://rs.tdwg.org/dwc/terms/Event>.
		?s2  <http://user.it.uu.se/~udbl/sard/ebird/location_of_event> ?s3.
		?s3 <http://rs.tdwg.org/dwc/terms/stateProvince> 'Georgia'.
		?s3 <http://rs.tdwg.org/dwc/terms/countryCode> 'USA'.
		?s5 <http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence> ?s2.
		{?s ?p ?val.
		 FILTER (?s = ?s2).}
		UNION
		{?s ?p ?val.
		 FILTER (?s = ?s3).}
		UNION
		{?s ?p ?val.
		 FILTER (?s = ?s5).}}";

eval("create function exec_q8()-><Charstring,Charstring,Literal> as " + parse_sparql(:q8)); 

create function count_q8()->Integer as count(exec_q8());

