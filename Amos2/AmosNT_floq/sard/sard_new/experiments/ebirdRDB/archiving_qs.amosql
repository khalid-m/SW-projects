defineDS("ebirdDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=ebird",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "ebird",
         "ebird",
         "ebird",
         "ebird");


Defineupv("ebirdDS","bird", "http://user.it.uu.se/~udbl/sard/ebird");

DSConnect("bird");	

wrapRDB(jdbcOfDS("ebirdDS"), "ebird", "ebird", "ebird");
assign_typeMap("bird", "ebird","ebird");

/*Mappings*/
set cMap("taxon","bird")="http://rs.tdwg.org/dwc/terms/Taxon";   
set cMap("location","bird")="http://purl.org/dc/terms/Location";   
set cMap("event","bird")="http://rs.tdwg.org/dwc/terms/Event";
set cMap("occurrence","bird")="http://rs.tdwg.org/dwc/terms/Occurrence";

set pMap("taxon","tid","bird")="http://user.it.uu.se/~udbl/sard/ebird/taxon_tid";
set pMap("taxon","scientificName","bird")="http://rs.tdwg.org/dwc/terms/scientificName";

set pMap("taxon","acceptedNameUsage","bird")="http://rs.tdwg.org/dwc/terms/acceptedNameUsage";
set pMap("taxon","class","bird")="http://rs.tdwg.org/dwc/terms/class";
set pMap("taxon","taxon_order","bird")="http://rs.tdwg.org/dwc/terms/order";
set pMap("taxon","family","bird")="http://rs.tdwg.org/dwc/terms/family";
set pMap("taxon","genus","bird")="http://rs.tdwg.org/dwc/terms/genus";


set pMap("location","lid","bird")="http://user.it.uu.se/~udbl/sard/ebird/location_lid";
set pMap("location","country","bird")="http://rs.tdwg.org/dwc/terms/country";
set pMap("location","countryCode","bird")="http://rs.tdwg.org/dwc/terms/countryCode";
set pMap("location","stateProvince","bird")= "http://rs.tdwg.org/dwc/terms/stateProvince";
set pMap("location","decimalLatitude","bird")="http://rs.tdwg.org/dwc/terms/decimalLatitude";
set pMap("location","decimalLongitude","bird")="http://rs.tdwg.org/dwc/terms/decimalLongitude";


set pMap("event","eid","bird")="http://user.it.uu.se/~udbl/sard/ebird/event_eid";
set pMap("event","eventID","bird")="http://rs.tdwg.org/dwc/terms/eventID";
set pMap("event","samplingProtocol","bird")="http://rs.tdwg.org/dwc/terms/samplingProtocol";
set pMap("event","samplingEffort","bird")="http://rs.tdwg.org/dwc/terms/samplingEffort";
set pMap("event","eventDate","bird")="http://rs.tdwg.org/dwc/terms/eventDate";
set pMap("event","eventTime","bird")="http://rs.tdwg.org/dwc/terms/eventTime";
set pMap("event","location","bird")="http://user.it.uu.se/~udbl/sard/ebird/location_of_event";

set pMap("occurrence","oid","bird")="http://user.it.uu.se/~udbl/sard/ebird/occurrence_oid";
set pMap("occurrence","recordedBy","bird")="http://rs.tdwg.org/dwc/terms/recordedBy";
set pMap("occurrence","individualCount","bird")="http://rs.tdwg.org/dwc/terms/individualCount";
set pMap("occurrence","taxon","bird")="http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence";
set pMap("occurrence","event","bird")="http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence";
set pMap("occurrence","taxon","bird")="http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence";

set rMap("occurrence","event","event","bird")= "http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence";
set rMap("occurrence","taxon","taxon","bird")= "http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence";
set rMap("event","location","location","bird")= "http://user.it.uu.se/~udbl/sard/ebird/location_of_event";

ViewRDB("bird");

parteval('pmap');
parteval('cmap');
parteval('rowid');
parteval('like');
parteval('rmap');
parteval('rmmMap');
parteval('typeMap');
parteval('xsd_Shortmap');
parteval("valueid");
parteval("OBJECT.OBJECT.!=->BOOLEAN");
lisp;
(setq _sq_always_return_vectors_ nil) 
(setq _el-corcl_ t)
(setq _elcon_ifnounif_ t)
(setq _rewrite_row_and_like_ t)
(setq _unif_ t)
(setq _gct_ t)
:osql   

set_bijective_function("rowid",true);

/*Archiving queries expressed by ARCHIVE (DESCRIBE similar) */

/*1) Archive the whole DB contenet*/


/*1.1)Archive the whole database --->(right) Describe query*/
set :q1="ARCHIVE ?s 
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE {?s ?p ?o}";

create function q11()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from
Charstring pp,Charstring oo,Charstring ss
where bird()=(ss,pp,oo);

1995913
14.847 s


/*1.2)Using Symetric (double side) Describe */ 
/*Problems: */

create function q12()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from Charstring s,Charstring p, Charstring o,
Charstring s1,Charstring p1,Charstring pp,Charstring oo,Charstring ss
where (s,p,o) in bird() and (s1,p1,s) in bird()
and (bird()=(ss,pp,oo) and ss=s ) or (bird()=(ss,pp,oo) and oo=s);

 count(remove_null(q12()));
1995913
109.627 s


/*2)Archive the taxonomy ---> Describe query*/
set :q2= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  ARCHIVE ?s 
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s rdf:type dwc:Taxon.}";

/*2.1)Using one-directional (right) Describe */ 
create function q21()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from Charstring s,
Charstring ss,Charstring pp,Charstring oo
where bird()=(s, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://rs.tdwg.org/dwc/terms/Taxon")
      and  ((bird()=(ss,pp,oo) and ss=s);


/*2.2)Using two-directional (symetrical) Describe */ 
create function q22()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from Charstring s,
Charstring ss,Charstring pp,Charstring oo
where bird()=(s, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://rs.tdwg.org/dwc/terms/Taxon")
      and  ((bird()=(ss,pp,oo) and ss=s) or (bird()=(ss,pp,oo) and oo=s));

count(remove_null(q22()));
355 346
6.75 s


/*3)Archive the whole DB content without the taxonomy ---> Describe query */
set :q3= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  ARCHIVE ?s 
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s rdf:type ?o.
		FILTER (?o != dwc:Taxon) }";

/*31)Using Right Describe */ 
create function q31()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from Charstring s,Charstring o,
Charstring ss,Charstring pp,Charstring oo
where bird()=(s, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", o) and
NEQ(o,"http://rs.tdwg.org/dwc/terms/Taxon") 
and (bird()=(ss,pp,oo) and ss=s);

/*3.2)Using Symetric (double side) Describe */ 
/*Problems: duplicates from the invesre properties that coincide
	with non-inverse properties of the neighbour class*/

create function q32()->(Charstring,Charstring,Charstring)
as select ss,pp,oo from Charstring s,Charstring o,
Charstring ss,Charstring pp,Charstring oo
where bird()=(s, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", o) and
NEQ(o,"http://rs.tdwg.org/dwc/terms/Taxon") 
and ( (bird()=(ss,pp,oo) and ss=s) or (bird()=(ss,pp,oo)and oo=s) );

count(remove_null(q32()));
2 755 371
25.188 s


/*4) Archive all birds observations in terms of 'Event' and 'Occurrence'
without the properties 'samplingProtocol' of 'Event' and
'recordedBy' of 'Occurrence' ---> CONSTRUCT query */

set :q4= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  PREFIX ebird: <http://user.it.uu.se/~udbl/sard/ebird/>
	  ARCHIVE {?s1 ?p1 ?o1.
 		   ?s2 ?p2 ?o2 } 
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s1 rdf:type dwc:Event.
		 ?s2 rdf:type dwc:Occurrence.
		 ?s2 ebird:event_of_occurrence ?s1.
		 ?s1 ?p1 ?o1.
		 FILTER (?p1 != dwc:samplingProtocol).
		 ?s2 ?p2 ?o2.
		FILTER (?p2 != dwc:recordedBy) }";

create function q4()->(Charstring,Charstring,Charstring) 
as select ss,pp,oo from Charstring ss,Charstring pp,Charstring oo,
 Charstring s1,Charstring p1,Charstring o1, Charstring s2,Charstring p2,Charstring o2   
where bird()=(s1,p1,o1) 
and bird()=(s1, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://rs.tdwg.org/dwc/terms/Event") 
and bird()=(s2, "http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence", s1) 
and NEQ (p1,"http://rs.tdwg.org/dwc/terms/samplingProtocol")
and bird()=(s2,p2,o2) 
and bird()=(s2, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://rs.tdwg.org/dwc/terms/Occurrence") 
and NEQ (p2,"http://rs.tdwg.org/dwc/terms/recordedBy")
and ((ss=s1 and pp=p1 and oo=o1) or (ss=s2 and pp=p2 and oo=o2));

 count(remove_null(q4()));
14 747 732
138.951 s

count(q4());
16 258 320
133.687 s


/*5) Archive all the dates on which observations have been made --> CONSTRUCT query*/

set :q5= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  ARCHIVE {?s dwc:eventDate ?o }
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s rdf:type dwc:Event.
		 ?s dwc:eventDate ?o }";

create function q5()->(Charstring,Charstring,Charstring) 
as select ss,pp,oo from Charstring s,Charstring o, Charstring ss, Charstring pp, Charstring oo 
where bird()=(s, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://rs.tdwg.org/dwc/terms/Event")
and bird()=(s, "http://rs.tdwg.org/dwc/terms/eventDate", o) 
and (ss=s and pp="http://rs.tdwg.org/dwc/terms/eventDate" and oo=o);


/*6) Archive all the dates (eventDate) and times (eventTime), and the person (recordedBy) 
who made observations --> CONSTRUCT query */

set :q6= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  PREFIX saq: <http://user.it.uu.se/~udbl/sard/ebird/>
	  ARCHIVE { ?s dwc:eventDate ?o.
		    ?s dwc:eventTime ?o1.
   	            ?s1 dwc:recordedBy ?o2 }
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s rdf:type dwc:Event .
		 ?s dwc:eventDate ?o.
		 ?s dwc:eventTime ?o1.
		 ?s1 rdf:type dwc:Occurrence .
		 ?s1 saq:event_of_occurrence ?s.
		 ?s1 dwc:recordedBy ?o2 }";

create function q6()->(Charstring,Charstring,Charstring) 
as select ss,pp,oo from Charstring s,Charstring o,Charstring o2,
Charstring s1,Charstring o1,Charstring ss,Charstring pp,Charstring oo   
 where bird()=(s, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Event')
   and bird()=(s, 'http://rs.tdwg.org/dwc/terms/eventDate', o)
   and bird()=(s, 'http://rs.tdwg.org/dwc/terms/eventTime', o1)
   and bird()=(s1, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Occurrence')
   and bird()=(s1, 'http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence', s)
   and bird()=(s1, 'http://rs.tdwg.org/dwc/terms/recordedBy', o2)
   and ((ss=s and pp= 'http://rs.tdwg.org/dwc/terms/eventDate' and oo=o)
	or (ss=s and pp= 'http://rs.tdwg.org/dwc/terms/eventTime' and oo=o1)
	or (ss=s1 and pp= 'http://rs.tdwg.org/dwc/terms/recordedBy' and oo=o2));

/*7)Archive classes having the word 'occur' in the class URI (like '*occur*') */

set :q7= "ARCHIVE ?s
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE {?s ?p ?o.
	 FILTER REGEX ( str(?s), '*Occur*')} ";


create function q7()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring s, Charstring p, Charstring o,
	Charstring ss,Charstring pp,Charstring oo 
 where bird()=(s, p, o)
 and like(s,'*Occur*')
 and ( bird()= (ss,pp,oo) and ss=s and pp=p and oo=o);


/*8) Archive these properties in the DB which concern latitude and longitude 
    --> CONSTRUCT query */

set :q8= " PREFIX dc: <http://purl.org/dc/terms>
	  ARCHIVE {?s ?p ?o.
		   ?s ?p1 ?o1 }
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s ?p ?o.
		FILTER REGEX (?p, '*Latitude').
		 ?s1 ?p1 ?o1
		FILTER REGEX (?p1, '*Longitude') }";

create function q8()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring s, Charstring p1, Charstring o1, Charstring p, Charstring o,
	Charstring ss, Charstring pp, Charstring oo
 where bird()=(s, p, o)
   and like(p,'*Latitude')
   and bird()=(s, p1, o1)
   and like(p1,'*Longitude')
   and ((ss=s and pp=p and oo=o) or (ss=s and pp=p1 and oo=o1));


/*9)Archive all species from the bird family 'Ardeidae' that 
have ben seen in state province of New York --> DESCRIBE query */

set :q9= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  PREFIX dc: <http://purl.org/dc/terms/>
	  PREFIX saq: <http://user.it.uu.se/~udbl/sard/ebird/>
	  ARCHIVE ?s1
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s1 rdf:type dwc:Taxon.
		 ?s1 dwc:family 'Ardeidae'.
		 ?s2 rdf:type dc:Location .
		 ?s2 dwc:stateProvince 'New_York'.
		 ?s3 rdf:type dwc:Event.
		 ?s3 saq:location_of_event ?s2.
		 ?s4 rdf:type dwc:Occurrence .
		 ?s4 saq:event_of_occurrence ?s3.
		 ?s4 saq:taxon_of_occurrence ?s1    }";

create function q9()->(Charstring,Charstring,Charstring) 
as select ss, pp, oo
  from Charstring s4, Charstring s2, Charstring s3, Charstring s1,
	Charstring ss, Charstring pp, Charstring oo
 where bird()=(s1, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Taxon')
   and bird()=(s1, 'http://rs.tdwg.org/dwc/terms/family', 'Ardeidae')
   and bird()=(s2, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://purl.org/dc/terms/Location')
   and bird()=(s2, 'http://rs.tdwg.org/dwc/terms/stateProvince', 'New_York')
   and bird()=(s3, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Event')
   and bird()=(s3, 'http://user.it.uu.se/~udbl/sard/ebird/location_of_event', s2)
   and bird()=(s4, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Occurrence')
   and bird()=(s4, 'http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence', s3)
   and bird()=(s4, 'http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence', s1)
   and (bird()=(ss, pp, oo) and ss=s1);


/*10)Archive all species from the bird family 'Ardeidae' and the locations where 
they have ben seen during the period from May to September  --> DESCRIBE query **/

set :q10= "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 	  PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
	  PREFIX dc: <http://purl.org/dc/terms/>
	  PREFIX saq: <http://user.it.uu.se/~udbl/sard/ebird/>
	  ARCHIVE ?s1 ?s2
	  FROM <http://user.it.uu.se/~udbl/sard/ebird>
	  WHERE {?s1 rdf:type dwc:Taxon.
		 ?s1 dwc:family 'Ardeidae'.
		 ?s2 rdf:type dc:Location.
		 ?s3 rdf:type dwc:Event.
		 ?s3 saq:location_of_event ?s2.
		 ?s4 rdf:type dwc:Occurrence.
		 ?s4 saq:event_of_occurrence ?s3.
		 ?s4 saq:taxon_of_occurrence ?s1.
		 ?s3 dwc:eventDate ?d1.
		 ?s3 dwc:eventDate ?d2.
		 FILTER (?d1 >= '2002-05-01').
                 FILTER (?d2 <= '2002-09-30')  }";

create function q10()->(Charstring,Charstring,Charstring) 
as select ss, pp, oo
  from Charstring s4, Charstring s2, Charstring s3, Charstring s1,
	Charstring d1, Charstring d2, Charstring oo, Charstring pp, Charstring ss
 where bird()=(s1, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Taxon')
   and bird()=(s1, 'http://rs.tdwg.org/dwc/terms/family', 'Ardeidae')
   and bird()=(s2, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://purl.org/dc/terms/Location')
   and bird()=(s3, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Event')
   and bird()=(s3, 'http://user.it.uu.se/~udbl/sard/ebird/location_of_event', s2)
   and bird()=(s4, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Occurrence')
   and bird()=(s4, 'http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence', s3)
   and bird()=(s4, 'http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence', s1)
   and bird()=(s3, 'http://rs.tdwg.org/dwc/terms/eventDate', d1)
   and bird()=(s3, 'http://rs.tdwg.org/dwc/terms/eventDate', d2)
   and d1 > '2002-04-30' and d2 < '2002-09-01'
   and ((bird()=(ss, pp, oo) and ss=s1 ) or (bird()=(ss, pp, oo) and ss=s2 ));

/*11)Archive all content having a property like '*code' with a value USA */

set :q11 ="ARCHIVE ?s
	   FROM <http://user.it.uu.se/~udbl/sard/ebird>
	   WHERE{?s ?p 'USA'.
	   FILTER REGEX (?p, '*Code')} "; 

create function q11()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring s, Charstring p,
 Charstring oo, Charstring pp, Charstring ss
 where bird()=(s, p, 'USA')
   and like(p,'*Code')
   and (bird()=(ss, pp, oo) and ss=s );

/*12)Archive all content having a property with value like 'P2*'*/

set :q12="ARCHIVE ?s
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	WHERE{?s ?p ?o.
       FILTER REGEX (?o, 'P2*')} ";

create function q12()->(Charstring,Charstring,Charstring)
as select ss,pp,oo
  from Charstring s, Charstring p,Charstring o,
 Charstring oo, Charstring pp, Charstring ss
 where bird()=(s, p, o)
   and like(o,'P2*')
   and (bird()=(ss, pp, oo) and ss=s and pp=p and oo=o );


/*13)Archive all content having a property with value different than 'Florida'*/
set :q13="ARCHIVE ?s
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	WHERE{?s ?p ?o.
       FILTER (?o != 'Florida')} ";

create function q13()-> (Charstring, Charstring, Charstring)
as select ss,pp,oo
  from Charstring s, Charstring p, Charstring o,
	Charstring oo, Charstring pp, Charstring ss 
 where bird()=(s, p, o)
   and NEQ(o,'Florida')
and  (bird()=(ss, pp, oo) and ss=s and pp=p and oo=o );


/*14)Archive all properties having URIs like '*country' */

set :q14 = "ARCHIVE {?s ?p ?o}
	   FROM <http://user.it.uu.se/~udbl/sard/ebird>
	   WHERE{?s ?p ?o.
	    FILTER REGEX (?p, '*country')} ";

create function q14()->(Charstring,Charstring,Charstring)
as select ss, pp, oo
  from Charstring s, Charstring p, Charstring o,
 Charstring oo, Charstring pp, Charstring ss
 where bird()=(s, p, o)
 and like(p,'*country*')
 and (bird()=(ss, pp, oo) and ss=s and pp=p and oo=o );






