   from Charstring s, Charstring val
   where bird()=<s, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://rs.tdwg.org/dwc/terms/Event'>
   and bird()=<s, 'http://rs.tdwg.org/dwc/terms/samplingEffort', val>
   and bird()=<s, 'http://rs.tdwg.org/dwc/terms/eventID', 'S6009775'> and val != 'sql null';



