/*Mappings*/
set cMap("taxon","bird")="http://rs.tdwg.org/dwc/terms/Taxon";   
set cMap("location","bird")="http://purl.org/dc/terms/Location";   
set cMap("event","bird")="http://rs.tdwg.org/dwc/terms/Event";
set cMap("occurrence","bird")="http://rs.tdwg.org/dwc/terms/Occurrence";

set pMap("taxon","tid","bird")="http://user.it.uu.se/~udbl/sard/ebird/taxon_tid";
set pMap("taxon","scientificName","bird")="http://rs.tdwg.org/dwc/terms/scientificName";
set pMap("taxon","acceptedNameUsage","bird")="http://rs.tdwg.org/dwc/terms/acceptedNameUsage";
set pMap("taxon","class","bird")="http://rs.tdwg.org/dwc/terms/class";
set pMap("taxon","taxon_order","bird")="http://rs.tdwg.org/dwc/terms/order";
set pMap("taxon","family","bird")="http://rs.tdwg.org/dwc/terms/family";
set pMap("taxon","genus","bird")="http://rs.tdwg.org/dwc/terms/genus";

set pMap("location","lid","bird")="http://user.it.uu.se/~udbl/sard/ebird/location_lid";
set pMap("location","country","bird")="http://rs.tdwg.org/dwc/terms/country";
set pMap("location","countryCode","bird")="http://rs.tdwg.org/dwc/terms/countryCode";
set pMap("location","stateProvince","bird")= "http://rs.tdwg.org/dwc/terms/stateProvince";
set pMap("location","decimalLatitude","bird")="http://rs.tdwg.org/dwc/terms/decimalLatitude";
set pMap("location","decimalLongitude","bird")="http://rs.tdwg.org/dwc/terms/decimalLongitude";

set pMap("event","eid","bird")="http://user.it.uu.se/~udbl/sard/ebird/event_eid";
set pMap("event","eventID","bird")="http://rs.tdwg.org/dwc/terms/eventID";
set pMap("event","samplingProtocol","bird")="http://rs.tdwg.org/dwc/terms/samplingProtocol";
set pMap("event","samplingEffort","bird")="http://rs.tdwg.org/dwc/terms/samplingEffort";
set pMap("event","eventDate","bird")="http://rs.tdwg.org/dwc/terms/eventDate";
set pMap("event","eventTime","bird")="http://rs.tdwg.org/dwc/terms/eventTime";

set pMap("event","location","bird")="http://user.it.uu.se/~udbl/sard/ebird/location_of_event";

set pMap("occurrence","oid","bird")="http://user.it.uu.se/~udbl/sard/ebird/occurrence_oid";
set pMap("occurrence","recordedBy","bird")="http://rs.tdwg.org/dwc/terms/recordedBy";
set pMap("occurrence","individualCount","bird")="http://rs.tdwg.org/dwc/terms/individualCount";
set pMap("occurrence","taxon","bird")="http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence";

set pMap("occurrence","event","bird")="http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence";
set pMap("occurrence","taxon","bird")="http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence";

set rMap("occurrence","event","event","bird")= "http://user.it.uu.se/~udbl/sard/ebird/event_of_occurrence";
set rMap("occurrence","taxon","taxon","bird")= "http://user.it.uu.se/~udbl/sard/ebird/taxon_of_occurrence";
set rMap("event","location","location","bird")= "http://user.it.uu.se/~udbl/sard/ebird/location_of_event";

ViewRDB("bird");

parteval('pmap');
parteval('cmap');
parteval('rowid');
parteval('like');
parteval('rmap');
parteval('rmmMap');
parteval('typeMap');
parteval("OBJECT.OBJECT.!=->BOOLEAN");
lisp;
(setq _sq_always_return_vectors_ nil) 
(setq _unif_ t)
(setq _gct_ t)
:osql  

set_bijective_function("rowid",true);



/*Archiving Queries:*/

set :select_sch = "SELECT DISTINCT ?s1 ?p1 ?val1";
set :where_sch = "?s1 ?p1 ?val1.
		?cl  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Class>.
		?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?cl. 
		{FILTER (?s1 = ?cl).
		 FILTER (?p1 =<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}
             UNION
		{  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		   FILTER (?s1 = ?p).
		  FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}
	      UNION
		{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		FILTER (?s1 = ?p).
		FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#domain>)}
	    UNION
		{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		FILTER (?s1 = ?p).
		FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#range>)}  
	     UNION 
		{FILTER (?s1 = ?cl).
		 FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ).}
  	    UNION  
		 {?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
	          FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)} 
	     UNION
		{  ?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
		  FILTER (?p1 = <http://www.w3.org/1999/02/22-rdf-syntax-ns#_1>).  } ";
 

set :where_sch_old = "?s1 ?p1 ?val1.
		?cl  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Class>.
		?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?cl. 
		{FILTER (?s1 = ?cl).
		 FILTER (?p1 =<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}
             UNION
		{  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		   FILTER (?s1 = ?p).
		  FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}
	      UNION
		{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		FILTER (?s1 = ?p).
		FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#domain>)}
	    UNION
		{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		FILTER (?s1 = ?p).
		FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#range>)}  
	     UNION 
		{FILTER (?s1 = ?cl).
		 FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> )}
	     UNION
		  {FILTER (?s1 = ?cl).
                   FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>)}
	     UNION
 		 {FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#REFERENCES>).
		  FILTER(?s1 = ?p).
		  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl. }
		UNION
		 {?p  <http://user.it.uu.se/~udbl/sard#REFERENCES> ?fk.
		  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl. 
		  FILTER (?s1=?fk ).
		 FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#domain>) }
	     UNION
		 {?p  <http://user.it.uu.se/~udbl/sard#REFERENCES> ?fk.
		  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl. 
		  ?fk  <http://www.w3.org/2000/01/rdf-schema#domain> ?s1. 
		 FILTER (?p1 =<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) }
	     UNION  
		 {?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
	          FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)} 
	     UNION
		{  ?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
		  FILTER (?p1 = <http://www.w3.org/1999/02/22-rdf-syntax-ns#_1>).  } ";

/*0)Archive the whole data (without the schema)*/

set :q0="SELECT ?s ?p ?val
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE {?s ?p ?val.
		FILTER (?p !=  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>).
		FILTER (?p != <http://www.w3.org/2000/01/rdf-schema#domain> ).
		FILTER (?p != <http://www.w3.org/2000/01/rdf-schema#range>).
		FILTER (?p != <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY>).
		FILTER (?p != <http://user.it.uu.se/~udbl/sard#FOREIGN_KEY> ).
		FILTER (?p != <http://user.it.uu.se/~udbl/sard#REFERENCES> ).
		FILTER (?p != <http://www.w3.org/1999/02/22-rdf-syntax-ns#_1> ). }";

eval("create function exec_q0()-><Charstring,Charstring,Literal> as " + parse_sparql(:q0)); 


/*1)Archive the whole database*/

set :q1="SELECT ?s ?p ?val
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE {?s ?p ?val.}";

eval("create function exec_q1()-><Charstring,Charstring,Literal> as " + parse_sparql(:q1)); 


create function count_q1()->Integer as count(remove_null(exec_q1()));

/*SARQ: 1 995 914; 6 047 669; 19 242 556; 39 874 996; 68 908 959*/
/*D2RQ: 1 995 789; 6 047 560; 19 242 447; 39 874 887; 68 908 850 */

/*Schema query 1, concerning metadata of q1*/
set :q1_schema="SELECT DISTINCT ?s1 ?p1 ?val1
		 FROM <http://user.it.uu.se/~udbl/sard/ebird>
		 WHERE {?s ?p ?val.
			?s1 ?p1 ?val1.
			?cl  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Class>.
			?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?cl. 
			{FILTER (?s1 = ?cl).
		 	FILTER (?p1 =<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}
             	  UNION
			{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		   	 FILTER (?s1 = ?p).
		  	 FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}
	      	  UNION
			{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
			 FILTER (?s1 = ?p).
			 FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#domain>)}
	    	  UNION
			{?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
			 FILTER (?s1 = ?p).
			 FILTER (?p1 =<http://www.w3.org/2000/01/rdf-schema#range>)}  
	     	  UNION 
			{FILTER (?s1 = ?cl).
		 	 FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ).}
  	    	  UNION  
		 	{?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
	          	 FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)} 
	     	  UNION
			{?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
		  	 FILTER (?p1 = <http://www.w3.org/1999/02/22-rdf-syntax-ns#_1>). } }";

eval("create function schema_q1()-><Charstring,Charstring,Literal> as " + parse_sparql(:q1_schema)); 

count(schema_q1());

