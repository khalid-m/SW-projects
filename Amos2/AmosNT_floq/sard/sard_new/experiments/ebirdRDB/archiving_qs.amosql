/*6)Archive the classes Event and Location without the properties 'decimalLatitude', 'decimalLongitude' 
and 'samplingProtocol'*/

set :q6="SELECT ?s ?p ?val
	 FROM <http://user.it.uu.se/~udbl/sard/ebird>
	 WHERE{ ?s ?p ?val.
		{?s  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://rs.tdwg.org/dwc/terms/Event>.
		FILTER (?p != <http://rs.tdwg.org/dwc/terms/samplingProtocol>)}
               UNION
		{?s  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://purl.org/dc/terms/Location>.
		FILTER (?p != <http://rs.tdwg.org/dwc/terms/decimalLongitude>).
		FILTER (?p != <http://rs.tdwg.org/dwc/terms/decimalLatitude>).} }";

eval("create function exec_q6()-><Charstring,Charstring,Literal> as " + parse_sparql(:q6)); 
create function count_q6()->Integer as count(exec_q6());

