create function q1()-><charstring,charstring,charstring> as
select e4,e5,e6 from integer e1,charstring e2,charstring e3,charstring e4,charstring e5,charstring e6,integer e7 where event_ebird_CC()=<e1,e2,e3,e4,e5,e6,e7> and e6 != "sql null" and  e5 != 'sql null' and e4 !="sql null";