create function query3()->(Charstring, Charstring, Charstring)
as
select _ss_, _pp_, _oo_
  from Charstring value, Charstring subject, Charstring _ss_, Charstring _pp_, 
		Charstring _oo_,Charstring property
 where (subject, property, value) in prod() and like(value, '%symbols%') 
    and ((_ss_ = subject and _pp_ = property and _oo_ = value));


create function q3_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o 
	where (s,p,o) in query3());

create function count3a()-> Integer as count(q3_arch());

