set :dbname="producer180m";
set :catalog="producer180m";
set :schema="producer180m";
set :usern="product180m";
set :passw="product180m";
set :upv="prod";
set :uriOfupv="http://user.it.uu.se/~udbl/sard/prod";


defineDS(:id,
         :url,
         :driver,
         :catalog,
         :schema,
         :usern,
         :passw);
defineUPV(:id,:upv, :uriofupv);
/*defineUPV(:id,:upv_fn, :uriofupv_fn);*/
DSConnect(:upv);	
wrapRDB(jdbcOfDS(:id), :dbname, :catalog, :schema);
assignIDs(:upv,:catalog, :schema);
ViewRDB(:upv);


/*Query 1
 PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX producttype: <http://user.it.uu.se/~udbl/sard/prod#producttype/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 CONSTRUCT {?product ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{?product	 ?property 				?value .
	 ?product	product:product_label			?label .
	 ?product	db:product_to_producttype	 	producttype:_1 .
	 ?product	db:product_to_productfeature	 	productfeature:_3 .
	 ?product	db:product_to_productfeature	 	productfeature:_4 .
	 ?product 	product:product_propertyNum1		?value1 .
	 FILTER (?value1 > '348') }

*/

/* SAQ */
lisp;
(setq _gct_ t)
(setq _unif_ t);;to normalize variable names in a DNF RDB predicate 
:osql
create function query1()->(Charstring,Charstring, Charstring)
as 
	select _ss_, _pp_, _oo_
  from Charstring value1, Charstring product, Charstring label, Charstring property, 
	Charstring value, Charstring _ss_, Charstring _pp_, Charstring _oo_, 
	Charstring val
 where (product, property, value) in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label) in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype', 'http://user.it.uu.se/~udbl/sard/prod#producttype/_1') in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_3') in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature', 'http://user.it.uu.se/~udbl/sard/prod#productfeature/_4') in prod()
   and (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', value1) in prod()
/* eqivalent to rewrite open FILTER */
   and val > '348' and (value1 = valueid(val,'http://www.w3.org/2001/XMLSchema#int') 
			or value1=valueid(val,'http://www.w3.org/2001/XMLSchema#float') 
			or value1 = valueid(val, 'http://www.w3.org/2001/XMLSchema#integer') 
			or value1 = valueid(val, 'http://www.w3.org/2001/XMLSchema#double') 
			or value1 = valueid(val, 'http://www.w3.org/2001/XMLSchema#decimal') )	
      and ((_ss_ = product and _pp_ = property and _oo_ = value));


create function q1_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o 
	where (s,p,o) in query1());

create function count1a()-> Integer as count(q1_arch());


/* SAQ Naive */
lisp;
(setq _gct_ nil)
(setq _unif_ nil);;to normalize variable names in a DNF RDB predicate 
:osql




/*Query 2
 PREFIX db: <http://user.it.uu.se/~udbl/sard/prod#>
 PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 PREFIX producttype: <http://user.it.uu.se/~udbl/sard/prod#producttype/>
 PREFIX productfeature: <http://user.it.uu.se/~udbl/sard/prod#productfeature/>
 PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
 CONSTRUCT { ?product ?property  ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE { 
	?product ?property  ?value .
	?product	product:product_label		?label .
	?product	rdf:type 			 <http://user.it.uu.se/~udbl/sard/prod#product/> .
	FILTER (?property != <http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature> ) .
	FILTER (?property != <http://user.it.uu.se/~udbl/sard/prod#product_to_producttype> ) .
	FILTER REGEX (?label,'*gram*' ) }

*/

/* SAQ */
lisp;
(setq _gct_ t)
(setq _unif_ t);;to normalize variable names in a DNF RDB predicate 
:osql

/* 1 sql query selecting columns from product */
create function query2()->(Charstring,Charstring, Charstring)
as 
select ss,pp,oo
  from Charstring product, Charstring label,Charstring ss, Charstring pp,Charstring oo,
	Charstring pred, Charstring obj, Charstring val
  where prod()=(product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_label', label)
   and prod()=(product, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://user.it.uu.se/~udbl/sard/prod#product')
   and like(val,'%gram%') and label=valueid(val,'http://www.w3.org/2001/XMLSchema#string')
  and pred != 'http://user.it.uu.se/~udbl/sard/prod#product_to_productfeature'
   and pred != 'http://user.it.uu.se/~udbl/sard/prod#product_to_producttype'
	and (prod()=(product,pred,obj) and ss=product and pp=pred and oo=obj) ;


create function q2_arch()->(Charstring,Charstring,Charstring)
	as remove_null(select distinct s,p,o from Charstring s, Charstring p, Charstring o 
	where (s,p,o) in query2());

create function count2a()-> Integer as count(q2_arch());

/* SAQ Naive */
lisp;
(setq _gct_ nil)
(setq _unif_ nil);;to normalize variable names in a DNF RDB predicate 
:osql




