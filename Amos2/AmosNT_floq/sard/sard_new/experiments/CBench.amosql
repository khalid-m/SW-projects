/* REASONING */
/*1)*/
set :query =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {  ?product 	product:product_propertyNum1 '1328' }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{ ?product 	product:product_propertyNum1		'1328'} ";
	 
* Translated by the Sparql parser to */
create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring product, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', '1328') in prod()
      and ((_ss_ = product and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1' and _oo_ = '1328'));

/*Processed by 1 sql query selecting column propertyNum1 in table product*/
/*Reason : part evaluation on the property and invertable valueid and 
vauleid(x,<xsd-type>)  where
Typeof(x) = t and
Xsdmap(t)=<xsd-type> -> x   */


/*1-2 */

set :query =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {  ?product 	product:product_propertyNum1 '1328' }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{ ?product 	product:product_propertyNum1		'http//www.ab.bg'} ";

/*Returns emty without serach in the RDB since 'http//www.ab.bg' is not 
	of type int as product_propertyNum1 */


/* 2*/
set :query =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {  ?product 	?prop '1328' }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{ ?product 	?prop		'1328'} ";

/* Translated by the Sparql parser to */
create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring product, Charstring prop, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (product, prop, '1328') in prod()
      and ((_ss_ = product and _pp_ = prop and _oo_ = '1328'));

/*Processed by 21 sql queries fro the 21 columns in the RDB that are from type intger or float */
/* Reason function valueid is defined so that
vauleid(x,<xsd-type>)  where
Typeof(x) = t and
Xsdmap(t)=<xsd-type> -> x

and thus the 21 sub-views where the object is a typed literal which is not of type integer or float, are eliminated */


/* 3*/
set :query =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {  ?product 	?prop 'Caryn' }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{ ?product 	?prop		'Caryn'} ";

create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring product, Charstring prop, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (product, prop, 'Caryn') in prod()
      and ((_ss_ = product and _pp_ = prop and _oo_ = 'Caryn'));

/*Processed by 27 sql queries selecting 27 columns in the RDB that are from type Varchar*/
/* Reason function valueid is defined so that
vauleid(x,<xsd-type>)  where
Typeof(x) = t and
Xsdmap(t)=<xsd-type> -> x

and thus the 27 sub-views where the object is a typed literal which is not of type xsd:string are eliminated*/


/*4*/
set :query =
"CONSTRUCT  {?sub ?prop <http://user.it.uu.se/~udbl/sard/prod#product/_2549> }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE{ ?sub ?prop <http://user.it.uu.se/~udbl/sard/prod#product/_2549> } ";

/*Translated by the Sparql parser to */
create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring sub, Charstring prop, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (sub, prop, 'http://user.it.uu.se/~udbl/sard/prod#product/_2549') in prod()
      and ((_ss_ = sub and _pp_ = prop and _oo_ = 'http://user.it.uu.se/~udbl/sard/prod#product/_2549'));

/*Processed by 2 sql queries selecting from tables review and offer owning having FK owned by table product */
/*Reason: invertable rowid makes so that the two 2 sub views are lefte where the object can be evaluated to 'http://user.it.uu.se/~udbl/sard/prod#product/_2549' */


/*5*/
set :query =
"CONSTRUCT  {?sub ?prop <novinar.bg> }
FROM <http://user.it.uu.se/~udbl/sard/prod>
WHERE{ ?sub ?prop <novinar.bg> } ";

/*It is not correctly processed */
/*Processed by 27 sql queries selecting 27 columns in the RDB that are from type Varchar*/
/* Reason : it can not see that <novinar.bg> is an IRI not a literal */



/*6*/

set :query =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT {  ?product 	product:product_propertyNum1 ?val }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{ ?product 	product:product_propertyNum1 ?val .
	  FILTER (?val > ' 1000' )}";

/*Translated by the Sparql parser to */
/*!NOT CORRECT Processed by 1 sql query, the filtering is done as postprocessing but the result is not correct */

create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring val, Charstring product, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', val) in prod()
   and val > ' 1000'
      and ((_ss_ = product and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1' and _oo_ = val));


/*!!! Correct Alternative translation, it can be done by the parser instead of a rewrite  */
create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring val, Charstring product, Charstring _ss_, 
	Charstring _pp_, Charstring _oo_, Charstring val1
 where (product, 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1', val) in prod()
   and val1 > '1000' and (val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#int') or
			    val= valueid(val1, 'http://www.w3.org/2001/XMLSchema#float') or
			    val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#integer') or
			    val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#double') or
			   val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#decimal'))
      and ((_ss_ = product and _pp_ = 'http://user.it.uu.se/~udbl/sard/prod#product/product_propertyNum1' 
	and _oo_ = val));



/*7*/

set :query =
"PREFIX product: <http://user.it.uu.se/~udbl/sard/prod#product/>
 CONSTRUCT { ?sub ?prop ?val }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE
	{ ?sub	?prop ?val .
	  FILTER (?val > '9990' )}";


/*Translated by the Sparql parser to */
/*!NOT CORRECT Processed by 76 q ;filtering as post-processing; the result is not correct */
create function query()->(Charstring,Charstring, Charstring)
as
select _ss_, _pp_, _oo_
  from Charstring val, Charstring prop, Charstring sub, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (sub, prop, val) in prod()
   and val > '9995'
      and ((_ss_ = sub and _pp_ = prop and _oo_ = val));


/* Correct translation : 21 q selecting from correct columns(with corrcet data type
				   + 45 q (5 * 9 ) for the 9 fk columns - unnecessary queries
  correct result set: 104 */				
create function query()->(Charstring,Charstring, Charstring)
as
select _ss_, _pp_, _oo_
  from Charstring val, Charstring prop, Charstring sub, Charstring _ss_, 
	Charstring _pp_, Charstring _oo_,Charstring val1
 where (sub, prop, val) in prod()
   and val1 > '9995' and (val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#int') or
			    val= valueid(val1, 'http://www.w3.org/2001/XMLSchema#float') or
			 val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#integer') or
			    val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#double') or
			   val = valueid(val1, 'http://www.w3.org/2001/XMLSchema#decimal') )			   
      and ((_ss_ = sub and _pp_ = prop and _oo_ = val));




/*8*/

set :query=
"
 CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/prod>
 WHERE 
         { ?subject ?property ?value .
	   FILTER REGEX (?value, '%symbols%') } ";

/*Translated by the Sparql parser to */
create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring value, Charstring property, Charstring subject, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (subject, property, value) in prod()
   and like(value, '%symbols%')
      and ((_ss_ = subject and _pp_ = property and _oo_ = value));


/* Correct translation : 27 q selecting from the correct columns 
			+ 9  for the 9 fk columns - unnecessary queries
			 correct result set: 166 */

create function query()->(Charstring,Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring value, Charstring property, Charstring subject, 
	Charstring _ss_, Charstring _pp_, Charstring _oo_, Charstring val1
 where (subject, property, value) in prod()
   and like(val1, '%symbols%') and value = valueid(val1, 'http://www.w3.org/2001/XMLSchema#string')
      and ((_ss_ = subject and _pp_ = property and _oo_ = value));