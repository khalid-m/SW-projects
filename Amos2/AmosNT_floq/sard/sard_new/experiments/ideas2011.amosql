Modified Query 11 (lower selectivity)
Unbound-property query: Retrieve all the info about offers that have deliver days = 5
			and the vendor country is GB


set :q11_ls="SELECT ?property ?hasValue ?isValueOf
	FROM <http://user.it.uu.se/~udbl/sard/producer180m>
	WHERE {	?offer <http://user.it.uu.se/~udbl/sard/producer180m#offer/offer_deliveryDays> '5'.
		{?offer ?property ?hasValue.}
	  UNION
	       { ?isValueOf ?property ?offer} }";
	

eval("create function exec_q11_ls()-><Charstring,Charstring,Charstring> as " + parse_sparql(:q11_ls)); 

create function count_q11_ls()->Integer as count(exec_q11_ls());



