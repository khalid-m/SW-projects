/*****************  20mil database (product 100 000)   ********/

defineDS("producer20milDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=producer20mil",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "producer20mil",
         "producer20mil",
         "product20mil",
         "product20mil");


defineUPV("producer20milDS","prod20mil", "http://user.it.uu.se/~udbl/sard/producer20mil");

DSConnect("prod20mil");	

wrapRDB(jdbcOfDS("producer20milDS"), "producer20mil", "producer20mil", "producer20mil");

assignIDs("prod20mil","producer20mil", "producer20mil");

ViewRDB("prod20mil");

parteval('pmap');
parteval('cmap');
parteval('rowid');
parteval('like');
parteval('rmap');
parteval('rmmMap');
parteval("OBJECT.OBJECT.!=->BOOLEAN");
lisp;
(setq _sq_always_return_vectors_ nil) 
(setq _unif_ t)
(setq _gct_ t)
(setq _el-corcl_ t)
:osql  
set_bijective_function("rowid",true);

/*Unload the whole DB*/

set :q="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s ?p ?val}";

eval("create function exec()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q)); 

create function count()->Integer as count(remove_null(exec()));



/*Query 1: Unload table offer*/

set :q_offer="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://user.it.uu.se/~udbl/sard/producer20mil#offer>.
		?s ?p ?val .}";

eval("create function exec_offer()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q_offer)); 

create function count_offer()->Integer as count(remove_null(exec_offer()));



/*Query 2 (Berlin 11): Unbound-property query*/

set :q11="SELECT  ?property ?hasValue ?isValueOf 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	{<http://user.it.uu.se/~udbl/sard/producer20mil#offer/_2285> ?property ?hasValue.}
		UNION
		{ ?isValueOf ?property <http://user.it.uu.se/~udbl/sard/producer20mil#offer/_2285> } }";
	

eval("create function exec_q11()-><Charstring,Charstring,Literal> as " + parse_sparql(:q11)); 

create function count_q11()->Integer as count(remove_null(exec_q11()));


/* Query 3 */
/*Berlin 9 inspired (low selectivity): Select the info about a reviewer coming from JP*/

set :q3="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {?s1 <http://user.it.uu.se/~udbl/sard/producer20mil#review/review_person> ?s.
		?s <http://user.it.uu.se/~udbl/sard/producer20mil#person/person_country> 'JP'.
		?s ?p ?val .}";

eval("create function exec_q3()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q3)); 

create function count_q3()->Integer as count(remove_null(exec_q3()));


/* Query 4 */
/*Berlin 9 inspired (high selectivity): Select the info about a reviewer coming from JP*/

set :q4="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {	?s <http://user.it.uu.se/~udbl/sard/producer20mil#person/person_name> 'Aaida'.
		?s ?p ?val .}";

eval("create function exec_q4()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q4)); 

create function count_q4()->Integer as count(remove_null(exec_q4()));


/* Query 3 old */
/*Berlin 9 inspired (low selectivity): Select the info about a reviewer coming from JP*/

set :q3_old="SELECT  ?s ?p ?val 
	FROM <http://user.it.uu.se/~udbl/sard/producer20mil>
	WHERE {?s <http://user.it.uu.se/~udbl/sard/producer20mil#offer/offer_deliveryDays> '5'.
		?s  <http://user.it.uu.se/~udbl/sard/producer20mil#offer/offer_vendor> ?s1.
		?s1 <http://user.it.uu.se/~udbl/sard/producer20mil#vendor/vendor_country> 'JP'.
		?s ?p ?val .}";

eval("create function exec_q3_old()->(Charstring,Charstring,Charstring) as " + parse_sparql(:q3_old)); 

create function count_q3_old()->Integer as count(remove_null(exec_q3_old()));



