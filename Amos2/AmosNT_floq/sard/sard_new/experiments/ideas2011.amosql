Query9: Unbound-property query: Get information about the reviewer that has done review number 10. 


set :q9="SELECT ?s1 ?p1 ?val2
	FROM <http://user.it.uu.se/~udbl/sard/producer37m>
	WHERE {	?s <http://user.it.uu.se/~udbl/sard/producer37m#review/review_nr> '10'.
		?s <http://user.it.uu.se/~udbl/sard/producer37m#review/review_person> ?val3.
		?s1 <http://user.it.uu.se/~udbl/sard/producer37m#person/person_nr> ?val3.
		?s1 ?p1 ?val2.}";

eval("create function exec_q9()-><Charstring,Charstring,Literal> as " + parse_sparql(:q9)); 

create function count_q9()->Integer as count(exec_q9());


