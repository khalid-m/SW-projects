/**********************************GENERAL FUNCTIONS**************************************************************************/


create function clearURI(Charstring dbURI,Charstring baseURI)->Charstring
as  /*begin declare Charstring baseURI;*/
	/*set baseURI="http://user.it.uu.se/~udbl/sard/person";*/
	result substring(dbURI,char_length(baseURI)+2,char_length(dbURI)-2);
   /* end;*/

/************************************************************************************************************************/
lisp;
(defun str-exp (fno str del res)
(osql-result str del (second(string-explode str del))))

:osql
create function str_exp(Charstring str,Charstring del)-> Charstring
as foreign "str-exp";

lisp;
(defun str-exp1 (fno str del res)
(osql-result str del (first(string-explode str del))))

:osql
create function str_exp1(Charstring str,Charstring del)-> Charstring
as foreign "str-exp1";

lisp;
(defun str-exp3 (fno str del res)
   (osql-result str del (listtoarray (string-explode str del))))

:osql
create function str_exp3(Charstring str,Charstring del)-> Vector
as foreign "str-exp3";

/************************************************************************************************************************/
			/***FUNCTIONS FOR MANIPULATING SCHEMA FILES ***/
/************************************************************************************************************************/

/*Create a stored function in Amos*/

create function schema(Charstring s, Charstring p, Charstring o, Charstring t)-> Boolean as stored;

/* Function to clean the content of the stored function since if you import a new file it will add  new content to the the old one:*/

create function cleanS()->Boolean
   as for each Charstring s, Charstring p, Charstring o,Charstring t where schema(s,p,o,t)=true
        set schema(s,p,o,t)=false;

/* Function to import a schema file and populate the stored function*/

create function importS(Charstring file)-> boolean
as
   for each Charstring s, Charstring p, Charstring o, Charstring t, Charstring d where {s,p,o,t,d} =read_ntuples(file)
           or {s,p,o,t} =read_ntuples(file)
       add schema(s,p,o,t)=true;

/* How to use the stored function*/

create function readTuples(Charstring filename1)
->(Charstring,Charstring,Charstring )
/*Retrieves s,p,v from the given filename*/
as
	select v[0],v[1],v[2] from  Vector v 
		where read_ntuples(filename1)=v;

create function readTuples1(Charstring filename1)
->(Charstring,Charstring,Charstring,Charstring )
/*Retrieves s,p,v from the given filename*/
as
	select v[0],v[1],v[2],v[3] from  Vector v 
		where read_ntuples(filename1)=v;
/************************************************************************************************************************/
			/***RETRIEVING TABLES FROM GIVEN FILES ***/
/************************************************************************************************************************/
create function ret_tableURIs1()
->Charstring 
/*Retrieve URI  of the table in the file*/
as select s from Charstring s , Charstring p, Charstring v,Charstring t where schema(s,p,v,t)=true and
 p="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" and v="<http://www.w3.org/2000/01/rdf-schema#Class>";

create function ret_fkInNT(Charstring tableURI)
->charstring
/* Retrieves the URI of corresponding foreign key column that is represented only in data file.*/
as
select v from Charstring s, Charstring p, Charstring v, Charstring t
where schema(s,p,v,t)=true and s=tableURI and p="<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>";

create function ret_tableURIs_CT()
->Charstring 
/*Retrieve all URIs (including connecting table) of the table in the file*/
as 
select s from Charstring s,Charstring p, Charstring v,Charstring t,Charstring s1 ,Charstring p1, Charstring v1,charstring t1
where schema(s,p,v,t)=true and p="<http://www.w3.org/2000/01/rdf-schema#range>" and v in ret_tableURIs1() 
and schema(s1,p1,v1,t1)=true and s1=s and p1="<http://www.w3.org/2000/01/rdf-schema#domain>" 
and notany(s in ret_fkinNT(v1));


create function ret_tableURIs()
->Charstring 
as
begin
	result ret_tableURIs1();
	result ret_tableURIs_CT();
end;

create function ret_tableName(Charstring baseURI)
->Charstring
as result clearURI(ret_tableURIs(),baseURI);

create function ret_tableNameURIs(Charstring baseURI)
->(Charstring ,Charstring)
/*Retrieve URI  of the table in the file*/
as
select s,clearURI(s,baseURI) from Charstring s , Charstring p, Charstring v,Charstring t 
where schema(s,p,v,t)=true and p="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" 
and v="<http://www.w3.org/2000/01/rdf-schema#Class>";

 
/************************************************************************************************************************/
			/*** RETRIEVING COLUMNS FROM GIVEN FILE***/
/************************************************************************************************************************/
create function ret_pkURI_woct(Charstring tableURI)
->Charstring
/*Retrieve the URI of the PK of the table represented by tableURI*/
as select v1 from Charstring s,Charstring p,Charstring v ,Charstring t, charstring s1, Charstring p1, Charstring v1,Charstring t1
where schema(s,p,v,t)=true and s=tableURI and p="<http://user.it.uu.se/~udbl/sard#PRIMARY_KEY>" 
and schema(s1,p1,v1,t1) and s1=v
and v1!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq>" and like(p1,"<http://www.w3.org/1999/02/22-rdf-syntax-ns#*");

create function ret_columnURIs_woct1(Charstring tableURI)
->Charstring
/*Retrieve URI of the column or property of given table represented by tabelURI*/
as select s from Charstring s,Charstring p, Charstring v,Charstring t,Charstring s1,Charstring p1,Charstring v1,Charstring t1
where schema(s,p,v,t)=true and p="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" and v="<http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>" 
and schema(s1,p1,v1,t1)=true and s1=s and p1="<http://www.w3.org/2000/01/rdf-schema#domain>" and v1=tableURI 
and notany(schema(s,p,v,t)=true and s=tableURI and p="<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>" )
and notany(s in ret_tableURIs_CT());


create function ret_columnURIs_wocta(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring)
/*Retrieve URI and Name of the column or property of given table represented by tabelURI*/
as 
select s,clearURI(s,baseURI) from Charstring s,Charstring p, Charstring v,Charstring t,Charstring s1,Charstring p1,Charstring v1,Charstring t1
where schema(s,p,v,t)=true and p="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" and v="<http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>" 
and schema(s1,p1,v1,t1)=true and s1=s and p1="<http://www.w3.org/2000/01/rdf-schema#domain>" and v1=tableURI 
and notany(schema(s,p,v,t)=true and s=tableURI and p="<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>" )
and notany(s in ret_tableURIs_CT());

create function ret_columnURIs_woct(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring)
as
begin 
	for each Charstring ch1, Charstring ch2 where ret_columnURIs_wocta(tableURI,baseURI)=<ch1,ch2>
	begin
		if like(ch2,"*/*") then
			result (ch1,ch2);
	end;
end;



create function ret_columnURIs_withCT1(Charstring tableURI)
->Charstring
as
begin	for each Charstring s,Charstring p, Charstring v,Charstring t where schema(s,p,v,t)=true and s=tableURI
	begin
		if (p="<http://www.w3.org/2000/01/rdf-schema#range>") then
			result ret_pkURI_woct(v)
		else if (p="<http://www.w3.org/2000/01/rdf-schema#domain>") then
			result ret_pkURI_woct(v);
	end;
end;

create function ret_columnURIs_withCT(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring)
as
begin	for each Charstring s,Charstring p, Charstring v,Charstring t where schema(s,p,v,t)=true and s=tableURI
	begin
		if (p="<http://www.w3.org/2000/01/rdf-schema#range>") then
			result (ret_pkURI_woct(v),clearURI(ret_pkURI_woct(v),baseURI))
		else if (p="<http://www.w3.org/2000/01/rdf-schema#domain>") then
			result (ret_pkURI_woct(v),clearURI(ret_pkURI_woct(v),baseURI));
	end;
end;
	
create function ret_pkURI_withCT(Charstring tableURI)
->Charstring
as
begin
	if (tableURI in ret_tableURIs_CT()) then
		result ret_columnURIs_withCT1(tableURI)
	else
		result ret_columnURIs_woCT1(tableURI);
end;

create function ret_pkURIs(Charstring tableURI)
->Charstring
as
begin
	if (tableURI in ret_tableURIs_CT()) then
		result ret_pkURI_withCT(tableURI)
	else
		result ret_pkURI_woCT(tableURI);
end;

create function ret_columnURIs(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring)
as
begin
	if (tableURI in ret_tableURIs_CT()) then
		result ret_columnURIs_withCT(tableURI,baseURI)
	else
		result ret_columnURIs_woCT(tableURI,baseURI);
end;

create function ret_columnURIs1(Charstring filename,Charstring baseURI)
->(Charstring,Charstring)
/*Retrieve URI of the column or property of given table represented by tabelURI*/
as select s,clearURI(s,baseURI) from Charstring s,Charstring p, Charstring v,Charstring s1 where readtuples(filename)=<s,p,v>
and p="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" and v="<http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>" 
and read_ntuples(filename)= {s, "<http://www.w3.org/2000/01/rdf-schema#domain>",s1,"."} 
and notany(read_ntuples(filename)= {s1,"<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>",s,"."});


create function ret_references(Charstring tableURI)
->Charstring as 
select s from Charstring s, Charstring p, Charstring v,Charstring t,Charstring s1,Charstring p1,Charstring v1,Charstring t1 
where schema(s,p,v,t)=true and p="<http://user.it.uu.se/~udbl/sard#REFERENCES>" 
and schema(s1,p1,v1,t1)=true and s1=s and p1="<http://www.w3.org/2000/01/rdf-schema#domain>" and v1=tableURI;

create function ret_colfk_data(Charstring tableURI,Charstring baseURI)
->Charstring
as
begin 
	declare integer z;
	set z=0;
	for each Charstring ch1,Charstring ch2 where ret_columnURIs_wocta(tableURI,baseURI)=<ch1,ch2>
	begin
		for each Charstring ch3 where ret_references(tableURI)=ch3
		begin
			if (ch3=ch1) then 
				set z=1;
		end;
		if z!=1 then 
			result ch1;
		set z=0;
	end;
end;
/************************************************************************************************************************/
			/***RETRIEVING PRIMARY KEY FROM GIVEN FILE ***/
/************************************************************************************************************************/
create function ret_pkName(Charstring tableURI,Charstring baseURI)
->Charstring
/*Retrieve the name of the PK of the table represented by tableURI*/
as
begin 
for each Charstring ch where ret_pkURIs(tableURI)=ch

	result str_exp(clearURI(ch,baseURI),'/') ;
end;

create function ret_pkName1(Charstring tableURI,Charstring baseURI)
->Charstring
/*Retrieve the name of the PK of the table represented by tableURI*/
as
begin 
declare Charstring pkname;
set pkname="";
for each Charstring ch where  ret_pkURIs(tableURI)=ch
begin
	set pkname=pkname+str_exp(clearURI(ch,baseURI),'/') ;
end;
result pkname;
end;

create function ret_pk(Charstring tableURI,Charstring baseURI)
->Charstring
/*Retrieve the name of the PK of the table represented by tableURI*/
as 
	result str_exp(clearURI(ret_pkURIs(tableURI),baseURI),'/');


/************************************************************************************************************************/
			/***RETRIEVING FOREIGN KEY FROM GIVEN FILE ***/
/************************************************************************************************************************/
create function ret_fkURI(Charstring tableURI)->Charstring
/*Retrieve the URI of the FK of the table represented by tableURI*/
as select v from Charstring s,Charstring p, Charstring v,Charstring t,Charstring s1,Charstring p1, Charstring v1,Charstring t1
where schema(s1,p1,v1,t1)=true and p1="<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>" and s1=tableURI and
schema(s,p,v,t)=true and s=v1 and p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>"
and like(p,"<http://www.w3.org/1999/02/22-rdf-syntax-ns#*");

create function ret_fkURI11_woct(Charstring tableURI)
->(Charstring,Charstring)
/*Retrieve the URI of the FK along with its p and v  of the table represented by tableURI*/
as select s,v from Charstring s,Charstring p, Charstring v,Charstring t,Charstring t1,Charstring s1,Charstring p1, Charstring v1
where schema(s1,p1,v1,t1)=true and p1="<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>" and s1=tableURI and
schema(s,p,v,t)=true and s=v1 and p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" 
and like(p,"<http://www.w3.org/1999/02/22-rdf-syntax-ns#*");

create function ret_fkURI11_withCT(Charstring tableURI)
->(Charstring,Charstring)
as
begin
	for each Charstring s,Charstring p, Charstring v,Charstring t where schema(s,p,v,t) and s=tableURI
	begin
		if (p="<http://www.w3.org/2000/01/rdf-schema#range>") then
			result (ret_pkURIs(v),v) 
		else if (p="<http://www.w3.org/2000/01/rdf-schema#domain>") then
			result (ret_pkURIs(v),v); 
	end;
end;

create function ret_fkURI11(Charstring tableURI)
->(Charstring,Charstring)
as
begin
	if (tableURI in ret_tableURIs_CT()) then
		result ret_fkURI11_withCT(tableURI)
	else
		result ret_fkURI11_woCT(tableURI);
end;

create function ret_fk(Charstring tableURI,Charstring baseURI)
->Charstring
/*Retrieve the URI of the FK of the table represented by tableURI*/
as select clearURI(v,baseURI) from Charstring s,Charstring p, Charstring v,Charstring t, Charstring t1,Charstring s1,Charstring p1, Charstring v1
where schema(s1,p1,v1,t1)=true and p1="<http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>" and s1=tableURI and
schema(s,p,v,t)=true and s=v1 and p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" 
and like(p,"<http://www.w3.org/1999/02/22-rdf-syntax-ns#*");

create function ret_fkRef(Charstring colURI)
-> charstring
/* Retrieves the URI of corresponding column that references to the foreign key.*/
as
select v from Charstring s, Charstring p, Charstring v,Charstring t
where schema(s,p,v,t)=true and p="<http://user.it.uu.se/~udbl/sard#REFERENCES>" 
and s=colURI;

create function ret_fkMap(Charstring fkURI)->Charstring
/*Retrieve the URI of the Mapped Column that is represented by FK in NT file*/
as select v1 from Charstring s1,Charstring p1, Charstring v1,Charstring t1
where schema(s1,p1,v1,t1)=true and s1=fkURI and p1!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" 
and like(p1,"<http://www.w3.org/1999/02/22-rdf-syntax-ns#*") ;


create function ret_fkRef1(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring,Charstring,Charstring,Charstring)
/*Generates INSERT INTO statements to insert column and data into the table while scanning the NT-file (containing only Charstring data) row by row*/
as
begin
	declare Charstring t1, charstring t2,charstring t3,charstring t, charstring tname, charstring tname_ref;
	set t="";
	set t1="";
	set t2="";
	set t3="";
	set tname="";
	set tname_ref="";

	if (tableURI in ret_tableURIs_CT()) then
	begin
		for each charstring s,charstring v where ret_fkURI11(tableURI)=<s,v>
		begin
			if(s!=t) then
	        	begin
		 		if (t!="")then
					begin				
				 		result (t1,tname,t3,t2,tname_ref);
			       	 	end;
					set t1="";
					set t2="";
					set t3="";
					set t=s;
    			                set tname=clearURI(tableURI,baseURI);
			end;	
			if(v!="") then
			begin
				set t2=str_exp(clearURI(s,baseURI),'/')+" ,"+t2;
				set t3=t3+"_"+str_exp(clearURI(s,baseURI),'/');
				set t1=str_exp(clearURI(s,baseURI),'/')+" ,"+t1;
	
			end; 
			set t1=substring(t1,0,char_length(t1)-2);
	                set t2=substring(t2,0,char_length(t2)-2);
        	        set t3=substring(t3,1,char_length(t3));
                	set tname_ref=str_exp1(clearURI(v,baseURI),'/');
  		end;
	end
	else
	begin
		for each charstring s,charstring v where ret_fkURI11(tableURI)=<s,v>
		begin
			if(s!=t) then
	        	begin
		 		if (t!="")then
					begin				
				 		result (t1,tname,t3,t2,tname_ref);
			       	 	end;
					set t1="";
					set t2="";
					set t3="";
					set t=s;
    			                set tname=clearURI(tableURI,baseURI);
			end;	
			if(v!="") then
			begin
				set t2=str_exp(clearURI(ret_fkref(v),baseURI),'/')+" ,"+t2;
				set t3=t3+"_"+str_exp(clearURI(v,baseURI),'/');
				set t1=str_exp(clearURI(v,baseURI),'/')+" ,"+t1;
			end; 	
                	set t1=substring(t1,0,char_length(t1)-2);
	                set t2=substring(t2,0,char_length(t2)-2);
        	        set t3=substring(t3,1,char_length(t3));
                	set tname_ref=str_exp1(clearURI(ret_fkref(v),baseURI),'/');
  		end;
	end;
	result (t1,tname,t3,t2,tname_ref);

end;

/************************************************************************************************************************/
			/***RETRIEVING COLUMN SIZE FROM GIVEN FILE ***/
/************************************************************************************************************************/

create function ret_ColSize(Charstring colURI)->Charstring
/*Retrieve the size  of data Size of column or attribute*/
as select v from Charstring s, Charstring p, Charstring v,Charstring t 
where schema(s,p,v,t)=true
and s=colURI and p="<http://user.it.uu.se/~udbl/sard#size>";

/************************************************************************************************************************/
			/*** RETRIEVING COLUMN DATATYPE FROM GIVEN FILE***/
/************************************************************************************************************************/


create function xsd_typeMap()-><Charstring rdbtype, Charstring xsdtype,Charstring xsdabb > as stored;

create function set_xsd_typeMap()->Boolean
as
 begin
	set xsd_typeMap()=(NIL,NIL,NIL);
	add xsd_typeMap()=<"varchar",'http://www.w3.org/2001/XMLSchema#string', 'xsd:string'>;
	/*add xsd_typeMap()=<"char",'http://www.w3.org/2001/XMLSchema#string','xsd:string'>;*/
        add xsd_typeMap()=<"float", 'http://www.w3.org/2001/XMLSchema#float','xsd:string'>;
	add xsd_typeMap()=<"integer", 'http://www.w3.org/2001/XMLSchema#integer', 'xsd:integer'>;
	add xsd_typeMap()=<"int", 'http://www.w3.org/2001/XMLSchema#int','xsd:int'>;
	add xsd_typeMap()=<"datetime",'http://www.w3.org/2001/XMLSchema#dateTime','xsd:dateTime'>;
	add xsd_typeMap()=<"date",'http://www.w3.org/2001/XMLSchema#date','xsd:date'>;
	add xsd_typeMap()=<"time",'http://www.w3.org/2001/XMLSchema#time','xsd:time'>;
	add xsd_typeMap()=<"decimal",'http://www.w3.org/2001/XMLSchema#decimal','xsd:decimal'>;
	add xsd_typeMap()=<"numeric",'http://www.w3.org/2001/XMLSchema#double','xsd:double'>;
 end;

set_xsd_typeMap();

create function ret_mappeddatatype(Charstring x)->Charstring 
/*Retrieves only datatype from URI of datatype*/
as 
	select reltype from Charstring relType,Charstring xsd,Charstring short where
        xsd_typeMap()=(reltype,xsd,short) and xsd=x;

create function ret_ColDataType(Charstring colURI)->Charstring
/*Retrieve the URI of datatype of column or attribute*/
as select ret_mappeddatatype(substring(v,1,char_length(v)-2)) from Charstring s, Charstring p, Charstring v,Charstring t
where schema(s,p,v,t) and s=colURI and p ="<http://www.w3.org/2000/01/rdf-schema#range>";

/************************************************************************************************************************/
	/*Retrieving column informations taking consideration of foreign key*/
/************************************************************************************************************************/
create function colInfo_mod(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring,Charstring,Charstring,Charstring)
as
begin
 for each Charstring ch1,Charstring ch2 where ret_columnURIs(tableURI,baseURI)=(ch1,ch2)
	if(ret_ColSize(ch1)!="") then
  	  result (clearURI(tableURI,baseURI),ch1,str_exp(ch2,"/"),ret_ColdataType(ch1),ret_ColSize(ch1))
	else
	  result (clearURI(tableURI,baseURI),ch1,str_exp(ch2,"/"),ret_ColdataType(ch1),"")

end;
/************************************************************************************************************************/
	/*Retrieving the information of the column taking account of primary key and mapping datatype for foreign key.*/
/************************************************************************************************************************/
create function get_info(Charstring tableURI,Charstring baseURI)
->Charstring
as 
begin 
	declare charstring temp;
	set temp="";
	for each Charstring tname,Charstring dsize,Charstring colURI, Charstring colname, Charstring dtype 
	 where <tname,colURI,colname,dtype,dsize> = colInfo_mod(tableURI,baseURI)
		if dsize=""then
			set temp = temp + colname + " " + dtype +","
		else 
			set temp = temp + colname + " " + dtype +"("+ dsize+")"+",";	 
	result substring(temp,0,char_length(temp)-2);
end;
/************************************************************************************************************************/
	/*Retrieving CREATE TABLE script for the given file*/
/************************************************************************************************************************/
create function makeTable(Charstring tableURI,Charstring baseURI)
->Charstring
as
begin
	declare charstring t1;
	set t1="";
	for each Charstring ch where ret_pk(tableURI, baseURI)=ch
	begin 
		set t1=t1+","+ch;
	end;
	 result "CREATE TABLE " + clearURI(tableURI,baseURI) + "(" + get_info(tableURI,baseURI) +",PRIMARY KEY(" +substring(t1,1,char_length(t1))+"));"
end;
create function colInfo_mod(Charstring tableURI,Charstring baseURI)
->(Charstring,Charstring,Charstring,Charstring,Charstring)
as
begin
 for each Charstring ch1,Charstring ch2 where ret_columnURIs(tableURI,baseURI)=(ch1,ch2)
	if(ret_ColSize(ch1)!="") then
  	  result (clearURI(tableURI,baseURI),ch1,str_exp(ch2,"/"),ret_ColdataType(ch1),ret_ColSize(ch1))
	else
	  result (clearURI(tableURI,baseURI),ch1,str_exp(ch2,"/"),ret_ColdataType(ch1),"")

end;
/************************************************************************************************************************/
	/*Retrieving the information of the column taking account of primary key and mapping datatype for foreign key.*/
/************************************************************************************************************************/
create function get_info(Charstring tableURI,Charstring baseURI)
->Charstring
as 
begin 
	declare charstring temp;
	set temp="";
	for each Charstring tname,Charstring dsize,Charstring colURI, Charstring colname, Charstring dtype 
	 where <tname,colURI,colname,dtype,dsize> = colInfo_mod(tableURI,baseURI)
		if dsize=""then
			set temp = temp + colname + " " + dtype +","
		else 
			set temp = temp + colname + " " + dtype +"("+ dsize+")"+",";	 
	result substring(temp,0,char_length(temp)-2);
end;

/************************************************************************************************************************/
	/*Retrieving CREATE TABLE script for the given file*/
/************************************************************************************************************************/
create function makeTable(Charstring tableURI,Charstring baseURI)
->Charstring
as
begin
	declare charstring t1;
	set t1="";
	for each Charstring ch where ret_pk(tableURI, baseURI)=ch
	begin 
		set t1=t1+","+ch;
	end;
	 result "CREATE TABLE " + clearURI(tableURI,baseURI) + "(" + get_info(tableURI,baseURI) +",PRIMARY KEY(" +substring(t1,1,char_length(t1))+"));"
end;

create function makeAllTable(JDBC jd,Charstring baseURI)
->Boolean 
as 	
	for each Charstring ch where ret_tableURIs()=ch
		sql(jd,makeTable(ch,baseURI));

create function generateSQLTable(jdbc j,Charstring baseURI)->Boolean
as
/*Creates all tables with sql*/
	for each Charstring ch where ret_tableURIs()=ch
		sql(j, makeTable(ch,baseURI));
			                 
/************************************************************************************************************************/
	/*Retrieving Constraints info to produce ALTER TABLE script*/
/************************************************************************************************************************/
create function makeConstraint(Charstring tableURI,Charstring baseURI)
->Charstring
as 
for each Charstring ch1,Charstring ch2,Charstring ch3,Charstring ch4,Charstring ch5 where ret_fkRef1(tableURI,baseURI)=<ch1,ch2,ch3,ch4,ch5>
              if(ch1!="") then
              result "ALTER TABLE " + ch2+ " ADD CONSTRAINT FK_"+ch2+"_"+ch3+" FOREIGN KEY("+ch1+") REFERENCES "+ch5+"("+ch4+");";

create function makeAllConstraint(JDBC jd,Charstring baseURI)
->Boolean 
as 
	for each Charstring ch where ret_tableURIs()=ch 
		sql(jd, makeConstraint(ch,baseURI));
	
create function generateSQLConstraint(jdbc j,Charstring baseURI)->Boolean
as
/*Creates all tables with sql*/
	for each Charstring ch where ret_tableURIs()=ch
		sql(j, makeConstraint(ch,baseURI));
			                 
/************************************************************************************************************************/
	/*DROP TABLE script*/
/************************************************************************************************************************/
create function dropTable(Charstring tableURI,Charstring baseURI)
->Charstring
as
	result "DROP TABLE if exists "+ clearURI(tableURI,baseURI)+ ";"; 

create function dropAllTable(JDBC jd,Charstring baseURI)
-> Boolean
as
begin
	sql(jd,"SET foreign_key_checks = 0;");
	for each Charstring ch where ret_tableURIs()=ch
		sql(jd,dropTable(ch,baseURI));
end;

create function generateSQLDrop(jdbc j,Charstring baseURI)->Boolean
as
/*Creates all tables with sql*/
	for each Charstring ch where ret_tableURIs()=ch
		sql(j,dropTable(ch,baseURI));
	
create function dropTables_mod(jdbc j)-> Charstring as 
/*Retrieves all table created on mysql*/
	for each Charstring ch1,Charstring ch2, Charstring ch3, Charstring ch4 where tables(j)=(ch1, ch2, ch3 , ch4)
		result "DROP TABLE if exists "+ ch1+ ";"; 
 	