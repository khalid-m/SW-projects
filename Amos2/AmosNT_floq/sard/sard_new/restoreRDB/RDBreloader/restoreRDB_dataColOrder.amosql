
create function dropProcedures_ColOrder1(Charstring tname, Vector colname)
->Charstring
/*Generates DROP PROCEDURE statements to drop the table procedures existing in the database.*/

as
begin
	declare Charstring proc_name,Charstring t;
	set t="";
	for each integer i where i in iota(1,dim(colname))
	begin
		set t=t+colname[i-1];
	end;
	set proc_name="SP_"+tname+"_"+t;
	result "DROP PROCEDURE IF EXISTS "+ proc_name+";";
end;

create function dropProcedureColOrder(JDBC jd,Charstring baseURI)
->Boolean

/*Function call to getnerate the DROP PROCEDURE statement with required parameters.*/
as
begin
	declare Charstring dtype,Charstring dsize,Charstring fkm,Charstring x1,Vector fkmap,Vector pkname,Vector colname,Vector coltype,Vector pktype,Integer i,Integer n,Integer n1,Integer z;
	set i=1;
	set z=0;
	set n1=0;
	set n=0;
	for each Charstring tableURI where ret_tableURIs()=tableURI
	begin
				
		for each Charstring ch where ret_colfk_data(tableURI,baseURI)=ch
		begin
			for each Charstring ch1 where ret_fkInNT(tableURI)=ch1
			begin
				if(ch=ch1) then 
					set z=1;
			end;
			if(z=0) then
			begin 
				set colname=concat(colname,{str_exp(clearURI(ch,baseURI),'/')});
			end
			else
			begin
				for each Charstring ch2 where ret_fkMap(ch)=ch2
				begin 	
					set fkMap=concat(fkmap,{ch2});
				end;
				for each Integer i where i in iota(1,dim(fkmap))
				begin
					set n1=n1+1;
					set fkM=fkmap[dim(fkmap)-i];
					set colname=concat(colname,{str_exp(clearURI(fkm,baseURI),'/')});
				end;
			end;
			sql(jd,dropProcedures_ColOrder1(clearURI(tableURI,baseURI),colname));
			set colname={};
			set fkMap={};
			set z=0;
		end;
	end;
end;

create function ProcColOrder(Charstring tname,Vector pkname,Vector pksize,Vector colname,Vector pktype,Vector coltype,Integer n,Integer n1)
->Charstring

/*Generates CREATE PROCEDURE statements to insert the data in database. These stored procedures are stored in the database nad called later during insertion.*/

as
begin
	declare Integer z,Charstring t5,Charstring t1,Charstring t2,Charstring tm,Charstring tn,Charstring k1,Charstring k2,Charstring k3,Charstring k4,Charstring k5;
	set k1="";
	set k2="";
	set k3="";
	set k4="";
	set k5="";
	set t1="";
	set t2="";
	set tm="";
	set tn="";
	set t5="";
	set z=1;
	for each integer j where j in iota(1,dim(pkname))
	begin
		for each integer k where k in iota(1,dim(colname))
		begin
			if(pkname[j-1]=colname[k-1]) then
				set z=z+1;
		end;
	end;
	for each integer i where i in iota(1,dim(pkname))
	begin
		if (pksize[i-1]!="") then
			set t1=t1+",IN PK_"+pkname[i-1]+" "+pktype[i-1]+"("+pksize[i-1]+")"
		else
			set t1=t1+",IN PK_"+pkname[i-1]+" "+pktype[i-1];
		set t2=t2+","+pkname[i-1];
		set tm=tm+",PK_"+pkname[i-1];
		set tn=tn+" and "+ pkname[i-1]+"=PK_"+ pkname[i-1];
		set t5=t5+pkname[i-1];
	end;
	set t1=substring(t1,1,char_length(t1));
	set t2=substring(t2,1,char_length(t2));
	set tm=substring(tm,1,char_length(tm));
	set tn=substring(tn,4,char_length(tn));		
	for each integer i where i in iota(1,dim(colname))
	begin
		set k1=k1+",IN P_"+colname[i-1]+" "+coltype[i-1]; 
		set k2=k2+","+colname[i-1];
		set k3=k3+",P_"+colname[i-1];
		set k4="UPDATE "+tname+" SET "+colname[i-1]+"=P_"+colname[i-1]+ " WHERE "+tn+"; "+k4;
		set k5=k5+colname[i-1];
	end;
	set k1=substring(k1,1,char_length(k1));
	set k2=substring(k2,1,char_length(k2));
	set k3=substring(k3,1,char_length(k3));
	set k4=substring(k4,0,char_length(k4));	

	if(z=1) then
	begin	
		result "CREATE PROCEDURE SP_"+tname+"_"+k5+"("+t1+","+k1+")
	
		IF EXISTS (SELECT * FROM "+tname+" WHERE "+tn+") THEN
			"+k4+"
		ELSE 
			INSERT INTO "+tname+ "("+t2+","+k2+") VALUES ("+tm+","+k3+");


		     END IF;" 	
	end
	
	else  
	begin
		result "CREATE PROCEDURE SP_"+tname+"_"+k5+"("+t1+")
	
		IF NOT EXISTS (SELECT * FROM "+tname+" WHERE "+tn+") THEN
			INSERT INTO "+tname+ "("+t2+") VALUES ("+tm+");
			
		     END IF;" 	
	end;
end;

create function ProcedureColOrder(JDBC jd,Charstring baseURI)
->Boolean
/*Call to the function generating CREATE PROCEDURE staments with required parameters..*/

as
begin
	declare Charstring dtype,Charstring dsize,Charstring fkM,Charstring x1,Vector cnt,Vector fkMap,Vector pkname,Vector pksize,Vector colname,Vector coltype,Vector pktype,Integer i,Integer n,Integer n1,Integer z;
	set i=1;
	set z=0;
	set n1=0;
	set n=0;
	set cnt={};
	for each charstring ch where ret_tableURIs_CT()=ch
	/*Retrieves all connecting tables from the NT file and stores in a vector.*/
	begin
		set cnt=concat(cnt,{ch});
	end;

	for each Charstring tableURI where ret_tableURIs()=tableURI
	begin
		for each Charstring ch where ret_pkURIs(tableURI)=ch
		begin	
		/*Setting the respective primary keys and its info of the corresponding table into a vector.*/	
			set n=n+1;
			set pkname=concat(pkname,{str_exp(clearURI(ch,baseURI),"/")});
			set pktype=concat(pktype,{ret_colDatatype(ch)});
			if (ret_colSize(ch)!="") then 
				set pksize=concat(pksize,{ret_colSize(ch)})
			else
				set pksize=concat(pksize,{""});
		end;
		

		if tableURI in cnt then
		begin
			for each Charstring colURI, Charstring col where ret_columnURIs(tableURI,baseURI)=<colURI,col>
			begin
				set n1=n1+1;
				set colname=concat(colname,{str_exp(col,'/')});
				set dtype=ret_ColDatatype(colURI);
				if (ret_colSize(colURI)!="") then 
					set x1=dtype+"("+ret_colSize(colURI)+")"
				else
					set x1=dtype;
				set coltype=concat(coltype,{x1}); 
			end;
			sql(jd,ProcColOrder(clearURI(tableURI,baseURI),pkname,pksize,colname,pktype,coltype,n,n1));
			set colname={};
			set coltype={};
			set n1=0;
		end
		else
		begin			
			for each Charstring ch where ret_colfk_data(tableURI,baseURI)=ch
			begin
				for each Charstring ch1 where ret_fkInNT(tableURI)=ch1
				begin
					if(ch=ch1) then 
						set z=1;
				end;
				for each Charstring ch1 where ret_tableURIs()=ch1
				begin
					if(ch=ch1) then 
						set z=2;
				end;
				if(z=0) then
				begin 
					set n1=n1+1;
					set colname=concat(colname,{str_exp(clearURI(ch,baseURI),'/')});
					set dtype=ret_ColDatatype(ch);
					if (ret_colSize(ch)!="") then 
						set x1=dtype+"("+ret_colSize(ch)+")"
					else
						set x1=dtype;
						set coltype=concat(coltype,{x1}); 
				end
				else if z=1 then
				begin
					for each Charstring ch2 where ret_fkMap(ch)=ch2
					begin 	
						set fkMap=concat(fkmap,{ch2});
					end;
					for each Integer i where i in iota(1,dim(fkmap))
					begin
						set n1=n1+1;
						set fkM=fkmap[dim(fkmap)-i];
						set colname=concat(colname,{str_exp(clearURI(fkm,baseURI),'/')});
						set dtype=ret_ColDatatype(fkm);
						if (ret_colSize(fkm)!="") then 
							set x1=dtype+"("+ret_colSize(fkm)+")"
						else
							set x1=dtype;
						set coltype=concat(coltype,{x1}); 
					end;
				end;
				if z!=2 then
					sql(jd,ProcColOrder(clearURI(tableURI,baseURI),pkname,pksize,colname,pktype,coltype,n,n1));
				set colname={};
				set fkMap={};
				set coltype={};
				set z=0;
				set n1=0;
			end;
		end;
		set pkname={};
		set pktype={};
		set pksize={};
		set n=0;
	end;
end;

create function get_pkVal_Col(Charstring baseURI,Vector v1,Vector v2,Charstring rowID,Charstring tname)
->Charstring
/* Returns the information about primary Value. The primary keys can be single or composite attribute/s.*/

as
begin
	declare Vector pkname,Vector pktype,Vector pkVal,
		Charstring a,Charstring b,Charstring pk,Charstring pkN,Charstring pkV;
	set pkN="";
	set pkV="";
	set pkName={};
	set pkVal={};
	set pktype={};

	for each Charstring ch where ret_pkNamefromRowID1(baseURI,rowID)=ch 
	begin 
		for each Integer j where j in iota(1,dim(v1)) 
   	  	begin   
			if(ch=v1[j-1]) then
			begin	
		     		set pkname=concat(pkname,{ch});
		     		set pktype=concat(pktype,{v2[j-1]});
			end; 
		end;	
	end;
	set pk=substring(str_exp(clearURI(rowID,baseURI),"/"),1,char_length(str_exp(clearURI(rowID,baseURI),"/")));
	set pkVal=str_exp3(pk,"_");
	for each integer i where i in iota(1,dim(pkname))
	begin
		set a=pkname[i-1];
		set pkn=pkn+","+str_exp(a,"/");
		set b=pkVal[i-1];
		if(pktype[i-1]='int') then
			set pkV=pkV+","+b
		else if(pktype[i-1]='float') then
			set pkV=pkV+","+b
		else 
			set pkV=pkV+","+"'"+b+"'";
	end;	
	set pkN=substring(pkN,1,char_length(pkN));
	set pkV=substring(pkV,1,char_length(pkV));
	result pkV;
end;


create function get_fkVal_NameCol(Charstring baseURI,Vector v2,Vector v4,Charstring p,Charstring RefID)
->(Charstring,Charstring)
/* Returns the information about foreign key name and Value. The foreign keys can be single or composite attribute/s.*/
as
begin 
     	declare Vector fkname,Vector fktype,Vector fkVal,
		Charstring a,Charstring b,Charstring c,Charstring fk,Charstring fkV,Charstring fkN;
	set fkN="";
	set fkV="";
	set fkName={};
	set fkType={};
	set fkVal={};
	set fk=substring(str_exp(clearURI(refID,baseURI),"/"),1,char_length(str_exp(clearURI(refID,baseURI),"/")));
	set fkVal=str_exp3(fk,"_");
	for each Charstring ch where ret_fkMap(p)=ch
	begin
		set fkname=concat(fkname,{str_exp(clearURI(ch,baseURI),'/')});
		for each Integer i where i in iota(1,dim(v4))
		begin
			if(ch=v4[i-1]) then
				set c=v2[i-1];
		end;
		set fktype=concat(fktype,{c});

	end;
	for each integer i where i in iota(1,dim(fkname))
	begin 
		set a=fkname[i-1];
		set fkN=a+fkN;
		set b=fkVal[dim(fkname)-i];
		if(fktype[i-1]='varchar') then
			set fkV="'"+b+"'"+","+fkV
		else if(fktype[i-1]='datetime') then
			set fkV="'"+b+"'"+","+fkV
		else
			set fkV=b+","+fkV;
	end;
	set fkN=substring(fkN,0,char_length(fkN));
	set fkV=substring(fkV,0,char_length(fkV)-2);
	result (fkN,fkV);
end;


create function CallProc_ColOrder(JDBC jd,Charstring filename2, charstring baseURI)
->Boolean
/*Generates CALL PROCEDURE_NAME  statements to insert data into the database. These CAll Procedure_name statements calls the stored procedures in the database for the data insertion.*/

as
begin
        declare Vector v1, Vector v2a,Vector v3,Vector v4,Vector cnt,Vector cnt1,Vector cnt2,
		Integer n,Integer n1,Integer n2,
		Charstring z,Charstring tname,Charstring t,
		Charstring t1,Charstring t2,Charstring t3,Charstring t4,Charstring t5,Charstring pkV,Charstring c1,Charstring c2,Charstring cont3,Charstring cont1,Charstring cont2;
	
	set v1={};
	set v2a={};
	set v3={};
	set v4={};
	set t="";
	set c1="";
	set c2="";
	set cnt={};
	set cnt1={};
	set cnt2={};
	set cont3="";	
	
	for each Charstring tableURI where ret_tableURIs1()=tableURI
	begin
		for each charstring col, charstring colURI where ret_columnURIs_woct(tableURI,baseURI)=<colURI,col> 
		begin  
		/*Stores the columns of all the tables in the NT file*/
			set v1=concat(v1,{col});
			set v2a=concat(v2a,{ret_colDatatype(colURI)}); 
			if (ret_colSize(colURI)!="") then
				set v3=concat(v3,{ret_colSize(colURI)})
			else
				set v3=concat(v3,{""});
			set v4=concat(v4,{colURI}); 
		end; 
	end;
	for each charstring ch where ret_tableURIs_CT()=ch
	/*Retrieves all connecting tables from the NT file and stores in a vector.*/
	begin
		set cnt=concat(cnt,{ch});
	end;
	
	for each charstring s, charstring p,charstring v, Charstring i where readtuples1(filename2)=<s,p,v,i>
	begin
		if (p in cnt) then
		/* Generatig CALL Procedure statements for connecting tables.*/
		begin
			if (p!=t) then 
			begin 
				set cont1=ret_pknamefromRowId(baseURI,v);
				set cont2=ret_pknamefromRowId(baseURI,s);
				set cont3="";
				for each charstring pk where ret_pkname(p,baseURI)=pk
				begin	set cont3=cont3+pk; end;
				
				set t=p;
			end;

			set cnt1=str_exp3(str_exp(clearURI(v,baseURI),'/'),'_');
			set cnt2=str_exp3(str_exp(clearURI(s,baseURI),'/'),'_');
			for each integer i where i in iota(1,dim(cnt1))
			begin
				if (cnt1[i-1]!="") then
					set c1=c1+","+cnt1[i-1];
			end;
			for each integer i where i in iota(1,dim(cnt2))
			begin
				if (cnt2[i-1]!="") then
					set c2=c2+","+cnt2[i-1];
			end;
	
			sql(jd,"CALL SP_"+clearURI(p,baseURI)+"_"+cont3+"("+substring(c1,1,char_length(c1))+","+substring(c2,1,char_length(c2))+");");	
			set cnt1={};
			set cnt2={};
			set c1="";
			set c2="";
		end
		else
		begin
			if (s!=t) then 
			begin 
				set pkV=get_pkVal_Col(baseURI,v1,v2a,s,tname);
				set tname=ret_tableNamefromRowID(baseURI,s);
				set t=s;
			end;
			if(v!="" and p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>") then
			begin
				set z=clearURI(p,baseURI);
				if(like(z,"*/*")) then 
				begin 
					for each integer i where i in iota(1,dim(v1))
					begin
						if (p=v4[i-1]) then
						begin
							set t3=str_exp(clearURI(p,baseURI),'/');
							set t5=v2a[i-1];
						end;
					end;
					if(t5='int')then 
						set t4=v
					else if(t5='float')then 
						set t4=v
					else
						set t4="'"+v+"'";
					sql(jd,"CALL SP_"+tname+"_"+t3+"("+pkV+","+t4+");");	
				end
				else
				begin
					set t1=str_exp1(clearURI(v,baseURI),"/"); 
					set t2=ret_pknamefromRowId(baseURI,v);
					for each Charstring ch1,Charstring ch2 where get_fkVal_NameCol(baseURI,v2a,v4,p,v)=<ch1,ch2>
					begin
						set t3=ch1;
						set t4=ch2;
					end;
					/*sql(jd,"CALL SP_"+t1+"_"+t2+"("+t4+");");*/
					sql(jd,"CALL SP_"+tname+"_"+t3+"("+pkV+","+t4+");");	
				end;
			end;
		end;
	end;
end;

