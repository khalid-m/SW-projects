create function loadSQLNoCheckColOrderInsert(JDBC a,Charstring filename,Charstring baseURI)->Boolean
as begin
	declare Number t;
/*Drops the table and procedures if already exists in the database.*/
	CleanDatabase(a,baseURI);

/*Create all the Procedures.*/
	ProcedureColOrder(a,baseURI);

/*Create all the tables.*/
	set t=real(now());
	makeAllTable(a,baseURI);
	set t=real(now())-t;
	print ("time to create table="+t);

/*Insert data in relational database.*/
	NoCheckColOrderInsertLoader(a,filename,baseURI);

	set t=real(now());
/*Create all the Constraints.*/
		makeAllConstraint(a,baseURI);
	set t=real(now())-t;
	print ("time for adding constraint="+t);
end;

create function loadSQLColOrderInsert(JDBC a,Charstring filename,Charstring baseURI)->Boolean
as begin
	declare Number t;
/*Drops the table and procedures if already exists in the database.*/
	CleanDatabase(a,baseURI);

/*Create all the Procedures.*/
	ProcedureColOrder(a,baseURI);

/*Create all the tables.*/
	set t=real(now());
	makeAllTable(a,baseURI);
	set t=real(now())-t;
	print ("time to create table="+t);

	set t=real(now());
/*Create all the Constraints.*/
		makeAllConstraint(a,baseURI);
	set t=real(now())-t;
	print ("time for adding constraint="+t);
/*Insert data in relational database.*/
	ColOrderInsertLoader(a,filename,baseURI);
end;

/*****************Reloading Archivals having no fixed BaseURIs***********/

create function importS2(Charstring filename)->Boolean
as begin
importS(filename);
addMapVal();
end;
/*****************RowOrder data*****************************************/

create function loadSQLRowInsertNoURI(Jdbc a,Charstring datafile)->Boolean
  as begin
	CleanDatabase(a);
	ProcedureRowOrderNoURI(a);
	makeAllTableNoURI(a);
	makeAllConstraintNoURI(a);
	FKInsertLoader(a,datafile);
end;

/*****************Column Order data*****************************************/

create function loadSQLColInsertNoURI(Jdbc a,Charstring datafile)->Boolean
  as begin
	CleanDatabase(a);
	ProcedureColOrderNoURI(a);
	makeAllTableNoURI(a);
	makeAllConstraintNoURI(a);
	ColOrderInsertLoader(a,datafile);
end;

