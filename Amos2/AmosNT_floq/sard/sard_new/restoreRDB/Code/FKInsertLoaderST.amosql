
/********************************************************************************************/
create function FKInsertLoaderST(JDBC jd,Charstring filename, Charstring baseURI)->Boolean
as
begin
	declare Number time1,Number time2, Number total,Charstring fname,Charstring t,Charstring tn,Charstring tu,Charstring tableURI,Bag of Charstring ct,Charstring c1, Charstring c2,Bag of Charstring colURIs;
	set t="";set total=0;
	set tableURI="";
	for each Charstring s, Charstring p, Charstring v,Charstring i where readTuples1(filename)=(s,p,v,i)
	begin 
		if(p in valueofCT()) then 
		begin
		/*Inserting the last record before parsing the connecting table.*/
			if (t!="") then 
			begin 	
				addValuePIL(ret_pkURIfromRowID2(tu),ret_pkVal(baseURI,t));
				set time1=real(now());
					sql(jd,"CALL SP_"+tn+"("+concatagg(inject(valueofattr1(),","))+");");	
				set time1=real(now())-time1; set total=time1+total;		
			end;
			set t="";
		/* Inserting values in connecting tables.*/
             		set c1=ret_pkVal(baseURI,s);
			set c2=ret_pkVal(baseURI,v);
			set time1=real(now());
				sql(jd,"CALL SP_FK_"+str_exp1(clearURI(v,baseURI),'/')+"("+c2+");");
				sql(jd,"CALL SP_FK_"+str_exp1(clearURI(s,baseURI),'/')+"("+c1+");");
				sql(jd,"CALL SP_"+clearURI(p,baseURI)+"("+c1+","+c2+");");	
			set time1=real(now())-time1; 
			set total=time1+total;		
  		end	
		else if(p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>") then
		/* Generating values for each column for regular tables.*/
  		begin 
			if(s!=t) then
			/*Checking whether the previous row ID(t) is same as the current ID (s)*/
	      		begin 	
			/* Producing a concatenated string with all the values of the attributes seperated by comma.*/
				if (t!="")then
				begin  
                                        addValuePIL(ret_pkURIfromRowID2(tu),ret_pkVal(baseURI,t));
					set time1=real(now());
						sql(jd,"CALL SP_"+tn+"("+concatagg(inject(valueofattr1(),","))+");");		
					set time1=real(now())-time1; 
					set total=time1+total;	
					clean_tableVal();
				end;
				set t=s;
			/*Adding columns in the Stored table*/
				set tu=ret_tableURIfromRowID1(baseURI,t);
				set tn=clearURI(tu,baseURI);
				if(tableURI!=tu) then 
				begin 
			 		remove_attr();
					addcolumn(tu);
				end; 
				set tableURI=tu;
			end;
			if(v!="") then
			begin 
				if like(clearURI(p,baseURI),"*/*")then begin 
					addValuePIL(p,v);end
				else begin set c1=ret_pkVal(baseURI,v); 
					addValuePIL(ret_fkMap(p),c1);
					set time1=real(now());
						sql(jd,"CALL SP_FK_"+str_exp1(clearURI(v,baseURI),'/')+"("+c1+");");	
					set time1=real(now())-time1; 
					set total=time1+total;	
				end;
			end;
		end;
	end;
	if notany(tableURI in valueofCT()) then begin
	addValuePIL(ret_pkURIfromRowID2(tu),ret_pkVal(baseURI,t));
	set time1=real(now());
    		sql(jd,"CALL SP_"+tn+"("+concatagg(inject(valueofattr1(),","))+");");	
	set time1=real(now())-time1; 
	set total=time1+total;	end;
	print(total);
end;



