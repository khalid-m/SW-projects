create function createCSVfile(Charstring filename2, charstring baseURI)->(Charstring,Charstring)
/*Generates CALL PROCEDURE statements to call the corresponding procedures to insert data ,given in Row order in NT, into the table.*/
as begin
	declare Charstring c,Charstring d, Charstring col1,Charstring z,Charstring tname,Charstring t,Charstring fkV,Charstring c1,Charstring c2,Charstring p1,
	Vector cn,Vector cnt,Vector t3,Vector t4;
	set t="";set col1="";set t3={};	set t4={};set cnt={};set cn={};	set tname="";
	/*Retrieves all connecting tables from the NT file and stores in a vector.*/
	for each charstring ch where ret_tableURIs_CT()=ch
			set cnt=concat(cnt,{ch});

	for each charstring s, charstring p,charstring v, Charstring i where readtuples1(filename2)=<s,p,v,i>
	begin	/* Generatig CALL Procedure statements for connecting tables.*/set p1=p;
		if (p in cnt) then
		begin	if t!="" then
			begin	for each Vector ch1, Vector ch2 where get_pkValRow(baseURI,t)=<ch1,ch2>
				begin	set t3=concat(t3,ch1);set t4=concat(t4,ch2);end;							
				set col1=sorting1(cn,t3,t4);				
				return (tname,substring(col1,1,char_length(col1)));
				set t="";
			end;
			set c1=concatagg(inject(vectorbag(ret_pkVal1(baseURI,v)),','));
			set c2=concatagg(inject(vectorbag(ret_pkVal1(baseURI,s)),','));
			return(clearURI(p,baseURI),c1+","+c2);	
		end
		else if(p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>") then
		/* Generatig CALL Procedure statements for regular tables.*/
		begin	if(s!=t) then
	    		begin 	if (t!="")then
				begin 	for each Vector ch1, Vector ch2 where get_pkValRow(baseURI,t)=<ch1,ch2>
					begin	set t3=concat(t3,ch1);	set t4=concat(t4,ch2);	end;		
					set col1=sorting1(cn,t3,t4);
					return (tname,substring(col1,1,char_length(col1)));	
				end;
				set t3={};set t4={};set t=s;
				if(tname!=ret_tableNamefromRowID1(baseURI,t)) then 
				begin 	set cn={};
					for each Charstring col,Charstring colURI where ret_columnURIs(ret_tableURIfromRowID1(baseUri,t),baseURI)=<colURI,col>
						set cn=concat(cn,{str_exp(col,'/')});
				end; 	
	 			set tname=ret_tableNamefromRowID(baseURI,t);
			end;		
			if(v!="" and p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>") then
			begin 	set z=clearURI(p,baseURI);
				if(like(z,"*/*")) then 
				begin 	set t3=concat(t3,{str_exp(clearURI(p,baseURI),'/')});	
				      	set t4=concat(t4,{v});
				end
				else
				begin	for each Vector ch1, Vector ch2,Charstring ch3 where get_fkValRow(baseURI,v,p)=<ch1,ch2,ch3>
					begin	set t3=concat(t3,ch1);set t4=concat(t4,ch2);	end;
				end;
			end;end;end;
	if notany(p1 in cnt) then begin
	for each Vector ch1, Vector ch2 where get_pkValRow(baseURI,t)=<ch1,ch2>
	begin	set t3=concat(t3,ch1);	set t4=concat(t4,ch2);end;		
	set col1=sorting1(cn,t3,t4);
	return (tname,substring(col1,1,char_length(col1)));end;
end;


create function print_to_file(Charstring x)->boolean
as begin print(x);end;

create function write_to_file(Charstring filename2, Charstring baseURI)->Boolean
as begin declare Charstring filename,Charstring tname1;
	set tname1="";
	for each Charstring ch1, Charstring ch2 where createCSVfile(filename2,baseURI)=(ch1,ch2)
	begin	if ch1!=tname1 then 
		begin	set filename=ch1+".csv";openwritefile(filename);end;			
		print_to_file(ch2);
		set tname1=ch1;
	end;
	closewritefile();
end;


create function BulkInsertLoader(JDBC jd,Charstring filename2,Charstring baseURI)
->Boolean
as begin declare Number time;
	write_to_file(filename2,baseURI);
	set time=real(now());
	bulkload_data(jd,baseURI);
	set time=real(now())-time;
	print(time);
end;