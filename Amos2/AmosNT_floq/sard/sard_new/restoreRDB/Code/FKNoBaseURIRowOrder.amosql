
/*****************************************************************************/
create function vectorBag(Vector v)->Bag of Object
 as select v[i] from Integer i;
/*****************************************************************************/

create function dropProceduresRowOrderNoURI(JDBC jd)->Charstring
/*Generates DROP PROCEDURE Statements to drop all the procedure in database*/
as begin declare Charstring proc_name1,Charstring proc_name2;
	for each Charstring ch where ret_tableName()=ch
	begin	set proc_name1="SP_"+ch;set proc_name2="SP_FK_"+ch;
		sql(jd,"DROP PROCEDURE IF EXISTS "+ proc_name1+";");
		sql(jd,"DROP PROCEDURE IF EXISTS "+ proc_name2+";");
	end;
end;
/*****************************************************************************/

create function procedureRowOrder1NoURI()->Charstring
as begin 
	declare Charstring a,Charstring b,Charstring c,Vector pkname,Charstring t1, Charstring t2,Charstring t3,Charstring t4,Charstring pk1,Integer z,Vector cn,Vector ct,Vector cs;
	set t1="";set t2="";set t3="";set t4="";set cn={};set ct={};set cs={};set pkname={};set pk1="";set z=0;
	for each Charstring tableURI,Charstring tname where ret_tableNameURIs()=<tableURI,tname>
	begin 
		for each Charstring ch1,Charstring ch2 where ret_pkNameURIs(tableURI)=<ch1,ch2> 
		begin 	
			set pkname=concat(pkname,{ch2});set pk1=pk1+" and "+ch2+"=C_"+ch2;end;
			set pk1=substring(pk1,4,char_length(pk1));
		for each Charstring col,Charstring colURI where ret_columnNameURIs(tableURI,tname)=<colURI,col>
		begin 	
			set cn=concat(cn,{col});set ct=concat(ct,{ret_Coldatatype(colURI)});
			if(ret_ColSize(colURI)!="") then set cs=concat(cs,{ret_ColSize(colURI)})
			else set cs=concat(cs,{""});
		end;		
		for each integer i where i in iota(1,dim(cn))
		begin 	set a=cn[i-1];set b=ct[i-1];set c=cs[i-1];
			if (c!="") then	set t1=t1+",IN C_"+a+" "+b+"("+c+")"
			else set t1=t1+",IN C_"+a+" "+b;
			
			set t2=t2+","+a;set t3=t3+","+"C_"+a;
			if(cn[i-1] in pkname) then set z=1
			else set t4=t4+","+a+"=C_"+a;
		end;
		set t1=substring(t1,1,char_length(t1));set t2=substring(t2,1,char_length(t2));
		set t3=substring(t3,1,char_length(t3));	set t4=substring(t4,1,char_length(t4));
	
		if(t4!="") then
			return "CREATE PROCEDURE SP_"+tname+"("+t1+")
				IF EXISTS(SELECT * FROM "+tname+" WHERE "+pk1+") THEN
			
				UPDATE "+tname+" SET "+t4+" WHERE "+pk1+";
				ELSE 
					INSERT INTO "+tname+"("+t2+") VALUES ("+t3+");
				END IF;"
		else
			return "CREATE PROCEDURE SP_"+tname+"("+t1+")
				IF NOT EXISTS(SELECT * FROM "+tname+" WHERE "+pk1+") THEN
					INSERT INTO "+tname+"("+t2+") VALUES ("+t3+");
				END IF;";
		set cn={};set cs={};set ct={};set pkname={};set t1="";set t2="";set t3="";set t4="";set pk1="";
	end;
end;
/*****************************************************************************/

create function procedureRowOrder2NoURI()->Charstring
as
/* Also Generates CREATE PROCEDURE statements for the table corresponding to the foreign key.*/
begin 	declare Charstring tname,Vector pkname,Vector pktype,Vector pksize,Charstring pk1,Charstring pk2,Charstring pk3,Charstring pk4,Charstring a,Charstring b,Charstring c;
	set pk1="";set pk2="";set pk3="";set pk4="";set pkname={};set pktype={};set pksize={};
	for each Charstring tableURI,Charstring tname where ret_tableNameURIs()=<tableURI,tname>
	begin 	for each Charstring pkURI,Charstring pk where ret_pknameURIs(tableURI)=<pkURI,pk> 
		begin 	set pkname=concat(pkname,{pk});
			set pktype=concat(pktype,{ret_Coldatatype(pkURI)});
			if(ret_ColSize(pkURI)!="") then	set pksize=concat(pksize,{ret_ColSize(pkURI)})
			else set pksize=concat(pksize,{""});
		end;
		
		for each Integer i where i in iota(1,dim(pkname))
		begin 	set a=pkname[i-1];set b=pktype[i-1];set c=pksize[i-1];
			set pk1=pk1+" and "+a+"=C_"+a;
			if c!="" then set pk2=pk2+","+"IN C_"+a+" "+b+"("+c+")"
			else set pk2=pk2+","+"IN C_"+a+" "+b;
			set pk3=pk3+","+a;set pk4=pk4+",C_"+a;
		end;
		set pk1=substring(pk1,4,char_length(pk1));set pk2=substring(pk2,1,char_length(pk2));
		set pk3=substring(pk3,1,char_length(pk3));set pk4=substring(pk4,1,char_length(pk4));
		return "CREATE PROCEDURE SP_FK_"+tname+"("+pk2+")
			IF NOT EXISTS(SELECT * FROM "+tname+" WHERE "+pk1+") THEN
				INSERT INTO "+tname+"("+pk3+") VALUES ("+pk4+");
			END IF;";
		set pkname={};set pktype={};set pksize={};set pk1="";set pk2="";set pk3="";set pk4="";
	end;
end;
/*****************************************************************************/

create function procedureRowOrderNoURI(JDBC jd)->Boolean
as begin
	sql(jd,procedureRowOrder1NoURI());
	sql(jd,procedureRowOrder2NoURI());
end;
/*****************************************************************/

create function get_pkValRowNoURI(Charstring t)->(Vector,Vector)
as begin	
/*Retreives respective vector of primary key name and its corresponding values.*/
	declare Vector pkname,Vector pkVal,Charstring a,Charstring b;
	set pkname={};set pkVal={};
	for each Charstring ch where ret_pkNamefromRowIDNoURI(t)=ch 
		 set pkname=concat(pkname,{ch});
   	set pkVal=row_ident(t,ret_tableURIfromRowIdNoURI(t));
	return (pkname,pkVal);
end;

create function get_fkValRowNoURI(Charstring v,Charstring p,Vector v1,Vector v4)->(Vector,Vector,Charstring)
as begin
/*Retrieves respective vector of foreign key name and its corresponding values.*/
	declare Vector fkname,Vector fkVal,Charstring c1,Charstring fkV,Vector fkVal1;
	set fkName={};
	set fkVal=row_ident(v,ret_tableURIFromRowIdNoURI(v));
	for each Charstring ch where ret_fkMap(p)=ch
	begin for each Integer i where i in iota(1,dim(v4))
			if(ch=v4[i-1]) then set c1=v1[i-1];		
		set fkname=concat(fkname,{c1});
	end;
	for each integer i where i in iota(1,dim(fkVal)) 
		set fkVal1=concat(fkVal1,{fkVal[dim(fkVal)-i]});
	set fkV=concatagg(inject(vectorBag(fkVal1),','));
	return (fkName,fKVal,fkV);
end;

create function FKInsertLoader(JDBC jd,charstring filename2)->Boolean
/*Generates CALL PROCEDURE statements to call the corresponding procedures to insert data ,given in Row order in NT, into the table.*/
as begin
	declare  Number time,Number total,Charstring col1,Vector fk,Vector cn,Vector v1,Vector v4,Vector cnt,Vector t3,Vector tab1,Vector tab2,Vector t4,Charstring p1,
		Charstring z,Charstring tname,Charstring t,Charstring fkV,Charstring c1,Charstring c2;
	set t="";set col1="";set t3={};set t4={};set cnt={};set cn={};set tname="";set total=0;
	
	for each Charstring ch1,Charstring ch2 where ret_tableNameURIs()=<ch1,ch2>
	begin 	
		set tab1=concat(tab1,{ch1});set tab2=concat(tab2,{ch2});
		for each Charstring ch where ret_fkInNt(ch1)=ch
			set fk=concat(fk,{ch});
		for each Charstring colURI,Charstring col where ret_columnNameURIs(ch1,ch2)=<colURI,col>
		begin 	set v1=concat(v1,{col});set v4=concat(v4,{colURI}); end;
	end;
	/*Retrieves all connecting tables from the NT file and stores in a vector.*/
	for each charstring ch where ret_tableURIs_CT()=ch
		set cnt=concat(cnt,{ch});

	for each charstring s, charstring p,charstring v, Charstring i where readtuples1(filename2)=<s,p,v,i>
	begin	set p1=p;
		if (p in cnt) then
		/* Generatig CALL Procedure statements for connecting tables.*/
		begin	
			if (t!="")then
			begin 	
				for each Vector ch1, Vector ch2 where get_pkValRowNoURI(t)=<ch1,ch2>
				begin	set t3=concat(t3,ch1);set t4=concat(t4,ch2);end;
					set col1=sorting(cn,t3,t4);
					set time=real(now());
					sql(jd,"CALL SP_"+tname+"("+substring(col1,1,char_length(col1))+");");
					set time=real(now())-time;set total=total+time;
					set t="";
			end;
			set c1=concatagg(inject(vectorbag(row_ident(s,ret_tableURIfromRowIDNoURI(s))),','));
			set c2=concatagg(inject(vectorbag(row_ident(v,ret_tableURIfromRowIDNoURI(v))),','));
			set time=real(now());
			sql(jd,"CALL SP_FK_"+ret_tableNameFromRowIdNoURI(s)+"("+c1+");");
			sql(jd,"CALL SP_FK_"+ret_tableNameFromRowIdNoURI(v)+"("+c2+");");
			sql(jd,"CALL SP_"+ ret_tabNameNoURI(p)+"("+c1+","+c2+");");	
			set time=real(now())-time;set total=total+time;
		end
		else if(p!="<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>") then
		/* Generatig CALL Procedure statements for regular tables.*/
		begin	if(s!=t) then
	    		begin 	if (t!="")then
				begin 	for each Vector ch1, Vector ch2 where get_pkValRowNoURI(t)=<ch1,ch2>
					begin	set t3=concat(t3,ch1);set t4=concat(t4,ch2);end;
					set col1=sorting(cn,t3,t4);
					set time=real(now());
					sql(jd,"CALL SP_"+tname+"("+substring(col1,1,char_length(col1))+");");
					set time=real(now())-time;set total=total+time;
				end;
				set t3={};set t4={};set t=s;
				if(tname!=ret_tableNamefromRowIDNoURI(t)) then 
				begin 	set cn={};
					for each Charstring col,Charstring colURI where ret_columnNameURIs(ret_tableURIfromRowIDNoURI(t),ret_tableNamefromRowIDNoURI(t))=<colURI,col>
						set cn=concat(cn,{col});
				end; 	
	 			set tname=ret_tableNamefromRowIDNoURI(t);
			end;		
			if(v!="") then
			begin 	
				if(p in fk) then 
				begin 	for each Vector ch1, Vector ch2,Charstring ch3 where get_fkValRowNoURI(v,p,v1,v4)=<ch1,ch2,ch3>
					begin	set fkV=ch3;set t3=concat(t3,ch1);set t4=concat(t4,ch2); end;
					set time=real(now());
					sql(jd,"CALL SP_FK_"+ret_tableNamefromRowIdNoURI(v)+"("+fkV+");");
					set time=real(now())-time;set total=total+time;
				end	
				else
				begin	
					set t3=concat(t3,{mapColumnName(ret_tableURIfromRowIdNoURI(t),p)});	
					set v="'"+v+"'";set t4=concat(t4,{v});
				end;
			end;end;end;
	if notany(p1 in cnt) then begin
	for each Vector ch1, Vector ch2 where get_pkValRowNoURI(t)=<ch1,ch2>
	begin	set t3=concat(t3,ch1);set t4=concat(t4,ch2);end;
	set col1=sorting(cn,t3,t4);
	set time=real(now());
	sql(jd,"CALL SP_"+tname+"("+substring(col1,1,char_length(col1))+");");	
	set time=real(now())-time;set total=total+time; end;print(total);
end;