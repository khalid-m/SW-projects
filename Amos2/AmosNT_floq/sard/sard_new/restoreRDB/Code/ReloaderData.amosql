/****************************************************************************/
		/*** RETRIEVING Value of RowID FROM GIVEN FILE***/
/****************************************************************************/

/*Retrieve PK value with of the table for the given RowID*/
create function ret_pkVal(Charstring baseURI,Charstring rowID)->Charstring 
as select ch from Charstring ch,charstring t1 where ch=str_exp1(t1,"_")
and t1=substring(str_exp(clearURI(rowID,baseURI),'/'),1,char_length(str_exp(clearURI(rowID,baseURI),'/')));

/*Retrieve PK value(composite) with of the table for the given RowID*/
create function ret_pkVal1(Charstring baseURI,Charstring rowID)->Vector 
as select str_exp3(substring(str_exp(t,'/'),1,char_length(str_exp(t,'/'))),'_')
from Charstring t where t=clearURI(rowID,baseURI);
/***************************************************************************/
create function bulkload_data(JDBC jd,Charstring baseURI)->Boolean
as begin
	declare Charstring tname;
	for each Charstring tableURI where ret_tableURIs()=tableURI
	begin
		set tname=clearURI(tableURI,baseURI);
		sql(jd, "LOAD DATA LOCAL INFILE "+"'"+ tname+".csv'"+" INTO TABLE  "+ tname+" FIELDS TERMINATED BY  ',' LINES TERMINATED BY  '\\r\\n';");
	end;	
end;


/****************************************************************************/
create function vectorBag(Vector v) -> Bag of Object  as select v[i] from Integer i;