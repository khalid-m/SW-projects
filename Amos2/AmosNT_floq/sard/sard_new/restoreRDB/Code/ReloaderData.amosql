/*****************************************************************************/
		/***RETRIEVING TABLES FROM GIVEN FILES ***/
/*****************************************************************************/

create function ret_tableName(Charstring tableURI,Charstring baseURI)->Charstring
as select t from Charstring t where t=clearURI(tableURI,baseURI);

/*Retrieves table name from the given rowID which is retrieved from the given file.*/
create function ret_tableNamefromrowID(Charstring baseURI,Charstring rowID)->Charstring 
as select t from charstring t where t=str_exp1(clearURI(rowID,baseURI),'/');

/*Retrieves table URI from the given rowID which is retrieved from the given file.*/
create function ret_tableURIfromrowID(Charstring baseURI,Charstring rowID)->Charstring 
as return "<"+baseURI+'#'+ret_tableNamefromrowID(baseURI,rowID)+">";

/*****************************************************************************/
		/***RETRIEVING primary key FROM GIVEN FILES ***/
/****************************************************************************/

/*Retrieve name of PK of the table for the given RowID*/
create function ret_pkURIfromRowID(Charstring baseURI,Charstring rowID)->Charstring
as select ch from Charstring ch,Charstring t where ch=ret_pkURIs(t) and  ret_tableURIfromRowID(baseURI,rowID)=t;

/*Retrieve the name of the PK of the table represented by tableURI*/
create function ret_pkNamefromRowID(Charstring baseURI,Charstring rowID) ->Charstring 
as begin 
	declare vector pk,Charstring a;
	for each charstring ch where ch=ret_pkURIfromRowID(baseURI,rowID) 
		set pk=concat(pk,{str_exp(clearURI(ch,baseURI),'/')});
	for each Integer i where i in iota(1,dim(pk)) 
		begin set a=pk[dim(pk)-i];return a;end;
end;

