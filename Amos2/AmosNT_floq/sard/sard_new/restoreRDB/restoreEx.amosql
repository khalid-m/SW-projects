connect(:ra, :url_a, :usern_a, :passw_a);

sql(:ra,"drop table MyTriple");

sql(:ra, "CREATE TABLE archive.MyTriple(
	[s] [varchar](200) NOT NULL,
	[p] [varchar](200) NOT NULL,
	[o] [varchar](2200) NOT NULL) ");

