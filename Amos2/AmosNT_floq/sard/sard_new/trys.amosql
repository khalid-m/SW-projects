set :sparql22 = 
"CONSTRUCT { ?s  <http://user.it.uu.se/~udbl/sard/person#person/name> ?name .

	?tel <http://user.it.uu.se/~udbl/sard/person#tel_of_person> ?s } 
 FROM <http://user.it.uu.se/~udbl/sard/person>
 WHERE {?s  <http://user.it.uu.se/~udbl/sard/person#person/name> ?name .

