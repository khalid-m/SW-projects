	as " + parse_sparql(:sparql3));

create function orrr()-> <Charstring, Charstring> as
select s, val
from Charstring s, Charstring val
where per()=<s, 'http://user.it.uu.se/~udbl/sard/person#person/name', val>
and like(val,'*van*') or 
(per()=<s, 'http://user.it.uu.se/~udbl/sard/person#person/age', val>);

