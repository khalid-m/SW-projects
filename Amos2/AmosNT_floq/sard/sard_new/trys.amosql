	as " + parse_sparql(:sparql222));

create function amos_exec1222()-><Charstring, Charstring>
as select s,p
from Charstring s,Charstring p
where (per('30')=<s,p> and "http://user.it.uu.se/~udbl/sard/person#person/age") or
      (per('30')=<s,p> and p="http://user.it.uu.se/~udbl/sard/person#person/sn") or
        (per('30')=<s,p> and p="http://user.it.uu.se/~udbl/sard/person#tel/telsn");

