/*Schema queries*/

/*Which are the tables (classes) and their properties*/

set :s00="PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
	  PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	  PREFIX saq: <http://user.it.uu.se/~udbl/sard#>
	  PREFIX per: <http://user.it.uu.se/~udbl/sard/person#>
	  select ?s ?p ?o
	  FROM  <http://user.it.uu.se/~udbl/sard/person>
	  WHERE { ?s rdf:type rdfs:Class .
		  ?s ?p ?o} ";

/*Which are the columns(propersties) of table(Class) 'per:tel' */

set :s0="PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
	 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	PREFIX saq: <http://user.it.uu.se/~udbl/sard#>
	PREFIX per: <http://user.it.uu.se/~udbl/sard/person#>
	select ?s ?p ?o
	FROM  <http://user.it.uu.se/~udbl/sard/person>
	WHERE { ?s rdfs:domain per:tel .
	        ?s ?p ?o. }";

/*The PK columns of tel with their properties*/

set :s1="PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
	PREFIX saq: <http://user.it.uu.se/~udbl/sard#>
	PREFIX per: <http://user.it.uu.se/~udbl/sard/person#>
	select ?val ?p ?o
	FROM  <http://user.it.uu.se/~udbl/sard/person>
	WHERE { per:tel saq:PRIMARY_KEY ?fk.
	       ?fk rdf:type rdf:Seq .       
	       ?fk ?prop ?val.
	       FILTER REGEX (?prop, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#*').
	       ?val ?p ?o .}";

/*The FK columns of tel */

set :s2="PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
	PREFIX saq: <http://user.it.uu.se/~udbl/sard#>
	PREFIX per: <http://user.it.uu.se/~udbl/sard/person#>
	select ?fk ?prop ?val
	FROM  <http://user.it.uu.se/~udbl/sard/person>
	WHERE { per:tel saq:FOREIGN_KEY ?fk.
	       ?fk rdf:type rdf:Seq .       
	       ?fk ?prop ?val.
	       FILTER REGEX (?prop, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#*')}";

/*The FK columns of tel with their properties*/

