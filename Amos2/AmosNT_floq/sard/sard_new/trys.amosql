create function amos_exec22_1()-><Charstring, Charstring ,Charstring>
as
select s,p,val
from Charstring s,Charstring p,Charstring val
where per()=<s,p,val> and like(val,'*maria');

create function amos_exec22()-><Charstring, Charstring ,Charstring>
as
select s,p,val
from Charstring s,Charstring p,Charstring val
where (per()=<s,p,val> and like(val,'*maria') and p="http://user.it.uu.se/~udbl/sard/person#person/name") or
	(per()=<s,p,val> and like(val,'*maria') and p="http://user.it.uu.se/~udbl/sard/person#tel/tel");


