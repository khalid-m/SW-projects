set :q02_schema2="SELECT ?s ?p ?val 
         FROM <http://user.it.uu.se/~udbl/sard/person>
         WHERE { ?s ?p ?val. 
		{FILTER(?s = <http://user.it.uu.se/~udbl/sard/person#tel>).} 
		UNION
		  {?s <http://www.w3.org/2000/01/rdf-schema#domain> <http://user.it.uu.se/~udbl/sard/person#tel>.}
 		UNION
	        {<http://user.it.uu.se/~udbl/sard/person#tel> <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s.
	        FILTER REGEX (?p,'*rdf-syntax-ns#_*').}
	        UNION
		{?s1 <http://www.w3.org/2000/01/rdf-schema#domain> <http://user.it.uu.se/~udbl/sard/person#tel>.
		 ?s1  <http://user.it.uu.se/~udbl/sard#references> ?s2.
		 ?s2 <http://www.w3.org/2000/01/rdf-schema#domain> ?s3. 
	 	  { ?s ?p ?val.
		   FILTER (?s =?s3). 
		   FILTER (?p =<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>).}
		  UNION
		  {?s ?p ?val.
		   FILTER (?s = ?s2).
		   FILTER (?p = <http://www.w3.org/2000/01/rdf-schema#domain>).
		   FILTER (?val=?s3).} } }";

