set :sparql3=
"select ?s ?val ?val2
FROM  <http://user.it.uu.se/~udbl/sard/person>
WHERE {  ?s <http://user.it.uu.se/~udbl/sard/person#person/name> ?val.
FILTER (?val != 'Ivan'). 
OPTIONAL {
          ?s <http://user.it.uu.se/~udbl/sard/person#person/age> ?val2.} }";

