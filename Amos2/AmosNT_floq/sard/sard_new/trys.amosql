/*RDB with columns only of type Varchar (Char) */
defineDS("egovDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=egov",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "egov",
         "egov",
         "useregov",
         "egov2013");


defineUPV("egovDS","egov","http://udbl.it.uu.se/upv/egov/");

DSConnect("egov");	

wrapRDB(jdbcOfDS("egovDS"), "egov", "egov", "egov");

assignIDS("egov","egov", "egov");

ViewRDB("egov");


set :q1 = 
"SELECT ?s 
 FROM <http://udbl.it.uu.se/upv/egov/>
 WHERE {?s <http://udbl.it.uu.se/upv/egov/#eucountry/currency> '\"euro\"\^\^<http://www.w3.org/2001/XMLSchema#string>' }";


eval("create function q1()-> Charstring
	as " + parse_sparql(:q1));


set :q3 = 
"SELECT ?p ?o
 FROM <http://udbl.it.uu.se/upv/egov/>
 WHERE {<http://udbl.it.uu.se/upv/egov/#eucountry/_spain> ?p ?o }";


eval("create function q3()->(Charstring,Charstring)
	as " + parse_sparql(:q3));


set :q2 = 
"CONSTRUCT { ?s ?p ?o }
 FROM <http://udbl.it.uu.se/upv/egov/>
 WHERE {?s <http://udbl.it.uu.se/upv/egov/#eucountry/currency>  '\"euro\"\^\^<http://www.w3.org/2001/XMLSchema#string>'.
	?s ?p ?o }";


eval("create function q2()-> (Charstring,Charstring,Charstring)
	as " + parse_sparql(:q2));



set :q4 = 
"CONSTRUCT { ?s ?p ?o }
 FROM <http://udbl.it.uu.se/upv/egov/>
 WHERE {?s <http://udbl.it.uu.se/upv/egov/#eucountry/currency>  ?o1 .
	?s ?p ?o .
	FILTER REGEX (?o1, 'euro%' ) } ";

create function q4()->(Charstring, Charstring, Charstring)
as select _ss_, _pp_, _oo_
  from Charstring o, Charstring p, Charstring s, Charstring val1,Charstring o1, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where (s, 'http://udbl.it.uu.se/upv/egov/#eucountry/currency', o1) in egov()
   and (s, p, o) in egov() and o1="\""+val1+"\""+"\^\^"+"<"+"http://www.w3.org/2001/XMLSchema#string"+">"
   and like(val1, 'euro')
      and ((_ss_ = s and _pp_ = p and _oo_ = o));



set :q5 = 
"SELECT ?s ?p ?o
 FROM <http://udbl.it.uu.se/upv/egov/>
 WHERE {?s ?p ?o .
	?s <http://udbl.it.uu.se/upv/egov/#lifeevent/name> ?o1 }";


eval("create function q5()->(Charstring,Charstring,Charstring)
	as " + parse_sparql(:q5));


/*Archive of a MS SQL Server database*/
/******************************************/

defineDS("person2DS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=person2",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "person2",
         "person",
         "person2",
         "person2");


defineUPV("person2DS","per2", "http://user.it.uu.se/~udbl/sard/person2");

DSConnect("per2");	

wrapRDB(jdbcOfDS("person2DS"), "person2", "person2", "person");


/*****************************************************/

defineDS("personDS",
         "jdbc:microsoft:sqlserver://localhost;DatabaseName=person",
        "com.microsoft.jdbc.sqlserver.SQLServerDriver",
         "person",
         "person",
         "sard2",
         "sard2");


defineUPV("personDS","per", "http://user.it.uu.se/~udbl/sard/person");

DSConnect("per");	

wrapRDB(jdbcOfDS("personDS"), "person", "person", "person");

assignIDS("per","person", "person");

ViewRDB("per");
/*make_def("per");*/

lisp;
(setq _gct_ t);;to apply GCT 
;;(setq _optional_ t)
(setq _unif_ t);;to normalize varianle names in a DNF RDB predicate 
(setq _rewrite_row_and_like_ t);;to rewrite a FILTER on subject/object
(setq _el-corcl_ t);;to rewrite the schema view to NIL when possible; {?s ?p <URI>}

(setq _elcon_ifnounif_ t);; to rewrite ( * * ?s. ?s ?p ?o ) -> dsecribe query

(setq _sch_ t) ;if the schema view and some rowid are conjuncted
(memo-function 'get-columns)

;;(setq _sq_ub_ NIL) ;;it doesn't work

:osql 


create_index(#'sdef->Charstring.Charstring.Charstring', "p","hash","multiple");
/*set_bijective_function("rowid",true);*/

/*Unload schema */

unloadS_asNT("preson_schema.nt",#"SPER->CHARSTRING.CHARSTRING.CHARSTRING");

unload_asNT("per_personschema.nt",functionnamed("retrieve_sclass"),{"http://user.it.uu.se/~udbl/sard/person#person"});

set :q7bench=
" CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/person>
 WHERE 
         { ?subject ?property1 ?value1 .
	   ?subject ?property ?value .
	   FILTER (?value1 != 'Ivan' )    }  ";


eval("create function q7bench()-> (Charstring,Charstring,Charstring)
	as " + parse_sparql(:q7bench));	

set :q3bench=
"CONSTRUCT {?subject ?property ?value }
 FROM <http://user.it.uu.se/~udbl/sard/person>
 WHERE 
         { ?subject ?property ?value .
	    FILTER REGEX (?value, '%lana%') } ";

eval("create function q3bench()-> (Charstring,Charstring,Charstring)
	as " + parse_sparql(:q3bench));	



