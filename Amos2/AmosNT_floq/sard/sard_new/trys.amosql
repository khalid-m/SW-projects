/*Unload schema concerning class <sard:person> - SCHEMA */

set :q01_schema="SELECT DISTINCT ?s1 ?p1 ?val1
         FROM <http://user.it.uu.se/~udbl/sard/person>
          WHERE {?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://user.it.uu.se/~udbl/sard/person#person>.
	         ?s ?p ?val.		 
		?s1 ?p1 ?val1.
		?cl  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Class>.
		?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?cl.	       
		{ FILTER (?s1 = ?cl).
	          FILTER (?p1 =<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)} 
	     UNION
		{  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		   FILTER (?s1 = ?p).
		  FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)}

	     UNION
		 {  ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		   FILTER (?s1 = ?p).
		   FILTER (?p1 = <http://www.w3.org/2000/01/rdf-schema#domain>).    }
	     UNION
		  { ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?cl.
		    FILTER (?p1 = <http://www.w3.org/2000/01/rdf-schema#range>).
		    FILTER (?s1 = ?p).}
	     UNION
		  { FILTER (?s1 = ?cl).
		    FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY>)}
	     UNION
		  {FILTER (?s1 = ?cl).
                   FILTER (?p1 = <http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>)}
	     UNION
		  { ?cl  <http://user.it.uu.se/~udbl/sard#FOREIGN_KEY> ?s1.
                   FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)} 
	     UNION
		{ 
		   ?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
	          FILTER (?p1 =  <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>)} 
	     UNION
		{  ?cl  <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY> ?s1.
		  FILTER (?p1 = <http://www.w3.org/1999/02/22-rdf-syntax-ns#_1>).   }
	     UNION
		{
		  FILTER REGEX (?p1,'*#REFERENCES')}}";
		

eval("create function q01_schema()-> <Charstring,Charstring,Charstring>
	as " + parse_sparql(:q01_schema));






