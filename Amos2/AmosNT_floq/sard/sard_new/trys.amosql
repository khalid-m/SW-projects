create function q10()->(Charstring,Charstring,Charstring)
as remove_null(select ss,pp,oo from Charstring ss,Charstring pp,Charstring oo
where per()=(ss,pp,oo)  or (per()=(ss,pp,oo) and oo=ss ));


create function q0()->(Charstring,Charstring,Charstring)
as remove_null(select ss,pp,oo from Charstring s,Charstring o,
Charstring ss,Charstring pp,Charstring oo
where per()=(s, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",o)
	and neq(o, "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property")
	and neq(o, "http://www.w3.org/2000/01/rdf-schema#Class")
	and neq(o, "http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq")
      and  ((per()=(ss,pp,oo) and ss=s ) or (per()=(ss,pp,oo) and oo=s )));

archive_content(#'q0',"data0.nt","schema0.nt");

