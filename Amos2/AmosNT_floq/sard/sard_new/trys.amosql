/*Archive only the data*/
set :q_data="SELECT ?s ?p ?val
	     FROM <http://user.it.uu.se/~udbl/sard/person>
	     WHERE {?s ?p ?val.
	     FILTER (?p != <http://www.w3.org/2000/01/rdf-schema#domain>).
             FILTER (?p != <http://www.w3.org/2000/01/rdf-schema#range>).
	     FILTER (?p != <http://www.w3.org/1999/02/22-rdf-syntax-ns#_1>).
	     FILTER (?p != <http://www.w3.org/1999/02/22-rdf-syntax-ns#_2>).
	     FILTER (?p != <http://www.w3.org/1999/02/22-rdf-syntax-ns#_3>).
	     FILTER (?p != <http://user.it.uu.se/~udbl/sard#PRIMARY_KEY>).
	     FILTER (?p != <http://user.it.uu.se/~udbl/sard#FOREIGN_KEY>).
	     FILTER (?p != <http://user.it.uu.se/~udbl/sard#REFERENCES>).
	     FILTER (?p != <http://user.it.uu.se/~udbl/sard#size>).
	     FILTER (?val !=<http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>).
	     FILTER (?val != <http://www.w3.org/2000/01/rdf-schema#Class>). 
	     FILTER (?val != <http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq>).
	     }";

eval("create function exec_q_data()-><Charstring,Charstring,Literal> as " + parse_sparql(:q_data)); 

write_ntuples(call_function("exec_q_data",{}),"person_data1.nt");

/*Archive only the schema*/
set :q_schema="SELECT ?s ?p ?val
	     FROM <http://user.it.uu.se/~udbl/sard/person>
	     WHERE {?s ?p ?val.
	        { FILTER REGEX (?val, '*#Property').
	          FILTER REGEX (?p,'*#type').}		 
	     UNION
		{ FILTER REGEX (?val, '*#Class'). 
	          FILTER REGEX (?p,'*#type')} 
	     UNION
		 {FILTER REGEX (?p, '*#domain').}
	     UNION
		  {FILTER REGEX (?p, '*#range')}
	     UNION
		  {FILTER REGEX (?p,'*#PRIMARY_KEY')}
	     UNION
		  {FILTER REGEX (?p,'*#FOREIGN_KEY')}
	     UNION
		{ FILTER REGEX (?val, '*#Seq'). 
	          FILTER REGEX (?p,'*#type')} 
	     UNION
		{ FILTER REGEX (?p, '*rdf-syntax-ns#_*')}
	     UNION
		{FILTER REGEX (?p,'*#REFERENCES')}}";

eval("create function exec_q_schema()-><Charstring,Charstring,Literal> as " + parse_sparql(:q_schema)); 

write_ntuples(call_function("exec_q_schema",{}),"person_schema.nt");



