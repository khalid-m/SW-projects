	FROM  <http://user.it.uu.se/~udbl/sard/person>
	WHERE { per:tel saq:FOREIGN_KEY ?fk.
	       ?fk rdf:type rdf:Seq .       
	       ?fk ?prop ?val.
	       FILTER REGEX (?prop, 'http://www.w3.org/1999/02/22-rdf-syntax-ns#*').
	       ?val ?p ?o.  }";


