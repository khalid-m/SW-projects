set :opt1 = 
"SELECT ?s ?val ?s1 ?val1
 FROM <http://user.it.uu.se/~udbl/sard/person>
 WHERE {?s <http://user.it.uu.se/~udbl/sard/person#person/age> ?val .
	FILTER (?val > '15') .
	OPTIONAL { ?s1 <http://user.it.uu.se/~udbl/sard/person#tel_of_person> ?s . } .
	OPTIONAL { ?s1 <http://user.it.uu.se/~udbl/sard/person#tel/telnumber> ?val1 . 
		   FILTER (?val1 > '999' ).  } }";


eval("create function opt1()-> (Charstring,Charstring,Charstring, Charstring )
	as " + parse_sparql(:opt1));

set :opt2 = 
"SELECT ?s ?val 
 FROM <http://user.it.uu.se/~udbl/sard/person>
 WHERE {?s <http://user.it.uu.se/~udbl/sard/person#person/age> ?val .
	FILTER (?val = '30') .
	OPTIONAL { ?s1 <http://user.it.uu.se/~udbl/sard/person#tel_of_person> ?s . 
		   ?s1 <http://user.it.uu.se/~udbl/sard/person#tel/telnumber> ?tel . }.
	 FILTER (!bound(?tel)) }";

set :opp = 
"SELECT ?s ?val 
 FROM <http://user.it.uu.se/~udbl/sard/person>
 WHERE {?s <http://user.it.uu.se/~udbl/sard/person#person/age> ?val .
	FILTER (?val = '30') .
	?s1 <http://user.it.uu.se/~udbl/sard/person#tel_of_person> ?s .
   	?s1 <http://user.it.uu.se/~udbl/sard/person#tel/telnumber> ?tel . 
	 FILTER (!bound(?tel)) }";


/*Retrieve the ages of all persons older than 15, if these persons have phone numbers and 
their names are 'Ivan', retrieve the phone numbers as well*/
create function cons_opt1()-> (Charstring, Charstring, Charstring)
as 
   select ss, pp, oo
  from Charstring val, Charstring s, Charstring s1,
	Charstring ss, Charstring pp, Charstring oo,Charstring tel
   where per()=(s, 'http://user.it.uu.se/~udbl/sard/person#person/age', val)
   and val > '15'
   and {s1,tel}=optional((select {s1_o,tel_o}
                      from Charstring s1_o, Charstring tel_o
                     where per()= (s, 'http://user.it.uu.se/~udbl/sard/person#person/name', 'Ivan') and
			   per()=(s1_o,'http://user.it.uu.se/~udbl/sard/person#tel/telnumber',tel_o) and
			    per()=(s1_o, 'http://user.it.uu.se/~udbl/sard/person#tel_of_person', s)),{'',''})
  and ( (ss=s and pp='http://user.it.uu.se/~udbl/sard/person#person/age' and oo=val) or
	(ss=s1 and pp='http://user.it.uu.se/~udbl/sard/person#tel/telnumber' and oo=tel) or
	(ss=s1 and pp='http://user.it.uu.se/~udbl/sard/person#tel_of_person' and oo=s ) );


