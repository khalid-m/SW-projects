create function cons_opt2_2()->(Charstring, Charstring, Charstring)
as
  select _ss_, _pp_, _oo_
  from Charstring val2, Charstring s, Charstring s1, Charstring tel, Charstring _ss_, Charstring _pp_, Charstring _oo_
 where per()=(s, 'http://user.it.uu.se/~udbl/sard/person#person/age', '30')
   and per()=(s, 'http://user.it.uu.se/~udbl/sard/person#person/name', val2)
   and {tel,s1}=optional((select {tel, s1}
                            where per()=(s1, 'http://user.it.uu.se/~udbl/sard/person#tel_of_person', s)
                             and per()=(s1, 'http://user.it.uu.se/~udbl/sard/person#tel/telnumber', tel)),{'',''})
      and ((_ss_ = s and _pp_ = 'http://user.it.uu.se/~udbl/sard/person#person/name' and _oo_ = val2)
        or (_ss_ = s1 and _pp_ = 'http://user.it.uu.se/~udbl/sard/person#tel_of_person' and _oo_ = s  and NEQ(s1,''))
        or (_ss_ = s1 and _pp_ = 'http://user.it.uu.se/~udbl/sard/person#tel/telnumber' and _oo_ = tel and NEQ(s1,'') and NEQ(tel,''))) ;



/*Retrieve the name and friend of person 1, retreive also his/her age only if he/she is older than 55 */
/*Exec:
	1 sql for the non-optional 
	1 sql for the optional */
create function cons_opt3()-> (Charstring, Charstring, Charstring)
as 
   select ss, pp, oo
  from Charstring val, Charstring val1,
	Charstring ss, Charstring pp, Charstring oo
   where per()=('http://user.it.uu.se/~udbl/sard/person#person/_1_1000', 'http://user.it.uu.se/~udbl/sard/person#person/name', val) 
   and val1=optional((select val1_o
                      from Charstring val1_o
                     where per()= ('http://user.it.uu.se/~udbl/sard/person#person/_1_1000', 'http://user.it.uu.se/~udbl/sard/person#person/age', val1_o) and val1_o > '55' ),'') 			  
	  and ( (ss='http://user.it.uu.se/~udbl/sard/person#person/_1_1000' and pp='http://user.it.uu.se/~udbl/sard/person#person/age' and oo=val1) or
	        (ss='http://user.it.uu.se/~udbl/sard/person#person/_1_1000' and pp='http://user.it.uu.se/~udbl/sard/person#person/name' and oo=val ) );
	


