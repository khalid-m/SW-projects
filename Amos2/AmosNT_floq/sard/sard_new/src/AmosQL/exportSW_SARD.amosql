        pMap('" + tn + "','" + cn + "','" + upv + "', p) and 
        s = rowid(cid,concatLiteral("+tn+"_"+k+")) and 
        val = " + tn + "_" + cn + ")"
 from Charstring k
 where k =  concatagg(inject(getKey(DSOfUPV(upv),tn),","+tn+"_"));

