create function pklist(Relational r,Charstring catalog_name,Charstring schema_name,Charstring tab)->Charstring
as
 if (some (primary_keys(r,catalog_name,schema_name,tab))) then
   begin
	declare Charstring list;
	set list="";
	for each Charstring keycol,Charstring keyname where primary_keys(r,catalog_name,schema_name,tab)=(keycol,keyname)
		set list=list+keycol+"_";
	return RDB_URI(ret_tableO(tab))+"/_"+substring(list,0,char_length(list)-2);
   end
 else return "NULL";
         




create function is_in_rMap(Charstring upv, Charstring tname,Charstring cname)->Boolean
/*True if the column 'cn' is mapped as a foreign key column*/
as
	select true 
	from Vector of Charstring cn2,Charstring tn1,Charstring tn2, Charstring rid 
	where rMap(tname,cname,tn1,upv,rid) or
		rmmMap(tname,{cname},cn2,tn1,tn2,upv,rid) or
		rmmMap(tname,cn2,{cname},tn2,tn1,upv,rid); 




create function gen_seqPKs(Charstring upv,Charstring catalog,Charstring schema, Charstring tn)-> Charstring
/*Defines the Primary key view*/
as
 if (some( primary_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn))) then
   begin
	declare integer i,Charstring seq;
	set i= count( primary_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn));
	 set seq= "(	 cmap('"+tn+"','"+upv+"',taburi) and
			 s = taburi and
			 p='http://user.it.uu.se/~udbl/sard#PRIMARY_KEY' and
			 val = '_:"+tn+"_PrK' ) or
		   	(s='_:"+tn+"_PrK' and
			p='http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
			val='http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq')";
	for each Charstring col,Charstring pkstr 
			where (col,pkstr) in primary_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn)
	   begin
	      set seq= seq +" or (s='_:"+tn+"_PrK' and
			 p='http://www.w3.org/1999/02/22-rdf-syntax-ns#_"+i+"' and
			 pMap('"+tn+"',colp,'"+upv+"',prop) and like_i(colp,'"+col+"') and
			val=prop )"; 
			 
 		set i=i-1;
	   end;
	return seq;
   end;
 




create function gen_seqFKs(Charstring upv,Charstring catalog,Charstring schema, Charstring tn)-> Charstring
/*Defines the Foreign key view*/
as
    if (some (imported_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn))) then
     begin
	declare integer i,Charstring seq;
	for each Charstring reftable, Charstring prop where prop in rcMap(tn,reftable,upv)
	 begin
		set i=1;
		set seq= seq + " or ( cmap('"+tn+"','"+upv+"',taburi) and
			 s = taburi and
			 p='http://user.it.uu.se/~udbl/sard#FOREIGN_KEY' and
			  rcMap('"+tn+"','"+reftable+"','"+upv+"',val))  or
		   	(  rcMap('"+tn+"','"+reftable+"','"+upv+"',s) and
			p='http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
			val='http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq')";
	     for each Charstring refcolumn, Charstring cn  
		where (reftable,refcolumn,cn) in imported_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn)
		begin 
		       set seq= seq +" or ( rcMap('"+tn+"','"+reftable+"','"+upv+"',s) and
			 p='http://www.w3.org/1999/02/22-rdf-syntax-ns#_"+i+"' and
			 pMap('" + tn + "','" + cn + "','" + upv + "', val)) or
			(pMap('" + tn + "','" + cn + "','" + upv + "', p1) and 
        		 s = p1 and 
	 		pMap('" + reftable + "','" + refcolumn + "','" + upv + "', p2) and
			 p ='http://user.it.uu.se/~udbl/sard#REFERENCES' and
  	 		val = p2)";
	                set i=i+1;
	        end;		
	   end;
	return substring (seq,6,char_length(seq));
     end;
   

create function gen_seqFKs10(Charstring upv,Charstring catalog,Charstring schema, Charstring tn)-> Charstring
/*Defines the Foreign key view*/
as
    if (some (imported_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn))) then
     begin
	declare integer i,Charstring seq,Charstring ref,integer j;
	set j=0; set seq=""; set ref="";
	for each Charstring reftable, Charstring refcolumn, Charstring cn  
	 where (reftable,refcolumn,cn) in imported_keys(jdbcOfDS(DSOfUPV(upv)),catalog,schema,tn)
            begin
		if notany(like(ref,reftable)) then
	         begin
			set i=1;
			set j=j+1;
		        set seq= "( cmap('"+tn+"','"+upv+"',taburi) and
			 s = taburi and
			 p='http://user.it.uu.se/~udbl/sard#FOREIGN_KEY' and
			 val = '_:"+tn+"_FK_" + j +"' ) or
		   	(s='_:"+tn+"_FK_"+j+"' and
			p='http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
			val='http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq') or  		
	   		 (s='_:"+tn+"_FK_"+j+"' and
			 p='http://www.w3.org/1999/02/22-rdf-syntax-ns#_"+i+"' and
			 rcMap('"+tn+"','"+reftable+"','"+upv+"',val) ) or
			(rcMap('"+tn+"','"+reftable+"','"+upv+"',s) and 
        		 pMap('" + reftable + "','" + refcolumn + "','" + upv + "',val) and
			 p ='http://user.it.uu.se/~udbl/sard#REFERENCES')" + " or " + seq;
			 set ref=reftable;
		  end
		else
		 begin
			set i=i+1;
		 	set seq =  seq + "(s='_:"+tn+"_FK_"+j+"' and
			 p='http://www.w3.org/1999/02/22-rdf-syntax-ns#_"+i+"' and
			 val = '"+RDB_URI(ret_columnO(tn,cn))+"') or
			(rcMap('"+tn+"','"+reftable+"','"+upv+"',s) and 
        		 pMap('" + reftable + "','" + refcolumn + "','" + upv + "',val) and
			 p ='http://user.it.uu.se/~udbl/sard#REFERENCES' )" + " or " + seq;			
		 end;
            end;
	return substring(seq,0,char_length(seq)-4);
      end;





create function genPKs(Charstring upv)->Bag of Charstring
as 
	for each Charstring tn, Charstring catalog, Charstring schema,Charstring taburi
			where (tn,catalog,schema,"TABLE") in tables(jdbcOfDS(DSOfUPV(upv))) and cmap(tn,upv)=taburi
	   return gen_seqPKs(upv,catalog,schema,tn);
	

create function genFKs(Charstring upv)->Bag of Charstring
as 
	for each Charstring tn, Charstring catalog, Charstring schema, Charstring taburi
			where (tn,catalog,schema,"TABLE") in tables(jdbcOfDS(DSOfUPV(upv))) and  cmap(tn,upv)=taburi
		 return  gen_seqFKs(upv,catalog,schema,tn);

create function genPKeys(Charstring upv)->Bag of Charstring
  as 
	if(genPKs(upv) != "") then
	  	return concatagg(inject(genPKs(upv)," or "));

create function genFKeys(Charstring upv)->Bag of Charstring
  as 
	if(genFKs(upv) != "") then
		return concatagg(inject(genFKs(upv)," or "));


create function gen_classpropview(Charstring upv)->Charstring 
as
	select ("(cMap(tn,'"+upv+"',taburi) and
	          s = taburi and
		  p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		 val = 'http://www.w3.org/2000/01/rdf-schema#Class') or
		 (cMap(tn,'"+upv+"',taburi) and
	  	 pMap(tn,cn,'"+upv+"',prop) and
	        s = prop and
		 p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		 val = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
	      (pMap(tn,cn,'"+upv+"',prop) and
	        cMap(tn,'"+upv+"',taburi) and
	        s = prop and
	        p = 'http://www.w3.org/2000/01/rdf-schema#domain' and 
	        val = taburi) or
	       (pMap(tn,cn,'"+upv+"',prop) and
	        cMap(tn,'"+upv+"',taburi) and
		typeMap(tn,cn,'"+upv+"',typ) and
		s = prop and
		p = 'http://www.w3.org/2000/01/rdf-schema#range' and
		val = typ) or
		(s='http://user.it.uu.se/~udbl/sard#size' and
   	         p= 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		 val='http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
		(s='http://user.it.uu.se/~udbl/sard#PRIMARY_KEY' and
   	         p= 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		 val='http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
		(s='http://user.it.uu.se/~udbl/sard#FOREIGN_KEY' and
   	         p= 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		 val='http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') ");


create function sizeprops(Charstring tn, Charstring cn, Charstring upv,Charstring prop)->Charstring
as
	if( neq(itoa(size(ret_columnO(tn,cn))),"") )  then
		return "( s = '"+prop+"' and
			   p= 'http://user.it.uu.se/~udbl/sard#size' and 
			   pmap('"+tn+"','"+cn+"','"+upv+"','"+prop+"') and
			   val = valueid(itoa(size(ret_columnO('"+tn+"','"+cn+"'))),
				'http://www.w3.org/2001/XMLSchema#int') )";
	  


create function all_sizeprops(Charstring upv)->Bag of Charstring 
as
	for each Charstring tn, Charstring cn, Charstring upv, Charstring prop
		where (tn,cn,upv,prop) in pMap()
  		return  sizeprops(tn,cn,upv,prop);


create function gen_sizeprops(Charstring upv)->Bag of Charstring 
as	return concatagg(inject(all_sizeprops(upv), " or "));





create function gen_FKprops(Charstring upv)-> Charstring
as
	select ("(cMap(tn,'"+upv+"',taburi) and
	  	  rcMap(tn,tn1,'"+upv+"',prop) and
	          s = prop and
		  p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		  val = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
	         (rcMap(tn,tn1,'"+upv+"',prop) and
	          cMap(tn,'"+upv+"',taburi) and
	          s = prop and
	          p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
	          val = taburi) or
	         (rcMap(tn,tn1,'"+upv+"',prop) and
	          cMap(tn,'"+upv+"',taburi) and
	          cMap(tn1,'"+upv+"',taburi1) and
		  s = prop and
		  p = 'http://www.w3.org/2000/01/rdf-schema#range' and
		  val = taburi1) ");


create function gen_MMprops(Charstring upv)-> Charstring
as
	select ("(rmmMap(tn,vcn1,vcn2,tn1,tn2,'"+upv+"',prop) and
	          s = prop and
		  p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and
		  val = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#Property') or
	         (rmmMap(tn,vcn1,vcn2,tn1,tn2,'"+upv+"',prop) and
	          s = prop and
	          p = 'http://www.w3.org/2000/01/rdf-schema#domain' and
		  cMap(tn1,'"+upv+"',taburi) and
	          val = taburi) or
	          (rmmMap(tn,vcn1,vcn2,tn1,tn2,'"+upv+"',prop) and
	          s = prop and
		  p = 'http://www.w3.org/2000/01/rdf-schema#range' and
		   cMap(tn2,'"+upv+"',taburi) and
		  val = taburi) ");
		


create function define_schemaview(Charstring upv)->Boolean
  as
   begin
    declare Charstring fkv, Charstring pkv;
   /* set fkv= genFKeys(upv);
    set pkv= genPKeys(upv);*/
    if ( some(genFKeys(upv)) and some(genPKeys(upv))
	and some(rmmMap()) and gen_sizeprops(upv) != ''  ) then
    begin
     eval("create function schema_view_" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as 
            select s,p,val 
           from Charstring s,Charstring p,Charstring val, Charstring taburi,Charstring taburi1,
		Charstring prop,Charstring typ,Charstring tn,Charstring cn,Charstring tn1,
		Charstring p1, Charstring p2,Charstring colp,
		Vector of Charstring vcn1,Vector of Charstring vcn2,Charstring tn2
           where " +  gen_classpropview(upv) + " or " +  gen_sizeprops(upv) + " or " + genPKeys(upv) + " or "
		+ gen_FKprops(upv) + " or "+ genFKeys(upv) + " or " + gen_MMprops(upv) +";");
    end ;
    if ( some(genFKeys(upv)) and some(genPKeys(upv))
	and some(rmmMap()) and like(gen_sizeprops(upv),'')  ) then
    begin
     eval("create function schema_view_" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as 
            select s,p,val 
           from Charstring s,Charstring p,Charstring val, Charstring taburi,Charstring taburi1,
		Charstring prop,Charstring typ,Charstring tn,Charstring cn,Charstring tn1,
		Charstring p1, Charstring p2,Charstring colp,
		Vector of Charstring vcn1,Vector of Charstring vcn2,Charstring tn2
           where " +  gen_classpropview(upv) + " or " + genPKeys(upv) + " or "
		+ gen_FKprops(upv) + " or "+ genFKeys(upv) + " or " + gen_MMprops(upv) +";");
    end ;

    if ( some(genFKeys(upv)) and some(genPKeys(upv))
	and notany(rmmMap()) and gen_sizeprops(upv) != '' ) then
    begin
     eval("create function schema_view_" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as 
            select s,p,val 
           from Charstring s,Charstring p,Charstring val, Charstring taburi,Charstring taburi1,
		Charstring prop,Charstring typ,Charstring tn,Charstring cn,Charstring tn1,
		Charstring p1, Charstring p2,Charstring colp
           where " +  gen_classpropview(upv) + " or " +  gen_sizeprops(upv)+ " or " + genPKeys(upv) + " or "
		+ gen_FKprops(upv) + " or "+ genFKeys(upv) + ";");
    end ;		
     if  (notany(genFKeys(upv)) and some(genPKeys(upv))
		and notany(rmmMap()) and gen_sizeprops(upv) != '') then
       begin
	eval("create function schema_view_" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as  
            select s,p,val 
           from Charstring s,Charstring p,Charstring val, Charstring taburi,
		Charstring prop,Charstring typ,Charstring tn,Charstring cn,Charstring colp
	 where " + gen_classpropview(upv)+ " or " +  gen_sizeprops(upv) + " or " + genPKeys(upv) +" ;");
	end ;
     	if ( notany(genFKeys(upv)) and notany(genPKeys(upv)) 
			and notany(rmmMap()) and gen_sizeprops(upv) != '' )  then
      begin
	eval("create function schema_view_" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as  
            select s,p,val 
           from Charstring s,Charstring p,Charstring val, Charstring taburi,
		Charstring prop,Charstring typ,Charstring tn,Charstring cn 
	 where " + gen_classpropview(upv)+ " or " +  gen_sizeprops(upv) + " ;");
      end;
      if  (some(genFKeys(upv)) and some(genPKeys(upv))
		and notany(rmmMap()) ) then
       begin
	eval("create function schema_view_" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as select s,p,val 
            from Charstring s,Charstring p,Charstring val, Charstring taburi,Charstring taburi1,
		Charstring prop,Charstring typ,Charstring tn,Charstring cn,Charstring tn1,
		Charstring p1, Charstring p2,Charstring colp
	 where " + gen_classpropview(upv)+ " or " +  genPKeys(upv) + " or " + gen_FKprops(upv) +
		 " or "+ genFKeys(upv) + ";");
	end ;
   end;




   


