create function genPV_oneK(Charstring upv,		
	              Charstring tn,
	              Charstring cn)->Charstring clause
as 
 select "(" + genRelcall(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and 
        pMap('" + tn + "','" + cn + "','" + upv + "', p) and 
        s = rowid(cid,"+tn+"_"+k+") and 
        val = " + tn + "_" + cn + ")"
 from Charstring k
 where k =  concatagg(inject(getKey(DSOfUPV(upv),tn),","+tn+"_"));





