create function SchemaViewMaterialize(Charstring upv)->Boolean 
as 
 begin
  /*define_schemaview(upv);*/
  eval("create function s" + upv 
	+ "(Charstring s,Charstring p,Charstring val)->
		Boolean as stored;");
 
  eval("declare_key(theresolvent('s" + upv + "'),{'s','p','val'});");

   /* Since the schema view resides in main memory the cost is 2 and fanout is
    * very small
    */
  eval("costhint('Charstring.Charstring.Charstring.s" + upv + "->Boolean',
		'fbf',{2,1});");

  eval("parteval('s" + upv + "');");
   	begin
  	 eval("for each Charstring s, Charstring p, Charstring val 
	     where (s,p,val) in s_view('"+upv+"')
         	add s" + upv + "(s,p,val)=true;");
    	end;
 
  eval("create function s" + upv + "()->
	(Charstring s,Charstring p,Charstring val) 
		as select s, p, val where s" + upv + "(s,p,val);");
 end;


create function SchemaViewNoMaterialize(Charstring upv)->Boolean 
as 
/*Define S-view - generic s-view, non-generated  */
 begin
 	eval("create function s" + upv+ "()->(Charstring s,Charstring p,Charstring val)
		as select s,p,val where (s,p,val) in s_view('"+upv+"');");
  end;


create function SchemaViewNoMaterialize_g(Charstring upv)->Boolean 
as 
/*Generate S-view  */
 begin
  generate_S_view(upv);
  eval("declare_key(theresolvent('s" + upv + "'),{'s','p','val'});");
 end;



create function SchemaViewMaterialize_old(Charstring upv)->Boolean 
as 
 begin
  define_schemaview(upv);
  eval("create function s" + upv 
	+ "(Charstring s,Charstring p,Charstring val)->
		Boolean as stored;");
 
  eval("declare_key(theresolvent('s" + upv + "'),{'s','p','val'});");

   /* Since the schema view resides in main memory the cost is 2 and fanout is
    * very small
    */
  eval("costhint('Charstring.Charstring.Charstring.s" + upv + "->Boolean',
		'fbf',{2,1});");

  eval("parteval('s" + upv + "');");
   	begin
  	 eval("for each Charstring s, Charstring p, Charstring val 
	     where (s,p,val) in schema_view_"+upv+"()
         	add s" + upv + "(s,p,val)=true;");
    	end;
 
  eval("create function s" + upv + "()->
	(Charstring s,Charstring p,Charstring val) 
		as select s, p, val where s" + upv + "(s,p,val);");
 end;



create function genRelcall(Charstring upv,
	                    Charstring rname)->Charstring r
as
 begin
  declare Charstring relcall;  
  set relcall=rname + "_" + DSOfUPV(upv) + "_cc()=(" +  
              concatagg(inject((select rname + "_" + cname 
                                from Charstring cname, Charstring ctype 
                                where (ctype, cname) in 
                                       columns(JDBCOfDS(DSOfUPV(upv)), 
                                        rname)), ",")) + ")";
  if(relcall="") then
   error("Could not extract any columns from table " + rname);
  
  return relcall;
 end;


create function genRelcall_nokey(Charstring upv,
	                    Charstring rname)->Charstring r
as
 begin
  declare Charstring relcall;  
  set relcall=rname + "_" + DSOfUPV(upv) + "_cc()=("+rname+"__ident_," +  
              concatagg(inject((select rname + "_" + cname 
                                from Charstring cname, Charstring ctype 
                                where (ctype, cname) in 
                                       columns(JDBCOfDS(DSOfUPV(upv)), 
                                        rname)), ",")) + ")";
  if(relcall="") then
   error("Could not extract any columns from table " + rname);
  return relcall;
 end;



create function rel(Charstring upv, Charstring tn)->Charstring
as
 begin
    declare Charstring relvars, integer i, Vector column;
    set column=vectorOf(columns(JDBCOfDS(DSOfUPV(upv)),tn ));
    set i=0;
    set relvars="";
    for each Charstring cctype where cctype=name(result_types(theresolvent(tn+"_"+DSOfUPV(upv)+"_CC") ))
      begin
        declare vector v;
	set v=column[i];
	set relvars=relvars + cctype+ " "+ tn+"_" + v[1]+",";
	set i=i+1;
      end;
   
    if(relvars = "") then
     error("Could not extract any columns from table " + tn);

    return substring(relvars,0,char_length(relvars)-2); 

 end;


create function rel_nokey(Charstring upv, Charstring tn)->Charstring
as
 begin
    declare Charstring relvars, integer i, Vector column,Vector v;
    set v={"int","_ident_"};
    set column=concat(vectorOf(v),vectorOf(columns(JDBCOfDS(DSOfUPV(upv)),tn )));
    set i=0;
    set relvars="";
    for each Charstring cctype where cctype=name(result_types(theresolvent(tn+"_"+DSOfUPV(upv)+"_CC") ))
      begin
        declare vector v;
	set v=column[i];
	set relvars=relvars + cctype+ " "+ tn+"_" + v[1]+",";
	set i=i+1;
      end;
   
    if(relvars = "") then
     error("Could not extract any columns from table " + tn);

    return substring(relvars,0,char_length(relvars)-2); 

 end;

create function genRelvars(Charstring upv)-> Charstring
as
 begin
  for each Charstring tn 
   where (tn,catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)), "TABLE") in
         tables(jdbcOfDS(DSOfUPV(upv)))
   begin
    declare Charstring relvars;
     if (notany(functionnamed(upper(tn) + "_" + DSOfUPV(upv) + "_CC"))) then
      begin
      if( some(primary_keys(jdbcOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)),tn)) ) then
        begin
    	 import_table(JDBCOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),
                        schemaOfDS(DSOfUPV(upv)),tn,'',false,{});
	 set relvars=rel(upv,tn);
        end
       else if (notany(primary_keys(jdbcOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)),tn)) ) then
        begin
	 import_tableRDB(JDBCOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),
                        schemaOfDS(DSOfUPV(upv)),tn,'',false,{});  
	 set relvars=rel_nokey(upv,tn);
	 end;       
     end
     else  
      begin
	if( some(primary_keys(jdbcOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)),tn)) ) then
		set relvars=rel(upv,tn)
	else set relvars=rel_nokey(upv,tn);
      end;	
    if(relvars = "") then
     error("Could not extract any columns from table " + tn);
    return relvars; 
    
   end;
 end;



	
create function concatLiteral(Number l1,Literal l2)->Charstring
as
	return  plus(itoa(l1),l2);



/* Get key of relational table. 
 */
create function getKeyrr(Charstring ds,
  	                Charstring tn)
	                ->Charstring col
as 
  begin
	declare Charstring str;
	set str="";
	if (count (primary_keys(JDBCOfDS(ds),catalogOfDS(ds),schemaOfDS(ds),tn)) > 0) then
         begin
		for each Charstring col,Charstring constraint
			 where (col,constraint) in primary_keys(JDBCOfDS(ds),catalogOfDS(ds),schemaOfDS(ds),tn) 
			set str=tn+"_"+col +","+str ;
		return "{"+ substring(str,0,char_length(str)-2)+"}";
 	 end;
  end;

/*Construct vector of compound primary key*/
create function getFKeyrr(Charstring ds, Charstring tn, Charstring otn) ->Charstring vectorcol
as 
 begin
   	declare Charstring str;
	set str="";
	 if ( some(imported_keys(JDBCOfDS(ds),catalogOfDS(ds),schemaOfDS(ds),tn))) then
	  begin
		for each Charstring col,Charstring ocol
			where(otn,ocol,col) in imported_keys(JDBCOfDS(ds),catalogOfDS(ds),schemaOfDS(ds),tn)
	 	set str=str+ ","+ tn+"_"+col ;
		if (str != "") then
			return "{"+ substring(str,1,char_length(str)-1)+"}";
  	  end;
  end;


create function formVal(Literal val key, Charstring xsdtype key)->Charstring maptype
as foreign 'gen-concat';	

create function retrieveVal(Charstring mapvalue,Charstring xsdtype)->Literal val
as foreign 'split-value';

create function valueid(Literal val, Charstring xsdtype)->Charstring mapvalue key
as multidirectional ('bbf' select formVal(val,xsdtype))
		    ('fbb' select retrieveVal(mapvalue,xsdtype));



create function genPV_o(Charstring upv,		
	              Charstring tn,
	              Charstring cn)->Charstring clause
as 
/*TO DO: The version of the genPV with concat of the XSD type to val*/
 select "(" + genRelcall(upv,tn) + " and 
	cMap('" + tn + "','" + upv + "', cid) and 
         pMap('" + tn + "','" + cn + "','" + upv + "', p) and 
         s = rowID(cid,"+k+") and 	 
	 val = valueid(" + tn + "_" + cn + ",find_abbtypeCol(typeMap('"+tn+"','"+cn+"','"+upv+"'))))"
 from Charstring k
 where k =  getKeyrr(DSOfUPV(upv),tn);


create function genPV(Charstring upv,		
	              Charstring tn,
	              Charstring cn)->Charstring clause
as 
/*TO DO: The version of the genPV with concat of the XSD type to val*/
 select "(" + genRelcall(upv,tn) + " and 
	cMap('" + tn + "','" + upv + "', cid) and 
         pMap('" + tn + "','" + cn + "','" + upv + "', p) and 
         s = rowID(cid,"+k+") and 	 
	 val = valueid(" + tn + "_" + cn + ",typeMap('"+tn+"','"+cn+"','"+upv+"')))"
 from Charstring k
 where k =  getKeyrr(DSOfUPV(upv),tn);


create function genPV_new2(Charstring upv,		
	              Charstring tn,
	              Charstring cn)->Charstring clause
as 
/*TO DO: The version of the genPV with concat of the abr XSD to val*/
 select "(" + genRelcall(upv,tn) + " and 
	 cMap('" + tn + "','" + upv + "', cid) and 
         pMap('" + tn + "','" + cn + "','" + upv + "', p) and 
         s = rowID(cid,"+k+") and 
  	 val = concat(cast(" + tn + "_" + cn + " as Charstring),'\^\^"+find_abbtypeCol(typeMap(tn,cn,upv))+"') )"
 from Charstring k
 where k =  getKeyrr(DSOfUPV(upv),tn);



create function genPV_nokey(Charstring upv,		
	              Charstring tn,
	              Charstring cn)->Charstring clause
as 
 select "(" + genRelcall_nokey(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and 
        pMap('" + tn + "','" + cn + "','" + upv + "', p) and 
        s = rowid(cid,{"+tn+"__ident_}) 
        val = " + tn + "_" + cn + ")"; 



create function genCCV(Charstring upv,		
	               Charstring tn)->Charstring clause
as 
 select "(" + genRelcall(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and         
         s = rowid(cid,"+k+") and 
        p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and 	
        val = cid  )"
 from Charstring k
 where k =  getKeyrr(DSOfUPV(upv),tn);


create function genCCV_nokey(Charstring upv,		
	               Charstring tn)->Charstring clause
as 
 select "(" + genRelcall_nokey(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and         
        s = rowid(cid,{"+tn+"__ident_}) and 
        p = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' and 
        val = cid)";


/* Generate class membership views for each mapped class. 
 */
create function genCCVs(Charstring up)->Charstring
  as  for each Charstring tn,Charstring cid 
          where cMap(tn,up,cid) 
  begin
   if (isTblOf(JDBCOfDS(DSOfUPV(up)),tn) and 
   notany(primary_keys(jdbcOfDS(DSOfUPV(up)),catalogOfDS(DSOfUPV(up)),schemaOfDS(DSOfUPV(up)),tn)) ) then
	     return genCCV_nokey(up,tn) 
   else if isTblOf(JDBCOfDS(DSOfUPV(up)),tn) then 
	    return genCCV(up,tn) 
   else error("No table named "+tn+" in data source");
  end;

create function genDCCVs(Charstring upv)-> Charstring
  as concatagg(inject(genCCVs(upv)," or "));




create function genPVs(Charstring up)->Bag of Charstring
/*Defines a relational column view for column cn in table tn if:
	- cn is a column of tn
	- cn is a primary key in tn
	- cn is not a foreign key column 
	(neither in o-many nor in many-many relationship
*/
/* as  for each Charstring tn, Charstring cid where cMap(tn,up,cid)
  begin */
   as for each Charstring tn,Charstring cn,Charstring pid  where pMap(tn,cn,up,pid) 
   begin
       if (isColOf(JDBCOfDS(DSOfUPV(up)),tn,cn) 
		/*and notany(isPrKOf(JDBCOfDS(DSOfUPV(up)),catalogOfDS(DSOfUPV(up)),schemaOfDS(DSOfUPV(up)),tn,cn))*/
		and count(primary_keys(jdbcOfDS(DSOfUPV(up)),catalogOfDS(DSOfUPV(up)),schemaOfDS(DSOfUPV(up)),tn))>=1
		and notany(isForKOf(jdbcOfDS(DSOfUPV(up)),catalogOfDS(DSOfUPV(up)),schemaOfDS(DSOfUPV(up)),tn,cn))
		/*and notany(is_in_rMap(up,tn,cn))*/  ) then		
     	return genPV(up,tn,cn)
     else  if  notany(primary_keys(jdbcOfDS(DSOfUPV(up)),catalogOfDS(DSOfUPV(up)),schemaOfDS(DSOfUPV(up)),tn) ) then
	return genPV_nokey(up,tn,cn);
      end;
/*  end;*/


/* Fn for defining a one-to-many relationship view for a foreign key column  mapped to 
 * an RDF property;
 * !!! NOT  generalized for the case of compound keys !!!!
 */
create function genFPV_nocompK(Charstring upv,		
	                Charstring tn,
                        Charstring cn,
                        Charstring otn)->Charstring clause
  as select "(" + genRelcall(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and 
       	rMap('" + tn + "','" +cn +"','"+ otn +"','"+upv +"',p) and
        s = rowID(cid,"+k+") and 
        val = rowID(cMap('" + otn + "','" + upv + "'),{" + tn + "_"+cn+"})  )"
  from Charstring k
  where k = getKeyrr(DSOfUPV(upv),tn);



/* Fn for defining a one-to-many relationship view for a foreign key column  mapped to 
 * an RDF property;
 * !!! Generalized for the case of compound keys !!!!
 */
create function genFPV(Charstring upv,		
	                Charstring tn,
                        Charstring otn)->Charstring clause
  as select "(" + genRelcall(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and 
       	rcMap('" + tn + "','"+ otn +"','"+upv +"',p) and
        s = rowID(cid,"+k+") and 
        val = rowID(cMap('" + otn + "','" + upv + "')," + k2+")  )"
  from Charstring k, Charstring k2
  where k = getKeyrr(DSOfUPV(upv),tn) and
	k2=  getFKeyrr(DSofUPV(upv),tn,otn);



create function genFPV_fk(Charstring upv,		
	                Charstring tn,
                        Charstring cn,
                        Charstring otn)->Charstring clause
  as select "(" + genRelcall(upv,tn) + " and 
        cMap('" + tn + "','" + upv + "', cid) and 
       	rMap('" + tn + "','" +cn +"','"+ otn +"','"+upv +"',p) and
        s = rowID(cid," + k + ") and 
        val = rowID_fk(cMap('" + otn + "','" + upv + "'), tuple(" + tn + "_"+cn+"))  )"
  from Charstring k
  where k = getKeyrr(DSOfUPV(upv),tn);


/* Fn for defining a many-to-many relationship view for pair of foreign key columns 
 */
create function genFMMPV(Charstring upv,		
	                Charstring tn,
                        Vector of Charstring cn1,
			Vector of Charstring cn2,
                        Charstring otn1,
			Charstring otn2)->Charstring clause
  as select "(" + genRelcall(upv,tn) + " and 
        cMap('" + otn1 + "','" + upv + "', cid) and 
        s = rowID(cid,{" +k1 + "}) and 
	rmmMap('" + tn + "',"+cn1+","+cn2+",'" +otn1 +"','" +otn2 +"','"+upv+"',p) and
        val = rowID(cMap('" + otn2 + "','" + upv + "'),{" + k2 + "}) )"
   from Charstring k1, Charstring k2
  where k1 = concat_cols(tn, cn1) and
	k2 = concat_cols(tn, cn2);
 
        



/* Generate one-to-many relationship views for each rMap-mapped relationship 
between tables tn and otn.
 */
create function genFPVs(Charstring up)->Bag of Charstring
  as 
  for each Charstring tn, Charstring cid where cMap(tn,up,cid)
  begin 
   for each Charstring otn,Charstring prop
    where rcMap(tn,otn,up,prop)
   begin
    return genFPV(up,tn,otn);
   end;
  end;

create function genDFPVs(Charstring upv)-> Charstring
  as concatagg(inject(genFPVs(upv)," or "));


/* Generate many-to-many relationship views for each rmmMap-mapped relationship 
among the tables tn, and otn1 and otn2.
 */
create function genFMMPVs(Charstring up)-> Charstring
  as 
    for each Charstring tn,Charstring otn1,Charstring otn2,Vector of Charstring cn1,Vector of Charstring cn2,Charstring prop
	 where rmmMap(tn,cn1,cn2,otn1,otn2,up,prop)
    return genFMMPV(up,tn,cn1,cn2,otn1,otn2);
  

create function genDFMMPVs(Charstring upv)-> Charstring
  as concatagg(inject(genFMMPVs(upv)," or "));



