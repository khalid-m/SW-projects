/*Creates the list of the columns for the tables that are classes*/
as 
 begin
  declare Charstring relvars, Vector tabs;  
  set relvars="";
  for each Charstring tn, Charstring cid  where cMap(tn,upv)=cid 
	set relvars= relvars + ","+rel(upv, tn);
   return substring(relvars,1,char_length(relvars)-1); 
 end;

create function genRelvars2old(Charstring upv)->Charstring relvars
as 
 return concatagg(inject(genRelvars(upv), ","));




