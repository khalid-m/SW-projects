create function genDPV(Charstring upv)->Charstring
  as concatagg(inject(genPVs(upv)," or "));


/* Fn for definition of content view
 */
create function defineCV(Charstring upv)->Boolean
  as
   begin
    eval("create function c" + upv + "()-> 
          (Charstring s,Charstring p,Literal val) 
         as 
          select s,p,val 
          where p" + upv + "() = (s,p,val) or
		cr" + upv +"() = (s,p,val) or
		mmr"+ upv +"() = (s,p,val) or
	        cm" + upv + "()= (s,p,val) ;");
   end;

/* Fn for definition of content view
 */
create function defineDataView(Charstring upv)->Boolean
  as
   begin
    eval("create function dat_" + upv + "()-> 
          (Charstring s,Charstring p,Literal val) 
         as 
          select s,p,val 
          where p" + upv + "() = (s,p,val) or
	        cm" + upv + "()= (s,p,val) ;");
   end;


/* Definition of relationships view: including one-to-many and 
	and many-to-many relationships*/

create function defineRelView(Charstring upv)->Boolean
  as
   begin
    eval("create function rel_" + upv + "()-> 
          (Charstring s,Charstring p,Literal val) 
         as 
          select s,p,val 
          where cr" + upv +"() = (s,p,val) or
		mmr"+ upv +"() = (s,p,val) ;");
   end;


create function genRelvarsPV(Charstring upv )->Charstring
/*Creates the list of the columns for the tables that will be 
included in the p- view*/
as 
 begin
  declare Charstring relvars, Vector tabs;  
  set relvars="";
  for each Charstring tn, Charstring cn, Charstring prop
     where pMap(tn,cn,upv)=prop 
	if ( notany(is_in_rMap(upv,tn,cn)) and  
		notany(isPrKOf(JDBCOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)),tn,cn)) ) then
   begin	
     if (notany(select tabs[i] from integer i where tabs[i]=tn)) then
      begin
	set relvars= relvars + ","+rel(upv, tn);
	set tabs=concat({tn},tabs);	
      end;
   end;
   return substring(relvars,1,char_length(relvars)-1); 
 end;



/* Fn for defining of union of property views
 */
create function defineP(Charstring upv)->Boolean
  as
   begin
    declare Charstring dpv;
    genRelvars(upv);
    set dpv=genDPV(upv);
    if (dpv != "") then
    begin
     eval("create function p" + upv + "()-> 
          (Charstring s,Charstring p,Literal val) 
          as 
           select s,p,val 
           from " + genRelvarsPV(upv) 
                 + ",Charstring cid
           where " + genDPV(upv) + ";");
    end
    else 
    begin
     eval("create function p" + upv + "()-> 
          (Charstring s,Charstring p,Literal val) 
          as 
           select s,p,val where nil;");
    end;
   end;




create function genRelvarsCR(Charstring upv )->Charstring
/*Creates the list of the columns for the tables having FK and tables referencing to FK*/
as 
 begin
  declare Charstring relvars, Vector tabs;  
  set relvars="";
  for each Charstring tn, Charstring otn,Charstring prop
     where rcMap(tn,otn,upv)=prop
  /*for each Charstring tn, Charstring cn,Charstring otn,Charstring prop
     where rMap(tn,cn,otn,upv)=prop*/
   begin
     if (notany(select tabs[i] from integer i where tabs[i]=tn)) then
      begin
	set relvars= relvars + ","+rel(upv, tn);
	set tabs=concat({tn},tabs);	
      end;
    /* if (notany(select tabs[i] from integer i where tabs[i]=otn)) then
    /*  begin	*/
   /*	set relvars = relvars + ","+rel(upv,otn);*/
   /*	set tabs = concat({otn},tabs);	*/
   /*   end;*/
   end;
   return substring(relvars,1,char_length(relvars)-1); 
 end;


create function genRelvarsMMR(Charstring upv )->Charstring
/*Creates the list of the columns for the tables having FK and tables referencing to FK*/
as 
 begin
  declare Charstring relvars, Vector tabs;  
  set relvars="";
  for each Charstring tn, Vector of Charstring cn1,Charstring otn1, Vector of Charstring cn2,Charstring otn2,Charstring prop
     where rmmMap(tn,cn1,cn2,otn1,otn2,upv)=prop
   begin
     if (notany(select tabs[i] from integer i where tabs[i]=tn)) then
      begin
	set relvars= relvars + ","+rel(upv, tn);
	set tabs=concat({tn},tabs);	
      end;
    /* if (notany(select tabs[i] from integer i where tabs[i]=otn)) then
    /*  begin	*/
   /*	set relvars = relvars + ","+rel(upv,otn);*/
   /*	set tabs = concat({otn},tabs);	*/
   /*   end;*/
   end;
   return substring(relvars,1,char_length(relvars)-1); 
 end;

/* Fn for defining union of class membership views
 */
create function defineCM(Charstring upv)->Boolean
  as
   begin
    declare Charstring dccv;
    set dccv=genDCCVs(upv);
    if (dccv != "") then
    begin
     eval("create function cm" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
         as 
          select s,p,val 
          from " + genRelvars2(upv) 
                 + ",Charstring cid
          where " + dccv + ";");
    end
    else 
    begin
     eval("create function cm" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as 
           select s,p,val where nil;");
    end;    
   end;


/* Fn for defining union of one-to-many relationship views.
 */
create function defineCR(Charstring upv)->Boolean
  as
   begin
    declare Charstring dfpv;
    set dfpv=genDFPVs(upv);
    if (dfpv != "") then
    begin
     eval("create function cr" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
         as 
          select s,p,val 
          from " + genRelvarsCR(upv) 
                 + ",Charstring cid
          where " + dfpv + ";");
    end
    else
    begin
     eval("create function cr" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as 
           select s,p,val where nil;");
    end;    
   end;


/* Fn for defining union of many-to-many relationship views.
 */
create function defineMMR(Charstring upv)->Boolean
  as
   begin
    declare Charstring dfpv;
    set dfpv=genDFMMPVs(upv);
    if (dfpv != "") then
    begin
     eval("create function mmr" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
         as 
          select s,p,val 
          from " + genRelvarsMMR(upv) 
                 + ",Charstring cid
          where " + dfpv + ";");
    end
    else
    begin
     eval("create function mmr" + upv + "()-> 
          (Charstring s,Charstring p,Charstring val) 
          as 
           select s,p,val where nil;");
    end;    
   end;

  
create function sdef()->(Charstring,Charstring,Charstring);

create function make_sdef(Charstring upv)->Charstring
/*Contsructs the sdef function*/
as
  eval("create function sdef()-> (Charstring s,Charstring p,Charstring o) 
	as select s,p,o from Charstring s,Charstring p,Charstring o
	where (s,p,o) in s"+upv+"();");


create function defineUPV(Charstring upv)->Boolean
  as
   begin
    eval("create function " + upv + "()->
          (Charstring s,Charstring p,Literal val)
         as
          select s,p,val where s" + upv + "() = (s,p,val) or 
		  	      cr" + upv +"() = (s,p,val) or
			     	mmr"+ upv +"() = (s,p,val) or
	        	       cm" + upv + "()= (s,p,val) or
                               p" + upv + "() = (s,p,val);");
   end;


/* Automatic generation of UPVs with END, END-P. 
 */
create function ViewRDB(Charstring upv)->Boolean 
as
 begin
  declare Boolean pflg;
	
  /* Check if UPV already exists 
   */
  if(notany(functionnamed(upv))) then
  begin

   /* Never use partial evaluation during UPV creation
    * when it is not further investigated 
    */
   /*if (pStat() = true) then
    begin 
     set pflg = true;
     enable_parteval(false);  
    end;*/

   /* Definition of schema view 
    */
   
  SchemaViewMaterialize(upv);
   /* SchemaViewNoMaterialize(upv);*/
   /*SchemaViewNoMaterialize_g(upv);*/

  /*genRelvars(upv);*/

   /* Definition of property views 
    */
   defineP(upv);

/* Definition of one-to-many relationship views 
    */
   defineCR(upv);

/* Definition of many-to-many relationship views 
    */
    defineMMR(upv);

/* Definition of class membership views 
    */
   defineCM(upv);

   /* Definition of content view 
    */

 /*  defineCV(upv); */
  
/*Define relationships view*/
    defineRelView(upv);

/*Define data view*/
    defineDataView(upv);
  
   /* Definition of the UPV 
    */
   defineUPV(upv);

   /* Definition of the SQL UPV 
    */
  /* defineSUPV(upv);*/

   /* Never use partial evaluation during UPV creation
    * when it is not further investigated. 
    */  
   if (pflg = true) then
    begin 
     enable_parteval(true);  
    end;
	
   /* Set name of schema and content view for UPV 
    */
   set swofupv(upv)="s"+upv+"->Charstring.Charstring.Literal";
   set cwofupv(upv)="c"+upv+"->Charstring.Charstring.Literal";

   /*Overload UPV fn dynamically with dummy to patch SparQL parser*/
   eval("create function " + upv + "(Literal lit)->
    (Charstring s, Charstring p) 
   as
    select s, p where " + upv + "()=(s,p,lit);");
    make_sdef(upv);

 end;
 return true;
end;
 