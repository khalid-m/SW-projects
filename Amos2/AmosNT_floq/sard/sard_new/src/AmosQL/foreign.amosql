
/*create_capability('Relational', '=', 'bb','relational-translate-like' );*/



create function import_tableRDB(relational r,
		             charstring catalog_name,
		             charstring schema_name,
		             charstring table_name,
			     charstring typename, 
	           	     boolean updateable,
                             vector supertypes) -> mappedtype mt
as foreign 'import_table_new-------+';


create function import_tableRDB(relational r, 
			     charstring table_name, 
			     boolean updateable)
  -> mappedtype mt
as
select import_tableRDB(r, '', '', table_name, '', updateable, {});



create function import_tableRDB(relational r, charstring table_name)
  -> mappedtype mt
as select import_tableRDB(r, table_name, false);




/* Returns a scan of the columns in the database. table_name_pattern may 
 * include '%' signs as wildcards.
 */
create function columns4(relational r, charstring schema_pattern,
			charstring table_name_pattern, 
 			charstring column_name_pattern)
  -> <charstring column_type, charstring column_name, integer column_size,  Charstring allowed_nulls>
as foreign 'abstract-function';

/* Returns a scan all columns in the database where table_name_pattern matches. 
 * table_name_pattern may include '%' signs as wildcards.
 */
create function columns4(relational r, charstring table_name_pattern) 
  -> <charstring column_type, charstring column_name, integer column_size,  Charstring allowed_nulls>
as select columns4(r, '%', table_name_pattern, '%');


