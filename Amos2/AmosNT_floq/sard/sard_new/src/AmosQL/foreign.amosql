as foreign 'calculate-mon-day';



create function round_tominutes(Real hh)->Charstring
as foreign 'time-round-tominutes';


create function write_triples_asNT(Bag of Vector rowset, Charstring file)
                            -> Charstring
  /* Write tuples in rowset as NT-triples in file */
  as foreign 'write-ntuplesNT--+';

create function write_asCSV(Bag of Vector rowset, Charstring file)
                            -> Charstring
  /* Write tuples in rowset as CSV in file */
  as foreign 'write-ntuplesCSV--+';

