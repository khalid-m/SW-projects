as foreign 'JAVA:executeSQL/columns';



create function bestRowIdent(jdbc ds, Charstring catalog, Charstring schema, Charstring table, Integer scope, Boolean nullable) -> Charstring column_name
as foreign 'JAVA:executeSQL/getBestRowIdent';


create function sql_rowN(jdbc ds, Charstring query) -><Vector,integer>
as foreign 'JAVA:executeSQL/rowNumbQuery';




/* Returns a scan of the columns in the database. table_name_pattern may 
 * include '%' signs as wildcards.
 */
create function columns4(relational r, charstring schema_pattern,
			charstring table_name_pattern, 
 			charstring column_name_pattern)
  -> <charstring column_type, charstring column_name, integer column_size,  Charstring allowed_nulls>
as foreign 'abstract-function';

/* Returns a scan all columns in the database where table_name_pattern matches. 
 * table_name_pattern may include '%' signs as wildcards.
 */
create function columns4(relational r, charstring table_name_pattern) 
  -> <charstring column_type, charstring column_name, integer column_size,  Charstring allowed_nulls>
as select columns4(r, '%', table_name_pattern, '%');

create function pStat()->Boolean as foreign 'p-stat'; /*Johans:Returns true if partial evaluation is enabled (default)*/


lisp;

(defun p-stat(fno)
"To get status of partial evaluation"
 (if *enable-parteval* (osql-result fno t)))

(defun import_table_res-------+ (fno ds catalog-name schema-name table-name 
				 type-name updateable supertypes mtp)
  (let ((mt (import-table-res ds 
			  (convert catalog-name)
			  (convert schema-name)
			  (convert table-name)
			  (or (convert type-name) 
			      (make-mapped-typename ds table-name))
			  (convert updateable)
			  (mapcar #'gettypenamed (convert supertypes)))))
    (osql-result ds catalog-name schema-name table-name
		 type-name updateable supertypes mt)))


;;(defun notnull- (fno x res) (if x (osql-result x)))

(defun notnull- (fno x) (if x (osql-result x)))

(osql "create function optional0(Bag b key, Object o) -> Object r as foreign 'optional--+';")

:osql


create function notnull(Object x) -> Boolean
  as foreign 'notnull-';


create function import_table_res(relational r,
		             charstring catalog_name,
		             charstring schema_name,
		             charstring table_name,
			     charstring typename, 
	           	     boolean updateable,
                             vector supertypes) -> mappedtype mt
as foreign 'import_table_res-------+';

