create function printxmll(bag x)->boolean
as begin 
     for each object o where o in x print(o);
 end; 

create function updt(charstring str)-> charstring as stored;


/* GENERATING QUERY TO CREATE TABLE */
create function string_tablecolumns(charstring t_name) -> charstring as stored;
create function generate_string_tablecolumns(charstring fname1,charstring fname2,charstring ont, charstring t_name) -> charstring
as begin
declare charstring temp ;	
 set temp ="";

for each charstring col_name, charstring typ,charstring primary_key where <typ,col_name> =get_colinfo(fname2,ont,t_name) and primary_key = unique(extract_tablepkey(fname1,ont,t_name))
    if primary_key = col_name then set temp = "primary key (" + primary_key + ")" + ","+ temp;    
for each charstring col_name, charstring typ,charstring primary_key where <typ,col_name> =get_colinfo(fname2,ont,t_name) and primary_key = unique(extract_tablepkey(fname1,ont,t_name))
   begin
      if typ = "string" and col_name != primary_key then set temp = col_name + " " +  "VARCHAR(200)" + "," + temp
	else if typ = "integer" and col_name != primary_key  then set temp = col_name + " " +  "INTEGER" + "," + temp
      else if typ = "string" and col_name = primary_key then set temp = col_name + " " +  "VARCHAR(200) not null" + "," + temp
	else if typ = "integer" and col_name = primary_key  then set temp = col_name + " " +  "INTEGER not null" + "," + temp
      else if typ = "date" and col_name != primary_key then set temp = col_name + " " +  "DATE" + "," + temp
	else if typ = "float" and col_name != primary_key  then set temp = col_name + " " +  "FLOAT" + "," + temp
      else if typ = "date" and col_name = primary_key then set temp = col_name + " " +  "DATE not null" + "," + temp
	else if typ = "float" and col_name = primary_key  then set temp = col_name + " " +  "FLOAT not null" + "," + temp;
      
end;
  set  string_tablecolumns(t_name) = substring(temp, 0 , char_length(temp)-2);
end;

/* CREATING  TABLE*/
create function table_query(Charstring t_name)->Charstring as stored;
create function create_table_query(Charstring t_name)->Charstring
as begin 
  
  set table_query(t_name)= "create table " + t_name + "(" + string_tablecolumns(t_name)+ ")"+ ";";  
 end;


/* GENERATING QUERY'S TO CREATE ALL TABLES */

create function generate_create_table_query(jdbc jd,charstring fname1,charstring fname2,charstring t_name, charstring ont) -> charstring
as begin
	
		generate_string_tablecolumns(fname1,fname2,ont,t_name); 
 		create_table_query(t_name);
		sqlu(jd,table_query(t_name));
		
  	
end;	
