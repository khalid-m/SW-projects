create function string_updatetable(charstring t_name) -> charstring as stored;
create function update_string_updatetable(charstring t_name) -> charstring as begin		
set string_updatetable(t_name)="";
end;

create function generate_string_updatetable(charstring fname1, charstring fname2, charstring ont, charstring t_name,charstring classuri) -> charstring
as begin
declare charstring insert1,charstring insert2,charstring insert3,charstring insert4,charstring val1,charstring val2,charstring val3;
set insert1 ="insert into " + t_name + "(" ;
set insert2 = "";
set insert3 = "";
set insert4 = "";
set val1 = "values (";
set val2 = "";
set val3 = "";
for each charstring col_name, charstring typ,charstring value where  <typ,col_name> = get_colinfo(fname2,ont,t_name) and <col_name,value> = get_valueforclassuri(fname1,ont,classuri)
  begin
   set insert2 = col_name + ","+ insert2;
   if typ = "integer" then set val2 = value + ","+ val2 
   else if typ = "float" then set val2 = value + ","+ val2 	
   else if typ = "string" then set val2 = "'" + value + "'" + ","+val2 
   else if typ = "date" then set val2 = "'"+ value + "'"+","+ val2; 
  end;
set insert2 = substring(insert2,0,char_length(insert2)-2) + ") ";
set val2 = substring(val2,0,char_length(val2)-2) + ");";
set insert3 = insert1+insert2;
set val3 = val1+val2;
set string_updatetable(t_name) = insert3+val3+string_updatetable(t_name) ;
end;


create function updatetable(jdbc jd,charstring fname1,charstring fname2,charstring t_name,charstring ont) -> charstring
as begin
	for each charstring classuri where classuri = get_classURIs(fname1,ont) and like(classuri,"*"+t_name+"*")
		begin
			update_string_updatetable(t_name);
	  		generate_string_updatetable(fname1,fname2,ont,t_name,classuri);
		       sqlu(jd,string_updatetable(t_name));
	  	end;	
    end;


