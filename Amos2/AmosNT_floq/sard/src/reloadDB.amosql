/* FOR GETTING TABLE NAMES */

create function get_tables(charstring fname, charstring ont) -> charstring table 
as 	
	select substring(s,char_length(ont)+char_length(db_name())+1,char_length(s)) 
	from charstring s, charstring p,charstring v, integer i 
	where parseRDF(fname)=<s,p,v,i> and like(v, "*Class");



create function get_tableURIs(charstring fname, charstring ont) -> charstring table 
as 	
	select s
	from charstring s, charstring p,charstring v, integer i 
	where parseRDF(fname)=<s,p,v,i> and like(v, "*Class");


/* FOR GETTING COLUMN URI'S */

create function table_name(Charstring ont,Charstring tableURI)->Charstring 
/*Extract the table name from the table URI*/
as
select substring(tableURI,char_length(ont+ db_name())+1,char_length(tableURI));

 
create function get_columnURIs(charstring fname, charstring ont) -> charstring
as 	
	select s  
	from charstring s, charstring p,charstring v, integer i 
	where parseRDF(fname)=<s,p,v,i> and like(p, "*domain");


create function get_classURIs(charstring fname, charstring ont) -> charstring
as 	
	select s  
	from charstring s, charstring p,charstring v, integer i 
	where parseRDF(fname)=<s,p,v,i> and like(p, "*type");

create function get_valueforclassuri(charstring fname,charstring ont,charstring classuri)-> <charstring col, charstring val>
as
 select substring(pred,char_length(ont)+1+char_length(db_name()),char_length(pred)),obj 
 from charstring sub, charstring pred,charstring obj,integer i where 
 parseRDF(fname) = <sub,pred,obj,i> and like(sub,classuri) and like(pred,"*"+ont+"*");


create function extract_tablepkey(Charstring file, Charstring ont, Charstring table)->Charstring 
/*Extract the primary key for a table*/
as
select k from Charstring k, Charstring value, Charstring classURI where classURI=get_classURIs(file,ont) and get_valueforClassuri(file,ont,classURI)=<k, value> and value=substring(classURI,char_length(ont+db_name()+table)+2, char_length(classURI));


/* FOR GETTING COLUMNS OF ALL TABLES */

create function get_colntable(charstring fname,charstring ont) -> <charstring col,charstring table>
as 
	select substring(s,char_length(ont)+1+char_length(db_name()),char_length(s)), substring(v,char_length(ont)+1+char_length(db_name()),char_length(v))
	from charstring s, charstring p,charstring v, integer i 
	where parseRDF(fname)=<s,p,v,i> and like(p, "*domain") ;

/* FOR GETTING TYPES OF ALL COLUMNS */

create function get_coltyp(charstring fname,charstring ont) -> <charstring typ, charstring col>
as
   select substring(v,4,char_length(v)),substring(s,char_length(ont)+1+char_length(db_name()),char_length(s))
   from charstring s, charstring p,charstring v, integer i  
	where parseRDF(fname)=<s,p,v,i> and like(p, "*#range");


/* FOR GETTING TABLE INFO WITH COLUMNS,TYPES AND TABLE NAME */

create function col_info(charstring fname,charstring ont) -> <charstring typ, charstring col,charstring table>
as
  select typ,col,table
   from charstring typ, charstring col,charstring table
   where <typ,col> = get_coltyp(fname,ont) and <col,table> = get_colntable(fname,ont); 




create function get_colinfo(charstring fname,charstring ont,charstring t_name) -> <charstring typ, charstring col>
as
select typ,col from charstring typ, charstring col
where <typ,col,t_name> = unique(col_info(fname,ont));

