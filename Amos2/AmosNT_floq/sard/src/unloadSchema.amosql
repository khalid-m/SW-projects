create function db_ontology() -> charstring as stored;
create function db_name() -> charstring as stored;
create function db_new_name()-> charstring as stored;/*Get all the tables from the relational database*/
create function table_name_down(jdbc jd) -> Charstring tname
 as
	select t_name from charstring t_name, charstring c2, charstring c3, charstring c4 
	where tables(jd)=<t_name,c2,c3,c4> and c4="TABLE";


create function f_map(Charstring upv, Charstring tname ) -> Boolean
/*Mapping if there are FKs in the table*/
as begin
	for each Charstring c_name, Charstring f_cname, Charstring f_tname
	  where <f_tname, f_cname, c_name> = imported_keys(jdbcofds(dsofupv(upv)), tname)
	begin
	  set rMap(tname, c_name, f_tname, upv)= db_ontology()+db_name()+ "/"+tname+ "#" +tname+ "_"+ f_tname ;
	end;
   end;

create function table_map(Charstring upv) -> Boolean
as begin
 for each Charstring t_name where t_name=table_name_down(jdbcofds(dsofupv(upv)))
	begin
      		assignClassId(t_name, upv, db_ontology()+db_name()+"/" + t_name);
		f_map(upv, t_name);
	end;
 end; 


/*Get the columns info*/

create function column_info_down(jdbc jd) -> <Charstring typ, Charstring column_name, Charstring t_name>
as
	select typ, column_name, t_name from Charstring typ, Charstring column_name, Charstring t_name
	where columns(jd, t_name)=<typ,column_name> and table_name_down(jd)=t_name; 


