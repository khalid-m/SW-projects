      	generate_xmlDomp(classuri);
	end;
end;
*/

create function generate_classXML(charstring classuri)->Charstring
as select c from charstring c where c=xmlDc(classuri) or c=rdfsclassdef() or c=close_descr();

create function generate_propertyXML(charstring propuri,charstring classuri)->Charstring
as select c from charstring c where c=xmlDp(propuri) or c=rdfspropertydef() or c=xmlDomp(classuri) or c = rdfsrangedef(propuri) or  c=close_descr();


create function allclassXML( jdbc jd, charstring file, Charstring upv) -> Bag of charstring
as begin 
   set file = file + "_schema.rdf";
  openwritefile(file);
  generate_header(db_name(),db_ontology());
  printxmll(header());
  for each charstring classuri where classuri=get_classURI(upv)  
   begin
    generate_xmlDc(classuri);
    generate_xmlDomp(classuri);
    printxmll(generate_classXML(classuri));
     for each Charstring propuri where get_classpropURI(classuri, upv)=propuri
	begin
		generate_xmlDp(propuri,classuri);
		generate_rangeforstr(jd, propuri);
		printxmll(generate_propertyXML(propuri, classuri)); 
	end;	
    end;
     printxmll(footer());
   closewritefile();
  end;
