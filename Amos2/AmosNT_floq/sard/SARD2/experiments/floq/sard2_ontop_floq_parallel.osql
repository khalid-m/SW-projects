2/*-*-sql-*-*******************************************************************
 * AMOS2
 *
 * Author: (c) <year> <author>, UDBL
 * $RCSfile: multisql.osql,v $
 * $Revision: 1.7 $ $Date:
 * $State: Exp $ $Locker:  $
 *
 * Description: Script to run SARD2 on top of parrell FLOQ
 ****************************************************************************
 *
 ****************************************************************************/
start javaamos -n
start javaamos -O peer.osql -s u
start javaamos -O peer.osql -s v

javaamos -b sard2.dmp -c me

lisp;
:osql

/* create triple view over the meta database(s) */ 
set :id2="metaDS";
set :url2="jdbc:mysql://localhost:3306/metadb_l";
set :driver2="com.mysql.jdbc.Driver";
set :dbname2="metadb_l";
set :usern2="regress";
set :passw2="regress";
set :catal2="metadb_l";
set :schem2="";

set :upv2="meta";
set :uriOfupv2="http://user.it.uu.se/~udbl/prod";

defineDS(:id2,
         :url2,
         :driver2,
         :catal2,
         :schem2,
         :usern2,
         :passw2);


defineUPV(:id2,:upv2, :uriofupv2);
/*defineUPV(:id,:upv_fn, :uriofupv_fn);*/

DSConnect(:upv2);


assignIDS(:upv2,:catal2,:schem2);

ViewRDB("meta");


<'experiments/floq/bjexp.osql';

/* setting for running in sequence */
/* to get :js for generate source predicate of measuresA */
set :js = jdbcSet(2,"com.microsoft.jdbc.sqlserver.SQLServerDriver");

/* to import the measuresA schema from one of the server regardless the 
   logdb size since they have the same schema */
set :logdb1url = "jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB";

set :logdb2url = "jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB";

connect2(first(:js), :logdb1url, "udbl", "udbl");

connect2(last(:js), :logdb2url, "udbl", "udbl");

/* create triple view over the sensor database(s) */ 
set :id="sensorid";
set :url="jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB";
set :driver="com.microsoft.jdbc.sqlserver.SQLServerDriver";
set :dbname="bm1GB";
set :usern="udbl";
set :passw="udbl";
set :catal="bm1GB";
set :schem="dbo";
/*set :schem="bm1GB";*/



set :upv="sensor";
set :uriOfupv="http://user.it.uu.se/~udbl/sensor";

defineDS(:id,
         :url,
         :driver,
         :catal,
         :schem,
         :usern,
         :passw);


defineUPV(:id,:upv, :uriofupv);

/*Define RDF view mappings*/
set pMap("measuresA","m","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA_m");
set pMap("measuresA","s","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA_s");
set pMap("measuresA","bt","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA_bt");
set pMap("measuresA","et","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA_et");
set pMap("measuresA","mv","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA_mv");
set pMap("measuresA","jdbcuri","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA_jdbcuri");
set cMap("measuresA","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresA"); 
set ucMap("measuresA","sensor")="http://user.it.uu.se/~udbl/sensor/measuresA"; 
set typemap("measuresA","m","sensor")="http://www.w3.org/2001/XMLSchema#int";
set typemap("measuresA","s","sensor")="http://www.w3.org/2001/XMLSchema#int";
set typemap("measuresA","bt","sensor")="http://www.w3.org/2001/XMLSchema#float";
set typemap("measuresA","et","sensor")="http://www.w3.org/2001/XMLSchema#float";
set typemap("measuresA","mv","sensor")="http://www.w3.org/2001/XMLSchema#float";
set typeMap("measuresA","jdbcuri","sensor")="http://www.w3.org/2001/XMLSchema#string";


set pMap("measuresB","m","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB_m");
set pMap("measuresB","s","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB_s");
set pMap("measuresB","bt","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB_bt");
set pMap("measuresB","et","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB_et");
set pMap("measuresB","mv","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB_mv");
set pMap("measuresB","jdbcuri","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB_jdbcuri");
set cMap("measuresB","sensor")=uri("http://user.it.uu.se/~udbl/sensor/measuresB"); 
set ucMap("measuresB","sensor")="http://user.it.uu.se/~udbl/sensor/measuresB"; 
set typemap("measuresB","m","sensor")="http://www.w3.org/2001/XMLSchema#int";
set typemap("measuresB","s","sensor")="http://www.w3.org/2001/XMLSchema#int";
set typemap("measuresB","bt","sensor")="http://www.w3.org/2001/XMLSchema#float";
set typemap("measuresB","et","sensor")="http://www.w3.org/2001/XMLSchema#float";
set typemap("measuresB","mv","sensor")="http://www.w3.org/2001/XMLSchema#float";
set typeMap("measuresB","jdbcuri","sensor")="http://www.w3.org/2001/XMLSchema#string";

DSConnect(:upv);

defineP(:upv,:js);

/* ViewRDB(:upv);*/

create function floqview()->(literal,Literal,Literal)
as
	select s,p,o from Literal s, Literal p, Literal o
	where (s,p,o) in psensor() or
	       (s,p,o) in meta();

set :idf="floqid";
set :urif= "http://user.it.uu.se/~udbl/federatedsensor";
set upv("floqview")=<:idf,:urif>;



/* mapping sensor DBs uri to peer name */
set   mappinguri_peer("jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB")='u';
set mappinguri_peer("jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB")='v';

/************************** peers setup for paralization ***************************/
/* peer u */
/* in peer u, call jdbc function */
set :u= call_function('u','jdbc', {"A","com.microsoft.jdbc.sqlserver.SQLServerDriver"}, 10)[0];

/* populating the mapping */
call_function('u','pop_uri_jdbc',{"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB",:u},10);


/* peer v */
/* in peer v, call jdbc function */
set :v= call_function('v','jdbc', {"B","com.microsoft.jdbc.sqlserver.SQLServerDriver"}, 10)[0];

/* populating the mapping */
call_function('v','pop_uri_jdbc',{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB",:v},10);

/* it is different from cases, connect different logdb sizes */
/* set to connect to bm1GB */
set :logDBuri1="jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB";

set :logDBuri2="jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB";

/* connect to bm1GB */
connectlogdb({'u','v'}, {:u, :v}, {:logDBuri1, :logDBuri2}, {"udbl", "udbl"},
             {"udbl", "udbl"});

/*********************** start rewrite ******************************/
lisp;
(setq _rewrite_filter_ t)
(setq *use-dnf* t)
(setq *enable-parallel* t)

:osql
set_bijective_function("USTR_LITERAL", true);
set_bijective_function("rowid_uri", true);
set_bijective_function("USTR", true);

	
set :q4=
	"SELECT ?ma ?bt ?et
	FROM <http://user.it.uu.se/~udbl/federatedsensor>
	WHERE { ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_mv> ?o1 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/ev> ?o2 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/th> ?o3 .
		FILTER ( ?o1 > ?o2 + ?o3) .
		?s4 <http://user.it.uu.se/~udbl/prod#location/lid> ?o4 .
		?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/locatedat> ?o4 .
		?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/mi> ?o5 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?o5 .
		?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/m> ?o6 .
		?s6 <http://user.it.uu.se/~udbl/prod#machine/m> ?o6 .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_s> ?o7 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/si> ?o7 .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_m> ?ma .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?ma .
		?s4 <http://user.it.uu.se/~udbl/prod#location/uri> ?o9 .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_jdbcuri> ?o9 . 
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_bt> ?bt .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_et> ?et }";

eval("create function q4()-> (Literal,Literal,Literal)
	as " + sparql_translate(:q4));

set :q41=
	"SELECT ?ma ?bt ?et ?o9
	FROM <http://user.it.uu.se/~udbl/federatedsensor>
	WHERE { ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_mv> ?o1 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/ev> ?o2 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/th> ?o3 .
		FILTER ( ?o1 > ?o2 + ?o3) .
		?s4 <http://user.it.uu.se/~udbl/prod#location/lid> ?o4 .
		?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/locatedat> ?o4 .
		?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/mi> ?o5 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?o5 .
		?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/m> ?o6 .
		?s6 <http://user.it.uu.se/~udbl/prod#machine/m> ?o6 .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_s> ?o7 .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/si> ?o7 .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_m> ?ma .
		?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?ma .
		?s4 <http://user.it.uu.se/~udbl/prod#location/uri> ?o9 .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_jdbcuri> ?o9 . 
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_bt> ?bt .
		?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_et> ?et }";

eval("create function q41()-> (Literal,Literal,Literal,Literal)
	as " + sparql_translate(:q41));




set :q5=
     "SELECT ?ma ?bt ?et
     FROM <http://user.it.uu.se/~udbl/federatedsensor>
     WHERE { ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_mv> ?o1 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/ev> ?o2 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/th> ?o3 .
         FILTER ( ?o1 > ?o2 + ?o3*0.75) .
         ?s4 <http://user.it.uu.se/~udbl/prod#location/lid> ?o4 .
         ?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/locatedat> ?o4 .
         ?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/mi> ?o5 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?o5 .
         ?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/m> ?o6 .
         ?s6 <http://user.it.uu.se/~udbl/prod#machine/m> ?o6 .
         ?s6 <http://user.it.uu.se/~udbl/prod#machine/mmname> ?mmname .
         FILTER (?mmname in ('MoriSeiki 5205', 'MoriSeiki 5305', 'MoriSeiki 5405', 'MoriSeiki 5505')) .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_s> ?o7 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/si> ?o7 .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_m> ?ma .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?ma .
         ?s4 <http://user.it.uu.se/~udbl/prod#location/uri> ?o9 .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_jdbcuri> ?o9 .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_bt> ?bt .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_et> ?et }";

eval("create function q5()-> (Literal,Literal,Literal)
     as " + sparql_translate(:q5));


set :q51=
     "SELECT ?ma ?bt ?et
     FROM <http://user.it.uu.se/~udbl/federatedsensor>
     WHERE { ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_mv> ?o1 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/ev> ?o2 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/th> ?o3 .
         FILTER ( ?o1 > ?o2 + ?o3*0.75) .
	 FILTER (?bt in ('sss', 'aaaa')) .
         ?s4 <http://user.it.uu.se/~udbl/prod#location/lid> ?o4 .
         ?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/locatedat> ?o4 .
         ?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/mi> ?o5 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?o5 .
         ?s5 <http://user.it.uu.se/~udbl/prod#machineinstallation/m> ?o6 .
         ?s6 <http://user.it.uu.se/~udbl/prod#machine/m> ?o6 .
         ?s6 <http://user.it.uu.se/~udbl/prod#machine/mmname> ?mmname .
         FILTER (?mmname in ('MoriSeiki 5205', 'MoriSeiki 5305', 'MoriSeiki 5405', 'MoriSeiki 5505')) .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_s> ?o7 .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/si> ?o7 .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_m> ?ma .
         ?s2 <http://user.it.uu.se/~udbl/prod#sensorinstallation/mi> ?ma .
         ?s4 <http://user.it.uu.se/~udbl/prod#location/uri> ?o9 .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_jdbcuri> ?o9 .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_bt> ?bt .
         ?s1 <http://user.it.uu.se/~udbl/sensor/measuresA_et> ?et }";

eval("create function q51()-> (Literal,Literal,Literal)
     as " + sparql_translate(:q51));
