/* maps logdburi to jdbc object and used in query in sequence */
create function logdburi_js(Object)->JDBC as stored; 


/* create n jdbc connection objects and used in query in sequence */
create function jdbcSet(Number n, Charstring driver)
                       -> Bag of Jdbc
  as jdbc("C"+iota(1,n), driver);

/********************* used in query in sequence ******************/
/* connect to jdbc datasource and map the uri to jdbc datasource */
create function connect2(Jdbc ds1, Charstring uri, 
                           Charstring user_name, Charstring password)->Jdbc ds2
  as begin 
          connect(ds1, uri, user_name, password);
          set logdburi_js(uri)=ds1;
     end;


/* connect each jdbc object with a data source with different db name */
/* and used in query in sequence */
create function openJdbcSet(Bag of Jdbc js,
                            Charstring dburl, Bag of Charstring dbs,
                            Charstring user, Charstring pw)
                          -> Bag of Jdbc
  as for each Jdbc j, Charstring db 
     where j in js and db in dbs 
     begin
         return connect(j, dburl+db, user, pw);
     end;


/* disconnect given database connections */
/* and used in query in sequence */
create function closeJdbcSet(Bag of Jdbc js) -> Bag of Jdbc
  as for each Jdbc j where j in js 
     begin disconnect(j);
           return j;
     end;

/* utility functions */
create function transformvec(vector inputvarsvec)->(object, vector) as foreign 'transinvec-++';

create function formargfrombag(bag)->vector as foreign 'formargfrombag-+';

create function vectorBag(Vector v) -> Bag of Charstring
  as select v[i] 
     from Integer i;

/******************* used in multicastreceive3 *********************/
/* mapping database uri to peer name */
/* It is used for mapping to get peer name. It is the same for different size 
   of logdb since i stored only 1Gb uri in metadb */
create function mappinguri_peer(Charstring uri)->Charstring as stored;


/* new definition with inputvarpovec as extra argument*/
/* and used in query in parallel */
/* mapping logdb uri to peer name and forming peer vector and query argument 
   vector for multicastreceive */
create function multicastreceive3(Vector uris, Charstring fn, Charstring query, 
                                         Vector args, Vector of number inputvarposvec)->Bag of Object
  as begin
     declare vector peervec, vector argvec, Charstring pe, Charstring logdburi;
     set peervec={};
     set argvec={};
     for each integer i where i in iota(0, dim(uris)-1)
       begin
       set logdburi=uris[i];
       set pe=mappinguri_peer(logdburi);
        if pe then
          begin
          set peervec=concat(peervec, {pe}); 
          set argvec=concat(argvec, {{logdburi, query, args[i], inputvarposvec}});
          end;
       end;
     if dim(peervec) >= 1 then
     return multicastreceive(peervec, fn, argvec);
     end;



/* and used in query in parallel */
/* mapping logdb uri to peer name and forming peer vector and query argument 
   vector for multicastreceive */
create function multicastreceive3_old(Vector uris, Charstring fn, Charstring query, 
                                         Vector args)->Bag of Object
  as begin
     declare vector peervec, vector argvec, Charstring pe, Charstring logdburi;
     set peervec={};
     set argvec={};
     for each integer i where i in iota(0, dim(uris)-1)
       begin
       set logdburi=uris[i];
       set pe=mappinguri_peer(logdburi);
        if pe then
          begin
          set peervec=concat(peervec, {pe}); 
          set argvec=concat(argvec, {{logdburi, query, args[i]}});
          end;
       end;
     if dim(peervec) >= 1 then
     return multicastreceive(peervec, fn, argvec);
     end;

/* multi_sql_union is the same as sql */
/* for query logdb in sequence, takes logdbid, query, and parameters */ 
create function multi_sql_union(Object logdburi, Charstring query, 
                                Vector params) -> Vector
  as select sql(logdburi_js(logdburi), query, params);




/* procedure to import tables from metaDB */
create function importmetatable(jdbc js, charstring dburi, 
                                charstring username, charstring password,
                                vector of charstring tables)->boolean
as begin declare integer i, integer numoftable; 
         set i =0;
	 set numoftable=dim(tables);
        connect(js, dburi, username, password);
        while i < numoftable
        do 
        import_table(js, tables[i]);
        set i = i+1;
        end while;
   end;



< 'experiments/floq/patch.osql';



create function rel(Charstring upv, Charstring tn)->Charstring
as
 begin
    declare Charstring relvars, integer i, integer j,Vector column;
    set column=vectorOf(columns(JDBCOfDS(DSOfUPV(upv)),tn ));
    set i=0;set j=0;
    set relvars="";
     for each Charstring cctype where cctype=name(result_types(theresolvent(tn+"_CC") ))	
   /* for each Charstring cctype where cctype=name(result_types(theresolvent("sql:"+tn) ))*/	
      begin
        declare vector v;
	if (j=0) then
		set relvars=relvars + cctype+ " "+ tn+"_jdbcuri, "
        else
	  begin
		set v=column[i];
		set relvars=relvars + cctype+ " "+ tn+"_" + v[1]+",";
		set i=i+1;
	  end;
	set j=j+1;
      end;   
    /*if(relvars = "") then
     error("Could not extract any columns from table " + tn);*/
    /*return relvars;*/
    return substring(relvars,0,char_length(relvars)-2); 
 end;



/* SARD2 function changed to use import_table2 instead of import_tabel*/
create function genRelvars(Charstring upv, Bag of Jdbc srcs)-> Charstring
as
 begin
  for each Charstring tn 
    where (tn,catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)), "TABLE") in
         tables(jdbcOfDS(DSOfUPV(upv)))
   begin
    declare Charstring relvars;
    /* if (notany(functionnamed("sql:"+tn))) then*/
     if (notany(functionnamed(tn + "_cc"))) then
      begin
      if( some(primary_keys(jdbcOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),schemaOfDS(DSOfUPV(upv)),tn)) ) then
        begin
    	 import_table2(JDBCOfDS(DSOfUPV(upv)),catalogOfDS(DSOfUPV(upv)),
                        schemaOfDS(DSOfUPV(upv)),tn,'',false,{},srcs);
	 set relvars=rel(upv,tn);
        end  
      end;
     if(relvars = "") then
    	 error("Could not extract any columns from table " + tn);
    return relvars;    
  end;
 end;


create function genRelcall(Charstring upv,
	                    Charstring rname)->Charstring r
as
 begin
  declare Charstring relcall, Charstring n;
  set n= concatagg(inject((select rname + "_" + cname 
                                from Charstring cname, Charstring ctype 
                                where (ctype, cname) in 
                                       columns(JDBCOfDS(DSOfUPV(upv)), 
                                        rname)), ","));
   set relcall = rname+ "_cc()=("+ rname + "_jdbcuri" + ","+ n + ")" ;
  if (relcall="") then
   error("Could not extract any columns from table " + rname);  
  return relcall;
 end;

  /*set relcall="sql:"+rname+"()=("+ rname + "_jdbcuri" + "," + n+ ")"; */



create function genPVs_js(Charstring up)->Bag of Charstring
/*Defines a relational column view for column cn in table tn if:
	- cn is a column of tn
	- cn is a primary key in tn
	- cn is not a foreign key column 
	(neither in o-many nor in many-many relationship
*/
as 
   for each Charstring tn, URI cid where cMap(tn,up,cid)
     if (count(primary_keys(jdbcOfDS(DSOfUPV(up)),catalogOfDS(DSOfUPV(up)),schemaOfDS(DSOfUPV(up)),tn))>=1) then
      for each Charstring tn,Charstring cn,URI pid where pMap(tn,cn,up,pid) 
   	begin
       	  if (isColOf(JDBCOfDS(DSOfUPV(up)),tn,cn) or cn="jdbcuri" ) then
	      if ( isStringType(tn,cn,up) or cn="jdbcuri" ) then		
	     	return genPV_strings(up,tn,cn) 
 	      else return genPV_nostrings(up,tn,cn)
        end;

create function genDPV_js(Charstring upv)->Charstring
  as concatagg(inject(genPVs_js(upv)," or "));


create function defineP(Charstring upv,Bag of Jdbc srcs)->Boolean
  as
   begin
    declare Charstring dpv;
    genRelvars(upv,srcs);
    set dpv=genDPV_js(upv);
    if (dpv != "") then
    begin
     eval("create function p" + upv + "()-> 
          (URI s,URI p,Literal val) 
          as 
           select s,p,val 
           from " + genRelvarsPV(upv) 
                 + ",Charstring ucid
           where " + genDPV_js(upv) + ";");
    end
    else 
    begin
     eval("create function p" + upv + "()-> 
          (URI s,URI p,Literal val) 
          as 
           select s,p,val where nil;");
    end;
   end;

