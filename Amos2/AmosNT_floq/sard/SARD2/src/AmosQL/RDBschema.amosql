create function wrapRDB(Jdbc j,Charstring dbname, Charstring catalog, Charstring schema)->Boolean
/*Populates the database schema*/
as
 begin
  declare integer tonum;
  set tonum=0;
  for each Charstring tabname 
  where (tabname, catalog, schema, "TABLE") in tables(j)
		begin
			declare table tt;
			create table(tname) instances tt(tabname);
			setURI(tt,dbname, tabname);
		
         		for each Charstring typ,Charstring colname, Integer size, Charstring anull where columns4(j,tabname)=(typ,colname, size, anull)
	        	   begin
				 declare column cc;
				 create column(tableOf,datatype,cname,size,nullable) instances cc (tt,typ,colname,size,anull);
				/* setURI(cc,dbname, tabname + "_" +colname);*/

				 setURI(cc,dbname,tabname+"/"+colname);
										
		           end;
			primaryRDB(j, dbname,tabname,catalog, schema);
			foreignRDB(j, dbname,tabname,schema,catalog);
		end;
    end;


