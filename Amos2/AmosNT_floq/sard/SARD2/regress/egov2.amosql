	(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse"] #[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEventID"] #[USTR "movinghouse"]) 
	(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse"] #[URI "http://udbl.it.uu.se/schemas/eGovern#lifeev_country"] #[URI "http://udbl.it.uu.se/schemas/eGovern#EUcountry/_italy"]) 
	(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse"] #[URI "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"] #[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent"]))
  )

