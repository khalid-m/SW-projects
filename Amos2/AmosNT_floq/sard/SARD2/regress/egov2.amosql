	(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob"] #[URI "http://purl.org/dc/elements/1.1/description"] #[USTR "A citizen from one EU country intends to look for a job in another EU country ."]) 
	(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob"] #[URI "http://purl.org/dc/elements/1.1/language"] #[USTR "EN"]) 
