/* Load regression setup  
 */		
<'egov_setup.amosql';
/* Generate the UPV according to END-P
 */
ViewRDB("EGov");

lisp;
(setq _rewrite_filter_ t);;to put FILTER correct
:osql

/*
lisp;
(setq _gct_ t);;to apply GCT 
(setq _unif_ t);;to normalize variable names in a DNF RDB predicate 
(setq _elcon_ifnounif_ t);; to rewrite { * * ?s. ?s ?p ?o }
(setq _rewrite_filter_ t);;to put FILTER correct
(setq _is_Literal_ t);;to activate rewrite is_Literal 
(setq _type_Match_ t);; to activate rewrite Type-match
:osql
*/

/* SPARQL queries 
 */
set :sparql_schema_1 = 
"SELECT ?lifeeventprop
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?lifeeventprop <http://www.w3.org/2000/01/rdf-schema#domain> 
		<http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
 FILTER	(?lifeeventprop != <http://purl.org/dc/elements/1.1/identifier>) .
 FILTER (?lifeeventprop != <http://udbl.it.uu.se/schemas/eGovern#lifeev_country> ).}";

set :sparql_content_1 = 
"SELECT ?val1 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/title> ?val1 .
        ?s1 <http://purl.org/dc/elements/1.1/description> ?val2 .}";

set :sparql_content_11 = 
"SELECT ?val1 ?s1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/title> ?val1 .
        ?s <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .}";



set :sparql_hybrid_1 = 
"SELECT ?s2 ?p ?val3
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/description> ?val1 .
        ?s2 <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .
        ?p <http://www.w3.org/2000/01/rdf-schema#domain> <http://udbl.it.uu.se/schemas/eGovern#Form> .
        ?s2 ?p ?val3 .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#FormID>) .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#liveeventform>) .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#Concern>) .
 FILTER REGEX (?val1, '.*move.*') .}";

set :sparql_hybrid_2 = 
"SELECT ?s2 ?p ?val3
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/description> ?val1 .
        ?s2 <http://udbl.it.uu.se/schemas/eGovern#Concern> ?s1 .
        ?p <http://www.w3.org/2000/01/rdf-schema#domain> 
         <http://udbl.it.uu.se/schemas/eGovern#Form> .
        ?s2 ?p ?val3 .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#parag>) .
 FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#LifeEventID>) .
 FILTER (?p != <http://purl.org/dc/elements/1.1/description>) .
 FILTER REGEX (?val1, '.*move.*') .}";


set :sparql_union1=
"SELECT ?s1 ?val1 ?val2 
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE { {?s1 <http://purl.org/dc/elements/1.1/description> ?val1} 
	 UNION
	{?s1 <http://udbl.it.uu.se/schemas/eGovern#parag> ?val2 } }";


set :sparql_union2=
"SELECT ?s1 ?val1  
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE { {?s1 <http://purl.org/dc/elements/1.1/description> ?val1} 
	 UNION
	{?s1 <http://udbl.it.uu.se/schemas/eGovern#parag> ?val1 } }";



set :sparql_union3=
"SELECT ?s1 ?p ?val
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE { ?s1 ?p ?val.
       {FILTER (?p = <http://purl.org/dc/elements/1.1/description> ) }
        UNION
       {FILTER (?p = <http://udbl.it.uu.se/schemas/eGovern#parag> ) }   }"; 


set :sparql_union33=
"SELECT ?s1 ?p ?val
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE { ?s1 ?p ?val.
       {FILTER REGEX (str(?p), '*description') }
        UNION
       {FILTER REGEX (str(?p), '*parag') }   }"; 




set :sparql_cont2 = 
"SELECT ?s1 ?p2 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
	FILTER (?p2 != <http://udbl.it.uu.se/schemas/eGovern#country> ) .
        ?s1 ?p2 ?val2 .}";



set :sparql_cont22 = 
"SELECT ?s1 ?p2 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {{?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
         ?s1 ?p2 ?val2 .}
	UNION
	{?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#Form> .
         ?s1 ?p2 ?val2 .} }";



set :sparql_cont3 = 
"SELECT ?s1 ?s2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
        ?s1 <http://udbl.it.uu.se/schemas/eGovern#lifeev_country> ?s2 .}";

set :sparql_cont33 = 
"SELECT ?s ?p ?s1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#EUcountry> .
        ?s ?p ?s1 .}";



set :sparql_cont4 = 
"SELECT ?s1 ?p2 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
        ?s1 <http://udbl.it.uu.se/schemas/eGovern#lifeev_country> <http://udbl.it.uu.se/schemas/eGovern#EUcountry/_italy> .
	?s1 ?p2 ?val2.
 { FILTER (?p2=<http://udbl.it.uu.se/schemas/eGovern#lifeev_country>) }
UNION
 { FILTER (?p2=<http://udbl.it.uu.se/schemas/eGovern#parag> )} }";



set :sparql_cont44 = 
"SELECT ?s1 ?p2 ?val2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://udbl.it.uu.se/schemas/eGovern#LifeEvent> .
        ?s1 <http://udbl.it.uu.se/schemas/eGovern#ResponsibleCountry> <http://udbl.it.uu.se/schemas/eGovern#EUcountry/_italy> .
	?s1 ?p2 ?val2.
 FILTER REGEX (?p2, '.*description.*'). }";





set :sparql_content_6 = 
"SELECT ?s1 ?p1 ?val1 
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 <http://purl.org/dc/elements/1.1/title> 'Job' .
        ?s1 ?p1 ?val1 .}";



set :sparql_cont7 = 
"SELECT ?s ?p ?val 
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s ?p ?val .
 FILTER REGEX (?s, '.*eGovern#EUcountry.*'). 
 FILTER REGEX (?val, 'lev').}";


set :sparql_cont7 = 
"SELECT ?s ?p ?val 
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s ?p ?val .
  FILTER REGEX (?val, 'lev').}";


set :sparql_cont8 = 
"SELECT ?s ?p ?val 
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s ?p ?val .
 FILTER (?s = <http://udbl.it.uu.se/schemas/eGovern#EUcountry/_bulgaria>).}";


set :sparql88 = 
"CONSTRUCT { ?s ?p ?s1 }
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s  ?p ?s1 .
	?s1 <http://udbl.it.uu.se/schemas/eGovern#lifeev_country> ?o .
	FILTER (?o= <http://udbl.it.uu.se/schemas/eGovern#EUcountry/_italy>). }";


set :sparql_cont9 = 
"SELECT ?s ?p ?val 
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s ?p ?val .}";


set :sparql_10 = 
"SELECT ?s1 ?s2
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1 ?s2 <http://udbl.it.uu.se/schemas/eGovern#EUcountry/_germany> }";


set :sparql11=
"SELECT ?s1 ?val1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1  <http://purl.org/dc/elements/1.1/title> ?val1 . 
	 FILTER (?val1 != 'Job') } ";

set :sparql11_2= "SELECT ?s1 ?p1 ?val1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1  ?p1 ?val1 . 
	 FILTER REGEX (?val1, 'Job') } ";


set :sparql12=
"SELECT ?s1 ?val1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1  <http://udbl.it.uu.se/schemas/eGovern#NumberOfFields> ?val1 . 
	 FILTER (?val1 > 25) } ";


set :sparql133=
"SELECT ?s1 ?p1 ?val1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1  ?p1 ?val1 . 
	 FILTER (?s1 = <http://udbl.it.uu.se/schemas/eGovern#Form/_fid0> ).
	FILTER REGEX (?val1, 'Sweden') }";

set :sparql134=
"CONSTRUCT {?s ?p ?o }
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {<http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse>  ?rel ?s .
	?s ?p ?o . } ";



set :sparql13=
"SELECT ?s1 ?p1 ?val1
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s1  ?p1 ?val1 . 
	FILTER REGEX (?val1, '*Sweden*') }";

set :sparql14=
"SELECT ?s ?p ?o
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {?s  <http://udbl.it.uu.se/schemas/eGovern#NumberOfFields> 129 . 
	?s ?p ?o .
	FILTER (?p != <http://udbl.it.uu.se/schemas/eGovern#liveeventform> ) } ";

set :sparql15=
"CONSTRUCT { ?s ?p ?o }
 FROM <http://udbl.it.uu.se/upv/eGov/>
 WHERE {<http://udbl.it.uu.se/schemas/eGovern#Form/_fid0> ?rel ?s .
	?s ?p ?o .} ";



/* Defining the results of and evaluating the example queries
 */
lisp;

(defglobal _schema_1_res_ 
  (sorttuples  '((#(#[URI "http://purl.org/dc/elements/1.1/description"]))
		(#(#[URI "http://purl.org/dc/elements/1.1/language"]))
 		(#(#[URI "http://purl.org/dc/elements/1.1/title"]))
 		(#(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEventID"]))
 		(#(#[URI "http://udbl.it.uu.se/schemas/eGovern#country"]))
 		(#(#[URI "http://udbl.it.uu.se/schemas/eGovern#parag"])))))


 
(defglobal _hybrid_1_res_ 
  '((#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://udbl.it.uu.se/schemas/eGovern#forms_of_thelifeevents"] #[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_movinghouse"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields"] 25))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid1"] #[URI "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields"] 129))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid2"] #[URI "http://udbl.it.uu.se/schemas/eGovern#NumberOfFields"] 59))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://www.egov_project.org/GovMLSchema#Creator"] #[USTR "National Tax Board of Sweden"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid1"] #[URI "http://www.egov_project.org/GovMLSchema#Creator"] #[USTR "National Tax Board of Sweden"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid2"] #[URI "http://www.egov_project.org/GovMLSchema#Creator"] #[USTR "http://www.workpermit.com"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid0"] #[URI "http://udbl.it.uu.se/schemas/eGovern#URL"] #[USTR "http://www.skatteverket.se/etjanster/skrivutpersonbevis.4.18e1b10334ebe8bc80001262.html"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid1"] #[URI "http://udbl.it.uu.se/schemas/eGovern#URL"] #[USTR "http://www.skatteverket.se/download/18.3dfca4f410f4fc63c86800010627/7665B5.pdf"]))
 (#(#[URI "http://udbl.it.uu.se/schemas/eGovern#Form/_fid2"] #[URI "http://udbl.it.uu.se/schemas/eGovern#URL"] #[USTR "http://www.workpermit.com/uk/employer_form.htm"]))))
  

