:osql
/* Regression test
 */
lisp;
(checkequal "SparQL schema query 1 with END-P"
	    ((sorttuples (osql "sparql(:sparql_schema_1);"))
	     _schema_1_res_))


(checkequal "SparQL hybrid query 1 with END-P"
	    ((sorttuples (osql "sparql(:sparql_hybrid_1);"))
	     (sorttuples _hybrid_1_res_)))


(checkequal "Schemaless unbound-property query 2 (with REGEX on s  ) "
	    ((sorttuples (osql "sparql(:sparql_cont8);"))
	     (sorttuples _cont8_)))



(checkequal "Union query 1, 2 blocks, diff variables "
	    ((sorttuples (osql "sparql(:sparql_union1);"))
	    (sorttuples _union1_)))


(checkequal "Union query 2, 2 blocks, same variables "
	    ((sorttuples (osql "sparql(:sparql_union2);"))
	     (sorttuples _union2_)))


:osql
eval("create function sparql_cont2()-><Literal,Literal,Literal> as " + sparql_translate(:sparql_cont2)); 
eval("create function sparql_cont3()-><Literal,Literal> as " + sparql_translate(:sparql_cont3)); 
eval("create function sparql_cont33()->(Literal,Literal,Literal) as " + sparql_translate(:sparql_cont33)); 
eval("create function sparql_cont4()-><Literal,Literal,Literal> as " + sparql_translate(:sparql_cont4)); 
eval("create function sparql_cont8()-><Literal,Literal,Literal> as " + sparql_translate(:sparql_cont8)); 
eval("create function sparql_union3()-><Literal,Literal,Literal> as " + sparql_translate(:sparql_union3)); 
eval("create function sparql_union33()-><Literal,Literal,Literal> as " + sparql_translate(:sparql_union33)); 


lisp;


(checkequal "SparQL unbound-property query 1 - GCT"  
	    ((sorttuples (osql "remove_null(sparql_cont2());"))
	     (sorttuples _cont2_)))


