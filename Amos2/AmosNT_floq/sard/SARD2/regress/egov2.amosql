	(#[URI "http://udbl.it.uu.se/schemas/eGovern#LifeEvent/_eujob"] #[URI "http://udbl.it.uu.se/schemas/eGovern#lifeev_country"] #[URI "http://udbl.it.uu.se/schemas/eGovern#EUcountry/_germany"]) 
