set :a = jdbc("myds", "com.mysql.jdbc.Driver");
set :dburl = "jdbc:mysql://localhost:3306/";

connect(:a, :dburl + "example", "sard", "sard");

sql(:a, 'drop table if exists RELATEDSERVICES');
sql(:a, 'drop table if exists AUTHORS');
sql(:a, 'drop table if exists CUSTOMER');
sql(:a, 'drop table if exists LIFEEVENT');
sql(:a, 'drop table if exists BOOKS');
sql(:a, 'drop table if exists ORDERS1');
sql(:a, 'drop table if exists ORDER_ITEMS');
sql(:a, 'drop table if exists FAQLISTS');
sql(:a, 'drop table if exists BUS');
sql(:a, 'drop table if exists CROSS_RATE');



sql(:a, 'create table CUSTOMER(CUSTID integer not null,
		      MKTSEGMENT varchar(10),
		      primary key (CUSTID))') ;

sql(:a, 'create table LIFEEVENT(EID varchar(25) not null,
			LANG varchar(25),
			DESCR varchar(25),
			LAW varchar(25),
			FORM varchar(50),
			primary key (EID))');

sql(:a, 'CREATE TABLE BOOKS(
	BOOK_ID INTEGER  NOT NULL, 
	AUTHOR_ID INTEGER, 
	TITLE1 VARCHAR(200), 
	DESCRIPTION VARCHAR(200), 
	PRICE INTEGER, 
	PAGES1 INTEGER, 
	PRIMARY KEY(BOOK_ID))');

sql(:a, 'CREATE TABLE ORDERS1(
	ORDER_ID INTEGER NOT NULL,
	BYER_NAME VARCHAR(100),
	SHIPPING_ADRESS VARCHAR(100),
	SHIPPING_ZIPCODE VARCHAR(10),
	SHIPPING_CITY VARCHAR(30),
	PRIMARY KEY(ORDER_ID))');

sql(:a, 'CREATE TABLE ORDER_ITEMS(
	ORDER_ITEM_ID INTEGER NOT NULL,
	ORDER_ID INTEGER,
	BOOK_ID INTEGER,
	QUANTITY INTEGER,
	PRIMARY KEY(ORDER_ITEM_ID))');

sql(:a, 'CREATE TABLE cross_rate
(
    from_currency   VARCHAR(10) NOT NULL,
    to_currency     VARCHAR(10) NOT NULL,
    conv_rate       FLOAT NOT NULL,	
    update_date     DATE,
    snum	    INTEGER,
    PRIMARY KEY (from_currency, to_currency))' );

sql(:a, 'CREATE TABLE bus
(
    snum1   VARCHAR(10),
    name   VARCHAR(10) NOT NULL,
    PRIMARY KEY (name))');

sql(:a, 'create table FAQLISTS(EID varchar(25) not null,
			FAQNR integer not null,
			QUESTION varchar(50),
			NUMBER varchar(25),
			primary key (EID,FAQNR))');


sql(:a, 'create table RELATEDSERVICES (EID varchar(25) not null,
				       SERVICENR integer not null,
				       NAME varchar(50),
				       constraint eid_pk primary key (EID))');

sql(:a, 'CREATE TABLE AUTHORS(AUTHOR_ID INTEGER NOT NULL, 
			      NAME VARCHAR(50),
			      SURNAME VARCHAR(50),
			      constraint id_pk PRIMARY KEY(AUTHOR_ID) )');

