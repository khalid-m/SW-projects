 root_generate_wrapper("t.root","ATLFAST","h51");
/*commit;*/
select Kfele(p),Nele(p) from H51_ATLFAST p where Id(p)=3;
select Nele(p) from h51_atlfast p where Id(p)=3;

 vectorof(root_columnnames_all("t.root","ATLFAST","h51"));  
 create_root_ccfn("t.root","ATLFAST","h51");
select Nele(p),Id(q) from h51_atlfast p, h51_atlfast q 
       where Id(p)=3 and Nele(p)<Nele(q);
