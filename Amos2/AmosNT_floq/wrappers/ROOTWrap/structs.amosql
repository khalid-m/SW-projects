load_lisp('structs.lsp');

create function get_slot(sobject s, integer i) -> object as multidirectional 
	("bbf" foreign 'sobject_getbbf' cost {2,1})
	("bff" foreign 'sobject_getbff' cost {20,10});

create function get_slot_bag(sobject s, integer i) -> bag of object as
	foreign 'sobject_getbagbbf';

create function set_slot(sobject s, integer i, object v) -> boolean
	as foreign 'sobject_setbbb';

create function size(sobject s) -> integer as
	foreign 'sobject_sizebf';

create function sobject_type(sobject s) -> type as
	foreign 'sobject_typebf';

create function source(sobject s) -> type as
	foreign 'sobject_srcbf';

create function sid(sobject s) -> object as
	foreign 'sobject_idbf';

create function new_sobject(Type t, Object source, Object sid, Vector cont) -> 
	sobject as foreign 'make_sobjectbbbbf';

create function new_sobject(Type t, Object source, Object sid, Integer n) -> 
	sobject as foreign 'make_sobjectbbbbf';

create function new_sobject(Type t, Object sid, Vector cont) -> 
	sobject as foreign 'make_sobjectbbbf';

create function transpose(Vector v) -> vector r as
	foreign 'vector_transpose';

create function sobject_transpose(Vector v, sobject s, type t) -> 
	bag of sobject as foreign 'sobject_transpose';

create function sobject_transpose_vect(Vector v, sobject s, type t) -> 
	vector of sobject as foreign 'sobject_transpose_tovector';

create function mat_sobject_transpose(Vector v, sobject s, type t, integer pos) -> boolean
	as foreign 'mat_sobject_transpose';

create function mat_sobject_transpose_add(Vector v, sobject s, type t, integer pos, 
				integer addslots) -> boolean
	as foreign 'mat_sobject_transpose_and_add_slots';

create function sobjectstat(boolean flag) -> boolean as
	foreign 'set_structstat';

create function slotstat(boolean flag) -> boolean as
	foreign 'set_slotstat';

create function sobjectstat_setfno(function fno) -> boolean as
	foreign 'set_structstatfnb';

create function sobjectstat_setfno(charstring fn) -> boolean as
	select sobjectstat_setfno(functionnamed(fn));

create function sobjectstat(charstring fn) -> boolean as
begin
	if (sobjectstat_setfno(fn))
	then return sobjectstat(TRUE);
end;

create function sobjectstat_getfno() -> function fno as
	foreign 'get_structstatfnf';

create function set_slotvector(sobject s, integer i, vector v) -> boolean
	as foreign 'sobject_setvectorbbb';

create function set_slotvector(sobject s, integer i, vector v, function fno) ->
	boolean	as foreign 'sobject_setvectorbbbb';

create function sobject_stat(type t, integer i)-> 
	(integer calls, integer results, integer sqsum) as stored;

create function set_sobjectstat(type t, integer i, integer arity) -> boolean 
as
begin
	declare integer calls, integer results, integer sqsum;
	select c,r,s into calls, results, sqsum
		from integer c, integer r, integer s
		where (c,r,s) = sobject_stat(t,i);
	if (calls != nil)
		then set calls = calls + 1
		else set calls = 1;
	if (results != nil)
		then set results = results + arity
		else set results = arity;
	if (sqsum != nil)
		then set sqsum = sqsum + arity*arity
		else set sqsum = arity*arity;
	set sobject_stat(t,i) = (calls,results,sqsum);
	return TRUE;
end;

create function set_sobjectstatfno() -> boolean as
select sobjectstat_setfno("type.integer.integer.set_sobjectstat->boolean");

create function sobjectstat() -> boolean as
select sobjectstat("type.integer.integer.set_sobjectstat->boolean");

create function set_slotvector_stat(sobject s, integer i, vector v) -> boolean
as select set_slotvector(s,i,v,
	functionnamed("type.integer.integer.set_sobjectstat->boolean"));

create function cachefn(Function fno, integer slot, sobject ev) -> 
	Object as foreign "cachefn";
