lisp;

(setq _strict-restypes_ nil) ;; sqisle uses non-strict typing

:osql

<'structs.amosql';
<'aleh_udfs.amosql';

/**
 * Foreign functions to get information about ROOT file. Such as directories,
 * tree objects and attributes of the tree object.
 */
create function root_dirs(charstring dataSource) -> bag of charstring 
		as foreign "root_dirs";
create function root_trees(charstring dataSource, charstring dirName) -> 
	bag of charstring as foreign 'root_files';
create function root_columns(charstring dataSource, charstring rootDir, 
	charstring rootTable) -> bag of <charstring cname,charstring datatype> as 
	foreign 'root_columns';
create function root_columns_all(charstring dataSource, charstring rootDir, 
	charstring rootTable) -> bag of <charstring cname,charstring datatype> as 
	foreign 'root_columns_all';

/**
 * General scan, get and get interval foreign functions. Source is specified
 * by file name, ROOT directory and tree object. The key is vector containing
 * source and id of tree object. The result vector is rest non key attributes.
 */
create function root_scan(charstring dataSource, charstring rootDir, 
	charstring rootTable) -> bag of <Vector key,Vector> as foreign 'root_scan';
create function root_get(charstring dataSource, charstring rootDir, 
	charstring rootTable, vector key) -> Vector as foreign 'root_get';
create function root_get_interval(charstring dataSource, charstring rootDir, 
	charstring rootTable, integer low, integer high) -> bag of <vector key,Vector> as 
	foreign 'root_get_interval';

/**
 * Foreign functions to scan and get with projection.
 */
create function root_scan_project(charstring dataSource, charstring rootDir, 
	charstring rootTable, vector AttrsProjection) 
       -> bag of <vector key,Vector>
 as foreign 'root_scan_project';
create function root_get_project(charstring dataSource, charstring rootDir, 
	charstring rootTable, vector AttrsProjection, vector key) -> Vector as 
	foreign 'root_get_project';
create function root_get_interval_project(charstring dataSource, 
	charstring rootDir, charstring rootTable, vector AttrsProjection, 
	integer low, integer high) -> bag of <vector key,Vector> as 
	foreign 'root_get_interval_project';

create function root_attr_i(charstring dataSource, charstring rootDir, 
	charstring rootTable, charstring attrName key) -> Integer as 
	foreign 'root_attr_i';

/* Foreign functions to scan with projection returning struct */
create function root_scan_project_addslots(charstring dataSource, 
	charstring rootDir, charstring rootTable, vector AttrsProjection, 
	type StructType, integer AdditionalSlots) -> stream of sobject as 
		foreign 'root_scan_sobjects_project';
costhint("ROOT_SCAN_PROJECT_ADDSLOTS","bbbbbbf",{2000.0,1000.0});

create function root_scan_project(charstring dataSource, 
	charstring rootDir, charstring rootTable, vector AttrsProjection, 
	type StructType) -> stream of sobject as 
select root_scan_project_addslots(dataSource, rootDir, rootTable,
	AttrsProjection,StructType,0);

create function root_get_interval_sobjects_project(charstring dataSource, 
	charstring rootDir, charstring rootTable, vector AttrsProjection, 
	type StructType, integer AdditionalSlots, integer firstEvent,
	integer lastEvent) -> stream of sobject as 
		foreign 'root_scan_sobjects_project';
costhint("CHARSTRING.CHARSTRING.CHARSTRING.VECTOR.TYPE.INTEGER.INTEGER.INTEGER.ROOT_GET_INTERVAL_SOBJECTS_PROJECT->BAG-SOBJECT","bbbbbbbbf",{200.0,100.0});

create function root_get_interval_sobjects_project(charstring dataSource, 
	charstring rootDir, charstring rootTable, vector AttrsProjection, 
	type StructType, integer firstEvent,integer lastEvent) 
		-> stream of sobject as 
select root_get_interval_sobjects_project(dataSource, rootDir, rootTable,
	AttrsProjection,StructType,0,firstEvent,lastEvent);

load_lisp("wrapper3.lsp");

/* Returns name and type name of attributes with space in between for 
the given TTree object under the given path in the given file. */
create function root_column_declarations(charstring src,charstring dir, 
		charstring tbl) -> Bag of Charstring as 
	select col+ " " + tpn 
	from Charstring tpn, Charstring col 
	where <tpn,col> = root_columns(src,dir,tbl);

/* Takes bag of strings and returns string with all strings concatinated and comma in between */
create function commalist(Bag b)->Charstring
  as select concatagg(inject(b,","));

/* Names of all columns except ID of table */
create function root_columnnames(Charstring src, charstring dir, 
		Charstring tbl) ->Bag of Charstring col
  as select col
     from Charstring tp
     where root_columns(src,dir,tbl) = <col,tp>;  
  
  
/* Names of all columns of table */
create function root_columnnames_all(Charstring src, charstring dir, 
		Charstring tbl) ->Bag of Charstring col
  as select col
     from Charstring tp
     where root_columns_all(src,dir,tbl) = <col,tp>;       

/* Names of all attributes to the given table under given path in the given file
starting with attribute Filename */
create function root_columnnames_alls(charstring file, charstring dir,
	charstring rootfile) -> bag of charstring as
begin
	return "filename";
	return root_columnnames_all(file,dir,rootfile);
end;

/* Multidirectional foreign function used by the wrapper to get data from ROOT files*/
create function root_access(charstring file, charstring dir,
	charstring tbl)->bag of <vector key, vector>
as multidirectional
	('bbbff' foreign 'root_scan' cost {1000,25000}) 
	('bbbbf' foreign 'root_get' cost {10,1});

create function root_access_project(charstring file, charstring dir,
	charstring tbl, vector projection) -> bag of <vector key, vector> as
multidirectional
	('bbbbff' foreign 'root_scan_project' cost {1000,25000}) 
	('bbbbbf' foreign 'root_get_project' cost {10,1});
declare_type_container("root_access_project");
/* Generates CC function for given sample file and generates mapped type. 
Mapped type can be used for any ROOT files where TTree objects has same 
names and placed under the same path */
