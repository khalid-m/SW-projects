/****************************Vehicle info***************************/
/* Used for storing all data about a vehicle*/
create function vehicle_info(integer vi)->
          < integer xway, integer pos, integer seg,integer dir,real bal,
            real lastupdate, integer vav, real nextexp>
  as stored;	

create function set_vehicle_info(integer vi, integer xway, integer pos, 
                                 integer seg,integer dir,real bal,
                                 real lastupdate, integer vav, real nextexp)
                                -> Boolean
  as set vehicle_info(vi)= <xway,pos,seg,dir,bal,lastupdate,vav,nextexp>;

create function add_vehicle_info(integer vi,integer xway, integer pos, 
                                 integer seg,integer dir,real bal,
                                 real lastupdate, integer vav, real nextexp)
                                 ->boolean
  as add vehicle_info(vi)=<xway,pos,seg,dir,bal,lastupdate,vav,nextexp>;

/***************************Vehicle info ends*********************************/

create function giveme_seg(integer vid)->integer
  as select s 
     from integer x, integer p, integer s,integer d,real b, real l, 
          integer va, real n 
     where vehicle_info(vid)=<x,p,s,d,b,l,va,n> ;

create function giveme_xway(integer vid)->integer
  as select x 
     from integer x, integer p, integer s,integer d,real b,real l, 
          integer va, real n 
     where vehicle_info(vid)=<x,p,s,d,b,l,va,n> ;

create function check_new_seg_report(integer vid,integer seg,integer xway)
                                    -> Boolean
  as  /* same seg in this report as in the latest report?*/
     select where giveme_seg(vid)=seg 
              and giveme_xway(vid)=xway;

              
create function add_previous_toll(integer vid,integer xway, integer pos, integer seg, integer dir, integer spd)->boolean
as
	select set_vehicle_info(vid,xway,pos,seg,dir, upbalance,tdiff(now(),rtime()),spd,0.0)
	
	 from real upbalance
       where upbalance=sum(select n+b 
                           from  integer xw, integer p, integer s, integer d,
                                 real b,real l, integer va, real n 
		           where vehicle_info(vid)
                                 = <xw,p,s,d,b,l,va,n>);

create function giveme_balance(integer vid)->integer
  as select b 
     from  integer xway, integer p, integer s, integer d, real b, real l, 
           integer va, real n 
     where vehicle_info(vid)=<xway,p,s,d,b,l,va,n>;

create function giveme_lasttime(integer vid)->real
  as select l 
     from integer xway, integer p, integer s, integer d, real b, real l, 
          integer va, real n 
     where vehicle_info(vid)=<xway,p,s,d,b,l,va,n>;


create function update_vehicle_info(integer vid, integer xway, integer pos, integer seg,integer dir, integer spd)->Boolean
  as   /*Vehicle is on the exit lane, update info and remove nextexp*/
     select add_previous_toll(vid,xway,pos,seg,dir,spd);
     


                                
create function update_vehicle_toll(integer vid, integer xway, integer pos, integer seg,integer dir, integer spd,real toll)->Boolean 
as select set_vehicle_info(vid,xway,pos,seg,dir,
                             cast(giveme_balance(vid)as real),
                             tdiff(now(),rtime()),spd,toll);
 
create function toll_alert()-><integer ty, integer vid,integer time, 
                               real emit,real vavg,real toll>
  as stored;

create function generate_toll_alert(integer vid, integer time, real vavg, 
                                    real toll)->boolean
  as 
     select wtoll({ 0,vid,time,tdiff(now(),rtime()),vavg,toll});


     

create function calc_toll(integer sec, integer vid, integer xway, integer pos, integer seg,integer dir,integer spd)->vector
  as begin
       declare real toll,integer nr_of_cars,real Avgv;
       if is_accident_area(xway,seg,dir)
       then begin waccident({1,sec,tdiff(now(),rtime()),vid,
                            get_accident_seg(xway) });/*send accident alert*/
	          set toll=0.0;
	          set Avgv=avgv(seg,xway,dir,
                                cast(current_minute()-1 as integer));
            end
       else begin set nr_of_cars=count_visited(seg,xway,dir,
                                               cast(current_minute()-1 
                                                    as integer));
	          set Avgv=avgv(seg,xway,dir,
                                cast(current_minute()-1 as integer));
	          if (nr_of_cars<=50) or (Avgv>=40) 
                  then set toll=0.0
                  else begin set toll=2*(nr_of_cars-50)*(nr_of_cars-50);
		             /*print({"toll=", toll});*/
                       end;
           end;
       update_vehicle_toll(vid,xway,pos,seg,dir,spd,toll);
       /*update_vehicle_toll(x[2],x[4],x[8],x[7],x[6],x[3],toll);*/
       generate_toll_alert(vid,sec,Avgv,toll);
     end;