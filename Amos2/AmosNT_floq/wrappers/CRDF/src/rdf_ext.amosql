create function RDFLiteralID(Charstring)->Integer key as stored;

create function FindLitID(Charstring dt)->Integer as select RDFLiteralID(dt);
create function NumOfLitID()->Integer as 
	select count(select RDFLiteralID(dt) from Charstring dt);

/*map datatype URI to integer*/
create function GetLitID(Charstring dt)->Integer as
begin
	declare integer n;
	set n = FindLitID(dt);
	if (n!=nil) then result n
	else
	begin
		set n = NumOfLitID();
		add RDFLiteralID(dt)=n;
		result n;
	end;
end;

create function parseRDF(Charstring)-><Resource,Resource,Resource> 
													as foreign "parseRDF";

create function rdf_triple_cache(Charstring)->Bag of <Resource,Resource,Resource> as stored;													
create function parseRDF_cache(Charstring)->Boolean as foreign "parseRDF_cache";

GetLitID("Resource");
GetLitID("PlainLiteral");
GetLitID("http://www.w3.org/2001/XMLSchema#integer");
GetLitID("http://www.w3.org/2001/XMLSchema#decimal");
GetLitID("http://www.w3.org/2001/XMLSchema#double");
GetLitID("http://www.w3.org/2001/XMLSchema#boolean");
GetLitID("http://www.w3.org/2001/XMLSchema#string");
