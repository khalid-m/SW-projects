create function jdbc(Charstring name, Charstring driver) -> Jdbc
  as foreign 'jdbc--+';

create function load_driver(Charstring driver) -> Boolean
  as foreign 'JAVA:jdbc_interface.JDBCInterface/loadDriver';

create function load_driver(Jdbc ds, Charstring driver) -> Boolean
  as foreign 'JAVA:jdbc_interface.JDBCInterface/loadDriver';
 
create function connect(Jdbc ds1, 
			Charstring url,
                        Charstring user_name, 
			Charstring password)  -> Jdbc ds2
  as foreign 'JAVA:jdbc_interface.JDBCInterface/connect';

/* Connect to a JDBC database using default username and password */
create function connect(Jdbc ds1, Charstring url) -> Jdbc ds2
  as foreign 'JAVA:jdbc_interface.JDBCInterface/connectDefault';

create function disconnect(Jdbc ds) -> Integer b
  as foreign 'JAVA:jdbc_interface.JDBCInterface/disconnect';

create function sql(Jdbc ds, Charstring query) -> Vector
  as foreign 'JAVA:jdbc_interface.JDBCInterface/executeQuery';

costhint('JDBC.CHARSTRING.SQL->VECTOR','bbf',{1000,1000});

create function sql(Jdbc ds, Charstring query, Vector arguments) -> Vector
  as foreign 'JAVA:jdbc_interface.JDBCInterface/executeParametrizedQuery';

create function sqlu(Jdbc ds,Charstring update) -> Integer
  as foreign 'JAVA:jdbc_interface.JDBCInterface/executeUpdate';
	 	     
create function sqlu(Jdbc ds, Charstring query, Vector arguments) -> Integer
  as foreign 'JAVA:jdbc_interface.JDBCInterface/executeParametrizedUpdate';

costhint('JDBC.CHARSTRING.VECTOR.SQL->VECTOR','bbbf',{1000,100});

/*Changes*/
create function table_cache(Jdbc ds)-> Bag of Vector as stored;

create function tables2(Jdbc ds)
                    -> (Charstring table,Charstring catalog,Charstring schema,
                        Charstring tbl_type)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/tables';

create function tables(Jdbc ds)
                   -> (Charstring table,Charstring catalog,Charstring schema,
                       Charstring tbl_type)
  as begin
        if notany(table_cache(ds)) then
	begin  
           for each Charstring table, 
	  	    Charstring catalog, 
		    Charstring schema, 
		    Integer tbl_type
               where (table,catalog,schema,tbl_type) = tables2(ds)
	begin
             add table_cache(ds) = {table,catalog,schema,tbl_type};        
	end;
	end;
	for each Charstring table, 
		 Charstring catalog, 
		 Charstring schema, 
		 Integer tbl_type
              where {table,catalog,schema,tbl_type} = table_cache(ds)
             return (table,catalog,schema,tbl_type);
   end;

/*End of changes*/

create function tables(Jdbc ds, Charstring tablename_pattern)
                   -> (Charstring table,Charstring catalog,Charstring schema,
                       Charstring tbl_type)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/tablesByName';

create function tables_in_schema(Jdbc ds, Charstring schemaname)
                             -> (charstring tablename, charstring catalogname,
                                 charstring typename)
  as select tablename, catalogname, typename 
     from Charstring tablename, Charstring catalogname, Charstring typename
     where tables(ds)=(tablename, catalogname, schemaname, typename);

/*Changes*/
create function columns_cache(Jdbc ds,
			      Charstring schema_pattern,
			      Charstring table_name_pattern,
			      Charstring column_name_pattern) -> Vector
  as stored;

create function columns2(Jdbc ds, 
			 Charstring schema_pattern,
			 Charstring table_name_pattern,
			 Charstring column_name_pattern)
                     -> (charstring column_type, charstring column_name)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/columns';

create function columns(Jdbc ds,
			Charstring schema_pattern,
			Charstring table_name_pattern,
			Charstring column_name_pattern)
                    -> (Charstring columns_type,Charstring column_name)
  as begin
        if notany(columns_cache(ds,
				schema_pattern,
				table_name_pattern,
				column_name_pattern)) 
	then add columns_cache(ds,
			       schema_pattern,
			       table_name_pattern,
			       column_name_pattern)
               = vectorof(columns2(ds,
			  	   schema_pattern,
				   table_name_pattern,
				   column_name_pattern));
        for each Charstring columns_type, 
		  Charstring column_name
            where {columns_type,column_name} in (columns_cache(ds,
							schema_pattern,
							table_name_pattern,
							column_name_pattern))
            return (columns_type,column_name);
      end;
/*End of changes*/

/*Changes*/
create function pk_cache(Jdbc ds, Charstring catalog_name,
                         Charstring schema_name, Charstring table_name)
                     -> Bag of (Charstring,Charstring)
  as stored;

create function primary_keys2(Jdbc ds, Charstring catalog_name, 
                              Charstring schema_name, Charstring table_name) 
                          -> (Charstring column_name,
                              Charstring constraint_name)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/primaryKeys';

create function primary_keys(Jdbc ds,
			     Charstring catalog_name,
			     Charstring schema_name,
			     Charstring table_name)
                         -> (Charstring column_name,Charstring constraint_name)
  as begin
        if notany(pk_cache(ds,
			catalog_name,
			schema_name,
			table_name)) 
	then        
           for each Charstring column_name, Charstring constraint_name
               where (column_name,constraint_name) = 
		primary_keys2(ds,
			catalog_name,
			schema_name,
			table_name)
             add pk_cache(ds,
			catalog_name,
			schema_name,
			table_name)
               = (column_name,constraint_name);
        for each Charstring column_name, 
		 Charstring constraint_name
            where (column_name,constraint_name) = pk_cache(ds,
						 	   catalog_name,
							   schema_name,
							   table_name)
             return (column_name,constraint_name);
     end;

/*End of changes*/


create function cross_reference(Jdbc,
				Charstring primary_table,
				Charstring foreign_table) 
                            -> (Charstring foreign_key, Charstring primary_key)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/getCrossReference';

/*
 * Ordered by pktable
 */
create function imported_keys(Jdbc ds, Charstring fktable)
                          -> (Charstring pktable, Charstring pkcolumn,
                              Charstring fkcolumn)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/getImportedKeys';

/*
 * Ordered by pktable. Works with MSQL Server.
 */
create function imported_keys(Jdbc ds, Charstring catalog, Charstring schema,
                              Charstring fktable)
                          -> (Charstring pktable, Charstring pkcolumn, 
                              Charstring fkcolumn)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/getImportedKeys';

/*
 * Ordered by pktable
 */
create function exported_keys(Jdbc ds, Charstring pktable)
                          -> (Charstring pkcolumn, Charstring fktable, 
                              Charstring fkcolumn)
  as foreign 'JAVA:jdbc_interface.JDBCInterface/getExportedKeys';
			      
/*
 * A feature of JDBC. Not even Interbase bothered to implement this.
 */
create function index_info(Jdbc j, 
			   Charstring schema_name,
			   Charstring table_name, 
    			   Boolean unique, 
			   Boolean approximate)
                       -> (Charstring index_type, Integer cardinality) 
  as foreign 'JAVA:jdbc_interface.JDBCInterface/getIndexInfo';

create function max_index_length(Jdbc j) -> Integer 
  as foreign 'JAVA:jdbc_interface.JDBCInterface/getMaxIndexLength';

create function set_trace_printing(Jdbc j, Boolean mode) -> Boolean
  as foreign 'JAVA:jdbc_interface.JDBCInterface/setTracePrinting';