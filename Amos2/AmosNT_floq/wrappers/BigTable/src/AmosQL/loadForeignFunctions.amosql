create function gql(Charstring dsn, Charstring query, Vector params)
                ->Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gql";

create function gql(Charstring dsn, Charstring query)->Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gql";

create function gql(Charstring dsn, Charstring query, Vector params, 
                    Charstring logFlag)
                ->Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gql";

create function serverNLJ(Charstring dsn, Vector of Charstring queries, Vector of
                       Vector of integer joinPro)->Bag of Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gqlNLJ";

create function serverNLJNew(Charstring dsn, Vector of Charstring queries, 
		       Vector of Vector of integer joinPro)->Bag of Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gqlNLJNew";

create function serverSMJ(Charstring dsn, Vector of Charstring queries, Vector of
                       Vector of integer joinPro)->Bag of Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gqlSMJ";

create function serverHJ(Charstring dsn, Vector of Charstring queries, Vector of
                       Vector of integer joinPro)->Bag of Vector
  as foreign  "JAVA:bigtable.BigTableInterface/gqlHJ";

create function insertBigTable(Charstring dsn, Charstring tablen, Vector props,
                               Vector propertyVal)->Charstring
  /* insert new tuple interface */
  as foreign "JAVA:bigtable.BigTableInterface/insertBigTable";

create function getBigTable(Charstring dsn, Charstring tablen, 
                            Vector keyPropVal)->Integer
  /* get a tuple record interface */
  as foreign "JAVA:bigtable.BigTableInterface/getBigTable";

create function deleteBigTable(Charstring dsn, Charstring tablen, 
                               Vector keyPropVal)->Charstring
  /* delete a tuple record interface */
  as foreign "JAVA:bigtable.BigTableInterface/deleteBigTable";

/******************************************************************************
 * System facility functions
 *****************************************************************************/
create function setClientLog(Charstring onOroff)->Boolean
  as foreign  "JAVA:bigtable.query.QueryManager/setClientLog";

create function setServerLog(Charstring onOroff)->Boolean
  as foreign  "JAVA:bigtable.query.QueryManager/setServerLog";

create function setResultChunkSize(Integer resultChunkSize)->Boolean
  /* Set returned query result size from server */ 
  as foreign "JAVA:bigtable.query.QueryManager/setResultChunkSize";	

/******************************************************************************
 * Exchange metadata with ODDSE server
 *****************************************************************************/

create function accessBigtable0(Charstring dsn, Charstring uri)->Boolean
  /* Access and wrap all relations from AppEngine at URI */
  as foreign "JAVA:bigtable.schema.SchemaManager/accessBigtable";

/******************************************************************************
 * Create Bigtable relations on AppEngine 
 *****************************************************************************/

create function createBigtable(Charstring uri, Charstring name,
                               Vector props, Vector types, Vector keys)
                              ->Boolean
  /* Create new Bigtable relation */
  as foreign "JAVA:bigtable.schema.SchemaManager/createBigtable";

create function createBigtable(Charstring uri, Charstring name, 
                               Charstring partype, Vector props, 
                               Vector types)->Boolean
  /* Create new Bigtable relation using inheritance */
  as foreign "JAVA:bigtable.schema.SchemaManager/createBigtable";
  
