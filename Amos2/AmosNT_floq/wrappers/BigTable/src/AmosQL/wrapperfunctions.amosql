     "} in gql('"+dsn+ "', 'select * from "+tbn+"',{});";
*/


create function generateBigtableCC(Charstring dsn, Charstring tbn)
                                  ->Charstring fnd
  as "create function #"+tbn+"_"+dsn+"()->("+
     commalist(bigTableAttributesR(dsn,tbn))+")
"+
     " as multidirectional ('"+genBpat(dsn,tbn)+"' select "+ 
                             commalist(bigtableCols(dsn,tbn))+
     " where {"+commalist(bigtableCols(dsn,tbn))+
     "} in gql('"+dsn+ "', 'select * from "+tbn+"',{}));";


/* auto string creation of mapped type with corresponding ccfn */
create function genCCfnMappedtype(Charstring dsn, Charstring tbn)
                                 ->Charstring fnd
  as "create_mapped_type('"+tbn+"_"+dsn+"', {'"+
                  bigTableKeyAttribute(dsn,tbn)+"'}, {'"+
                  quoteList(bigtableCols(dsn,tbn)) +
                  "'}, '#"+tbn+"_"+dsn+"');";
