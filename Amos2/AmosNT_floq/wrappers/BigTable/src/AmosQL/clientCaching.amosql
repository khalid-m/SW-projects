/*
create function gql_results_cache(Charstring dsn, Charstring query, Vector params)
       ->Bag of Vector as stored;


create function gql2(Charstring dsn, Charstring query, Vector params)->
    Bag of Vector as
  foreign "JAVA:bigtable.BigTableInterface/gql";

create function gql_results(Charstring dsn, Charstring query, Vector params) ->
                 Bag of Vector v as
  begin
        if notany(gql_results_cache(dsn,query,params)) then        
           for each original Vector v
               where v in gql2(dsn,query,params)
             add gql_results_cache(dsn,query,params) = v;
        for each Vector v
              where v in gql_results_cache(dsn,query,params)
             result v;
   end;


create function checkNil(object)->boolean
as foreign 'checkNil-';


(defun checkNil- (fno x)
	(if (equal (mkstring x) "nil")   (help)
	    (osql-result x)))	

