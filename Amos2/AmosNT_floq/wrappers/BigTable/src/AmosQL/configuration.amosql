set_absorber('Bigtable', 'absorb-gql');
set_finalizer('Bigtable', 'finalize-gql');

create_wrapper_absorbability('Bigtable', '<');
create_wrapper_absorbability('Bigtable', '<=');
create_wrapper_absorbability('Bigtable', '>');
create_wrapper_absorbability('Bigtable', '>=');
create_wrapper_absorbability('Bigtable', '!=');
/* like predicate is not supported in GQL */

