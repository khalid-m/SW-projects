/*****************************************************************************
 * BiGWrapper Meta-data
 ****************************************************************************/

create function bigTableURL(Charstring dsn) -> Charstring url
  as stored;

create function bigTables(Charstring dsn) -> Bag of Charstring name
  /* The collections in a BigTable datasource */
  as stored;

create function bigTableKeyAttribute(Charstring dsn, Charstring coll)
                                     ->Bag of (Charstring aname)
  as stored; 


create function bigTableNumOfTuples(Charstring dsn, Charstring coll)
                                    -> Integer numOfTuples
  /* Retrieved by meta-data importer by running Python program */
  as stored; 

create function extent_dsn(Function efn)-> Charstring dsn
  /* The data source identifier of a source relation */
  as stored;

create function extent_ds(Function efn)-> Bigtable bt
  as stored;

create function collection_dsn(Charstring coll) -> Charstring dsn
  as select extent_dsn(efn)
     from Function efn
     where extent_collection(efn) = coll;

create function extent_fn(Charstring dsn, Charstring coll)
			 -> Function efn
  /* The source relation for a collection in a data source */
  as select efn where extent_collection(efn)=coll and extent_dsn(efn)=dsn;

/*
create function bigTableAttributes(Charstring dsn, Charstring coll)
                                  ->Bag of (Integer pos,
                                            Charstring aname, 
                                            Charstring atype, 
                                            Integer iskey, Integer indexed)
  as stored; 
*/

create function bigTableAttributes(Charstring dsn, Charstring coll)
                                  ->Bag of (Integer pos,
                                            Charstring aname, 
                                            Charstring atype, 
                                            Charstring iskey, 
					    Charstring indexed)
  as stored; 

/*
create function bigTableAttributeVectorAname(Charstring dsn, Charstring coll)
                                       -> Vector of Charstring
  as vectorize(select pos, aname 
               from Integer pos,
                    Charstring aname,
                    Charstring atype,
                    Integer iskey,
                    Integer indexed
               where (pos, aname, atype, iskey, indexed) in
                      bigTableAttributes(dsn, coll));
*/

create function bigTableAttributeVectorAname(Charstring dsn, Charstring coll)
                                       -> Vector of Charstring
  as vectorize(select pos, aname 
               from Integer pos,
                    Charstring aname,
                    Charstring atype,
                    Charstring iskey,
                    Charstring indexed
               where (pos, aname, atype, iskey, indexed) in
                      bigTableAttributes(dsn, coll));

/*
create function bigTableAttributeVectorAtype(Charstring dsn, Charstring coll)
                                       -> Vector of Charstring
  as vectorize(select pos, atype
               from Integer pos,
                    Charstring aname,
                    Charstring atype,
                    Integer iskey,
                    Integer indexed
               where (pos, aname, atype, iskey, indexed) in
                      bigTableAttributes(dsn, coll));
*/

create function bigTableAttributeVectorAtype(Charstring dsn, Charstring coll)
                                       -> Vector of Charstring
  as vectorize(select pos, atype
               from Integer pos,
                    Charstring aname,
                    Charstring atype,
                    Charstring iskey,
                    Charstring indexed
               where (pos, aname, atype, iskey, indexed) in
                      bigTableAttributes(dsn, coll));

/* => attribute type and name by dsn and tbn as bag of charstring 
  in the order with query result*/
create function bigTableAttributesR(Charstring dsn, Charstring coll)
                                       -> bag of Charstring
  as select atype + " " +  aname
               from Integer pos,
                    Charstring aname,
                    Charstring atype
               where (pos, aname) in
                      bagify(bigTableAttributeVectorAname(dsn, coll)) and 
                     (pos, atype) in 
                      bagify(bigTableAttributeVectorAtype(dsn, coll));
  

create function extent_function(Charstring dsn, Charstring coll)
                               -> Function efn
  as select efn
     where extent_dsn(efn) = dsn and
           extent_collection(efn) = coll;



create function bigtableExtentAttributes(Function efn)-> Vector of Charstring
  as bigtableAttributeVectorAname(extent_dsn(efn), extent_collection(efn));


/******************************************************************************
 * Statistics
 *****************************************************************************/
/* statistic of column type integer */
create function colIntegerStatistic(Charstring dsn, Charstring coll, 
					Charstring aname)
			            -> (Integer minVal, Integer maxVal) 
  as stored;

create function colInt_maxVal(Charstring dsn, Charstring coll, 
					Charstring aname)
			            -> Integer maxVal 
  as stored;

create function colInt_minVal(Charstring dsn, Charstring coll, 
					Charstring aname)
			            -> Integer minVal 
  as stored;

/* statistic of column type Charstring */
create function colCharstringStatistic(Charstring dsn, Charstring coll, 
					Charstring aname)
			    	       -> Integer numOfDiffVals 
  as stored;