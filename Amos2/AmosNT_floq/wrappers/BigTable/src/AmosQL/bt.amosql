create function generateBigtableCC_old(Charstring dsn, Charstring tbn)
                                  ->Charstring fnd
  as "create function #"+tbn+"_"+dsn+"()->("+
     commalist(bigTableAttributesR(dsn,tbn))+")
"+
     " as multidirectional ('"+genBpat(dsn,tbn)+"' select "+ 
                             commalist(bigtableCols(dsn,tbn))+
     " where {"+commalist(bigtableCols(dsn,tbn))+
     "} in gql('"+dsn+ "', 'select * from "+tbn+"',{}));";





