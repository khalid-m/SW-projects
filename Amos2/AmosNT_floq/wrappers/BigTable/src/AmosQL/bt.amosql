create function put_tablename(Function fn, Charstring tbn)->Boolean as foreign 'put-tablename--';

create function put_datasource(Function fn, Bigtable ds)->Boolean as foreign 'put-datasource--';

create function genCCfnAndRWAndMPT(Bigtable ds, Charstring absorber)->Object
  as 
    begin
	 declare Charstring dsn;
	 set dsn = lower(name(ds));
	 for each Charstring tbn where tbn in bigTables(dsn)
	 begin
	     for each Function fno 
                 where {fno} in evalv(generateBigtableCC(dsn, tbn))
                  begin
		    set datasource(fno) = ds;	
		    set extent_ds(fno) = ds;
	            set extent_dsn(fno) = dsn;
                    set extent_collection(fno) = tbn;
		    put_tablename(fno, tbn);
	            put_datasource(fno, ds);
	            declare_key(fno, vectorof(bigTableKeyAttribute(dsn, tbn)));
                  end;
	     for each  Charstring fnd2 
                where fnd2 in  genCCfnMappedtype(dsn, tbn)
	     return evalv(fnd2);
	 end;
   end;	

