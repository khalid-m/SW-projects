/* ccfnFilter function cost */
create function ccfnFilterCost(Charstring dsn, Charstring tbn)->Number
  as bigTableNumOfTuples(dsn,tbn)*100 + 10000;

/* statistic of string value column selectivity */
create function strColSelectivity(Charstring dsn, Charstring coll, 
                               Charstring aname)
                              -> Real 
  as 1/colCharstringStatistic(dsn, coll, aname);

/* statistic of integer value column selectivity */
create function intColSelectivity(Charstring dsn, Charstring coll, 
                               Charstring aname, Integer x)
                              -> Real 
  as if colInt_maxVal(dsn,coll,aname)!= colInt_minVal(dsn,coll,aname) then
        return (colInt_maxVal(dsn,coll,aname)-x)/
               (colInt_maxVal(dsn,coll,aname)-colInt_minVal(dsn,coll,aname))
     else
        return 0.0000001;

