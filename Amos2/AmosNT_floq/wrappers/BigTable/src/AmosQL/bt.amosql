create function Bigtableds(Charstring name)->Object
  as foreign 'Bigtableds-+';

create function accessBigTable(Bigtable ds, Charstring url)->Boolean
	as 
	  begin 
	        declare Charstring absorber, Charstring finalizer;
	        set absorber = absorber(typeof(ds));
		set finalizer = finalizer(typeof(ds));
         	accessBigTable0(lower(name(ds)), url);
	   	genCCfnAndRWAndMPT(ds,absorber);
     	  end;

