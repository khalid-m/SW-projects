create function qNLJ()-> Bag of Object
  as select v2[1] from Vector v1, Vector v2 where
  v1 in gql('ds1',"select * from CITY where POPULATION > ?", {2000000}) and 
  v2 in gql('ds2',"select * from STATE where SHORTNAME = '"+v1[0]+"'");

pc("qnlj");



create function qHJ()-> bag of <object, object, object>
as select v[0], v[1], v[2] from Vector v where 
v in gqlHJ('ds1',{"select * from STATE", "select * from CITY where POPULATION > 50000"}, {{1,0}});

pc("qHJ");



create function q6()-> Bag of (Object, Object) as
	select x, y from object x, object y, vector v1, vector v2 where
	  v1 in gql('ds1', "select * from STATE where SHORTNAME > ?", {"M"}) and
	  v2 in gql('ds1', "select * from CITY where POPULATION > ? and STATE = ?", {800000, v1[0]}) and x = v1[1] and y = v2[1];

pc("q6");

create function qNLJ_1()-> bag of (object, object)
as select v2[1], v1[1] from vector v2, vector v1 where
          v1 in gql('ds1', "select * from STATE where SHORTNAME > ?", {"M"}) and
	  v2 in gql('ds1', "select * from CITY where POPULATION > ? and STATE = ?", {800000, v1[0]});

