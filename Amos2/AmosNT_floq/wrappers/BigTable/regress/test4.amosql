/* populate stored functions by dsn and url */
/* accessBigtable("ds1", "http://bigwrapper.appspot.com/simpleprotocol"); */
accessBigtable("ds1", "http://oddse2010.appspot.com/simpleprotocol");

bigTables('ds1');

bigTableAttributes('ds1', 'CITY');

bigTableAttributes('ds1', 'STATE');

/* Find the cities and their states where the population of the city > 50000 */
/* SQL: select S.FULLNAME, S.SHORTNAME, C.STATE, C.CITYNAME, C.POPULATION
        from STATE S, CITY C
        where C.POPULATION > 50000 and
              S.SHORTNAME = C.STATE */

/* high selectivity */
count(serverNLJNew("ds1", {"select * from STATE", 
                           "select * from CITY where POPULATION > 50000"}, 
                   {{1,0}}));

count(serverHJ("ds1", {"select * from STATE", 
                       "select * from CITY where POPULATION > 50000"}, 
               {{1,0}}));

count(serverNLJ('ds1',{"select * from STATE", "select * from CITY where POPULATION > 50000 and STATE = ?"}, {{1}}));


/* low selectivity */
count(serverNLJNew("ds1", {"select * from STATE", 
                           "select * from CITY where POPULATION > 500000"}, 
                   {{1,0}}));

count(serverHJ("ds1", {"select * from STATE", 
                       "select * from CITY where POPULATION > 500000"}, 
               {{1,0}}));

count(serverNLJ('ds1',{"select * from STATE", "select * from CITY where POPULATION > 500000 and STATE = ?"}, {{1}}));


count(sql("select s.FULLNAME, s.SHORTNAME, c.STATE, c.CITYNAME, c.POPULATION
        from STATE_ds1 s, CITY_ds1 c
        where c.POPULATION > 50000 and
              s.SHORTNAME = c.STATE"));

/* Client NLJ */
create function q0()->(Charstring,Charstring)
  as select cityname(c), fullname(s)
     from City_ds1 c, State_ds1 s
     where population(c)>50000 and
           state(c) = shortname(s);

count(q0());

/* Client HJ */
set :a = gql("ds1","select * from STATE");

set :b = gql("ds1","select * from CITY where POPULATION > 50000");

count(fasthashjoin(:a,:b,1,0));

pc("*select*");


/* serverLog("on"); */

create function q1()-> Bag of (Charstring, Charstring)
  as select cityname(c), fullname(s) 
     from City_ds1 c, State_ds1 s 
     where population(c)>2500000 and 
           shortname(s)>"IL" and 
           state(c) = shortname(s);

pc("q1");

q1();

	
accessBigtable("ds2", "http://oddse2010.appspot.com/simpleprotocol");
accessBigtable("ds1", "http://oddse2010.appspot.com/simpleprotocol");

/* absorb first apprearence predicate => constructed gql query could be 
different and execution plan could be different as well */
create function q0()->(Charstring,Charstring) as
select cityname(c), fullname(s)
         from City_ds1 c, State_ds1 s
         where population(c)>200000 and
               state(c) = shortname(s);

pc("q0");

create function q01()->Charstring as
select fullname(s)
         from State_ds1 s
         where shortname(s)>'CA';

create function q23()-> Bag of (Charstring, Charstring)
  as select cityname(c), fullname(s) 
     from City_ds1 c, State_ds1 s 
     where cityname(c)>'Dallas city' and  
	   shortname(s)<'WY' and
	   shortname(s)>'TX' and
	   population(c)>=500000 and population(c)<2500000 and 
           state(c) = shortname(s);

