
create function radio(charstring) -> bag of (integer, numarray, numarray, numarray)
	as foreign "FIXSTREAM:3d_radio_labview:i2,ci2[122],ci2[122],ci2[122]";

create function visualize_radio(stream) -> boolean
	as foreign "VISUALIZE:visualize_radio";



set :vi = vi("callout_radio.vi");

set :f = fixstream(:vi, "i2,ci2[122],ci2[122],ci2[122]");

set :a = streamof(select abs(fft(x))
	from integer i, numarray x, numarray y, numarray z
	where (i, x, y, z) in :f);

set :g = {vi("callout_radio_graph1.vi")};

visualize(:g, :a);

visualize({vi("visualize_radio.dll")}, :a);

set :b = streamof(select x
	from integer i, numarray x, numarray y, numarray z
	where (i, x, y, z) in :f);

visualize({vi("callout_radio_graph3.vi")}, :b);

select i
	from integer i, numarray x, numarray y, numarray z
	where (i, x, y, z) in :f;

set :v1 = vi("callout_radio_graph1b.vi");



set :vi = vi("callout_radio2.vi");

set :f = fixstream(:vi, "i2,ci2[366]");

set :a = streamof(select i /*abs(fft(il(x, 0, 3)))*/
	from integer i, numarray x
	where (i, x) in :f);

set :g = {vi("callout_radio_graph1.vi")};

set :b = streamof(select abs(fft(il(x, 0, 3))), abs(fft(il(x, 1, 3))), abs(fft(il(x, 2, 3)))
	from integer i, numarray x
	where (i, x) in :f);

visualize({vi("callout_radio_graph3.vi")}, :b);



visualize({
vi("callout_radio_graph1.vi"), vi("callout_radio_graph1b.vi"),
vi("callout_radio_graph1.vi"), vi("callout_radio_graph1b.vi"),
vi("callout_radio_graph1.vi"), vi("callout_radio_graph1b.vi"),
vi("callout_radio_graph1.vi"), vi("callout_radio_graph1b.vi"),
vi("callout_radio_graph1.vi"), vi("callout_radio_graph1b.vi")
}, :a);

visualize(
{vi("callout_radio_graph1.vi"), vi("callout_radio_graph1b.vi")}
, :a);

visualize(
{
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi"),
vi("callout_radio_graph1.vi")
}, :a);
