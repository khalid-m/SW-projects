# ---------------------------------------------------------------------------
!if !$d(BCB)
BCB = $(MAKEDIR)\..
!endif

# ---------------------------------------------------------------------------
# IDE SECTION
# ---------------------------------------------------------------------------
# The following section of the project makefile is managed by the BCB IDE.
# It is recommended to use the IDE to change any of the values in this
# section.
# ---------------------------------------------------------------------------

VERSION = BCB.04.04
# ---------------------------------------------------------------------------
PROJECT = ..\..\..\bin\odbc.dll
OBJFILES = odbc.obj ..\src\OdbcFunctions.obj ..\src\AmosTypes.obj
RESFILES = odbc.res
RESDEPEN = $(RESFILES)
LIBFILES = libodbc_bc.lib ..\..\..\bin\amos.lib
LIBRARIES = Vcl40.lib
SPARELIBS = Vcl40.lib
PACKAGES = vcljpg40.bpi
DEFFILE =
# ---------------------------------------------------------------------------
PATHCPP = .;..\src
PATHPAS = .;
PATHASM = .;
PATHRC = .;
DEBUGLIBPATH = $(BCB)\lib\debug
RELEASELIBPATH = $(BCB)\lib\release
USERDEFINES = NDEBUG;WIN32;_WINDOWS;IN_ODBCXX;_RWSTD_NO_EX_SPEC
SYSDEFINES = NO_STRICT
# ---------------------------------------------------------------------------
CFLAG1 = -I..\..\..\C;..\libodbc;..\src;..\libodbc\src;$(BCB)\include;$(BCB)\include\vcl \
  -WD -O2 -w -Ve -a8 -5 -k- -vi -c -b- -w-par -w-inl -Vx -tWM \
  -D$(SYSDEFINES);$(USERDEFINES)
PFLAGS = -U..\src;$(BCB)\lib\obj;$(BCB)\lib;$(RELEASELIBPATH) \
  -I..\..\..\C;..\libodbc;..\src;..\libodbc\src;$(BCB)\include;$(BCB)\include\vcl \
  -DNDEBUG;WIN32;_WINDOWS;IN_ODBCXX;_RWSTD_NO_EX_SPEC -$Y- -$L- -$D- -v -JPHNE -M
RFLAGS = -i..\..\..\C;..\libodbc;..\src;..\libodbc\src;$(BCB)\include;$(BCB)\include\vcl \
  -DNDEBUG;WIN32;_WINDOWS;IN_ODBCXX;_RWSTD_NO_EX_SPEC
AFLAGS = /i..\..\..\C /i..\libodbc /i..\src /i..\libodbc\src /i$(BCB)\include \
  /i$(BCB)\include\vcl /dNDEBUG /dWIN32 /d_WINDOWS /dIN_ODBCXX \
  /d_RWSTD_NO_EX_SPEC /mx /w2 /zn
LFLAGS = -L..\src;$(BCB)\lib\obj;$(BCB)\lib;$(RELEASELIBPATH) -aa -Tpd -x -Gn
# ---------------------------------------------------------------------------
ALLOBJ = c0d32.obj sysinit.obj $(OBJFILES)
ALLRES = $(RESFILES)
ALLLIB = $(LIBFILES) $(LIBRARIES) import32.lib cp32mt.lib
# ---------------------------------------------------------------------------
!ifdef IDEOPTIONS

