Item1=..\..\..\C;..\src;..\libodbc\src;$(BCB)\include;$(BCB)\include\vcl
Item2=..\..\C;..\libodbc;..\src;..\libodbc\src;$(BCB)\include;$(BCB)\include\vcl

[HistoryLists\hlLibraryPath]
Count=1
Item0=..\src;$(BCB)\lib\obj;$(BCB)\lib

[HistoryLists\hlDebugSourcePath]
Count=1
Item0=..\src

[HistoryLists\hlConditionals]
Count=1
Item0=NDEBUG;WIN32;_WINDOWS;IN_ODBCXX;_RWSTD_NO_EX_SPEC

[HistoryLists\hlIntOutputDir]
Count=1
Item0=Intermediate

[HistoryLists\hlHostApplication]
Count=1
