bk_connect("DB1");
set :h=bk_handle("DB1","Person");
bk_set(:h,{2487},{"ulf",1.2}); 
bk_get(:h,{2487}); /* {"ulf",1.2} */
bk_rollback();
bk_get(:h,{2487}); /* {"ulf",1.79} */
bk_disconnect();



