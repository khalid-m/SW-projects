create function bk_primkeys(charstring filename, charstring btid)->
					bag of charstring primkeys 
       /* Rettrieve names of primary keys in a table */
       as foreign 'BKPrimary_keysaa';

create function bk_columns(charstring filename, charstring btid)->
					bag of <charstring, charstring > 
       /* Retrieve names of columns in a table */
       as foreign 'BKColumnsaa';

create function bk_tables(charstring filename)->bag of charstring table
       /* Retrieve names of tables a file */
       as foreign 'BKTablesaa';