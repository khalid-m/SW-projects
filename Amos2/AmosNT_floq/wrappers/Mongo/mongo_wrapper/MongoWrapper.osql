load_extension("Mongo_wrapper");

create function mongo_connect(Charstring host)-> Integer conn_no
  as foreign 'mongo_connect-+';

create function mongo_add(Integer  conn_no, Charstring  database, Charstring collection,
                          Record oid) -> Object id
  as foreign 'mongo_add----+';

create function mongo_add_batch(Integer  conn_no, Charstring  database, Charstring collection, 
                          Integer write_concern,  Vector oid) -> Object status
  as foreign 'mongo_add_batch';

create function mongo_del(Integer  conn_no, Charstring  database, Charstring collection, 
                          Record oid) -> Boolean status
  as foreign 'mongo_del----+';

create function mongo_get(Integer  conn_no, Charstring  database, Charstring collection, 
                          Record r) -> Bag of Record x
  as foreign 'mongo_get----+';