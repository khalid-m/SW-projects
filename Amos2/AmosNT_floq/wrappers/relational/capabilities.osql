 *
 * Description: The capabilities for the translator part of the relational
 * Wrapper. Serves as an example how a wrapper implementor will specify the
 * capabilities of a translator.
 *
 ****************************************************************************/

create_capability('Relational', '<', 'bb', 'relational-translate-comparison');
create_capability('Relational', '>', 'bb', 'relational-translate-comparison');
create_capability('Relational', '<=', 'bb','relational-translate-comparison');
create_capability('Relational', '>=', 'bb','relational-translate-comparison');
create_capability('Relational', '!=', 'bb', 'relational-translate-comparison');
create_capability('Relational', 'like', 'bb', 'relational-translate-like');

sqloperator("!=","<>",true,false,false);
