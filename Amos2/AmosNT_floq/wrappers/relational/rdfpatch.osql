 *
 * Description: patch file for absorb rdf numerical predicates (rdf:minus,
 *              rdf:times, etc), and map them to sql operator  
 *
 ****************************************************************************/


create_wrapper_absorbability('relational', 'LITERAL.LITERAL.RDF:PLUS->LITERAL');

sqloperator('LITERAL.LITERAL.RDF:PLUS->LITERAL', '+', true, true, false);


create_wrapper_absorbability('relational', 'LITERAL.LITERAL.RDF:TIMES->LITERAL');

sqloperator('LITERAL.LITERAL.RDF:TIMES->LITERAL', '*', true, true, false);


create_wrapper_absorbability('relational', 'LITERAL.RDF:ABS->LITERAL');

sqloperator('LITERAL.RDF:ABS->LITERAL', 'abs', false, true, false);