create type TM_Object;
create type TopicMap under TM_Object;
create type Topic under TM_Object;
create type BaseName under TM_Object;
create type Variant under TM_Object;
create type Occurrence under TM_Object;
create type Association under TM_Object;
create type Member under TM_Object;

create function topicTopicMap(TopicMap) -> Bag of Topic as stored;
create function mergeMap(TopicMap) -> Bag of Topic as stored;
create function associationTopicMap(TopicMap) -> Bag of association as stored;
create function idTopicMap(TopicMap) -> Charstring as stored;
/*create function name(TopicMap) -> Charstring as stored;*/

create function idTopic(topic) -> Charstring as stored;
create_index(theresolvent("idtopic"),"Charstring","hash","multiple");
/*create function URI(topic) -> Charstring as stored;*/
create function instanceOfTopic(topic nonkey) -> topic as stored;
/*create function subjectIdentity(topic nonkey) -> topic as stored;*/
create function subjectIdentity(topic nonkey) -> Charstring as stored;
create_index(theresolvent("subjectidentity"),"Charstring","hash","multiple");
create function subjectAddress(topic nonkey) -> Charstring as stored;
create function baseNameTopic(topic) -> Bag of baseName as stored;
create function occurrenceTopic(topic) -> Bag of occurrence as stored;

create function idBaseName(baseName) -> Charstring as stored;
create function baseNameString(baseName) -> Charstring as stored;
create_index(theresolvent("basenamestring"),"Charstring","hash","multiple");
create function scopeBaseName(baseName nonkey) -> topic as stored;
create function variantBaseName(baseName nonkey) -> variant as stored;

create function subVariant(variant) -> Bag of variant as stored;
create function variantName(variant) -> Charstring as stored;
create function parameters(variant) -> Bag of topic as stored;
/*create function data(variant) -> <Charstring,Charstring> as stored;*/

create function instanceOfOccurrence(occurrence) -> topic as stored;
create function scopeOccurrence(occurrence nonkey) ->  topic as stored;
create function data(occurrence) -> Charstring as stored;
create_index(theresolvent("data"),"Charstring","hash","multiple");
create function reference(occurrence) -> Charstring as stored;
create_index(theresolvent("reference"),"Charstring","hash","multiple");
create function idOccurrence(occurrence) -> Charstring as stored;

create function idAssociation(association key) -> Charstring as stored;
create function instanceOfAssociation(association) -> topic as stored;
create function scopeAssociation(association nonkey) -> topic as stored;
create function memberAssociation(association) -> Bag of member as stored;

create function roleSpec(member key) -> topic as stored;
create function topicMember(member nonkey) -> topic as stored;

/*create function localname(TM_Object t key)->Charstring n key*/
/*  as  multidirectional ("bf" foreign "localname-+")*/
/*                       ("fb" foreign "localname+-");*/

lisp;
(defun localname-+ (fno t- n+)
   (if (oid-p t-) (osql-result t- (mkstring (oid-idno t-)))))

(defun localname+- (fno t+ n-)
   (osql-result (getobjectnumbered (read n-)) n-))
:osql

create function long_ontology()->charstring
  /* Namespace for the RDF view of Topic Maps */
  as stored;
set long_ontology()="http://udbl2.it.uu.se/swatm";

create function short_ontology()->charstring
  /* Namespace for the RDF view of Topic Maps */
  as stored;

set short_ontology()="swatm";

create function ontology()->charstring 
  /* Namespace for the RDF view of Topic Maps */
  as stored;
/*set ontology()="swatm";*/
set ontology()=long_ontology();

parteval("ontology"); /* never changes */

create function idTMO(TM_Object t)-> <charstring URI, integer ito>
/*Unique identification of a TM_Object*/
as stored;

declare_key(theresolvent('IDTMO'),{'URI','ito'});
create_index(theresolvent('IDTMO'), "ITO","hash", "multiple");


create function TMURI(TM_Object o)->Charstring
/*Giving an unique URI of each TM_Object as a sum of the ontology URI and its unique number*/
as
	begin
	 declare integer i, charstring u;
	 select id, uri into i, u from integer id, Charstring uri where idTMO(o)=<uri,id>;
	 result u+ ":"+ itoa(i);
	end;


create function TMURI(TM_Object o, Charstring src)->Charstring
/*Giving an unique URI of each TM_Object as a sum of the ontology URI and its unique number*/
as select src + ":" + itoa(id) from integer id where idTMO(o)=<src, id>; 

create function topicFile(TM_Object o)-> Charstring
as select src from Charstring src, Charstring turi where TMURI(o,src)=turi;

create function topicidno(charstring URI, TM_object t)-> integer
/*Retrieving the unique number of a TM_Object coming from a xtm file with the URI*/
as
	select idno from integer idno where <URI, idno> = idTMO(t);


create function topicnumbered(charstring URI, integer idn)-> TM_Object
/*Retrieving the TM_Object coming from a xtm file with the URI and having the unique number idn within the file*/
as
	select o from TM_object o where idTMO(o)=<URI, idn>; 