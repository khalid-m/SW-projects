 *
 * Description: Creates a new topic if it doesn't exist in the database
 *
 ****************************************************************************/
 
optmethod("exhaustive");
create function theTopic(Charstring idt,  Charstring fileTopic, Integer num, Topicmap tm) -> Topic r
as 
	begin
		declare Topic p;
		select t into p from Topic t where idtopic(t)=idt and topicFile(t)=fileTopic;
		if (p != NIL) then
			result p;
		if (p = NIL) then
			begin
				create TOPIC(idtopic, idTMO) instances r(idt, <fileTopic, num>);
				add topicTopicMap(tm)=r;
				result r
			end;
			
	end;
optmethod("ranksort");

