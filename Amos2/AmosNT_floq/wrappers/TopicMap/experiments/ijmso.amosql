set :sparql_schema = 
	"SELECT ?tp
	FROM <http://user.it.uu.se/~udbl/software/swatm/mondial.xtm>
	WHERE {?tp <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>. 
