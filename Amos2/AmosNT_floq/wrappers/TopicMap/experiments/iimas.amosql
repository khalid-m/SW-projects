lisp;
(defun pred-size (pred)
  (let ((cnt 0))
    (mappred pred (f/l (p)(1++ cnt)))
    cnt))

(defun execplan-size (fno)
   (pred-size (selectbody-optpred (getselectbody fno))))

:osql

