set :sparql_content1  = "SELECT ?tm2
		       	FROM <http://user.it.uu.se/~udbl/software/swatm/mondial.xtm>
			WHERE {?tm0  <http://udbl2.it.uu.se/swatm:BASENAMETOPIC> ?tm1.
			       ?tm1  <http://udbl2.it.uu.se/swatm:BASENAMESTRING> 'Nottinghamshire'. 
			       ?tm0  <http://udbl2.it.uu.se/swatm:OCCURRENCETOPIC> ?tm2 }";

eval("create function test1()-> Charstring as "+parsesparql(:sparql_content1));

sparql(:sparql_content1);

