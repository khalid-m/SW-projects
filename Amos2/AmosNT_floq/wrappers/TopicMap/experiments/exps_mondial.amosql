set :rdql_content45  = "SELECT ?iofc, ?occurrence
		       	FROM <mondial.xtm>
			WHERE (?tm0 , <http://udbl2.it.uu.se/swatm:BASENAMETOPIC>, ?tm1)
			      (?tm1 , <http://udbl2.it.uu.se/swatm:BASENAMESTRING>, 'Lang Son') 
			      (?tm0 , <http://udbl2.it.uu.se/swatm:OCCURRENCETOPIC>, ?tm2)
        		      (?tm2 , <http://udbl2.it.uu.se/swatm:DATA>, ?occurrence)
			      (?tm2 , <http://udbl2.it.uu.se/swatm:INSTANCEOFOCCURRENCE>, ?iofc)";

{"http://udbl2.it.uu.se/swatm:1395","8187"}
{"http://udbl2.it.uu.se/swatm:1397","671900"}
3.844 s

set :rdql_content05  = "SELECT ?idt
		       	FROM <mondial.xtm>
			WHERE (<http://udbl2.it.uu.se/swatm:1395>, <http://udbl2.it.uu.se/swatm:IDTOPIC>, ?idt)";


set :rdql_content5  = "SELECT ?idt
		       	FROM <mondial.xtm>
			WHERE (?tm0 , <http://udbl2.it.uu.se/swatm:BASENAMETOPIC>, ?tm1)
			      (?tm1 , <http://udbl2.it.uu.se/swatm:BASENAMESTRING>, 'Lang Son') 
			      (?tm0 , <http://udbl2.it.uu.se/swatm:OCCURRENCETOPIC>, ?tm2)
        		      (?tm2 , <http://udbl2.it.uu.se/swatm:DATA>, ?occurrence)
			      (?tm2 , <http://udbl2.it.uu.se/swatm:INSTANCEOFOCCURRENCE>, ?iofc)
			      (?iofc, <http://udbl2.it.uu.se/swatm:IDTOPIC>, ?idt)";



rdql(:rdql_content5);

{"8187","http://udbl2.it.uu.se/swatm:1395"}
{"671900","http://udbl2.it.uu.se/swatm:1397"}
1.906 s