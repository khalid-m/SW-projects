/*RDQL questions*/



set :rdql_content1 = "SELECT ?basenamestring
			FROM <mondial.xtm>
			WHERE (?tmo , <http://udbl2.it.uu.se/swatm:BASENAMESTRING> ?basenamestring)";

3 s

set :rdql_content2  = "SELECT ?tm0 
		       	FROM <mondial.xtm>
			WHERE (?tm0 , <http://udbl2.it.uu.se/swatm:BASENAMETOPIC>, ?tm1)
			      (?tm1 , <http://udbl2.it.uu.se/swatm:BASENAMESTRING>, 'Lang Son')"; 

rdql(:rdql_content2);
{"http://udbl2.it.uu.se/swatm:12013"}
0.3 s

