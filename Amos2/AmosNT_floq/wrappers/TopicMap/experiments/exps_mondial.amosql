/*SPARQL queries*/

set :sparql_content1 = "SELECT ?basenamestring
			FROM <http://user.it.uu.se/~udbl/software/swatm/mondial.xtm>
			WHERE {?tmo <http://udbl2.it.uu.se/swatm:BASENAMESTRING> ?basenamestring}";

sparql(:sparql_content1);
5s

set :sparql_content2  = "SELECT ?tm0 
		       	FROM <http://user.it.uu.se/~udbl/software/swatm/mondial.xtm>
			WHERE {?tm0  <http://udbl2.it.uu.se/swatm:BASENAMETOPIC> ?tm1.
			       ?tm1  <http://udbl2.it.uu.se/swatm:BASENAMESTRING> 'Lang Son'}"; 

sparql(:sparql_content2);

{"http://udbl2.it.uu.se/swatm:10953"}
0.516 s


