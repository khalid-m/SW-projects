create function RDF_classview(TM_Object t, Charstring file) -> 
                (Charstring s, Charstring p, Charstring o)
  as select s, p, o 
  where s = tmuri(t, file) and o = tmclassmap(typeof(t)) and
        p = rdfschemauri();


create function generate_rdfview_def_lit(Function fn)->Charstring fnd
/*Generates a rdf view if the result of the binary function fn is a literal*/
as select 
"create function RDF_" + gn + "(Charstring fname)->(Charstring s, Charstring p, Charstring o)
as select s,p,o
   from "+ tp + " a
   where o in "+ gn + "(a) and
         TMURI(a,fname)=s and
         p = \"" + tmpropmap(fn)+ "\";"

     from Charstring gn, Charstring tp
     where gn = generic_name(fn) and
           tp = name(argument_types(fn)) and 
		 fn in topicMapFunctions();

create function generate_rdfview_def(Function fn)->Charstring fnd
/*Generates a rdf view if the result of the binary function fn is an object*/
  as select 
"create function RDF_" + gn + "(Charstring fname)->(Charstring s, Charstring p, Charstring o)
as select s,p,o
   from "+ tp + " a, " + tr + " r
      where r in "+ gn + "(a) and
         TMURI(r,fname)=o and
	 TMURI(a,fname)=s and
         p = \"" + tmpropmap(fn)+ "\";"

     from Charstring gn, Charstring tp, Charstring tr
     where gn = generic_name(fn) and
           tp = name(argument_types(fn))and
   	   tr= name(result_types(fn)) and
	   fn in topicMapFunctions();

create function generate_rdfview(Function fn)->Object
/*Generates a rdfview for a binary TM function */
  as begin if is_literal(result_types(fn))
           then return eval(generate_rdfview_def_lit(fn))
           else return eval(generate_rdfview_def(fn));
     end;

create function generate_all_rdfviews()->Object
  /* Generate all the rdf views over all existing TM functions */    
  as begin
	for each function f where f in topicMapFunctions()
	     generate_rdfview(f);
     end;

create function make_statement(Charstring filen)->charstring
  as begin
    declare charstring nn, charstring fundef;
    set nn="";	
    for each charstring nam where nam = generic_name(topicMapFunctions())
    	set nn = "(s,p,o) in rdf_" + nam + "(\""+filen+"\") " + "or " + nn;
    return substring(nn, 0, char_length(nn)-5);
    end;

create function rdfclass_triples(Charstring f) ->
       Bag of (Charstring s, Charstring p, Charstring o)
  /* Generates triples (TM_object,#type,the_class)
     for each imported TM object */
  as  	select rdf_classview(t,f)
        from TM_object t, integer num where idTMO(t)=(f, num);

create function UPVname(Charstring  xtmfile)->Charstring 
as return substring(xtmfile,0,char_length(xtmfile)-5);

create function generate_TM_rdf_triples(Charstring file, Charstring upv)->Charstring ch
  /* Generates the triple view over the all imported xtm data */
  as  
 select  "create function tm_rdf_triples_"+upv+"()-> 
                 Bag of (Charstring s, Charstring p, Charstring o)
  	as select s,p,o 
     	from charstring s, charstring p, charstring o
     	where (s,p,o) in rdfclass_triples(\""+file+"\") 
              or (s,p,o) in tm_rdfschema_triples_mat() or " + 
          make_statement(file)+";";


create function generate_TM_rdf_triples_lit(Charstring file, Charstring upv)->Charstring ch
  /* Overload the triple view function with dummy to patch SparQL parser*/
  as  
 select  "create function tm_rdf_triples_"+upv+"(Charstring lit)-> 
                 Bag of (Charstring s, Charstring p)
  	as select s,p 
     	from charstring s, charstring p
     	where (s,p,lit) in tm_rdf_triples_"+upv+"();";

create function UPV(Charstring file)->Charstring as stored;

create function setUPV(Charstring file)->Charstring
  as set UPV(file)= substring(extract_nickname(file),0,char_length(extract_nickname(file))-5);


/*** Generate RDF view functions ***/

generate_all_rdfviews(); /* Generates meta-functions for Topic Maps */

materialize_TM_RDFschema_triples(); /* Materialize TM_rdfdata_triples() */


create function generate#TMtable(Charstring upvname)->Charstring ch
  /* Generates the triple view over the all imported xtm data */
  as select 
"create function #"+upvname+"()
                 -> Bag of (Charstring s, Charstring p, Charstring val)
  as select s,p,v 
     from Charstring s, Charstring p, Charstring v 
     where (s,p,v) in tm_rdf_triples_"+upvname+"();";

create function generate#TMtable_lit(Charstring upvname)->Charstring ch
   as select 
"create function #"+upvname+"(Charstring lit)
                 -> Bag of (Charstring s, Charstring p)
  as select s,p 
     from Charstring s, Charstring p 
     where (s,p,lit) in tm_rdf_triples_" + upvname+"();";

create function return_upvname(Charstring url)->Charstring
  as select substring(url, char_length(url)-8 , char_length(url)-5);

create function importTopicMap(Charstring xtmfile) -> Object
/*Loads the xtm file and generates the UPV  if it has not been generated
with the name given as function argument, i.e upvname*/
as begin
   declare Charstring upv, Charstring uri, Charstring upvname;
   set upv=UPV(xtmfile);
   set upvname = substring(xtmfile, char_length(xtmfile)-7, 
                           char_length(xtmfile)-5);
   if upv=nil then    
      begin
	 set UPV(xtmfile)=upvname; 
	 loadXTM(xtmfile);
	 eval(generate_TM_rdf_triples(xtmfile, upvname));
	 eval(generate_TM_rdf_triples_lit(xtmfile, upvname));
	 eval(generate#TMtable(upvname));
	 eval(generate#TMtable_lit(upvname));
  	 set URIofUPV("#"+upvname)=xtmfile;	 
	 set URIofUPV("tm_rdf_triples_"+upvname)="";
	 set uri= "tm_rdf_triples_"+upvname+"()";  	 	
      end;
end;


