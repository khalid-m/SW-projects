/*SQL questions */

set :sql_content1 = 
"SELECT val 
 FROM TM 
 WHERE p='http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAMESTRING';";

/*The result
0.2 s
*/


set :sql_content2 = 
"SELECT t1.s 
 FROM TM t1, TM t2
 WHERE t2.p='http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAMESTRING' AND t2.val='nom de plume' AND t1.val=t2.s;";

/*The result
sql(:sql_content2);
{"http://udbl.it.uu.se/TopicMap#1846"}
0.63 s
*/ 


set :sql_content3 =
"SELECT t3.val 
 FROM TM t1, TM t2, TM t3
 WHERE t2.p='http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAMESTRING' AND t2.val='nom de plume' AND t1.val=t2.s AND t3.p='http://user.it.uu.se/~udbl/TMRDF/Schema#OCCURRENCE' AND t3.s=t1.s;";

sql(:sql_content3);
/*The result
{"http://udbl.it.uu.se/TopicMap#2751"}
{"http://udbl.it.uu.se/TopicMap#2750"}
74.594 s 
*/

set :sql_content4 =
"SELECT t1.val 
 FROM TM t1, TM t2, TM t3, TM t4
 WHERE t1.p='http://user.it.uu.se/~udbl/TMRDF/Schema#REFERENCE' AND t1.s=t2.val AND t2.p='http://user.it.uu.se/~udbl/TMRDF/Schema#OCCURRENCE'
       AND t2.s=t3.s AND t3.val = t4.s AND t4.p='http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAMESTRING' AND t4.val = 'nom de plume';";

/*The result
{"file:///C|/ontopia/topicmaps/opera/occurs/nom-de-plume.htm"}
{"http://www.ontopia.net/topicmaps/examples/opera/occurs/nom-de-plume.htm"}
81.5 s
*/