/*Retrieves the names of all operas (all 711 topics)*/
set :sparql1 = "SELECT ?topicname
	       FROM <http://user.it.uu.se/~udbl/software/swatm/opera.xtm>
	       WHERE {?tmo  <http://udbl2.it.uu.se/swatm:BASENAMESTRING> ?topicname}
               ORDER BY ?toicname ";

sparql(:sparql1);

set :sparql3  = "SELECT ?tm2 ?tm3
		FROM <http://user.it.uu.se/~udbl/software/swatm/opera.xtm>
		WHERE {?tm0  <http://udbl2.it.uu.se/swatm:BASENAMETOPIC> ?tm1.
		       ?tm1  <http://udbl2.it.uu.se/swatm:BASENAMESTRING> 'Rigoletto'. 
		       ?tm0  <http://udbl2.it.uu.se/swatm:OCCURRENCETOPIC> ?tm2.
         	       ?tm2  <http://udbl2.it.uu.se/swatm:INSTANCEOFOCCURRENCE> ?tm3}";
sparql(:sparql3);

