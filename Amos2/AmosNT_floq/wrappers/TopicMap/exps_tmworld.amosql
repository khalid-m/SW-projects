set :rdql_hybrid = "SELECT ?iofoc, ?tm3 
		       	FROM <http://user.it.uu.se/~udbl/TMRDF/>
			WHERE (?tm0 , <http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAME>, ?tm1)
			      (?tm1 , <http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAMESTRING>, 'Topologi Schematron Validator') 
			      (?tm0 , <http://user.it.uu.se/~udbl/TMRDF/Schema#OCCURRENCE>, ?tm2)
        		      (?tm2 , <http://user.it.uu.se/~udbl/TMRDF/Schema#REFERENCE>, ?occurrence)
			      (?tm2 , <http://user.it.uu.se/~udbl/TMRDF/Schema#INSTANCEOFOCCURRENCE>, ?iofoc)
                              (<http://user.it.uu.se/~udbl/TMRDF/Schema#INSTANCEOFOCCURRENCE>, <http://www.w3.org/2000/01/rdf-schema#domain>,?tm3)
			AND ?occurrence  != <http://www.topologi.com/validator/> ";

rdql(:rdql_hybrid);

