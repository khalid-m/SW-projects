set :rdql_content11 = "SELECT ?basenamestring
			FROM <http://user.it.uu.se/~udbl/TMRDF/>
			WHERE (?tmo , <http://user.it.uu.se/~udbl/TMRDF/Schema#BASENAMESTRING> ?basenamestring)";

rdql(:rdql_content11);

count(rdql(:rdql_content11));
