create function GetPlaceList(charstring placephrase,integer maxitems,charstring imagepresence)-><charstring placename,charstring state, charstring country,real lon, real lat,integer availablethememask,charstring placetypeid,integer population>
	as select res[0],res[1],res[2],res[3],res[4],res[5],res[6],res[7] 
	   from vector out, vector res
	  where out =cwo("http://www.terraserver.microsoft.com/TerraService2.asmx?WSDL","TerraService","GetPlaceList",{'GetPlaceList',{'placeName',placephrase,'MaxItems',maxitems,'imagePresence',imagepresence}},"testquery/placelist_sdef.xq")and res=elementOf(out);

/*create function GetPlaceFacts(charstring placename,charstring state,charstring country)-><charstring placename1,charstring state1, charstring country1,real lon, real lat,integer availablethememask,charstring placetypeid,integer population>
	as select res[0],res[1],res[2],res[3],res[4],res[5],res[6],res[7] 
	   from vector out, vector res
	  where out =cwo("http://www.terraserver.microsoft.com/TerraService2.asmx?WSDL","TerraService","GetPlaceFacts",{'GetPlaceFacts',{'place',{'City',placename,'State',state,'Country',country}}},"testquery/placefacts_sdef.xq")and res=elementOf(out);*/

create function GetPlaceFacts(charstring placename,charstring state,charstring country)-><real lon, real lat,integer availablethememask,charstring placetypeid,integer population>
	as select res[3],res[4],res[5],res[6],res[7] 
	   from vector out, vector res
	   where out =cwo("http://www.terraserver.microsoft.com/TerraService2.asmx?WSDL","TerraService","GetPlaceFacts",{'GetPlaceFacts',{'place',{'City',placename,'State',state,'Country',country}}},"testquery/placefacts_sdef.xq")and res=elementOf(out);


create function ConvertPlaceToLonLatPt(charstring placename,charstring state,charstring country)-><real lon, real lat>
	as select res[0],res[1] 
	   from vector out, vector res
	  where out =cwo("http://www.terraserver.microsoft.com/TerraService2.asmx?WSDL","TerraService","ConvertPlaceToLonLatPt",{'ConvertPlaceToLonLatPt',{'place',{'City',placename,'State',state,'Country',country}}},"testquery/convertplacetolonlat_sdef.xq")and res=elementOf(out);

create function ConvertLonLatPtToNearestPlace(real lon, real lat)-><charstring placename>
	as select res[0] 
	   from vector out, vector res
	 where out =cwo("http://www.terraserver.microsoft.com/TerraService2.asmx?WSDL","TerraService","ConvertLonLatPtToNearestPlace",{'ConvertLonLatPtToNearestPlace',{'point',{'Lon',lon,'Lat',lat}}},"testquery/convertlonlatpttonearestplace_sdef.xq")and res=elementOf(out);

create function GetLatLong(charstring zipcode)-><charstring placename, charstring state, real lon, real lat>
	as select res[0],res[1],res[2],res[3] 
	   from vector out, vector res
	 where out =cwo("http://ws.cdyne.com/ziptogeo/zip2geo.asmx?wsdl","Zip2Geo","GetLatLong",{'GetLatLong',{'zipcode',zipcode,'LicenseKey','0'}},"testquery/getlatlong_sdef.xq")and res=elementOf(out);

