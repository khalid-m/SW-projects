create function findelements(charstring wsname,charstring opname)
                ->Element e 
			as 
			   select e 
   			   from Operation op, Service ws, Element e
   			   where name(op)=opname and name(ws)=wsname and 
         			port(ws)=op and input(op)=e ;

create function findresult1()->vector rs  
				as select value(ve) from Vecele1 ve where name(ve)="ele1";

create function findresult2()->vector rs  
				as select value(ve) from Vecele2 ve where name(ve)="ele2";
	 
