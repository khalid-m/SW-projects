create function maxoccurs(Charstring f)->Integer as select maxoccurs(e) from Element e where name(e)=f;

create function elementOf(vector v)-> Object
  as select v[i] from integer i;

lisp;
(defun cwo (fno wd ws op t q r)
  (mapfunctionres 'callwebserviceoperation (list wd ws op t q) nil
	(f/l (row)
		       (osql-result wd ws op t q (nth 0 row)))))
:osql

/*****************************************************************************/
		/* callwebservice  functions  */
/*****************************************************************************/

create function initoperation(charstring name, charstring soapactionuri, 
                                charstring style ,charstring encodingstyle, 
                                charstring namespaceuri, charstring targeturl,
                                vector t,charstring query)
                 -> vector v 
as foreign  "JAVA:webservicewrapper/initoperation";  


create function cwo(charstring wsdluri,charstring wsname,charstring opname, 
                               vector t,charstring query)->vector v as foreign "cwo";
 
create function callwebserviceoperation(charstring wsdluri,charstring wsname,charstring opname, 
                               vector t,charstring query)->vector v as 
 select initoperation(opname,soapactionuri(op),style(op),
                        encodingstyle(op),namespaceuri(ws),targeturl(op),t,
                        query)
 from Operation op, Service ws 
 where name(op)=opname and name(ws)=wsname and wsdluri(ws)=wsdluri and port(ws)=op;
 

/*****************************************************************************/
/*calculate the excution time of query*/
/****************************************************************************/
create function testsql(Charstring sql)->Real c 
as begin set c = clock();
         sql(sql);
         result clock()-c;
   end;
 

