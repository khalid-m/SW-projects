(defun makerecord(fno v r) 
  (osql-result v (make-record v)))

(defun put_record(fno v k val r) 
  (osql-result v k val (record-put v k val)))

(defun vref_bbf(fno H K R) 
  (let ((R (record-get H K))) 
    (if R (osql-result H K R))))

(defun vref_bff(fno H K R) 
  (do ((I 0 (+ 2 I)))
      ((= I (Length (record-fields H))))
    (osql-result H (aref (record-fields H) I) 
		 (aref (record-fields H) (+ 1 I)))))

(defun vref_any_bbf(fno H I R) 
  (osql-result H I (aref (record-fields H) I)))
(defun vref_any_bff(fno H K R) 
  (do ((I 0 (+ 2 I)))
      ((= I (Length (record-fields H))))
    (osql-result H I (aref (record-fields H)(+ 1 I)))))
(defun all_value(fno H R) 
  (do ((I 0 (+ 1 I)))
      ((= I (Length (record-fields H))))
    (osql-result H (aref (record-fields H) I))))

(set-alias-name 'sequence 'vector  _type_)
(set-alias-name 'sequence 'vector  _function_)
		       
:osql
create function make_record(Vector)->Record as foreign "makerecord"; 
create function put_record(Record,Charstring,Object)->Record as foreign "put_record"; 
create function vref(Record,Charstring)->Object as multidirectional ("bbf" foreign "vref_bbf")("bff" foreign "vref_bff");
create function vref(Record,Integer)-><Object> as multidirectional ("bbf" foreign "vref_any_bbf")("bff" foreign "vref_any_bff");
create function concat_obj(Object a, Object b)-> vector as
					begin
					 result {a,b};
					end;
create function all_value(Record R)-> <Object> as foreign "all_value";

create function elementOf(sequence s)-> Object
  as select s[i] from integer i;


create function concat_obj_seq(Object a, Object b)-> sequence as
					begin
					 result {a,b};
					end;					   