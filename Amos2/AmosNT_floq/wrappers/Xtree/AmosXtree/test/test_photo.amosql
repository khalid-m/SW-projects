/*Create an album named as FamilyAlbum :) */
print("Create family album");
set :familyAlbum = newAlbum("FamilyAlbum");

/*add all pictures which are represented by vector of integer.
One picture per line
data_4.txt contains 100000 vectors 4 dimensions*/

print("Add pictures into the album");
add_pictures(:familyAlbum, "test\\data\\data_4.txt");

lisp;

(checkequal 
 "Xtree wrappers"
 ((osql "q1('Caption17', 3);")
