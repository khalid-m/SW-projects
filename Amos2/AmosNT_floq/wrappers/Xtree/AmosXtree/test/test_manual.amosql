/*Create an album named as FamilyAlbum :) */
print("Create family album");
set :familyAlbum = newAlbum("FamilyAlbum");

print("Add pictures into the album");
set :pic01 = newPicture(:familyAlbum, "test\\data\\pictures\\Image01.jpg", "Caption01");
set :pic02 = newPicture(:familyAlbum, "test\\data\\pictures\\Image02.jpg", "Caption02");
set :pic03 = newPicture(:familyAlbum, "test\\data\\pictures\\Image03.jpg", "Caption03");
/*Picture 4 has a same feature as picture 1*/
set :pic04 = newPicture(:familyAlbum, "test\\data\\pictures\\Image01.jpg", "Caption04");
set :pic05 = newPicture(:familyAlbum, "test\\data\\pictures\\Image05.jpg", "Caption05");
set :pic06 = newPicture(:familyAlbum, "test\\data\\pictures\\Image06.jpg", "Caption06");

addFeatureIndex(picture_index(), features(:pic01), :pic01);
addFeatureIndex(picture_index(), features(:pic02), :pic02);
addFeatureIndex(picture_index(), features(:pic03), :pic03);
addFeatureIndex(picture_index(), features(:pic04), :pic04);
addFeatureIndex(picture_index(), features(:pic05), :pic05);
addFeatureIndex(picture_index(), features(:pic06), :pic06);

/*removeFeatureIndex(picture_index(), features(:pic04), :pic04);*/
q1("Caption01", 3);