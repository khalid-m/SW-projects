# If no IP communication is desired:
# (i) set env variable NOCOMM to 1.
# (ii) define NOCOMM to C preprocessor
AMOSHOME=../..
HOSTTYPE=i386
SRC= aggops.c amosfns.c winagg.c cinterf.c init.c event_manager.c text_fns.c \
   text_match.c comm.c math_fns.c compl_fns.c \
   commands.c getopt.c os_fns.c lexyy.c parser_tab.c SQLParse.c sql_parser_tab.c sql_lexyy.c uri.c \
   lispfns.c storagetypes.c binary.c filefns.c

BINS=eval.o extfns.o print.o read.o storage.o \
   misc.o olog.o rel.o hist.o linh.o htbl.o \
   oid.o files.o systemfns.o typecheck.o top.o \
   fncall.o index.o btree.o libyywrap.o unix_socket.o a_time.o
OBJDIR=./$(HOSTTYPE)
CFLAGS =  -I$(AMOSHOME)/C -I$(AMOSHOME)/system/include -I$(AMOSHOME)/system/C \
          -O2 -DUNIX=1 -DLINUX=1

BINDIR=$(AMOSHOME)/bin
CC = gcc
OBJS = $(SRC:%.c=$(OBJDIR)/%.o)

all: $(BINDIR)/amos2 $(BINDIR)/amos2.dmp

../C/sql_parser_tab.c: ../C/sql_parser.y
	cd ../C && bison -d -osql_parser_tab.c -p SQL sql_parser.y
	cd ../C && flex -osql_lexyy.c  -PSQL -i sql_lexer.l

../C/parser_tab.c: ../C/lexyy.c


$(BINDIR)/libamos.a: ../C/sql_parser_tab.c
../C/lexyy.c: ../C/parser.y ../C/scanner.l
	cd ../C && bison -d -oparser_tab.c parser.y
	cd ../C && flex -olexyy.c scanner.l

$(BINDIR)/libamos.a: ../C/parser_tab.c ../C/sql_parser_tab.c $(HOSTTYPE)/*.o ../C/*.c
	cd ../C && $(CC) $(CFLAGS) -c $(SRC)
	cp ../C/*.o $(OBJDIR)
	cd $(OBJDIR) && ar rc ../$(BINDIR)/libamos.a *.o

$(BINDIR)/amos2: $(BINDIR)/libamos.a $(AMOSHOME)/C/main.o 
	$(CC) -O2 -o $(BINDIR)/amos2 $(AMOSHOME)/C/main.c $(BINDIR)/libamos.a -lm -lnsl  

$(BINDIR)/amos2.dmp: $(BINDIR)/amos2 
	$(BINDIR)/amos2 -i../../lsp -o "save '$(BINDIR)/amos2.dmp';quit;"


