lisp;
(load "defs.lsp")
:osql

create function niota(Number n)->Number as iota(1, n);

create function cciota(Integer n)->Integer as count(ciota(n));

create function background(Integer w)->Real as foreign 'backgroundbf';

create function zbg(Integer s)->Real as zip(background(s), background(s));
