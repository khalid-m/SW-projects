/*----------------------------------------------------------------------
Navie implementation of KNN
-----------------------------------------------------------------------*/

create function distance(Vector of Number x, Function disfn,
	 Vector of Number y)-> Number distance
  /* Compute the distance between x and y using the distance function disfn */
  as (apply(disfn, {x, y}))[0];

create function classdistances(Vector of Number x, Function disfn,
			       Bag of (Object, Vector of Number) cp)
       -> Bag of (Number distance, Object cid)
 /* Given a distance function disfn(x,y)
    calculate all distances from query point x to the points
    in set of classified points cp */
 as select distance(x, disfn, v), cid
    from Object cid, Vector of Number v
    where (cid,v) in cp;


create function k_nearest(Vector of Number x, Number k, 
                          Function disfn, 
			  Bag of (Object, Vector of Number) cp)
                       -> Bag of (Object, Object)
  /* Function searching K nearest neighbours of a query point x 
     among classified points cp using disfn with. Brute force algorithm. */
  as leastk(classdistances(x, disfn, cp), k);


create function k_nearest_with_fn(Vector of Number x, Number k, 
                          Function disfn, 
			  Function fn)
                       -> Bag of (Object, Object)
  as k_nearest(x, k, disfn, cast((select extent(fn)) 
		  as Bag of (Number, Vector of Number)));

/*----------------------------------------------------------------------
 Signatures of knn
-----------------------------------------------------------------------*/

/*Case 1 KNN with bag*/
create function knn(Vector of Number, Number k, Bag of Object)
                  -> Bag of Object 
 as multidirectional
    ('bbbf' foreign 'knnsearch_with_bag---+');

/*Case 2 KNN with function*/
create function knn(Vector of Number , Number k, Function fn)
                  -> Bag of Object 
 as multidirectional
    ('bbbf' foreign 'knnsearch_with_fn---+');



