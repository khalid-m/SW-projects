/*--------------META DATA------------------------------------------------*/
/* ball id maps to sensor id */
create function ball(Number bid) -> Integer sid key 
  /* Sensor id SID for a given ball BID */
  as stored;

create function ballsensors()-> Bag of Number 
  /* The SIDs of the ball sensors */
  as select sid
     from Number sid, Number bid  
     where ball(bid) = sid;

/* team id maps to player id */
create function team(Integer tid) -> Bag of Integer pid
   /* The player ids PID in team TID */
   as stored;

/* player info */
create function player(Number pid) -> Charstring name
  /* The name of player PID */
  as stored;

create function playerSensor(Number sid) -> Number pid
  /* The player id PID of sensor SID */
  as stored;

create function referee(Number rid) -> (Number left, Number right)
  /* two sensors of the referee id RID */
  as stored;

/*--------------EVENT DATA------------------------------------------------*/
/* sensor readings */
create function sensor(Number sid) -> Bag of Vector of Number
  /* Cheng? */
  as stored;

create function psfrequency()->Number
  /* Cheng? */
  as 200;

create function ballfrequency()->Number
  /* The frequency of the ball readings */
  as 2000;

create function reportfrequency() -> Number
  /* Cheng? */
  as 50;

create function microWinSize()-> Number as
  /* Cheng? */
  1.0;
/*2013-04-11 Change to 1 second according to FAQ#15*/

/* Stream schema */
create function ts(vector of number v) -> Number
  /* Event time stamp */
  as v[0];
create function sid(vector of number v) -> number
  /* Sensor id */
  as floor(v[1]);
create function x(vector of number v) -> number
  /* X position */
  as v[2];
create function y(vector of number v) -> number
  /* Y position */
  as v[3];
create function z(vector of number v) -> number
  /* Z position */
  as v[4];
create function vabs(vector of number v) -> number
  /* Velosity */
  as v[5] ;
create function aabs(vector of number v) -> number
  /* Acceleration */
  as v[9] ;
create function vx(vector of number v) -> number
  /* Speed in X direction */
  as v[6] ;
create function vy(vector of number v) -> number
  /* Speed in Y direction */
  as v[7];
create function vz(vector of number v) -> number
  /* Speed in Z direction */
  as v[8];
create function ax(vector of number v) -> number
  /* Acceleration in X direction */
  as v[10];
create function ay(vector of number v) -> number
  /* Acceleration in Y direction */
  as v[11];
create function az(vector of number v) -> number
  /* Acceleration in Z direction */
  as v[12];

create function ts(Numarray v) -> Number as v[0];
create function sid(Numarray v) -> number as floor(v[1]);
create function x(Numarray v) -> number as v[2];
create function y(Numarray v) -> number as v[3];
create function z(Numarray v) -> number as v[4];
create function vabs(Numarray v) -> number as v[5] ;
create function vx(Numarray v) -> number as v[6] ;
create function vy(Numarray v) -> number as v[7];
create function vz(Numarray v) -> number as v[8];
create function aabs(Numarray v) -> number as v[9] ;
create function ax(Numarray v) -> number as v[10];
create function ay(Numarray v) -> number as v[11];
create function az(Numarray v) -> number as v[12];

create function pico2sec(Number pico) -> Number
  as pico * 10^-12;

lisp;
(defun x (v) (na-elt v 2))
(defun y (v) (na-elt v 3))
(defun debsts (v) (na-elt v 0))
:osql

create function hitacc() -> Number
  /* The ball acceleration threshold for hitting the ball */
  as 55.0;

create function isBallHitter(Numarray v) -> Boolean
  /* Is a tuple a ball hitter event? */
  as dim(v) = 3;

create function start1sthalf()-> Number 
  /* Start time of 1st half of the game */
  as 10753295594424116; /*10753295594424116 10748401988186756*/

create function start2ndhalf() -> Number
  /* Start time of second half of the game */
  as 13086639146403495;

create function end1sthalf()-> Number 
  /* Duration of first half of the game */
  as pico2sec(12557295594424116 - start1sthalf());

create function end2ndhalf()-> Number 
  /* Duration of the whole game, including the break */
  as pico2sec(14879639146403495 - start1sthalf());

create function firsthalf() -> number
  /* Duration of first half of game in seconds */
  as pico2sec(12557295594424116 - start1sthalf());

create function secondhalf() -> Number
  /* Start of second half in seconds after start of first half */
  as pico2sec(start2ndhalf() - start1sthalf());

create function secondhalfend() -> number
  /* Duration of whole game, including the break, in seconds */
  as end2ndhalf();


/*--------------UTILITY FUNCTIONS--------------------------------------------*/
create function isInterrupt(Vector of Number v)->Boolean 
  /* Is v an interrupt event? */
  as sid(v) = -1;

create function isInterrupt(Numarray v)->Boolean 
  /* Is v an interrupt event? */
  as sid(v) = -1;

create function isInterruptBegin(Vector of Number v)->Boolean 
  /* Check if current event indicates that an interrupt is raised by referee */
  as isInterrupt(v) and v[2]=1;

create function isInterruptBegin(Numarray v)->Boolean 
  /* Check if current event indicates that an interrupt is raised by referee */
  as isInterrupt(v) and v[2]=1;

create function isInterruptEnd(Vector of Number v)->Boolean 
  /* Check if current event indicates that an interrupt is stopped */
  as isInterrupt(v) and v[2]=0;

create function isInterruptEnd(Numarray v)->Boolean 
  /* Check if current event indicates that an interrupt is stopped */
  as isInterrupt(v) and v[2]=0;

create function isPlayer(Vector of Number v)->Boolean 
  /* Is v a player event? */
  as some(select playerSensor(sid(v)));

create function isPlayer(Numarray v)->Boolean
  /* Is v a player event? */
  as some(select playerSensor(sid(v)));

create function isBall(Vector of Number v)->Boolean 
  /* Is v a ball event? */
  as sid(v) in ballsensors();

create function isBall(Numarray v)->Boolean 
  /* Is v a ball event? */
  as select sid(v) in ballsensors();

create function isLeftSensor(Number sid) -> Boolean
  /* Is SID a left sensor of a player or the referee? */
  as sid in {13, 97, 47, 49, 19, 53, 23, 57, 59,
             61, 99, 63, 65, 67, 69, 71, 73, 75, 105};

create function isRightSensor(Number sid) -> Boolean
  /* Is SID a right sensor of a player or the referee? */
  as sid in {14, 98, 16, 88, 52, 54, 24, 58, 28,
	     62, 100, 64, 66, 68, 38, 40, 74, 44, 106};

create function ballIn(Vector of Number v) -> Boolean 
  /* Is the ball in the field? 
     Approximate since the field is not a perfect rectangle.
     The corners should perhaps be separate functions */
  as 0.0 <= x(v) and 
     x(v) <= 52.477 and  
     -33.939 <= y(v) and 
     y(v) <= 33.941;

create function ballIn(Numarray v) -> Boolean
  /* Is the ball in the field? */
  as  0.0 <= x(v) and 
      x(v) <= 52.477 and 
      -33.939 <= y(v) and 
      y(v) <= 33.941;

create function whichteam(Number pid)->Number
  /* To which team does player PID belong */
  as select tid 
     from Number tid 
     where pid in team(tid);
parteval("whichteam"); /* Never changes! */

/*returns the team for which the player pid plays
[a faster version of whichteam()]*/
create function team_id(number pid)->number as
begin
	if (pid>=1) and (pid<=8) then
		return 1;
	if (pid>=9) and (pid<=16) then
		return 2;
	if (pid<1) or (pid>16)then return -1;
end;
parteval('team_id');

create function isInterruptBreakStart(Numarray v)->Boolean 
  /* Check if current event indicates that an interrupt is a break start */
  as isInterrupt(v) and v[2]=-2;

create function isInterruptBreakEnd(Numarray v)->Boolean 
  /* Check if current event indicates that an interrupt is a break start */
  as isInterrupt(v) and v[2]=-3;

create function isInterruptBreakStartv(Vector of Number v)->Boolean 
  /* Check if current event indicates that an interrupt is a break start */
  as isInterrupt(v) and v[2]=-2;

create function isInterruptBreakEndv(Vector of Number v)->Boolean 
  /* Check if current event indicates that an interrupt is a break start */
  as isInterrupt(v) and v[2]=-3;

create function isBreakInterrupt(Numarray e) -> Boolean
  as isInterrupt(e) and (e[2] = -2 or e[2] = -3);

lisp;

(defglobal _playersensor_ (theresolvent 'playersensor))

(defun playersensor (sid)
  (let (res)
    (assignfunction _playersensor_ (vector sid) '(res))
    res))

:osql
