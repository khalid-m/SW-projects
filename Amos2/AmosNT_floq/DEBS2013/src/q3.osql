load_lisp('heatmap.lsp');

/* functions to generate 1 second aggregated sub windows */
create function frontendinit_hm() -> Boolean
  as foreign 'frontendinit-hm';

create function frontendadd_pos(Numarray pos) -> Boolean 
  as foreign 'frontendadd-pos';

create function frontendreport_HM ()
                    -> (Number pid, Number cellid, Number ts, Number count)
  as foreign 'frontendreport-HM';

create function gameStart() -> Integer as stored;
set gameStart() = 0;

create function rtime() -> Number as stored; /* wall clock */

create function current_second() -> Number as stored;

create function set_current_second(Number s)-> Boolean
  as set current_second()=s;

create function frontendq3_0(Numarray pos) -> Bag of Numarray
  as begin
       if gamestart() = 0
       then begin
	      print("Game starts");
	      frontendinit_hm();
	      set gamestart() = 1;
            end;
       /* ts between current time and current time + 1  then only add */
       if (ts(pos) >= 0) then
       begin
         if (floor(ts(pos)) = current_second())
	  then begin frontendadd_pos(pos); end
         else  /* the second turns, make reports */
	  begin
	    for each Number pid, Number cellid, Number ts, Number count
              where (pid, cellid, ts, count) in frontendreport_HM()
              return darray({current_second(), pid, cellid, ts, count});
	    set_current_second(floor(ts(pos)));  /* take care of the time stamp skew */
	    frontendinit_hm();
	    frontendadd_pos(pos);
          end;
       end;
     end;

create function frontendq3(Stream of Numarray pos) -> Stream of Numarray
  as streamof(frontendq3_0(in(pos)));

/* functions for the heatmap */
/*hm_base is an array of  size sub hm_sec windows*/
create function init_hm(Number size) -> Boolean
  as foreign 'init-hm';

/*Put data to hm_sec*/
create function add_pos(Numarray pos, Number sec) -> Boolean 
  as foreign 'add-pos';

/*Implements the window slide,*/
create function slide_HM_base(Number sec) -> Boolean 
  as foreign 'slide-HM-base';

create function report_HM ()
                    -> (Number ts, Integer streamid, Number pid, 
                        Number cell_x1, Number cell_y1, Number cell_x2, 
                        Number cell_y2, Number perc)
		       /*(Number ts, number pid, number cell_id, number perc)*/
  as foreign 'report-HM';

create function q3init(Integer wsize) -> Boolean
  as begin
       init_hm(60 * wsize);
       clear_function("rtime");
       set_current_second(0);
       set gamestart() = 1;
     end;

create function fstNMinute(Number sec, Integer n) -> Boolean
  as select sec < 60 * n;

create function q3_0(Numarray pos, Integer wsize) -> Bag of Vector of Number
  as begin
       if gamestart() = 0 then begin print("init first half"); q3init(wsize); end /* 1st half begins */
       else if ts(pos) = secondhalf()    /* 2nd half begins */
         then begin print("init second half"); q3init(wsize); end;
       /* ts between current time and current time + 1  then only add */
       if (ts(pos) >= 0) then
       begin
         if (floor(ts(pos)) = current_second())
	  then begin add_pos(pos, current_second()); end
         else  /* the second turns, make reports */
	  begin
	    for each Number ts, Integer streamid, Number pid, Number cell_x1, 
                     Number cell_y1, Number cell_x2, Number cell_y2, Number perc
              where (ts, streamid, pid, cell_x1, cell_y1, cell_x2, cell_y2, perc)
                    in report_HM()
            return {ts, streamid, pid, cell_x1, cell_y1, cell_x2, cell_y2, perc};
	    /*return {ts, streamid, pid, cell_x1, cell_y1, cell_x2, cell_y2, perc};*/
	    /*print({ts, streamid, pid, cell_x1, cell_y1, cell_x2, cell_y2, perc});*/
	    if notany(fstNMinute(floor(ts(pos)), wsize)) then
	    for each Number i where i in iota(current_second() + 1, floor(ts(pos)))
	     begin
		  print({"slide for second:", i});
                  slide_HM_base(i);
             end;
	    set_current_second(floor(ts(pos)));
	    add_pos(pos, current_second());
	    print({"new second:", current_second()});
          end;
       end;
     end;

create function q3w(Stream of Numarray s, Integer wsize) -> Stream of Boolean
  as streamof(writecsvfile("output/q3r" + wsize + "m.csv", q3_0(in(s), wsize)));


create function q3(Stream of Numarray s) -> Stream
  as mergestreams(svali:mapstreams(splitstream(frontendq3(s), 4, #'broadcastna'),
                                      {#'q3w', #'q3w', 
				       #'q3w', #'q3w'},
				      {{1}, {5}, {10}, {60}}));


/* This should happen at the beginning of each half */
/* included in q3() */
/* q3init(1); */

