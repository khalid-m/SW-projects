/*-------------------------SPLIT tester---------------------------------------*/
create function q1tester(Numarray v) -> Boolean
  as isPlayer(v);

create function q3tester(Numarray v) -> Boolean
  as isPlayer(v);

/*-------------------------SPLITTER ---------------------------------------*/
create function splitterQ1(Numarray v, Integer fanout) -> (Integer, Numarray)
  as select i, v from Integer i
     where i = 0 and q1tester(v);

create function splitterQ2Q4(Numarray v, Integer fanout) -> (Integer, Numarray)
  as select i, v from Integer i
     where i = 0;

create function splitterQ3(Numarray v, Integer fanout) -> (Integer, Numarray)
  as select i, v from Integer i
     where i = 0 and q3tester(v);

/*-------------------------QUERY 1 ---------------------------------------*/
create function q1alone(Charstring file) -> Object
  as in(mergestreams(svali:mapstreams(splitstream(inputstreamna(file), 1, #'splitterQ1'),
                                      {#'q1'},{{}})));

/*-------------------------QUERY 2 ---------------------------------------*/
create function ballhitterSplit1(Numarray v, Integer fanout) -> (Integer, Numarray)
  as select i, v from Integer i
     where (i = 0 and (isBallHitter(v) or isInterruptBreakStart(v) or isInterruptBreakEnd(v)));


create function q2(Stream of Numarray s) -> Stream
  as mergestreams(svali:mapstreams(splitstream(ballhitter_process(s), 1, #'ballhittersplit1'),
                                      {#'playerpossesion'},
				      {{}}));


create function q2alone(Charstring file) -> Object
  as in(mergestreams(svali:mapstreams(splitstream(inputstreamna(file), 1, #'splitterQ2Q4'),
                                      {#'q2'},{{}})));

/*-------------------------QUERY 4 ---------------------------------------*/
create function ballhitterSplit2(Numarray v, Integer fanout) -> (Integer, Numarray)
  as select i, v from Integer i
     where 
	  (i=0 and isInterruptBreakStart(v)=FALSE and isInterruptBreakEnd(v)=FALSE);

create function anotherq4(Stream of Numarray s) -> Stream
  as mergestreams(svali:mapstreams(splitstream(ballhitter_process(s), 1, #'ballhittersplit2'),
                                      {#'q4'},
				      {{}}));
create function q4alone(Charstring file) -> Object
  as in(mergestreams(svali:mapstreams(splitstream(inputstreamna(file), 1, #'splitterQ2Q4'),
                                      {#'anotherq4'},{{}})));

/*-------------------------QUERY 2-QUERY 4 ---------------------------------------*/
create function q2q4alone(Charstring file) -> Object
  as in(mergestreams(svali:mapstreams(splitstream(inputstreamna(file), 1, #'splitterQ2Q4'),
                                      {#'q2q4'},{{}})));

/*-------------------------QUERY 3 ---------------------------------------*/
create function q3alone(Charstring file) -> Object
  as in(mergestreams(svali:mapstreams(splitstream(inputstreamna(file), 1, #'splitterQ3'),
                                      {#'q3new'},{{}})));

/*-------------------------FULL ---------------------------------------*/
create function full(Charstring file)->Boolean
  as debsnew(inputstreamna(file));

/*------------------------- NEW ---------------------------------------*/

create function teamposs_process2(Stream of Numarray pps, 
				  Number wlength, Number slide, Number reportfr)
  -> Stream of Numarray
  as streamof(teamposs_bag(pps, wlength, slide, reportfr));

create function playerpossesion2(Stream of Numarray hitters) -> Vector of Stream of Numarray
  as svali:mapstreams(splitstream(playerposs_report(hitters), 4, #'broadcastna'),
	                          {#'teamposs_process2', #'teamposs_process2', 
		 		   #'teamposs_process2', #'teamposs_process2'},
			 	  {{60, 10, 10}, {300, 10, 10}, {1200, 10, 10}, 
				   {69*60, 10, 10}});

create function merge_playerpossession(Stream of numarray vs) -> Stream of numarray
  as mergestreams(playerpossesion2(vs));

create function test_playerpossession(charstring file) -> stream of numarray
  as merge_playerpossession(ballhitter_process(inputstreamna(file)));

create function test_possession_vector(charstring file) -> Vector of Stream of Numarray
  as vselect mergestreams(vectorof(s)) from Stream s
    where s in playerpossesion2(ballhitter_process(inputstreamna(file)));

create function simple_test(charstring file) -> Vector of Charstring
  as {"1", "2", "3", "4"};