lisp;

(osql "
set :fullgame= 'data/full-game';")

(checkequal
 "Query 1 Alone"
 ((time (osql "count(q1alone(:fullgame));"))
  '((0)))
 )
(checkequal
 "Query 2 Alone"
 ((time (osql "count(q2alone(:fullgame));"))
  '((0)))
 )

(checkequal
 "Query 4 Alone"
 ((time (osql "count(q4alone(:fullgame));"))
  '((0)))
 )

(checkequal
 "Query 3 Alone"
 ((time (osql "count(q3alone(:fullgame));"))
  '((0)))
 )

(checkequal
 "Whole system"
 ((time (osql "count(full(:fullgame));"))
  '((0)))
 )

:osql