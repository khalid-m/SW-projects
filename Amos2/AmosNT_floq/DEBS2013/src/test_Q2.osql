lisp;
(osql "set :testQ4 = 'data/testQ4.csv';")

(checkequal 
 "Test ballhitter on small data"
 ((osql "count(select v from Numarray v where v in ballhitter_bag(inputstreamna(:testQ4)) and isballhitter(v));")
  '((2))))

(checkequal 
 "Test Ball hitter + ball events"
 ((osql "count(in(select v from Numarray v where v in ballhitter_process(inputstreamna('data/testQ4.csv')) and v[1]!= -1));")
  '((1570))))


(checkequal 
 "Test Player possession"
 ((osql "count(playerposs_bag(streamof(select v from Numarray v where v in ballhitter_bag(inputstreamna('data/testQ4.csv')) and isballhitter(v))));")
  '((0))))

(quote (checkequal 
 "Heavy test 1"
 ((osql "select v[1], v[3] from Numarray v where v in playerposs_bag(ballhitter_process(inputstreamna('data/head4M.csv'))) and v[1]!=-1;")
  '((13.0,2.0) (11.0,3.0) (13.0,2.0) (14.0,2.0) (10.0,2.0) (14.0,2.0) (11.0,2.0) (13.0,2.0) (15.0,1.0) (6.0,1.0) 
    (7.0,1.0)  (6.0,1.0)  (4.0,1.0)  (14.0,2.0) (13.0,3.0) (14.0,1.0) (10.0,1.0) (11.0,3.0) (14.0,2.0) (12.0,2.0)
    (13.0,2.0) (11.0,3.0) (4.0,1.0)  (1.0,2.0)  (4.0,2.0)  (1.0,2.0)  (3.0,2.0)  (5.0,3.0)  (4.0,1.0)  (6.0,1.0)
    (4.0,2.0) (2.0,2.0)   (3.0,2.0) (5.0,2.0)  (4.0,4.0) (11.0,1.0) (2.0,1.0) (10.0,1.0) (11.0,2.0) (4.0,1.0) 
    (3.0,2.0) (5.0,1.0) (4.0,3.0) (2.0,3.0) (3.0,1.0) (4.0,2.0) (5.0,2.0) (7.0,1.0) (4.0,3.0) (2.0,3.0) (12.0,1.0)
    (7.0,1.0) (12.0,4.0) (3.0,1.0) (12.0,1.0) (6.0,1.0) (5.0,1.0) (7.0,3.0) (11.0,1.0) (12.0,2.0) (11.0,1.0)
   (10.0,3.0) (6.0,1.0) (13.0,2.0) (10.0,1.0)))) 
)

:osql



