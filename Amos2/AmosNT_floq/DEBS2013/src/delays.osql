propagate_delays(false);

create function csv_delay(Charstring filename) 
                        -> (Number avg, Number stdev)
  as avgstdev(select v[1]-v[0] 
              from Vector of Number v 
              where v in csv_file_tuples(filename));

create function csv_delays() -> Bag of Vector
  as select {filename,csv_delay("output/"+filename)}
     from Charstring filename
     where filename in dir("output","*.csv");

writecsvfile("delays.csv",csv_delays());
