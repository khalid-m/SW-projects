create function tgoall() -> number 
  /* x coordinate for left goal post of top goal */
  as 22.5785; 
create function tgoalr() -> number
  /* x coordinate for right goal post of top goal */
  as 29.8985;
create function tgoalline() -> number
  /* y coordinate of top goal */
  as 33.941;

create function tgoall_outer() -> number 
  /* left goal post of top goal plus two m margin */
  as 20.5785;
create function tgoalr_outer() -> number
  /* right goal post of top goal plus two m margin */
  as 31.8985;

create function bgoall() -> number
  /* x coordinate for left goal post of bottom goal */
  as 22.560;
create function bgoalr() -> number
  /* x coordinate for right goal post of bottom goal */
  as 29.880;
create function bgoalline() -> number
  /* y coordinate of bottom goal */
  as -33.968;

create function bgoall_outer() -> number
  /* left goal post of bottom goal plus two m margin */
  as 20.560;
create function bgoalr_outer() -> number
  /* right goal post of bottom goal plus two m margin */
  as 31.880;

create function goalbar() -> number
  /* Heigh (z-coordinate) of goal */
  as 2.440;

create function direction_goal(number xmin, number xmax, number y,
                               numarray n) -> boolean
  /* Is the current direction of the ball towards a goal?
     xmin: Left  x coodidate of the goal
     xmax: Right x coordinate of the goal
     y: y coordinate of the goal line
     n: ball properties (ts, sid, x, y, z, vabs, vx, vy, vz, aabs,
                         ax, ay, az) */
  as select true 
       from number t, number dx, number dy, number dz,
            number dist, number sec, number zadd,
            number xpos, number zheight
      where vy(n) != 0 and 
            vabs(n) != 0 and
            dy = y - y(n) and /* straight y distance to goal line */
            t = dy / vy(n) and /* time measure */
            dx = vx(n) * t and /* x distance ball to goal line */
            dz = vz(n) * t and /* vertical distance */
            dist = dx ^ 2 + dy ^ 2 + dz ^ 2 and /* absolute distance squared */
            sec = dist / (vabs(n) ^ 2) and /* time for ball to hit goal line */
            zadd = 9.82 * sec * sec and /* adjust vertical check for gravity */
            xpos = x(n) + dx and
            xmin < xpos and
            xpos < xmax and
            zheight = z(n) + dz and
            -goalbar() - zadd < zheight and /* account for bounces */
            zheight < goalbar() + zadd and 
            sec <= 1.5; /* time to hit must be less/qual than 1.5 seconds */

create function correct_direction(number player_id, numarray n) -> boolean
  /* Has player PID kicked the ball in the direction of the opposite teams's
     goal based on ball event N? */
  as select true
      where ts(n) < secondhalf() and
             (player_id in team(1) and
              direction_goal(tgoall(), tgoalr(), tgoalline(), n)
              or
              player_id in team(2) and
              direction_goal(bgoall(), bgoalr(), bgoalline(), n))
            or
            ts(n) >= secondhalf() and
             (player_id in team(2) and
              direction_goal(tgoall(), tgoalr(), tgoalline(), n)
              or
              player_id in team(1) and
              direction_goal(bgoall(), bgoalr(), bgoalline(), n));

create function pending_direction(number player_id, numarray n) -> boolean
  /* Is shot close enough to be considered pending?  */
  as select true
      where y(n) < tgoalline() and y(n) > bgoalline() and
            (ts(n) < secondhalf() and
              (player_id in team(1) and 
               direction_goal(tgoall_outer(), tgoalr_outer(), tgoalline(), n)
               or
               player_id in team(2) and 
               direction_goal(bgoall_outer(), bgoalr_outer(), bgoalline(), n))
             or
             ts(n) >= secondhalf() and
              (player_id in team(2) and
               direction_goal(tgoall_outer(), tgoalr_outer(), tgoalline(), n)
               or
               player_id in team(1) and 
               direction_goal(bgoall_outer(), bgoalr_outer(), bgoalline(), n)));

create function Q4_b(stream of numarray s) -> bag of numarray
  as begin
     declare integer state,
       number player_id,
       number x_hit, number y_hit, number z_hit;
     set state = 0;
     set player_id = 0;

     for each numarray n where n in s
       if isBallHitter(n) then begin /* ball hit, new state */
         if state = 0 then begin
           set state = 1;
           set player_id = n[1];
         end;
       end
       else if isInterruptBegin(n) then /* reset */
         set state = 0
       else begin
         if state = 1 then begin /* save ball position at hit */
           set state = 2;
           set x_hit = x(n);
           set y_hit = y(n);
           set z_hit = z(n);
         end

         else if state = 2 and /* wait till ball reaches one metre */
                 euclidSq(x(n), y(n), z(n), x_hit, y_hit, z_hit) >= 1 then
           set state = 3

         else if state = 3 then begin
           if pending_direction(player_id, n) then begin
             /* within margin, don't reset state but don't return
                anythin either */
             if correct_direction(player_id, n) then
               /* within goal area, return */
               return darray({ts(n), player_id, x(n), y(n), z(n),
                              vabs(n), vx(n), vy(n), vz(n),
                              aabs(n), ax(n), ay(n), az(n)});
           end
           else
             set state = 0;
         end;
       end;
  end;

create function Q4(stream of numarray s) -> stream of numarray
  as logger("output/q4.csv", streamof(Q4_b(s)));
