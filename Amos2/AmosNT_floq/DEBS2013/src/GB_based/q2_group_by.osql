/*
Q2-ballhitter: the player-ball-hit query.
generates the stream of vector {pid, lts}, 
 - pid is a player who hits the ball,
 - lts is the latest time stamp of the hit event.

Q2-ballhitter output stream looks like
 (pid1, lts1)
 (pid1, lts2)
 (pid1, lts3)
 (pid2, lts4)
 (pid3, lts5)
 (pid1, lts6)
  ....
 
Q2Playerpossession The player ball posession report
 - Input is stream generated by Q2-ballhitter.
 - Output (ts, pid, total time, hits)
 - Give the above example, the output stream looks like

Option 1
  (lts3, pid1, lts3 - lts1, 3)
  (lts5, pid2, lts5 - lts4, 1)
  (lts6, pid3, lts6 - lts5, 1)
  . . .
Option 2
  (lts3, pid1, lts3 - lts1, 3)
  (lts4, pid2, lts4 - lts4, 1)
  (lts5, pid3, lts5 - lts5, 1)
   . . .

We chose the first option 2013-03-21 which is corresponding to the DEBS GC FIgure 4
Note that, option 2 is likely corresponding to the DEBS GC ' reference data

*/

create function tsgap()->Number as stored;
set tsgap()= 1.0; /*1.2*/

create function maxNumber()->Number as 100000000;
create function minNumber()->Number as 0-maxNumber();
create function dropping_playerevent (Numarray v, Number lrts, Number epsilon) -> Boolean as ts(v) > lrts + epsilon;

create function ballhitter_bag(Stream of Numarray inputs)->Bag of Numarray
as
begin
	declare Number sdist, /*shortest distance from the ball to a player*/
		Number cpid, /*the closet player*/
		Number bx, Number by, Number bz, /*Position of ball*/	
		Number pdist, 
		Number ballacc, /*ball acceleration*/
		Number lrts, /*TS of the latest report */
		Boolean gameOn; /*A switch to turn the game ON /OFF*/	

	set sdist = maxNumber();
	set lrts = 0.0;
	set gameOn = FALSE;
	set ballacc = minNumber();
	for each Numarray v where v in inputs
	begin
		if (isBall(v)) then
		begin	
		/*Update ball position*/
			set bx = x(v);
			set by = y(v);
			set bz = z(v);
			set ballacc = aabs(v);
			/*Let all ball events go through*/
			return v;
		end else if (isPlayer(v) and ballacc != minNumber())then
		begin
			/*Update the closet player to the ball*/
			set pdist =  euclidSq({bx, by, bz}, {x(v), y(v), z(v)});
			if (pdist < sdist) then 
			begin 
				set sdist = pdist; 
				set cpid = playerSensor(sid(v)); 
			end;

		        if ( sdist < 1.0 		and /*ball in proximity*/
			     ballacc >= hitacc()        and 
                             dropping_playerevent(v, lrts, 0.2)) 
			then
			begin
					/*Report : Who hits the ball*/
					return darray({ts(v), cpid, 0}); 
					set lrts = ts(v);
					set sdist = maxNumber();			
					set ballacc = minNumber();
			end;
		end
                else if isInterrupt(v) then /*all interruptions event go through*/
                      return v;
	end;
end;


/*Produces a stream of ball hitter pid, ts*/
create function ballhitter_process(Stream of Numarray inputs) -> Stream of Numarray
  as streamof(ballhitter_bag(inputs));


/*Q2 Player possession*/
create function playerposs_bag(Stream of Numarray hitters) -> Bag of Numarray  as
begin
  declare  Number cpid, /*current latest ts*/ 
	   Number start, /*First ts when a player contact the ball*/
           Number hits, Number interts /*interval to count a hit*/;
  /*Initialize*/	
  set cpid = -1.0;
  set start = 0;
  set hits = 0;
  openwritefile("output/q2playerpossession.csv"); 
  for each Numarray v where v in hitters
  begin
	if isBallhitter(v) then
	/*First time*/
        if (cpid = -1.0) then 
	begin 	
		set cpid = v[1];
		set start = v[0];
		set interts = start;
		set hits = 1;
	end else if (cpid = v[1]) then begin
		    if (interts + tsgap() < v[0]) then 	
		    begin
	    		    set interts = v[0];		    
			    set hits = hits + 1;
		    end;
		end
	else if (cpid != v[1]) then /*the ball is hit by another player*/
	begin
		/*emit the current*/
		log_csv_stdout({v[0], cpid, v[0] - start, hits});
		/*print({v[0], cpid, v[0] - start, hits});*/
		return darray({v[0], cpid, v[0] - start, hits});
		/*keep the new*/
		set cpid = v[1];
		set start = v[0];
		set interts = start;
		set hits = 1;
	end
        else if (isInterruptBreakStart(v) or isInterruptBreakEnd(v)) then
	      return v;  	
  end;
  closewritefile();
end;
/*------------------------------------PLAYER POSSESSION STREAM---------------------------*/
/*Player Ball possession */
create function playerposs_out(Stream of Numarray inputs) -> Stream of Numarray
  as streamof(playerposs_bag(ballhitter_process(inputs)));

create function playerposs_report(Stream of Numarray hitters) -> Stream of Numarray
  as streamof(playerposs_bag(hitters));

/*------------------------------------TEAM POSSESSION STREAM---------------------------*/
create function extractts(Numarray v)-> Number as v[0];
create function teamoutputfile(Number )->Charstring as stored;
add teamoutputfile(60)= "output/q2teampossession_1min.csv";
add teamoutputfile(300)= "output/q2teampossession_5min.csv";
add teamoutputfile(1200)= "output/q2teampossession_20min.csv";
add teamoutputfile(69*60)= "output/q2teampossession_landmark.csv";

/*
Adds a posession percentage of each team by computing the total_sum
per window(the bag b here) and deviding posession by the total_sum.
*/
create function add_percentage(bag of (Vector of Number,Number) b)-> Bag of Numarray
as
	select darray({tsw,team,duration,100*duration/total_sum})
	from Number tsw, Number team, Number duration,Number total_sum
	where ({tsw,team},duration) in b
	and total_sum=sum(
			select duration0
			from Number tsw0,Number team0, Number duration0
			where ({tsw0,team0},duration0) in b);

/*sums up the per team ball posession per each window*/
create function teampossW(Window w)-> Bag of Numarray
as
add_percentage(
	new_group_by(
		(select {ts(w),team_id(pid)},duration
		from Number pid,  number duration,Numarray v
		where v in w
		and pid=floor(v[1]) and duration=v[2])
		,{#'sum'}));

create function teamposs_bag00(Stream of Numarray pps, /*player possession stream*/ 
			     Number wlength, Number slide, Number reportfr)-> Bag of (Number,Number)
as for each Window w 
   where w in twindowize(pps, #'extractts', wlength, slide, reportfr, #'isInterruptBreakStart', #'isInterruptBreakEnd')
   return teampossW(w); /*Windows will start to from as the first element arrives*/


/*Parameterize Team Ball possession*/
create function teamposs_bag(Stream of Numarray pps, /*player possession stream*/ 
			     Number wlength, Number slide, Number reportfr)-> Bag of Numarray
as for each Window w 
   where w in twindowize(pps, #'extractts', wlength, slide, reportfr, #'isInterruptBreakStart', #'isInterruptBreakEnd')
   return teampossW(w); /*Windows will start to from as the first element arrives*/


create function teamposs_process(Stream of Numarray pps, 
			     Number wlength, Number slide, Number reportfr)-> Stream of Boolean
as streamof(writecsvfile(teamoutputfile(wlength), teamposs_bag(pps, wlength, slide, reportfr)));


/*----------------------- OUTPUT STREAMS--------------------------------------*/
create function playerpossesion(Stream of Numarray hitters)-> Stream of Numarray
 as mergestreams(svali:mapstreams(splitstream(playerposs_report(hitters), 4, #'broadcastna'),
	                                     {#'teamposs_process', #'teamposs_process', 
					      #'teamposs_process', #'teamposs_process'},
					    {{60, 10, 10}, {300, 10, 10}, {1200, 10, 10}, 
					    {69*60, 10, 10}}));

/*First level of split*/
create function ballhitterSplit(Numarray v, Integer fanout) -> (Integer, Numarray)
  as select i, v from Integer i
     where (i = 0 and (isBallHitter(v) or isInterruptBreakStart(v) or isInterruptBreakEnd(v)))
        or (i = 1 and (isBallHitter(v) or isBall(v) or isInterruptBegin(v)));

create function q2q4(Stream of Numarray s) -> Stream
  as mergestreams(svali:mapstreams(splitstream(ballhitter_process(s), 2, #'ballhittersplit'),
                                      {#'playerpossesion', #'Q4'},
				      {{}, {}}));
