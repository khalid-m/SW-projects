load_lisp('heatmap.lsp');

create function q3ats(Numarray e) -> Number as floor(ts(e));

create function q3a_init() -> Dictionary as dictionary();  /* 1 second table */

/* room for improvement: make key value numarray 2013.04.18 Cheng */
/* comments: the gridx and gridy is 128 * 100, becuase we consider the full
             game field as the grid, so 64 * 100 becomes 128 * 100 */
create function q3a_add(Dictionary res, Numarray r) -> Dictionary
 as select setd(res, k, {ts, oldvalue[1] + 1})
     from Vector of Number k, Vector of Number oldvalue, Number ts
     where k = {playersensor(sid(r)), cellid(r, 128, 100)}
     and oldvalue = get_withdefault(res, k, {0,0})
     and ts = ts(r);

create function q3a_remove() -> Dictionary as nil;


aggregate_function("q3a_agg", "q3a_init", "q3a_add", "q3a_remove");

/* returns: current_second, pid, cellid, latestts, count 
   might be better event just return the k value */
create function onesec(Window w) -> Bag of Numarray
  as begin
	if ts(w) = 2333 then
	  begin
	     return breakstart();
	     return breakend();
	  end;
     for each Vector of Number k, Vector of Number value, Dictionary onesec
	where onesec = q3a_agg(w)
              and onesec[k] = value
       return darray({ts(w), k[0], k[1], value[0], value[1]});
     end;

create function temp(Stream of Numarray s) -> Stream of Window
  as twindowize(s, #'q3ats', 1, 1);

create function q3a(Stream of Numarray s) -> Stream of Numarray
  as streamof(select onesec(w)
              from Window w
              where w in temp(s));


create function q3b_init1() -> Dictionary as dictionary();  /* summary table */

/* comments: dictionary vs. array which one is faster? 2013.04.18 Cheng */
create function q3b_init2() -> Dictionary as dictionary();  /* total sum table */

create function q3bts(Numarray a) -> Number as a[3];

create function q3b_add1(Dictionary res, Numarray r) -> Dictionary
  as select setd(res, k, {ts, oldvalue[1] + r[4]})
     from Vector of Number k, Vector of Number Oldvalue, Number ts
     where k = {r[1], r[2]}
     and ts = q3bts(r)
     and oldvalue = get_withdefault(res, k, {ts, 0});

create function q3b_add2(Dictionary res, Numarray r) -> Dictionary
  as select setd(res, k, oldvalue + r[4])
     from Number k, Number Oldvalue
     where k = r[1]
     and oldvalue = get_withdefault(res, k, 0);

create function q3b_remove1(Dictionary res, Numarray r) -> Dictionary
  as select ifsome(oldvalue[1] - r[4] = 0,
	           rem(res, k),
		   setd(res, k, {oldvalue[0], oldvalue[1] - r[4]}))
     from Vector of Number k, Vector of Number Oldvalue
     where k = {r[1], r[2]}
     and oldvalue = res[k];

create function q3b_remove2(Dictionary res, Numarray r) -> Dictionary
  as select ifsome(oldvalue - r[4] = 0,
	           rem(res, k),
		   setd(res, k, oldvalue - r[4]))
     from Number k, Number Oldvalue
     where k = r[1]
     and oldvalue = res[k];

aggregate_function("summary", "q3b_init1", "q3b_add1", "q3b_add1");

aggregate_function("totalcnt", "q3b_init2", "q3b_add2", "q3b_add2");

create function heatmap(Window w) -> Bag of Numarray
  as select darray({ts, streamid, pid, cell_x1, cell_y1,
		    cell_x2, cell_y2, perc})
     from Number ts, Integer streamid, Number pid, Number cell_x1, 
     Number cell_y1, Number cell_x2, Number cell_y2, Number perc,
     Dictionary total, Dictionary summary
     where summary = summary(w)
     and total = totalcnt(w)
     and (ts, streamid, pid, cell_x1, cell_y1, cell_x2, cell_y2, perc)
            in heatmap_report(summary, total);

create function temp2(Stream of Numarray s, Number wsize, Number slide, Number repfreq) -> Stream of Window
  as twindowize(s, #'numarray.ts->number', wsize, slide, repfreq, #'isInterruptBreakStart', #'isInterruptBreakEnd');

create function q3outputfile(Number wsize) -> Charstring as stored;

add q3outputfile(60) = "output/q3_1M.csv";
add q3outputfile(300) = "output/q3_5M.csv";
add q3outputfile(600) = "output/q3_10M.csv";
add q3outputfile(4200) = "output/q3_landmark.csv";

create function q3b(Stream of Numarray s, Number wsize, Number slide, Number repfreq) -> Stream
  as streamof(writecsvfile(q3outputfile(wsize),
			    (select heatmap(w)
              		     from Window w
                             where w in temp2(s, wsize, slide, repfreq))));

create function q3new(Stream of Numarray s) -> Stream
  as mergestreams(svali:mapstreams(splitstream(q3a(s), 4, #'broadcastna'),
                                      {#'q3b', #'q3b',
				       #'q3b', #'q3b'},
				      {{60, 1, 1}, {300, 1, 1},
			 	       {600, 1, 1}, {4200, 1, 1}}));

create function q3input(Charstring filename)
                      -> Stream of Numarray
  as q1input(filename);