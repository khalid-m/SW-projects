/*Output
 ts 0, 
 player_id 1, 
 standing_time 2, standing_distance 3, 
 trot_time 4, trot_distance 5, 
 low_time 6, low_distance 7, 
 medium_time 8, medium_distance 9, 
 high_time 10 , high_distance 11, 
 sprint_time 12, sprint_distance 13*/

create function q1b_init() -> Vector of Vector of Number
  as {new_vector(14, 0), new_vector(14, 0), new_vector(14, 0), new_vector(14, 0),
      new_vector(14, 0), new_vector(14, 0), new_vector(14, 0), new_vector(14, 0),
      new_vector(14, 0), new_vector(14, 0), new_vector(14, 0), new_vector(14, 0),
      new_vector(14, 0), new_vector(14, 0), new_vector(14, 0), new_vector(14, 0)};

create function q1b_addfn(Vector of Vector of Number res, Vector of Number e)
								-> Boolean
  as begin
	declare Number pid, Number ts,
		Vector of Number pstats,
		Number intensity, Number duration, Number indist, Number i;

	set duration =  e[1] - e[0];
	set pid = e[2];
	set ts =  e[1]; /* latest ts */
        set pstats = res[pid - 1];
	set intensity = e[3];
	set indist = e[4];
	set i = intensity * 2 + 2;

	set_vref(pstats, i, pstats[i] + duration);
	set_vref(pstats, i + 1, pstats[i + 1] + indist);

	set_vref(pstats, 0, ts);
	set_vref(pstats, 1, pid);
     end;

create function q1b_removefn(Vector of Vector of Number res, Vector of Number e)
								-> Boolean
  as begin
	declare Number pid, Number ts,
		Vector of Number pstats, 
		Number intensity, Number duration, Number indist, Number i;

	set duration =  e[1] - e[0];
	set pid = e[2];
	set ts =  e[1]; /* latest ts */
        set pstats = res[pid - 1];
	set intensity = e[3];
	set indist   = e[4];
	set i = intensity * 2 + 2;

	set_vref(pstats, i, pstats[i] - duration);
	set_vref(pstats, i + 1, pstats[i + 1] - indist);
     end;

aggregate_function("q1b_agg", "q1b_init", "q1b_addfn", "q1b_removefn");

create function q1bagg(Window w) -> Vector of Number
  as select pstats[idx]
     from Vector of Vector of Number pstats, Number idx
     where pstats = q1b_agg(w)
      and idx in iota(0, dim(pstats) - 1);

create function q1bts(Vector of Number e) -> Number as floor(e[0]);

create function q1outputfile(Number wsize) -> Charstring as stored;

add q1outputfile(60) = "output/q1b_1M.csv";
add q1outputfile(300) = "output/q1b_5M.csv";
add q1outputfile(1200) = "output/q1b_20M.csv";
add q1outputfile(4200) = "output/q1b_landmark.csv";

/* functions to run 1, 5, 10 minutes window of q1b */
create function q1b_0(Stream of Vector of Number input, Number wsize) -> Bag of Vector of Number
  as select q1bagg(w)
     from Window w
     where w in twindowize(input, #'q1bts',
			   wsize, microWinSize(), microWinSize(),
			   #'isInterruptBreakStartv', #'isInterruptBreakEndv');
create function q1b(Stream of Vector of Number input, Number wsize) -> Stream
  as streamof(writecsvfile(q1outputfile(wsize), q1b_0(input, wsize)));


create function q1(Stream of Numarray s) -> Stream
  as mergestreams(svali:mapstreams(splitstream(q1a(s), 4, #'broadcastv'),
                                   {#'q1b', #'q1b', 
				    #'q1b', #'q1b'},
				   {{60}, {300}, {1200}, 
				    {4200}}));

create function q1input(Charstring filename)
                      -> Stream of Numarray
  as streamof(select e from Numarray e
	      where e in inputstreamna(filename)
	      and (isPlayer(e) or isBreakInterrupt(e)));