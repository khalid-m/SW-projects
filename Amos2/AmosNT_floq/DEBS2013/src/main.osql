writefile("output/q3result" + 1, q3_0(in(q3input(inputstreamna(:testbin))), 1));

writefile("output/q3Newresult" + 1, q3_0(frontendq3_0(in(q3input(inputstreamna(:testbin)))), 1));

count(q3(inputstreamna(:fullbin)));


/* Q4 test */

q4(inputstreamna(:testbin));

/* DEBS test */

count(debs(inputstreamna(:testbin)));


create function stdev3(Bag of Number b)-> Real
  /* Scalable incremental streaming algorithm.
    See http://en.wikipedia.org/wiki/Algorithms_for_calculating_variance  */
  as begin declare Number Mi, Number M, Number S, Number N;
           set M = 0.0;
           set S = 0.0;
           set N = 0.0;
           for each Number Xi where Xi in b
           begin set N = N + 1;
                 set Mi = M + (Xi - M)/N;
                 set S = S + (Xi - M)*(Xi - Mi);
                 set M = Mi;
           end;
           return sqrt(S/(N-1));
     end;

stdev3(iota(1,100000)); /* Correct! */