logging off;

scsqprofile("logs");

show_sp();

set :test1 = "data/test.csv";
set :test = "data/head4M.csv";
set :testbin = "data/head4M.bin";
set :full = "data/full-game";
set :fullbin = "data/full-game.bin";


/* input test */
count(in(inputStream(:test1)));

count(in(interruptStream()));

count(in(eventStream(:test1)));

count(in(inputStream(:test1)));

/* Q1 test */

q1a(eventstreamna(:testbin));

q1(inputstreamna(:testbin));


/* Q2 test */

/* Only player possession */
count(ballhitter_bag(inputstreamna('data/head4M.bin')));")

/* 5 results streams*/
q2(inputstreamna(:testbin));

/* Whole game
teamposs(playerposs_out(inputstreamna(:fullbin)));
*/

q2(inputstreamna(:testbin));


/* Q3 test */

count(in(eventStreamna(:testbin)));  /* 16.84 second */

count(in(q3input(eventStreamna(:testbin))));  /* 26 second */

count(in(q3input(inputstreamna(:testbin))));  /* 26 second */

count(q3(in(q3input(inputstreamna(:testbin))), 10));  /* 148 second */


count(q3(in(q3input(inputstreamna(:fullbin))), 10));

