/*Register MYMAP as external index type.
  The second parameter TRUE means saving/restoring index info taken care 
  by the system ( MEXINMA)*/
register_exindextype('MYMAP', FALSE);

 /*----------------------------------------------------------------------------
 Foreign functions : MAKE, PUT, DELETE, GET, CLEAR and MAPPER
 -----------------------------------------------------------------------------*/
 create function mymap_make() -> Integer
  as foreign 'JAVA:ExinmaDemo/mymap_make';

 create function mymap_put(Integer xtId, Object f, Object o)-> Object
  as foreign 'JAVA:ExinmaDemo/mymap_put';

 create function mymap_delete(Integer xtId, Object f) -> Boolean
  as foreign 'JAVA:ExinmaDemo/mymap_delete';

 create function mymap_get(Integer xtId, Object o) ->Bag of Object
  as foreign 'JAVA:ExinmaDemo/mymap_get';

 create function mymap_clear(Integer xtId)-> Boolean
  as foreign 'JAVA:ExinmaDemo/mymap_clear';

 create function mymap_map(Integer xtId)-> Bag of Object
  as foreign 'JAVA:ExinmaDemo/mymap_mapper';


/*----------------------------------------------------------------------------
Use mymap index type
-----------------------------------------------------------------------------*/
create function phoneof(Charstring name)-> Number  
 pn as stored;

/*Create MYMAP index on function phoneof*/
create_index('phoneof', 'pn', 'Mymap', 'multiple');

/*Drop Hash index*/
drop_index('phoneof', 'name');

/*Populate data*/
add phoneof("Alex")    = 765809542;
add phoneof("Hanna")   = 765805544;
add phoneof("Paul")    =  715809542;
add phoneof("Ansders") = 795909542;

add phoneof("Johan")   = 795909542;
add phoneof("Julia")   = 795729542;
add phoneof("Diego")   =  765809542;

remove phoneof("Paul") =  715809542;

/*Full scan*/
create function q() -> Bag of <Charstring, Number> 
 as select p, n from Charstring p, Number n where phoneof(p) = n;

/*Index scan*/
create function q1(Number i) -> Charstring nm
 as select nm  where phoneof(nm) = i;

load_lisp("exinma_test.lsp");