/*Register Linear Hashing index type written in C and provided as a DLL*/
register_exindextype("LINH", "C:linh", FALSE);

/*From a state to several cities of it*/
create function cityofstate(Charstring state)-> Charstring city;

/*Create a Linear Hashing index on position 1*/
create_index("cityofstate", "city", "LINH", "multiple");

/*Drop the default Hash index */
drop_index("cityofstate", "state");


/*Populate data*/
add cityofstate("New York") = "New York";

add cityofstate("California") = "Los Angeles";
add cityofstate("California") = "SanDiego";
add cityofstate("California") = "San Jose";
add cityofstate("Texas") = "Dallas";
add cityofstate("Texas") = "San Antionio";
add cityofstate("Arizona") = "Phoneix";
add cityofstate("Pennsylvania") = "Philadelphia";

print("---Testing multiple---------");
add cityofstate("New Year") = "New York";
remove cityofstate("Pennsylvania") = "Philadelphia";

/*Deletion is not working*/

create function q()-> <Charstring , Charstring >
as 
  select c, s from Charstring c, Charstring s
  where cityofstate(s) = c;

create function q1(Charstring city)->Charstring
as 
  select s from Charstring s
  where cityofstate(s) = city;

lisp;

(checkequal 
 "Full scan LINH"
 ((osql "q();")
 '(("SanDiego" "California") 
  ("New York" "New Year") 
  ("New York" "New York") 
  ("Dallas" "Texas") 
  ;;("Philadelphia" "Pennsylvania") 
  ("Los Angeles" "California") 
  ("San Antionio" "Texas") 
  ("San Jose" "California") 
  ("Phoneix" "Arizona"))))
(checkequal 
 "Index scan LINH"
 ((osql "q1('Dallas');")
  '(("Texas"))))
(checkequal 
 "Full scan LINH"
 ((osql "q();")
 '(("SanDiego" "California") 
  ("New York" "New Year") 
  ("New York" "New York") 
  ("Dallas" "Texas") 
  ;;("Philadelphia" "Pennsylvania") 
