  '(("Texas"))))
(checkequal 
 "Full scan LINH"
 ((osql "q();")
 '(("SanDiego" "California") 
  ("New York" "New Year") 
  ("New York" "New York") 
  ("Dallas" "Texas") 
  ;;("Philadelphia" "Pennsylvania") 
  ("Los Angeles" "California") 
  ("San Antionio" "Texas") 
  ("San Jose" "California") 
  ("Phoneix" "Arizona"))))
(checkequal 
 "Index scan LINH"
 ((osql "q1('Dallas');")
  '(("Texas"))))
(checkequal 
