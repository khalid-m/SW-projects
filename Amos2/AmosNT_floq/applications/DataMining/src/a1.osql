/*-*-sql-*-*******************************************************************/

/* Use knownclasses to store the data points with known class belonging */

create function knownclasses(Vector of Number x) -> Number v as stored;

create function add_kc(Vector of Number w) -> Boolean
  as add knownclasses({w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8]})
                    =w[9];

create function readnumfile(Charstring f) -> Vector of Number w
  as read_ntuples(f);

create function unknown() -> Vector of Number as stored;

/* Read data files */

add_kc(readnumfile("../data/glassdata.nt"));

add unknown() = readnumfile("../data/testdata.nt");

/* Use testclasses() and k() to store the result of your assignment */

create function testclasses(Vector of Number) -> Number as stored;

create function k() -> Integer as stored;

/* Pass knownclasses() on (coord, class) tuple form as argument to functions */

create function knowntuples() -> Bag of (Vector of Number x, Number v)
  as select ww, cc
     from Vector of Number ww, Number cc
     where cc in knownclasses(ww);

/* Projecting the knownclasses to its coordinates is useful when normalizing */

create function knowncoordinates() -> vector of number
  as select ww
     from vector of number ww, number cc
     where cc in knownclasses(ww);

/* all_but_this is useful for leave-one-out cross-validation */

create function all_but_this(Vector of Number x)
  -> Bag of (Vector of Number, Number)
  as select ww, cc
     from Vector of Number ww, Number cc
     where (ww, cc) in knowntuples()
     and ww != x;

/* Basic functions for kNN */

create function classdistances(Vector of Number x,
                               Bag of (Vector of Number, Number) P)
                           -> Bag of (Number distance, Number class)
  as select euclid(x, v), class
     from Vector of Number v
     where (v, class) in P;

create function k_nearest(Vector of Number x, Integer k, 
                          Bag of (Vector of Number, Number) P)
                      -> Bag of <Object, Object>
  as leastk(classdistances(x, P), k);

create function k_votes(Vector of Number x, Integer k,
                        Bag of (Vector of Number, Number) P)
                    -> Bag of (Integer class, Number count)
  as groupby((select cl 
              from Number cl, Real dist
              where (dist, cl) in k_nearest(x, k, P)),
             #'count');

