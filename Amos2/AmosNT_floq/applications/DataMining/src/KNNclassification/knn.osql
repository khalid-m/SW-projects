

/*************************************************************************
BASIC KNN FUNCTIONS
**************************************************************************/

create function distance(Vector of Number x, Function disfn, 
                         Object dispara, Vector of Number v)
                -> Number distance
  /* Helping function to calculate the distance between two vector x and v
     using the distance function difn(x,y) with optional extra parameter
     disopara */
  as (apply(disfn, {x, v, dispara}))[0];

create function classdistances(Vector of Number x, Function disfn,
                               Object dispara, 
			       Bag of <Number, Vector of Number> bv)
                -> Bag of <Number distance, Number cid>
  /* Given a distance function disfn(x,y) or disfn(x,y,dispara)
     calculate all distances from query point x to the points
     in bag bv */
  as select distance(x, disfn, dispara, v), cid
     from Number cid, Vector of Number v
     where <cid,v> in bv;

create function k_nearest(Vector of Number x, Integer k, 
                          Function disfn, Object para, 
			  Bag of <Number , Vector of Number> bv)
                       -> Bag of <Object, Object>
  /* Function searching K nearest neighbours of a query point x 
     in values bv for a given distance function. 
     Brute force algorithm */
  as leastk(classdistances(x, disfn, para, bv ), k);

create function k_votes(Vector of Number x, Integer k, Function disfn,
                        Object par, Bag of <Number, Vector of Number> bv)
                       -> Bag of <Integer class, Number count>
  /* Function voting classes among K nearest neighbours of a query point x */
  as groupby((select cl 
		from Number cl, Real dist
		where <dist, cl> in k_nearest(x, k, disfn, par, bv))
	     ,#'count');


create function knnclassifyvalue(Vector of Number x, Integer k,
	Function disfn, Object para,
	Bag of <Number, Vector of Number> cd)
	-> Number class
  /* x    : Data value to be classified
     k    : Classify based on K nearest neighbours
     disfn: Used distance function
     para : Optional extra parameter of disfn
     cd  :  */
  as select cid from Number cid, Number votes
     where <votes, cid> in
            topk((select vo, class 
                  from Number vo, Number class 
                  where <class, vo> in 
                        k_votes(x, k, disfn, para, bv)), 1);
 

create function store_knnclassification(Vector of Number x, Integer k, 
	Function disfn, Object para, 
	Bag of <Number , Vector of Number> bv,
	Function classified_data_fn)-> Boolean
  /* Classify a query point x and store the found class together with x in
     the stored function classified_data_fn */
  as addfunction(classified_data_fn, {knnclassify(x, k, disfn, para, bv)}, 
                 vectorof(x));

/*****************************************************************************
CROSS-VALIDATION FUNCTIONS
******************************************************************************/

create function invalid_classifications (Integer k, Function disfn, 
                                         Object dispara,
                                         Function cm,
                                         Bag of <Number, Vector of Number> ts)
       -> Bag of <Number class, Vector of Number val>
  /* Brute force cross-validation. 
     k          : number of Nearest neghbours
     disfn      : distance function
     dispara    : extra argument for disfn
     cm         : already classified data
     ts	        : training set

     The function returns a bag of <class, value> where 
     class     : is a class identifier
     val       : a value of class incorrectly classified */ 
  as select classid, ve from Vector of Number ve, Number classid
     where {classid,ve} in cast(extent(cm) as Bag of Vector of Number)
     and classid != knnclassify(ve, k, disfn, dispara,
                  (select c,v from Number c, Vector of Number v
                   where <c,v> in ts and
                         ve != v));

/*****************************************************************************
NORMALIZATION FUNCTIONS
******************************************************************************/

create function values_of_known_data()->Bag of Vector of Number
  /* Function returning all vector values of the data stored in known_data */
  as select ww
     from vector of number ww, number cid
     where ww in known_data(cid);


create function normalize_iddata(Bag of <Number, Vector of Number> bv,
                                 Vector of Number substract, 
                                 Vector of Number divide,
                                 Function normalized_data_fn) -> Boolean
  /* Function normalizing a given set of classified data values in bv 
     storing the normalized data in function normalized_data_fn */
  as for each Integer cid, Vector v where <cid, v> in bv
 	  addfunction(normalized_data_fn,
		      {cid}, vectorof((v - substract)./
                      substv(0,000001, divide - substract)));

create function normalize_data(Bag of <Vector of Number> bv,
	Vector of Number substract, 
	Vector of Number divide,
	Function normalized_data_fn)->Boolean
  /* Function normalizing a given set of data values in bv storing the 
     normalized data values in function normalized_data_fn */
  as for each Vector v where v in bv
 	 addfunction(normalized_data_fn,
		     {},
                     vectorof((v - substract) ./ 
                              substv(0,000001, divide - substract)));

