/*****************************************************************************
DEFINITION OF USER DATA FUNCTION
******************************************************************************/


create function known_data(Number cid) -> Bag of <Vector of Number v> 
   /* Function to store training data mappings between each class 
      identifier its bag of value vectors */
  as stored;

/* For fast search among values of data function class_members: */
create_index("known_data","v","mbtree","multiple");

create function normalized_known_data(Number cid)
   /* Function to store normalized training data per class */
                -> Bag of <Vector of Number val>
  as stored;

create function unknown_data() 
   /* Function storing data to be classified */
                -> Bag of vector of number
  as stored;

create function normalized_unknown_data() -> Bag of <Vector of Number val> 
   /* Function to store normalized data values to be classified */
  as stored;

create function classified_data(Number cid)-> Bag of <Vector of Number v> 
   /* Function to store mappings between each class identifier and 
      a bag of value vectors for each class for data to be classified */
  as stored;

/* For fast search among values of data function class_members: */
create_index("classified_data","v","mbtree","multiple");

/*****************************************************************************
DEFINITION OF USER SESSION PARAMETERS
******************************************************************************/

/* Set position in rows of mined file for class identifier: */
set :cidpos = 9;

/* Ser positions in rows of mined file for value vector: */
set :valposl = {0,1,2,3,4,5,6,7,8};

/* The used best k for KNN classification: */
set :k = 2;

/*STEP 0*/ 
/*Import data from file into known data set'*/
add_dfn("../../data/glassdata.nt",#'known_data',:cidpos,:valposl);

/*Import data from file into unknown data set'*/
add_dfn("../../data/testdata.nt",#'unknown_data',:valposl);

/*STEP 1*/
/* EZ: Different normalizations: gaussian (mean + stdev), 
minmax (min + max), and so on...
Then, provide some hint to the students on how to normalize using gaussian */

/* Normalize the known data'*/
dropfunction(#"normalized_known_data",1);
normalize_iddata((select cid, v 
                  from Number cid, Vector of Number v
                  where v in known_data(cid)),
		 aggv(values_of_known_data(), #'minagg'), 
		 aggv(values_of_known_data(), #'maxagg'), 
		#'normalized_known_data');

/*-b- Normalize the unknown data*/
dropfunction(#'normalized_unknown_data',1);
normalize_data(unknown_data(), 
		aggv(values_of_known_data(), #'minagg'), 
		aggv(values_of_known_data(), #'maxagg'), 
		#'normalized_unknown_data');


/*STEP 2 - Validate for different K to pick up the best K*/
select count(invalid_classification(k, #'euclid', 0, #'known_data',
		    (select cid, v 
		           from Number cid, Vector of Number v
		           where v in known_data(cid)))),k 
       from Integer k 
       where k in iota(1, 5);

set :k = 2;

/*****************************************************************************
CLASSIFICATION
******************************************************************************/
dropfunction(#'classified_data', 1);
select store_knnclassification(x, :k, #'euclid', 0
	, (select cid, v 
           from Number cid, Vector of Number v
           where v in known_data(cid))
	, #'classified_data')
	from vector of Number x
	where x in unknown_data();

