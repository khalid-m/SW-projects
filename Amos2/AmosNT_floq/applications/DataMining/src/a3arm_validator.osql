/*-*-sql-*-*******************************************************************/

/* USAGE: Must be placed (along with the input data files transactions1000.nt 
   and beer.nt) and run in/from the parent directory of the student solutions.
   In Amos execute the following:

< 'some_student_dir/a2arm.osql';
< 'a2arm_validator.osql'

*/


/* Diagnostics functions */

create function transact_vt()->Bag of <Integer, Vector of Integer>
/* Returns the items in each transaction as a vector of integers. */
  as groupby(transact_bt(), #'vectorof');

lisp;
     
(defun match-ordered-seq (x y)
   "Function to match two ordered sequences"
   (let ((lkey 0)
         (rkey 0)
         (lsize (length x))
         (rsize (length y))
         (res (vector))
         cmp)
    (loop 
      (cond ((>= lkey lsize)(return res))
            ((>= rkey rsize)(return res))
            ((= 0 (setq cmp (compare (aref x lkey)(aref y rkey))))
             (setq res (push-vector res (aref x lkey)))
             (1++ lkey)
             (1++ rkey))
            ((> cmp 0) (1++ rkey))
            (t (1++ lkey))))))

(defun match-ordered-seq--+ (fno x y r)
   (osql-result x y (match-ordered-seq x y)))

:osql

create function match_ordered_seq (Vector x, Vector y)->Vector
/* Matches two ordered sequences */
  as foreign 'match-ordered-seq--+';

create function naive_intersect(Vector x, Vector y)->Vector
/* Calculates the intersection of two vectors naively */
  as vectorof(select x[i] 
              from Integer i
              where x[i] in y);

create function smart_intersect_ofsorted(Vector x, Vector y)->Vector
/* Implements the merge-join/sort like intersection 
   of two sorted vectors */               
  as match_ordered_seq(x,y);

create function vsort(Vector v)->Vector
/* Sorts a vector */
  as sort(in(v)); 

create function smart_intersect(Vector x, Vector y)->Vector
/* Implements the merge-join/sort like intersection 
   of two unsorted vectors. Vectors are sorted internally. */ 
  as match_ordered_seq(vsort(x),vsort(y));

create function is_subset(Vector a, Vector b)->Boolean
/* Checks if the elements of a (set a) are a subset of the elements
   of b (set b) */
  as select dim(a)=dim(smart_intersect(a,b));

create function itemset_supp(Vector of Integer iset)->Integer
/* Claculates the support of an itemset in the transaction base */
  as count(select is_subset(iset, items_in_t)
           from Integer t, Vector of Integer items_in_t
           where <t,items_in_t> in transact_vt());   

create function validate_fis(Bag of Vector of Vector bfis)
                             -> Bag of Vector
/* Validates a bag of frequent itemsets output by fim w.r.t the 
   actual support of the same itemsets calculated directly 
   from the transactions in transact() */
  as select {fis, supp, asupp}
     from Vector of Integer fis, Integer supp, Integer asupp
     where {fis, {supp}} in bfis
       and asupp = itemset_supp(fis)
       and asupp != supp; 

create function vunion(Vector a, Vector b)->Vector
/* Calculates the union of the elements in vector a and b */
  as sort(select distinct e
          from Object e
          where e in a or e in b);

create function rule_conf_supp_transact(Vector of Integer head,
                                        Vector of Integer tail)
                                        -><Real, Real>
/* Calculates the confidence and relative support of a rule
   directly from the transactions */
  as select roundto(ars/ahs,4), roundto(ars/num_transact(),4)
     from Integer ars, Integer ahs, Vector of Integer r
     where r = vunion(head, tail)
       and ars = itemset_supp(r)
       and ahs = itemset_supp(head); 

create function validate_rules(Bag of Vector br)->Bag of Vector
/* Validates a bag of rules output by arm w.r.t the 
   actual confidence and support of the same rules 
   calculated directly from the transactions in transact() */
  as select {head, tail, conf, supp, aconf, asupp}
     from Vector of Integer head, Vector of Integer tail,
          Real conf, Real supp, Real aconf, Real asupp
     where {head, tail, conf, supp} in br
       and <aconf, asupp> = rule_conf_supp_transact(head, tail)
       and (aconf != conf or asupp != supp); 

create function regress_arm()->Vector
/* Performs association rule mining for various values of 
   minsupp and minconf on the transactions in transact() */
  as sort(select sort(arm(ms,mc))
          from Real ms, Real mc
          where ms in vectorof(iota(1,10))/20
            and mc in vectorof(iota(10,20))/20);

lisp;
(checkequal "frequent itemset mining correctness"
 ((osql "fim_file('beer.nt', 0.1);")
 '((#(#() #(10))) (#(#(1) #(7))) (#(#(1 2) #(4))) (#(#(1 2 3) #(3))) (#(#(1 3) #(4))) (#(#(1 3 4) #(1))) (#(#(1 4) #(1))) (#(#(2) #(7))) (#(#(2 3) #(5))) (#(#(2 3 4) #(1))) (#(#(2 4) #(1))) (#(#(3) #(6))) (#(#(3 4) #(2))) (#(#(4) #(2))))
))

(checkequal "frequent itemset mining correctness 2"
 ((osql "validate_fis(fim_file('beer.nt', 0.1));")
 'NIL
)) 

(checkequal "association rule mining correctness"
 ((osql "arm_file('beer.nt', 0.1, 0.5);")
 '((#(2 4) #(3) 1.0 0.1) (#(1 4) #(3) 1.0 0.1) (#(1 3) #(2) 0.75 0.3) (#(1 2) #(3) 0.75 0.3) (#(2 3) #(1) 0.6 0.3) (#(3) #(1 2) 0.5 0.3) (#(3 4) #(2) 0.5 0.1) (#(3 4) #(1) 0.5 0.1) (#(4) #(2 3) 0.5 0.1) (#(4) #(1 3) 0.5 0.1) (#(4) #(3) 1.0 0.2) (#(3) #(2) 0.8333 0.5) (#(2) #(3) 0.7143 0.5) (#(3) #(1) 0.6667 0.4) (#(2) #(1) 0.5714 0.4) (#(1) #(3) 0.5714 0.4) (#(1) #(2) 0.5714 0.4) (#(4) #(2) 0.5 0.1) (#(4) #(1) 0.5 0.1))
))

(checkequal "association rule mining correctness 2"
 ((osql "validate_rules({arm_file('beer.nt', 0.1, 0.5)});")
 'NIL
))

(checkequal "Association rule mining results for varying minsupp and minconf values"
 ((osql "regress_arm();")
 '((#(#() #() #() #() #() #() #() #() #() #() #() #() #() #() #() #() #() #() #() #() #(#(#(1) #(2) 0.5714 0.4) #(#(1) #(3) 0.5714 0.4) #(#(1 2) #(3) 0.75 0.3) #(#(1 3) #(2) 0.75 0.3) #(#(1 4) #(3) 1.0 0.1) #(#(2) #(1) 0.5714 0.4) #(#(2) #(3) 0.7143 0.5) #(#(2 3) #(1) 0.6 0.3) #(#(2 4) #(3) 1.0 0.1) #(#(3) #(1) 0.6667 0.4) #(#(3) #(1 2) 0.5 0.3) #(#(3) #(2) 0.8333 0.5) #(#(3 4) #(1) 0.5 0.1) #(#(3 4) #(2) 0.5 0.1) #(#(4) #(1) 0.5 0.1) #(#(4) #(1 3) 0.5 0.1) #(#(4) #(2) 0.5 0.1) #(#(4) #(2 3) 0.5 0.1) #(#(4) #(3) 1.0 0.2)) #(#(#(1) #(2) 0.5714 0.4) #(#(1) #(3) 0.5714 0.4) #(#(1 2) #(3) 0.75 0.3) #(#(1 3) #(2) 0.75 0.3) #(#(1 4) #(3) 1.0 0.1) #(#(2) #(1) 0.5714 0.4) #(#(2) #(3) 0.7143 0.5) #(#(2 3) #(1) 0.6 0.3) #(#(2 4) #(3) 1.0 0.1) #(#(3) #(1) 0.6667 0.4) #(#(3) #(1 2) 0.5 0.3) #(#(3) #(2) 0.8333 0.5) #(#(3 4) #(1) 0.5 0.1) #(#(3 4) #(2) 0.5 0.1) #(#(4) #(1) 0.5 0.1) #(#(4) #(1 3) 0.5 0.1) #(#(4) #(2) 0.5 0.1) #(#(4) #(2 3) 0.5 0.1) #(#(4) #(3) 1.0 0.2)) #(#(#(1) #(2) 0.5714 0.4) #(#(1) #(3) 0.5714 0.4) #(#(1 2) #(3) 0.75 0.3) #(#(1 3) #(2) 0.75 0.3) #(#(1 4) #(3) 1.0 0.1) #(#(2) #(1) 0.5714 0.4) #(#(2) #(3) 0.7143 0.5) #(#(2 3) #(1) 0.6 0.3) #(#(2 4) #(3) 1.0 0.1) #(#(3) #(1) 0.6667 0.4) #(#(3) #(2) 0.8333 0.5) #(#(4) #(3) 1.0 0.2)) #(#(#(1) #(2) 0.5714 0.4) #(#(1) #(3) 0.5714 0.4) #(#(1 2) #(3) 0.75 0.3) #(#(1 3) #(2) 0.75 0.3) #(#(1 4) #(3) 1.0 0.1) #(#(2) #(1) 0.5714 0.4) #(#(2) #(3) 0.7143 0.5) #(#(2 3) #(1) 0.6 0.3) #(#(2 4) #(3) 1.0 0.1) #(#(3) #(1) 0.6667 0.4) #(#(3) #(2) 0.8333 0.5) #(#(4) #(3) 1.0 0.2)) #(#(#(1) #(2) 0.5714 0.4) #(#(1) #(3) 0.5714 0.4) #(#(1 2) #(3) 0.75 0.3) #(#(1 3) #(2) 0.75 0.3) #(#(2) #(1) 0.5714 0.4) #(#(2) #(3) 0.7143 0.5) #(#(2 3) #(1) 0.6 0.3) #(#(3) #(1) 0.6667 0.4) #(#(3) #(1 2) 0.5 0.3) #(#(3) #(2) 0.8333 0.5)) #(#(#(1) #(2) 0.5714 0.4) #(#(1) #(3) 0.5714 0.4) #(#(1 2) #(3) 0.75 0.3) #(#(1 3) #(2) 0.75 0.3) #(#(2) #(1) 0.5714 0.4) #(#(2) #(3) 0.7143 0.5) #(#(2 3) #(1) 0.6 0.3) #(#(3) #(1) 0.6667 0.4) #(#(3) #(1 2) 0.5 0.3) #(#