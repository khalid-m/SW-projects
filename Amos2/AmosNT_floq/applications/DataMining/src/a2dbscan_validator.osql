  '((#(#(1 #(7 #(2.9073 -0.0064 -0.0952 0.2094))) #(2 #(9 #(-3.0587 -0.3154 0.0225 -0.0216))) #(3 #(5 #(-3.0196 0.0983 -0.0159 0.0072))) #(4 #(6 #(-4.8498 0.9803 1.0038 -0.7231))) #(5 #(7 #(-4.7909 1.0062 -0.1803 0.0468))))))
