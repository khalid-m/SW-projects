/*-*-sql-*-*******************************************************************/

/* USAGE: Must be placed (along with the input data files patterns.nt and 
   patterns2.nt) and run in/from the parent directory of the student
   solutions. In Amos execute the following:

< 'some_student_dir/a2dbscan.osql';
< 'a2dbscan_validator.osql'

*/

  
create function disp_sorted_5dist(Bag of Number kd)->Integer
/* Displays the sorted 5-dist graph which can be used to estimate eps. */ 
  as scatter2((select {i, v[i]}
               from Vector v, Integer i
               where v = sort(kd, 'dec')));

create function col_means(Bag of Vector of Number bv)
                      -> Vector of Number
/* TODO: Calculate the columns-wise mean of the bag of vectors bv.
   HINT: Use function aggv() and an appropriate aggregate function. */
  as aggv(bv, #'avg');

create function cnt_means(Bag of Vector of Number bv)->Vector
  as {count(bv), roundto(col_means(bv),4)};

create function cluster_statistics(Bag of Vector clus)
                               -> Bag of (Integer, Vector) 
/* Computes the centroids based on the input clustering clus */  
  as groupby((select c, pv
              from Integer c, Integer p, Vector of Number pv
              where {c,p,pv} in clus),
             #'cnt_means'); 

lisp;

(checkequal "DBSCAN results for patterns.nt of eps = 0.54" 
  ((osql "sort(cluster_statistics(dbscan_file('patterns.nt',0.54,5)));")  
  '((#(#(1 #(40 #(-0.9569 0.9978 -0.1237 0.0493))) #(2 #(20 #(-2.9555 0.029 -0.8696 0.9261))) #(3 #(25 #(3.0234 -2.0986 0.1021 -0.0506))) #(4 #(35 #(-2.9672 -0.0527 0.0302 0.0068))) #(5 #(30 #(0.9952 1.9979 -0.0785 0.2297))))))
))

(checkequal "DBSCAN results for patterns.nt of eps = 0.8" 
  ((osql "sort(cluster_statistics(dbscan_file('patterns.nt',0.8,5)));")  
  '((#(#(1 #(30 #(0.9952 1.9979 -0.0785 0.2297))) #(2 #(40 #(-0.9569 0.9978 -0.1237 0.0493))) #(3 #(55 #(-2.9629 -0.023 -0.297 0.3411))) #(4 #(25 #(3.0234 -2.0986 0.1021 -0.0506))))))
))

(checkequal "DBSCAN results for patterns.nt of eps = 0.2" 
  ((osql "sort(cluster_statistics(dbscan_file('patterns.nt',0.2,5)));")  
  '((#()))
))

(checkequal "DBSCAN results for patterns.nt of eps = 0.1" 
  ((osql "sort(cluster_statistics(dbscan_file('patterns.nt',0.1,5)));")  
  '((#()))
))

(checkequal "DBSCAN results for patterns2.nt of eps = 0.54" 
  ((osql "sort(cluster_statistics(dbscan_file('patterns2.nt',0.54,5)));")  
  '((#(#(1 #(55 #(-2.932 0.0644 -0.2397 0.2043))) #(2 #(44 #(-5.0101 0.9912 -0.1104 0.0154))) #(3 #(25 #(3.009 0.0 -0.0981 0.204))) #(4 #(33 #(-4.9964 0.9926 1.0068 -1.1217))) #(5 #(21 #(3.0394 -0.9528 -0.0547 -0.0976))))))
