(checkequal "DBSCAN results for patterns2.nt of eps = 0.8" 
  ((osql "sort(cluster_statistics(dbscan_file('patterns2.nt',0.8,5)));")  
  '((#(#(1 #(58 #(-2.9405 0.052 -0.2275 0.2069))) #(2 #(45 #(-5.0263 0.9832 -0.1086 0.0212))) #(3 #(48 #(3.0169 -0.4174 -0.0476 0.0641))) #(4 #(33 #(-4.9964 0.9926 1.0068 -1.1217))))))
