/*-*-sql-*-*******************************************************************/

/* Disable logging */
logging off;
/* Turn off one-tuple buffering to facilitate truely dynamic cursors */
lisp; 
(delay-emit NIL) ; disable
:osql 

create function debug()->Boolean as stored;
set debug() = 1<0;

/* stored global parameters */
create function eps()->Number as stored;
create function minpts()->Integer as stored;
set minpts() = 3;
set eps() = 1;

create function enumerate(Bag of Vector bv) ->Bag of <Integer i, Vector>
/* Enumerates a bag of vectors bv from  1 to count(b) */
as 
begin
  set i = 0;
  for each original Vector w where w = in(bv)
  begin
    set i = i + 1;
    result <i, w>;
  end;
end; 

/* Function / relation to store the enumerates data points as vectors */
create function datapoint(Integer d)->Vector of Number v as stored;
/*create_index('datapoint', 'v', 'mbtree', 'multiple');*/

create function datapoints()-> Bag of <Integer, Vector>
/* Enumerated values in stored function datapoint */ 
  as select p, v 
     from Integer p, Vector v 
     where v = datapoint(p);

create function load_vdp(Charstring file)->Boolean
/* Loads stored function datapoint from a file that
   contains amos Vectors */
  as add datapoint(i) =  v
     from Integer i, Vector v, Bag of Vector bv
     where <i, v> in enumerate(bv)
       and bv = (read_ntuples(file)); 

create function genclust2x2(Number x0, Number y0)->Bag of <Number, Number>
/* Generates a 2 by 2 cluster of 2D points with origine (x0,y0) */
  as select x0+x, y0+y 
     from Number x, Number y
     where x in iota(0,1)
       and y in iota(0,1); 

create function popdp()->Boolean
/* Populates the stored function datapoint with 2(+1) 
   density based clusters */  
as 
begin
  /* Cluster 1 */
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(1,1);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(3,1);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(5,1);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(7,1);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(1,3);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(1,5);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(1,7);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(7,3);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(7,5);
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(7,7);
  /* Cluster 2 with 5 points */ 
  add datapoint(concat(x*100,y*100))= {x,y}
  from Number x, Number y
  where <x, y> in genclust2x2(4,7);
  add datapoint(400600) = {4,6};
  /* Noise / Cluster 3 with two points */
  add datapoint(400400) = {4,4};
  add datapoint(500400) = {5,4};
end;

create function eqdiv100(Integer p)->Bag of Integer
/* Subdivides the (0,100] interval into p approximatelly 
   equal subintervals */
  as select integer(i*d)
     from Integer i, Integer d
     where d = round(100/p)
       and i = iota(1,floor(100/d)-1); 

create function blowupdp(Integer k)->Boolean
/* Blows up the number of data entries in datapoint by uniformly 
   increasing the density of the data points within the original
   extend of the data by a factor of k^2 */ 
  as add datapoint(concat(xid+i, yid+j)) = {vxy[0]+(i/100), vxy[1]+(j/100)}
     from Integer xyid, Integer xid, Integer yid, Vector of Number vxy, Integer i, Integer j
     where datapoint(xyid)=vxy
       and i in eqdiv100(k)
       and j in eqdiv100(k)
       and xid = atoi(substring(itoa(xyid), 0, 2))
       and yid = atoi(substring(itoa(xyid), 3, 5)); 

/* Stored function / relation of the directly density reachable 
   graph, i.e. ddrtab(p)=q entails tha tp is a corepoint and q 
   is within p's eps-neighborhood. */ 
create function ddrtab(Integer p)->Bag of Integer q as stored; 
/*Automatic: create_index('ddrtab', 'p', 'hash', 'multiple');*/
create_index('ddrtab', 'q', 'hash', 'multiple');

/* TODO: Make this faster */
create function nbr(Integer p)->Bag of Integer
/* Calculates the eps-neighborhood of point p */
as select q
   from Integer q, Integer i,
        Vector of Number pv, Vector of Number qv
   where pv = datapoint(p)
     and qv = datapoint(q)
     and qv[i] >= pv[i] - eps() 
     and qv[i] <= pv[i] + eps()
     and euclid(pv, qv) <= eps()
     and p != q;

create function ddr(Integer p)->Bag of Integer
/* Calculates the set of points q that are ddr from p */ 
  as select q
     from Integer q
     where count(nbr(p)) >= minpts()
       and q in nbr(p); 

create function build_ddrtab()->Boolean
/* Populates ddrtab based on the function ddr(p) */
  as add ddrtab(p)=q
     from Integer p, Integer q
     where q in ddr(p); 

create function remove_ddrtab(Vector of Integer dcc)->Boolean
/* Removes a dcc, i.e., a cluster from ddrtab */
  as remove ddrtab(a)=b
     from Integer a, Integer b
     where a in dcc 
        or b in dcc;

create function show_ddrtab()-> Bag of <Integer, Integer>
/* Displayes the contents of ddrtab */
  as select f, t 
     from Integer f, Integer t
     where t in ddrtab(f);

create function ddr_child(Integer p)->Bag of Integer
/* Returns a set of points q that are ddr from point p.
   Essentially the same results as ddr(p), but instead
   of operationg on the stored table datapoint, it 
   retrieves the results from the precalculated ddrtab.
   Used to traverse the ddr graph stored in ddrtab by 
   iterative application of the function on its results
   via transitive closure. */
  as select q 
     from Integer q
     where q in ddrtab(p);  

create function dc(Integer p)->Bag of Integer
/* Retrieve the maximal set of density-connected points
   starting from p, i.e., a the maximal ddr tree / chain. */    
  as select q 
     from Integer q
     where q = tclose(#'ddr_child', p)
       and p != q;

create function find_and_remove_dc(Integer p, Integer cn)->Vector
/* Find, emit, and remove the density-connected dc points, dcc starting
   from p. It identifies a density-based cluster starting from p. */
as 
begin
    declare Vector of Integer dcc;
    /* find dc(p) */ 
    set dcc = (vselect dc(p));
    set dcc = concat(dcc, {p});
    if debug() then print({"dcc: ", dcc});
    /* remove dcc from ddrtab */
    remove_ddrtab(dcc);
    /* emit dcc */ 
    result (select {cn, q, datapoint(q)} 
            from Integer q
            where q in dcc);
    /*for each Integer q
    where q in dcc
    result {cn, q, datapoint(q)};*/
end;

create function nnbr(Integer p)->Integer
/* Returns the number of neighbors of p based on ddrtab */ 
  as count(ddrtab(p));

create function corepoints()->Bag of Integer
/* Returns the remaining corepoints based on the state of ddrtab */ 
  as select distinct p
     from integer p, integer q
     where q in ddrtab(p);

/*       and nnbr(p) >= eps(); */
/* NOTE: The last condition might seem useless, but it can happen 
   that some neighbors of an initially core point p are added to 
   clusters making p a non-core point. Density-connected components
   i.e, clusters should be retrieved by starting at a corepoint. */

create function dbscan(Number eps, Integer minpts)->Bag of Vector
/* The DBSCAN algorithm based on retrieval of dccs from the ddr graph */
as 
begin 
   declare Integer cn;
   set minpts() = minpts;
   set eps() = eps;
   set cn = 1; 
   /* build ddr tab */
   clear_function("ddrtab");
   build_ddrtab();
   /* find, remove and emit dccs from ddrtab */
   for each original Integer cp
   where cp in corepoints()
   begin 
      if debug() then print({"cp: ", cp});
      result find_and_remove_dc(cp, cn);
      set cn = cn + 1;
   end;
end;

/* For each 'original' is like a dynamic cursor over the result set,
   but a one-tuple buffering is performed by the DBMS, hence the 
   above implementation of DBSCAN is not entirely correct because the
   for each original corepoint loop buffers one corepoint ahead. So
   for example if x and y are coorpoints calculated in the given order
   and y belongs to the dcc of x, then y is added to the cluster of x
   and is removed from ddrtab, but it will be tried as a new core of a 
   cluster, and because of the faulty logic, will actually be placed in
   its own singelton cluster again!!! To avoid this one can disable the
   buffering, or fix the semantics of dc(p) to include p, or alternatively 
   the corepoints can also be stored and managed in a table. The functions
   bellow implement the later solution. */

/* Stored function / relation to store corepoints */
create function cptab()->Bag of Integer cp as stored;

create function build_cptab()->Boolean
/* Populates cptab based on the derived function corepoints() */
  as add cptab()=cp
     from Integer cp 
     where cp in corepoints();

create function remove_cptab(Vector of Integer dcc)->Boolean
/* Removes a set of points (cluster / dcc) from the cptab */
  as remove cptab()=a
     from Integer a
     where a in dcc;

create function find_and_remove_dc2(Integer p, Integer cn)->Vector
/* Find, emit, and remove the density-connected dc points, dcc starting
   from p. It identifies a density-based cluster starting from p. 
   The points in the foind dcc are also removed from cptab. */
as 
begin
    declare Vector of Integer dcc;
    /* find dc(p) */
    set dcc = (vselect dc(p));
    set dcc = concat(dcc, {p});
    if debug() then print({"dcc: ", dcc});
    /* remove dcc from ddrtab and cptab */  
    remove_ddrtab(dcc);
    remove_cptab(dcc);
    /* emit dcc */
    result (select {cn, q, datapoint(q)} 
            from Integer q
            where q in dcc);
    /*for each Integer q
    where q in dcc
    result {cn, q, datapoint(q)};*/
end;    

create function dbscan2(Number eps, Integer minpts)->Bag of Vector
/* The DBSCAN algorithm based on retrieval of dccs from the ddr graph 
   and maintining remaining corepoints in a stored relation */
as 
begin 
   declare Integer cn;
   set minpts() = minpts;
   set eps() = eps;
   set cn = 1; 
   /* build ddrtab and cptab */
   clear_function("ddrtab");
   build_ddrtab();
   clear_function("cptab");
   build_cptab();
   if debug() then print({"cptab: ", vselect cptab()});
   /* find, remove and emit dccs from ddrtab */
   for each original Integer cp
   where cp in cptab()
   begin
      if debug() then print({"cp: ", cp}); 
      result find_and_remove_dc2(cp, cn);
      set cn = cn + 1;
   end;
end;

create function disp_clustering3d(Bag of Vector of Vector c)
                                  ->Integer   
/* 3D scatter plot display of clustering */
  as scatter3p((select concat(project(v[2],{0,1,2}),{v[0]})
                from Vector of Vector v
                where v in c));


create function whole()->Bag of Integer
  as iota(1,10);

create function subset()->Bag of Integer
  as iota(3,6);



select i, source  
from integer i, Charstring source
where (i in whole()
       and notany(select j from Integer j where j in subset() and i = j)
       and source = "whole")
   or (i in subset()
       and source = "subset") ; 



