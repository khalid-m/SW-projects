/* 

   Help directives and skeleton for basic kmeans clustering and tasks 
   in DM assignment 2. Read all comments and code. 

   Students are expected to follow the directives and complete / replace 
   / correct code where necessary (marked with TODO) according 
   to the function signatures, descriptions, HINTS, and NOTES.
   Students are encouraged to experiment with explicit or implicit 
   options and alternative implementations. 

*/

/* DIRECTIVE 1:
      
   Use read_tuples, zscore (or other normalization), pca or pcascore, and 
   the data visualization functions (scatter2(3), etc) to read in, preprocess 
   (normalize and project) and visualize the data sets to determine visually 
   the possible number of clusters. 

   Example:

   set :file = 'patterns.nt';
   scatter2(pcascore(zscore((select v from Vector of Number v
                             where v in read_ntuples(:file))),2));

*/ 

/* DIRECTIVE 2: 

   Implement the basic k-means algorithm.

*/
 
/* Stored function to store the datapoints */ 
create function datapoint(Integer d)->Vector of Number as stored;

create function datapoints()->Bag of Vector of Number
/* Returns data ointr vectors stored in the function datapoint() */ 
  as select datapoint(i) from Integer i;

create function enumerate(Bag of Vector bv)->Bag of <Integer i, Vector v>
/* Enumerates a bag of vectors bv from 1 to count(bv) */
as
begin
  set i = 0;
  for each original Vector v where v  in bv
  begin
    set i = i + 1;
    result <i, v>;
  end;
end;

create function load_vdp(Charstring file)->Boolean
/* Loads stored function datapoint from a file that 
   contains n-tuples that are ment to reperesent vectors. */
  as add datapoint(i) = v
     from Integer i, Vector v, Bag of Vector bv
     where <i, v> in enumerate(bv)
       and bv = (read_ntuples(file));

create function rand_id(Bag of Object b)->Bag of <Integer i, Object>
/* Assigns random ids to elements of a bag */
  as for each Object o where o in b result <rand(1000000), o>; 

create function rand_sample(Bag of Object b, Integer k)->Bag of Object 
/* Selects a random k-sized sample of a bag. 
   NOTE: If k << count(b) sortbagby can be replaced with functions 
         topk() or leastk() */  
  as select vo[i][1]
     from Integer i, Vector of Vector vo
     where vo = sortbagby(rand_id(b), 1, 'inc')
       and i < k;         

create function init_centroids(Integer k)->Bag of <Integer, Vector of Number>
/* TODO: Initialize a bag of enumerated centroids to contain k
         randomly selected points from stored function datapoint().
   HINT: Use functions enumerate() and rand_sample(). */
  as select i, v
     from Integer i, Vector v, Bag of Vector bv
     where <i, v> in enumerate(bv)
       and bv = rand_sample(datapoints(), k);

create function p2c_distances(Bag of <Integer, Vector of Number> bc)
                              ->Bag of <Integer/*p*/, 
                                        Integer/*c*/, 
                                        Number /*d*/>
/* TODO: Calculate the Euclidean distance d between every point p 
         in stored function datapoint() and every centroid c 
         in the input bag of enumerated centroids bc. 
   HINT: Use functions euclid(), datapoint() */
  as select p, c, d
     from Integer p, Integer c, Vector of Number cv, Number d
     where d = euclid(datapoint(p), cv)
       and <c, cv> in bc;

create function argminv(Bag of Vector bkvv) -> Object
/* Returns the key (argument) k for which the value v is minimal
   among the bag of key(argument)-value vectors bkvv. */
 as {leastK((select v, k
             from Object k, Object v
             where {k, v} in bkvv), 1)}[1];

create function calc_cluster_assignment(Bag of <Integer, 
                                                Integer, 
                                                Number> p2c_dist)
                                        ->Bag of <Integer, Integer>
/* TODO: Calculate the cluster assignment of datapoints based on the 
         point-to-centroid distances p2c_dist, i.e., each point is assigned 
         to the cluster with the closest centroid.
   Input: bag of <point#, centroid#, distance> tuples
   Output: bag of <point#, nearest centroid#> tuples
   HINT: Use groupby and apply the aggregate function argminv() 
         on each group */
  as groupby((select p, {c,d} 
              from Integer p, Integer c, Number d
              where <p,c,d> in p2c_dist),
             #'argminv');

create function emit_clustering_ca(Bag of <Integer, Integer> ca)
                                   ->Bag of Vector
/* Emits a clustering of the datapoints according to cluster assignment ca */
  as select {c, p, datapoint(p)} 
     from Integer c, Integer p
     where <p,c> in ca;

create function emit_clustering_bc(Bag of <Integer, Vector of Number> bc)
                                   ->Bag of Vector
/* Emits a clustering of the datapoints according to the bag of 
   enumerated centroids in bc. */ 
  as emit_clustering_ca(calc_cluster_assignment(p2c_distances(bc)));

create function col_means(Bag of Vector of Number bv)
                          ->Vector of Number mv
/* TODO: Calculate the columns-wise mean of the bag of vectors bv.
   HINT: Use function aggv() and an appropriate aggregate function. */
  as aggv(bv, #'avg');

create function calc_cluster_means(Bag of <Integer, Integer> ca)
                                   ->Bag of <Integer, Vector of Number>
/* TODO: Calculate the means of clusters.
   HINT: Use groupby and apply the aggragate function col_means() 
         on each group. */
  as groupby((select c, datapoint(p)
              from Integer c, Integer p
              where <p,c> in ca),
             #'col_means');

create function vc2bc(Vector of Vector vc)
                      ->Bag of <Integer c, Vector of Number vn>
/* Converts a collection of enumerated centroids that are represented 
   as Vector of Vectors into a Bag of <Integer, Vector of Number> 
   representation. */ 
  as select c, vn
     from Vector iv
     where iv in vc
       and {c, vn} = iv;

create function bc2vc(Bag of <Integer, Vector of Number> bc)
                      ->Vector of Vector                      
/* Inverse of function vc2bc(). */ 
  as vectorof(select {c, vn}
              from Integer c, Vector of Number vn
              where <c, vn> in bc);

create function kmeans_tcfv(Vector of  Vector vc)
                            ->Vector of Vector 
/* TODO: Perform a k-means iteration step in form of a closed 
         transition function.
   Input: vc - Vector of centroid id - centroid vector pairs (paired into 
          a vector)
   Output: Same as vc, but after a k-means iteration step, i.e., after cluster 
           assignment and cluster center re-computation and centroids 
           SORTED in order of the centroind ids.
   HINT: Use functions calc_cluster_means(), calc_cluster_assignment(), 
         p2c_distances(), vc2bc(), and sortbagby(). */
  as sortbagby
       (calc_cluster_means
          (calc_cluster_assignment
             (p2c_distances(vc2bc(vc)))),
       1, 'dec');

create function kmeans_tclosev(Vector of Vector vc)
                               ->Vector of Vector
/* Iterative k-means clustering based on convergence of centroids.
   NOTE: What does this function do? Why was the sorting in kmeans_tcfv 
   necessary? */
   as select newvc
      from Vector of Vector newvc
      where newvc in tclose(#'kmeans_tcfv', vc);

create function kmeans(Integer k) 
                       ->Bag of Vector
/* K-means algorithm to cluseter the high-dimensional data points 
   that are stored in function datapoint(). 
   NOTE: Function last() emits the last tuple of a bag. */
  as select v
     from Vector v, 
          Bag of <Integer, Vector of Number> bc,
          Vector of Vector icv 
     where v in emit_clustering_bc(bc)
     and bc = vc2bc(last(kmeans_tclosev(icv)))
     and icv = bc2vc(init_centroids(k));

create function kmeans_bag(Bag of Vector of Number bvd, Integer k) 
                           ->Bag of Vector
/* K-means algorithm to cluster the high-dimensional datapoints in bvd */
as 
begin
  clear_function('datapoint');
  add datapoint(i) = v
  from Integer i, Vector v
  where <i, v> in enumerate(bvd);
  result kmeans(k);
end;

create function kmeans_file(Charstring datafile, Integer k) 
                            ->Bag of Vector 
/* K-means algorithm to cluster the high-dimensional points in datafile */
as 
begin
  clear_function('datapoint');
  load_vdp(datafile);
  result kmeans(k);
end;

create function disp_clustering3d(Bag of Vector c)
                                  ->Integer   
/* TODO: Create a 3D scatter plot display of a clustering that is 
         produced by kmeans_*() */
  as scatter3p((select concat(project(v[2], {0,1,2}), {v[0]})
                from Vector of Vector v
                where v in c));

create function pcaproject3d_clustering(Bag of Vector bc)
                                        ->Bag of Vector
/* Function that projects the results of a clustering 
   down to 3 dimensions. Used for vizualization of high 
   dimensional clustering results */ 
  as select {cv[i], pv[i], pvv[i]}
     from Vector of Vector vc,
          Vector of Integer cv,
          Vector of Integer pv,
          Vector of Vector of Number vv,
          Vector of Vector pvv,
          Integer i
     where vc = vectorof(bc)
       and cv = vectorof(in(vc)[0])
       and pv = vectorof(in(vc)[1])
       and vv = vectorof(in(vc)[2])
       and pvv = vectorof(pcascore(in(vv),3));


/* Sample call: 

disp_clustering3d
  (pcaproject3d_clustering
     ((select kmeans_file('patterns.nt', 5))));

*/


/* DIRECTIVE 3: 

   Cluster quality measures. Implement the sum-of-squared error of 
   (SSE) measure.  

*/

create function calc_clust_mea(Vector of Vector vc, 
                               Function daggfn)
                               ->Bag of <Integer, Object> 
/* Evaluates the (distance)-aggregate function daggfn on each cluster 
   of the cluster assignment that is derived based on the enumerated 
   vector of cluster centroids. */  
  as groupby((select c, euclid(cv, datapoint(p))
              from Integer c, Integer p, Vector of Number cv
              where <p,c> in calc_cluster_assignment(
                               p2c_distances(
                                 vc2bc(vc)))
                and {c,cv} in vc),
             daggfn); 

create function sumsquare(Bag of Number bn)->Number
/* Calculates sum-of-squared of the bag of values in bn */ 
 as sum(select n*n from Number n where n in bn);

create function sse(Vector of Vector vc)
                    ->Number
/* Calculates the SSE of a clustering based on the enumerated
   vector of cluster centroids vc */
 as sum(select ss
        from Integer c, Number ss
        where <c, ss> in calc_clust_mea(vc, #'sumsquare'));

/* DIRECTIVE 4: 
   
   Implement a version of kmeans that using the cluster quality measure 
   for a given k derives the optimal clustering by rerunning kmeans n times 
   and returns as a final result the clustering that resulted in the 
   minimal value for the cluster quality measure. 

*/

create function minimal_kmeans(Integer k, Integer n) 
                               ->Bag of Vector
/* TODO: Implements a version of kmeans that using the cluster quality measure 
   for a given k derives the optimal clustering by rerunning kmeans n times 
   and returns as a final result the clustering that resulted in the 
   minimal value for the cluster quality measure. */
as 
begin
  declare Vector of Vector of Number vc,
          Vector of Vector of Number minvc, 
          Number minSSE;  
  set vc = last(kmeans_tclosev(bc2vc(init_centroids(k))));
  set minSSE = SSE(vc);
  for each Integer i where i in iota(1,n-1)
  begin
    set vc = last(kmeans_tclosev(bc2vc(init_centroids(k))));
    if (minSSE > SSE(vc)) then
    begin
      set minSSE = SSE(vc);
      set minvc = vc;
      /*print(minSSE);*/
    end;
  end;
  result emit_clustering_bc(vc2bc(minvc));
end;  

create function minimal_kmeans_file(Charstring datafile, 
                                    Integer k, 
                                    Integer n)
                                    ->Bag of Vector
/* Same as minimal_kmeans but the data points are first read from the 
   datafile file and stored in the stored function datapoint. */ 
as
begin
  clear_function('datapoint');
  load_vdp(datafile);
  result minimal_kmeans(k, n);
end; 

create function minimal_kmeans_bag(Bag of Vector of Number bvd, 
                                   Integer k, 
                                   Integer n)
                                   ->Bag of Vector
/* Same as minimal_kmeans but the data points are passed as a bag of 
   vectors and subsequently are stored in the stored function datapoint. */ 
as
begin
  clear_function('datapoint');
  add datapoint(i) = v
  from Integer i, Vector v
  where <i, v> in enumerate(bvd);
  result minimal_kmeans(k, n);
end; 

/* Sample calls:

disp_clustering3d(minimal_kmeans_file('patterns.nt',5,10)); 

*/

/* DIRECTIVE 5 (OPTIONAL):

   Implement an additional cluster quality measure (index) that in addition to 
   favoring compactness of clusters also looks at the separation between
   clusters. See http://machaon.karanagai.com/validation_algorithms.html for   
   definitions of additional cluster quality measures. Use your additional
   measure to construct a version of k-means that finds not only the optimal
   clustering for a GIVEN value of k, but also kinds the 'optimal' value of k.

*/

/**************************/
/* Cluster data generator */
/**************************/

create function seed_3d_centroids(Integer n)->Bag of Vector of Number
/* Generates random 3d centroinds at n unit locations 
   from the space [1:10,1:10,1:10] */  
  as rand_sample((select {i, j, k}
                  from Integer i, Integer k, Integer j
                  where i in iota(1,10)
                    and j in iota(1,10)
                    and k in iota(1,10)),n); 

create function urrand(Real f, Real t)->Real
/* Generates a real random from the distribution ~U(f,t), f<t. */
  as ((rand(100000)/100000)*(t-f))+f;

create function urrands(Real f, Real t, Integer d)->Bag of Real
/* Generates a bag of n real random numbers with distribution ~U(f,t), f<t. */
  as for each Integer i where i in iota(1,d) result urrand(f,t);

create function urrandv(Real f, Real t, Integer d)->Vector of Real
/* Generates a d-dimensional vector of real random numbers 
   with distribution ~U(f,t), f<t. */
  as vectorof(urrands(f,t,d));
    
create function uniform_cloud(Vector of Number c, Real pm, Integer n)
                              ->Bag of Vector of Number 
/* Generates a uniform cloud of n dim(c)-dimensional datapoints centered 
   around c+-pm. */
  as for each Integer i where i in iota(1,n) result c+urrandv(-pm,pm,dim(c));    

create function clusterdata_3d(Integer k, Real pm, Integer n)
                               ->Bag of Vector of Number
/* Generates a 3d cluster dataset with k clusters 
   each of which is uniromly distributed a respective 
   cluster centroid c+-pm */
  as select uniform_cloud(seed_3d_centroids(k), pm, n);

/**************/
/* Regression */
/**************/

create function printv(Vector v)->Boolean
/* Prints the concatanation of the vector elements in v */
  as print(concatagg(in(v)));

create function vca2ca(Vector of Vector vca)->Bag of <Integer, Integer>
/* Converts a vector of vectors into a bag of vectors, used with in conjuction 
   with vectorize as a primitive form of bag materialization. */
  as select p,c
     from Integer p, Integer c
     where {p,c} in vca;  

create function test_clust_assignment(Bag of <Integer, Integer> ca, 
                                      Integer k, Integer n)
                                      ->Boolean
/* Tests the validity of a clustering assignment w.r.t the extpected number
   or objects and 1-to-1 assignment */
as 
begin
  declare Vector of Vector vca, Integer cn, Boolean valid,
          Integer sum_clust_sizes, Integer sum_num_assign;
  set vca = vectorof(ca);
  set cn = count(vca2ca(vca));
  set sum_clust_sizes = 
      sum(select cs 
          from Integer c, Integer cs
          where <c, cs> = groupby((select c, 1 
                                   from Integer p, Integer c 
                                   where <p,c> in vca2ca(vca)),
                                  #'sum'));
  set sum_num_assign = 
      sum(select na 
          from Integer c, Integer na
          where <c, na> = groupby((select p, 1 
                                   from Integer p, Integer c 
                                   where <p,c> in vca2ca(vca)),
                                  #'sum'));
  set valid = (sum_clust_sizes + sum_num_assign) = (2 * n);
  if ((n=cn) and valid) then
    result TRUE
  else
  begin
    printv({"Expected the clustering of ", n, " objects."});
    if (valid) then
      printv({"Instead ", cn, " objects were clustered in a valid way." })
    else
      printv({"Instead ", cn, " objects were clustered in an invalid way."});
    /*disp_clustering3d(vca2ca(vca));*/
    result FALSE;
  end;
end;

create function regress_kmeans(Integer maxk, Integer numtrial)
                               ->Boolean
/* Performes numtrial number of times validity checks of 
   kmeans clasterings (for varying values of k) of randomly 
   generated */
as 
begin
  declare Boolean res;
  for each integer k where k in iota(1,maxk)
    for each integer trial where trial in iota(1,numtrial)
    begin
      set res = test_clust_assignment(
                  (select p,c
                   from Integer p, Integer c, Vector of Number v
                   where {c,p,v} = kmeans_bag(clusterdata_3d(k, 0.5, 20), k)), 
                  k, k*20);
    end;
  result res;
end;

create function get_centroids_of_clustering(Bag of Vector clus)
                               ->Bag of <Integer, Vector of Number> 
/* Computes the centroids based on the input clustering clus */  
  as groupby((select c, pv
              from Integer c, Integer p, Vector of Number pv
              where {c,p,pv} in clus),
             #'col_means'); 

create function ref_sse(Vector of Vector vc)
                    ->Number
/* Calculates the SSE of a clustering based on the enumerated
   vector of cluster centroids vc */
 as sum(select ss
        from Integer c, Number ss
        where <c, ss> in calc_clust_mea(vc, #'sumsquare'));


/* Regression test */

lisp;
(checkequal "K-means validity"
 ((osql "regress_kmeans(5,2);")
 '((TRUE))))

(checkequal "Minimal K-means on patterns.osql"
 ((osql "ref_sse(bc2vc(get_centroids_of_clustering(minimal_kmeans_file('data/patterns.nt',5,20)))) < 25;")
 '((TRUE))))

(checkequal "Minimal K-means on patterns2.osql"
 ((osql "ref_sse(bc2vc(get_centroids_of_clustering(minimal_kmeans_file('data/patterns2.nt',5,20)))) < 120;")
 '((TRUE))))

:osql

 
 

 
 