delete function n;

create function n()->Bag of <Number a, Number b> as stored;

/*

create_index('n', 'a', 'mbtree', 'multiple');

*/


add n()=<x,x+1> from Number x where x in iota(1,100000);

create function findbinn(Number y)->Number
  as select y
     from Number dummy
     where n()=<dummy, y>;  

create function findxepsinn(Number x, Number eps)->Number
  as select n 
     from Number n, Number dummy
     where n()=<n, dummy>
       and n<=x+eps
       and n>=x-eps;  

create function findyepsinn(Number y, Number eps)->Number
  as select n 
     from Number n, Number dummy
     where n()=<dummy, n>
       and n<=y+eps
       and n>=y-eps;  


create function findallbinn(Integer k)->Number
 as count(findbinn(iota(1,k)));

count(findxepsinn(iota(1,1000),100)); 

findallbinn(10);

complexity(#'findallbinn', 100, 100, 1000);


