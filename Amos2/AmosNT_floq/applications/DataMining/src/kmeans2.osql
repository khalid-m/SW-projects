/* Decision theoretic measures for the evaluation of 
   the accuracy of a clustering in light of another 
   reference clustering */

/* Stored functions / realtions to store a clustering f(object)->cluster */
/* Used to compare / calculate accuracy of a test clustering t_c relative 
   to a reference clustering r_c */
create function t_c(Number o)->Number c as stored;
create function r_c(Number o)->Number c as stored;

/* Populate the the test and reference clustering relations */ 
/*clear_function("t_c");*/
/*add t_c(v[1])=v[0] from Vector of Number v where v = kmeans_file('./data/patterns.nt', 4, 100);*/
/*add t_c(v[1])=v[0] from Vector of Number v where v = optimal_kmeans_file('./data/patterns.nt', 13, 5, 20);*/

/*clear_function("r_c");*/
/*add r_c(v[1])=v[0] from Vector of Number v where v = kmeans_file('./data/patterns.nt', 4, 100);*/
/*add r_c(v[1])=v[0] from Vector of Number v where v = optimal_kmeans_file('./data/patterns.nt', 7, 5, 20);*/

create function same_diff(Object o1, Object o2)->Charstring
/* Determines if two objects are the same "S" or ar different "D" */
  as if o1 = o2 then result "S" else result "D";

create function clustering_contengency_tab()-> Bag of <Charstring, Integer>
/* Calculates counts for the four basic measures to determine 
   clustering accuracy based on clustering of object pairs:
   SS == True Positive:  The two objects are placed in the same cluster 
                         both in the test and ref clustering
   SD == False Positive: The two objects are placed in the same cluster 
                         in the test but not in the ref clustering
   DD == True Negative:  The two objects are placed in different clusters
                         both in the test and ref clustering
   DS == False Negative: The two objects are placed in different clusters 
                         in the test but not in the ref clustering 
   The problems is symetric, i.e., the decision, TP, TN, FP, FN, are the 
   same for (o1, o2) and (o2,o1), hence one one case is evaluated and the 
   counts reflect only one of the cases. 
   Essentailly, the result is a decision theoretic contingency table for 
   a clustering relative to a reference clustering. */ 
  as groupby((select g, c 
              from Charstring g, Integer c
              where <g,c> in groupby((select concat(same_diff(tc1, tc2), same_diff(rc1, rc2)), 1
                                      from Number to1, Number to2, Number tc1, Number tc2, 
                                      Number ro1, Number ro2, Number rc1, Number rc2
                                      where t_c(to1)=tc1
                                      and t_c(to2)=tc2
                                      /* pruning of symetric cases */  
                                      and to1 < to2
                                      and r_c(ro1)=rc1
                                      and r_c(ro2)=rc2
                                      and to1 = ro1
                                      and to2 = ro2),
                                     #'count')
                 or {g,c} in {{"SS",0},{"SD",0},{"DD",0},{"DS",0}}),
            #'sum');   

create function cctab()-> Vector of Vector
/* Same measures as in clustering_contingancy_tab() 
   but with more intuitive names and in order */
  as select {{"TP",v[3][1]},{"TN",v[0][1]},{"FP",v[1][1]},{"FN",v[2][1]}} 
     from Vector of Vector v    
     where v = sortbagby((clustering_contengency_tab()), 1, "inc");

create function cctab1()-> Vector of Number
/* Same measures as in clustering_contingancy_tab() 
   but without names but in the same order */
  as select {v[3][1], v[0][1], v[1][1], v[2][1]} 
     from Vector of Vector v    
     where v = sortbagby((clustering_contengency_tab()), 1, "inc");

create function ri(Vector of Number v)->Real
/* A common single measure, Rand Index, to evaluate the accuracy of a clustering
   relative to a reference clustering, i.e, percentage of correct decisions  */
  as (v[0]+v[1])/(v[0]+v[1]+v[2]+v[3]);

create function prec(Vector of Number v)->Real
/* Calculates the precision measure known in IR/ML*/
  as (v[0])/(v[0]+v[2]);

create function recall(Vector of Number v)->Real
/* Calculates the recall measure knownin IR/ML */
  as (v[0])/(v[0]+v[3]);

create function f_measure(Vector of Number v, Real b)->Real
/* Calculates the F-measure known in IR/ML 
   Parameter b (beta) weights the penalty on recall vs precision, 
   i.e., b>1 recall is weighted heavier and FN mistakes are penalized more
   and, b<1 precision is weighted heavier and FP mistakes are penalized more */
  as select((b*b+1)*p*r)/((b*b*p)+r)
     from Real p, Real r
     where p = prec(v)
       and r = recall(v);

/* Cluster data generator */

create function seed_3d_centroids(Integer n)->Bag of Vector of Number
/* Generates random 3d centroinds at n unit locations 
   from the space [1:10,1:10,1:10] */  
  as rand_sample((select {i, j, k}
                  from Integer i, Integer k, Integer j
                  where i in iota(1,10)
                    and j in iota(1,10)
                    and k in iota(1,10)),n); 

create function urrand(Real f, Real t)->Real
/* Generates a real random from the distribution ~U(f,t), f<t. */
  as ((rand(100000)/100000)*(t-f))+f;

create function urrands(Real f, Real t, Integer d)->Bag of Real
/* Generates a bag of n real random numbers with distribution ~U(f,t), f<t. */
  as for each Integer i where i in iota(1,d) result urrand(f,t);

create function urrandv(Real f, Real t, Integer d)->Vector of Real
/* Generates a d-dimensional vector of real random numbers 
   with distribution ~U(f,t), f<t. */
  as vectorof(urrands(f,t,d));
    
create function uniform_cloud(Vector of Number c, Real pm, Integer n)
                              ->Bag of Vector of Number 
/* Generates a uniform cloud of n dim(c)-dimensional datapoints centered 
   around c+-pm. */
  as for each Integer i where i in iota(1,n) result c+urrandv(-pm,pm,dim(c));    

create function clusterdata_3d(Integer k, Real pm, Integer n)
                               ->Bag of Vector of Number
/* Generates a 3d cluster dataset with k clusters 
   each of which is uniromly distributed a respective 
   cluster centroid c+-pm */
  as select uniform_cloud(seed_3d_centroids(k), pm, n);

