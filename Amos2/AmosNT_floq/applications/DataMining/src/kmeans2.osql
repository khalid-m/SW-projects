/*-*-sql-*-*******************************************************************/

/* Stored functions to store the datapoints and the cluster centroids */ 
create function datapoint(Integer d)->Vector of Number as stored;
create function centroid(Integer c)->Vector of Number as stored;
create function clustering(Integer clid)-><Number rid, Number k, Number dbi, Number Q, Vector of Vector cl> as stored;

create function datapoints()->Bag of Vector of Number 
/* Selects all data points */
  as select datapoint(i) from Integer i;

create function centroids()->Bag of Vector of Number 
/* Selects all centroids */
  as select centroid(i) from Integer i;

create function enumerate(Bag of Vector bv) ->Bag of <Integer i, Vector>
/* Enumerates a bag of vectors bv from  1 to count(b) */
as 
begin
  set i = 0;
  for each original Vector w where w  in bv
  begin
    set i = i + 1;
    result <i, w>;
  end;
end; 

create function load_vdp(Charstring file)->Boolean
/* Loads stored function datapoint from a file that
   contains amos Vectors */
  as add datapoint(i) = v
     from Integer i, Vector v, Bag of Vector bv
     where <i, v> in enumerate(bv)
       and bv = (read_ntuples(file)); 

create function rand_id(Bag of Object b) ->Bag of <Integer i, Object>
/* Assigns random ids to elements of a bag */
  as for each Object o where o in b result <rand(1000000), o>; 

create function rand_sample(Bag of Object b, Integer k)->Bag of Object 
/* Selects a random k-sized sample of a bag */  
  as select vo[i][1]
     from Integer i, Vector of Vector vo
     where vo = sortbagby(rand_id(b), 1, 'inc')
       and i < k;         

create function init_centroids(Integer k)->Boolean
/* Initializes stored function centroid to cointain k
   randomly selected points from stored function datapoint */
  as add centroid(i) = v
     from Integer i, Vector v, Bag of Vector bv
     where <i, v> in enumerate(bv)
       and bv = rand_sample(datapoints(), k);

create function p2c_distances()->Bag of <Integer, Integer, Number>
/* Calculates the Euclidean distance between every point and every centroid */
  as select p, c, d
     from Integer p, Integer c, Number d
     where d = euclid(datapoint(p), centroid(c));

create function argminv(Bag of Vector bv)->Object 
/* Returns the argument value a for which variable value v
   is minimal among the bag of v-a vectors */
  as {leastK((select v, a 
              from Object v, Object a
              where {v,a} in bv),1)}[1];

create function calc_cluster_assignment(Bag of <Integer, Integer, Number> p2c_dist)
                                        ->Bag of <Integer, Integer>
/* Calculates the cluster assignmment of datapoints based on centroids */
  as groupby((select p, {d,c} 
              from Integer p, Integer c, Number d
              where <p,c,d> in p2c_dist),
             #'argminv');

create function print_clustering_bag(Bag of <Integer, Integer> ca)->Bag of Vector
/* Prints a clustering of the datapoints according to ca*/ 
  as select {c, p, datapoint(p)} 
     from Integer c, Integer p
     where <p,c> in ca;

create function print_clustering()->Bag of Vector
/* Prints a clustering of the datapoints according to the current 
   assignment, i.e., current position of the centroids */ 
  as print_clustering_bag(calc_cluster_assignment(p2c_distances()));

create function col_means(Bag of Vector of Number bv)
                          -> Vector of Number
/* Calculates the columns-wise mean of a bag of vectors */
  as aggv(bv, #'avg');

create function calc_cluster_means(Bag of <Integer, Integer> ca)
                                   ->Bag of <Integer, Vector of Number>
/* Calculates the means of clusters */
  as groupby((select c, datapoint(p)
              from Integer c, Integer p
              where <p,c> in ca),
             #'col_means');

create function update_emit_centroids(Bag of <Integer, Vector of Number> cv)
                                      -> Bag of <Integer, Vector of Number> 
/* Updates and emits centroids */
  as for each Integer c, Vector v
     where <c, v> in cv
     begin
        set centroid(c)=v;
        result <c,v>;
     end;

create function kmeans_tcf(Vector of  Vector cv)
                           -> Vector of Vector 
/* k-means iteration step in form a transitive closure function */
  as sortbagby((select c, v
                from Integer c, Vector of Number v
                where <c, v> in update_emit_centroids(
                                   calc_cluster_means(
                                      calc_cluster_assignment(
                                          p2c_distances())))),
               1, 'inc');

create function kmeans_tclose(Vector of Vector input, 
                              Integer maxiter)
                              ->Vector of Vector
/* Iterative k-means clustering based on convergence of centroids */
   as select output
      from integer d, Vector of Vector output
      where <output, d> = tclose(#'kmeans_tcf', input, maxiter);

create function kmeans(Integer k, Integer maxiter) 
                       ->Bag of Vector
/* K-means algorithm to cluseter the high-dimensional in stored function datapoint */
as 
begin
  clear_function('centroid');
  init_centroids(k);
  kmeans_tclose({{}}, maxiter); 
  result print_clustering();
end;

create function kmeans_bag(Bag of Vector of Number bvd,
                           Integer k, Integer maxiter) 
                           ->Bag of Vector
/* K-means algorithm to cluster the high-dimensional datapoints in bvd */
as 
begin
  clear_function('datapoint');
  add datapoint(i) = v
  from Integer i, Vector v
  where <i, v> in enumerate(bvd);
  result kmeans(k, maxiter);
end;

create function kmeans_file(Charstring datafile, Integer k, Integer maxiter) 
                            ->Bag of Vector 
/* K-means algorithm to cluseter the high-dimensional data points in datafile */
as 
begin
  clear_function('datapoint');
  clear_function('centroid');
  load_vdp(datafile);
  init_centroids(k);
  result kmeans(k, maxiter);
end;

create function pcaproject3d_clustering(Bag of Vector bc)
                                        ->Bag of Vector
/* Function that projects the results of a clustering 
   down to 3 dimensions. Used for vizualization of high 
   dimensional clustering results */ 
  as select {cv[i], pv[i], pvv[i]}
     from Vector of Vector vc,
          Vector of Integer cv,
          Vector of Integer pv,
          Vector of Vector of Number vv,
          Vector of Vector pvv,
          Integer i
     where vc = vectorof(bc)
       and cv = vectorof(in(vc)[0])
       and pv = vectorof(in(vc)[1])
       and vv = vectorof(in(vc)[2])
       and pvv = vectorof(pcascore(in(vv),3));

create function disp_clustering3d_bag(Bag of <Integer, Integer> ca)->Integer
/* Displays a 3D scatter plot of the clustering ca. The centroids
   are displayed with a value 0, i.e., in black. 
   Centroids are not displayed after all, due to the PCA! */
  as scatter3p({1,2,3,4}, (select concat(project(v[2], {0,1,2}), {v[0]})
                           from Vector of Vector v
                           where v = print_clustering_bag(ca)));
                              /*or v in (select {0, 1, cv}
                                        from Vector of Number cv
                                        where cv = centroids()))); */

create function disp_clustering3d()->Integer
/* Displays a 3D scatter plot of the current clustering. The centroids
   are displayed with a value 0, i.e., in black. */
  as disp_clustering3d_bag(calc_cluster_assignment(p2c_distances()));



