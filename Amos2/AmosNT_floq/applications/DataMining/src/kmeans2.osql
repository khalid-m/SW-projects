/* Cluster quality measures */

create function calc_clust_mea(Function daggfn)->Bag of <Integer, Object> 
/* Evaluates the (distance)-aggregate function aggfn on each cluster of the clustering */  
  as groupby((select c, euclid(centroid(c), datapoint(p))
              from Integer c, Integer p
              where <p,c> in calc_cluster_assignment(p2c_distances())),
             daggfn); 

create function Q()->Number
/* Calculates Jagota cluster tightness mesaure */
  as sum(select (1/cnt)*sd
         from Integer c1, Integer cnt, Integer c2, Number sd
         where <c1,cnt> in calc_clust_mea(#'count')
           and <c2,sd> in calc_clust_mea(#'sum')
           and c1 = c2);

create function minimal_kmeans(Integer k,
                               Integer num_run,  
                               Integer maxiter)
                               ->Bag of Vector
/* Performs kmeans num_run number of times and returns the clustering 
   with the minimal q measure, i.e., highest tightness */
as 
begin
  declare Vector of Vector of Number vc, Number minQ;
  kmeans(k,maxiter);
  set minQ = Q();
  for each Integer i where i in iota(1,num_run-1)
  begin
    kmeans(k,maxiter);
    if (minQ > Q()) then
    begin
      set minQ = Q();
      set vc = vectorof(centroids());
    end;
  end;
  clear_function('centroid');
  add centroid(j) = vc[i] from Integer i, Integer j where j = i+1;
  result print_clustering();
end;  

create function minimal_kmeans_file(Charstring datafile, 
                                    Integer maxk, 
                                    Integer num_run, 
                                    Integer maxiter)
                                    ->Bag of Vector
/* Same as minimal_kmeans but the data points are first read from the 
   datafile file and stored in the stored function datapoint. */ 
as
begin
  clear_function('datapoint');
  load_vdp(datafile);
  result minimal_kmeans(maxk, num_run, maxiter);
end; 

create function minimal_kmeans_bag(Bag of Vector of Number bvd, 
                                   Integer maxk, 
                                   Integer num_run, 
                                   Integer maxiter)
                                   ->Bag of Vector
/* Same as minimal_kmeans but the data points are passed as a bag of 
   vectors and subsequently are stored in the stored function datapoint. */ 
as
begin
  clear_function('datapoint');
  add datapoint(i) = v
  from Integer i, Vector v
  where <i, v> in enumerate(bvd);
  result minimal_kmeans(maxk, num_run, maxiter);
end; 

create function kmeans_Qstat(Integer k,
                             Integer num_run,  
                             Integer maxiter)
                             ->Vector of Number
/* Performs kmeans num_run number of times and returns statistics
   (avg, stdev) of the corresponding Q-measures */
as 
begin
  declare Vector of Number Qs;
  set Qs = {};
  for each Integer i where i in iota(1,num_run)
  begin
    kmeans(k,maxiter);
    set Qs = concat(Qs, {Q()});    
  end;  
  result {vavgstdev(Qs)};
end;

/* Davies-Bouldin index: minimal value suggest optimal clustering i.e., k-value */

create function calc_avg_within_clust_dists()->Bag of <Integer, Number> 
/* Calculates average within cluster distances */  
  as calc_clust_mea(#'avg');

create function calc_between_clust_dists()->Bag of <Integer, Integer, Number>
/* Calculates the pair-wise distances between cluster centroids */
  as select c1, c2, euclid(centroid(c1), centroid(c2))
     from Integer c1, Integer c2;

create function DBi()->Number
/* Calculates the Davies-Bouldin index of a clustering */
  as 1.0/count(centroids()) *
     sum(select maxval
         from Number maxval, Integer g
         where <g, maxval> in groupby((select cw1, ((dw1 + dw2) / db12)
                                       from Integer cw1, Integer cw2,
                                            Number dw1, Number dw2, Number db12
                                       where <cw1, dw1> in calc_avg_within_clust_dists()
                                         and <cw2, dw2> in calc_avg_within_clust_dists()
                                         and <cw1, cw2, db12> in calc_between_clust_dists()
                                         and cw1 != cw2),
                                      #'maxagg'));

create function optimal_kmeans(Integer maxk, 
                               Integer num_run, 
                               Integer maxiter)
                               ->Bag of Vector
/* Performs kmeans with maximum iterations maxiter a num_run number of times
   with random inital centroids for varying values of k between 2 and maxk. 
   the data points to be clustered are stored in the sored frunction datapoint. 
   The results of the runs along with a cluster quality measure DBI are saved 
   in a stored function clustering. Based on the DBI measure the optial 
   clustering is emmited */ 
as
begin
  declare Integer clid;
  clear_function('clustering');
  /* Evaluate and store cluster quality measure dbi 
     for different clusterings for varying values of k */ 
  set clid = 1;
  for each Integer k where k in iota(2,maxk)
    for each Integer r where r in iota(1,num_run)
    begin
      kmeans(k,maxiter);
      add clustering(clid) = <r, k, dbi(), Q(), vectorof(centroids())>;
      set clid = clid + 1;
    end;
  /* Use the centroids of the optimal clustering */
  clear_function('centroid');
  add centroid(j) = cvs[i]
  from Integer i, Integer j, Vector of Vector of Number cvs, Integer r, Integer k, Number dbi, Number q
  where {r, k, dbi, q, cvs} = sortbagby((select clustering(i) from integer i), 3, 'inc')[0]
    and j = i+1;
  /* Emmit the clustering */
  result (select {c, p, datapoint(p)} 
          from Integer p, Integer c
          where <p,c> in calc_cluster_assignment(p2c_distances()));
end; 

create function optimal_kmeans_file(Charstring datafile, 
                                    Integer maxk, 
                                    Integer num_run, 
                                    Integer maxiter)
                                    ->Bag of Vector
/* Same as optimal_kmeans but the data points are first read from the 
   datafile file and stored in the stored function datapoint. */ 
as
begin
  clear_function('datapoint');
  load_vdp(datafile);
  result optimal_kmeans(maxk, num_run, maxiter);
end; 

create function optimal_kmeans_bag(Bag of Vector of Number bvd, 
                                   Integer maxk, 
                                   Integer num_run, 
                                   Integer maxiter)
                                   ->Bag of Vector
/* Same as optimal_kmeans but the data points are passed as a bag of 
   vectors and subsequently are stored in the stored function datapoint. */ 
as
begin
  clear_function('datapoint');
  add datapoint(i) = v
  from Integer i, Vector v
  where <i, v> in enumerate(bvd);
  result optimal_kmeans(maxk, num_run, maxiter);
end; 

create function optimal_kmeans_params()->Vector
/* Function to print the parameters for the "optimal" 
   kmeans clustering, according to the dbi clustering measure */
  as sortbagby((select clustering(i) from integer i), 3, 'inc')[0];

create function avg_dbi_k()->Vector of Vector
/* Calculates average dbi for each value of k */
  as sortbagby(groupby((select k, dbi
                        from Vector of Vector of Number cvs, 
                             Integer r, Integer k, Integer i, Number dbi, Number Q
                        where {r, k, dbi, Q, cvs} = {clustering(i)}),
                        #'avg'),
               1, 'inc');

create function min_dbi_k()->Vector of Vector
/* Calculates minimal dbi for each value of k */
  as sortbagby(groupby((select k, dbi
                        from Vector of Vector of Number cvs, 
                             Integer r, Integer k, Integer i, Number dbi, Number Q
                        where {r, k, dbi, Q, cvs} = {clustering(i)}),
                        #'minagg'),
               1, 'inc');

create function avg_Q_k()->Vector of Vector
/* Calculates average Q for each value of k */
  as sortbagby(groupby((select k, Q
                        from Vector of Vector of Number cvs, 
                             Integer r, Integer k, Integer i, Number dbi, Number Q
                        where {r, k, dbi, Q, cvs} = {clustering(i)}),
                        #'avg'),
               1, 'inc');

create function min_Q_k()->Vector of Vector
/* Calculates minimal Q for each value of k */
  as sortbagby(groupby((select k, dbi
                        from Vector of Vector of Number cvs, 
                             Integer r, Integer k, Integer i, Number dbi, Number Q
                        where {r, k, dbi, Q, cvs} = {clustering(i)}),
                        #'minagg'),
               1, 'inc');


