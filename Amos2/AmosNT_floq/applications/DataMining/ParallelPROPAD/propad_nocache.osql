start amos2 -n

start amos2 -s p1
start amos2 -s p2
start amos2 -s p3
start amos2 -s p4

amos2

register("coordinator");

< 'propad_coordinator_nocache.osql';

broadcast("< 'propad_node_nocache.osql';");

/* Load and partition transactions randomly into nodes */
load_distribute(4, cast(read_ntuples('../AmosMiner/data/transactions1000.nt') as Vector of Integer));

/* Number of transactions loaded in total */
count(castreceive('transactions',{}));

/* Number of transactions on the first node */
count(call_function('p1','transactions',{},1000));

count(propad(50));

count(propad(100));

