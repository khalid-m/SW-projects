 *
 * Description: Population of relational database through Amos II (FireBird)
 *
 ****************************************************************************/

set :a = jdbc("ibds", "interbase.interclient.Driver");

set :dbdir =
 "jdbc:interbase://localhost/"+getenv("AMOS_HOME")+"/demo/scenario/";

connect(:a,:dbdir+"EMPLOYEE.GDB", "SYSDBA", "masterkey");

sqlu(:a, "
create table person(
  ssn integer not null,
  name varchar(30),
  address varchar(30),
  primary key (ssn));
"); 

sqlu(:a, "
create table takes(
  ssn integer not null,
  cid integer not null,
  score integer,
  primary key (ssn,cid));
");

sqlu(:a, "
create table teaches(
  ssn integer not null,
  cid integer not null,
  primary key (ssn,cid));
");

sqlu(:a, "
create table course(
  cid integer not null,
  name varchar(30),
  primary key (cid));
");

create function addperson(jdbc c,integer ss,charstring nm,charstring address)->integer
  as select sqlu(c, "insert into person values(?,?,?);",{ss,nm,address});
addperson(:a,1000,"Tore","Byvägen 2");
addperson(:a,1001,"Carl","Villavägen 8");
addperson(:a,1002,"Bill","Skid Row");
addperson(:a,1003,"Ed","Lervägen 3");
addperson(:a,1004,"Mike","Dead End 1");
addperson(:a,1005,"Sue","Yellow Brick Road 4");
addperson(:a,1006,"Mona","Route 66");
addperson(:a,1007,"Lisa","Trollstigen 8");
addperson(:a,1008,"Peggy","Col de Sac 2");

create function addcourse(Jdbc c, Integer cid, Charstring nm)->Integer
   as select sqlu(c, "insert into course values(?,?);",{cid,nm});
addcourse(:a,1,"Math");
addcourse(:a,2,"Algorithms");
addcourse(:a,3,"Programming");

create function addteaches(Jdbc c, Integer ssn, Integer cid)->Integer
   as select sqlu(c, "insert into teaches values(?,?);",{ssn,cid});
addteaches(:a,1000,1);
addteaches(:a,1003,2);
addteaches(:a,1006,3);

create function addtakes(Jdbc c, Integer ssn, Integer cid, Integer score)
                        -> Integer
   as select sqlu(c, "insert into takes values(?,?,?);",{ssn, cid, score});
addtakes(:a, 1001,1,3);
addtakes(:a, 1002,1,2);
addtakes(:a, 1004,1,5);
addtakes(:a, 1005,2,3);
addtakes(:a, 1007,2,1);
addtakes(:a, 1008,3,3);

disconnect(:a);

quit;
