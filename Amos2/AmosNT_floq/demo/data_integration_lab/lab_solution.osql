/* b) */
latebinding('OR');
normalization(TRUE);
register('m');

/* from an AMOS2 database */
import_type('isyemp', 'isydb');
import_func('CHARSTRING.ID_TO_SSN->INTEGER', 'isydb');

/* from the ODBC wrapper */
import_type('IDAEMP_DS', 'idadb');

create derived type isyemp1 
  subtype of isyemp@isydb ie
  where wplace(ie) = 1;


/* c) */

select name(idae), ssn(idae) 
  from idaemp_ds@idadb idae, isyemp1 isye
  where id_to_ssn(id(isye)) = ssn(idae);


/* d) */
create derived type both_dept_person
subtype of idaemp_ds@idadb idae, isyemp1 isye
where
 id_to_ssn(id(isye)) = ssn(idae);

/* BUG:
select  idaemp_idadb.name->charstring(bdp), ssn(bdp) 
from BOTH_DEPT_PERSON  bdp;
--> No object found named IDAEMP_IDADB.NAME->CHARSTRING of type FUNCTION
*/

/* e) */
/* BUG: does not work because of the previous bug
select  idaemp_idadb.name->charstring(bdp), salary(bdp)+pay(bdp)
from BOTH_DEPT_PERSON  bdp;
*/

select name(idae), salary(idae)
from idaemp_ds@idadb idae, integer s
where s=ssn(idae) and
      notany(select name(isye) from isyemp1 isye where id_to_ssn(id(isye))=s);

select name(isye), pay(isye)
from isyemp1 isye, integer s
where s = id_to_ssn(id(isye)) and
      notany(select name(idae) from idaemp_ds@idadb idae where s = ssn(idae));


