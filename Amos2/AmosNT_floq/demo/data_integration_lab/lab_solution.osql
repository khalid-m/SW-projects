*/

/* f */
/* BUG:
No object found named BAG-CHARSTRING.IN->CHARSTRING of type FUNCTION

select distinct name
from charstring name
where name = in(select name(idae) from idaemp_ds@idadb idae)
      or
      name = in(select name(isye) from isyemp1 isye);
*/


/* g */
create derived type Allemp
  key integer ssn
  supertype of
    idaemp_ds@idadb idae = ssn(idae),
    isyemp1 isye = id_to_ssn(id(isye))
  functions
    (real_name charstring, real_ssn integer, real_salary integer)
    case idae:
       real_name   = name(idae);
       real_ssn    = ssn(idae);
       real_salary = salary(idae);
    case isye:
       real_name   = name(isye);
       real_ssn    = id_to_ssn(id(isye));
       real_salary = pay(isye);
    case idae, isye:
       real_name   = name(idae);
       real_ssn    = ssn(idae);
       real_salary = salary(idae) + pay(isye);
  end functions
  properties (room charstring);

/* TAKES 10 SECONDS TO EXECUTE !!! */
select real_name(ae), real_salary(ae), real_ssn(ae) from Allemp ae;
