		{0,10,20,30,50,100,200,500,600,650,700,750,800,5000},
	functionnamed("eventfile.integer.integer.integer.tuneII_SH->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial on II and SH for advanced CM with full stat.");
end;

