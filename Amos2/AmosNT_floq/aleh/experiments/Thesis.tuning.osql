create function udf_exectime() -> boolean as
begin
	exectime_udfs("udfs_exectime.mei.txt");
	sendmessage("Exectime for UDFs");
end;


/********************************************************************
			PROFILED GROUPING TUNING
 *******************************************************************/

/* Dynamic query processing.
	Fast stat collecting.
	It is run on t.root file.
	Run with run.root.sh and load master.current.aucm.hagrid.osql 
	from osql */
create function profilingAUcmFaststatGreedyGreedy() -> boolean as
begin
	declare eventfile f;
	openwritefile("profileTune.aucm.stat.greedy.greedy.txt");
	select file into f from eventfile file 
		where name(experiment(file))="bkg2" and id(file)=0;
	for each integer i where i in {1,2,3,4,5,7,10}
		runTuneProfiling(f,"NaiveStat","GreedyOpt","GreedyOrder",i,5);
	runTuneProfiling(f,"NaiveStat","GreedyOpt","GreedyOrder",0,5);
	closewritefile();
	sendmessage("Profiling, AUcm Fast stat Greedy opt, greedy order");
end;

