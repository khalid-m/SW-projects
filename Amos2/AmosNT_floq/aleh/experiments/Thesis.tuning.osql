/**************************************************************************
 ************ Tuning optimization of nested subqueries
 *************************************************************************/

/* Factorial experiment to tune choise of II and SH iterations for randomopt
	for top level and nested subqueries.
	It is run on t.root file. It is compared with ranksort.
	Run with run.current.sh */
create function tuning2levelQO() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("twoLevelFactorial.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	tocollectstat("charstring.expcuts->event",1.65,0.15);
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	factorial({{0,0},{1,30},{23,650}},
		{{0,0},{10,10},{10,50},{50,50},{100,100},{100,1000},
			{100,10000}},
		functionnamed("eventfile.vector.vector.integer.qo2level->real")
		,f,5);
	closewritefile();
	sendmessage("Two level factorial is done.");
end;

/* Factorial experiment to tune choise of II and SH iterations for randomopt
	for nested subqueries.
	It is run on t.root file.
	Run with run.current.sh */
