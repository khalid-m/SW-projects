begin
	declare eventfile f, charstring fpath;
	openwritefile("topNested.aucm.Faststat.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	tocollectstatnaive("charstring.expcuts->event",1.65,0.15);
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	tuneII_SHnestedForBest(f,0,0,5);
	factorial({800,1000,1500,5000,10000},
		{500,1000,1500,5000,10000,15000},
		functionnamed(
	"eventfile.integer.integer.integer.tuneTopNestedSH->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial of top and nested SH for auCM fast stat");
end;


/************************************************************************
 ********* Measuring profile-controler overhead.
 ***********************************************************************/

/* Measuring overhead of profile-controller operator.
	Run with run.current.sh */
create function controller_overhead() -> boolean as
begin
	openwritefile("overhead.bkgs.2003.txt");
	measure_overhead(41,5);
	closewritefile();
	sendmessage("Measuring overhead of profile controller");
end;

/* Run with run.current.2005.sh */
create function controller_overhead2005() -> boolean as
begin
	openwritefile("overhead.bkgs.2005.txt");
	measure_overhead(41,5);
	closewritefile();
	sendmessage("Measuring overhead of profile controller");
end;

/************************************************************************
 ******** Impact of initial optimization and optimization of grouping
 ***********************************************************************/

/* Impact of initial optimization on total time of dynamic query execution.
  It is compared with possibility to find a plan during query reoptimization.
  The grouping is performed with ranksort only.
	Run with run.current.sh */
create function initialOptimization() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("initOpt.T.2003.txt");
	select file, filename(file) into f,fpath from eventfile file 
		where name(experiment(file))="bkg2" and id(file)=0;
	expcuts(fpath); /* warming up */
	factorial({{0,0,0,0},{1,30,0,0},{23,650,60,300}},
		{{0,0,0,0},{1,30,0,0},{23,650,60,300}},
		functionnamed("eventfile.vector.vector.integer.initOpt->real")
		,f,5);
	closewritefile();
	sendmessage("Initial optimization");
end;

/* Impact of initial optimization and grouping optimization on total time 
	of dynamic query execution. Dynamic reoptimization is done by randomopt
	in fast way.
	Run with run.current.sh */
create function initialOptimization2() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("initOpt2.T.2003.txt");
	select file,filename(file) into f,fpath from eventfile file 
		where name(experiment(file))="bkg2" and id(file)=0;
	expcuts(fpath); /* warming up */
	factorial({{0,0,0,0},{1,30,0,0},{23,650,60,300}},
		{{0,0,0,0},{1,30,0,0},{23,650,60,300}},
		functionnamed("eventfile.vector.vector.integer.initOpt2->real")
		,f,5);
	closewritefile();
	sendmessage("Initial optimization 2");
end;

