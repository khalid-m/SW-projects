begin
	declare eventfile f, charstring fpath;
	openwritefile("II_SHfactorial.nested.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	tocollectstat("charstring.expcuts->event",1.65,0.15);
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	tuneII_SHnestedForBest(f,0,0,5);
	factorial({1,10,20,40,60,80,100,150},
		{0,10,50,100,200,300,500,600,700,800,900,1000},
		functionnamed(
	"eventfile.integer.integer.integer.tuneII_SHnestedForBest->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial experiment of II and SH for nested subqueries");
end;

