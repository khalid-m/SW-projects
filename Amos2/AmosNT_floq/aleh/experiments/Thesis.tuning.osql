<'Thesis.experiments.osql';

/* Tuning alpha and delta for statistics on particles cardinality.
	Run with run.current.sh */
create function tuneCardStat() -> boolean as
begin
	declare eventfile f;
	openwritefile("tuneCardStat.T.2003.txt");
	select file into f
	from eventfile file
	where name(experiment(file))="bkg2" and id(file)=0;
	expcuts(); /* warming up */
	/* no stat */
	noCardStat(f,5);
	/* Alpha = 98%, 95%, 90% */
	factorial({2.33,1.96,1.65},{0.025,0.05,0.1,0.15},
		functionnamed("eventfile.real.real.integer.tuneCardStat->real")
				,f,5);
	/* entire file */
	cardStatFullFile(f,5);
	closewritefile();
	sendmessage("Tuning cardinality statistics is done");
end;

/* Demonstrates behaviour of choosen points for cardinality statistics on
	all bkg files.
	Run with run.current.sh */
create function checkCardStat() -> boolean as
begin
	openwritefile("tuneCardStat.All.2003.txt");
	for each eventfile f
	begin
		expcuts(filename(f)); /* warming */
		tuneCardStat(f,1.65,0.15,5);
		tuneCardStat(f,1.96,0.1,5);
		cardStatFullFile(f,5);
	end;
	closewritefile();
	sendmessage("Checking cardinality statistics is done");
end;


/******************************************************************
 ******* Tuning II and SH on top
 *****************************************************************/

/* Factorial experiment to tune choise of II and SH iterations for randomopt.
	It is run on t.root file. It is compared with ranksort.
	Run with run.current.sh */
create function II_SHfactorial() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("II_SHfactorial.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	tocollectstat("charstring.expcuts->event",1.65,0.15);
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	factorial({0,10,20,40,60,80},{0,10,100,200,300,500,1000,1500, 5000},
	functionnamed("eventfile.integer.integer.integer.tuneII_SH->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial experiment of II and SH is done.");
end;

/* More precise factorial experiment to tune choise of II and SH 
	iterations for randomopt.
	It is run on t.root file.
	Run with run.current.sh */
create function II_SHfactorial2() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("II_SHfactorial2.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	tocollectstat("charstring.expcuts->event",1.65,0.15);
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	factorial({1,5,9,13,17,21,25,23},
		{0,10,20,30,50,100,200,500,600,650,700,750,800},
	functionnamed("eventfile.integer.integer.integer.tuneII_SH->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial experiment 2 on II and SH is done.");
end;

/* Factorial experiment to tune choise of II and SH iterations for randomopt.
	Using Full query processing and statistics collected on entire file.
	It is run on t.root file.
	Run with run.current.sh */
create function II_SHfactorialFullStat() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("II_SHfactorial.FullQP.FullStat.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	grouping(true);
	ungroup(true);
	reoptimize0("charstring.expcuts->event");
	grouping(false);
	sobjectstat();
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	sobjectstat(false);
	factorial({1,5,9,13,17,21,25,23},
		{0,10,20,30,50,100,200,500,600,650,700,750,800,5000},
	functionnamed("eventfile.integer.integer.integer.tuneII_SH->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial on II and SH with full QP and Full stat");
end;

/* Factorial experiment to tune choise of II and SH iterations for randomopt.
	It is run on t.root file.
	Dynamic query processing only. Fast collecting statistics.
	Run with run.root.sh and load master.current.aucm.hagrid.osql 
	from osql */
create function II_SHfactorialAUcm() -> boolean as
begin
	declare eventfile f, charstring fpath;
	openwritefile("II_SHfactorial.aucm.FastStat.T.2003.txt");
	select file, filename(file) into f, fpath
		from eventfile file
		where name(experiment(file))="bkg2" and id(file)=0;
	drop_sobjectstat();
	tocollectstatnaive("charstring.expcuts->event",1.65,0.15);
	expcuts(fpath); /*collecting stat for better optimization. 
					warming*/
	tuneII_SH(f,0,0,5);
	factorial({1,5,9,13,17,21,25,23},
		{0,10,20,30,50,100,200,500,600,650,700,750,800,5000},
	functionnamed("eventfile.integer.integer.integer.tuneII_SH->real")
				,f,5);
	closewritefile();
	sendmessage("Factorial on II and SH for advanced CM with fast stat");
end;

/* Factorial experiment to tune choise of II and SH iterations for randomopt.
	It is run on t.root file.
	Dynamic query processing only. Collecting stat on entire data set.
	Run with run.root.sh and load master.current.aucm.hagrid.osql from 
	osql */
