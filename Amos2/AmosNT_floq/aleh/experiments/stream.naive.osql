create function OptSignal(integer nrEvents, integer rptForAvg) -> boolean as
begin
	declare real avgtime, real sqsum, real stdev, integer passedevents,
		real filefanout, eventfile f;
	select sf into f from eventfile sf where name(experiment(sf))="signal";
	optallcuts(filename(f),0,(nrEvents-1));
	select a,q,s,p into avgtime,sqsum,stdev,passedevents
	from real a, real q, real s, integer p
	where <a,q,s,p> = 
		execute("integer.signaloptallcuts->event",(nrEvents-1),
			rptForAvg);
	set filefanout = cast(passedevents as real)/size(f);
	myprint(0,avgtime,stdev,sqsum,nrEvents,passedevents,filefanout);
end;

