create function signalsixcuts(integer idEvent) -> event ev as
select ev
from eventfile f
where name(experiment(f))="signal" and fileid(f)=0 and
	ev=sixcuts(filename(f),0,idEvent);

create function signalfourcuts(integer idEvent) -> event ev as
select ev
from eventfile f
where name(experiment(f))="signal" and fileid(f)=0 and
	ev=fourcuts(filename(f),0,idEvent);

create function signalscientsixcuts(integer idEvent) -> event ev as
select ev
from eventfile f
where name(experiment(f))="signal" and fileid(f)=0 and
	ev=scientsixcuts(filename(f),0,idEvent);

create function signalpapersixcuts(integer idEvent) -> event ev as
select ev
from eventfile f
where name(experiment(f))="signal" and fileid(f)=0 and
	ev=papersixcuts(filename(f),0,idEvent);

create function signaloptsixcuts(integer idEvent) -> event ev as
select ev
from eventfile f
where name(experiment(f))="signal" and fileid(f)=0 and
	ev=optsixcuts(filename(f),0,idEvent);

create function signaloptfourcuts(integer idEvent) -> event ev as
select ev
from eventfile f
where name(experiment(f))="signal" and fileid(f)=0 and
	ev=optfourcuts(filename(f),0,idEvent);
