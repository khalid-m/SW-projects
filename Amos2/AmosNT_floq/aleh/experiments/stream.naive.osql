create function bkg2sixcuts(integer fid) -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and fileid(f)<fid and ev=sixcuts(filename(f));

create function bkg2fourcuts(integer fid) -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and fileid(f)<fid and ev=fourcuts(filename(f));

create function bkg2optsixcuts(integer fid) -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and fileid(f)<fid and ev=optsixcuts(filename(f));

create function bkg2optfourcuts(integer fid) -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and fileid(f)<fid and 
	ev=optfourcuts(filename(f));

create function bkg2scientsixcuts(integer fid) -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and fileid(f)<fid and 
	ev=scientsixcuts(filename(f));

create function bkg2papersixcuts(integer fid) -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and fileid(f)<fid and 
	ev=papersixcuts(filename(f));
