create function bkgsoptsixcuts() -> event as
select ev
from eventfile f
where name(experiment(f))="bkg2" and ev=optsixcuts(filename(f));

create function bkgsoptfourcuts() -> event as
select ev
from eventfile f
where name(experiment(f))="bkg2" and ev=optfourcuts(filename(f));
