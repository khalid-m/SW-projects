create function bkgssixcuts() -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and ev=sixcuts(filename(f));

create function bkgsfourcuts() -> event ev as
select ev
from eventfile f
where name(experiment(f))="bkg2" and ev=fourcuts(filename(f));
