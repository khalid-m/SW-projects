load_lisp('../experiments/stream.naive.lsp');

create function sendmessage(charstring m) -> boolean as
select tosystem("echo "+m+" | mail ruslan@it.uu.se -s \""+m+" is done\"");

create function myprint (integer, real, real, real, integer,
			real) -> boolean as foreign 'myprint';
create function myprint (integer, real, real, real, integer, integer,
			real) -> boolean as foreign 'myprint';
