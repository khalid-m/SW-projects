	set fn = "charstring.expcuts->event";
	for each real zAlpha, real Delta where zAlpha in zAlphas
						and Delta in Deltas
	begin
		drop_structstat();
		select s,n into st,sn
		from real s, integer n
		where <s,n> = getstats("../../wrappers/ROOTWrap/t.root",
					zAlpha,Delta,10);
		optmethod('ranksort');
		reoptimize('charstring.expcuts->event');
		select e,s into extG,steG
		from real e, real s, integer r
		where <e,s,r> = 
			execute(fn,theBkgFile,1,1);
		optmethod('randomopt');
		optlevel(ii,shIn);
		reoptimize('charstring.expcuts->event');
		optlevel(ii,sh0);
		reoptimize0('charstring.expcuts->event');
		select e,s into extR,steR
		from real e, real s, integer r
		where <e,s,r> = 
			execute(fn,theBkgFile,1,1);
		myprint(zAlpha,Delta,st,sn,extG,steG,extR,steR);
	end;
end;
