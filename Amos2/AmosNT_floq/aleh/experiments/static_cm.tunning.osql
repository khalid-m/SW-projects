create function statCollecting(integer rpt, integer delta) -> boolean as
begin
	optmethod('randomopt');
	optlevel(100,1000);
	for each integer i, integer st where i=iota(1,rpt) and st=(i-1)*delta
	begin
		declare real calls, real results, real sqsum,
			real elmean, real elstderr,
			real mumean, real mustderr,
			real jbmean, real jbstderr,
			real ctR, real fanR, real extR,
			real ctG, real fanG, real extG;
		getstructstat("../bkg2Events_ruslan_000.root",st,delta);
		structstat(false);
		select c,r,s into calls,results,sqsum 
			from integer c, integer r, integer s
			where <c,r,s> =struct_stat(typenamed("event"),4);
		set elmean = results/calls;
		set elstderr = sqrt((sqsum/calls-elmean*elmean)/calls);
		select c,r,s into calls,results,sqsum 
			from integer c, integer r, integer s
			where <c,r,s> =struct_stat(typenamed("event"),5);
		set mumean = results/calls;
		set mustderr = sqrt((sqsum/calls-mumean*mumean)/calls);
		select c,r,s into calls,results,sqsum 
			from integer c, integer r, integer s
			where <c,r,s> =struct_stat(typenamed("event"),6);
		set jbmean = results/calls;
		set jbstderr = sqrt((sqsum/calls-jbmean*jbmean)/calls);
		optmethod('randomopt');
		optlevel(100,1000);
		reoptimize('expcuts->event');
		optlevel(100,10000);
		reoptimize0('expcuts->event');
		select c,f into ctR,fanR
			from real c, real f
			where <c,f> = plan_cost('expcuts->event');
		set extR=expcuts_bkg(3);
		optmethod('ranksort');
		reoptimize('expcuts->event');
		select c,f into ctG,fanG
			from real c, real f
			where <c,f> = plan_cost('expcuts->event');
		set extG=expcuts_bkg(3);
		my_print(i,calls,elmean,elstderr,mumean,mustderr,
			jbmean,jbstderr,ctR,fanR,extR,ctG,fanG,extG);
	end;
end;

create function noAndAllStat(integer filenr, charstring GNfile, 
	charstring RNfile, charstring Afile) -> boolean as
begin
	optlevel(100,1000);
	optmethod('ranksort');
	reoptimize('charstring.expcuts->event');
	openwritefile(GNfile);
	for each bkgfile f, integer fileid 
	where fileid=id(f) and fileid = iota(0,filenr)
	begin
		declare real avgtime, real stderror, integer passedevents,
			real ct, real fan;
		select a,s,p into avgtime,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",location(f), 
				3, 1);
		select c,f into ct,fan
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
		myprint(fileid,avgtime,ct,fan);
	end;
	closewritefile();
	optmethod('randomopt');
	reoptimize('charstring.expcuts->event');
	openwritefile(RNfile);
	for each bkgfile f, integer fileid 
	where fileid=id(f) and fileid = iota(0,filenr)
	begin
		declare real avgtime, real stderror, integer passedevents,
			real ct, real fan;
		select a,s,p into avgtime,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",location(f), 
				3, 1);
		select c,f into ct,fan
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
		myprint(fileid,avgtime,ct,fan);
	end;
	closewritefile();
	openwritefile(Afile);
	for each bkgfile f, integer fileid 
	where fileid=id(f) and fileid = iota(0,filenr)
	begin
		declare real avgtimeG, real stderror, integer passedevents,
			real ctG, real fanG, 
			real avgtimeR, real ctR, real fanR;
		getstructstat(location(f),25000);
		structstat(false);
		optmethod('ranksort');
		reoptimize('charstring.expcuts->event');
		select a,s,p into avgtimeG,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",location(f), 
				3, 1);
		select c,f into ctG,fanG
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
		optmethod('randomopt');
		reoptimize('charstring.expcuts->event');
		select a,s,p into avgtimeR,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",location(f), 
				3, 1);
		select c,f into ctR,fanR
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
		myprint(fileid,avgtimeG,ctG,fanG,avgtimeR,ctR,fanR);
		drop_structstat();
	end;
	closewritefile();
end;

create function NoAndAllStatSignal() -> boolean as
begin
	declare charstring signalFile, real avgtimeNG, real stderror, 
		integer passedevents, real ctNG, real fanNG, real avgtimeNR, 
		real ctNR, real fanNR, real avgtimeAG, real ctAG, real fanAG,
		real avgtimeAR, real ctAR, real fanAR;
	select location(f) into signalFile from signalfile f;
	optlevel(100,1000);
	optmethod('ranksort');
	reoptimize('charstring.expcuts->event');
	select a,s,p into avgtimeNG,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",signalFile,3,1);
	select c,f into ctNG,fanNG
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
	optmethod('randomopt');
	reoptimize('charstring.expcuts->event');
	select a,s,p into avgtimeNR,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",signalFile,3,1);
	select c,f into ctNR,fanNR 
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
	getstructstat(signalFile,8623);
	structstat(false);
	optmethod('ranksort');
	reoptimize('charstring.expcuts->event');
	select a,s,p into avgtimeAG,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",signalFile,3,1);
	select c,f into ctAG,fanAG
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
	optmethod('randomopt');
	reoptimize('charstring.expcuts->event');
	select a,s,p into avgtimeAR,stderror,passedevents
		from real a, real s, integer p
		where <a,s,p> = 
			execute("charstring.expcuts->event",signalFile,3,1);
	select c,f into ctAR,fanAR 
		from real c, real f
		where <c,f> = plan_cost("charstring.expcuts->event");
	myprint(0,avgtimeNG,ctNG,fanNG,avgtimeNR,ctNR,fanNR,avgtimeAG,ctAG,
		fanAG,avgtimeAR,ctAR,fanAR);
end;

create function IItuning(integer nrII, integer stepII,
	integer SH, charstring fn) -> boolean as
begin
	declare real rt, real rse, real cst, real fnt, real ext, real ste,
		charstring theBkgFile;
	set theBkgFile = "../../wrappers/ROOTWrap/t.root";
	group_optmethods('randomopt','randomopt');
	for each integer ii where ii=stepII*iota(1,nrII)
	begin
		group_optlevels(ii,SH,ii,SH);
		select ot,se into rt,rse
		from real ot, real se
		where <ot,se> = reopt2(fn,3);
		select c,f into cst,fnt
		from real c, real f
		where <c,f> = plan_cost(fn);
		select e,s into ext,ste
		from real e, real s, integer r
		where <e,s,r> = 
			execute(fn,theBkgFile,1,3);
		myprint(ii,rt,rse,cst,fnt,ext,ste);
	end;
end;

create function SHtuning(integer startSHnr, integer nrSH, integer stepSH,
	integer II, charstring fn) -> boolean as
begin
	declare real rt, real rse, real cst, real fnt, real ext, real ste,
		charstring theBkgFile;
	set theBkgFile = "../../wrappers/ROOTWrap/t.root";
	group_optmethods('randomopt','randomopt');
	for each integer sh where sh=stepSH*iota(startSHnr,nrSH)
	begin
		group_optlevels(II,sh,II,sh);
		select ot,se into rt,rse
		from real ot, real se
		where <ot,se> = reopt2(fn,1);
		select c,f into cst,fnt
		from real c, real f
		where <c,f> = plan_cost(fn);
		select e,s into ext, ste
		from real e, real s, integer r
		where <e,s,r> = 
			execute(fn,theBkgFile,1,5);
		myprint(sh,rt,rse,cst,fnt,ext,ste);
	end;
end;

create function optimizationSubqueries(charstring optm0, integer ii0, 
	integer sh0, bag iis, integer shnr, integer shstep) -> boolean as
begin
	declare real optt, real optse, real cst, real fnt, real ext, real ste,
		charstring theBkgFile;
	set theBkgFile = "../../wrappers/ROOTWrap/t.root";
	group_optmethods(optm0,'ranksort');
	group_optlevels(ii0,sh0,0,0);
	select ot,se into optt,optse
	from real ot, real se
	where <ot,se> = reopt2('charstring.expcuts->event',1);
	select c,f into cst,fnt
	from real c, real f
	where <c,f> = plan_cost('charstring.expcuts->event');
	select e,s into ext,ste
	from real e, real s, integer r
	where <e,s,r> = 
		execute('charstring.expcuts->event',theBkgFile,1,1);
	myprint(optm0,ii0,sh0,'ranksort',0,0,optt,optse,cst,fnt,ext,ste);
	for each integer ii, integer sh 
	where ii in iis and sh=shstep*iota(0,shnr)
	begin
		group_optmethods(optm0,'randomopt');
		group_optlevels(ii0,sh0,ii,sh);
		select ot,se into optt,optse
		from real ot, real se
		where <ot,se> = reopt2('charstring.expcuts->event',1);
		select c,f into cst,fnt
		from real c, real f
		where <c,f> = plan_cost('charstring.expcuts->event');
		select e,s into ext,ste
		from real e, real s, integer r
		where <e,s,r> = 
			execute('charstring.expcuts->event',theBkgFile,1,1);
		myprint(optm0,ii0,sh0,'randomopt',ii,sh,optt,optse,cst,fnt,ext,
			ste);
	end;
end;

create function statTuning(bag zAlphas, bag Deltas, integer ii, integer shIn,
			integer sh0) -> boolean as
begin
	declare real st, integer sn, real extG, real steG, real extR, 
		real steR, charstring theBkgFile, charstring fn;
