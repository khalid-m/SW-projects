<'../experiments/stream.osql';

create function my_print(charstring, charstring, real, real, real,
		real, real, real, integer, real, real) -> boolean as 
	foreign 'myprint';

create function my_print(charstring, integer, real, real, real,
		real, real, real, integer, real, real) -> boolean as 
	foreign 'myprint';

create function reoptimize0(charstring fnname, integer rptAvg) ->
		<real opt_avg, real opt_sqsum, real opt_stdev, real avgtime,
		real sqsum, real stdev, integer passedevents, 
		real cst, real fnt> as
begin
	select a,sq,sd into opt_avg, opt_sqsum, opt_stdev
	from real a, real sq, real sd
	where <a,sq,sd> = reoptfn0(fnname,rptAvg);

	select c,f into cst, fnt
	from real c, real f
	where <c,f> = plan_cost(fnname);

	select a,q,s,p into avgtime,sqsum,stdev,passedevents
	from real a, real q, real s, integer p
	where <a,q,s,p> = execute(fnname,rptAvg);

	result <opt_avg,opt_sqsum,opt_stdev,
		avgtime,sqsum,stdev,passedevents,cst,fnt>;
end;

create function reoptimize(charstring fnname, integer rptAvg) ->
		<real opt_avg, real opt_sqsum, real opt_stdev, real avgtime,
		real sqsum, real stdev, integer passedevents, 
		real cst, real fnt> as
begin
	select a,sq,sd into opt_avg, opt_sqsum, opt_stdev
	from real a, real sq, real sd
	where <a,sq,sd> = reoptfn(fnname,rptAvg);

	select c,f into cst, fnt
	from real c, real f
	where <c,f> = plan_cost(fnname);

	select a,q,s,p into avgtime,sqsum,stdev,passedevents
	from real a, real q, real s, integer p
	where <a,q,s,p> = execute(fnname,rptAvg);

	result <opt_avg,opt_sqsum,opt_stdev,
		avgtime,sqsum,stdev,passedevents,cst,fnt>;
end;

create function reopt_level(integer rptAvg) -> boolean as
begin
	declare real opt_avg, real opt_sqsum, real opt_stdev, real avgtime,
		real sqsum, real stdev, integer passedevents, 
		real cst, real fnt, integer collected;

	/* Optimization on top with no statistics */
	select TRUE
	where <opt_avg,opt_sqsum,opt_stdev,avgtime,sqsum,stdev,passedevents,
			cst,fnt> = reoptimize0("bkgsexpcuts->event",rptAvg) and
		my_print("Top level","No stat",opt_avg,opt_sqsum,opt_stdev,
			avgtime,sqsum,stdev,passedevents,cst,fnt);

	/* Collect full statistics and optimize on top again */
	structstat();
	set collected = count(select aleh_stream(location(f)) from bkgfile f);
	structstat(FALSE);

	select TRUE
	where <opt_avg,opt_sqsum,opt_stdev,avgtime,sqsum,stdev,passedevents,
			cst,fnt> = reoptimize0("bkgsexpcuts->event",rptAvg) and
		my_print("Top level",collected,opt_avg,opt_sqsum,opt_stdev,
			avgtime,sqsum,stdev,passedevents,cst,fnt);

	/* Optimize everywhere with stat */
	select TRUE
	where <opt_avg,opt_sqsum,opt_stdev,avgtime,sqsum,stdev,passedevents,
			cst,fnt> = reoptimize("bkgsexpcuts->event",rptAvg) and
		my_print("All levels",collected,opt_avg,opt_sqsum,opt_stdev,
			avgtime,sqsum,stdev,passedevents,cst,fnt);

	/* With No stat */
	drop_structstat();

	select TRUE
	where <opt_avg,opt_sqsum,opt_stdev,avgtime,sqsum,stdev,passedevents,
			cst,fnt> = reoptimize("bkgsexpcuts->event",rptAvg) and
		my_print("All levels","No stat",opt_avg,opt_sqsum,opt_stdev,
			avgtime,sqsum,stdev,passedevents,cst,fnt);
end;

