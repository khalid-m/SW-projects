	openwritefile("full.fastStat.greedyOpt.bkgs.2003.txt");
	for each integer i where i in {1,9,17,25,33,41}
		runReoptExperiment("integer.bkg2sixcuts->event",i,5,"FastStat",
				"GreedyOpt","Mat");
	closewritefile();
	sendmessage("Full QP with fast stat and greedy opt bkgs 2003");
end;

