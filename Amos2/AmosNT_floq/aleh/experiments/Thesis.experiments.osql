<'stream.osql';
load_lisp("udfs_exectime.lsp");

/**********************************************************************
 ***** Dynamic query processing, i.e. advanced cost model with
 ***** dynamic reoptimization.
 *********************************************************************/

/* Scaling over bkgs with 2003 query. Best optimization with
	cost model for aggregates and UDFs and fast stat collecting.
	run with run.root.sh and load master.current.aucm.hagrid.osql 
	from osql */
create function aucmFaststatBestoptBkg2003() -> boolean as
begin
	openwritefile("aucm.fastStat.bestOpt.bkgs.2003.txt");
	for each integer i where i in {1,9,17,25,33,41}
		runReoptExperiment("integer.bkg2sixcuts->event",i,5,"FastStat",
				"DynBestOpt","Naive");
	closewritefile();
	sendmessage("Full CM with fast stat and best opt bkgs 2003");
end;

/* Scaling over bkgs with 2005 query. Best optimization with
	cost model for aggregates and UDFs and fast stat collecting.
	DynStatCM
	run with run.root.sh and load master.current.aucm.hagrid.2005.osql 
	from osql */
create function aucmFaststatBestoptBkg2005() -> boolean as
begin
	openwritefile("aucm.fastStat.bestOpt.bkgs.2005.txt");
	for each integer i where i in {1,9,17,25,33,41}
		runReoptExperiment("integer.bkg2fourcuts->event",i,5,
			"FastStat","DynBestOpt","Naive");
	closewritefile();
	sendmessage("Full CM with fast stat and best opt bkgs 2005");
end;

/* Scaling over signal with 2003 query. Best optimization with
	cost model for aggregates and UDFs and fast stat collecting.
	run with run.root.sh and load master.current.aucm.hagrid.osql 
	from osql */
create function aucmFaststatBestoptSignal2003() -> boolean as
begin
	openwritefile("aucm.fastStat.bestOpt.signal.2003.txt");
	for each integer i where i in {1437,2874,4311,5748,7185,8622}
		runReoptExperiment("integer.signalsixcuts->event",(i-1),5,
				"FastStat","DynBestOpt","Naive");
	closewritefile();
	sendmessage("Full CM with fast stat and best opt signal 2003");
end;

