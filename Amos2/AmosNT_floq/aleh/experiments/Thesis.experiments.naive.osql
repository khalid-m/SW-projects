	OptBkgPart(9,5);
	OptBkgPart(17,5);
	OptBkgPart(25,5);
	OptBkgPart(33,5);
	OptBkgPart(41,5);
	closewritefile();
	sendmessage("Manual bkgs 2003");
end;
*/
