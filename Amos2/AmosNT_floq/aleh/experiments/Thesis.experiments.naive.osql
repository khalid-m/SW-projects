/*******************************************************************
 ********** UNOPT
 ******************************************************************/

/* Scaling over bkgs with 2003 query. Basic approach, i.e. with no CM, 
	ranksort optimization, no materialization, and no rewritings. 
	run with run.current.basic.sh 
create function basicBkg2003() -> boolean as
begin
	openwritefile("basic.bkgs.2003.txt");
	ExpBkgPart(1,5);
	ExpBkgPart(9,5);
	ExpBkgPart(17,5);
	ExpBkgPart(25,5);
	ExpBkgPart(33,5);
	ExpBkgPart(41,5);
	closewritefile();
	sendmessage("Basic bkgs 2003");
end;
*/
/* Scaling over bkgs with 2005 query. Basic approach, i.e. with no CM, 
	ranksort optimization, no materialization, and no rewritings. 
	run with run.current.basic.2005.sh 
create function basicBkg2005() -> boolean as
begin
	openwritefile("basic.bkgs.2005.txt");
	ExpBkgPart(1,5);
	ExpBkgPart(9,5);
	ExpBkgPart(17,5);
	ExpBkgPart(25,5);
	ExpBkgPart(33,5);
	ExpBkgPart(41,5);
	closewritefile();
	sendmessage("Basic bkgs 2005");
end;
*/
/* Measuring performance of 2003 query over the signal file. 
	Basic approach, i.e. with no CM, 
	ranksort optimization, no materialization, and no rewritings. 
	run with run.current.basic.sh 
create function basicSignal2003() -> Boolean as
begin
	openwritefile("basic.signal.2003.txt");
	select expcuts(filename(f)) 
		from eventfile f 
		where name(experiment(f))="signal";
	ExpSignal(1437,5);
	ExpSignal(2874,5);
	ExpSignal(4311,5);
	ExpSignal(5748,5);
	ExpSignal(7185,5);
	ExpSignal(8622,5);
	closewritefile();
	sendmessage("Basic signal 2003");
end;
*/
/* Measuring performance of 2005 query over the signal file. 
	Basic approach, i.e. with no CM, 
	ranksort optimization, no materialization, and no rewritings. 
	run with run.current.basic.2005.sh 
create function basicSignal2005() -> Boolean as
begin
	openwritefile("basic.signal.2005.txt");
	select expcuts(filename(f)) 
		from eventfile f 
		where name(experiment(f))="signal";
	ExpSignal(1437,5);
	ExpSignal(2874,5);
	ExpSignal(4311,5);
	ExpSignal(5748,5);
	ExpSignal(7185,5);
	ExpSignal(8622,5);
	closewritefile();
	sendmessage("Basic signal 2005");
end;
*/
