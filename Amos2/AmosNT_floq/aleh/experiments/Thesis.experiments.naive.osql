/* Measuring performance of 2005 query over the signal file. 
	MAN approach, i.e. with no CM, 
	ranksort optimization, but with materialization, and  rewritings. 
	The order of cuts is found manually, which is the same as in the
	paper.
	run with run.current.limited.2005.sh 
create function manualSignal2005() -> Boolean as
begin
	openwritefile("manual.signal.2005.txt");
	OptSignal(1437,5);
	OptSignal(2874,5);
	OptSignal(4311,5);
	OptSignal(5748,5);
	OptSignal(7185,5);
	OptSignal(8622,5);
	closewritefile();
	sendmessage("Manual signal 2005");
end;
*/
