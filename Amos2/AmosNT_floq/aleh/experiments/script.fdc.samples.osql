/* AmosQL script to measure different plans produced by dynamic group cost model for different
   sample sizes. Note: this script runs for several hours. The result of the script is printed 
   in /experiments/result.fdc.samples.txt. */

load_root_file("../wrappers/ROOTWrap/t.root");
/*load_root_file("D:/Project/ALEH/ANALYS/NTUPLES/bkg2Events_ruslan_000.root");*/
/*load_root_file('D:/Project/ALEH/ANALYS/NTUPLES/signal50000Events_000.root');*/
cd('osql');
<'cuts.grouped.const.osql';
openwritefile('../experiments/result.fdc.samples.txt');
print("profile_time,opt_time,min_execution_time,max_execution_time,sum_of_execution_time,sum_of_square_execution_time");
create function profile(integer n) -> boolean as
begin
clr_aggstat();
aggstat(true);
for each event ev where id(ev)>=0 and id(ev)<n 
/*and filename(ev)="D:/Project/ALEH/ANALYS/NTUPLES/bkg2Events_ruslan_000.root"*/
begin
	group(theresolvent("TLCcount"),ev);
	group(theresolvent("TLCsome"),ev);
	group(theresolvent("ZVC"),ev);
	group(theresolvent("TC"),ev);
	group(theresolvent("JVC"),ev);
	group(theresolvent("LCnotany"),ev);
	group(theresolvent("LCsome"),ev);
	group(theresolvent("MEC"),ev);
end;
aggstat(false);
end;
optmethod('randomopt');
optlevel(100,10);

lisp;
;(setq  _DYNPROG_MAX_TIME_ 100)
(defun test2 () (osql "expcuts();"))
(let ((min 100)(max 0)(sum 0)(sumsq 0)(pt)(best_pt 100)(best_opt 100)(opt))
  (dotimes (i 5)
    (setq pt (timer2 (osql "profile(5);")))
    (sleep 60)
    (setq opt (timer2 (osql "reoptimize0('expcuts');")))
    (let ((best 100)(cur))
      (dotimes (i 10)
	(setq cur (timer2 (test2)))
	(setq best (min cur best)))
      (setq min (min best min))
      (setq best_pt (if (equal min best) pt best_pt))
      (setq best_opt (if (equal min best) opt best_opt))
      (setq max (max best max))
      (setq sum (+ sum best))
      (setq sumsq (+ sumsq (* best best)))))
  (princ best_pt *mystream*)
  (princ ", " *mystream*)
  (princ best_opt *mystream*)
  (princ ", " *mystream*)
  (princ min *mystream*)
  (princ ", " *mystream*)
  (princ max *mystream*)
  (princ ", " *mystream*)
  (princ sum *mystream*)
  (princ ", " *mystream*)
  (print sumsq *mystream*))

(let ((min 100)(max 0)(sum 0)(sumsq 0)(pt)(best_pt 100)(best_opt 100)(opt))
  (dotimes (i 5)
