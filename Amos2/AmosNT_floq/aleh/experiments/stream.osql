/* Reoptimize subquery under profile controller (only one level) 
	of expcuts query with randomopt for given II and SH. 
	Measures optimization and execution (over given file) 
	with rptAvg runs */
create function tuneII_SH(eventfile f, integer ii, integer sh, integer rptAvg)
	-> real as
begin
	declare charstring fpath, integer fid, real optavgtime, real optsqsum,
		real optstdev, real exavgtime, real exsqsum, real exstdev,
		integer passedevent, real plan_cst, real plan_fnt;
	set fpath = filename(f);
	set fid = id(f);
	/* set II and SH levels */
	if ((ii!=0)or(sh!=0))
	then begin
		group_optmethods("randomopt","ranksort");
		group_optlevels(ii,sh,10,10);
	end else begin
		group_optmethods("ranksort","ranksort");
	end;
	/* Perform reoptimization of expcuts rptAvg times */
	reset_reoptt();
	for each integer i where i=iota(1,rptAvg)
	begin
		set_reoptimize_meas_stop();
		sixcuts(fpath);
	end;
	select mean(su,c),q,stdev(su,q,c) into optavgtime,optsqsum,optstdev
		from  real q, real su, integer c
		where <su,q,c> = reset_reoptt();
	select c,f into plan_cst, plan_fnt
		from real c, real f
		where <c,f> = cost_after_reoptimize();
	/* Measure execution performance rptAvg times */
	select a,q,s,p into exavgtime,exsqsum,exstdev,passedevent
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.sixcuts->event",fpath,rptAvg);
	/* Print result */
	myprint(fid,ii,sh,optavgtime,optstdev,optsqsum,exavgtime,exstdev,
		exsqsum,passedevent,plan_cst,plan_fnt);
	result exavgtime;
end;

create function tuneII_SHtopForBest(eventfile f, integer ii, integer sh, 
	integer rptAvg)	-> real as
begin
	declare charstring fpath, integer fid, real optavgtime, real optsqsum,
		real optstdev, real exavgtime, real exsqsum, real exstdev,
		integer passedevent, real plan_cst, real plan_fnt;
	set fpath = filename(f);
	set fid = id(f);
	/* set II and SH levels */
	if ((ii!=0)or(sh!=0))
	then begin
		group_optmethods("randomopt","randomopt");
		group_optlevels(ii,sh,60,300);
	end else begin
		group_optmethods("ranksort","randomopt");
		group_optlevels(ii,sh,60,300);
	end;
	/* Perform reoptimization of expcuts rptAvg times */
	reset_reoptt();
	for each integer i where i=iota(1,rptAvg)
	begin
		set_reoptimize_meas_stop();
		sixcuts(fpath);
	end;
	select mean(su,c),q,stdev(su,q,c) into optavgtime,optsqsum,optstdev
		from  real q, real su, integer c
		where <su,q,c> = reset_reoptt();
	select c,f into plan_cst, plan_fnt
		from real c, real f
		where <c,f> = cost_after_reoptimize();
	/* Measure execution performance rptAvg times */
	select a,q,s,p into exavgtime,exsqsum,exstdev,passedevent
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.sixcuts->event",fpath,rptAvg);
	/* Print result */
	myprint(fid,ii,sh,optavgtime,optstdev,optsqsum,exavgtime,exstdev,
		exsqsum,passedevent,plan_cst,plan_fnt);
	result exavgtime;
end;

create function qo2level(eventfile f, vector toplevel, vector level2, 
			integer rptAvg) -> real as
begin
	declare charstring fpath, integer fid, integer topII, integer topSH,
		integer l2II, integer l2SH, charstring topMethod, 
		charstring l2Method, real optavgtime, real optsqsum,
		real optstdev, real exavgtime, real exsqsum, real exstdev,
		integer passedevent, real plan_cst, real plan_fnt;
	set fpath = filename(f);
	set fid = id(f);
	set topII = toplevel[0];
	set topSH = toplevel[1];
	set l2II = level2[0];
	set l2SH = level2[1];
	if ((topII = 0) and (topSH = 0))
		then set topMethod = "ranksort"
		else set topMethod = "randomopt";
	if ((l2II = 0) and (l2SH = 0))
		then set l2Method = "ranksort"
		else set l2Method = "randomopt";
	group_optmethods(topMethod,l2Method);
	group_optlevels(topII,topSH,l2II,l2SH);
	/* Perform reoptimization of expcuts rptAvg times */
	reset_reoptt();
	for each integer i where i=iota(1,rptAvg)
	begin
		set_reoptimize_meas_stop();
		sixcuts(fpath);
	end;
	select mean(su,c),q,stdev(su,q,c) into optavgtime,optsqsum,optstdev
		from  real q, real su, integer c
		where <su,q,c> = reset_reoptt();
	select c,f into plan_cst, plan_fnt
		from real c, real f
		where <c,f> = cost_after_reoptimize();
	/* Measure execution performance rptAvg times */
	select a,q,s,p into exavgtime,exsqsum,exstdev,passedevent
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.sixcuts->event",fpath,rptAvg);
	myprint(fid,topII,topSH,l2II,l2SH,optavgtime,optstdev,optsqsum,
		exavgtime,exstdev,exsqsum,passedevent,plan_cst,plan_fnt);
	result exavgtime;
end;
