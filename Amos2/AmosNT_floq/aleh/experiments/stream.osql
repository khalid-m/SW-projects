create function measureStrategy(charstring fn, integer nrFiles,
	charstring collectStat, charstring opt, 
	charstring qp, integer rptAvg) -> 
	<real initAvg, 
	real initStdev, real initSqsum, real groupAvg, real groupStdev,
	real groupSqsum, real monAvg, real monStdev, real monSqsum,
	real exAvg, real exStdev, real exSqsum, integer passed> as
begin
	declare real initSum, real groupSum, real monSum, real exSum;
	set initSum = 0;
	set initSqsum = 0;
	set groupSum = 0;
	set groupSqsum = 0;
	set monSum = 0;
	set monSqsum = 0;
	set exSum = 0;
	set exSqsum = 0;
	for each integer i where i=iota(1,rptAvg)
	begin
		drop_sobjectstat();
		cleansb(fn);
		/* Init optimization is always done by ranksort */
		group_optmethods("ranksort","ranksort");
		group_optlevels(0,0,0,0);
		optmethod("ranksort");
		/* except No runtime profiling approach */
		if (collectStat="NoStat")
		then begin
			if (opt="DynBestOpt")
			then begin
				group_optmethods("randomopt","randomopt");
				group_optlevels(25,650,60,300);
			end;
			if (opt="FastOpt")
			then begin
				group_optmethods("randomopt","ranksort");
				group_optlevels(1,30,0,0);
			end;
		end;
		/* perform initial optimization */
		select a+initsum, q+initsqsum into initsum,initsqsum
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.reoptimize2->function",
				fn,1);
		/* Prepare runtime profiling. */
		if ((collectStat="FastStat") and (qp="Naive"))
		then
			select a+groupsum,q+groupsqsum into groupsum,groupsqsum
			from real a, real q, real s, integer p
			where <a,q,s,p> = 
			execute("charstring.tocollectstatnaive->boolean",
					fn,1);
		if ((collectStat="FastStat") and (qp="Mat"))
		then
			select a+groupsum,q+groupsqsum into groupsum,groupsqsum
			from real a, real q, real s, integer p
			where <a,q,s,p> = 
			execute("charstring.tocollectstat->boolean",
					fn,1);
		if ((collectStat="FullStat") and (qp="Naive"))
		then begin
			sobjectstat();
			slotstat(true);
			collectstatnaive();
		end;
		if ((collectStat="FullStat") and (qp="Mat"))
		then begin
			slotstat(false);
			sobjectstat();
			collectstat();
		end;
		if ((collectStat != "FastStat") and (collectStat != "FullStat")
			and (collectStat != "NoStat"))
		then print("Unkonw strategy to collect stat: "+collectStat);
		if ((qp != "Naive") and (qp != "Mat"))
		then print("Unknown query processing type: "+qp);
		/* Executing the query with collecting statistics */
		if (opt="DynBestOpt")
		then begin
			group_optmethods("randomopt","randomopt");
			group_optlevels(25,650,60,300);
		end;
		if (opt="FastOpt")
		then begin
			group_optmethods("randomopt","ranksort");
			group_optlevels(1,30,0,0);
		end;
		if (opt="GreedyOpt")
		then begin
			group_optmethods("ranksort","ranksort");
			group_optlevels(0,0,0,0);
		end;
		if ((opt!="DynBestOpt") and (opt!="FastOpt") and 
			(opt!="GreedyOpt"))
		then print("Unknow strategy for reoptimization: "+opt);
		select a+monsum,q+monsqsum into monsum,monsqsum
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute(fn,nrFiles,1);
		/* Cleaning before measuring performance of obtain plan */
		if (collectStat="FullStat")
		then begin 
			sobjectstat(false);
			slotstat(false);
			select a+groupsum, q+groupsqsum 
				into groupsum,groupsqsum
			from real a, real q, real s, integer p
			where <a,q,s,p> = 
				execute("charstring.reoptimize2->function",
					fn,1);
		end;
		if (collectStat="FastStat")
		then unprofile(fn);
		/* Measuring performance of obtained plan */
		select a+exsum,q+exsqsum,p into exsum,exsqsum,passed
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute(fn,nrFiles,1);
	end;
	set initAvg = mean(initsum,rptAvg);
	set initStdev = stdev(initsum,initsqsum,rptAvg);
	set groupAvg = mean(groupsum,rptAvg);
	set groupStdev = stdev(groupsum,groupsqsum,rptAvg);
	set monAvg = mean(monsum,rptAvg);
	set monStdev = stdev(monsum,monsqsum,rptAvg);
	set exAvg = mean(exsum,rptAvg);
	set exStdev = stdev(exsum,exsqsum,rptAvg);
	result <initAvg,initStdev,initSqsum,groupAvg,groupStdev,groupSqsum,
		monAvg,monStdev,monSqsum,exAvg,exStdev,exSqsum,passed>;
end;

create function runReoptExperiment(charstring fn, integer nrFiles, 
	integer rptAvg, charstring stat, charstring opt, charstring qp) 
		-> boolean as 
begin
	declare vector res;
	/* initial optimization without measuremnts */
	optmethod("ranksort");
	reoptimize(fn);
	/* warming up */
	apply(functionnamed(fn),{nrFiles});
	/* do experiments */
	select v into res 
	from vector v
	where v = measureStrategy(fn,nrFiles,stat,opt,qp,rptAvg);
	/* print results */
	myprint(nrFiles,stat,opt,res[0],res[1],res[2],res[3],
		res[4],res[5],res[6],res[7],res[8],res[9],res[10],res[11],
		res[12]);
end;

create function tune_profiling(charstring fn, object arg, charstring stat, 
	charstring opt,	charstring groupOpt, integer toStop, integer rptAvg) ->
	<real initAvg, real initStdev, real initSqsum, real initCostAvg,
	real initCostStdev, real groupAvg, real groupStdev, real groupSqsum, 
	real groupCostAvg, real groupCostStdev, real monAvg, real monStdev, 
	real monSqsum, real monCostAvg, real monCostStdev,
	integer collectStat,
	real profiledEvents, real profEvStdev, real exAvg, real exStdev, 
	real exSqsum, integer passed> as
/* toStop = 0 means entire data set */
begin
	declare real initSum, real groupSum, real monSum, real exSum, integer
		prEvSum, real prEvSqsum, real initCostSum, real initCostSqSum,
		real groupCostSum, real groupCostSqSum, real monCostSum,
		real monCostSqSum;
	set initSum = 0.0;
	set initSqsum = 0.0;
	set groupSum = 0.0;
	set groupSqsum = 0.0;
	set monSum = 0.0;
	set monSqsum = 0.0;
	set prEvSum = 0;
	set prEvSqsum = 0.0;
	set exSum = 0.0;
	set exSqsum = 0.0;
	set initCostSum = 0.0;
	set initCostSqSum = 0.0;
	set groupCostSum = 0.0;
	set groupCostSqSum = 0.0;
	set monCostSum = 0.0;
	set monCostSqSum = 0.0;
	for each integer i where i=iota(1,rptAvg)
	begin
		drop_sobjectstat();
		clr_aggstat();
		cleansb(fn);
		/* Init optimization is always done by ranksort */
		group_optmethods("ranksort","ranksort");
		group_optlevels(0,0,0,0);
		optmethod("ranksort");
		select a+initsum, q+initsqsum into initsum,initsqsum
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.reoptimize2->function",
				fn,1);
		select c+initCostSum, c*c+initCostSqSum
			into initCostSum, initCostSqSum
		from real c, real f
		where <c,f> = plan_cost(fn);

		/* Grouping is always done by ranksort. */
		/* Grouping */
		grouping(true);
		select a+groupsum,q+groupsqsum into groupsum,groupsqsum
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.reoptimize0->function",
					fn,1);
		select c+groupCostSum, c*c+groupCostSqSum
			into groupCostSum, groupCostSqSum
		from real c, real f
		where <c,f> = plan_cost(fn);

		/* Setting monitoring and profiling */
		if (stat="NoStat")
		then begin
			slotstat(false);
			sobjectstat(false);
		end
		else if (stat="MatStat")
		then begin
			slotstat(false);
			sobjectstat();
			collectstat();
		end
		else if (stat="NaiveStat")
		then begin
			slotstat(true);
			sobjectstat();
			collectstatnaive();
		end
		else if (stat="FirstMatStat")
		then begin
			slotstat(false);
			sobjectstat();
			collectstat();
		end
		else if (stat="FirstNaiveStat")
		then begin
			sobjectstat();
			slotstat(true);
			collectstatnaive();
		end
		else print("Unkonw strategy to collect stat: "+stat);
		if (toStop = 0)
		then begin
			profiling(true);
			if ((opt="GreedyOpt") and (groupOpt="GreedyOrder")
				and (stat="NoStat"))
			then stopNfirstEventsReopt0(25000)
			else stopNfirstEventsReopt2(25000);
		end
		else begin
			profiling(true);
			if ((stat="FirstMatStat") or (stat="FirstNaiveStat"))
			then stopCollectProfileNoChanges(1.65,0.15,toStop)
			else if ((opt="GreedyOpt") and (groupOpt="GreedyOrder")
				and (stat="NoStat"))
			then stopNoChanges(toStop)
			else stopNoChangesReopt(toStop);
		end;

		/* Setting reoptimization strategy */
		if ((opt="BestOpt") and (groupOpt="RandomOrder"))
		then begin
			group_optmethods("randomopt","randomopt");
			group_optlevels(10,100,60,300);
		end
		else if ((opt="BestOpt") and (groupOpt="GreedyOrder"))
		then begin
			group_optmethods("ranksort","randomopt");
			group_optlevels(0,0,60,300);
		end
		else if ((opt="GreedyOpt") and (groupOpt="RandomOrder"))
		then begin
			group_optmethods("randomopt","ranksort");
			group_optlevels(10,100,0,0);
		end
		else if ((opt="GreedyOpt") and (groupOpt="GreedyOrder"))
		then begin
			group_optmethods("ranksort","ranksort");
			group_optlevels(0,0,0,0);
		end
		else if ((opt="BestOpt") and (groupOpt="DynOrder"))
		then begin
			group_optmethods("exhaustive","randomopt");
			group_optlevels(0,0,60,300);
		end
		else if ((opt="GreedyOpt") and (groupOpt="DynOrder"))
		then begin
			group_optmethods("exhaustive","ranksort");
			group_optlevels(0,0,0,0);
		end
		else print("Unknow strategy for reoptimization: "+opt+" and "+
			groupOpt);

		/* Executing the query with collecting statistics */
		select a+monsum,q+monsqsum into monsum,monsqsum
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute(fn,arg,1);
		select c+monCostSum, c*c+monCostSqSum
			into monCostSum, monCostSqSum
		from real c, real f
		where <c,f> = cost_after_reoptimize();
		/* Obtaining number of profiled events */
		select prEvSum+p, prEvSqsum+p*p into prEvSum,prEvSqsum
		from integer p
		where p = getEventCounter();
		/* Cleaning before measuring performance of obtain plan */
		unprofile(fn);
		/* Measuring performance of obtained plan */
		select a+exsum,q+exsqsum,p into exsum,exsqsum,passed
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute(fn,arg,1);
	end;
	set initAvg = mean(initsum,rptAvg);
	set initStdev = stdev(initsum,initsqsum,rptAvg);
	set groupAvg = mean(groupsum,rptAvg);
	set groupStdev = stdev(groupsum,groupsqsum,rptAvg);
	set monAvg = mean(monsum,rptAvg);
	set monStdev = stdev(monsum,monsqsum,rptAvg);
	set collectStat = get_profiled_counter();
	set profiledEvents = mean(prEvSum,rptAvg);
	set profEvStdev =stdev(prEvSum,prEvSqsum,rptAvg);
	set exAvg = mean(exsum,rptAvg);
	set exStdev = stdev(exsum,exsqsum,rptAvg);
	set initCostAvg = mean(initCostSum,rptAvg);
	set initCostStdev = stdev(initCostSum,initCostSqSum,rptAvg);
	set groupCostAvg = mean(groupCostSum,rptAvg);
	set groupCostStdev = stdev(groupCostSum,groupCostSqSum,rptAvg);
	set monCostAvg = mean(monCostSum,rptAvg);
	set monCostStdev = stdev(monCostSum,monCostSqSum,rptAvg);
	result <initAvg,initStdev,initSqsum,initCostAvg,initCostStdev,
		groupAvg,groupStdev,groupSqsum,groupCostAvg,groupStdev,
		monAvg,monStdev,monSqsum,monCostAvg,monCostStdev,
		collectStat,profiledEvents,
		profEvStdev,exAvg,exStdev,exSqsum,passed>;
end;
/*
create function runTuneProfiling (eventfile f, charstring stat, charstring opt,
	charstring groupOpt, integer toStop, integer rptAvg) -> boolean as
begin
	declare vector res;
	expcuts(filename(f));
	select v into res 
	from vector v
	where v = tune_profiling("charstring.expcuts->event",filename(f),stat,
		opt,groupOpt,toStop,rptAvg);
	myprint(id(f),toStop,stat,opt,groupOpt,res[0],res[1],res[2],res[3],
		res[4],res[5],res[6],res[7],res[8],res[9],res[10],res[11],
		res[12],res[13],res[14],res[15],res[16],res[17],res[18],
		res[19],res[20],res[21]);
end;
*/
create function runProfileExperiment(charstring fn, integer nrFiles, 
	integer rptAvg, charstring stat, charstring opt, charstring groupopt,
	integer N) -> boolean as 
begin
	declare vector res;
	/* initial optimization without measuremnts */
	optmethod("ranksort");
	reoptimize(fn);
	/* warming up */
	apply(functionnamed(fn),{nrFiles});
	/* do experiments */
	select v into res 
	from vector v
	where v = tune_profiling(fn,nrFiles,stat,opt,groupopt,N,rptAvg);
	/* print results */
	myprint(nrFiles,N,stat,opt,groupopt,res[0],res[1],res[2],res[3],
		res[4],res[5],res[6],res[7],res[8],res[9],res[10],res[11],
		res[12],res[13],res[14],res[15],res[16],res[17],res[18],
		res[19],res[20],res[21]);
end;
