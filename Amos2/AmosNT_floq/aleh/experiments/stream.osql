create function tuneII_SHnestedForBest(eventfile f, integer ii, integer sh, 
	integer rptAvg)	-> real as
begin
	declare charstring fpath, integer fid, real optavgtime, real optsqsum,
		real optstdev, real exavgtime, real exsqsum, real exstdev,
		integer passedevent, real plan_cst, real plan_fnt;
	set fpath = filename(f);
	set fid = id(f);
	/* set II and SH levels */
	if ((ii!=0)or(sh!=0))
	then begin
		group_optmethods("randomopt","randomopt");
	end else begin
		group_optmethods("randomopt","ranksort");
	end;
	group_optlevels(23,650,ii,sh);
	/* Perform reoptimization of expcuts rptAvg times */
	reset_reoptt();
	for each integer i where i=iota(1,rptAvg)
	begin
		set_reoptimize_meas_stop();
		sixcuts(fpath);
	end;
	select mean(su,c),q,stdev(su,q,c) into optavgtime,optsqsum,optstdev
		from  real q, real su, integer c
		where <su,q,c> = reset_reoptt();
	select c,f into plan_cst, plan_fnt
		from real c, real f
		where <c,f> = cost_after_reoptimize();
	/* Measure execution performance rptAvg times */
	select a,q,s,p into exavgtime,exsqsum,exstdev,passedevent
		from real a, real q, real s, integer p
		where <a,q,s,p> = 
			execute("charstring.sixcuts->event",fpath,rptAvg);
	/* Print result */
	myprint(fid,ii,sh,optavgtime,optstdev,optsqsum,exavgtime,exstdev,
		exsqsum,passedevent,plan_cst,plan_fnt);
	result exavgtime;
end;

