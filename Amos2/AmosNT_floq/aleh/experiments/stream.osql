create function myprint(integer, real, real, real, real, real, integer, real, 
			real, real, integer, integer, real, real, real) -> 
		boolean as foreign 'myprint';

create function myprint(integer, integer, integer, real, real, real, real, 
			real, real, integer,real,real) -> boolean as 
		foreign 'myprint';

create function myprint(integer, integer, integer, integer, integer, real, 
			real, real, real, 
			real, real, integer,real,real) -> boolean as 
		foreign 'myprint';

create function myprint(integer, real, real, real, integer) -> boolean as 
		foreign 'myprint';

create function myprint(integer, integer, integer, integer, integer, integer,
		integer, integer, integer, real, real, real, real, real, real,
		real, real, real, integer, real, real, real, integer) -> 
		boolean as foreign 'myprint';

create function myprint(object, object, object, object, object, object,
		object, object, object, object, object, object, object,
		object, object, object) -> boolean as foreign 'myprint';

create function myprint(object, object, object, object, object, object,
		object, object, object, object, object, object, object,
		object, object, object, object, object, object, object,
		object, object, object, object, object, object, object) -> 
	boolean as foreign 'myprint';

/**************************************************
 * Tuning experiments
 *************************************************/

create function factorial(vector v1,vector v2, function f, object arg, integer rptAvg) ->
	boolean as
begin
	for each object o1, object o2 where o1 in v1 and o2 in v2
		apply(f,{arg,o1,o2,rptAvg});
end;
