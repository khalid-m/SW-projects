cd("../osql");
<"schema.osql";
<"../regress/test_data.const.osql";
load_lisp("../lsp/cost_model.populated.lsp");
load_lisp('../lsp/grouping.lsp');
load_lisp('../lsp/dyngroups.lsp');
commit;
<"cuts.const.osql";

/* Static cost model and greedy optimization */
lisp;
(checkequal "Greedy optimization with the static cost model"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'expcuts->event)) '(2 10))
	     '(353982 0))
	    ((osql "eventid(expcuts());")
	     '((24455))))
:osql

optmethod('randomopt');
optlevel(100,100);
create function expid()-> bag of integer as
select eventid(expcuts());

lisp;
(checkequal "Random optimization with the static cost model"
	    ((lr2i10nl
	      (exec-cost-of-fn (getfunctionnamed 'expid->integer)) '(2 10))
	     '(353782 0))
	    ((osql "expid();")
	     '((24455))))
:osql

lisp;
(setq *enable-parteval* nil)
:osql
optmethod("ranksort");
grouping(true);
reoptimize0("expid");
grouping(false);

lisp;
(checkequal "Greedy optimization with the profiled group cost model"
	    ((osql "count(select print_aggstat());")
	     '((10)))
	    ((r2i10n (second 
		      (exec-cost-of-fn (getfunctionnamed 'expid->integer)))
		      '10)
	     '2191107)
	    ((osql "expid();")
	     '((24455))))
:osql
