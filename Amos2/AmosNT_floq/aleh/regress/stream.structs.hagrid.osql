cd('regress');

create function idExpCuts() -> integer as
select eventid(ev) from event ev where 
	ev=sixcuts("../../wrappers/ROOTWrap/t.root");

create function idExpCutsInterval() -> integer as
select eventid(ev) from event ev where 
	ev=sixcuts("../../wrappers/ROOTWrap/t.root",19000,19100);

lisp;
(checkequal "Checking sixcuts with simple ranksort optimization without 
collected statistics"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) 
	      '(2 8))
	     '(3356164 18366))
	    ((osql "idExpCuts();")
	     '((19015) (24455))))
(princ "Time to execute sixcuts with simple cost model ")
(print (timer2 (osql "idExpCuts();")))
:osql

lisp;
(checkequal "Checking sixcuts on interval with simple ranksort 
optimization without collected statistics"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcutsinterval->integer))
	      '(2 8))
	     '(335616 1836))
	    ((osql "idExpCutsInterval();")
	     '((19015))))
:osql

tocollectstatNaive("idexpcuts->integer");
lisp;
(checkequal "Collecting statisitcs on slots"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) 
	      '(2 8))
	     '(6672957 18366))
	    ((osql "idExpCuts();")
	     '((19015) (24455)))
	    ((osql "select name(t),i,sobject_stat(t,i) from type t, 
integer i where i=iota(0,23);")
	     '(("EVENT" 2 430 136 174) ("EVENT" 3 430 136 174) 
	       ("EVENT" 4 430 136 174) ("EVENT" 5 430 136 174) 
	       ("EVENT" 6 430 136 174) ("EVENT" 7 430 127 169) 
	       ("EVENT" 8 430 127 169) ("EVENT" 9 430 127 169) 
	       ("EVENT" 10 430 127 169) ("EVENT" 11 430 127 169) 
	       ("EVENT" 12 430 3439 29837) ("EVENT" 13 430 3439 29837) 
	       ("EVENT" 14 430 3439 29837) ("EVENT" 15 430 3439 29837) 
	       ("EVENT" 16 430 3439 29837) ("EVENT" 17 430 136 174) 
	       ("EVENT" 18 430 127 169) ("EVENT" 19 430 3439 29837)
	       ("EVENT" 20 225 1485 10691)))
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 
				'EVENT.NEW_ELECTRONS->ELECTRON) t) 
	      '(2 8))
	     '(651 31627906)))
:osql
drop_sobjectstat();
tocollectstat("idexpcuts->integer");
lisp;
(checkequal "Collecting statisitcs on cached slots"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) 
	      '(2 8))
	     '(1445134 704))
	    ((osql "idExpCuts();")
	     '((19015) (24455)))
	    ((osql "select name(t),i,sobject_stat(t,i) from type t, 
integer i where i=iota(0,23);")
	     '(("EVENT" 17 430 136 174) ("EVENT" 18 430 127 169) 
	       ("EVENT" 19 430 3439 29837) ("EVENT" 20 5 26 138))))
(reoptimize (getfunctionnamed 'idexpcuts->integer) t)
(checkequal "Checking sixcuts with simple ranksort optimization with 
collected statistics on cardinalities on cached slots"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) 
	      '(2 8))
	     '(1727295 704))
	    ((osql "idExpCuts();")
	     '((19015) (24455))))
(princ "Time to execute sixcuts with collected statistics on cached slots")
(print (timer2 (osql "idExpCuts();")))
:osql

grouping(true);
reoptimize0("idexpcuts->integer");
profiling(true);
lisp;
(checkequal "Doing dynamic profiling of groups"
	    ((osql "idExpCuts();")
	     '((19015) (24455))))
(princ "Time to execute sixcuts after profiling ")
(print (timer2 (osql "idExpCuts();")))
(checkequal "Checking that profiled result is correct"
	    ((second (lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) 
	      '(2 8)))
	     '704)
	    ((osql "idExpCuts();")
	     '((19015) (24455))))
:osql

create function idPaperCuts() -> integer as
select eventid(ev) from event ev where
        ev=papersixcuts("../../wrappers/ROOTWrap/t.root");

lisp;
(checkequal "Checking paper sixcuts with simple ranksort optimization without
collected statistics"
            ((lr2i10nl
              (exec-cost-of-fn (getfunctionnamed 'idpapercuts->integer))
              '(2 8))
             '(1553271 704))
            ((osql "idPaperCuts();")
             '((19015) (24455))))
(princ "Time to execute papersixcuts with simple cost model ")
(print (timer2 (osql "idPaperCuts();")))
:osql

