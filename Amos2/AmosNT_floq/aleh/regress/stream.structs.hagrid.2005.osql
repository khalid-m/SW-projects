cd('regress');

create function idExpCuts() -> integer as
select eventid(ev) from event ev where 
	ev=fourcuts("../../wrappers/ROOTWrap/t.root");

lisp;
(checkequal "Checking fourcuts with simple ranksort optimization without 
collected statistics"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) '(2 8))
	     '(17052764 24144007))
	    ((osql "idExpCuts();")
	     '((140) (1285) (2202) (2247) (2526) (3572) (3969) (5809) (6637) 
	       (7515) (8175) (8340) (11243) (11984) (12093) (12497) (13387) 
	       (14539) (14842) (15357) (15579) (15815) (16818) (17051) (17562)
	       (19166) (20761) (22290) (22926) (23524) (23583) (24455))))
(princ "Time to execute fourcuts with simple cost model ")
(print (timer2 (osql "idExpCuts();")))
:osql

grouping(true);
reoptimize0("idexpcuts->integer");
profiling(true);
lisp;
(checkequal "Doing dynamic profiling of groups"
	    ((osql "idExpCuts();")
	     '((140) (1285) (2202) (2247) (2526) (3572) (3969) (5809) (6637) 
	       (7515) (8175) (8340) (11243) (11984) (12093) (12497) (13387) 
	       (14539) (14842) (15357) (15579) (15815) (16818) (17051) (17562)
	       (19166) (20761) (22290) (22926) (23524) (23583) (24455))))
(princ "Time to execute fourcuts after profiling ")
(print (timer2 (osql "idExpCuts();")))
(checkequal "Checking that profiled result is correct"
	    ((second (lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idexpcuts->integer)) 
	      '(2 8)))
	     '24144007)
	    ((osql "idExpCuts();")
	     '((140) (1285) (2202) (2247) (2526) (3572) (3969) (5809) (6637) 
	       (7515) (8175) (8340) (11243) (11984) (12093) (12497) (13387) 
	       (14539) (14842) (15357) (15579) (15815) (16818) (17051) (17562)
	       (19166) (20761) (22290) (22926) (23524) (23583) (24455))))
:osql

create function idPaperCuts() -> integer as
select eventid(ev) from event ev where
        ev=optfourcuts("../../wrappers/ROOTWrap/t.root");

lisp;
(checkequal "Checking opt four cuts with default ranksort optimization with
simple ALEH cost model"
            ((lr2i10nl
              (exec-cost-of-fn (getfunctionnamed 'idpapercuts->integer))
              '(2 8))
             '(17052764 24144007))
            ((osql "idPaperCuts();")
             '((140) (1285) (2202) (2247) (2526) (3572) (3969) (5809) (6637) 
	       (7515) (8175) (8340) (11243) (11984) (12093) (12497) (13387) 
	       (14539) (14842) (15357) (15579) (15815) (16818) (17051) (17562)
	       (19166) (20761) (22290) (22926) (23524) (23583) (24455))))
(princ "Time to execute opt four cuts with simple ALEH cost model ")
(print (timer2 (osql "idPaperCuts();")))
:osql
