 * $Revision: 1.3 $ $Date: 2007/07/19 11:53:56 $
 * $State: Exp $ $Locker:  $
 *
 * Description: Regression test for ALEH project for materialized ontology 
 * loading entire file limited cost model from the paper. 
 * Tests that some cut queries over entire file t.root located in ROOT wrapper
 * home directory.
 ****************************************************************************
 * $Log: materialized.load.limited.osql,v $
 * Revision 1.3  2007/07/19 11:53:56  ruslan
 * check that costs of best plan and other plans without cost model are not updated by somebody changes
 *
 * Revision 1.2  2006/12/12 14:40:08  ruslan
 * cuts queries are loaded after the database populated in the limited cost model version
 *
 * Revision 1.1  2006/09/28 13:20:44  ruslan
 * aleh implementation with simple cost model for experimenting with order of cuts manually
 *
 ****************************************************************************/

lisp;
(checkequal "Loading t.root file"
	    ((osql "load_root_file(\"../wrappers/ROOTWrap/t.root\");")
	     '((25000))))
:osql

cd('osql');
<'cuts.const.nohints.osql';

lisp;
(checkequal "Estimated costs"
	    ((lr2i10nl (exec-cost-of-fn (getfunctionnamed 'expcuts->event)) 
		       '(2 10))
	     '(363082974 257100671))
	    ((lr2i10nl (exec-cost-of-fn (getfunctionnamed 'allcuts->event)) 
		       '(2 10))
	     '(381736099 257100671))
	    ((lr2i10nl (exec-cost-of-fn (getfunctionnamed 'optallcuts->event)) 
		       '(2 10))
	     '(378913706 257100671)))
(checkequal "3 lepton cut"
	    ((osql "count(select e from event e
where threeleptoncut(e));")
	     '((475))))

(checkequal "Opt all cuts"
	    ((osql "sort(select id(optallcuts()));")
	     '((#(19015 24455)))))
:osql