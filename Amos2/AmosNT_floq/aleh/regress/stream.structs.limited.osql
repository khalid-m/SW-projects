cd('regress');

create function idOptAllCuts() -> integer as
select eventid(ev) from event ev where 
	ev=optsixcuts("../../wrappers/ROOTWrap/t.root");

lisp;
(checkequal "Checking optsixcuts (best effort manual with default ranksort 
optimization without ALEH cost model"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'idoptallcuts->integer)) 
	      '(2 10))
	     '(940859 207618048))
	    ((osql "idoptallCuts();")
	     '((19015) (24455))))
(princ "Time to execute optsixcuts without ALEH cost model ")
(print (timer2 (osql "idOptAllCuts();")))
:osql

create function idPaperCuts() -> integer as
select eventid(ev) from event ev where
        ev=papersixcuts("../../wrappers/ROOTWrap/t.root");

lisp;
(checkequal "Checking paper sixcuts with default ranksort optimization without
ALEH cost model"
            ((lr2i10nl
              (exec-cost-of-fn (getfunctionnamed 'idpapercuts->integer))
              '(2 10))
             '(947591 207618048))
            ((osql "idPaperCuts();")
             '((19015) (24455))))
(princ "Time to execute papersixcuts without ALEH cost model ")
(print (timer2 (osql "idPaperCuts();")))
:osql
