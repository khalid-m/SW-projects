/*-*-sql-*-*******************************************************************
 * AMOS2
 *
 * Author: (c) 2007 Ruslan Fomkin, UDBL
 * $RCSfile: stream.closed.limited.osql,v $
 * $Revision: 1.3 $ $Date: 2007/12/12 09:59:49 $
 * $State: Exp $ $Locker:  $
 *
 * Description: Regression test for ALEH project for streamed approach with 
 * ontology implemented with use of structs, which represent objects in
 * transient way. The disjunctive call for retrieving particles of more
 * general type is closed by using multidirectional with select stmt. 
 * No cost model (MAN).
 * Tests that some cut queries over entire file t.root located in ROOT wrapper
 * home directory.
 ****************************************************************************
 * $Log: stream.closed.limited.osql,v $
 * Revision 1.3  2007/12/12 09:59:49  ruslan
 * loading cost models removed from cuts script to making scripts to be able to have different cost model in parallel, e.g. for desktop and for Hagrid
 *
 * Revision 1.2  2007/09/16 11:24:24  ruslan
 * new costs after applying partial evaluation
 *
 * Revision 1.1  2007/09/12 13:03:11  ruslan
 * regression test for MAN in stream case is added to general regression test
 *
 ****************************************************************************/

cd("osql");
<'formulas.stream.osql';
<"cuts.const.stream.osql";

create function TLC() -> integer i as
select count(select ev from event ev where
		ev=aleh_stream("../../wrappers/ROOTWrap/t.root") and
		threeleptoncut(ev));

create function LCs() -> integer i as
select count(select ev from event ev where
		ev=aleh_stream("../../wrappers/ROOTWrap/t.root") and
		leptoncuts(ev));

create function MECs() -> integer i as
select count(select ev from event ev where
		ev=aleh_stream("../../wrappers/ROOTWrap/t.root") and
		misseecuts(ev));

lisp;
(checkequal "Greedy optimization without cost model, three lepton cut"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'TLC->integer)) '(2 10))
	     '(10050 1310065408))
	    ((osql "TLC();")
	     '((475))))
(checkequal "Greedy optimization without cost model, lepton cuts"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'LCs->integer)) '(2 10))
	     '(10050 1310065408))
	    ((osql "LCs();")
	     '((5121))))
(checkequal "Greedy optimization without cost model, miss ee cuts"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'MECs->integer)) '(2 10))
	     '(10050 1310065408))
	    ((osql "MECs();")
	     '((13693))))
(checkequal "Greedy optimization without cost model, opt all cuts"
	    ((lr2i10nl 
	      (exec-cost-of-fn (getfunctionnamed 'optallcuts->event)) '(2 10))
	     '(957552250 232068180))
	    ((osql "id(optallcuts('../../wrappers/ROOTWrap/t.root'));")
	     '((19015) (24455))))
:osql
