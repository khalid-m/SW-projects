create function tocollectstat(charstring fn) -> boolean as
begin
	slotstat(false);
	grouping(true);
	ungroup(true);
	reoptimize0(fn);
	set_alpha_delta(1.65,0.15);
	collectstat();
	profiling(true);
	sobjectstat();
end;

create function tocollectstat(charstring fn, real zAlpha, real Delta) -> 
	boolean as
begin
	slotstat(false);
	grouping(true);
	ungroup(true);
	reoptimize0(fn);
	set_alpha_delta(zAlpha,Delta);
	collectstat();
	profiling(true);
	sobjectstat();
end;

create function tocollectstatNaive(charstring fn) -> boolean as
begin
	grouping(true);
	ungroup(true);
	reoptimize0(fn);
	set_alpha_delta(1.65,0.15);
	collectstatNaive();
	profiling(true);
	sobjectstat();
	slotstat(true);
end;

create function tocollectstatNaive(charstring fn, real zAlpha, real Delta) -> 
	boolean as
begin
	grouping(true);
	ungroup(true);
	reoptimize0(fn);
	set_alpha_delta(zAlpha,Delta);
	collectstatNaive();
	profiling(true);
	sobjectstat();
	slotstat(true);
end;
