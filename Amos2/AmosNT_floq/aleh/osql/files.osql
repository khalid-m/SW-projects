create type datafile;
create function filename(datafile f key) -> charstring name key as stored;
create function name(datafile f key) -> charstring name key as stored;
create function path(datafile f key) -> charstring path key as stored;

create type experiment;
create function name(experiment exp key) -> charstring name key as stored;

create type eventfile under datafile;
create function fileid(eventfile) -> integer id as stored;
create function size(eventfile) -> integer nr_event as stored;
create function experiment(eventfile) -> experiment exp as stored;

create experiment instances :bkg;
set name(:bkg)="bkg2";

