load_lisp("../lsp/exchange.lsp");

create function aleh_print(object o) -> boolean as foreign 'aleh-print';
create function aleh_read() -> object as foreign 'aleh-read';
create function open_alehfile(charstring file) -> boolean as foreign
	'open-alehfile';
create function close_alehfile() -> boolean as foreign 'close-alehfile';

