<"sobject.stat.osql";

costhint("NUMBER.NUMBER.PLUS->NUMBER","bbf",{1.0,1.0});
costhint("NUMBER.NUMBER.PLUS->NUMBER","bfb",{1.0,1.0});
costhint("NUMBER.NUMBER.TIMES->NUMBER","bbf",{1.0,1.0});
costhint("NUMBER.NUMBER.TIMES->NUMBER","bfb",{1.0,1.0});
costhint("NUMBER.ABS->NUMBER","bf",{1.0,1.0});

/* Cost function is defined in cost_model.structs.lsp 
costhint("VECTOR.INTEGER.VREF->OBJECT","bbf",{1.0,1.0});*/
costhint("VECTOR.VECTOR.TIMES->NUMBER","bbf",{1.3,1.0});
costhint("NUMBER.SQRT_POS->REAL","bf",{1.3,1.0});

costhint("VECTOR.VECTOR.PLUS->VECTOR","bbf",{6.7,1.0});
costhint("NUMBER.LOG->REAL","bf",{2.0,1.0});
costhint("NUMBER.NUMBER.ATAN2->REAL","bbf",{1.7,1.0});
costhint("NUMBER.CEILING->INTEGER","bf",{1.3,1.0});
costhint("NUMBER.COS->REAL","bf",{1.3,1.0});
costhint("NUMBER.NUMBER.NUMBER.MAGNITUDE->REAL","bbbf",{3.7,1.0});
costhint("NUMBER.NUMBER.NUMBER.ETA->REAL","bbbf",{5.0,1.0});
costhint("NUMBER.NUMBER.PT->REAL","bbf",{2.6,1.0});
costhint("BAG-VECTOR.SUM->VECTOR-NUMBER","bf",{63.0,1.0});

costhint("SOBJECT.INTEGER.GET_SLOT->OBJECT","bff",{20.0,10.0});

costhint("SOBJECT.INTEGER.OBJECT.SET_SLOT->BOOLEAN","bbb",{1.0,1.0});
costhint("SOBJECT.INTEGER.VECTOR.SET_SLOTVECTOR->BOOLEAN","bbb",{1.0,1.0});
costhint("SOBJECT.INTEGER.VECTOR.FUNCTION.SET_SLOTVECTOR->BOOLEAN","bbbb",
	{1.0,1.0});

costhint("VECTOR.SOBJECT.TYPE.INTEGER.MAT_SOBJECT_TRANSPOSE->BOOLEAN","bbbb",{2.0,1.0});
costhint("OBJECT.VECTOR.NOT_IN->BOOLEAN","bb",{2.0,0.3});
