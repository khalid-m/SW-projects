logging off;

load_lisp("../lsp/stream.structs.lsp");

declare_key(functionnamed('get_slot'),{'s','i'});

/*
 * Metadata about structs.
 */
/* Schema */
create type SOBJECT_TYPE;
create function name(SOBJECT_TYPE key) -> charstring key as stored;
create function structof(SOBJECT_TYPE key) -> type key as stored;

/* Meta-data */
create SOBJECT_TYPE instances :evt;
set name(:evt) = "EVENT";
set structof(:evt) = typenamed("EVENT");

create SOBJECT_TYPE instances :et;
set name(:et) = "ELECTRON";
set structof(:et) = typenamed("ELECTRON");

create SOBJECT_TYPE instances :mt;
set name(:mt) = "MUON";
set structof(:mt) = typenamed("MUON");

create SOBJECT_TYPE instances :jt;
set name(:jt) = "JET";
set structof(:jt) = typenamed("JET");

/*
 * Access functions to the slots of structs.
 */

create function aleh_stream(charstring filename)-> bag of Event ev as
select ev
where ev=root_scan_project(filename,"/ATLFAST","h51",{"Pxmiss",
	"Pymiss","Kfele","Pxele","Pyele","Pzele","Eeele",
	"Kfmuo","Pxmuo","Pymuo","Pzmuo","Eemuo","Kfjetb",
	"Pxjetb","Pyjetb","Pzjetb","Eejetb"},typenamed("EVENT"));

create function filename(event ev) -> charstring filename as
select source(ev);

create function eventId(event ev) -> integer id as
select sid(ev);

create function Pxmiss(event ev) -> real as
select get_slot(ev,0);

create function Pymiss(event ev) -> real as
select get_slot(ev,1);

create function Kfele(event ev) -> vector of integer as
select get_slot(ev,2);
create function Pxele(event ev) -> vector of real as
select get_slot(ev,3);
create function Pyele(event ev) -> vector of real as
select get_slot(ev,4);
create function Pzele(event ev) -> vector of real as
select get_slot(ev,5);
create function Eeele(event ev) -> vector of real as
select get_slot(ev,6);

create function Kfmuo(event ev) -> vector of integer as
select get_slot(ev,7);
create function Pxmuo(event ev) -> vector of real as
select get_slot(ev,8);
create function Pymuo(event ev) -> vector of real as
select get_slot(ev,9);
create function Pzmuo(event ev) -> vector of real as
select get_slot(ev,10);
create function Eemuo(event ev) -> vector of real as
select get_slot(ev,11);

create function Kfjetb(event ev) -> vector of integer as
select get_slot(ev,12);
create function Pxjetb(event ev) -> vector of real as
select get_slot(ev,13);
create function Pyjetb(event ev) -> vector of real as
select get_slot(ev,14);
create function Pzjetb(event ev) -> vector of real as
select get_slot(ev,15);
create function Eejetb(event ev) -> vector of real as
select get_slot(ev,16);

/* For particles. */
/*
create function id(particle p)-> integer as
	select get_slot(p,0);
*/
create function kf(particle p)-> integer as
	select get_slot(p,0);
create function px(particle p)-> real as
	select get_slot(p,1);
create function py(particle p)-> real as
	select get_slot(p,2);
create function pz(particle p)-> real as
	select get_slot(p,3);
create function ee(particle p)-> real as
	select get_slot(p,4);

create function pid(particle p)-> integer as
select sid(p);

create function event(particle p)-> event as
select source(p);

/*
create function new_jetb(Type r, Event src, integer id, Vector cont)-> 
	jetb s key as foreign "make_sobjectbbbbf";
create function new_electron(Type r, Event src, integer id, Vector cont)-> 
	electron s key as foreign "make_sobjectbbbbf";
create function new_muon(Type r, Event src, integer id, Vector cont)-> 
	muon s key as foreign "make_sobjectbbbbf";
create function new_event(Type r, charstring src, integer id, Vector cont)-> 
	event s key as foreign "make_sobjectbbbbf";
*/
/* Does not work with particle ID
create function new_electrons(vector eles) -> Electron e as
select new_electron(typenamed("ELECTRON"),v)
from integer i, vector v
where v=eles[i];

create function new_muons(vector muos) -> Muon m as
select new_muon(typenamed("MUON"),v)
from integer i, vector v
where v=muos[i];

create function new_jetbs(vector jetbs) -> Jetb b as
select new_jetb(typenamed("JETB"),v)
from integer i, vector v
where v=jetbs[i];
*/

/* Constructors for stream objects of specific particle types */
create function new_electron(Object ev, Integer i, Integer kf, Real px,
	Real py, Real pz, Real ee)-> Electron as
select new_sobject(typenamed("ELECTRON"),ev,i,{kf,px,py,pz,ee});

create function new_muon(Object ev, Integer i, Integer kf, Real px,
	Real py, Real pz, Real ee)-> Muon as
select new_sobject(typenamed("MUON"),ev,i,{kf,px,py,pz,ee});

create function new_jet(Object ev, Integer i, Integer kf, Real px,
	Real py, Real pz, Real ee)-> Jet as
select new_sobject(typenamed("JET"),ev,i,{kf,px,py,pz,ee});

/* Creating electron structs for a given event and streaming them. */
create function new_electrons(event ev)-> bag of Electron as
select new_electron(ev,i,Kfele(ev)[i],
	Pxele(ev)[i],Pyele(ev)[i],Pzele(ev)[i],Eeele(ev)[i])
from integer i;

/* Creating muon structs for a given event and streaming them. */
create function new_muons(event ev)-> bag of Muon as
select new_muon(ev,i,Kfmuo(ev)[i],
	Pxmuo(ev)[i],Pymuo(ev)[i],Pzmuo(ev)[i],Eemuo(ev)[i])
from integer i;

/* Creating jetb structs for a given event and streaming them. */
create function new_jets(event ev)-> bag of Jet as
select new_jet(ev,i,Kfjetb(ev)[i],
	Pxjetb(ev)[i],Pyjetb(ev)[i],Pzjetb(ev)[i],Eejetb(ev)[i])
from integer i;

create function electrons(event ev) -> bag of electron e as multidirectional
("bf" select new_electrons(ev))
("fb" select event(e));

create function muons(event ev) -> bag of muon m as multidirectional
("bf" select new_muons(ev))
("fb" select event(m));

create function jets(event ev) -> bag of jet j as multidirectional
("bf" select new_jets(ev))
("fb" select event(j));

/*
create function leptonsfn(event ev) -> bag of Lepton l as
	select l where l=electrons(ev) or l=muons(ev);*/
create function leptons(event ev)-> Lepton l as multidirectional
("bf"	select l
	where l=electrons(ev) or l=muons(ev))
/*	from function fn
	where fn=functionnamed("event.leptonsfn->lepton") and 
		l=closednf(fn,1,ev))*/
("fb"	select event(l));
/*
create function particlesfn(event ev)-> bag of Particle p as
	select p where p=leptons(ev) or p=jets(ev);*/
create function particles(event ev)-> Particle p as multidirectional
("bf"	select p
	where p=leptons(ev) or p=jets(ev))
/*	from function fn
	where p=closednf(fn,1,ev) and
		fn=functionnamed("event.particlesfn->particle"))*/
("fb"	select event(p));


create function aleh_stream(charstring filename,integer firstEvent, 
	integer lastEvent)-> bag of Event ev as
select ev
where ev=root_get_interval_sobjects_project(filename,"/ATLFAST","h51",
	{"Pxmiss","Pymiss","Kfele","Pxele","Pyele","Pzele","Eeele",
	"Kfmuo","Pxmuo","Pymuo","Pzmuo","Eemuo",
	"Kfjetb","Pxjetb","Pyjetb","Pzjetb","Eejetb"},
	typenamed("EVENT"),firstEvent,lastEvent);

load_lisp("../lsp/help_fns.lsp");

