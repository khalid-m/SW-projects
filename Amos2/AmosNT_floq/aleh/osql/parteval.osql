enable_parteval(true);

parteval('typenamed');
parteval("CHARSTRING.UPPER->CHARSTRING");
parteval("OBJECT.OBJECTNAME->CHARSTRING");
parteval("NUMBER.NUMBER.TIMES->NUMBER");

parteval("SOBJECT_TYPE.NAME->CHARSTRING");
parteval("SOBJECT_TYPE.STRUCTOF->TYPE");

parteval("EXPERIMENT.NAME->CHARSTRING");
parteval("DATAFILE.NAME->CHARSTRING");
parteval("DATAFILE.PATH->CHARSTRING");
parteval("EVENTDATA.FILEID->INTEGER");
parteval("EVENTDATA.EXPERIMENT->EXPERIMENT");
