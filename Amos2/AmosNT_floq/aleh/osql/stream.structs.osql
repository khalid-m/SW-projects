<"stream.structs.naive.osql";

create function aleh_stream(charstring filename)-> bag of Event ev as
	multidirectional
("bf" select ev
where ev=root_scan_project_addslots(filename,"/ATLFAST","h51",{"Pxmiss",
	"Pymiss","Kfele","Pxele","Pyele","Pzele","Eeele",
	"Kfmuo","Pxmuo","Pymuo","Pzmuo","Eemuo",
	"Kfjetb","Pxjetb","Pyjetb","Pzjetb",
	"Eejetb"},typenamed("EVENT"),4)
	and mat_sobject_transpose({2,3,4,5,6},ev,typenamed("ELECTRON"),17)
	and mat_sobject_transpose({7,8,9,10,11},ev,typenamed("MUON"),18)
	and mat_sobject_transpose({12,13,14,15,16},ev,typenamed("JET"),19));

/*	and set_slotvector_stat(ev,21,transpose({kfele(ev),
				pxele(ev),pyele(ev),pzele(ev),eeele(ev)},
				typenamed("ELECTRON")))
	and set_slotvector_stat(ev,22,transpose({kfmuo(ev),pxmuo(ev),pymuo(ev),
				pzmuo(ev),eemuo(ev)},
				typenamed("MUON")))
	and set_slotvector_stat(ev,23,transpose({kfjetb(ev),pxjetb(ev),
				pyjetb(ev),pzjetb(ev),eejetb(ev)},
				typenamed("JETB"))));*/
/* using transpose from vector of vector into vecto of vector:
	and set_slot(ev,21,vectorof(new_electrons(transpose({kfele(ev),
				pxele(ev),pzele(ev),eeele(ev)}))))
	and set_slot(ev,22,vectorof(new_muons(transpose({kfmuo(ev),pxmuo(ev),
				pzmuo(ev),eemuo(ev)}))))
	and set_slot(ev,23,vectorof(new_jetbs(transpose({kfjetb(ev),pxjetb(ev),
				pzjetb(ev),eejetb(ev)})))));*/

create function aleh_stream(charstring filename, integer firstEvent, 
	integer lastEvent)-> bag of Event ev as multidirectional
("bbbf" select ev
where ev=root_get_interval_sobjects_project(filename,"/ATLFAST","h51",
	{"Pxmiss","Pymiss","Kfele","Pxele","Pyele","Pzele","Eeele",
	"Kfmuo","Pxmuo","Pymuo","Pzmuo","Eemuo",
	"Kfjetb","Pxjetb","Pyjetb","Pzjetb",
	"Eejetb"},typenamed("EVENT"),4,firstEvent,lastEvent)
	and mat_sobject_transpose({2,3,4,5,6},ev,typenamed("ELECTRON"),17)
	and mat_sobject_transpose({7,8,9,10,11},ev,typenamed("MUON"),18)
	and mat_sobject_transpose({12,13,14,15,16},ev,typenamed("JET"),19));
