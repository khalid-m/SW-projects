<"stream.structs.basic.osql";
/*
create function new_jetb(Type r, integer id, Vector cont)-> 
	jetb s key as foreign "make_sobjectbbbf";
create function new_electron(Type r, integer id, Vector cont)-> 
	electron s key as foreign "make_sobjectbbbf";
create function new_muon(Type r, integer id, Vector cont)-> 
	muon s key as foreign "make_sobjectbbbf";
create function new_event(Type r, charstring src, integer id, Vector cont)-> 
	event s key as foreign "make_sobjectbbbbf";
*/
create function new_electrons(event ev)-> bag of Electron as
select new_electron({filename(ev),eventid(ev)},i,Kfele(ev)[i],
	Pxele(ev)[i],Pyele(ev)[i],Pzele(ev)[i],Eeele(ev)[i])
from integer i;

/* Creating muon structs for a given event and streaming them. */
create function new_muons(event ev)-> bag of Muon as
select new_muon({filename(ev),eventid(ev)},i,Kfmuo(ev)[i],
	Pxmuo(ev)[i],Pymuo(ev)[i],Pzmuo(ev)[i],Eemuo(ev)[i])
from integer i;

/* Creating jet structs for a given event and streaming them. */
create function new_jets(event ev)-> bag of Jet as
select new_jet({filename(ev),eventid(ev)},i,Kfjetb(ev)[i],
	Pxjetb(ev)[i],Pyjetb(ev)[i],Pzjetb(ev)[i],Eejetb(ev)[i])
from integer i;

create function aleh_stream(charstring filename)-> bag of Event ev as
multidirectional
("bf" select ev
where ev=root_scan_project_addslots(filename,"/ATLFAST","h51",{"Pxmiss",
	"Pymiss","Kfele","Pxele","Pyele","Pzele","Eeele",
	"Kfmuo","Pxmuo","Pymuo","Pzmuo","Eemuo",
	"Kfjetb","Pxjetb","Pyjetb","Pzjetb","Eejetb"},typenamed("EVENT"),3)
	and set_slotvector(ev,17,vectorof(new_electrons(ev)))
	and set_slotvector(ev,18,vectorof(new_muons(ev)))
	and set_slotvector(ev,19,vectorof(new_jets(ev))));

create function event(particle p) -> event ev as
select ev
from charstring filename, vector source, integer id
where source=source(p) and filename=source[0] and id=source[1]
	and ev=aleh_stream(filename) and eventid(ev)=id;

create function electrons(event ev) -> bag of electron e as multidirectional
("bf"	select e
	where e=get_slot_bag(ev,17))
("fb"	select ev
	from charstring filename, vector source, integer id
	where source=source(e) and filename=source[0] and id=source[1]
		and ev=aleh_stream(filename) and eventid(ev)=id);

create function muons(event ev) -> bag of muon m as multidirectional
("bf"	select m
	where m=get_slot_bag(ev,18))
("fb"	select ev
	from charstring filename, vector source, integer id
	where source=source(m) and filename=source[0] and id=source[1]
		and ev=aleh_stream(filename) and eventid(ev)=id);

create function jets(event ev) -> bag of jet j as multidirectional
("bf"	select j
	where j=get_slot_bag(ev,19))
("fb"	select ev
	from charstring filename, vector source, integer id
	where source=source(j) and filename=source[0] and id=source[1]
		and ev=aleh_stream(filename) and eventid(ev)=id);

create function leptons(event ev)-> bag of Lepton l as multidirectional
("bf"	select l
	where l=electrons(ev) or l=muons(ev))
/*	select closednf(fn,1,ev)
	from function fn
	where fn=functionnamed("event.leptonsfn->lepton"))*/
("fb"	select ev
	from charstring filename, vector source, integer id
	where source=source(l) and filename=source[0] and id=source[1]
		and ev=aleh_stream(filename) and eventid(ev)=id);

create function particles(event ev)-> bag of Particle p as multidirectional
("bf"	select p
	where p=leptons(ev) or p=jets(ev))
/*	select closednf(fn,1,ev)
	from function fn
	where fn=functionnamed("event.particlesfn->particle"))*/
("fb"	select ev
	from charstring filename, vector source, integer id
	where source=source(p) and filename=source[0] and id=source[1]
		and ev=aleh_stream(filename) and eventid(ev)=id);

create function aleh_stream(charstring filename, integer firstEvent, 
	integer lastEvent)-> bag of Event ev as
multidirectional
("bbbf" select ev
where ev=root_get_interval_sobjects_project(filename,"/ATLFAST","h51",
	{"Pxmiss","Pymiss","Kfele","Pxele","Pyele","Pzele","Eeele",
	"Kfmuo","Pxmuo","Pymuo","Pzmuo","Eemuo",
	"Kfjetb","Pxjetb","Pyjetb","Pzjetb",
	"Eejetb"},typenamed("EVENT"),3,firstEvent,lastEvent)
	and set_slotvector(ev,17,vectorof(new_electrons(ev)))
	and set_slotvector(ev,18,vectorof(new_muons(ev)))
	and set_slotvector(ev,19,vectorof(new_jets(ev))));
