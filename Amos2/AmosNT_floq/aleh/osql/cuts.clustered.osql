<'formulas.osql';

/********************************************************************/
/**
 * Event should have exactly three isolated leptons with pt above
 * minPtOfAllThreeLeptons (7 GeV), one of them should have pt above
 * minPtOfTheHardestLepton (20 GeV), at the same time all of them
 * should have eta within etaRangeForAllThreeLeptons (2.4).
 */
/*
 * TTreeCut::ThreeLeptonCut, allLeptonsWithinEtaRange
 * m_etaRangeForAllThreeLeptons: etaL
 */
create function leptonsWithinEta (Event ev, parameters g) -> Lepton as
	select l from Lepton l
	where l = leptons(ev) and abs(eta(l)) < etaL(g);

/*
 * TTreeCut::ThreeLeptonCut, m_isolatedLeptons
 * m_minPtOfAllThreeLeptons: minPtL
 */
create function isolatedLeptons(Event ev, parameters g) -> Lepton as
	select l from Lepton l
	where l=leptonsWithinEta(ev,g) and pt(l) > minPtL(g);

/**
 * minPtOfAllThreeLeptons: minPtL
 * minPtOfTheHardestLepton: hardPtL
 * etaRangeForAllThreeLeptons: etaL
 */
create function threeLeptonCut (Event ev, parameters g) -> Event as
	select ev
	where w_count(isolatedLeptons(ev,g))=3 and
		w_some(select r from real r 
			where r=Pt(isolatedLeptons(ev,g)) and r>hardPtL(g));

/**********************************************************************/
/**
 * the event which has two opposite charged leptons with invariant
 * mass closed to the Z mass should be cutted away.
 * Differences between invariant mass of any two opposite charged
 * leptons and m_zMass should be bigger or equal to m_minimumZMassDiff.
 * we should look to pairs electron - positron and muon - antimuon.
 */

create function oppositeLeptons(Event ev) -> vector of Lepton as
	select {l1, l2} from Lepton l1, Lepton l2
	where l1 = particles(ev) and l2 = particles(ev) and Kf(l1)=-Kf(l2);

/*
 * m_zMass: zMass
 * m_minimumZMassDiff: minZMass
 */
/**rewrite, removed disjunction*/
create function EvInvMass(Event ev,parameters g) -> real r as
	select r
	from vector lept, real inv
	where lept = oppositeLeptons(ev) and
		inv = invMass(lept) and
		r=abs(inv-zMass(g)) and	r < minZMass(g);

create function zVetoCut(Event ev, parameters g) -> Event as
	select ev
	where w_notany(EvInvMass(ev,g));

/********************************************************************/
/**
 * HardTopCut
 */

/*
 * TTreeCut::SelectOkJets, m_okJets
 * Selects jets (with AtlfastB to) which are ok
 * m_etaRangeForJets: etaJ
 * m_minPtForJets: minPtJ
 */
create function okJetsHelpfunc(Event ev, parameters g) -> JetB as
	select j from JetB j where event(j)=ev and abs(eta(j))<etaJ(g) and
		pt(j)>minPtJ(g);
create function okJets(Event ev, parameters g) -> JetB as
	select j from JetB j where j=okJetsHelpfunc(ev,g)/* and
                          atleast(3,okJetsHelpfunc(ev,g))*/;

/*
 * TTreeCut::SeperateBJets, m_okBJets
 * Select b jets from jets (with AtlfastB to) of event
 * function getPdg is Kfjetb from TTreeClass here
 * m_theIntegerForBTaggedJet: forBJet
 */
create function bJets(Event ev, parameters g) -> JetB as
	select j from JetB j where j=okJets(ev, g) and
		kf(j)=forBJet(g);

/*
 * TTreeCut::SeperateBJets, m_okWJets
 * Select wJets from jets (with AtlfastB to) of event. 
 * They are ok and not bJets.
 */
create function wJets(Event ev, parameters g) -> JetB as
	select j from JetB j where j=okJets(ev, g) and
		kf(j)!=forBJet(g);

/*
 * TTreeCut::Select2WCombinations, m_okWComb
 * select 2W combinations
 * returns vectors of two wJets which satisfy invariant mass condition
 * m_wMass: wMass
 * m_allowedWMassDiff: allowedWMass
 */
create function wPairs(Event ev, parameters g) -> vector v as
	select v from JetB j1, JetB j2
	where j1=wJets(ev,g) and j2=wJets(ev,g)
		and j1>j2 and v={j1,j2} and 
		absInvMass(v,wMass(g))<allowedWMass(g); 

/*
 * TTreeCut::SelectTopCombination, m_okTopComb
 * m_topMass: tMass
 * m_allowedTopMassDiff: allowedTMass
 */
create function topComb(Event ev, parameters g) -> vector v as
	select v from JetB j1, JetB j2, Jetb bj
	where v={j1,j2,bj} and {j1,j2}=wPairs(ev,g) and bj=bJets(ev,g) and
		absInvMass(v,tMass(g))<allowedTMass(g);


/**
 * Hardronic Top Cut 2 (see management file)
 *** OBS!do not forget that it should be at least 3 ok jets
 */
create function topCut(Event ev, parameters g) -> Event as
	select ev
	where w_some(topComb(ev,g));

/**********************************************************************/
/* Jet Veto Cut 2
 * leftJets jetbs should have Pt not bigger then maxAllowedPtForOtherJets
 * see Hadronic Top Cut 2
 * m_maxAllowedPtForOtherJets: ptOJets
 */

/*
 * TTreeCut::SelectTopCombination, m_theTopComb
 * min of m_okTopComb
 */
create function mTopComb(Event ev, parameters g) -> vector v as
	select v
	where v=topComb(ev,g) and absInvMass(v,tMass(g))=
		minagg(absInvMass(topComb(ev,g),tMass(g)));

/*
 * TTreeCut::SelectTopCombination, m_theLeftOverJets
 * select m_okJets which are not contained in m_theTopComb
 */
create function leftJets(Event ev, parameters g) -> JetB as
	select j from JetB j
	where j=okJets(ev,g) and
		notany(select j 
				where j=in(mTopComb(ev,g)));

create function jetVetoCut(Event ev, parameters g) -> Event as
	select ev
	where w_notany(select j from JetB j 
				where j=leftJets(ev,g) and Pt(j)>ptOJets(g));

/**********************************************************************/
/*
 * Other cuts
 * 1. All isolated leptons should has Pt not bigger then maxPtAll
 * 2. Isolated lepton which has smallest Pt should have Pt not bigger
 *    then maxPtSoft
 * m_isolatedLeptons: isolatedLeptons(event,parameters)->leptons
 * m_maxPtForAllThreeIsolatedLeptons: maxPtAll
 * m_maxPtForTheSoftestIsolatedLepton: maxPtSoft
 */
create function leptonCuts(Event ev, parameters g) -> Event as
	select ev
	where w_notany(select l from Lepton l 
			where l=isolatedLeptons(ev,g) and Pt(l)>maxPtAll(g))
		and w_some(select r from real r 
			where r=Pt(isolatedLeptons(ev,g)) and r<=maxPtSoft(g));

/*
 * Other cuts, continue*
 * 1. Missing traverse energy (mod(PtMiss)) should be not smaller
 *    then minTransEe
 * 2. Effective mass should be not bigger then maxEfMass
 * m_minMissingTransverseEnergy: minTransEe
 * m_maxAllowedEffectiveMass: maxEfMass
 * ptMiss={PxMiss,PyMiss}
 * pt31=sum(Px(isolated lepton),Py(isolated lepton))
 */
create function missEeCuts(Event ev, parameters g) -> Event as
select ev 
where w_some(select ptmiss from vector ptMiss, vector pt31
	where ptMiss={PxMiss(ev),PyMiss(ev)} and mod(ptMiss)>=minTransEe(g)
		and pt31={sum(select Px(isolatedLeptons(ev,g))),
				sum(select Py(isolatedLeptons(ev,g)))}
		and effectiveMass(ptMiss,pt31)<=maxEfMass(g));

/*******************************************************************/
/**
 * All cuts together!
 */
create function allCuts(Event ev, parameters g) -> Event as
	select ev
	where ev=threeLeptonCut(ev,g) and ev=zVetoCut(ev,g)
		and ev=topCut(ev,g) and ev=jetVetoCut(ev,g) and 
		ev=leptonCuts(ev,g) and ev=missEeCuts(ev,g);

/**
 * This order of applying cuts forces the opimizer to produce more 
 * optimal order of calling transient objects in the execution plan 
 * than previous function allCuts.
 */
create function optAllCuts(Event ev, parameters g) -> Event as
	select ev
	where ev=threeleptoncut(ev,g) and ev=leptoncuts(ev,g) and 
		ev=misseecuts(ev,g) and ev=zvetocut(ev,g) and 
		ev=topcut(ev,g) and ev=jetvetocut(ev,g);
