create function vin(vector v) -> object o as
	select o
	from object o, integer i
	where o=v[i];

/*
 * Formulas over abstact particles
 */
/* 3D vector of momentum */
create function momentum(Particle p key) -> vector as
	select {Px(p),Py(p),Pz(p)};

/* Invariant mass calculation of several particles*/
create function invMass(bag of Particle vl) -> real as
	select r from real e, real r, vector m
	where e=sum(Ee(in(vl))) and	m=sum(momentum(in(vl))) 
		and r=sqrt_pos(abs(e*e-m*m));

create function invMass(vector vl key) -> real as
	select r from real e, real r, vector m
	where e=sum(select Ee(p) from particle p where p=vin(vl)) and	
		m=sum(select momentum(p) from particle p where p=vin(vl))
		and r=sqrt_pos(abs(e*e-m*m));

create function invMass(particle p key) -> real as
	select r from real e, real r, vector m
	where e=Ee(p) and	
		m=momentum(p)
		and r=sqrt_pos(abs(e*e-m*m));

create function invMass(particle p1, particle p2) -> real as
	select r from real e, real r, vector m
	where e=plus(Ee(p1),Ee(p2)) and	
		m=plus(momentum(p1),momentum(p2))
		and r=sqrt_pos(abs(e*e-m*m));
declare_key(functionnamed("PARTICLE.PARTICLE.INVMASS->REAL"),{"p1","p2"});

create function invMass(particle p1, particle p2, particle p3) -> real as
	select r from real e, real r, vector m
	where e=plus(Ee(p1),Ee(p2),Ee(p3)) and	
		m=plus(momentum(p1),momentum(p2),momentum(p3))
		and r=sqrt_pos(abs(e*e-m*m));
declare_key(functionnamed("PARTICLE.PARTICLE.PARTICLE.INVMASS->REAL"),
		{"p1","p2","p3"});

/* Absolute value of difference between invariant mass of vector and
   constant */
create function absInvMass(bag of Particle vs, real cMass)
-> real as
	select abs(invMass(vs)-cMass);
create function absInvMass(vector vs, real cMass) -> real as
	select abs(invMass(vs)-cMass);

create function absInvMass(particle p, real cMass) -> real as
	select abs(invMass(p)-cMass);
create function absInvMass(particle p1, particle p2, real cMass) -> real as
	select abs(invMass(p1,p2)-cMass);
declare_key(functionnamed("PARTICLE.PARTICLE.REAL.ABSINVMASS->REAL"),
	{"p1","p2","cmass"});
create function absInvMass(particle p1, particle p2, particle p3, 
				real cMass) -> real as
	select abs(invMass(p1,p2,p3)-cMass);
declare_key(functionnamed("PARTICLE.PARTICLE.PARTICLE.REAL.ABSINVMASS->REAL"),
	{"p1","p2","p3","cmass"});

/* Magnitude */
create function magnitude(Particle p key) -> real as
	select magnitude(px(p),py(p),pz(p));

/* Eta */
create function eta(Particle p key) -> real r as 
	select eta(px(p),py(p),pz(p));

/* Pt */
create function pt(Particle p key) -> real as
	select pt(px(p),py(p));

create function Pairs(bag of object obs) -> bag of vector pair as
select {o1,o2}
from object o1, object o2
where o1>o2 and o1=in(obs) and o2=in(obs);

create function Pairs(vector obs) -> bag of vector pair as
select {o1,o2}
from object o1, object o2
where o1>o2 and o1=vin(obs) and o2=vin(obs);
