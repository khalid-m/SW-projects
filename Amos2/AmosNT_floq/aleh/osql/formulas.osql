/*****************************************************************/
/* 
 * General and vector operations. And cost hints for arethmetic operations.
 */

lisp;
(resetvar _system-watermark_ 0
(deleteobject (getfunctionnamed 'vector.vector.plus->vector-number))
(osql "create function plus(vector v1, vector v2) -> vector as foreign 'plus-vec';"))
:osql
create function null_vector(vector v key) -> vector as foreign 'null-vec';
create function log(number key) -> real as foreign 'logn';
create function atan2(number, number) -> real as foreign 'atan2f';

create function magnitude(vector key) -> real as foreign 'magnitude';
create function eta(vector key) -> real as foreign 'eta';
create function pt(vector key) -> real as foreign 'pt';

create function sum(bag of vector vs key) -> vector as
begin
	declare vector v0, integer size;
	set v0 = null_vector(in(vs));
	for each vector v where v=in(vs)
		set v0=v0+v;
	return v0;
end;

/* Mod of Vector */
create function mod(vector v key) -> real r as
select sqrt(v*v);

/*
 * Calculation effective mass and vector2 specific operations
 *
 * Effective mass = sqrt(2*pt31*ptMiss*(1-cos(pt31.DeltaPhi(ptMiss))))
 * DeltaPhi(v)=	Phi_mpi_pi(Phi()-v.Phi())
 * Phi=			TMath::Pi()+TMath::ATan2(-fY,-fX)
 * Phi_mpi_pi(x)=   while (x >= kPI) x -= kTWOPI;
 *					while (x < -kPI) x += kTWOPI;
 *					return x;
 * kPI=				TMath::Pi
 * kTOWPI=			2.0*kPI
 * TMath::Pi=		3.14159265358979323846
 * TMath::ATan2=	if (x != 0) return  atan2(y, x);
 *					if (y == 0) return  0;
 *					if (y >  0) return  Pi()/2;
 *					else        return -Pi()/2; 
 */

create function fy(vector v key) -> real as
select fy
from real fx, real fy
where {fx,fy}=v;

create function fx(vector v key) -> real as
select fx
from real fx, real fy
where {fx,fy}=v;

create function phi(Vector v key) -> real as
select atan2(-fy(v),-fx(v))+pi();

create function phi_mpi_pi(number x key) -> real as
	select r from real r, integer k 
	where r=x+k*2*pi() and k=ceiling(-1.0/2.0-x/(2.0*pi()));

create function effectiveMass(Vector ptMiss, Vector pt31) -> real r as
select sqrt(abs(2.0*(pt31*ptMiss)*(1-cos(phi_mpi_pi(phi(pt31)-phi(ptMiss))))));

/****************************************************************/
/*
 * Formulas over abstact particles
 */
/* 3D vector of momentum */
create function momentum(Particle p key) -> vector of real as
	select {Px(p),Py(p),Pz(p)};

/* Invariant mass calculation of several particles*/
create function invMass(bag of Particle vl) -> real as
	select r from real e, real r, vector of real m
	where e=sum(Ee(in(vl))) and	m=sum(momentum(in(vl))) 
		and r=sqrt(abs(e*e-m*m));
/*
create function invMass(bag of Particle vl key) -> real as
	select r from real e, real r, real y, real xv, real z
	where e=sum(Ee(in(vl))) and	y=sum(Py(in(vl))) and xv=sum(Px(in(vl))) and
		z=sum(Pz(in(vl))) and r=sqrt(abs(e*e-(xv*xv+y*y+z*z))) and r>=0;
*/
create function invMass(vector vl key) -> real as
	select invMass(p) from bag of Particle p where p=in(vl);

/* Absolute value of difference between invariant mass of vector and
   constant */
create function absInvMass(bag of Particle vs, real cMass)
-> real as
	select abs(invMass(vs)-cMass);
create function absInvMass(vector vs, real cMass) -> real as
	select abs(invMass(vs)-cMass);

/* Magnitude */
create function magnitude(Particle p key) -> real as
	select magnitude(momentum(p));

/* Eta */
create function eta(Particle p key) -> real r as 
	select eta(momentum(p));

/* Pt */
create function pt(Particle p key) -> real as
	select pt(momentum(p));
