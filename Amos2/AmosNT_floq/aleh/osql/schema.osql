/* Creating entity types */
create type Event;
create type Particle;
create type Lepton under Particle;
create type JetB under Particle;
create type Electron under Lepton;
create type Muon under Lepton;

/* Attributes of Event. Each event uniquely identified by filename and
   its id number in the file. */
create function PxMiss(Event) -> real as stored;
create function PyMiss(Event) -> real as stored;
create function filename(Event) -> charstring as stored;
create function EventId(Event) -> integer as stored;

/* Attributes of particles. An id number is assign to each particle to be
   able to order particles belonging to the same event. */
create function PID(Particle) -> integer as stored;
create function Kf(Particle) -> integer as stored;
create_index("KF","integer","hash","multiple");
create function Px(Particle) -> real as stored;
create function Py(Particle) -> real as stored;
create function Pz(Particle) -> real as stored;
create function Ee(Particle) -> real as stored;
create_index("EE","REAL","hash","multiple");

create function event(Particle)-> Event;
/* Implementation of relationship between an event and its particles. For
   efficiency each basic particle stores refernce to its event. */
create function event(Muon)-> Event as stored;
create function event(Electron)-> Event as stored;
create function event(Jetb)-> Event as stored;
create_index("MUON.EVENT->EVENT","EVENT","hash","multiple");
create_index("ELECTRON.EVENT->EVENT","EVENT","hash","multiple");
create_index("JETB.EVENT->EVENT","EVENT","hash","multiple");

/* Definition of derived functions for simplifying defenitions of analysis
   queries. */
create function electrons(Event ev) -> Electron el as 
select el
where event(el)=ev;

create function muons(Event ev) -> Muon mu as
select mu 
where event(mu)=ev;

create function jetbs(Event ev) -> JetB jb as
select jb 
where event(jb)=ev;

create function leptons(Event ev) -> Lepton l as
select l
where event(l)=ev;

create function particles(Event ev) -> Particle p as
select p 
where event(p)=ev;

load_lisp("../lsp/operations.lsp");
