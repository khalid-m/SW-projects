set_absorber('Bigtable', 'absorb-gql');
set_finalizer('Bigtable', 'translate-gql');

create_wrapper_absorbability('Bigtable', '<', 'gql-translate-comparison');
create_wrapper_absorbability('Bigtable', '<=', 'gql-translate-comparison');
create_wrapper_absorbability('Bigtable', '>', 'gql-translate-comparison');
create_wrapper_absorbability('Bigtable', '>=', 'gql-translate-comparison');
create_wrapper_absorbability('Bigtable', '!=', 'gql-translate-comparison');
/* like predicate is not supported in GQL */

