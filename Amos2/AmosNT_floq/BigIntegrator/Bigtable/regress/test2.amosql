bigTableAttributes('ds1', 'CITY');

bigTableAttributes('ds1', 'STATE');

/* Find the cities and their states where the population of the city > 50000 */
/* SQL: select S.FULLNAME, S.SHORTNAME, C.STATE, C.CITYNAME, C.POPULATION
        from STATE S, CITY C
        where C.POPULATION > 50000 and
              S.SHORTNAME = C.STATE */

/* high selectivity */
count(serverNLJNew("ds1", {"select * from STATE", 
                           "select * from CITY where POPULATION > 50000"}, 
                   {{1,0}}));

count(serverHJ("ds1", {"select * from STATE", 
                       "select * from CITY where POPULATION > 50000"}, 
               {{1,0}}));

count(serverNLJ('ds1',{"select * from STATE", "select * from CITY where POPULATION > 50000 and STATE = ?"}, {{1}}));


/* low selectivity */
count(serverNLJNew("ds1", {"select * from STATE", 
                           "select * from CITY where POPULATION > 500000"}, 
                   {{1,0}}));

count(serverHJ("ds1", {"select * from STATE", 
                       "select * from CITY where POPULATION > 500000"}, 
               {{1,0}}));

count(serverNLJ('ds1',{"select * from STATE", "select * from CITY where POPULATION > 500000 and STATE = ?"}, {{1}}));


count(sql("select s.FULLNAME, s.SHORTNAME, c.STATE, c.CITYNAME, c.POPULATION
        from STATE_ds1 s, CITY_ds1 c
        where c.POPULATION > 50000 and
              s.SHORTNAME = c.STATE"));

/* Client NLJ */
create function q0()->(Charstring,Charstring)
  as select cityname(c), fullname(s)
     from City_ds1 c, State_ds1 s
     where population(c)>50000 and
           state(c) = shortname(s);

count(q0());

/* Client HJ */
set :a = gql("ds1","select * from STATE");

set :b = gql("ds1","select * from CITY where POPULATION > 50000");

count(fasthashjoin(:a,:b,1,0));

pc("*select*");


