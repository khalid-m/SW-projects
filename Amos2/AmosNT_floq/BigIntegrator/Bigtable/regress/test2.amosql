		 from City_ds1 c, State_ds1 s
		 where population(c)>800000 and shortname(s)>'M' and
		       state(c) = shortname(s);



	create function q2()-> Bag of Object
	  as gql('ds1',"select * from CITY 
			where POPULATION > ? and 
			      POPULATION < ?", {600000,900000});

	create function q3()-> Bag of Object
	  as gql('ds1',"select * from CITY 
			where CITYNAME > ?", {'B'});

	bigTableNumOfTuples('ds1','CITY');
	bigTableNumOfTuples('ds1','STATE');

	costhint("CHARSTRING.CHARSTRING.VECTOR.gql->VECTOR", "bbbf", {10000,199});

create function q10()->(Charstring, Charstring) as 
select cityname(c), fullname(s) from City_ds1 c, State_ds1 s where population(c)>800000 and shortname(s)>'CA' and state(c) = shortname(s);
*/

lisp;


(checkequal 
 "checking populated local meta data table from bigtable"
 ((osql "bigTableURL('ds1');") 
  '(("http://oddse2010.appspot.com/simpleprotocol")))
 ((osql "bigTables('ds1');")
  '(("STATE") ("CITY")))
 ((osql "bigTableAttributes('ds1', 'CITY');") 
  '(("POPULATION" "INTEGER" -1 1) ("CITYNAME" "CHARSTRING" 0 1) ("STATE" "CHARSTRING" -1 1)))
 ((osql "bigTableKeyAttribute('ds1', 'CITY');") '(("CITYNAME")))
)



(checkequal
 "testing foreign function for querying bigtable part I"
 ((osql "gql('ds1','select * from CITY');") 
  '((#("GA" "Atlanta" 538000)) (#("NY" "New York" 8364000)) 
    (#("CA" "San Francisco" 809000)))) 
 ((osql "gql('ds1','select * from CITY where CITYNAME > ?', {'Atlanta'});")
  '((#("NY" "New York" 8364000)) (#("CA" "San Francisco" 809000))))
 ((osql "gql('ds1', 'select * from CITY where CITYNAME >= ?', {'Atlanta'});")
  '((#("GA" "Atlanta" 538000)) (#("NY" "New York" 8364000)) (#("CA" "San Francisco" 809000))))
 ((osql "gql('ds1', 'select * from CITY where CITYNAME > ? 
                      and CITYNAME < ?', {'Atlanta','San Francisco'});")
  '((#("NY" "New York" 8364000))))
 )



(checkequal
 "testing foreign function for querying bigtable part II"
 ((osql "gql('ds1','select * from CITY where POPULATION > ?', {8000000});")
  '((#("NY" "New York" 8364000))))
 ((osql "gql('ds1','select * from CITY where POPULATION >= ?', {809000});")
  '((#("CA" "San Francisco" 809000)) (#("NY" "New York" 8364000))))
 ((osql "gql('ds1','select * from CITY where POPULATION > ? and 
                      POPULATION < ?', {600000, 900000});") 
  '((#("CA" "San Francisco" 809000))))
 ((osql "gql('ds1', 'select * from CITY where POPULATION > ? and STATE = ?', {800000, 'CA'});")
  '((#("CA" "San Francisco" 809000))))
 )


(checkequal
 "inserting a new tuple"
 ((osql "insertBigTable('ds1','CITY',{'CITYNAME', 'POPULATION', 'STATE'},{'New city XX', 9999999, 'CA'});")
  nil)
)


(checkequal
 "testing foreign function for querying bigtable after inserting a new tuple"
 ((osql "gql('ds1','select * from CITY');")
  '((#("GA" "Atlanta" 538000)) (#("NY" "New York" 8364000)) (#("CA" "San Francisco" 809000)) (#("CA" "San Jose" 1100000))))
 ((osql "gql('ds1','select * from CITY where POPULATION > ?', {8000000});")
  '((#("CA" "San Jose" 1100000)) (#("NY" "New York" 8364000))))
)



(checkequal
 "getting a tuple"
 ((osql "getBigTable('ds1','CITY',{'New city XX'});")
  '((#("CA" "San Jose" 1100000))))
 ((osql "getBigTable('ds1','CITY',{'San Francisco'});")
  '((#("CA" "San Francisco" 809000))))
)


(checkequal
 "deleting a new tuple"
 ((osql "deleteBigTable('ds1','CITY',{'New city XX'});")
  nil)
)



(checkequal
 "Rewrites of core cluster functions (querying single table)"
 ((osql "select cityname(c) from City_ds1 c where population(c) > 800000;") 
  '(("San Francisco") ("New York")))
 ((osql "select cityname(c) from City_ds1 c;") 
  '(("Atlanta") ("New York") ("San Francisco"))) 
 ((osql "select cityname(c) from City_ds1 c 
         where population(c) > 800000 and
               population(c) < 2000000;")
  '(("San Francisco")))
 ((osql "select cityname(c) from City_ds1 c where population(c)>800000 and
                                       state(c)='CA';")
  '(("San Francisco")))
 ((osql "select cityname(c), fullname(s)
         from City_ds1 c, State_ds1 s
         where population(c)>800000 and
               state(c) = shortname(s);")
  '(("San Francisco" "California") ("New York" "New York")))
)


(checkequal
 "Rewrites of core cluster functions (rewriting join)"
 ((osql "select cityname(c), fullname(s)
         from City_ds1 c, State_ds1 s
         where population(c)>1000000 and population(c)<2000000 and
               state(c) = shortname(s);")
  '(("San Francisco" "California")))
 ((osql "select cityname(c), fullname(s)
         from City_ds1 c, State_ds1 s
         where population(c)>80000 and shortname(s)>'CA' and
               state(c) = shortname(s);" )
  '(("Atlanta" "Georgia") ("New York" "New York")))
 ((osql "select cityname(c), fullname(s)
         from City_ds1 c, State_ds1 s
         where population(c)>500000 and population(c)<2000000 and shortname(s)>'CA' 
	       and state(c) = shortname(s);" )
  '(("Atlanta" "Georgia")))
)


create function q00002()->(integer, Charstring) 
  /* Multi-database theta-join between BigTable tables and an equijoin with MySQL */
  as select mid(i), name(o)
     from Machine_ds1 m, MachineInstallation_ds1 i, Site_ds1 s, 
          Operator_ibds o 
     where name(m) = "M1" and
           region(s) = "Uppland" and	
           model(m) = model(i) and
           sid(i) > sid(s) and
           mid(i) = Operates(o);


create function q00003()->(integer, Charstring) 
  /* Multi-database theta-join between BigTable tables and an equijoin with MySQL */
  as select mid(i), name(o)
     from Machine_ds1 m, MachineInstallation_ds1 i, Site_ds1 s, 
          Operator_ibds o 
     where name(m) = "M1" and
           region(s) = "Uppland" and	
           model(m) = model(i) and
           sid(i) = sid(s) and
           mid(i) = Operates(o) and ;

:osql


