set :a = jdbc("ds1", "com.mysql.jdbc.Driver");

set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

set :db=getenv("database");

connect(:a, :dburl + :db, "regress", "regress");

count(read_sql(:a, "dropmetadb.sql"));

count(read_sql(:a, "metadb.sql"));


disconnect(:a);

quit;