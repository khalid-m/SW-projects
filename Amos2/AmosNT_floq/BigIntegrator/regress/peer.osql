/* almost working */
/*
create function sql_myv2(Charstring logdburi, Charstring query, Vector of Vector args, Vector of number inputvarposvec)->Vector
as select {arg[0], arg[1], arg[2], arg[3], arg[4], arg[5], arg[6], logres[0], logres[1], logres[2]}
   from Vector arg, vector logres
   where arg in args and logres = sql(logdburi_jdbc(logdburi),query, project(arg, inputvarposvec));
*/

create function sql_myv2(Charstring logdburi, Charstring query, Vector of Vector args, Vector of number inputvarposvec)->Vector
as select concat(arg, logres)
   from Vector arg, vector logres
   where arg in args and logres = sql(logdburi_jdbc(logdburi),query, project(arg, inputvarposvec));


