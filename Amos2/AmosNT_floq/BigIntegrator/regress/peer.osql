create function logdburi_jdbc(Charstring logdburi)->JDBC as stored;

create function pop_uri_jdbc(Charstring logdburi, JDBC jo)->Boolean as 
 set logdburi_jdbc(logdburi)=jo;


create function sql_my(Charstring logdburi, Charstring query)->Vector
as
    sql(logdburi_jdbc(logdburi),query);

create function sql_my(Charstring logdburi, Charstring query, Vector args)->Vector
as
    sql(logdburi_jdbc(logdburi),query,args);

/* sql_myv2 with args as vector of vector arguments for sql query running in 
   peers */

/* new version for push down metaDB data to logdb to output at the same time */
