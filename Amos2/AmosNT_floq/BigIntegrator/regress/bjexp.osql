/* new definition with inputvarpovec as extra argument*/
/* and used in query in parallel */
/* mapping logdb uri to peer name and forming peer vector and query argument 
   vector for multicastreceive */
create function multicastreceive3(Vector uris, Charstring fn, Charstring query, 
                                         Vector args, Vector of number inputvarposvec)->Bag of Object
  as begin
     declare vector peervec, vector argvec, Charstring pe, Charstring logdburi;
     set peervec={};
     set argvec={};
     for each integer i where i in iota(0, dim(uris)-1)
       begin
       set logdburi=uris[i];
       set pe=mappinguri_peer(logdburi);
        if pe then
          begin
          set peervec=concat(peervec, {pe}); 
          set argvec=concat(argvec, {{logdburi, query, args[i], inputvarposvec}});
          end;
       end;
     if dim(peervec) >= 1 then
     return multicastreceive(peervec, fn, argvec);
     end;

/* multi_sql_union is the same as sql */
/* for query logdb in sequence, takes logdbid, query, and parameters */ 
create function multi_sql_union(Object logdburi, Charstring query, 
                                Vector params) -> Vector
  as select sql(logdburi_js(logdburi), query, params);


/* set url of meta-database */ 
set :dburl = "jdbc:mysql://localhost:3306/";


/************************ this is different from cases **********************/
/* set up connection to access small meta database (100 machine installations 
   and 200 sensors) at local mysql */
set :metas = jdbc("metas", "com.mysql.jdbc.Driver");

/* set up connection to access middle meta database (200 machine installations 
   and 400 sensors) at local mysql */
set :metam = jdbc("metam", "com.mysql.jdbc.Driver");


/* set up connection to access large meta database (500 machine installations 
   and 1000 sensors) at local mysql */
set :metal = jdbc("metal", "com.mysql.jdbc.Driver"); 


/* procedure to import tables from metaDB */
create function importmetatable(jdbc js, charstring dburi, 
                                charstring username, charstring password,
                                vector of charstring tables)->boolean
as begin declare integer i, integer numoftable; 
         set i =0;
	 set numoftable=dim(tables);
        connect(js, dburi, username, password);
        while i < numoftable
        do 
        import_table(js, tables[i]);
        set i = i+1;
        end while;
   end;

/* generate source predicates for small meta database */
importmetatable(:metas, :dburl + "metadb_s", "regress", "regress", 
                {'SENSORINSTALLATION', 'LOCATION', 'MACHINEINSTALLATION', 
                 'MACHINE', 'SENSOR'});

/* generate source predicates for middle meta database */
importmetatable(:metam, :dburl + "metadb_m", "regress", "regress", 
                {'SENSORINSTALLATION', 'LOCATION', 'MACHINEINSTALLATION', 
                 'MACHINE', 'SENSOR'});

/* generate source predicates for large meta database */
importmetatable(:metal, :dburl + "metadb_l", "regress", "regress", 
                {'SENSORINSTALLATION', 'LOCATION', 'MACHINEINSTALLATION', 
                 'MACHINE', 'SENSOR'});


/***************** just for import_table2 ******************/

/* to get :js for generate source predicate of measuresA */
/* used in query in sequence */
set :js = jdbcSet(2,"com.microsoft.jdbc.sqlserver.SQLServerDriver");

/* to import the measuresA schema from one of the server regardless the 
   logdb size since they have the same schema */
set :logdb1url = "jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB";

connect2(first(:js), :logdb1url, "udbl", "udbl");

< 'patch.osql';

/* import source predicate Measurement from one logdb */
/* import_sourceset_table(:js, 'MEASURESA'); */
import_table2(first(:js),'MEASURESA',:js);


/************************** peers setup for paralization ***************************/
/* peer u */
/* in peer u, call jdbc function */
set :u= call_function('u','jdbc', {"A","com.microsoft.jdbc.sqlserver.SQLServerDriver"}, 10)[0];

/* populating the mapping from logdburi of metaDB to jdbc object at peer, used
   in sql_myv2 at peer to get the jdbc object at peer */
call_function('u','pop_uri_jdbc',{"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB",:u},10);


/* peer v */
/* in peer v, call jdbc function */
set :v= call_function('v','jdbc', {"B","com.microsoft.jdbc.sqlserver.SQLServerDriver"}, 10)[0];

/* populating the mapping from logdburi of metaDB to jdbc object at peer, used
   in sql_myv2 at peer to get the jdbc object at peer */
call_function('v','pop_uri_jdbc',{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB",:v},10);

/* procedure to connect to different size of logdb */
create function connectlogdb(Vector of charstring peervec, vector js, 
                             vector logDBuri, 
                             vector username, vector password)->boolean
as begin declare integer i, integer numoflogDB;
         set i=0;
         set numoflogDB=dim(logDBuri);
         while i < numoflogDB
         do
         call_function(peervec[i], 'connect', {js[i], logDBuri[i], username[i],
                       password[i]}, 10);
         set i = i+1;
         end while;
   end;


/* it is different from cases, connect different logdb sizes */
/* set to connect to bm1GB */
set :logDBuri1="jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB";

set :logDBuri2="jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB";

/* connect to bm1GB */
connectlogdb({'u','v'}, {:u, :v}, {:logDBuri1, :logDBuri2}, {"udbl", "udbl"},
             {"udbl", "udbl"});
