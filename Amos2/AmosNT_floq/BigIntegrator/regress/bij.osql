start javaamos -n
start javaamos -O peer.osql -s u
start javaamos -O peer.osql -s v

javaamos -c me


/* section of generate meta bindings cvs fles, remote bulk insert and query */

/************************** run remote bulk insert and query ******************************/
set :u= call_function('u','jdbc', {"A","com.microsoft.jdbc.sqlserver.SQLServerDriver"}, 10)[0];
set :v= call_function('v','jdbc', {"B","com.microsoft.jdbc.sqlserver.SQLServerDriver"}, 10)[0];

/* set up JDBC connection and populate mapping in peers */
create function initialize(Charstring logDBname, vector remotejdbcobjvec)->boolean as
begin 
    call_function('u','connect', {remotejdbcobjvec[0],"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname, "udbl", "udbl"}, 10);
    call_function('u','pop_uri_jdbc',{"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname, remotejdbcobjvec[0]},10);
    call_function('v','connect', {remotejdbcobjvec[1],"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname, "udbl", "udbl"}, 10);
    call_function('v','pop_uri_jdbc',{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname, remotejdbcobjvec[1]},10);
end;


/* notice the queries in multicastreceive need to be well specified since one needs to write
   'include' some columns in the index creation */
/* only multicastreceive procedure to remote bulk insert and query */
create function remoteproc(Charstring logDBname, vector schemanamevec, vector csvfilenamevec)->bag of object as
begin
    declare Charstring bulkinsertserver1, Charstring bulkinsertserver3;
    /* delete metabinding table rows */	 
    multicastreceive({"v","u"}, "sql_my",{{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname,"delete from metabindings", {}},
				      {"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname,"delete from metabindings", {}}});
    /* remote bulk insert metabinding into temp table in logdb */
    set bulkinsertserver1="BULK INSERT "+logDBname+"."+schemanamevec[0]+".metabindings FROM '//130.238.14.85/Users/Public/FLOQ/"+csvfilenamevec[0]+"' WITH (FIELDTERMINATOR =',', ROWTERMINATOR = '0x0a');";
    set bulkinsertserver3="BULK INSERT "+logDBname+"."+schemanamevec[1]+".metabindings FROM '//130.238.14.85/Users/Public/FLOQ/"+csvfilenamevec[1]+"' WITH (FIELDTERMINATOR =',', ROWTERMINATOR = '0x0a');";
    multicastreceive({"v","u"}, "sql_my",{{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname,bulkinsertserver3,{}},
				       {"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname,bulkinsertserver1, {}}});
    /* run queries */ 
    return multicastreceive({"v","u"}, "sql_my", {{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname,
	                                    "select * from measuresA ma, metabindings mbs where ma.mv>mbs.th+mbs.ev and ma.m=mbs.m and ma.s=mbs.s",{}},
		        		   {"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname,
	                                    "select * from measuresA ma, metabindings mbs where ma.mv>mbs.th+mbs.ev and ma.m=mbs.m and ma.s=mbs.s",{}}});  
end;


/* notice the queries in multicastreceive need to be well specified since one needs to write
   'include' some columns in the index creation */
/* only multicastreceive procedure to remote bulk insert and query */
create function remoteproc2(Charstring logDBname, vector schemanamevec, vector csvfilenamevec, )->bag of object as
begin
    declare Charstring bulkinsertserver1, Charstring bulkinsertserver3;
    /* delete metabinding table rows */	 
    multicastreceive({"v","u"}, "sql_my",{{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname,"delete from metabindings", {}},
				      {"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname,"delete from metabindings", {}}});
    /* remote bulk insert metabinding into temp table in logdb */
    set bulkinsertserver1="BULK INSERT "+logDBname+"."+schemanamevec[0]+".metabindings FROM '//130.238.14.85/Users/Public/FLOQ/"+csvfilenamevec[0]+"' WITH (FIELDTERMINATOR =',', ROWTERMINATOR = '0x0a');";
    set bulkinsertserver3="BULK INSERT "+logDBname+"."+schemanamevec[1]+".metabindings FROM '//130.238.14.85/Users/Public/FLOQ/"+csvfilenamevec[1]+"' WITH (FIELDTERMINATOR =',', ROWTERMINATOR = '0x0a');";
    multicastreceive({"v","u"}, "sql_my",{{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname,bulkinsertserver3,{}},
				       {"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname,bulkinsertserver1, {}}});
    /* run queries */ 
    return multicastreceive({"v","u"}, "sql_my", {{"jdbc:microsoft:sqlserver://udblserver3;DatabaseName="+logDBname,
	                                    "select * from measuresA ma, metabindings mbs where ma.mv>mbs.th+mbs.ev and ma.m=mbs.m and ma.s=mbs.s",{}},
		        		   {"jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName="+logDBname,
	                                    "select * from measuresA ma, metabindings mbs where ma.mv>mbs.th+mbs.ev and ma.m=mbs.m and ma.s=mbs.s",{}}});  
end;

/* access bm1GB */
