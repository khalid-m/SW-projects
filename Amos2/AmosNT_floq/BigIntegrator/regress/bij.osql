/***********************remote bulk insert*********************/
/* split the bindings into two files and with different size files, small, middle, large */
/* remote bulk insert to server 1 with meta small data, note: you need to include schema name dbo */
set :bulkinsertserv1_metas= "BULK INSERT bm1GB.dbo.metabindings
   FROM '//130.238.14.85/Users/Public/FLOQ/server1_s_bindings.csv'
   WITH 
      (
         FIELDTERMINATOR =',',
	 ROWTERMINATOR = '0x0a'
      );";

/* delete existing data first */
sql(first(:js), "delete from metabindings");

/* remote bulk insert into server 1, first(:js) is server 1 */
sql(first(:js),:bulkinsertserv1_metas);

/* query to check the remote bulk loaded data */
count(sql(first(:js), "select * from metabindings")); 


/* remote bulk insert to server 3 with meta small data, note: you need to include schema name udb */
