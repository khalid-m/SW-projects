/* disconnect peer JDBC */
create function disconnect(vector remotejdbcobjvec)->boolean as
begin
call_function('u','disconnect',{remotejdbcobjvec[0]},10); 
call_function('v','disconnect',{remotejdbcobjvec[1]},10);
end;

disconnect({:u,:v});




set :metas = jdbc("metas", "com.mysql.jdbc.Driver");

set :dburl = "jdbc:mysql://localhost:3306/";

connect(:metas, :dburl+ "metadb_s", "regress", "regress");

set :b=groupby((select metavec[1], {metavec[4], metavec[5], metavec[3], metavec[2]} from vector metavec where metavec = sql(:metas, "select LID,URI,SI,S_.MI,EV,TH,MACHINENIL_.M from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID")), #'vectorof');


lisp;

/* stop here */
/* make a lisp function for each grouped item in bag call writecsvfile function */
(defun writebagtocsv-+ (fno b path)
	(mapbag b
	          (f/l (x)
	(getfunction 'writecsvfile (list path (car (last x))))
)))			

:osql

create function writebagtocsv(bag b, charstring path)->boolean as foreign 'writebagtocsv-+';



writebagtocsv



/* this function is writing the grouped metaDB result into csv file */
create function writemetabindins(JDBC js, Charstring metadbquery, Vector filename)->Boolean as
begin
    declare bag metabag;
    set metabag=sql(js, metadbquery);

    for each 
	


/***********************generate meta bindings cvs fles*********************/
/* generate meta small size csv file for server 1 */
writecsvfile("C:/Users/Public/FLOQ/server1_s_bindings.csv", sql(:metas, "select S_.MI,SI,EV,TH from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID and uri='jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB';"));

/* generate meta small size csv file for server 3 */
writecsvfile("C:/Users/Public/FLOQ/server3_s_bindings.csv", sql(:metas, "select S_.MI,SI,EV,TH from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID and uri='jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB';"));


/* generate meta middle size csv file for server 1 */
writecsvfile("C:/Users/Public/FLOQ/server1_m_bindings.csv", sql(:metam, "select S_.MI,SI,EV,TH from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID and uri='jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB';"));

/* generate meta middle size csv file for server 3 */
