/* this is what original the wrapping function does or without the bag of */
create function sql3(Jdbc c, Charstring q) ->bag of (object, object, object, object, object, object, object) as 
select v[0], v[1], v[2], v[3], v[4], v[5], v[6]
from vector v
where v = sql(c,q);

pc("sql3");

create function sql2(Jdbc c, Charstring q) ->bag of (object, object, object, object, object, object, object) as 
select v[0], v[1], v[2], v[3], v[4], v[5], v[6]
from vector v
where v in sql(c,q);

pc("sql2");


