      peervec=formarg[0]                                      																			and
      argvec=formarg[1]                                         																		and
      boj in multicastreceive3(peervec, "sql_myv2", "select bt,et,mv from measuresA where (mv-?)>? and m=? and s=?", argvec); 

pc("lowfun14v9");

count(lowfun14v9(:a));



create function lowfun14v10(jdbc js)->(number, number, number, object, object) as
select boj[0], boj[1], boj[2], bmetavec[1], bmetavec[2]
from bag of vector b,  vector formarg, vector peervec, vector argvec, 
     vector boj, vector bmetavec
where b=sql1(js, "select LID,URI,SI,S_.MI,EV,TH,MACHINENIL_.M from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID") and
      bmetavec in b and  
/* can i out put meta var at here ??? */							                                        							 
      formarg = formargfrombag(groupby((select v[1], {v[4], v[5], v[3], v[2]} from vector v where v in b), #'vectorof'))                                              				and
      peervec=formarg[0]                                      																			and
      argvec=formarg[1]                                         																		and
      boj in multicastreceive3(peervec, "sql_myv2", "select bt,et,mv from measuresA where (mv-?)>? and m=? and s=?", argvec); 

pc("lowfun14v10");

count(lowfun14v10(:a));


/* this one applied myin */
create function lowfun14v2(jdbc js)->(number, number, number, object, object) as
select boj[0], boj[1], boj[2], bmetavec[1], bmetavec[2]
from vector bmetavec, vector formarg, vector peervec, vector argvec, 
     vector boj
where bmetavec= myin(sql(js, "select LID,URI,SI,S_.MI,EV,TH,MACHINENIL_.M from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID"))                                                        							                                        							and 
      formarg = formargfrombag(select groupby((select bmetavec[1], {bmetavec[4], bmetavec[5], bmetavec[3], bmetavec[2]} ), #'vectorof'))                                              				and
      peervec=formarg[0]                                      																			and
      argvec=formarg[1]                                         																		and
      boj in multicastreceive3(peervec, "sql_myv2", "select bt,et,mv from measuresA where (mv-?)>? and m=? and s=?", argvec); 

pc("lowfun14v2");

count(lowfun14v2(:a));


/* this one returns correct number of results, but can't output metaDB result */
create function lowfun12(jdbc js)->(number, number, number) as
select boj[0], boj[1], boj[2]
from bag of vector bmetavec, vector formarg, vector peervec, vector argvec, 
     vector boj
where bmetavec = mysql(js, "select LID,URI,SI,S_.MI,EV,TH,MACHINENIL_.M from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID", {})                                                        and 
      formarg = formargfrombag(select groupby((select metavec[1], {metavec[4], metavec[5], metavec[3], metavec[2]} from vector metavec where metavec in bmetavec), #'vectorof'))                                              and
      peervec=formarg[0]                                        and
      argvec=formarg[1]                                         and
      boj in multicastreceive3(peervec, "sql_myv2", "select bt,et,mv from measuresA where (mv-?)>? and m=? and s=?", argvec); 

pc("lowfun12");

count(lowfun12(:a));



/********************** Numerical queries **************************/
/* retrieves the machine identifiers m for which a sensor has measured values 
   mv of measurement class A higher than the expected values ev by a threshold
   value @thA during the time from bt to time et */
/* with small meta DB and different size of logdb */
create function newq4()->(Integer, Number, Number) as
select m(ma), bt(ma), et(ma)
from SensorInstallation@a si, Location@a l, MeasuresA ma, 
     MachineInstallation@a mi, Machine@a m
where mv(ma)> ev(si) + th(si) and
      lid(l)=locatedat(mi) and
      mi(mi)=mi(si) and
      m(mi)=m(m) and
      s(ma)=si(si) and 
      m(ma)=mi(si) and 
      uri(l)=jdbcuri(ma);

pc("newq4");

count(newq4());

