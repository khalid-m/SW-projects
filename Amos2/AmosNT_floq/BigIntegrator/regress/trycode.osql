create function foo6(integer i)->vector 
as begin 
   declare vector resvec;
   set resvec={};
   for each integer j where j=i
     begin
     set resvec=concat(resvec, {j});
     end;
   return resvec;
   end;

foo6(1);

foo6(iota(1,3));