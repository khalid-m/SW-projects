/* not right yet, why multicastreceive3 still receive single peer??? */
create function lowfun3(jdbc js)->Bag of object as
select multicastreceive3(peervec, "sql_myv2", "select bt,et,mv from measuresA where (mv-?)>? and m=? and s=?", argvec)
from vector metavec, vector formarg, vector peervec, vector argvec
where metavec=sql(js, "select LID,URI,SI,S_.MI,EV,TH,MACHINENIL_.M from LOCATION L_,SENSORINSTALLATION S_,MACHINE MACHINENIL_,MACHINEINSTALLATION MACHINEI_ where MACHINEI_.MI = S_.MI AND MACHINEI_.M = MACHINENIL_.M AND LOCATEDAT = LID") and formarg=formargfrombag(select groupby((select metavec[1], {metavec[4], metavec[5], metavec[3], metavec[2]}), #'vectorof')) and 
peervec=formarg[0] and argvec=formarg[1];

pc("lowfun3");

lowfun3(:a);

trace("multicastreceive");

count(lowfun3(:a));



