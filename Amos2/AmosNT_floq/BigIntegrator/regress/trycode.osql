/* low level call */
create function multicastreceive2(Vector uris, Charstring fn, Charstring query, 
					 Vector args)->Bag of Object
  as begin
     declare vector peervec, vector argvec;
     set peervec={};
     set argvec={};
     for each Charstring pe, Charstring logdburi
       where logdburi in vectorbag(uris) and pe in mappinguri_peer(logdburi) 
       begin
       set peervec=concat(peervec, {pe}); 
       set argvec=concat(argvec, {{logdburi, query, args}});
       end;
     return multicastreceive(peervec, fn, argvec);
     end;


