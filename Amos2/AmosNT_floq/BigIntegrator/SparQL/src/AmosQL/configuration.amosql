 *
 * Description: configuration to setup absorber, finalizer, absorbability 
                for a SparQL kind of Datasource.
 ****************************************************************************/

set_absorber('sparql', 'absorb-sparql');
set_finalizer('sparql', 'translate-sparql');

create_wrapper_absorbability('sparql', '<', 'sparql-translate-comparison');
create_wrapper_absorbability('sparql', '<=', 'sparql-translate-comparison');
create_wrapper_absorbability('sparql', '>', 'sparql-translate-comparison');
create_wrapper_absorbability('sparql', '>=', 'sparql-translate-comparison');
create_wrapper_absorbability('sparql', 'like', 'sparql-translate-like');

