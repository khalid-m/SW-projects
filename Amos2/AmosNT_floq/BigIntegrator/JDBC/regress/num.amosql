set :a = jdbc("nw", "com.mysql.jdbc.Driver");

set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

connect(:a, :dburl + "regress", "regress", "regress");

import_table(:a, 'EMPLOYEE');

import_table(:a, 'DEPARTMENT');



create function qn1()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e) > 15000 and 
     salary(e) + 1000  < 30000 and 
     like(first_name(e),'A*');

/*
pc("q1");

q1();
*/

create function qn2()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e) > 15000 and 
     salary(e) + salary(e) = 44000 and 
     like(first_name(e),'A*');

/*
pc("q2"); 

q2();
*/

/*More indirectly computed expression*/
create function qn3()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e) > 15000 and 
     salary(e) + 1000  + 12 < 30000 and 
     like(first_name(e),'A*');

/*
pc("q3"); 

q3();
*/

create function qn4()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e) > 15000 and 
     salary(e) < 30000  +  emp_no(e) and 
     like(first_name(e),'A*');

/*
pc('q4');

q4();
*/

/*With minus and plus together*/
create function qn5()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e) > 15000 and 
     salary(e) - 1000 + 89  < 30000 and 
     like(first_name(e),'A*');

/*
pc('q5');

q5();
*/

/*Combination of  minus, plus, times, and divide together*/
create function qn6()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e) > 15000 and 
     (salary(e) - 100)/2 + 50   < 30000 and
     like(first_name(e),'A*');

/*
pc('q6');

q6();
*/

/*Expression  'date() - duration' can be translated */
create function qn7()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where date() - 7 > hire_date(e); 

/*
pc('q7');

q7();
*/

create function qn8()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where date() + 7 > hire_date(e); 

/*
pc('q8');

q8();
*/

/*Translate IN */
create function qn9()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e
     where  first_name(e) in ("Robert","Bruce","Kim");

/*
pc("q9");

q9();
*/

create function qn10()->Bag of Charstring
  as select first_name(e)            
     from employee_nw e 
     where salary(e)*2 > 15000;

/*
pc("q10");

q10();
*/

/* numerical operation on multi-attributes */
create function qn11()->Bag of (Charstring, Charstring) 
  as select first_name(e), department(d) 
     from employee_nw e, department_nw d 
     where dept_no(e)=dept_no(d) and 
           salary(e) + 3000>60000 and 
           budget(d)-30000>50000;

/*
pc("q11");

q11();
*/

create function qn12(integer x)->Bag of Charstring
  as select first_name(e)
     from employee_nw e
     where salary(e) > 15000 and
     salary(e) < 30000 - x and
     like(first_name(e),'A*'); 


lisp;

(osql "load_lisp('num.lsp');")
:osql