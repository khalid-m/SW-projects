/* database size 15GB */
set :id="regressDS";
set :url="jdbc:microsoft:sqlserver://udblserver1;DatabaseName=bm15GB";
set :driver="com.microsoft.jdbc.sqlserver.SQLServerDriver";
set :dbname="bm15GB";
set :usern="udbl";
