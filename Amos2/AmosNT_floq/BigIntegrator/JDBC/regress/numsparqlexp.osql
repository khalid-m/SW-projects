/* create triple view from udblserver1 server */
/* database size 1GB */
set :id="regressDS";
set :url="jdbc:microsoft:sqlserver://udblserver1;DatabaseName=bm1GB";
set :driver="com.microsoft.jdbc.sqlserver.SQLServerDriver";
set :dbname="bm1GB";
set :usern="udbl";
set :passw="udbl";
set :catal="bm1GB"; 
set :schem="dbo";
set :upv="prod";
set :uriOfupv="http://user.it.uu.se/~udbl/prod";

/* database size 5GB */
