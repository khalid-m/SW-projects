lisp;

(defun extract-sql-strings (&optional fn)
  (let (name optpred)
    (cond ((eq fn nil)  (setq name  '*select*))
	  (t            (setq name fn)))
    (setq optpred (selectbody-optpred (getselectbody (getfunctionnamed name))))
    (if (conjunctionp optpred)
	(mapfilter #'sqlcallp (rest optpred) #'extract-sql-string)
      (if (sqlcallp optpred)
	  (list (extract-sql-string optpred))))))

(defun extract-sql-string (pred)
  (get-sql-string (getobject (fourth pred) 'sqlquery)))

(defun sqlcallp (pred)
  (equal (firstn 2 pred) '(call apply-pred-+)))

(checkequal "the JDBC wrapper primitives"
	    ((osql "select col from Charstring col, Charstring constraint
                    where (col,constraint) = primary_keys(:a, 'EMPLOYEE');") 
	     '(("emp_no")))
	    ((osql "select upper(col)
                    from Charstring tp, Charstring col
                    where (tp, col) = columns(:a, 'EMPLOYEE');")
             '(("EMP_NO") ("FIRST_NAME") ("LAST_NAME") ("PHONE_EXT") 
               ("HIRE_DATE") ("DEPT_NO") ("JOB_CODE") ("JOB_GRADE") 
               ("JOB_COUNTRY") ("SALARY")))
	    )

(Checkequal "Importing Table Employee (Twice)"
	    ((osql "import_table(:a, 'EMPLOYEE');")
	     `(( ,(gettypenamed 'employee_ibds))))
	    ((osql "import_table(:b, 'EMPLOYEE');")
	     `(( ,(gettypenamed 'employee_ibds2))))
	    ((osql "import_table(:a, 'DEPARTMENT');")
	     `(( ,(gettypenamed 'department_ibds))))
	    ((osql "import_table(:a, 'COUNTRY');")
	     `(( ,(gettypenamed 'country_ibds))))
	    )

(checkequal "creation of mapped objects from imported tables"
	    ((osql "count(select e from employee_ibds e);") '((42)))
	    ((osql "count(select d from department_ibds d);") '((21))))

(checkequal "simple queries"
	    ((osql "select first_name(e)            
                    from employee_ibds e 
                    where salary(e) > 15000 and salary(e) < 30000
                    and like(first_name(e),'A*');")
	     '(("Ann")))
	    ((osql "select first_name(e)            
                    from employee_ibds e 
                    where salary(e) > 15000 and salary(e) < 30000;")
	     '(("Ann") ("Kelly")))
	    )

(checkequal "Composite relation key"
	    ((osql "count(select country(c1),country(c2) 
                          from country_ibds c1, country_ibds c2 
                          where currency(c1)='dollar' and 
                                currency(c2)='dollar' and country(c1)='usa');")
	     '((4)))
	    )

(checkequal "Disjunctive SQL wrapper queries"
	    ((osql "select last_name(e) from employee_ibds e
where first_name(e)='Janet' or first_name(e)='Pete';")
	     '(("Baldwin") ("Fisher")))
	    ((let (*use-dnf*);; Disjunctive SQL generation
	       (sorttuples (osql "select last_name(e) from employee_ibds e
where first_name(e)='Janet' or first_name(e)='Pete';")))
	     '(("Baldwin") ("Fisher")))
	    )


:osql
create function test1(Real s)->Integer no
  as select emp_no(e) from employee_ibds e where salary(e)=s;

create function test2(Real s)->Integer no
  as select emp_no(e) from employee_ibds e where salary(e)= s + 0.0;

create function head(department_ibds d)-> department_ibds d1
  as select d1 where dept_no(d1)=head_dept(d);

select d into :d1 from department_ibds d where dept_no(d)="125";

lisp;

(checkequal "Rewite to SQL with computed bound variable"
            ((extract-sql-strings (getfunctionnamed 'real.test1->integer))
             '("select EMP_NO from EMPLOYEE where SALARY = ?"))
	    ((extract-sql-strings (getfunctionnamed 'real.test2->integer))
	     '("select EMP_NO from EMPLOYEE where SALARY = ?"))
)
 
(checkequal
 "join queries over different datasources (join condition tested in amos)"
 ((sorttuples (osql "select first_name(e), first_name(e2) 
                    from employee_ibds e, employee_ibds e2
                    where first_name(e) = first_name(e2) and 
                                          emp_no(e) != emp_no(e2);"))
  '(("Leslie" "Leslie") 
    ("Leslie" "Leslie")
    ("Roger" "Roger") 
    ("Roger" "Roger"))))

(checkequal 
 "join queries over one datasource (join condition tested @ source)"
 ((osql "sort(select first_name(e), first_name(e2) 
                    from employee_ibds e, employee_ibds e2
                    where first_name(e) = first_name(e2) and
                                          emp_no(e) != emp_no(e2));")
  '((#(#("Leslie" "Leslie") 
       #("Leslie" "Leslie") 
       #("Roger" "Roger") 
       #("Roger" "Roger")))))
 )

(osql "create function manager(employee_ibds employee)-> employee_ibds 
       as select manager
       from   employee_ibds manager, department_ibds d
       where  dept_no(employee) = dept_no(d) and
	        emp_no(manager) = mngr_no(d);")

(checkequal "execution of advanced queries (1)"
	    ((osql "select first_name(manager(e)) 
                    from employee_ibds e
                    where salary(manager(e))>salary(e);")
	     '(("Oliver H.") ("Walter") ("Chris") ("Roger") ("Katherine") 
               ("Kevin") ("Phil") ("Robert") ("Takashi") ("Chris") 
               ("Katherine") ("Mary S.") ("Katherine") ("Randy") ("Phil")))
	    )

(checkequal "execution of advanced queries (2)"
	    ((osql "select first_name(manager(e)) 
          from employee_ibds e
          where salary(e)>salary(manager(e));")
	     '(("K. J.") ("Katherine") ("Roger") ("Janet")))
	    )

(checkequal 
 "translator"
 ((extract-sql-strings) 
  '("select E_1.DEPT_NO,E_1.SALARY,MNGR_NO,E_2.FIRST_NAME,E_2.SALARY from EMPLOYEE E_2,EMPLOYEE E_1,DEPARTMENT D_ where D_.DEPT_NO = E_1.DEPT_NO and E_2.EMP_NO = MNGR_NO and E_1.SALARY > E_2.SALARY"))
 )

(checkequal "transitive closure (recursive cursors)"
	    ((osql "department(:d1);") '(("Field Office: Italy")))
	    ((osql "sort(department(cast(tclose(functionnamed('HEAD'),:d1) 
                               as department_ibds)));")
	     '((#("Corporate Headquarters" "European Headquarters" 
		  "Field Office: Italy" "Sales and Marketing"))))
	    )

(checkequal "execution of truth-value queries"
	    ((osql "select first_name(e)
          from employee_ibds e
          where first_name(e)='Janet';")
	     '(("Janet"))))
;   (osql "select first_name(e), first_name(e2)
;          from employee_ibds e, employee_ibds e2
;          where first_name(e)=first_name(e2);")))
:osql

select e into :roberto from employee_ibds e where first_name(e)='Roberto';
select e into :michael from employee_ibds e where first_name(e)='Michael';
select first_name(:roberto), first_name(:michael);
lisp;


(checkequal "that cross-products don't get pushed"
	    ((extract-sql-strings)
	     '("select FIRST_NAME from EMPLOYEE where EMP_NO = ?" 
	       "select FIRST_NAME from EMPLOYEE where EMP_NO = ?"))
	    ((length (extract-sql-strings)) 2))
   
