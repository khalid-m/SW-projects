:osql	    

create function SDEF() -> Bag of (Charstring, Charstring)
  as select country(cr), currency(cr) from COUNTRY_IBDS cr;

lisp;

(checkequal "optional() over sql views"
	    ((osql "
select x from Charstring x, Charstring y 
where (x,'dollar') in SDEF() and 
      optional((y,x) in SDEF());")
	     '(("usa") ("australia") ("hong kong") ("fiji")))
	    )

:osql
