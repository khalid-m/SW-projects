set :a = jdbc("ibds", "com.mysql.jdbc.Driver");
set :b = jdbc("ibds2", "com.mysql.jdbc.Driver");
set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

connect(:a, :dburl + "regress", "regress", "regress");
connect(:b, :dburl + "regress", "regress", "regress");

count(read_sql(:a, "mysqldrop.sql"));
count(read_sql(:a, "regress.sql"));

< 'regress1.amosql';
< 'testConstructor.amosql';
< 'regress2.amosql';
< 'stress.amosql';

disconnect(:a); 
disconnect(:b);

load_amosql('num.amosql');

quit;
