/* multicast_receive will be factor 4 times faster than call sql to every 
   datasource in sequence (like in multisql) in a 4 processors machine (my 
   machine (according to Tore) */



/* maps logdbid to jdbc object  */
create function logdbid_js(Object)->Bag of JDBC as stored;


create function map_logdbid_js(Bag of Jdbc js)->Boolean
 as 
  begin 
      declare Integer i;
      set i=1;
      for each Jdbc jsobj where jsobj in js
        begin 
           add logdbid_js(i)=jsobj;
           set i=i+1;
        end;
    end;


/* create n jdbc connection objects */
create function jdbcSet(Number n, Charstring driver)
                       -> Bag of Jdbc
  as jdbc("C"+iota(1,n), driver);


/* create n different log database names */
/*
create function dbnames(Number n, Charstring prefix)->Bag of Charstring
  as prefix+iota(1,n);
*/

/* connect each jdbc object with a data source with the same db name */ 
/*
create function openJdbcSet(Bag of Jdbc js,
                            Charstring dburl, Charstring db,
                            Charstring user, Charstring pw)
                          -> Bag of Jdbc
  as for each Jdbc j where j in js 
     return connect(j, dburl+db, user, pw);
*/

/* connect each jdbc object with a data source with different db name */
create function openJdbcSet(Bag of Jdbc js,
                            Charstring dburl, Bag of Charstring dbs,
                            Charstring user, Charstring pw)
                          -> Bag of Jdbc
  as for each Jdbc j, Charstring db 
     where j in js and db in dbs 
     begin
         return connect(j, dburl+db, user, pw);
     end;


/* disconnect given database connections */
create function closeJdbcSet(Bag of Jdbc js) -> Bag of Jdbc
  as for each Jdbc j where j in js 
     begin disconnect(j);
           return j;
     end;


/* sends the same query to set of data sources js */
/* multisql takes bag of vector, (jdbc object, query, param) */
/* this function is not right because all jdbc take the same query */
/*
create function multiSQL(Bag of Jdbc js, Charstring query, Vector params)
                       -> Bag of Vector
  as sql(in(js), query, params);
*/

/* multi_sql_union is the same as sql */
/* takes logdbid, query, and parameters */ 
create function multi_sql_union(Object logdbid, Charstring query, 
                                Vector params) -> Vector
  as select sql(logdbid_js(logdbid), query, params);



/* set url of meta-database */ 
set :dburl = "jdbc:mysql://localhost:3306/";

trace("connect");

/* set up connection to access meta database at local mysql */
set :a = jdbc("a", "com.mysql.jdbc.Driver");

connect(:a, :dburl + "metadb", "regress", "regress");

/* set up two jdbc connection objects to logDBs at SQLserver*/
/* one logDB is located at udblserver1 and another resides at udbl-station */
set :js = jdbcSet(2,"com.microsoft.jdbc.sqlserver.SQLServerDriver");

/* connect each jdbc object with a database connection */
/* openJdbcSet(:js,:dburl,dbnames(2, "logdb"), "regress", "regress"); */
set :logdb1url = "jdbc:microsoft:sqlserver://udblserver1.it.uu.se;DatabaseName=bm1GB";

set :logdb2url = "jdbc:microsoft:sqlserver://udblserver3;DatabaseName=bm1GB";

connect(first(:js), :logdb1url, "udbl", "udbl");

connect(last(:js), :logdb2url, "udbl", "udbl");

/* suppose one site has one log database */
/* site 1 corresponse to Uppsala log database */
map_logdbid_js(:js);	


/* testing multi_sql_union */
count(multi_sql_union(1, "select * from measuresA where mv>359", {}));

count(multi_sql_union(2, "select * from measuresA where mv>359", {}));

< 'patch.osql';



/* import source predicate SENSORINSTALLATION, SITE, INSTALLEDEQUIPMENT, 
   EQUIPMENTMODEL, SENSORMODEL from database storing meta data */
import_table(:a, 'SENSORINSTALLATION');

import_table(:a, 'SITE');

import_table(:a, 'INSTALLEDEQUIPMENT');

import_table(:a, 'EQUIPMENTMODEL');

import_table(:a, 'SENSORMODEL');

/* import source predicate Measurement from one logdb */
import_table2(first(:js),'MEASURESA',:js);

apropos("measuresa");


/*Q: new test query in new set up  */
create function newq3()->(Integer, charstring, Integer, Number) as
select ie(si), ename(e), logdbid(s), mv(m)
from SENSORINSTALLATION@A si, SITE@A s, MEASURESA m, 
     INSTALLEDEQUIPMENT@A ie, EQUIPMENTMODEL@A e
where location(s)='Uppsala' and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      s(m)=si(si) and
      logdbid(m)=logdbid(s);

pc("newq3");

count(newq3());

