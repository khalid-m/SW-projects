/* queries */
/*Q1: What are the sites for equipment named PUMP? */
create function q1()->charstring as
select location(s)
from SITE@A s, EQUIPMENTMODEL@A e, INSTALLEDEQUIPMENT@A ie
where ename(e)='MoriSeiki 5000' and e(ie)=e(e) and site(s)=site(ie);


/*Q2: What equipment is there in Uppsala? */
create function q2()->integer as
select e(ie)
from INSTALLEDEQUIPMENT@A ie, SITE@A s
where location(s)='Uppsala' and site(ie)=site(s);



/*Q3: What equipment in Uppsala has failed (mv-ev>th) during the last month? */
create function q3()->(Integer, charstring, Integer, Number) as
select ie(si), ename(e), logdbid(s), mv(m)
from SENSORINSTALLATION@A si, SITE@A s, MEASURESA m, 
     INSTALLEDEQUIPMENT@A ie, EQUIPMENTMODEL@A e
where location(s)='Uppsala' and 
      Real(now())-30*24*60*60<ts(m) and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      logdbid(m)=logdbid(s);


/*Q4: What sensors on what equipment in Uppsala has almost indicated failure 
      (mv-ev>0.75*th) during the last month? */
create function q4()->(Integer, charstring) as
select ie(si), ename(e)
from SENSORINSTALLATION@A si, SITE@A s, MEASUREMENT m, 
     INSTALLEDEQUIPMENT@A ie, EQUIPMENTMODEL@A e
where location(s)='Uppsala' and 
      Real(now())-30*24*60*60<ts(m) and
      mv(m)-ev(si)>0.75*th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      logdbid(m)=logdbid(s);


/*Q5: What sensors on what equipment and location indicated failure (mv-ev>th) 
      during the last month? */
create function q5()->(Integer, Number, Charstring, Integer) as
select ie(si), mv(m),location(s), logdbid(s)
from SENSORINSTALLATION@A si, SITE@A s, MEASUREMENT m, 
     INSTALLEDEQUIPMENT@A ie, EQUIPMENTMODEL@A e
where Real(now())-30*24*60*60<ts(m) and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      logdbid(m)=logdbid(s);


/*Q6: What sensors of kind TEMP indicated failure on different machines in Uppsala within less than 5 minutes. */
create function q6()->Integer as
select si(si)
from SENSORINSTALLATION@A si, SITE@A s, MEASUREMENT m, 
     INSTALLEDEQUIPMENT@A ie, EQUIPMENTMODEL@A e, SENSORMODEL@A sm
where location(s)='Uppsala' and
      sname(sm)='TEMP' and
      Real(now())-5*60<ts(m) and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      sm(si)=sm(sm) and
      logdbid(m)=logdbid(s);



/*Q7: On what equipment in Uppsala did sensor TEMP and POWER fail within one 
      minute? */
/* problem with or in amosql */
create function q7()->(Integer, charstring) as
select ie(si), ename(e)
from SENSORINSTALLATION@A si, SITE@A s, MEASUREMENT m, 
     INSTALLEDEQUIPMENT@A ie, EQUIPMENTMODEL@A e, SENSORMODEL@A sm
where location(s)='Uppsala' and
      (sname(sm)='TEMP' or
      sname(sm)='POWER') and
      Real(now())-60<ts(m) and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      sm(si)=sm(sm) and
      logdbid(m)=logdbid(s);


/*Q8: On what equipment and when was sensor TEMP higher than its maxv */
create function q8()->(Integer, number) as
select ie(si), ts(m)
from SENSORINSTALLATION@A si, SENSORMODEL@A sm, MEASUREMENT m 
where sname(sm)='TEMP' and
      mv(m)>maxv(sm) and
      sm(si)=sm(sm) and
      si(m)=si(si);


/* low level interface function call corresponding to q3 */

/* multi_sql_union should have something to do with parallelism */
/*
create function multi_sql_union2(Bag of vector (JDBC jdbc, Charstring query, Vector params))->Bag
  as set tempds
     for each js in jdbc
      /* start a peer */
      begin 
       sql(js, query, param);
*/

in(multi_sql_union({first(:js), "SELECT * FROM MEASUREMENT M", {}}));

/* using logdbid_js */
select in(multi_sql_union(qrb))
from Bag of vector qrb
where qrb = (select {logdbid_js(qr[4]),
                     "SELECT * FROM MEASUREMENT M 
                      WHERE M.MV - ?>? AND M.SI = ? AND M.LOGDBID=?",
                    {qr[2], qr[3], qr[1], qr[4]}}    
                 from Vector qr
                where qr = 
                  sql(:a, "SELECT E.ENAME, SI.SI, SI.EV, SI.TH, S.LOGDBID
                           FROM SENSORINSTALLATION SI, SITE S, 
                                INSTALLEDEQUIPMENT IE,
                                EQUIPMENTMODEL E
                           WHERE S.LOCATION = 'Uppsala' AND
                                 S.SITE = IE.SITE AND
                                 IE.IE=SI.IE AND
                                 IE.E=E.E"));

/* just to check the result of the previous query */
set :qrb = (select {logdbid_js(qr[4]),
                     "SELECT * FROM MEASUREMENT M 
                      WHERE M.MV - ?>? AND M.SI = ? AND M.LOGDBID=?",
                    {qr[2], qr[3], qr[1], qr[4]}}    
                 from Vector qr
                where qr = 
                  sql(:a, "SELECT E.ENAME, SI.SI, SI.EV, SI.TH, S.LOGDBID
                           FROM SENSORINSTALLATION SI, SITE S, 
                                INSTALLEDEQUIPMENT IE,
                                EQUIPMENTMODEL E
                           WHERE S.LOCATION = 'Uppsala' AND
                                 S.SITE = IE.SITE AND
                                 IE.IE=SI.IE AND
                                 IE.E=E.E"));

/* with logdbid_js as seperate predicate */
create function test2()->charstring as
select qr[0] 
from Vector qr, jdbc js 
where qr = 
sql(#[OID 1517 "A"], "SELECT E.ENAME, SI.SI, SI.EV, SI.TH, S.LOGDBID
          FROM SENSORINSTALLATION SI, SITE S, 
               INSTALLEDEQUIPMENT IE,
               EQUIPMENTMODEL E
          WHERE S.LOCATION = 'Uppsala' AND
                S.SITE = IE.SITE AND
                IE.IE=SI.IE AND
                IE.E=E.E") and
                js = logdbid_js(qr[4]) and   
some(multisql(js,"SELECT * FROM MEASUREMENT M WHERE M.MV - ?>? 
                                AND M.SI = ? AND M.LOGDBID=?",
                     {qr[2], qr[3], qr[1], qr[4]}));


/* low level interface function call send the same query to all log 
   databases */
select qr[0] 
from Vector qr
where qr = 
sql(:a, "SELECT E.ENAME, SI.SI, SI.EV, SI.TH, S.LOGDBID
          FROM SENSORINSTALLATION SI, SITE S, 
               INSTALLEDEQUIPMENT IE,
               EQUIPMENTMODEL E
          WHERE S.LOCATION = 'Uppsala' AND
                S.SITE = IE.SITE AND
                IE.IE=SI.IE AND
                IE.E=E.E") and
some(multisql(:js,"SELECT * FROM MEASUREMENT M WHERE M.MV - ?>? AND
                             ?- 2592000<M.TS AND
                              M.SI = ? AND M.LOGDBID=?",
                     {qr[2], qr[3], real(now()), qr[1], qr[4]}));









/* start peers */
/* open 2 connections */
javaamos -n ns

start /min javaamos -s s1

start /min javaamos -s s2

javaamos

/* To be sure peer started.*/
sleep(1); 
register("me");





/* low level interface function parallel calling querying multi databases 
   by multicastreceive */
/* :a is a jdbc object */
set :a= call_function('s1','jdbc', {"ibds","com.mysql.jdbc.Driver"}, 10)[0];

set :b= call_function('s2','jdbc', {"ibds2","com.mysql.jdbc.Driver"}, 10)[0];

call_function('s1','connect', {:a,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 10);

call_function('s2','connect', {:b,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 10);

count(call_function('s1','sql', {:a,"select * from measurement", {}}, 100));

count(call_function('s2','sql', {:b,"select * from measurement", {}}, 100));

count(multicastreceive({'s1','s2'}, 'sql', {{:a,"select * from measurement",{}},{:b,"select * from measurement",{}}}));


/* multisql vs multicastreceive */
count(multisql(:js, "select * from measurement", {}));

/* need to generate a call with multicastreceive instead of multisql */
count(multicastreceive({'s1','s2'}, 'sql', {{:a,"select * from measurement",{}},{:b,"select * from measurement",{}}}));



/* close jdbc connection set */
closeJdbcSet(:js);

call_function('s1','disconnect',{:a},10); 
call_function('s2','disconnect',{:b},10);


kill_the_federation();







/* open 10 connections */
javaamos -n ns

start /min javaamos -s s1

start /min javaamos -s s2

start /min javaamos -s s3

start /min javaamos -s s4

start /min javaamos -s s5

start /min javaamos -s s6

start /min javaamos -s s7

start /min javaamos -s s8

start /min javaamos -s s9

start /min javaamos -s s10

javaamos

sleep(1); 
register("me");

/* running 10 sql in sequence in a Amos peer */

create function jdbcSet(Number n, Charstring driver)
                       -> Bag of Jdbc
  as jdbc("C"+iota(1,n), driver);

create function openJdbcSet(Bag of Jdbc js,
                            Charstring dburl, Charstring db,
                            Charstring user, Charstring pw)
                          -> Bag of Jdbc
  as for each Jdbc j where j in js 
     return connect(j, dburl+db, user, pw);

create function closeJdbcSet(Bag of Jdbc js) -> Bag of Jdbc
  as for each Jdbc j where j in js 
     begin disconnect(j);
           return j;
     end;

create function multiSQL(Bag of Jdbc js, Charstring query, Vector params)
                       -> Bag of Vector
  as sql(in(js), query, params);

set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

trace("connect");

set :js = jdbcSet(10,"com.mysql.jdbc.Driver");

openJdbcSet(:js,:dburl,"regress", "regress", "regress");

/* start to execute */
count(multisql(:js, "select * from measured", {}));

multisql(:js, "select * from measured", {});

select qr[0] 
from Vector qr
where qr = 
sql(first(:js), "SELECT E.ENAME, SI.SI, SI.EV, SI.TH, S.LOGDBID
          FROM SENSORINSTALLATION SI, SITE S, 
               INSTALLEDEQUIPMENT IE,
               EQUIPMENTMODEL E
          WHERE S.LOCATION = 'Uppsala' AND
                S.SITE = IE.SITE AND
                IE.IE=SI.IE AND
                IE.E=E.E") and
some(multisql(:js,"SELECT * FROM MEASURED M WHERE M.MV - ?>? AND
                             ?- 2592000<M.TS AND
                              M.SI = ? AND M.LOGDBID=?",
                     {qr[2], qr[3], real(now()), qr[1], qr[4]}));

multicastreceive({first(:js), first(:js)}, 'sql', {{first(:js),"select * from measured",{}},{first(:js),"select * from measured",{}}});


/* running in parellel in 10 Amos peers */

set :a= call_function('s1','jdbc', {"ibds","com.mysql.jdbc.Driver"}, 10)[0];

set :b= call_function('s2','jdbc', {"ibds2","com.mysql.jdbc.Driver"}, 10)[0];

set :c= call_function('s3','jdbc', {"ibds3","com.mysql.jdbc.Driver"}, 10)[0];

set :d= call_function('s4','jdbc', {"ibds4","com.mysql.jdbc.Driver"}, 10)[0];

set :e= call_function('s5','jdbc', {"ibds5","com.mysql.jdbc.Driver"}, 10)[0];

set :f= call_function('s6','jdbc', {"ibds6","com.mysql.jdbc.Driver"}, 10)[0];

set :g= call_function('s7','jdbc', {"ibds7","com.mysql.jdbc.Driver"}, 10)[0];

set :h= call_function('s8','jdbc', {"ibds8","com.mysql.jdbc.Driver"}, 10)[0];

set :i= call_function('s9','jdbc', {"ibds9","com.mysql.jdbc.Driver"}, 10)[0];

set :j= call_function('s10','jdbc', {"ibds10","com.mysql.jdbc.Driver"}, 10)[0];

call_function('s1','connect', {:a,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s2','connect', {:b,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s3','connect', {:c,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s4','connect', {:d,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s5','connect', {:e,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s6','connect', {:f,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s7','connect', {:g,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s8','connect', {:h,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s9','connect', {:i,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

call_function('s10','connect', {:j,"jdbc:mysql://localhost:3306/regress", "regress", "regress"}, 100);

count(call_function('s1','sql', {:a,"select * from measured", {}}, 100));

count(call_function('s2','sql', {:b,"select * from measured", {}}, 100));

count(multicastreceive({'s1','s2','s3','s4','s5','s6','s7','s8','s9','s10'}, 'sql', {{:a,"select * from measured",{}},{:b,"select * from measured",{}},
	{:c,"select * from measured",{}},{:d,"select * from measured",{}},
	{:e,"select * from measured",{}},{:f,"select * from measured",{}},
	{:g,"select * from measured",{}},{:h,"select * from measured",{}},
	{:i,"select * from measured",{}},{:j,"select * from measured",{}}}));


/* multisql vs multicastreceive */
count(multisql(:js, "select * from measured", {}));

count(multicastreceive({'s1','s2','s3','s4','s5','s6','s7','s8','s9','s10'}, 'sql', {{:a,"select * from measured",{}},{:b,"select * from measured",{}},
	{:c,"select * from measured",{}},{:d,"select * from measured",{}},
	{:e,"select * from measured",{}},{:f,"select * from measured",{}},
	{:g,"select * from measured",{}},{:h,"select * from measured",{}},
	{:i,"select * from measured",{}},{:j,"select * from measured",{}}}));



/* close jdbc connection set */
closeJdbcSet(:js);  /*local*/


call_function('s1','disconnect',{:a},10); 
call_function('s2','disconnect',{:b},10);
call_function('s3','disconnect',{:c},10);
call_function('s4','disconnect',{:d},10);
call_function('s5','disconnect',{:e},10);
call_function('s6','disconnect',{:f},10);
call_function('s7','disconnect',{:g},10);
call_function('s8','disconnect',{:h},10);
call_function('s9','disconnect',{:i},10);
call_function('s10','disconnect',{:j},10);



kill_the_federation();



/* running 20 sql in sequence in a Amos peer */
javaamos -n ns

start /min javaamos -s s1

start /min javaamos -s s2

start /min javaamos -s s3

start /min javaamos -s s4

start /min javaamos -s s5

start /min javaamos -s s6

start /min javaamos -s s7

start /min javaamos -s s8

start /min javaamos -s s9

start /min javaamos -s s10

start /min javaamos -s s11

start /min javaamos -s s12

start /min javaamos -s s13

start /min javaamos -s s14

start /min javaamos -s s15

start /min javaamos -s s16

start /min javaamos -s s17

start /min javaamos -s s18

start /min javaamos -s s19

start /min javaamos -s s20

javaamos

sleep(1); 
register("me");


create function jdbcSet(Number n, Charstring driver)
                       -> Bag of Jdbc
  as jdbc("C"+iota(1,n), driver);

create function openJdbcSet(Bag of Jdbc js,
                            Charstring dburl, Charstring db,
                            Charstring user, Charstring pw)
                          -> Bag of Jdbc
  as for each Jdbc j where j in js 
     return connect(j, dburl+db, user, pw);

create function closeJdbcSet(Bag of Jdbc js) -> Bag of Jdbc
  as for each Jdbc j where j in js 
     begin disconnect(j);
           return j;
     end;

create function multiSQL(Bag of Jdbc js, Charstring query, Vector params)
                       -> Bag of Vector
  as sql(in(js), query, params);

set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

trace("connect");

set :js = jdbcSet(20,"com.mysql.jdbc.Driver");

openJdbcSet(:js,:dburl,"regress", "regress", "regress");



/* running in parellel in 20 Amos peers */

set :a= call_function('s1','jdbc', {"ibds","com.mysql.jdbc.Driver"}, 10)[0];

set :b= call_function('s2','jdbc', {"ibds2","com.mysql.jdbc.Driver"}, 10)[0];

