register("me");


create function jdbcSet(Number n, Charstring driver)
                       -> Bag of Jdbc
  as jdbc("C"+iota(1,n), driver);

create function openJdbcSet(Bag of Jdbc js,
                            Charstring dburl, Charstring db,
                            Charstring user, Charstring pw)
                          -> Bag of Jdbc
  as for each Jdbc j where j in js 
     return connect(j, dburl+db, user, pw);

create function closeJdbcSet(Bag of Jdbc js) -> Bag of Jdbc
  as for each Jdbc j where j in js 
     begin disconnect(j);
           return j;
     end;

create function multiSQL(Bag of Jdbc js, Charstring query, Vector params)
                       -> Bag of Vector
  as sql(in(js), query, params);

set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

trace("connect");

set :js = jdbcSet(30,"com.mysql.jdbc.Driver");

openJdbcSet(:js,:dburl,"regress", "regress", "regress");



