set :a = jdbc("ibds", "interbase.interclient.Driver");
set :b = jdbc("ibds2", "interbase.interclient.Driver");
set :dbdir = "jdbc:interbase://localhost/"+pwd()+"/";

connect(:a,:dbdir+"TEST.GDB", "SYSDBA", "masterkey");
connect(:b,:dbdir+"TEST.GDB", "SYSDBA", "masterkey");

< 'regress1.amosql';
< 'testConstructor.amosql';
< 'regress2.amosql';
< 'stress.amosql';

disconnect(:a); 
disconnect(:b);

quit;
