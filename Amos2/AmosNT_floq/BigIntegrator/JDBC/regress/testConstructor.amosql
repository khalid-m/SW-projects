/* You cannot have constructors if you do not import the table as updateable. */

import_table(:a,'PERSON3', true);
import_table(:a,'JOBB');
import_table(:a,'MARRIED',true);

create person3_ibds(ssn, first_name) instances :Herman(77, 'Herman');
create person3_ibds(ssn) instances :Torsten(78, 'Torsten');
create married_ibds (ssn, cid, score) instances (1,1,1);

lisp;
(checkequal "Transparent constructors"
  ((osql "sql(:a,'select * from PERSON3');")
   '((#(77 "Herman")) (#(78 NIL))))
  ((osql "sql(:a,'select ssn from PERSON3');")
   '((#(77)) (#(78))))
  ((catch-error (osql "create person3_ibds instances :Urban;")) 
   '(:ERRCOND (-1 "Property must be set: SSN" NIL)))
  ((osql "select ssn(m), cid(m), score(m) from married_ibds m;")
   '((1 1 1))))

(checkequal "Setting variables from constructors"
  ((osql "first_name(:Herman);")
   '(("Herman"))))

(checkequal "Forbidding constructors."
  ((catch-error (osql "create jobb_ibds instances :jobbet;"))
   '(:ERRCOND (-1 "This mapped type is read-only" NIL))))

:osql
