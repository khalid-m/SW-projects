/* experiment queries */

/* finds when and on what machines, the pressure reading of class A was higher
   than a threshold from its expected value (Thanh's query 1) */
/*
set :sparql1 = 
"select ?m ?bt ?et
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresa <http://user.it.uu.se/~udbl/prod#measuresA/m> ?m.
         ?measuresa <http://user.it.uu.se/~udbl/prod#measuresA/bt> ?bt.
         ?measuresa <http://user.it.uu.se/~udbl/prod#measuresA/et> ?et.
         ?measuresa <http://user.it.uu.se/~udbl/prod#measuresA/s> ?s.
         ?measuresa <http://user.it.uu.se/~udbl/prod#measuresA/mv> ?mv.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (?mv > (?ev + 343)).          
                   }";
*/

set :sparql1 =
"select ?m ?bt ?et
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA_of_sensor> ?sensor .
         ?sensor    <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/m> ?m.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/bt> ?bt.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/et> ?et.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/mv> ?mv.
         FILTER (?mv > (?ev + 343)). } ";


eval("create function sparql1()->(Literal, Literal, Literal) as " + sparql_translate(:sparql1, true));

pc("sparql1");

count(sparql1());



/* When was the pressure readings of class B almost indicating a failured
   for machines of model 'E_1' (similar to Thanh's query 5) */
set :sparql2 = 
"select ?m ?bt ?et
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/m> ?m.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/bt> ?bt.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/et> ?et.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/s> ?s.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/mv> ?mv.
         ?machine <http://user.it.uu.se/~udbl/prod#machine/m> ?m.
         ?machine <http://user.it.uu.se/~udbl/prod#machine/mm> 'E_1'.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (?mv > (?ev + 0.75*5)).          
                   }";


