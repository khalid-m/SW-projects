	 bind ((?mv-?ev) as ?temp1). 
	 bind (?temp1/?ev as ?temp2).	
         FILTER (abs(?temp2) > 0.7).          
                   }";
*/

set :sparql3_10_27 =
"select ?m ?bt ?et
from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB_of_sensor> ?sensor.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv.
         ?sensor    <http://user.it.uu.se/~udbl/prod#sensor/m>     ?m.
         ?sensor    <http://user.it.uu.se/~udbl/prod#sensor/ev>    ?ev.
         bind ((?mv-?ev) as ?temp).
         FILTER (abs(?temp) > 5).} " ;

eval("create function sparql3_10_27()->(Literal, Literal, Literal) as " + sparql_translate(:sparql3_10_27, true));

pc("sparql3_10_27");

count(sparql3_10_27());

/* when and for which machine identifiers did the pressure reading of class
   B deviate more than a threshold from its expected value (Thanh's query 2) */
set :sparql3 = 
"select ?m ?bt ?et
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/m> ?m.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/s> ?s.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (abs(?mv-?ev) > 19.9).          
                   }";

eval("create function sparql3()->(Literal, Literal, Literal) as " + sparql_translate(:sparql3, true));

pc("sparql3");

count(sparql3());


set :sparql3v2 = 
"select ?m ?temp
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/m> ?m.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/s> ?s.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv.
	 bind (greater(?bt, ?et) as ?temp).
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (abs(?mv-?ev) > 19.9).          
                   }";



create function rdf:greater(literal x, literal y)->literal as 
greater(cast(x as number), cast(y as number));

eval("create function sparql3v2()->(Literal, Literal) as " + sparql_translate(:sparql3v2, true));

pc("sparql3v2");

count(sparql3v2());



set :sparql3v = 
"select ?m ?temp
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/m> ?m.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/s> ?s.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv.
	 bind (tduration(?bt, ?et) as ?temp).
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (abs(?mv-?ev) > 19.9).          
                   }";



create function rdf:tduration(literal x, literal y)->literal as 
foreign 'tdiff--+';

lisp;

(defun tdiff--+ (fn x y res)
  (osql-result x y (- y x)))

:osql

create_wrapper_absorbability('relational','rdf:tduration');

sqloperator('rdf:tduration', 'dbo.tduration', false, true, false);


eval("create function sparql3v3()->(Literal, Literal) as " + sparql_translate(:sparql3v3, true));

pc("sparql3v3");

count(sparql3v3());









/*************************** old stuff *************************************/
/* --------- eq1 = Q2 in Thanh's paper --------- */
set :eq1 = 
"select ?m ?bt ?et
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/m> ?m.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/s> ?s.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (abs(?mv-?ev) > 19.9).          
                   }";

eval("create function eq1()->(Literal, Literal, Literal) as " + sparql_translate(:eq1, true));

pc("eq1");


/* eq1 amosql */
create function eq1amos()->(literal, literal, literal) as
select m, bt, et
  from Number ev, Literal sensor, Number mv, Literal s, Literal measuresb, Literal et, Literal bt, Literal m
 where (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/m'), m) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/bt'), bt) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/et'), et) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/s'), s) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/mv'), mv) in prod()
   and (sensor, URI('http://user.it.uu.se/~udbl/prod#sensor/m'), m) in prod()
   and (sensor, URI('http://user.it.uu.se/~udbl/prod#sensor/s'), s) in prod()
   and (sensor, URI('http://user.it.uu.se/~udbl/prod#sensor/ev'), ev) in prod()
   and abs(minus(mv, ev))>19.9;

pc("eq1amos");

count(eq1amos());




/* ---------eq2 = Q5 in Thanh's paper -----------*/
/* in operator is not supported */
set :eq2 = 
"select ?m ?bt ?et
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/m> ?m.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/s> ?s.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv.
         ?machine <http://user.it.uu.se/~udbl/prod#machine/m> ?m.
         ?machine <http://user.it.uu.se/~udbl/prod#machine/mm> ?mm.
         FILTER (?mm in ('M_1' , 'M_2', 'M_3')). 
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/s> ?s.
         ?sensor <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev.
         FILTER (abs(?mv-?ev) > 300).          
                   }";

eval("create function eq2()->(Literal, Literal, Literal) as " + sparql_translate(:eq2, true));

pc("eq2");



/* eq2 amosql */
create function eq2amos()->(literal, literal, literal) as
select m, bt, et
  from Number ev, Literal sensor, Number mv, Literal s, Literal measuresb, Literal et, Literal bt, Literal m, Literal machine, Literal mm
 where (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/m'), m) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/bt'), bt) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/et'), et) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/s'), s) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/mv'), mv) in prod()
   and (machine, URI('http://user.it.uu.se/~udbl/prod#machine/m'), m) in prod()
   and (machine, URI('http://user.it.uu.se/~udbl/prod#machine/mm'), mm) in prod()
   and (sensor, URI('http://user.it.uu.se/~udbl/prod#sensor/m'), m) in prod()
   and (sensor, URI('http://user.it.uu.se/~udbl/prod#sensor/s'), s) in prod()
   and (sensor, URI('http://user.it.uu.se/~udbl/prod#sensor/ev'), ev) in prod()
   and abs(minus(mv, ev))>15
   and mm in ('E_1','E_10','E_100');


pc("eq2amos");


/* ---------query 3 = Q7 in Thanh's paper -----------*/
set :eq3 = 
"select ?m 
 from <http://user.it.uu.se/~udbl/prod>
 where { ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/bt> ?bt1.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/et> ?et1.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/m> ?m.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/s> ?sa.
         ?measuresA <http://user.it.uu.se/~udbl/prod#measuresA/mv> ?mv1.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/m> ?m.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/bt> ?bt2.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/et> ?et2.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/s> ?sb.
         ?measuresB <http://user.it.uu.se/~udbl/prod#measuresB/mv> ?mv2.
         FILTER (?bt1 <= ?et2).
         FILTER (?et1 >= ?bt2). 
         ?sensora <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensora <http://user.it.uu.se/~udbl/prod#sensor/s> ?sa.
         ?sensora <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev1.
         ?sensorb <http://user.it.uu.se/~udbl/prod#sensor/m> ?m.
         ?sensorb <http://user.it.uu.se/~udbl/prod#sensor/s> ?sb.
         ?sensorb <http://user.it.uu.se/~udbl/prod#sensor/ev> ?ev2.
        FILTER (((?mv1-?ev1)+abs(?mv2-?ev2))/2 > 300).          
                   }";

eval("create function eq3()->(Literal, Literal, Literal) as " + sparql_translate(:eq3, true));

pc("eq3");



/* eq3 amosql */
/* don't use this query, this query runs too long time */
create function eq3amos()->(literal, literal, literal) as
select m, greater(bt1, bt2), lesser(et1, et2)
  from Number ev2, Literal sensorb, Number ev1, Literal sensora, Number mv2, Literal sb, Number et2, Number bt2, Literal measuresb, Number mv1, Literal sa, Number et1, Number bt1, Literal measuresa, Literal m
 where (measuresa, URI('http://user.it.uu.se/~udbl/prod#measuresA/bt'), bt1) in prod()
   and (measuresa, URI('http://user.it.uu.se/~udbl/prod#measuresA/et'), et1) in prod()
   and (measuresa, URI('http://user.it.uu.se/~udbl/prod#measuresA/m'), m) in prod()
   and (measuresa, URI('http://user.it.uu.se/~udbl/prod#measuresA/s'), sa) in prod()
   and (measuresa, URI('http://user.it.uu.se/~udbl/prod#measuresA/mv'), mv1) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/m'), m) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/bt'), bt2) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/et'), et2) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/s'), sb) in prod()
   and (measuresb, URI('http://user.it.uu.se/~udbl/prod#measuresB/mv'), mv2) in prod()
   and (sensora, URI('http://user.it.uu.se/~udbl/prod#sensor/m'), m) in prod()
   and (sensora, URI('http://user.it.uu.se/~udbl/prod#sensor/s'), sa) in prod()
   and (sensora, URI('http://user.it.uu.se/~udbl/prod#sensor/ev'), ev1) in prod()
   and (sensorb, URI('http://user.it.uu.se/~udbl/prod#sensor/m'), m) in prod()
   and (sensorb, URI('http://user.it.uu.se/~udbl/prod#sensor/s'), sb) in prod()
   and (sensorb, URI('http://user.it.uu.se/~udbl/prod#sensor/ev'), ev2) in prod()
   and bt1<=et2 
   and et1>=bt2 
   and div(plus(minus(mv1,ev1), abs(minus(mv2,ev2))), 2)>300 ;


pc("eq3amos");

count(eq3amos());





