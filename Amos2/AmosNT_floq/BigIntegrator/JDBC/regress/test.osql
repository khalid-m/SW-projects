/* approach 1 */
set :q2c =
"SELECT ?ev ?th ?ts ?mv
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?x <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/si> ?si.
	    ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/si> ?si.
            ?x <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/ev> ?ev.
            ?x <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/th> ?th.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/ts> ?ts.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/mv> ?mv.
            }" ;

eval("create function sparql2c()->(number, number, number, number) as " + sparql_translate(:q2c));

pc("sparql2c"); 

sparql2c();

/* approach 2 */
set :q2c =
"SELECT ?ev ?th ?ts ?mv
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/si> ?si.
            ?si <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/ev> ?ev.
            ?si <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/th> ?th.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/ts> ?ts.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/mv> ?mv
            }" ;

/* works, join the other two tables, site, installedequipment */
set :q1b =
"SELECT ?ie ?location
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?x <http://user.it.uu.se/~udbl/regress#INSTALLEDEQUIPMENT/site> ?si.
            ?x <http://user.it.uu.se/~udbl/regress#INSTALLEDEQUIPMENT/ie> ?ie.
            ?y <http://user.it.uu.se/~udbl/regress#SITE/site> ?si.
            ?y <http://user.it.uu.se/~udbl/regress#SITE/location> ?location.
            ?y <http://user.it.uu.se/~udbl/regress#SITE/country> ?country.
            FILTER REGEX (?country, 'Sweden').
              }" ;

eval("create function sparql1b()->(number, charstring) as " + sparql_translate(:q1b));

pc("sparql1b"); 

sparql1b();

/* simple query on Measurement with numerical predicates */
set :q1c =
"SELECT ?si ?ts ?mv
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?x <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/mv> ?mv.
            FILTER (?mv > 0.75*100) .
            ?x <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/si> ?si.
            ?x <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/ts> ?ts.
              }" ;

/*eval("create function sparql1c()->(number, charstring, number) as " + sparql_translate(:q1c));*/
eval("create function sparql1c()->(number, charstring, number) as " + sparql_translate(:q1c));

pc("sparql1c"); 

sparql1c();


/* join measurement with site, failed query join with measurement */
set :q1d =
"SELECT ?mv ?location
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?x <http://user.it.uu.se/~udbl/regress#SITE/logdbid> ?logdbid.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/logdbid> ?logdbid.
            ?x <http://user.it.uu.se/~udbl/regress#/MEASUREMENT/mv> ?mv.
            ?x <http://user.it.uu.se/~udbl/regress#SITE/location> ?location.
            ?x <http://user.it.uu.se/~udbl/regress#SITE/country> ?country.
            FILTER REGEX (?country, 'Sweden').
              }" ;

eval("create function sparql1d()->(number, charstring) as " + sparql_translate(:q1d));

pc("sparql1d"); 

sparql1d();

/* approach 3 with less triple pattern */
set :q2c =
"SELECT  ?th ?ts ?mv
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?y <http://user.it.uu.se/~udbl/regress#/MEASURE2/si> ?si.
            ?si <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/th> ?th.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASURE2/ts> ?ts.
            ?y <http://user.it.uu.se/~udbl/regress#/MEASURE2/mv> ?mv
            }" ;

eval("create function sparql2c()->(number, number, number) as " + sparql_translate(:q2c));

pc("sparql2c"); 

sparql2c();


set :q3 =
"SELECT ?x
    FROM <http://user.it.uu.se/~udbl/prod>
    WHERE { ?s <http://user.it.uu.se/~udbl/regress#/SENSORINSTALLATION/si> ?x }" ;

eval("create function sparql3()-><Literal> as " + sparql_translate(:q3));

sparql3();



lisp;

(setq _save-intermediates_ t)

:osql

pc("sparql2"); 

lisp;

(osql "sparql(:q2);")


/* amosql queries */
import_table(:a, 'EQUIPMENTMODEL');

import_table(:a, 'SENSORMODEL');

import_table(:a, 'MEASURED2');

parteval("now");

parteval("real");

/* numerical queries */
/*nq1: What equipment in Uppsala has failed (mv-ev>th) during the last month? */
create function nq1()->(Integer, charstring) as
select ie(si), ename(e)
from SENSORINSTALLATION@C1 si, SITE@C1 s, MEASURED2@C1 m, 
     INSTALLEDEQUIPMENT@C1 ie, EQUIPMENTMODEL@C1 e
where location(s)='Uppsala' and 
      Real(now())-30*24*60*60<ts(m) and
      mv(m)-ev(si)>th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      logdbid(m)=logdbid(s);

pc("nq1");

/* with times operations */
create function nq2()->(Integer, charstring) as
select ie(si), ename(e)
from SENSORINSTALLATION@C1 si, SITE@C1 s, MEASURED2@C1 m, 
     INSTALLEDEQUIPMENT@C1 ie, EQUIPMENTMODEL@C1 e
where location(s)='Uppsala' and 
      Real(now())-30*24*60*60<ts(m) and
      mv(m)-ev(si)>0.75*th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      logdbid(m)=logdbid(s);

pc("nq2");

/* with abs and times operations */
create function nq3()->(Integer, charstring) as
select ie(si), ename(e)
from SENSORINSTALLATION@C1 si, SITE@C1 s, MEASURED2@C1 m, 
     INSTALLEDEQUIPMENT@C1 ie, EQUIPMENTMODEL@C1 e
where location(s)='Uppsala' and 
      Real(now())-30*24*60*60<ts(m) and
      abs(mv(m)-ev(si))/2>0.75*th(si) and
      site(s)=site(ie) and
      ie(ie)=ie(si) and
      e(ie)=e(e) and
      si(m)=si(si) and
      logdbid(m)=logdbid(s);

pc("nq3");