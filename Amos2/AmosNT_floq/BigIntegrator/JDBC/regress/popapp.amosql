set :a = jdbc("ds1", "com.mysql.jdbc.Driver");

set :dburl = "jdbc:mysql://localhost:"+getenv("PORTDB")+"/";

connect(:a, :dburl + "regress", "regress", "regress");

count(read_sql(:a, "dropappdb.sql"));
count(read_sql(:a, "popappdb.sql"));

disconnect(:a);

quit;