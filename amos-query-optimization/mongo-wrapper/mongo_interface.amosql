load_extension("Mongo_wrapper");

create function mongo_connect(Charstring host) -> Integer conn_no
  /* Connect to the MongoDB database on a given IP host */
  as foreign 'mongo_connect+-';

create function mongo_disconnect(Number conn_no)-> Boolean status
  /* Disconnect from the MongoDB server */
  as foreign 'mongo_disConnect-+';

create function mongo_add(Number conn_no, Charstring  database, 
                          Charstring collection, Record o) -> Literal id
  /* Add a record to a MongoDB collection and return its MongoDB identifier
     if insert was successful */
  as foreign 'mongo_add----+';

create function mongo_del(Number  conn_no, Charstring  database, 
                          Charstring collection, Record q) -> Boolean status
  /* Delete record from collection */
  as foreign 'mongo_del----+';

create function mongo_delete_id(Number conn_no, Charstring database,
                                Charstring collection, Object id)
                              -> Boolean
  /* Delete record, given its identifier */
  as mongo_del(conn_no, database, collection, {"_id": id});

create function mongo_query(Number  conn_no, Charstring  database, 
                          Charstring collection, Record q) -> Bag of Record x
  /* Get all records matchin q in collection */
  as foreign 'mongo_query----+';

create function mongo_get(Number conn_no, Charstring database,
                          Charstring collection, Object k) -> Record
  /* Get the record having a specific key (id) in a collection */
  as mongo_query(conn_no, database, collection, {"_id": k});

create function mongo_replace(Number conn_no, Charstring database,
                              Charstring collection, Record new) -> Literal r
  /* Update the record NEW in database.
     If two clients try to update at the same time one will fail.
     Success is signalled by mongo_replace() returning the id of NEW */
  as for each Record old
         where old in mongo_query(conn_no, database, collection, 
                                  {"_id": new["_id"]})
           begin mongo_del(conn_no, database, collection, old);
                 /* The database may be inconsistent here 
                    because of lack of transactions in MongoDB */
                 return mongo_add(conn_no, database, collection, new);
           end;

create function mongo_createIndex(Number  conn_no, Charstring  database, 
                                  Charstring  collection, Charstring indexName,
                                  Record field)
                                -> Boolean status  
  /* Create an index on a specific filed of the records in a collection */
  as foreign 'mongo_createIndex-----+';             

create function mongo_run_cmd(Number  conn_no, Charstring  database, 
                              Record cmd)
                            -> Record status
  /* Run the MongoCommand cmd */
  as foreign 'mongo_run_cmd---+';

create function mongo_dropIndex(Number  conn_no, Charstring  database, 
                                Charstring  collection, Charstring indexName)
                              -> Record status
  /* Drop a specific index in a collection */  
  as mongo_run_cmd(conn_no, database, 
                   { "dropIndexes": collection, "index": indexName });

create function mongo_dropAllIndex(Number  conn_no, Charstring  database, 
                                   Charstring  collection)
                                 -> Record status 
  /* Drop all indexes in a collection */
  as mongo_run_cmd(conn_no, database, 
                   { "dropIndexes": collection, "index": "*" });

create function mongo_add_batch0(Number  conn_no, Charstring  database, 
                                 Charstring  collection, 
                                 Integer write_concern,  Vector records) 
                               -> Boolean status
  as foreign 'mongo_add_batch-----+';


create function mongo_add_batch(Number  conn_no, Charstring  database, 
                                Charstring  collection, 
                                Vector records) 
                              -> Boolean status
  /* Bulk insert records without acknowledgements */
  as mongo_add_batch0(conn_no, database, collection, 1, records);

create function mongo_add_batch_unack(Number  conn_no, Charstring  database, 
                                    Charstring  collection, 
                                    Vector records) 
                                  -> Boolean status
  /* Bulk insert records with acknowledgements of success */
  as mongo_add_batch0(conn_no, database, collection, 0, records);

create function mongo_getPrevError(Number  conn_no, Charstring  database )
                                 -> Record status  
  /* Returns status record containing all errors */
  as mongo_run_cmd(conn_no, database, { "getPrevError": 1 });

create function mongo_collStats(Number  conn_no, Charstring  database, 
                                Charstring  collection) -> Record status  
  /* Reports storage utilization statics for a specified collection */
  as mongo_run_cmd(conn_no, database, { "collStats": collection});

create function indexStats(Number  conn_no, Charstring  database, 
                           Charstring  collection, Charstring indexName)
                         -> Record status  
  /* The indexStats command aggregates statistics for the B-tree data 
     structure of a MongoDB index.*/
  as mongo_run_cmd(conn_no, database, 
                   { "indexStats": collection, "index": indexName });

create function mongo_dbStats(Number  conn_no, Charstring  database, 
                              Integer scale)
                            -> Record status  
  /* Reports storage utilization statistics for the specified database */
  as mongo_run_cmd(conn_no, database, { "dbStats": 1, "scale": scale});

create function mongo_count(Number  conn_no, Charstring  database, 
                            Charstring  collection, Record query) 
                          -> Record  
  /* Counts the number of objects in a collection */
  as mongo_run_cmd(conn_no, database, {"count": collection ,
                                       "query": query });

create function mongo_dropCollection(Number  conn_no, Charstring  database, 
                                     Charstring  collection) -> Record status 
  /* Removes the specified collection from the database */
  as mongo_run_cmd(conn_no, database, { "drop": collection});

create function mongo_dropDB(Number  conn_no, Charstring  database)
                           -> Record status  
  /* Removes the entire database */  
  as mongo_run_cmd(conn_no, database, { "dropDatabase": 1});

create function mongo_collNameSpaces(Number  conn_no, Charstring  database)
                                   -> Bag of Record x  
  /* Get all the collection namespaces in a database */
  as mongo_query(conn_no, database, "system.namespaces", empty_record());

create function mongo_indexNameSpaces(Number  conn_no, Charstring  database)
                                    -> Bag of Record x  
  /* Get all the index meta-data in a database */
  as mongo_query(conn_no, database, "system.indexes", empty_record());
